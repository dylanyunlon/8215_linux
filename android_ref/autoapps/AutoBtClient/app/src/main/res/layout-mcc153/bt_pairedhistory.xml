<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/x5"
        android:layout_marginTop="@dimen/y5"
        android:layout_marginEnd="@dimen/x5"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/x10"
            android:layout_marginEnd="@dimen/x5"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/y75"
                android:layout_marginTop="@dimen/y5"
                android:layout_weight="5"
                android:background="@drawable/top_frame_bg">

                <TextView
                    android:id="@+id/bt_device"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/x30"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/x25" />

                <Button
                    android:id="@+id/bt_device_connected"
                    android:layout_width="@dimen/x250"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/x18"
                    android:layout_marginEnd="@dimen/x18"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textColor="@color/bt_connect_color"
                    android:textSize="@dimen/x25"
                    android:background="@null"
                    android:onClick="startMarquee" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_scan_bt"
                android:layout_width="0dp"
                android:layout_height="@dimen/y75"
                android:layout_marginStart="@dimen/x20"
                android:layout_marginTop="@dimen/y5"
                android:layout_weight="1"
                android:background="@drawable/set_search"
                android:textColor="@android:color/white"
                android:textSize="@dimen/x25" />

            <Button
                android:id="@+id/btn_connect_bt"
                android:layout_width="0dp"
                android:layout_height="@dimen/y75"
                android:layout_marginStart="@dimen/x20"
                android:layout_marginTop="@dimen/y5"
                android:layout_weight="1"
                android:background="@drawable/set_connect"
                android:textColor="@android:color/white"
                android:textSize="@dimen/x25" />

            <Button
                android:id="@+id/btn_disconnect_bt"
                android:layout_width="0dp"
                android:layout_height="@dimen/y75"
                android:layout_marginStart="@dimen/x20"
                android:layout_marginTop="@dimen/y5"
                android:layout_weight="1"
                android:background="@drawable/set_disconnect"
                android:textColor="@android:color/white"
                android:textSize="@dimen/x25" />

            <Button
                android:id="@+id/btn_unpair_bt"
                android:layout_width="0dp"
                android:layout_height="@dimen/y75"
                android:layout_marginStart="@dimen/x20"
                android:layout_marginTop="@dimen/y5"
                android:layout_weight="1"
                android:background="@drawable/set_delete"
                android:textColor="@android:color/white"
                android:textSize="@dimen/x25" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_below="@id/top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/y350"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:background="@drawable/set_device_bg"
                android:divider="@drawable/divider"
                android:orientation="vertical"
                android:paddingStart="@dimen/x10"
                android:paddingEnd="@dimen/x10"
                android:showDividers="middle|end"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/x40"
                    android:layout_marginTop="@dimen/y8"
                    android:text="@string/BtSettingsLabel"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/x23" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/y5"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/y32"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_name_string"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/x22" />

                    <TextView
                        android:id="@+id/tv_edit_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:singleLine="true"
                        android:text="@string/bt_device_name_text"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/x22" />

                    <Button
                        android:id="@+id/btn_edit_name_bt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/more" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_pin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/y50"
                    android:layout_marginTop="@dimen/y5"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/y32"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_pin_string"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/x22" />

                    <TextView
                        android:id="@+id/tv_edit_pin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:singleLine="true"
                        android:text="@string/bt_device_pin_text"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/x22" />

                    <Button
                        android:id="@+id/btn_edit_pin_bt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/more" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/y32"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:text="@string/autoanswer_string"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/x22" />

                    <Button
                        android:id="@+id/switch_autoanswer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/set_tumbler_off" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/y32"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:text="@string/autoconnect_string"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/x22" />

                    <Button
                        android:id="@+id/switch_autoconnect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/set_tumbler_off" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/y32"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/bluetooth_network"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/x22" />

                    <Button
                        android:id="@+id/network_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/network_tips" />

                    <Button
                        android:id="@+id/network"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/set_tumbler_off"
                        android:minWidth="52dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/y32"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxWidth="@dimen/x240"
                        android:singleLine="true"
                        android:text="@string/power_string"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/x22" />

                    <Button
                        android:id="@+id/switch_power"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/set_tumbler_on" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/x10"
                android:layout_weight="1"
                android:background="@drawable/set_device_bg"
                android:divider="@drawable/divider"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/paired_devices_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/x40"
                    android:layout_marginTop="@dimen/y7"
                    android:ellipsize="end"
                    android:maxWidth="@dimen/x250"
                    android:singleLine="true"
                    android:text="@string/paired_devices_string"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/x25" />

                <ListView
                    android:id="@+id/bluetooth_paired_devices"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/y20"
                    android:cacheColorHint="@android:color/transparent"
                    android:choiceMode="singleChoice"
                    android:divider="@drawable/divider"
                    android:listSelector="@android:color/transparent"
                    android:scrollbars="none" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/x10"
                android:layout_weight="1"
                android:background="@drawable/set_device_bg"
                android:divider="@drawable/divider"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/usable_devices_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/x40"
                    android:layout_marginTop="@dimen/y7"
                    android:ellipsize="end"
                    android:maxWidth="@dimen/x250"
                    android:singleLine="true"
                    android:text="@string/usable_devices_string"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/x25" />

                <ListView
                    android:id="@+id/bluetooth_usable_devices"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/y20"
                    android:cacheColorHint="@android:color/transparent"
                    android:choiceMode="singleChoice"
                    android:divider="@drawable/divider"
                    android:listSelector="@android:color/transparent"
                    android:scrollbars="none" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- waiting downloading layout -->

    <LinearLayout
        android:id="@+id/scan_device_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/dialog_bg"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressbar_scan_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/x15"
            android:indeterminateDrawable="@drawable/blue_progressbar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="@dimen/x15"
            android:text="@string/scan_device"
            android:textColor="@android:color/white"
            android:textSize="@dimen/x25" />
    </LinearLayout>

    <include
        android:id="@+id/network_layout"
        layout="@layout/activity_bluetooth_net_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_bg"
        android:visibility="gone" />

</FrameLayout>