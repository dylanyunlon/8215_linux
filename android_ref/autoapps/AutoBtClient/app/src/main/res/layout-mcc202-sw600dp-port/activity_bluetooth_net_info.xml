<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/x10"
    android:paddingEnd="@dimen/x10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="@dimen/x490"
            android:layout_height="@dimen/y113"
            android:layout_gravity="center_vertical"
            android:background="@drawable/settingbtn_n">

            <ImageView
                android:id="@+id/imageView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:background="@drawable/bluetooth_setup_icon"
                android:visibility="gone" />

            <TextView
                android:id="@+id/info1"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="10dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/title_1"
                android:textColor="@color/color_green_dark"
                android:textSize="23sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/tips_close"
            android:layout_width="@dimen/x132"
            android:layout_height="@dimen/y113"
            android:background="@drawable/set_btn_selector"
            android:ellipsize="end"
            android:gravity="center"
            android:shadowRadius="0.6"
            android:singleLine="true"
            android:text="@string/next"
            android:textColor="@color/bluetooth_close_text_color"
            android:textSize="23sp" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/set_device_bg"
        android:divider="@drawable/line"
        android:orientation="vertical"
        android:paddingStart="@dimen/x20"
        android:paddingEnd="@dimen/x20"
        android:showDividers="middle|end">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="35dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/bluetooth_android" />

            <TextView
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/android_system"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="22sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="15dp">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/bluetooth_bt_info" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/openphonebluetoot"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="22sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="15dp">

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/bluetooth_input_info" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="end"
                android:maxWidth="380dp"
                android:singleLine="true"
                android:text="@string/inputnetwork"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="15dp">

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/bluetooth_open_info" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="380dp"
                android:singleLine="true"
                android:text="@string/openbtnewshare"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/y10"
        android:layout_marginBottom="@dimen/y15"
        android:layout_weight="1"
        android:background="@drawable/set_device_bg"
        android:divider="@drawable/line"
        android:orientation="vertical"
        android:paddingStart="@dimen/x20"
        android:paddingEnd="@dimen/x20"
        android:showDividers="middle|end">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/imageView2_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bluetooth_apple" />

            <TextView
                android:id="@+id/textView1_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/ios_system"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="22sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="15dp">

            <ImageView
                android:id="@+id/imageView3_r"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/bluetooth_bt_info" />

            <TextView
                android:id="@+id/textView2_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="380dp"
                android:singleLine="true"
                android:text="@string/openphonebluetoot"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="15dp">

            <ImageView
                android:id="@+id/imageView4_r"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/bluetooth_wifi_info" />

            <TextView
                android:id="@+id/textView3_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="380dp"
                android:singleLine="true"
                android:text="@string/openapplenet"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>