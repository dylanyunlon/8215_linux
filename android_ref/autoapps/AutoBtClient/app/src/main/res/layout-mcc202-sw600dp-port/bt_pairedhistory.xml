<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/x10"
    android:paddingTop="@dimen/x10"
    android:paddingEnd="@dimen/x10"
    android:paddingBottom="@dimen/x20">

    <LinearLayout
        android:id="@+id/ll_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/y100"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:paddingStart="@dimen/x18"
                android:paddingEnd="@dimen/x18"
                android:background="@drawable/top_frame_bg">

                <TextView
                    android:id="@+id/bt_device"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:singleLine="true"
                    android:textColor="@color/color_green_dark"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/bt_device_connected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="@dimen/x240"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:background="@null"
                    android:textColor="@color/color_green_dark"
                    android:textSize="22sp"
                    android:onClick="startMarquee" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_scan_bt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/x2"
                android:layout_weight="1"
                android:background="@drawable/set_search"
                android:textColor="@android:color/white"
                android:textSize="25sp" />

            <ImageView
                android:id="@+id/btn_connect_bt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/x2"
                android:layout_weight="1"
                android:background="@drawable/set_connect"
                android:textColor="@android:color/white"
                android:textSize="25sp" />

            <ImageView
                android:id="@+id/btn_disconnect_bt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/x2"
                android:layout_weight="1"
                android:background="@drawable/set_disconnect"
                android:textColor="@android:color/white"
                android:textSize="25sp" />

            <ImageView
                android:id="@+id/btn_unpair_bt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/x2"
                android:layout_weight="1"
                android:background="@drawable/set_delete"
                android:textColor="@android:color/white"
                android:textSize="25sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/y10"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/set_device_bg"
                android:divider="@drawable/line"
                android:orientation="vertical"
                android:paddingStart="@dimen/x18"
                android:paddingEnd="@dimen/x18"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/usable_devices_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/usable_devices_string"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ListView
                    android:id="@+id/bluetooth_usable_devices"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:cacheColorHint="@android:color/transparent"
                    android:choiceMode="singleChoice"
                    android:divider="@drawable/line"
                    android:listSelector="@android:color/transparent"
                    android:scrollbars="none" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/y10"
                android:layout_weight="1"
                android:background="@drawable/set_device_bg"
                android:divider="@drawable/line"
                android:orientation="vertical"
                android:paddingStart="@dimen/x18"
                android:paddingEnd="@dimen/x18"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/paired_devices_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/paired_devices_string"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ListView
                    android:id="@+id/bluetooth_paired_devices"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:cacheColorHint="@android:color/transparent"
                    android:choiceMode="singleChoice"
                    android:divider="@drawable/line"
                    android:listSelector="@android:color/transparent"
                    android:scrollbars="none" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- waiting downloading layout -->
    <LinearLayout
        android:id="@+id/scan_device_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/dialog_bg"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressbar_scan_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:indeterminateDrawable="@drawable/blue_progressbar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="15dp"
            android:text="@string/scan_device"
            android:textColor="@android:color/white"
            android:textSize="25sp" />
    </LinearLayout>

    <include
        android:id="@+id/network_layout"
        layout="@layout/activity_bluetooth_net_info"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>