<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/x10"
    android:paddingTop="@dimen/y20"
    android:paddingEnd="@dimen/x10"
    android:paddingBottom="@dimen/y20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <EditText
                android:id="@+id/search_edittext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:imeOptions="actionDone|flagNoFullscreen"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                tools:text="共有100位联系人" />

            <Button
                android:id="@+id/bt_phonebook_syn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/sync" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="32dp"
            android:layout_weight="1"
            android:padding="@dimen/x22"
            android:background="@drawable/set_device_bg"
            android:orientation="horizontal">

            <GridView
                android:id="@+id/phonebook_listview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:background="@android:color/transparent"
                android:choiceMode="singleChoice"
                android:listSelector="@android:color/transparent"
                android:numColumns="2"
                android:stretchMode="columnWidth"
                android:verticalSpacing="16dp"
                android:paddingStart="@dimen/phonebook_listview_paddingStart"
                android:paddingEnd="@dimen/phonebook_listview_paddingEnd"
                android:paddingTop="@dimen/phonebook_listview_paddingTop"
                android:paddingBottom="@dimen/phonebook_listview_paddingTop"/>

            <com.autochips.bluetooth.view.SideBar
                android:id="@+id/phonebook_sidebar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="24dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- waiting downloading layout -->
    <LinearLayout
        android:id="@+id/download_phonebook_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/dialog_bg"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressbar_download_phonebook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:indeterminateDrawable="@drawable/blue_progressbar" />

        <TextView
            android:id="@+id/tv_download_phonebook_text"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/str_download_phonebook"
            android:textColor="@android:color/white"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
