<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/bt_pairedhistory_layout_marginStart"
        android:layout_marginEnd="@dimen/bt_pairedhistory_layout_marginStart"
        android:layout_marginTop="@dimen/bt_pairedhistory_layout_marginTop">

        <LinearLayout
            android:id="@+id/linearLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/bt_pairedhistory_top_frame_bg_layout_width"
                android:layout_height="@dimen/bt_pairedhistory_top_frame_bg_layout_height"
                android:layout_marginTop="@dimen/bt_pairedhistory_top_frame_bg_layout_marginTop"
                android:paddingBottom="@dimen/bt_pairedhistory_top_frame_bg_paddingBottom"
                android:background="@drawable/top_frame_bg"
                tools:visibility="gone">

                <TextView
                    android:id="@+id/bt_device"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/color_green_dark"
                    android:textSize="@dimen/bt_pairedhistory_bt_device_textSize"
                    android:layout_marginStart="@dimen/bt_pairedhistory_bt_device_layout_marginStart"/>

                <Button
                    android:id="@+id/bt_device_connected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/x20"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textColor="@color/color_green_dark"
                    android:textSize="@dimen/bt_pairedhistory_bt_device_textSize"
                    android:layout_marginStart="@dimen/bt_pairedhistory_bt_device_layout_marginStart"
                    android:background="@null"
                    android:onClick="startMarquee" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <LinearLayout
                android:id="@+id/top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_scan_bt"
                    android:layout_width="@dimen/bt_pairedhistory_btn_scan_bt_layout_width"
                    android:layout_height="@dimen/bt_pairedhistory_btn_scan_bt_layout_height"
                    android:background="@drawable/set_search"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/btn_connect_bt"
                    android:layout_width="@dimen/bt_pairedhistory_btn_scan_bt_layout_width"
                    android:layout_height="@dimen/bt_pairedhistory_btn_scan_bt_layout_height"
                    android:layout_marginStart="@dimen/bt_pairedhistory_btn_connect_bt_layout_marginStart"
                    android:background="@drawable/set_connect"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/btn_disconnect_bt"
                    android:layout_width="@dimen/bt_pairedhistory_btn_scan_bt_layout_width"
                    android:layout_height="@dimen/bt_pairedhistory_btn_scan_bt_layout_height"
                    android:layout_marginStart="@dimen/bt_pairedhistory_btn_connect_bt_layout_marginStart"
                    android:background="@drawable/set_disconnect"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/btn_unpair_bt"
                    android:layout_width="@dimen/bt_pairedhistory_btn_scan_bt_layout_width"
                    android:layout_height="@dimen/bt_pairedhistory_btn_scan_bt_layout_height"
                    android:layout_marginStart="@dimen/bt_pairedhistory_btn_connect_bt_layout_marginStart"
                    android:layout_marginEnd="@dimen/bt_pairedhistory_btn_connect_bt_layout_marginEnd"
                    android:background="@drawable/set_delete"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/linearLayout1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/x700"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/x10"
                android:background="@drawable/set_device_bg"
                android:orientation="vertical"
                android:paddingStart="@dimen/x10"
                android:paddingEnd="@dimen/x10"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/y8"
                    android:text="@string/BtSettingsLabel"
                    android:textColor="#000000"
                    android:textSize="@dimen/x23" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x2"
                    android:layout_marginStart="@dimen/x4"
                    android:layout_marginTop="@dimen/y6"
                    android:layout_marginEnd="@dimen/x4"
                    android:background="@drawable/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/y5"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/x32"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_name_string"
                        android:textColor="#000000"
                        android:textSize="@dimen/x22" />

                    <TextView
                        android:id="@+id/tv_edit_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/x8"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:singleLine="true"
                        android:text="@string/bt_device_name_text"
                        android:textColor="#000000"
                        android:textSize="@dimen/x22" />

                    <Button
                        android:id="@+id/btn_edit_name_bt"
                        android:layout_width="@dimen/x32"
                        android:layout_height="@dimen/x32"
                        android:background="@drawable/more" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/y16"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/x32"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="@dimen/x100"
                        android:layout_height="wrap_content"
                        android:text="@string/device_pin_string"
                        android:textColor="#000000"
                        android:textSize="@dimen/x23" />

                    <TextView
                        android:id="@+id/tv_edit_pin"
                        android:layout_width="@dimen/x100"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:text="@string/bt_device_pin_text"
                        android:textColor="#000000"
                        android:textSize="@dimen/x22" />

                    <Button
                        android:id="@+id/btn_edit_pin_bt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/more" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/y16"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/x32"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/autoanswer_string"
                        android:textColor="#000000"
                        android:textSize="@dimen/x22" />

                    <Button
                        android:id="@+id/switch_autoanswer"
                        android:layout_width="@dimen/x137"
                        android:layout_height="@dimen/x56"
                        android:background="@drawable/set_tumbler_off" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/y16"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/x32"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/autoconnect_string"
                        android:textColor="#000000"
                        android:textSize="@dimen/x22" />

                    <Button
                        android:id="@+id/switch_autoconnect"
                        android:layout_width="@dimen/x137"
                        android:layout_height="@dimen/x56"
                        android:background="@drawable/set_tumbler_off" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/y16"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/x32"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/bluetooth_network"
                        android:textColor="#000000"
                        android:textSize="@dimen/x22" />

                    <Button
                        android:id="@+id/network_tips"
                        android:layout_width="@dimen/x31"
                        android:layout_height="@dimen/x31"
                        android:layout_marginEnd="@dimen/x16"
                        android:background="@drawable/network_tips" />

                    <Button
                        android:id="@+id/network"
                        android:layout_width="@dimen/x137"
                        android:layout_height="@dimen/x56"
                        android:background="@drawable/set_tumbler_off"
                        android:minWidth="@dimen/x52" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/y16"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/x32"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxWidth="@dimen/x240"
                        android:singleLine="true"
                        android:text="@string/power_string"
                        android:textColor="#000000"
                        android:textSize="@dimen/x22" />

                    <Button
                        android:id="@+id/switch_power"
                        android:layout_width="@dimen/x137"
                        android:layout_height="@dimen/x56"
                        android:background="@drawable/set_tumbler_on" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/bt_pairedhistory_set_device_bg_layout_width"
                android:layout_height="@dimen/bt_pairedhistory_set_device_bg_layout_height"
                android:layout_marginTop="@dimen/bt_pairedhistory_set_device_bg_layout_marginTop"
                android:paddingTop="@dimen/bt_call_dialpad_bg_paddingTop"
                android:paddingBottom="@dimen/bt_call_dialpad_bg_paddingBottom"
                android:paddingStart="@dimen/bt_call_dialpad_bg_paddingStart"
                android:paddingEnd="@dimen/bt_call_dialpad_bg_paddingStart"
                android:background="@drawable/set_device_bg"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/paired_devices_title"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bt_pairedhistory_paired_devices_title_layout_height"
                    android:layout_marginStart="@dimen/bt_pairedhistory_paired_devices_title_layout_marginStart"
                    android:layout_marginEnd="@dimen/bt_pairedhistory_paired_devices_title_layout_marginEnd"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/paired_devices_string"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/bt_pairedhistory_paired_devices_title_textSize"
                    android:gravity="center_vertical"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@drawable/line" />

                <ListView
                    android:id="@+id/bluetooth_paired_devices"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bt_pairedhistory_bluetooth_paired_devices_layout_height"
                    android:cacheColorHint="@android:color/transparent"
                    android:choiceMode="singleChoice"
                    android:divider="@drawable/line"
                    android:dividerHeight="2dp"
                    android:listSelector="@android:color/transparent"
                    android:scrollbars="none" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <LinearLayout
                android:layout_width="@dimen/bt_pairedhistory_set_device_bg_layout_width"
                android:layout_height="@dimen/bt_pairedhistory_set_device_bg_layout_height"
                android:layout_marginTop="@dimen/bt_pairedhistory_set_device_bg_layout_marginTop"
                android:paddingTop="@dimen/bt_call_dialpad_bg_paddingTop"
                android:paddingBottom="@dimen/bt_call_dialpad_bg_paddingBottom"
                android:paddingStart="@dimen/bt_call_dialpad_bg_paddingStart"
                android:paddingEnd="@dimen/bt_call_dialpad_bg_paddingStart"
                android:background="@drawable/set_device_bg"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/usable_devices_title"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bt_pairedhistory_paired_devices_title_layout_height"
                    android:layout_marginStart="@dimen/bt_pairedhistory_paired_devices_title_layout_marginStart"
                    android:layout_marginEnd="@dimen/bt_pairedhistory_paired_devices_title_layout_marginEnd"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/usable_devices_string"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/bt_pairedhistory_paired_devices_title_textSize"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@drawable/line" />

                <ListView
                    android:id="@+id/bluetooth_usable_devices"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bt_pairedhistory_bluetooth_paired_devices_layout_height"
                    android:cacheColorHint="@android:color/transparent"
                    android:choiceMode="singleChoice"
                    android:divider="@drawable/line"
                    android:dividerHeight="2dp"
                    android:listSelector="@android:color/transparent"
                    android:scrollbars="none" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- waiting downloading layout -->

    <LinearLayout
        android:id="@+id/scan_device_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/dialog_bg"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressbar_scan_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/x15"
            android:indeterminateDrawable="@drawable/blue_progressbar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="@dimen/x15"
            android:text="@string/scan_device"
            android:textColor="@color/callhistory_download_text"
            android:textSize="@dimen/dial_listitem_dial_name_textSize" />
    </LinearLayout>

    <include
        android:id="@+id/network_layout"
        layout="@layout/activity_bluetooth_net_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_bg"
        android:visibility="gone" />
</FrameLayout>