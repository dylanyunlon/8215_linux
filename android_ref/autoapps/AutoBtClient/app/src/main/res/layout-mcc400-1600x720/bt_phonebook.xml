<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/bt_phonebook_layout_marginStart"
        android:layout_marginEnd="@dimen/bt_phonebook_layout_marginStart"
        android:layout_marginTop="@dimen/bt_call_layout_marginTop"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/search_edittext"
                android:layout_width="@dimen/bt_phonebook_search_edittext_layout_width"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:imeOptions="actionDone|flagNoFullscreen"
                android:singleLine="true"
                android:textColor="@color/color_blue_dark"
                android:textColorHint="@color/color_blue_dark"
                android:textSize="@dimen/bt_phonebook_search_edittext_textSize"
                android:layout_gravity="center_vertical"/>

            <Button
                android:id="@+id/bt_phonebook_syn"
                android:layout_width="@dimen/bt_phonebook_bt_phonebook_syn_layout_width"
                android:layout_height="@dimen/bt_phonebook_bt_phonebook_syn_layout_height"
                android:background="@drawable/sync" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <GridView
                android:id="@+id/phonebook_listview"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/bt_phonebook_phonebook_listview_layout_height"
                android:layout_gravity="center_horizontal"
                android:choiceMode="singleChoice"
                android:listSelector="@android:color/transparent"
                android:numColumns="@integer/bt_phonebook_phonebook_listview_numColumns"
                android:stretchMode="columnWidth"
                android:verticalSpacing="@dimen/bt_phonebook_phonebook_listview_verticalSpacing"
                android:layout_marginTop="@dimen/bt_phonebook_phonebook_listview_layout_marginTop"
                android:layout_marginStart="@dimen/bt_phonebook_phonebook_listview_layout_marginStart"
                android:layout_marginEnd="@dimen/bt_phonebook_phonebook_listview_layout_marginStart"/>

            <com.autochips.bluetooth.view.SideBar
                android:id="@+id/phonebook_sidebar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bt_phonebook_phonebook_sidebar_layout_marginTop" />
        </LinearLayout>

    </LinearLayout>

    <!-- waiting downloading layout -->
    <LinearLayout
        android:id="@+id/download_phonebook_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/dialog_bg"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressbar_download_phonebook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/x15"
            android:indeterminateDrawable="@drawable/blue_progressbar" />

        <TextView
            android:id="@+id/tv_download_phonebook_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/x15"
            android:text="@string/str_download_phonebook"
            android:textColor="@color/callhistory_download_text"
            android:textSize="@dimen/dial_listitem_dial_name_textSize" />
    </LinearLayout>
</FrameLayout>
