<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/device_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/device_listitem_layout_height"
    android:paddingStart="@dimen/device_listitem_paddingStart"
    android:paddingEnd="@dimen/device_listitem_paddingEnd"
    android:descendantFocusability="blocksDescendants"
    android:gravity="bottom"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/device_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_remote_device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/color_blue_dark"
            android:textSize="@dimen/device_listitem_item_remote_device_name_textSize" />

        <ImageView
            android:id="@+id/device_select"
            android:layout_width="@dimen/device_listitem_device_select_layout_width"
            android:layout_height="@dimen/device_listitem_device_select_layout_height"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:background="@drawable/set_rb_off" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_config_profile"
        android:layout_width="@dimen/device_listitem_device_select_layout_width"
        android:layout_height="@dimen/device_listitem_device_select_layout_height"
        android:layout_gravity="center_vertical"
        android:background="@drawable/more" />

</LinearLayout>
