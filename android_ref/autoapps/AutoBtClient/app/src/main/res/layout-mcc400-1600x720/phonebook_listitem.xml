<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="@dimen/phonebook_listitem_contact_layout_width"
        android:layout_height="@dimen/phonebook_listitem_contact_layout_width"
        android:src="@drawable/contact" />

    <LinearLayout
        android:id="@+id/phonebook_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="blocksDescendants"
        android:layout_marginStart="@dimen/phonebook_listitem_phonebook_item_layout_marginStart"
        android:paddingBottom="@dimen/phonebook_listitem_phonebook_item_paddingBottom"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_phonebook_name"
            android:layout_width="@dimen/phonebook_listitem_item_phonebook_name_layout_width"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/color_blue_dark"
            android:text="shabi"
            android:textSize="@dimen/dial_listitem_dial_name_textSize" />

        <TextView
            android:id="@+id/item_phonebook_number"
            android:layout_width="@dimen/phonebook_listitem_item_phonebook_name_layout_width"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:layout_marginTop="@dimen/phonebook_listitem_item_phonebook_number_layout_marginTop"
            android:text="shabi"
            android:textColor="@color/color_white_light"
            android:textSize="@dimen/phonebook_listitem_item_phonebook_number_textSize" />

        <ImageView
            android:id="@+id/btn_phonebook_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@drawable/bt_phonebook_path_phone"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>