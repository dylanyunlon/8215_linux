<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginStart="@dimen/bt_phonebook_layout_marginStart"
        android:layout_marginEnd="@dimen/bt_phonebook_layout_marginStart"
        android:layout_marginTop="@dimen/bt_call_layout_marginTop">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:orientation="vertical">

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/btn_missed"
                    android:layout_width="@dimen/bt_phonebook_bt_phonebook_syn_layout_width"
                    android:layout_height="@dimen/bt_phonebook_bt_phonebook_syn_layout_height"
                    android:background="@drawable/missed"
                    android:button="@null" />

                <RadioButton
                    android:id="@+id/btn_received"
                    android:layout_width="@dimen/bt_phonebook_bt_phonebook_syn_layout_width"
                    android:layout_height="@dimen/bt_phonebook_bt_phonebook_syn_layout_height"
                    android:layout_marginStart="@dimen/bt_callhistory_btn_received_layout_marginStart"
                    android:background="@drawable/received"
                    android:button="@null" />

                <RadioButton
                    android:id="@+id/btn_dialed"
                    android:layout_width="@dimen/bt_phonebook_bt_phonebook_syn_layout_width"
                    android:layout_height="@dimen/bt_phonebook_bt_phonebook_syn_layout_height"
                    android:layout_marginStart="@dimen/bt_callhistory_btn_received_layout_marginStart"
                    android:background="@drawable/called"
                    android:button="@null" />

                <RadioButton
                    android:id="@+id/bt_callhistory_syn"
                    android:layout_width="@dimen/bt_phonebook_bt_phonebook_syn_layout_width"
                    android:layout_height="@dimen/bt_phonebook_bt_phonebook_syn_layout_height"
                    android:layout_marginStart="@dimen/bt_callhistory_btn_received_layout_marginStart"
                    android:background="@drawable/sync"
                    android:button="@null" />

            </RadioGroup>

            <GridView
                android:id="@+id/history_listview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:choiceMode="singleChoice"
                android:listSelector="@android:color/transparent"
                android:numColumns="@integer/bt_phonebook_phonebook_listview_numColumns"
                android:stretchMode="columnWidth"
                android:verticalSpacing="@dimen/bt_phonebook_phonebook_listview_verticalSpacing"
                android:layout_marginTop="@dimen/bt_phonebook_phonebook_listview_layout_marginTop"
                android:layout_marginStart="@dimen/bt_phonebook_phonebook_listview_layout_marginStart"
                android:layout_marginEnd="@dimen/bt_phonebook_phonebook_listview_layout_marginStart"/>
        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/download_callhistory_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/dialog_bg"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressbar_download_callhistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/x15"
            android:indeterminateDrawable="@drawable/blue_progressbar" />

        <TextView
            android:id="@+id/tv_download_callhistory_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/x15"
            android:text="@string/str_download_history"
            android:textColor="@color/callhistory_download_text"
            android:textSize="@dimen/dial_listitem_dial_name_textSize" />
    </LinearLayout>

</FrameLayout>