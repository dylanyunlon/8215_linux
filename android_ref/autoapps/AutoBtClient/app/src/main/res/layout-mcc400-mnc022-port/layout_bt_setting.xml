<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/network_layout"
        layout="@layout/activity_bluetooth_net_info"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/setting_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/bt_call_layout_marginTop"
        android:layout_marginStart="@dimen/layout_zx_bt_setting_setting_layout_layout_marginStart"
        android:layout_marginEnd="@dimen/layout_zx_bt_setting_setting_layout_layout_marginStart"
        android:divider="@drawable/line"
        android:orientation="vertical"
        android:showDividers="middle|end">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/x8"
            android:text="@string/BtSettingsLabel"
            android:textColor="@color/color_bt_setting_page"
            android:textSize="@dimen/x30"
            android:visibility="gone" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_zx_bt_setting_name_layout_height"
            android:paddingStart="@dimen/layout_zx_bt_setting_name_paddingStart"
            android:paddingEnd="@dimen/layout_zx_bt_setting_name_paddingEnd"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_name_string"
                android:textColor="@color/color_bt_setting_page"
                android:textSize="@dimen/layout_zx_bt_setting_tv_edit_name_textSize" />

            <TextView
                android:id="@+id/tv_edit_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/bt_device_name_text"
                android:textColor="@color/color_bt_setting_page"
                android:textSize="@dimen/layout_zx_bt_setting_tv_edit_name_textSize"
                android:layout_marginStart="@dimen/layout_zx_bt_setting_tv_edit_name_layout_marginStart"/>

            <Button
                android:id="@+id/btn_edit_name_bt"
                android:layout_width="@dimen/device_listitem_device_select_layout_width"
                android:layout_height="@dimen/device_listitem_device_select_layout_height"
                android:background="@drawable/more" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_pin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_zx_bt_setting_name_layout_height"
            android:paddingStart="@dimen/layout_zx_bt_setting_name_paddingStart"
            android:paddingEnd="@dimen/layout_zx_bt_setting_name_paddingEnd"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_pin_string"
                android:textColor="@color/color_bt_setting_page"
                android:textSize="@dimen/layout_zx_bt_setting_tv_edit_name_textSize"  />

            <TextView
                android:id="@+id/tv_edit_pin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:singleLine="true"
                android:text="@string/bt_device_pin_text"
                android:textColor="@color/color_bt_setting_page"
                android:textSize="@dimen/layout_zx_bt_setting_tv_edit_name_textSize"
                android:layout_marginStart="@dimen/layout_zx_bt_setting_tv_edit_name_layout_marginStart"/>

            <Button
                android:id="@+id/btn_edit_pin_bt"
                android:layout_width="@dimen/device_listitem_device_select_layout_width"
                android:layout_height="@dimen/device_listitem_device_select_layout_height"
                android:background="@drawable/more" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_zx_bt_setting_name_layout_height"
            android:paddingStart="@dimen/layout_zx_bt_setting_name_paddingStart"
            android:paddingEnd="@dimen/layout_zx_bt_setting_name_paddingEnd"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/autoanswer_string"
                android:textColor="@color/color_bt_setting_page"
                android:textSize="@dimen/layout_zx_bt_setting_tv_edit_name_textSize"/>

            <Button
                android:id="@+id/switch_autoanswer"
                android:layout_width="@dimen/layout_zx_bt_setting_switch_autoanswer_layout_width"
                android:layout_height="@dimen/layout_zx_bt_setting_switch_autoanswer_layout_height"
                android:background="@drawable/set_tumbler_off" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_zx_bt_setting_name_layout_height"
            android:paddingStart="@dimen/layout_zx_bt_setting_name_paddingStart"
            android:paddingEnd="@dimen/layout_zx_bt_setting_name_paddingEnd"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/autoconnect_string"
                android:textColor="@color/color_bt_setting_page"
                android:textSize="@dimen/layout_zx_bt_setting_tv_edit_name_textSize" />

            <Button
                android:id="@+id/switch_autoconnect"
                android:layout_width="@dimen/layout_zx_bt_setting_switch_autoanswer_layout_width"
                android:layout_height="@dimen/layout_zx_bt_setting_switch_autoanswer_layout_height"
                android:background="@drawable/set_tumbler_off" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_zx_bt_setting_name_layout_height"
            android:paddingStart="@dimen/layout_zx_bt_setting_name_paddingStart"
            android:paddingEnd="@dimen/layout_zx_bt_setting_name_paddingEnd"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bluetooth_network"
                android:textColor="@color/color_bt_setting_page"
                android:textSize="@dimen/layout_zx_bt_setting_tv_edit_name_textSize" />

            <Button
                android:id="@+id/network_tips"
                android:layout_width="@dimen/layout_zx_bt_setting_network_tips_layout_width"
                android:layout_height="@dimen/layout_zx_bt_setting_network_tips_layout_height"
                android:layout_marginEnd="@dimen/x15"
                android:background="@drawable/network_tips" />

            <Button
                android:id="@+id/network"
                android:layout_width="@dimen/layout_zx_bt_setting_switch_autoanswer_layout_width"
                android:layout_height="@dimen/layout_zx_bt_setting_switch_autoanswer_layout_height"
                android:background="@drawable/set_tumbler_off" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_zx_bt_setting_name_layout_height"
            android:paddingStart="@dimen/layout_zx_bt_setting_name_paddingStart"
            android:paddingEnd="@dimen/layout_zx_bt_setting_name_paddingEnd"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/power_string"
                android:textColor="@color/color_bt_setting_page"
                android:textSize="@dimen/layout_zx_bt_setting_tv_edit_name_textSize" />

            <Button
                android:id="@+id/switch_power"
                android:layout_width="@dimen/layout_zx_bt_setting_switch_autoanswer_layout_width"
                android:layout_height="@dimen/layout_zx_bt_setting_switch_autoanswer_layout_height"
                android:background="@drawable/set_tumbler_on" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>