<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/x1024"
    android:layout_height="@dimen/y600"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="@dimen/x919"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/x65"
            android:layout_marginTop="15dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/search_edittext"
                    android:layout_width="@dimen/x400"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:imeOptions="actionDone|flagNoFullscreen"
                    android:singleLine="true"
                    android:textColor="@color/color_blue_dark"
                    android:textColorHint="@color/color_blue_dark"
                    android:textSize="30sp" />

                <Button
                    android:id="@+id/bt_phonebook_syn"
                    android:layout_width="@dimen/y50"
                    android:layout_height="@dimen/y50"
                    android:layout_marginStart="@dimen/x438"
                    android:background="@drawable/sync" />
            </LinearLayout>

            <GridView
                android:id="@+id/phonebook_listview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:choiceMode="singleChoice"
                android:listSelector="@android:color/transparent"
                android:numColumns="2"
                android:paddingEnd="@dimen/x75"
                android:stretchMode="columnWidth"
                android:verticalSpacing="@dimen/x16" />

        </LinearLayout>

        <com.autochips.bluetooth.view.SideBar
            android:id="@+id/phonebook_sidebar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x14" />

    </LinearLayout>


    <!-- waiting downloading layout -->
    <LinearLayout
        android:id="@+id/download_phonebook_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/dialog_bg"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressbar_download_phonebook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:indeterminateDrawable="@drawable/blue_progressbar" />

        <TextView
            android:id="@+id/tv_download_phonebook_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="16dp"
            android:text="@string/str_download_phonebook"
            android:textColor="@color/color_blue_dark"
            android:textSize="30sp" />
    </LinearLayout>
</FrameLayout>
