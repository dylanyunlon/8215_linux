<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <ImageView
        android:layout_width="@dimen/y79"
        android:layout_height="@dimen/y79"
        android:layout_marginTop="@dimen/x13"
        android:layout_marginStart="@dimen/x15"
        android:src="@drawable/contact" />
              />

    <LinearLayout
            android:id="@+id/history_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="blocksDescendants"
            android:orientation="vertical"
            android:paddingBottom="0dp"
            android:paddingEnd="@dimen/x5"
            android:paddingStart="@dimen/x5">

        <TextView
                android:id="@+id/item_history_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
		        android:layout_marginTop="@dimen/y15"
                android:layout_gravity="top"
                android:ellipsize="end" 
                android:singleLine="true"
                android:textColor="@color/color_blue_dark"
                android:layout_marginStart="@dimen/x5"
                android:textSize="@dimen/x18" />

        <TextView
                android:id="@+id/item_history_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/y4"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/x5"
                android:ellipsize="end" 
                android:singleLine="true"
                android:textColor="@color/color_white_light"
                android:textSize="@dimen/x15" />

        <TextView
                android:id="@+id/item_history_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/color_blue_dark"
                android:textSize="@dimen/x15"
                android:visibility="gone" />

        <ImageView
                android:id="@+id/btn_call_history_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/x3"
                android:src="@drawable/contact"
                android:visibility="gone" />
    </LinearLayout>
</LinearLayout>