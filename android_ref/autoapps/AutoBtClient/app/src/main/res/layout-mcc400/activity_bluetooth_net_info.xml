<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/x1024"
    android:layout_height="@dimen/y600">

    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/x30">

        <LinearLayout
            android:layout_width="@dimen/x471"
            android:layout_height="@dimen/y89"
            android:layout_gravity="center_vertical"
            android:background="@drawable/network_top_bg">

            <ImageView
                android:id="@+id/imageView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/x20"
                android:background="@drawable/bluetooth_setup_icon"
                android:visibility="gone" />

            <TextView
                android:id="@+id/info1"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x40"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/x25"
                android:layout_marginEnd="@dimen/x16"
                android:ellipsize="end"
                android:maxWidth="@dimen/x670"
                android:singleLine="true"
                android:text="@string/title_1"
                android:textColor="@color/color_green_dark"
                android:textSize="@dimen/x24" />

            <TextView
                android:id="@+id/info2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/x30"
                android:text="@string/title_2"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="@dimen/x22"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/tips_close"
            android:layout_width="@dimen/x132"
            android:layout_height="@dimen/y89"
            android:layout_marginStart="@dimen/x360"
            android:background="@drawable/set_btn_selector"
            android:ellipsize="end"
            android:gravity="center_horizontal|center_vertical"
            android:maxWidth="@dimen/x130"
            android:shadowRadius="0.6"
            android:singleLine="true"
            android:text="@string/next"
            android:textColor="@color/bluetooth_close_text_color"
            android:textSize="@dimen/x23" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/relativeLayout1"
        android:layout_width="@dimen/x472"
        android:layout_height="@dimen/y360"
        android:layout_below="@id/linearLayout1"
        android:layout_marginStart="@dimen/x32"
        android:background="@drawable/set_device_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/y10">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="@dimen/x40"
                android:layout_height="@dimen/y40"
                android:layout_marginStart="@dimen/x35"
                android:layout_marginTop="@dimen/y5"
                android:src="@drawable/bluetooth_android" />

            <TextView
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/android_system"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="@dimen/x22" />

        </LinearLayout>

        <TextView
            android:layout_width="@dimen/x446"
            android:layout_height="@dimen/x2"
            android:layout_marginStart="@dimen/x13"
            android:layout_marginTop="@dimen/y15"
            android:background="@drawable/line" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x50"
            android:layout_marginTop="@dimen/y15">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="@dimen/x40"
                android:layout_height="@dimen/y40"
                android:src="@drawable/bluetooth_bt_info" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/openphonebluetoot"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="@dimen/x22" />

        </LinearLayout>

        <TextView
            android:layout_width="@dimen/x446"
            android:layout_height="@dimen/x2"
            android:layout_marginStart="@dimen/x13"
            android:layout_marginTop="@dimen/x15"
            android:background="@drawable/line" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x50"
            android:layout_marginTop="@dimen/y15">

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="@dimen/x40"
                android:layout_height="@dimen/y40"
                android:src="@drawable/bluetooth_input_info" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="end"
                android:maxWidth="@dimen/x370"
                android:singleLine="true"
                android:text="@string/inputnetwork"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="@dimen/x22" />
        </LinearLayout>

        <TextView
            android:layout_width="@dimen/x446"
            android:layout_height="@dimen/x2"
            android:layout_marginStart="@dimen/x13"
            android:layout_marginTop="@dimen/x15"
            android:background="@drawable/line" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x50"
            android:layout_marginTop="@dimen/y15">

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="@dimen/x40"
                android:layout_height="@dimen/y40"
                android:src="@drawable/bluetooth_open_info" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="@dimen/x370"
                android:singleLine="true"
                android:text="@string/openbtnewshare"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="@dimen/x22" />
        </LinearLayout>

        <TextView
            android:layout_width="@dimen/x446"
            android:layout_height="@dimen/x2"
            android:layout_marginStart="@dimen/x13"
            android:layout_marginTop="@dimen/x15"
            android:background="@drawable/line" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="@dimen/x472"
        android:layout_height="@dimen/y360"
        android:layout_below="@id/linearLayout1"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/x32"
        android:background="@drawable/set_device_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x25"
            android:layout_marginTop="@dimen/y10">

            <ImageView
                android:id="@+id/imageView2_r"
                android:layout_width="@dimen/x40"
                android:layout_height="@dimen/y40"
                android:layout_marginTop="@dimen/y5"
                android:src="@drawable/bluetooth_apple" />

            <TextView
                android:id="@+id/textView1_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/ios_system"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="@dimen/x22" />

        </LinearLayout>

        <TextView
            android:layout_width="@dimen/x446"
            android:layout_height="@dimen/x2"
            android:layout_marginStart="@dimen/x13"
            android:layout_marginTop="@dimen/y15"
            android:background="@drawable/line" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x50"
            android:layout_marginTop="@dimen/y15">

            <ImageView
                android:id="@+id/imageView3_r"
                android:layout_width="@dimen/x40"
                android:layout_height="@dimen/y40"
                android:layout_marginTop="@dimen/y2"
                android:src="@drawable/bluetooth_bt_info" />

            <TextView
                android:id="@+id/textView2_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="@dimen/x380"
                android:singleLine="true"
                android:text="@string/openphonebluetoot"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="@dimen/x22" />
        </LinearLayout>

        <TextView
            android:layout_width="@dimen/x446"
            android:layout_height="@dimen/x2"
            android:layout_marginStart="@dimen/x13"
            android:layout_marginTop="@dimen/x15"
            android:background="@drawable/line" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x50"
            android:layout_marginTop="@dimen/y15">

            <ImageView
                android:id="@+id/imageView4_r"
                android:layout_width="@dimen/x40"
                android:layout_height="@dimen/y40"
                android:src="@drawable/bluetooth_wifi_info" />

            <TextView
                android:id="@+id/textView3_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="@dimen/x380"
                android:singleLine="true"
                android:text="@string/openapplenet"
                android:textColor="@color/bluetooth_net_text_color"
                android:textSize="@dimen/x22" />
        </LinearLayout>

        <TextView
            android:layout_width="@dimen/x446"
            android:layout_height="@dimen/x2"
            android:layout_marginStart="@dimen/x13"
            android:layout_marginTop="@dimen/x15"
            android:background="@drawable/line" />

    </LinearLayout>
</RelativeLayout>