<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/network_layout"
        layout="@layout/activity_bluetooth_net_info"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/setting_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/y10"
        android:divider="@drawable/line"
        android:orientation="vertical"
        android:showDividers="middle|end">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/x8"
            android:text="@string/BtSettingsLabel"
            android:textColor="@color/color_blue_dark"
            android:textSize="@dimen/x30"
            android:visibility="gone" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/x81"
                android:text="@string/device_name_string"
                android:textColor="@color/color_blue_dark"
                android:textSize="@dimen/x24" />

            <TextView
                android:id="@+id/tv_edit_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/x8"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:singleLine="true"
                android:text="@string/bt_device_name_text"
                android:textColor="@color/color_blue_dark"
                android:textSize="@dimen/x24" />

            <Button
                android:id="@+id/btn_edit_name_bt"
                android:layout_width="@dimen/y60"
                android:layout_height="@dimen/y60"
                android:layout_marginTop="@dimen/x4"
                android:layout_marginEnd="@dimen/x71"
                android:layout_marginBottom="@dimen/y8"
                android:background="@drawable/more" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="@dimen/x32">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/x81"
                    android:text="@string/device_pin_string"
                    android:textColor="@color/color_blue_dark"
                    android:textSize="@dimen/x24" />

                <TextView
                    android:id="@+id/tv_edit_pin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/x8"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:singleLine="true"
                    android:text="@string/bt_device_pin_text"
                    android:textColor="@color/color_blue_dark"
                    android:textSize="@dimen/x24" />

                <Button
                    android:id="@+id/btn_edit_pin_bt"
                    android:layout_width="@dimen/y60"
                    android:layout_height="@dimen/y60"
                    android:layout_marginTop="@dimen/x4"
                    android:layout_marginEnd="@dimen/x71"
                    android:layout_marginBottom="@dimen/y8"
                    android:background="@drawable/more" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x5"
            android:layout_marginBottom="@dimen/x5"
            android:gravity="center_vertical"
            android:minHeight="@dimen/x32"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/x81"
                android:layout_weight="1"
                android:text="@string/autoanswer_string"
                android:textColor="@color/color_blue_dark"
                android:textSize="@dimen/x24" />

            <Button
                android:id="@+id/switch_autoanswer"
                android:layout_width="@dimen/y104"
                android:layout_height="@dimen/y56"
                android:layout_marginTop="@dimen/x4"
                android:layout_marginEnd="@dimen/x71"
                android:layout_marginBottom="@dimen/y4"
                android:background="@drawable/set_tumbler_off" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x5"
            android:layout_marginBottom="@dimen/x5"
            android:gravity="center_vertical"
            android:minHeight="@dimen/x32"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/x81"
                android:layout_weight="1"
                android:text="@string/autoconnect_string"
                android:textColor="@color/color_blue_dark"
                android:textSize="@dimen/x24" />

            <Button
                android:id="@+id/switch_autoconnect"
                android:layout_width="@dimen/y104"
                android:layout_height="@dimen/y56"
                android:layout_marginTop="@dimen/x4"
                android:layout_marginEnd="@dimen/x71"
                android:layout_marginBottom="@dimen/y4"
                android:background="@drawable/set_tumbler_off" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x5"
            android:layout_marginBottom="@dimen/x5"
            android:gravity="center_vertical"
            android:minHeight="@dimen/x32"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/x81"
                android:layout_weight="1"
                android:text="@string/bluetooth_network"
                android:textColor="@color/color_blue_dark"
                android:textSize="@dimen/x24" />

            <Button
                android:id="@+id/network_tips"
                android:layout_width="@dimen/x45"
                android:layout_height="@dimen/x45"
                android:layout_marginEnd="@dimen/x16"
                android:background="@drawable/network_tips" />

            <Button
                android:id="@+id/network"
                android:layout_width="@dimen/y104"
                android:layout_height="@dimen/y56"
                android:layout_marginTop="@dimen/x4"
                android:layout_marginEnd="@dimen/x71"
                android:layout_marginBottom="@dimen/y4"
                android:background="@drawable/set_tumbler_off"
                android:minWidth="@dimen/x52" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x5"
            android:layout_marginBottom="@dimen/x5"
            android:gravity="center_vertical"
            android:minHeight="@dimen/x32"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/x81"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxWidth="@dimen/x240"
                android:singleLine="true"
                android:text="@string/power_string"
                android:textColor="@color/color_blue_dark"
                android:textSize="@dimen/x24" />

            <Button
                android:id="@+id/switch_power"
                android:layout_width="@dimen/y104"
                android:layout_height="@dimen/y56"
                android:layout_marginTop="@dimen/x4"
                android:layout_marginEnd="@dimen/x71"
                android:layout_marginBottom="@dimen/y4"
                android:background="@drawable/set_tumbler_on" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>