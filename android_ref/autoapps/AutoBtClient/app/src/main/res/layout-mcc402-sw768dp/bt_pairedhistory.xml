<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp">

        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="84dp"
            android:layout_marginStart="27dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/top_frame_bg">

            <TextView
                android:id="@+id/bt_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="23dp"
                android:layout_marginBottom="5dp"
                android:textColor="@color/color_green_dark"
                android:textSize="24sp" />

            <Button
                android:id="@+id/bt_device_connected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textColor="@color/color_green_dark"
                android:textSize="24dp"
                android:background="@null"
                android:onClick="startMarquee"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="367dp"
            android:orientation="horizontal">


            <Button
                android:id="@+id/btn_scan_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/set_search"
                android:textColor="@android:color/white"
                android:textSize="25sp" />

            <Button
                android:id="@+id/btn_connect_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/set_connect"
                android:textColor="@android:color/white"
                android:textSize="25sp" />

            <Button
                android:id="@+id/btn_disconnect_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/set_disconnect"
                android:textColor="@android:color/white"
                android:textSize="25sp" />

            <Button
                android:id="@+id/btn_unpair_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/set_delete"
                android:textColor="@android:color/white"
                android:textSize="25sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="700dp"
            android:layout_marginStart="27dp"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="30dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="700dp"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:background="@drawable/set_device_bg"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="@string/BtSettingsLabel"
                    android:textColor="#000000"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_name_string"
                        android:textColor="#000000"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tv_edit_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:singleLine="true"
                        android:text="@string/bt_device_name_text"
                        android:textColor="#000000"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/btn_edit_name_bt"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/more" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/device_pin_string"
                        android:textColor="#000000"
                        android:textSize="23dp" />

                    <TextView
                        android:id="@+id/tv_edit_pin"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:text="@string/bt_device_pin_text"
                        android:textColor="#000000"
                        android:textSize="22dp" />

                    <Button
                        android:id="@+id/btn_edit_pin_bt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/more" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/autoanswer_string"
                        android:textColor="#000000"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/switch_autoanswer"
                        android:layout_width="137dp"
                        android:layout_height="56dp"
                        android:background="@drawable/set_tumbler_off" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/autoconnect_string"
                        android:textColor="#000000"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/switch_autoconnect"
                        android:layout_width="137dp"
                        android:layout_height="56dp"
                        android:background="@drawable/set_tumbler_off" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/bluetooth_network"
                        android:textColor="#000000"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/network_tips"
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/network_tips" />

                    <Button
                        android:id="@+id/network"
                        android:layout_width="137dp"
                        android:layout_height="56dp"
                        android:background="@drawable/set_tumbler_off"
                        android:minWidth="52dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxWidth="240dp"
                        android:singleLine="true"
                        android:text="@string/power_string"
                        android:textColor="#000000"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/switch_power"
                        android:layout_width="137dp"
                        android:layout_height="56dp"
                        android:background="@drawable/set_tumbler_on" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="313dp"
                android:layout_marginTop="17dp"
                android:background="@drawable/set_device_bg"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/paired_devices_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="20dp"
                    android:ellipsize="end"
                    android:maxWidth="150dp"
                    android:singleLine="true"
                    android:text="@string/paired_devices_string"
                    android:textColor="@color/color_blue_dark"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dip"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/divider" />

                <ListView
                    android:id="@+id/bluetooth_paired_devices"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:cacheColorHint="@android:color/transparent"
                    android:choiceMode="singleChoice"
                    android:divider="@drawable/line"
                    android:dividerHeight="1dp"
                    android:listSelector="@android:color/transparent"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:scrollbars="none" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="313dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/set_device_bg"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/usable_devices_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="20dp"
                    android:ellipsize="end"
                    android:maxWidth="250dp"
                    android:singleLine="true"
                    android:text="@string/usable_devices_string"
                    android:textColor="@color/color_blue_dark"
                    android:textSize="23dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/divider" />

                <ListView
                    android:id="@+id/bluetooth_usable_devices"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:cacheColorHint="@android:color/transparent"
                    android:choiceMode="singleChoice"
                    android:divider="@drawable/line"
                    android:dividerHeight="1dp"
                    android:listSelector="@android:color/transparent"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:scrollbars="none" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- waiting downloading layout -->

    <LinearLayout
        android:id="@+id/scan_device_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/dialog_bg"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressbar_scan_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:indeterminateDrawable="@drawable/blue_progressbar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="15dp"
            android:text="@string/scan_device"
            android:textColor="@color/color_blue_dark"
            android:textSize="25dp" />
    </LinearLayout>

    <include
        android:id="@+id/network_layout"
        layout="@layout/activity_bluetooth_net_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_bg"
        android:visibility="gone" />
</FrameLayout>