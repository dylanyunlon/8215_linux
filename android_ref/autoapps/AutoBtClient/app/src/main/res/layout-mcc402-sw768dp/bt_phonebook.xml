<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="750dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/search_edittext"
                android:layout_width="500dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:imeOptions="actionDone|flagNoFullscreen"
                android:singleLine="true"
                android:textColor="@color/color_blue_dark"
                android:textColorHint="@color/color_blue_dark"
                android:textSize="30sp" />

            <Button
                android:id="@+id/bt_phonebook_syn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:background="@drawable/sync" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="704dp"
            android:layout_height="631dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="13dp"
            android:background="@drawable/set_device_bg"
            android:orientation="horizontal">

            <GridView
                android:id="@+id/phonebook_listview"
                android:layout_width="640dp"
                android:layout_height="631dp"
                android:layout_gravity="center_horizontal"
                android:choiceMode="singleChoice"
                android:listSelector="@android:color/transparent"
                android:numColumns="2"
                android:paddingStart="40dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:stretchMode="columnWidth"
                android:verticalSpacing="26dp" />

            <com.autochips.bluetooth.view.SideBar
                android:id="@+id/phonebook_sidebar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- waiting downloading layout -->
    <LinearLayout
        android:id="@+id/download_phonebook_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/dialog_bg"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressbar_download_phonebook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:indeterminateDrawable="@drawable/blue_progressbar" />

        <TextView
            android:id="@+id/tv_download_phonebook_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="16dp"
            android:text="@string/str_download_phonebook"
            android:textColor="@color/color_blue_dark"
            android:textSize="30sp" />
    </LinearLayout>
</FrameLayout>
