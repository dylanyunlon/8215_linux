<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="5dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/search_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/y10"
                android:layout_weight="3"
                android:background="@android:color/transparent"
                android:imeOptions="actionDone|flagNoFullscreen"
                android:singleLine="true"
                android:textColor="#ffffff"
                android:textColorHint="#ffffff"
                android:textSize="@dimen/x26" />

            <Button
                android:id="@+id/bt_phonebook_syn"
                android:layout_width="@dimen/x214"
                android:layout_height="@dimen/y48"
                android:layout_marginTop="@dimen/y10"
                android:layout_marginEnd="@dimen/x40"
                android:background="@drawable/sync" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical">

            <GridView
                android:id="@+id/phonebook_listview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="@dimen/x20"
                android:layout_marginEnd="@dimen/x20"
                android:choiceMode="singleChoice"
                android:listSelector="@android:color/transparent"
                android:numColumns="3"
                android:padding="@dimen/x5"
                android:stretchMode="columnWidth"
                android:verticalSpacing="@dimen/x24" />

            <com.autochips.bluetooth.view.SideBar
                android:id="@+id/phonebook_sidebar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <!-- waiting downloading layout -->
    <LinearLayout
        android:id="@+id/download_phonebook_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/dialog_bg"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressbar_download_phonebook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/x16"
            android:indeterminateDrawable="@drawable/blue_progressbar" />

        <TextView
            android:id="@+id/tv_download_phonebook_text"
            android:layout_width="@dimen/x200"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/str_download_phonebook"
            android:textColor="@android:color/white"
            android:textSize="@dimen/x20" />
    </LinearLayout>
</FrameLayout>
