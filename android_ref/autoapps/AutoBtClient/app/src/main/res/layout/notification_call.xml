<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ccffffff"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_call_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="5dp"
            android:src="@drawable/skpad_contacts" />

        <TextView
            android:id="@+id/notification_callnumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/str_calling_phone_number"
            android:textColor="@color/color_blue_dark"
            android:textSize="30dp" />

        <TextView
            android:id="@+id/notification_call_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/str_out_call_status"
            android:textColor="@color/color_blue_dark"
            android:textSize="30dp" />

        <TextView
            android:id="@+id/notification_held_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:text="@string/str_calling_phone_number"
            android:textColor="@color/color_blue_dark"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notification_held_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/str_out_call_status"
            android:textColor="@color/color_blue_dark"
            android:textSize="27dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_notification_accept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:background="@drawable/call"
            android:gravity="center"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_notification_held"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:text="@string/str_bt_call_held"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_notification_reject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:background="@drawable/skpad_hangup"
            android:gravity="center"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_notification_accept_terminate"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:text="@string/str_bt_call_accept_terminate"
            android:textColor="#ffa500"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_notification_accept_held"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:text="@string/str_bt_call_accept_held"
            android:textColor="#00ff00"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_notification_swap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:text="@string/str_bt_call_swap"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_notification_merge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:text="@string/str_bt_call_merge"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
