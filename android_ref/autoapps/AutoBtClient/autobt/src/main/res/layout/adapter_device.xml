<?xml version="1.0" encoding="utf-8"?>
<com.autochips.bluetooth.view.HMultiLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="@dimen/dp_item_min_height"
    android:background="@drawable/selector_bg_device_adapter"
    android:paddingLeft="@dimen/dp_adapter_padding"
    android:paddingRight="@dimen/dp_adapter_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/id_device_adapter_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_settings_auto_connect"
            android:singleLine="true"
            android:textColor="@color/colors_menu_title"
            android:textSize="@dimen/sp_device_adapter_title_size" />

        <TextView
            android:id="@+id/id_device_adapter_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_bt_state_bound_none"
            android:singleLine="true"
            android:textColor="@color/colors_menu_title"
            android:textSize="@dimen/sp_device_adapter_state_size" />
    </LinearLayout>

    <ImageView
        android:id="@+id/id_device_adapter_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:src="@drawable/selector_adapter_btn_del"/>

</com.autochips.bluetooth.view.HMultiLayout>