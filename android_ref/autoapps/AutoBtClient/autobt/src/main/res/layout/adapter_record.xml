<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/selector_item_bg_small"
    android:gravity="center_vertical"
    android:paddingLeft="@dimen/dp_record_adapter_padding"
    android:paddingRight="@dimen/dp_record_adapter_padding"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/id_record_adapter_icon"
        android:src="@drawable/ic_bt_head_mini"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="@dimen/dp_4"
        android:gravity="center_vertical"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/id_record_adapter_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/color_adapter_title_normal"
            android:textSize="@dimen/sp_record_adapter_name_size" />

        <TextView
            android:id="@+id/id_record_adapter_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/color_adapter_title_normal"
            android:textSize="@dimen/sp_record_adapter_phone_size" />

    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/id_record_adapter_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/color_adapter_title_normal"
            android:textSize="@dimen/sp_record_adapter_phone_size" />

        <TextView
            android:id="@+id/id_record_adapter_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/color_adapter_title_normal"
            android:textSize="@dimen/sp_record_adapter_phone_size" />

    </LinearLayout>

</LinearLayout>