<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/selector_item_bg_small"
    android:paddingLeft="@dimen/dp_item_padding_left"
    android:paddingRight="@dimen/dp_item_padding_right"
    android:minHeight="@dimen/dp_item_min_height">

    <TextView
        android:id="@+id/tv_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/colors_item_title"
        android:textSize="@dimen/sp_main_menu_title" />

    <TextView
        android:id="@+id/tv_item_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@id/tv_item_title"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/colors_item_title"
        android:textSize="@dimen/sp_main_menu_title"
        android:visibility="gone" />

    <ToggleButton
        android:id="@+id/tog_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:background="@drawable/tog_off_bg_selector"
        android:textOff=""
        android:textOn=""
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="520dp"
            android:singleLine="true"
            android:textColor="@color/colors_item_title"
            android:textSize="32sp" />

        <ImageView
            android:id="@+id/iv_item_enter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:background="@drawable/selector_item_pointer" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/tv_item_title"
        android:background="@android:color/transparent" />

</RelativeLayout>