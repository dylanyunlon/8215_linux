<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <TextView
        android:id="@+id/tv_mute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/extdsp_attenuate_tv_mute_paddingTop"
        android:layout_marginBottom="@dimen/extdsp_attenuate_tv_mute_layout_marginBottom"
        android:text="@string/attenuate_mute"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/tv_invert"
        app:layout_constraintEnd_toEndOf="@+id/tv_invert" />

    <TextView
        android:id="@+id/tv_invert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/extdsp_attenuate_tv_invert_paddingTop"
        android:layout_marginBottom="@dimen/extdsp_attenuate_tv_invert_layout_marginBottom"
        android:text="@string/attenuate_invert"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:gravity="center"
        app:layout_constraintEnd_toStartOf="@+id/asb_lf"
        app:layout_constraintBottom_toBottomOf="parent"
        />



    <com.hcn.autoeq.view.ExtDspAttenuateSeekBar
        android:id="@+id/asb_lf"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/extdsp_fragment_attenuate_asb_lf_layout_marginTop"
        android:tag="LF"
        app:attenuate_seek_bar_top_name="@string/balance_field_lf"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="@dimen/extdsp_attenuate_asb_lf_layout_constraintHorizontal_bias"
        />

    <ToggleButton
        android:id="@+id/btn_link_lf_rf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_attenuate_link_selector"
        android:layout_marginTop="@dimen/extdsp_fragment_attenuate_btn_link_lf_rf_layout_marginTop"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text=""
        android:textOff=""
        android:textOn=""
        app:layout_constraintTop_toTopOf="@+id/tv_mute"
        app:layout_constraintBottom_toBottomOf="@+id/tv_invert"
        app:layout_constraintStart_toStartOf="@+id/asb_lf"
        app:layout_constraintEnd_toEndOf="@+id/asb_rf"
        />


    <ImageView
        android:id="@+id/extdsp_link_line_lf_rf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_attenuate_link_line"
        app:layout_constraintTop_toTopOf="@+id/btn_link_lf_rf"
        app:layout_constraintBottom_toBottomOf="@+id/btn_link_lf_rf"
        app:layout_constraintStart_toStartOf="@+id/btn_link_lf_rf"
        app:layout_constraintEnd_toEndOf="@+id/btn_link_lf_rf"
        app:layout_constraintVertical_bias="@dimen/extdsp_attenuate_extdsp_link_line_lr_rr_layout_constraintHorizontal_bias"
        />

    <com.hcn.autoeq.view.ExtDspAttenuateSeekBar
        android:id="@+id/asb_rf"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/extdsp_fragment_attenuate_asb_lf_layout_marginTop"
        android:tag="RF"
        app:attenuate_seek_bar_top_name="@string/balance_field_rf"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="@dimen/extdsp_attenuate_asb_rf_layout_constraintHorizontal_bias"
        />




    <com.hcn.autoeq.view.ExtDspAttenuateSeekBar
        android:id="@+id/asb_lr"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/extdsp_fragment_attenuate_asb_lf_layout_marginTop"
        android:tag="LR"
        app:attenuate_seek_bar_top_name="@string/balance_field_lr"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="@dimen/extdsp_attenuate_asb_lr_layout_constraintHorizontal_bias"

        />


    <ToggleButton
        android:id="@+id/btn_link_lr_rr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_attenuate_link_selector"
        android:layout_marginTop="@dimen/extdsp_fragment_attenuate_btn_link_lf_rf_layout_marginTop"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text=""
        android:textOff=""
        android:textOn=""
        app:layout_constraintTop_toTopOf="@+id/tv_mute"
        app:layout_constraintBottom_toBottomOf="@+id/tv_invert"
        app:layout_constraintStart_toStartOf="@+id/asb_lr"
        app:layout_constraintEnd_toEndOf="@+id/asb_rr"
        />


    <ImageView
        android:id="@+id/extdsp_link_line_lr_rr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_attenuate_link_line"
        app:layout_constraintTop_toTopOf="@+id/btn_link_lr_rr"
        app:layout_constraintBottom_toBottomOf="@+id/btn_link_lr_rr"
        app:layout_constraintStart_toStartOf="@+id/btn_link_lr_rr"
        app:layout_constraintEnd_toEndOf="@+id/btn_link_lr_rr"
        app:layout_constraintVertical_bias="@dimen/extdsp_attenuate_extdsp_link_line_lr_rr_layout_constraintHorizontal_bias"
        />


    <com.hcn.autoeq.view.ExtDspAttenuateSeekBar
        android:id="@+id/asb_rr"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/extdsp_fragment_attenuate_asb_lf_layout_marginTop"
        android:tag="RR"
        app:attenuate_seek_bar_top_name="@string/balance_field_rr"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="@dimen/extdsp_attenuate_asb_rr_layout_constraintHorizontal_bias"

        />



    <com.hcn.autoeq.view.ExtDspAttenuateSeekBar
        android:id="@+id/asb_subwoofer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/extdsp_fragment_attenuate_asb_lf_layout_marginTop"
        android:tag="SUBWOOFER"
        app:attenuate_seek_bar_top_name="@string/str_subwoofer1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="@dimen/extdsp_attenuate_asb_subwoofer_layout_constraintHorizontal_bias"
        />


    <com.hcn.autoeq.view.ExtDspAttenuateSeekBar
        android:id="@+id/asb_centcer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/extdsp_fragment_attenuate_asb_lf_layout_marginTop"
        android:gravity="center_horizontal"
        android:tag="CENTER"
        app:attenuate_seek_bar_top_name="@string/str_subwoofer2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="@dimen/extdsp_attenuate_asb_subwoofer2_layout_constraintHorizontal_bias"
        />

</androidx.constraintlayout.widget.ConstraintLayout>