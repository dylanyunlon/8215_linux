<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_dbb_car"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_dbb_car"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ll_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_dbb_speaker_lf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_dbb_speaker_lf_n"
        app:layout_constraintBottom_toTopOf="@+id/iv_dbb_speaker_lr"
        app:layout_constraintStart_toStartOf="@+id/iv_dbb_car"
        app:layout_constraintTop_toTopOf="@+id/iv_dbb_car" />

    <ImageView
        android:id="@+id/iv_dbb_speaker_rf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_dbb_speaker_rf_n"
        app:layout_constraintBottom_toTopOf="@+id/iv_dbb_speaker_rr"
        app:layout_constraintEnd_toEndOf="@+id/iv_dbb_car"
        app:layout_constraintTop_toTopOf="@+id/iv_dbb_car" />

    <ImageView
        android:id="@+id/iv_dbb_speaker_lr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_dbb_speaker_lr_n"
        android:layout_marginBottom="@dimen/extdsp_hlpf_iv_hlpf_speaker_lr_layout_marginBottom"
        app:layout_constraintBottom_toBottomOf="@+id/iv_dbb_car"
        app:layout_constraintStart_toStartOf="@+id/iv_dbb_car"
        app:layout_constraintTop_toBottomOf="@+id/iv_dbb_speaker_lf" />

    <ImageView
        android:id="@+id/iv_dbb_speaker_rr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_dbb_speaker_rr_n"
        android:layout_marginBottom="@dimen/extdsp_hlpf_iv_hlpf_speaker_lr_layout_marginBottom"
        app:layout_constraintBottom_toBottomOf="@+id/iv_dbb_car"
        app:layout_constraintEnd_toEndOf="@+id/iv_dbb_car"
        app:layout_constraintTop_toBottomOf="@+id/iv_dbb_speaker_rf" />

    <ImageView
        android:id="@+id/iv_dbb_speaker_subwoofer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_dbb_speaker_subwoofer_n"
        android:layout_marginStart="@dimen/extdsp_hlpf_iv_hlpf_speaker_subwoofer_layout_margin"
        app:layout_constraintBottom_toBottomOf="@+id/iv_dbb_car"
        app:layout_constraintStart_toStartOf="@+id/iv_dbb_car" />

    <ImageView
        android:id="@+id/iv_dbb_speaker_subwoofer2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_dbb_speaker_subwoofer2_n"
        android:layout_marginEnd="@dimen/extdsp_hlpf_iv_hlpf_speaker_subwoofer_layout_margin"
        app:layout_constraintBottom_toBottomOf="@+id/iv_dbb_car"
        app:layout_constraintEnd_toEndOf="@+id/iv_dbb_car"
        />

    <LinearLayout
        android:id="@+id/ll_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_dbb_touch_bg"
        app:layout_constraintStart_toEndOf="@+id/iv_dbb_car"
        tools:ignore="MissingConstraints">

        <RadioGroup
            android:id="@+id/rg_dbb_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            >

            <RadioButton
                android:id="@+id/rb_dbb_mode_fl_fr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/extdsp_dbb_mode_selector"
                android:button="@null"
                android:gravity="center"
                android:text="@string/dbb_fl_fr"
                android:textColor="@android:color/white"
                android:textSize="@dimen/extdsp_balance_mode_text_size" />

            <RadioButton
                android:id="@+id/rb_dbb_mode_rl_rr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/extdsp_hlpf_radio_button_layout_marginTop"
                android:background="@drawable/extdsp_dbb_mode_selector"
                android:button="@null"
                android:gravity="center"
                android:text="@string/dbb_rl_rr"
                android:textColor="@android:color/white"
                android:textSize="@dimen/extdsp_balance_mode_text_size" />

            <RadioButton
                android:id="@+id/rb_dbb_mode_subwoofer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/extdsp_hlpf_radio_button_layout_marginTop"
                android:background="@drawable/extdsp_dbb_mode_selector"
                android:button="@null"
                android:gravity="center"
                android:text="@string/str_subwoofer1"
                android:textColor="@android:color/white"
                android:textSize="@dimen/extdsp_balance_mode_text_size" />

            <RadioButton
                android:id="@+id/rb_dbb_mode_subwoofer2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/extdsp_hlpf_radio_button_layout_marginTop"
                android:background="@drawable/extdsp_dbb_mode_selector"
                android:button="@null"
                android:gravity="center"
                android:text="@string/str_subwoofer2"
                android:textColor="@android:color/white"
                android:textSize="@dimen/extdsp_balance_mode_text_size" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_reset_dbb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/extdsp_dbb_reset_selector"
            android:layout_marginTop="@dimen/extdsp_hlpf_radio_button_layout_marginTop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/rg_dbb_mode"
            app:layout_constraintStart_toStartOf="@+id/rg_dbb_mode"
            app:layout_constraintTop_toBottomOf="@+id/rg_dbb_mode"
            />

    </LinearLayout>



    <ImageView
        android:id="@+id/iv_dbb_touch_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_dbb_touch_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ll_group"
        app:layout_constraintTop_toTopOf="parent" />

    <com.hcn.autoeq.view.ExtDspDbbView
        android:id="@+id/v_dbb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_dbb_touch_fg"
        app:layout_constraintBottom_toBottomOf="@+id/iv_dbb_touch_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_dbb_touch_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_dbb_touch_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_dbb_touch_bg" />

</androidx.constraintlayout.widget.ConstraintLayout>