<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/fydsp_band_user_paddingStart"
    android:paddingEnd="@dimen/fydsp_band_user_paddingStart"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <ImageView
        android:id="@+id/iv_band_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fydsp_iv_band_line_margin_bottom"
        android:background="@drawable/fydsp_band_line"
        app:layout_constraintBottom_toTopOf="@+id/tv_g_title"
        app:layout_constraintEnd_toEndOf="@+id/tv_q_title" />

    <TextView
        android:id="@+id/tv_gain_max"
        style="@style/fydsp_scroll_title_style"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/fydsp_tv_gain_margin_bottom"
        android:textColor="#9ec3e3"
        app:layout_constraintBottom_toTopOf="@+id/tv_gain_center"
        app:layout_constraintEnd_toEndOf="@+id/tv_gain_min"
        tools:text="7" />

    <TextView
        android:id="@+id/tv_gain_center"
        style="@style/fydsp_scroll_title_style"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/fydsp_tv_gain_margin_bottom"
        android:text="0"
        android:textColor="#9ec3e3"
        app:layout_constraintBottom_toTopOf="@+id/tv_gain_min"
        app:layout_constraintEnd_toEndOf="@+id/tv_gain_min" />

    <TextView
        android:id="@+id/tv_gain_min"
        style="@style/fydsp_scroll_title_style"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/fydsp_tv_gain_min_margin_bottom"
        android:textColor="#9ec3e3"
        app:layout_constraintBottom_toTopOf="@+id/tv_g_title"
        app:layout_constraintEnd_toStartOf="@+id/iv_band_line"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="-7" />

    <TextView
        android:id="@+id/tv_g_title"
        style="@style/fydsp_scroll_title_style"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/fydsp_tv_g_title_margin_bottom"
        android:text="FC:"
        app:layout_constraintBottom_toTopOf="@+id/tv_q_title"
        app:layout_constraintEnd_toEndOf="@+id/iv_band_line" />

    <TextView
        android:id="@+id/tv_q_title"
        style="@style/fydsp_scroll_title_style"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/fydsp_tv_q_title_margin_bottom"
        android:text="Q:"
        app:layout_constraintBottom_toBottomOf="@+id/hsv_band"
        app:layout_constraintEnd_toEndOf="@+id/tv_g_title" />

    <HorizontalScrollView
        android:id="@+id/hsv_band"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_reset_band"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_band_line"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/ll_band"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="@dimen/fydsp_ll_band_minWidth"
            android:orientation="vertical">
            <!-- 此处控件高度要写明，不然不显示 -->
            <com.auto.hequalizer.EqualizerSurface
                android:id="@+id/es_freq"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fydsp_es_freq_layout_height"
                android:layout_gravity="center_horizontal"
                android:background="@color/eq_bg_color"
                app:background_color="@android:color/transparent"
                app:bar_color="@android:color/transparent"
                app:bar_text_color="@android:color/white"
                app:bar_text_shadow_color="@color/silver"
                app:bar_text_size="0sp"
                app:bar_width="@dimen/dsp_frequency_bar_width"
                app:freq_curve_bg_shader_color_1="@color/fydsp_bg_shader_color_1"
                app:freq_curve_bg_shader_color_2="@color/fydsp_bg_shader_color_2"
                app:freq_curve_bg_shader_color_3="@color/fydsp_bg_shader_color_3"
                app:freq_curve_bg_shader_color_4="@color/fydsp_bg_shader_color_4"
                app:freq_curve_bg_shader_color_5="@color/fydsp_bg_shader_color_5"
                app:freq_curve_color_1="@color/fydsp_fragment_band_freq_curve_color_1"
                app:freq_curve_color_2="@color/fydsp_fragment_band_freq_curve_color_1"
                app:freq_curve_width_1="@dimen/fydsp_freq_curve_width_1"
                app:freq_curve_width_2="@dimen/fydsp_freq_curve_width_2"
                app:gain_text_color="@android:color/white"
                app:gain_text_size="0sp"
                app:heq_bar_knob_color="#61afff" />

        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btn_band_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fydsp_sp_reverb_layout_marginStart"
        android:background="@drawable/fydsp_band_mode_selector"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="@dimen/fydsp_textSize"
        app:layout_constraintBottom_toBottomOf="@+id/btn_reset_band"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_reset_band"
        tools:text="新闻" />

    <RadioGroup
        android:id="@+id/rg_user_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_reset_band">

        <RadioButton
            android:id="@+id/rb_fydsp_user_mode_user0"
            style="@style/fydsp_radio_band_user_style"
            android:tag="USER1"
            android:text="@string/band_user0" />

        <RadioButton
            android:id="@+id/rb_fydsp_user_mode_user1"
            style="@style/fydsp_radio_band_user_style"
            android:tag="USER2"
            android:text="@string/band_user1" />

        <RadioButton
            android:id="@+id/rb_fydsp_user_mode_user2"
            style="@style/fydsp_radio_band_user_style"
            android:tag="USER3"
            android:text="@string/band_user2" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_reset_band"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/fydsp_band_reset_selector"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/rg_user_mode"
        app:layout_constraintEnd_toStartOf="@+id/btn_move_scroll" />

    <ImageView
        android:id="@+id/btn_move_scroll"
        android:layout_width="@dimen/fydsp_move_scroll_btn_width"
        android:layout_height="@dimen/fydsp_move_scroll_btn_height"
        android:paddingHorizontal="@dimen/fydsp_move_scroll_btn_padding"
        android:src="@drawable/fydsp_icon_arrow_right"
        app:layout_constraintBottom_toBottomOf="@+id/rg_user_mode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rg_user_mode" />

</androidx.constraintlayout.widget.ConstraintLayout>
