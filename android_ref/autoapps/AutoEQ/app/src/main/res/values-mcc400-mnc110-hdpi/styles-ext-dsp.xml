<resources>

    <style name="extdsp_radio_band_user_style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:textColor">@drawable/extdsp_radio_text_selector</item>
        <item name="android:textSize">@dimen/extdsp_band_user_textSize</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginEnd">@dimen/extdsp_band_button_marginEnd</item>
    </style>

    <!-- Customize your theme here. -->
    <style name="extdsp_radio_button_style">
        <!-- Customize your theme here. -->
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/radio_button_selector</item>
        <item name="android:button">@null</item>
        <item name="android:textColor">@drawable/extdsp_radio_text_selector</item>
        <item name="android:textSize">30sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
