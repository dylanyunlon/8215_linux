<resources>

    <style name="extdsp_radio_band_user_style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:textColor">@drawable/extdsp_radio_text_selector</item>
        <item name="android:textSize">@dimen/extdsp_band_user_textSize</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/extdsp_band_user_selector</item>
        <item name="android:layout_marginEnd">@dimen/extdsp_band_button_marginEnd</item>
    </style>

    <!-- balance -->
    <style name="extdsp_balance_mode_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@drawable/extdsp_balance_btn_mode_selector</item>
        <item name="android:button">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">@dimen/extdsp_band_user_textSize</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
