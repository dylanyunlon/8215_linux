<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/q_item_paddingHorizontal">

    <TextView
        android:id="@+id/tv_csc_center_fre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/q_item_tv_csc_center_fre_layout_marginBottom"
        android:gravity="center"
        android:text="20"
        android:textColor="#66FFFFFF"
        android:textSize="@dimen/q_item_tv_csc_center_fre_textSize" />


    <TextView
        android:id="@+id/tv_csc_q_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/csc_asp_btn_q"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/q_item_tv_csc_center_q_value_textSize" />
</LinearLayout>
