<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 边框渐变层 -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#19FFFFFF"/> <!-- 10% 透明度白 -->
            <corners android:radius="16dp"/>
            <stroke
                android:width="2dp"
                android:color="#00000000"/> <!-- 实际颜色由渐变控制 -->
        </shape>
    </item>

    <!-- 原有背景层 -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="#ff212633"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>