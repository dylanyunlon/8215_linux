<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_front"
    android:paddingLeft="@dimen/nine_dts_fragment_sound_focus_nine_common_seekbar_paddingLeft"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_top2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="100"
        android:textColor="@color/nine_text_color_8"
        android:textSize="@dimen/x24"
        app:layout_constraintEnd_toEndOf="@+id/sbr_band_font"
        app:layout_constraintStart_toStartOf="@+id/sbr_band_font"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_scale"
        android:layout_width="@dimen/x30"
        android:layout_height="@dimen/nine_common_seekbar_sb_nine_height"
        android:layout_marginTop="@dimen/y20"
        android:paddingVertical="@dimen/y15"
        android:scaleType="fitXY"
        android:src="@drawable/nine_seek_bar_scale_small"
        app:layout_constraintBottom_toTopOf="@+id/tv_down"
        app:layout_constraintEnd_toStartOf="@+id/sbr_band_font"
        app:layout_constraintTop_toBottomOf="@+id/tv_top2" />

    <TextView
        android:id="@+id/tv_scale_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/x2"
        android:text="100"
        android:textColor="@color/nine_text_color_3"
        android:textSize="@dimen/x20"
        app:layout_constraintEnd_toStartOf="@+id/iv_scale"
        app:layout_constraintTop_toTopOf="@+id/iv_scale" />

    <TextView
        android:id="@+id/tv_scale_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/x2"
        android:text="50"
        android:textColor="@color/nine_text_color_3"
        android:textSize="@dimen/x20"
        app:layout_constraintBottom_toBottomOf="@+id/iv_scale"
        app:layout_constraintEnd_toStartOf="@+id/iv_scale"
        app:layout_constraintTop_toTopOf="@+id/iv_scale" />

    <TextView
        android:id="@+id/tv_scale_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/x2"
        android:text="0"
        android:textColor="@color/nine_text_color_3"
        android:textSize="@dimen/x20"
        app:layout_constraintBottom_toBottomOf="@+id/iv_scale"
        app:layout_constraintEnd_toStartOf="@+id/iv_scale" />

    <com.hcn_library.view.SeekBarRotator
        android:id="@+id/sbr_band_font"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/y20"
        android:layout_marginEnd="@dimen/x50"
        app:layout_constraintBottom_toTopOf="@+id/tv_down"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_top2">

        <SeekBar
            android:id="@+id/sb_nine"
            android:layout_width="@dimen/nine_common_seekbar_sb_nine_height"
            android:layout_height="wrap_content"
            android:background="@null"
            android:maxHeight="@dimen/y28"
            android:minHeight="@dimen/y28"
            android:paddingStart="@dimen/y15"
            android:paddingEnd="@dimen/y15"
            android:splitTrack="false"
            android:progressDrawable="@drawable/nine_progress_bg_selector"
            android:thumb="@drawable/nine_seek_bar_thumb"
            android:thumbOffset="@dimen/y12" />
    </com.hcn_library.view.SeekBarRotator>

    <TextView
        android:id="@+id/tv_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="位置"
        android:textColor="@color/nine_text_color_9"
        android:textSize="@dimen/x24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/sbr_band_font"
        app:layout_constraintStart_toStartOf="@+id/sbr_band_font"
        app:layout_constraintTop_toBottomOf="@+id/sbr_band_font" />
</androidx.constraintlayout.widget.ConstraintLayout>