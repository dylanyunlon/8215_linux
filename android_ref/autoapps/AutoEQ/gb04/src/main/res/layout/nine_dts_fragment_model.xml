<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_dts_model"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/nine_dts_fragment_model_paddingHorizontal"
    android:paddingTop="@dimen/nine_dts_fragment_model_paddingTop">

    <LinearLayout
        android:id="@+id/ll_theater"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/nine_dts_model_ll_bg_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/x20"
        android:paddingTop="@dimen/y20"
        app:layout_constraintEnd_toStartOf="@+id/ll_music"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_theater"
            android:layout_width="@dimen/nine_dts_fragment_model_iv_theater_width"
            android:layout_height="@dimen/nine_dts_fragment_model_iv_theater_height"
            android:clickable="false"
            android:focusable="false"
            android:scaleType="centerCrop"
            android:src="@drawable/nine_dts_model_theater" />

        <TextView
            android:id="@+id/tv_theater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/y20"
            android:clickable="false"
            android:focusable="false"
            android:gravity="start"
            android:text="@string/nine_dts_mode_theater"
            android:textColor="@color/nine_text_color_8"
            android:textSize="@dimen/x48" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/nine_dts_model_ll_bg_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/x20"
        android:paddingTop="@dimen/y20"
        app:layout_constraintEnd_toStartOf="@+id/ll_professional"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/ll_theater"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_music"
            android:layout_width="@dimen/nine_dts_fragment_model_iv_theater_width"
            android:layout_height="@dimen/nine_dts_fragment_model_iv_theater_height"
            android:clickable="false"
            android:focusable="false"
            android:scaleType="centerCrop"
            android:src="@drawable/nine_dts_model_music" />

        <TextView
            android:id="@+id/tv_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/y20"
            android:clickable="false"
            android:focusable="false"
            android:gravity="start"
            android:text="@string/nine_dts_mode_music"
            android:textColor="@color/nine_text_color_8"
            android:textSize="@dimen/x48" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_professional"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/nine_dts_model_ll_bg_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/x20"
        android:paddingTop="@dimen/y20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/ll_music"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_professional"
            android:layout_width="@dimen/nine_dts_fragment_model_iv_theater_width"
            android:layout_height="@dimen/nine_dts_fragment_model_iv_theater_height"
            android:clickable="false"
            android:focusable="false"
            android:scaleType="centerCrop"
            android:src="@drawable/nine_dts_model_professional" />

        <TextView
            android:id="@+id/tv_professional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/y20"
            android:clickable="false"
            android:focusable="false"
            android:gravity="start"
            android:text="@string/nine_dts_mode_professional"
            android:textColor="@color/nine_text_color_8"
            android:textSize="@dimen/x48" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>