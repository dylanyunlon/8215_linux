<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_sound_car"
        android:layout_width="@dimen/x1100"
        android:layout_height="@dimen/y770"
        android:layout_marginTop="@dimen/y152"
        android:src="@drawable/nine_sound_focus_car"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_sound_front_l"
        android:layout_width="@dimen/x270"
        android:layout_height="@dimen/y270"
        android:layout_marginStart="@dimen/x200"
        android:layout_marginBottom="@dimen/y540"
        android:src="@drawable/icon_nine_audio_left_03"
        app:layout_constraintBottom_toBottomOf="@+id/iv_sound_car"
        app:layout_constraintStart_toStartOf="@+id/iv_sound_car" />

    <ImageView
        android:id="@+id/iv_sound_rear_l"
        android:layout_width="@dimen/x270"
        android:layout_height="@dimen/y270"
        android:layout_marginStart="@dimen/x18"
        android:layout_marginBottom="@dimen/y350"
        android:src="@drawable/icon_nine_audio_left_10"
        app:layout_constraintBottom_toBottomOf="@+id/iv_sound_car"
        app:layout_constraintStart_toStartOf="@+id/iv_sound_car" />

    <ImageView
        android:id="@+id/iv_sound_forefront"
        android:layout_width="@dimen/x270"
        android:layout_height="@dimen/y270"
        android:layout_marginBottom="@dimen/y620"
        android:src="@drawable/icon_nine_audio_forefront_07"
        app:layout_constraintBottom_toBottomOf="@+id/iv_sound_car"
        app:layout_constraintEnd_toEndOf="@+id/iv_sound_car"
        app:layout_constraintStart_toStartOf="@+id/iv_sound_car" />

    <ImageView
        android:id="@+id/iv_sound_front_r"
        android:layout_width="@dimen/x270"
        android:layout_height="@dimen/y270"
        android:layout_marginEnd="@dimen/x210"
        android:layout_marginBottom="@dimen/y540"
        android:src="@drawable/icon_nine_audio_right_03"
        app:layout_constraintBottom_toBottomOf="@+id/iv_sound_car"
        app:layout_constraintEnd_toEndOf="@+id/iv_sound_car" />

    <ImageView
        android:id="@+id/iv_sound_rear_r"
        android:layout_width="@dimen/x270"
        android:layout_height="@dimen/y270"
        android:layout_marginEnd="@dimen/x20"
        android:layout_marginBottom="@dimen/y350"
        android:src="@drawable/icon_nine_audio_right_10"
        app:layout_constraintBottom_toBottomOf="@+id/iv_sound_car"
        app:layout_constraintEnd_toEndOf="@+id/iv_sound_car" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_sound_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/y100"
        android:background="@drawable/nine_dsp_seek_bar_group_bg"
        android:orientation="vertical"
        android:paddingVertical="@dimen/y20"
        android:paddingLeft="@dimen/x40"
        android:paddingRight="@dimen/y18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

       <!-- <com.example.gb04.view.NineCommonSeekBar
            android:id="@+id/sb_sound_front"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="Front"
            app:layout_constraintEnd_toStartOf="@+id/sb_sound_rear"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:nine_seek_bar_down_name="@string/nine_tv_front"
            app:nine_seek_bar_top_name_two="10" />

        <com.example.gb04.view.NineCommonSeekBar
            android:id="@+id/sb_sound_rear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="Rear"
            app:layout_constraintEnd_toStartOf="@+id/sb_sound_center"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/sb_sound_front"
