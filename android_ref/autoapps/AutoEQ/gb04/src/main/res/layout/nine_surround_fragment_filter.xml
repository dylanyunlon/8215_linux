<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/nine_surround_fragment_filter_marginTop"
    android:layout_marginEnd="@dimen/nine_surround_fragment_filter_marginEnd"
    android:layout_marginBottom="@dimen/nine_surround_fragment_filter_marginBottom">

    <RadioGroup
        android:id="@+id/rg_surround"
        android:layout_width="@dimen/x720"
        android:layout_height="@dimen/y88"
        android:layout_marginStart="@dimen/nine_surround_fragment_filter_rg_surround_marginStart"
        android:background="@drawable/nine_dsp_bar_basic_bg"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RadioButton
            android:id="@+id/rb_gain"
            style="@style/nine_dts_bar_radio_button_style"
            android:text="@string/nine_btn_surround_bar_gain" />

        <RadioButton
            android:id="@+id/rb_delay"
            style="@style/nine_dts_bar_radio_button_style"
            android:text="@string/nine_btn_surround_bar_delay" />
    </RadioGroup>

    <TextView
        android:id="@+id/tv_surround_reset"
        android:layout_width="@dimen/x180"
        android:layout_height="@dimen/y88"
        android:background="@drawable/nine_dts_btn_bg_selector"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/nine_btn_reset"
        android:textColor="@color/nine_text_color_5"
        android:textSize="@dimen/nine_surround_fragment_filter_tv_surround_reset_textSize"
        android:focusable="true"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="@+id/rg_surround"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <FrameLayout
        android:id="@+id/surround_filter_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x30"
        app:layout_constraintTop_toBottomOf="@id/rg_surround" />
</androidx.constraintlayout.widget.ConstraintLayout>