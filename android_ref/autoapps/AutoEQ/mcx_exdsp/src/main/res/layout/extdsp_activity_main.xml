<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/eq_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6" />

    <RadioGroup
        android:id="@+id/rg_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/extdsp_main_footer_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.hcn.autoeq.view.DrawableCenterRadioButton
            android:id="@+id/rb_extdsp_band"
            style="@style/extdsp_radio_button_style"
            android:paddingTop="@dimen/extdsp_rb_extdsp_band_paddingTop"
            android:drawableStart="@drawable/extdsp_band_selector" />

        <com.hcn.autoeq.view.DrawableCenterRadioButton
            android:id="@+id/rb_extdsp_balance"
            style="@style/extdsp_radio_button_style"
            android:drawableStart="@drawable/extdsp_balance_selector" />

        <com.hcn.autoeq.view.DrawableCenterRadioButton
            android:id="@+id/rb_extdsp_attenuate"
            style="@style/extdsp_radio_button_style"
            android:drawableStart="@drawable/extdsp_balance_attenuate_selector" />

        <com.hcn.autoeq.view.DrawableCenterRadioButton
            android:id="@+id/rb_extdsp_filter"
            style="@style/extdsp_radio_button_style"
            android:drawableStart="@drawable/extdsp_filter_selector" />

        <com.hcn.autoeq.view.DrawableCenterRadioButton
            android:id="@+id/rb_extdsp_delay"
            style="@style/extdsp_radio_button_style"
            android:drawableStart="@drawable/extdsp_delay_selector" />
    </RadioGroup>

</LinearLayout>