    <!-- band -->
    <style name="extdsp_radio_button_style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@drawable/extdsp_radio_text_selector</item>
        <item name="android:textSize">@dimen/main_radiobutton_text_size</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="extdsp_scroll_title_style">
        <item name="android:textSize">@dimen/extdsp_scroll_title_textSize</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxWidth">200dp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="extdsp_radio_band_user_style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:textColor">@drawable/extdsp_radio_text_selector</item>
        <item name="android:textSize">@dimen/extdsp_band_user_textSize</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/extdsp_band_user_selector</item>
        <item name="android:layout_marginEnd">@dimen/extdsp_band_button_marginEnd</item>
    </style>

