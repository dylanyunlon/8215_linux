<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:autoeq="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@drawable/extdsp_main_background">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/logo"
        android:layout_marginStart="133dp"
        android:layout_marginTop="3dp"
        app:layout_constraintBottom_toTopOf="@+id/balance_mode_main"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/balance_mode_main"
        style="@style/extdsp_balance_mode_style"
        android:text="@string/balance_model_master"
        android:textSize="@dimen/extdsp_fragment_balance_balance_mode_main_textSize"
        android:layout_marginTop="@dimen/extdsp_fragment_balance_balance_mode_main_layout_marginTop"
        android:layout_marginStart="@dimen/extdsp_fragment_balance_balance_mode_main_layout_marginStart"
        app:layout_constraintBottom_toTopOf="@+id/balance_mode_co"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/balance_mode_co"
        style="@style/extdsp_balance_mode_style"
        android:text="@string/balance_model_copilot"
        android:textSize="@dimen/extdsp_fragment_balance_balance_mode_main_textSize"
        android:layout_marginTop="@dimen/balance_mode_co_layout_Top"
        app:layout_constraintEnd_toEndOf="@+id/balance_mode_main"
        app:layout_constraintStart_toStartOf="@+id/balance_mode_main"
        app:layout_constraintTop_toBottomOf="@+id/balance_mode_main" />

    <Button
        android:id="@+id/balance_mode_rear"
        style="@style/extdsp_balance_mode_style"
        android:text="@string/balance_model_user"
        android:textSize="@dimen/extdsp_fragment_balance_balance_mode_main_textSize"
        android:layout_marginTop="@dimen/balance_mode_co_layout_Top"
        app:layout_constraintEnd_toEndOf="@+id/balance_mode_main"
        app:layout_constraintStart_toStartOf="@+id/balance_mode_main"
        app:layout_constraintTop_toBottomOf="@+id/balance_mode_co" />

    <Button
        android:id="@+id/balance_mode_whole"
        style="@style/extdsp_balance_mode_style"
        android:text="@string/balance_model_full"
        android:textSize="@dimen/extdsp_fragment_balance_balance_mode_main_textSize"
        android:layout_marginTop="@dimen/balance_mode_co_layout_Top"
        app:layout_constraintEnd_toEndOf="@+id/balance_mode_main"
        app:layout_constraintStart_toStartOf="@+id/balance_mode_main"
        app:layout_constraintTop_toBottomOf="@+id/balance_mode_rear" />

    <com.hcn.autoeq.view.BalanceView
        android:id="@+id/id_eq_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_balance_mode_bg"
        app:layout_constraintStart_toEndOf="@id/balance_mode_main"
        app:layout_constraintBottom_toBottomOf="@+id/balance_mode_whole"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/logo"
        autoeq:thumb="@drawable/extdsp_balance_mode_selector"/>

    <Button
        android:id="@+id/balance_front"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_balance_up_selector"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:layout_constraintBottom_toTopOf="@+id/id_eq_balance"
        app:layout_constraintEnd_toEndOf="@+id/id_eq_balance"
        app:layout_constraintStart_toStartOf="@+id/id_eq_balance" />

    <Button
        android:id="@+id/balance_rear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_balance_down_selector"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:layout_constraintEnd_toEndOf="@+id/id_eq_balance"
        app:layout_constraintStart_toStartOf="@+id/id_eq_balance"
        app:layout_constraintTop_toBottomOf="@+id/id_eq_balance" />

    <Button
        android:id="@+id/balance_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_balance_left_selector"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/id_eq_balance"
        app:layout_constraintEnd_toStartOf="@+id/id_eq_balance"
        app:layout_constraintTop_toTopOf="@+id/id_eq_balance" />

    <Button
        android:id="@+id/balance_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_balance_right_selector"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/id_eq_balance"
        app:layout_constraintStart_toEndOf="@+id/id_eq_balance"
        app:layout_constraintTop_toTopOf="@+id/id_eq_balance" />

</androidx.constraintlayout.widget.ConstraintLayout>