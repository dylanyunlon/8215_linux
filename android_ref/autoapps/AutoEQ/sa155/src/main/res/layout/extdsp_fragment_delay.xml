<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@drawable/extdsp_main_background">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/logo"
        app:layout_constraintBottom_toTopOf="@+id/iv_delay_car"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/iv_delay_car"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_delay_car"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/iv_delay_speaker_lf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_delay_speaker_lf_p"
        android:layout_marginTop="@dimen/iv_delay_speaker_lf_layout_Top"
        android:layout_marginStart="@dimen/iv_delay_speaker_lf_layout_Start"
        app:layout_constraintStart_toEndOf="@+id/rksb_lf"
        app:layout_constraintTop_toTopOf="@+id/iv_delay_car" />

    <ImageView
        android:id="@+id/iv_delay_speaker_rf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/iv_delay_speaker_lf_layout_Start"
        android:background="@drawable/extdsp_delay_speaker_rf_p"
        app:layout_constraintEnd_toStartOf="@+id/rksb_rf"
        app:layout_constraintTop_toTopOf="@+id/iv_delay_speaker_lf" />

    <ImageView
        android:id="@+id/iv_delay_speaker_lr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_delay_speaker_lr_p"
        android:layout_marginTop="@dimen/iv_delay_speaker_lr_layout_Top"
        app:layout_constraintStart_toStartOf="@+id/iv_delay_speaker_lf"
        app:layout_constraintTop_toBottomOf="@+id/iv_delay_speaker_lf" />

    <ImageView
        android:id="@+id/iv_delay_speaker_rr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_delay_speaker_rr_p"
        app:layout_constraintEnd_toEndOf="@+id/iv_delay_speaker_rf"
        app:layout_constraintTop_toTopOf="@+id/iv_delay_speaker_lr" />

    <com.hcn.autoeq.view.ExtDspDelayView2
        android:id="@+id/rksb_lf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="LF"
        android:layout_marginTop="@dimen/iv_delay_rksb_lf_layout_Top"
        android:layout_marginEnd="@dimen/iv_delay_rksb_lf_layout_Start"
        app:layout_constraintBottom_toTopOf="@+id/rksb_lr"
        app:layout_constraintEnd_toStartOf="@+id/iv_delay_car"
        app:layout_constraintTop_toTopOf="parent" />

    <com.hcn.autoeq.view.ExtDspDelayView2
        android:id="@+id/rksb_rf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="RF"
        android:layout_marginTop="@dimen/iv_delay_rksb_lf_layout_Top"
        android:layout_marginStart="@dimen/iv_delay_rksb_lf_layout_Start"
        app:layout_constraintBottom_toBottomOf="@+id/rksb_lf"
        app:layout_constraintStart_toEndOf="@+id/iv_delay_car"
        app:layout_constraintTop_toTopOf="@+id/rksb_lf" />

    <com.hcn.autoeq.view.ExtDspDelayView2
        android:id="@+id/rksb_lr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="LR"
        android:layout_marginBottom="@dimen/iv_delay_rksb_lf_layout_Top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rksb_lf"
        app:layout_constraintStart_toStartOf="@+id/rksb_lf"
        app:layout_constraintTop_toBottomOf="@+id/rksb_lf" />

    <com.hcn.autoeq.view.ExtDspDelayView2
        android:id="@+id/rksb_rr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="RR"
        android:layout_marginBottom="@dimen/iv_delay_rksb_lf_layout_Top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rksb_rf"
        app:layout_constraintStart_toStartOf="@+id/rksb_rf"
        app:layout_constraintTop_toBottomOf="@+id/rksb_rf" />

    <Button
        android:id="@+id/btn_reset_delay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/extdsp_band_reset_selector"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>