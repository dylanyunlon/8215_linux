<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- TODO: Update blank fragment layout -->
    <com.auto.hequalizer.EqualizerSurface
        android:id="@+id/frequencyResponse"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dsp_frequency_layout_height"
        android:layout_marginStart="@dimen/dsp_frequency_layout_padding"
        android:layout_marginEnd="@dimen/dsp_frequency_layout_padding"
        android:background="@color/eq_bg_color"
        app:bar_width="@dimen/dsp_frequency_bar_width"
        app:bar_color="@color/bar_color"
        app:gain_text_color="@android:color/white"
        app:gain_text_size="@dimen/dsp_frequency_gain_tv_size"
