<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/csc_asp_tab_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/equalizer_csc_asp_tab_view_layout_marginTop"
        android:background="@drawable/csc_asp_main_top_bg"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/csc_asp_equalizer_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/equalizer_csc_asp_equalizer_chart_bg_layout_marginTop"
        android:background="@drawable/csc_asp_band_seekbar_bg"
        app:layout_constraintEnd_toEndOf="@+id/csc_asp_tab_view"
        app:layout_constraintStart_toStartOf="@+id/csc_asp_tab_view"
        app:layout_constraintTop_toBottomOf="@+id/csc_asp_tab_view" />

    <LinearLayout
        android:id="@+id/ll_text_group"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/equalizer_ll_text_group_layout_height"
        android:layout_marginEnd="@dimen/equalizer_ll_text_group_layout_marginEnd"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/csc_asp_equalizer_bg"
        app:layout_constraintEnd_toStartOf="@+id/csc_asp_equalizer_bg"
        app:layout_constraintTop_toTopOf="@+id/csc_asp_equalizer_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="+15"
            android:textColor="@android:color/white"
            android:textSize="@dimen/equalizer_ll_text_group_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="+10"
            android:textColor="@android:color/white"
            android:textSize="@dimen/equalizer_ll_text_group_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="+5"
            android:textColor="@android:color/white"
            android:textSize="@dimen/equalizer_ll_text_group_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0"
            android:textColor="@android:color/white"
            android:textSize="@dimen/equalizer_ll_text_group_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="-5"
            android:textColor="@android:color/white"
            android:textSize="@dimen/equalizer_ll_text_group_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="-10"
            android:textColor="@android:color/white"
            android:textSize="@dimen/equalizer_ll_text_group_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="-15"
            android:textColor="@android:color/white"
            android:textSize="@dimen/equalizer_ll_text_group_text" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hsv_csc_asp_band"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/equalizer_hsv_csc_asp_band_paddingHorizontal"
        android:layout_marginTop="@dimen/equalizer_hsv_csc_asp_band_layout_marginTop"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="@+id/csc_asp_equalizer_bg"
        app:layout_constraintStart_toStartOf="@+id/csc_asp_equalizer_bg"
        app:layout_constraintTop_toTopOf="@+id/csc_asp_equalizer_bg">

        <LinearLayout
            android:id="@+id/ll_csc_asp_seekbar_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/equalizer_hsv_csc_asp_band_layout_marginTop"
            android:gravity="center"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/equalizer_fc_value_layout_marginBottom"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/equalizersurface_fc_value"
        android:textColor="@android:color/white"
        android:textSize="@dimen/equalizer_ll_text_group_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ll_text_group"
        app:layout_constraintTop_toBottomOf="@+id/csc_asp_equalizer_bg" />

    <ImageView
        android:id="@+id/btn_move_scroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/csc_asp_btn_next_n"
        app:layout_constraintBottom_toBottomOf="@id/csc_asp_equalizer_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/csc_asp_equalizer_bg"
        app:layout_constraintTop_toTopOf="@id/csc_asp_equalizer_bg" />


    <com.hcn.autoeq.view.CustomAspTopTabView
        android:id="@+id/second_csc_asp_top_tab"
        android:layout_width="@dimen/equalizer_csc_asp_top_tab_layout_width"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/equalizer_csc_asp_top_tab_layout_marginTop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
