<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RadioGroup
        android:id="@+id/rg_band_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RadioButton
            android:id="@+id/rb_extdsp_band_user0"
            style="@style/extdsp_radio_band_user_style"
            android:layout_width="wrap_content"
            android:background="@drawable/extdsp_band_user_reverb_top_selector"
            android:text="@string/band_user0" />

        <RadioButton
            android:id="@+id/rb_extdsp_band_user1"
            style="@style/extdsp_radio_band_user_style"
            android:layout_width="wrap_content"
            android:background="@drawable/extdsp_band_user_reverb_middle_selector"
            android:text="@string/band_user1" />

        <RadioButton
            android:id="@+id/rb_extdsp_band_user2"
            style="@style/extdsp_radio_band_user_style"
            android:layout_width="wrap_content"
            android:background="@drawable/extdsp_band_user_reverb_bottom_selector"
            android:text="@string/band_user2" />
    </RadioGroup>


</androidx.constraintlayout.widget.ConstraintLayout>