        app:freq_curve_bg_shader_color_3="@color/bg_shader_color_6"
        app:freq_curve_bg_shader_color_4="@color/bg_shader_color_6"
        app:freq_curve_bg_shader_color_5="@color/bg_shader_color_6"
        app:freq_curve_color_1="@color/bg_shader_color_6"
        app:freq_curve_color_2="@color/bg_shader_color_6"
        app:freq_curve_width_1="@dimen/dsp_freq_curve_width_1"
        app:freq_curve_width_2="@dimen/dsp_freq_curve_width_2"
        app:gain_text_color="@color/xt540_text_color_translate"
        app:gain_text_size="@dimen/dsp_frequency_gain_tv_size"
        app:heq_bar_knob_color="@color/bar_knob_color"
        tools:ignore="MissingConstraints" />
</androidx.constraintlayout.widget.ConstraintLayout>