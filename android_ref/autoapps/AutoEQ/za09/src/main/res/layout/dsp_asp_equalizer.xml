<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- TODO: Update blank fragment layout -->
    <com.auto.hequalizer.EqualizerSurface
        android:id="@+id/frequencyResponse"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dsp_frequency_layout_height"
        android:layout_marginStart="@dimen/dsp_frequency_layout_padding"
        android:layout_marginEnd="@dimen/dsp_frequency_layout_padding"
        android:background="@null"
        app:gridlines_color="@color/xt540_text_color_translate"
        android:foreground="@drawable/dsp_eq_seekbar_bg"
        app:bar_color="@color/xt540_text_color_translate"
        app:bar_text_color="@color/xt540_text_color_translate"
        app:bar_text_shadow_color="@color/xt540_text_color_translate"
        app:bar_text_size="@dimen/dsp_frequency_bar_tv_size"
        app:bar_width="@dimen/dsp_frequency_bar_width"
        app:freq_curve_bg_shader_color_1="@color/bg_shader_color_6"
