<resources>

    <style name="asp_mode_btn">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@drawable/radio_text_selector</item>
        <item name="android:layout_width">@dimen/asp_reverb_width</item>
        <item name="android:layout_height">@dimen/asp_reverb_height</item>
        <item name="android:layout_marginStart">25dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">1</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:button">@null</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">@dimen/asp_reverb_bottom</item>
        <item name="android:gravity">center_horizontal|bottom</item>
    </style>

    <!-- Customize your theme here. -->
    <style name="RadioButtonStyle">
        <!-- Customize your theme here. -->
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/radio_button_selector</item>
        <item name="android:button">@null</item>
        <item name="android:textColor">@drawable/radio_text_selector</item>
        <item name="android:textSize">@dimen/main_radiobutton_text_size</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>