<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/iv_reset_mode_dialog_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/csc_asp_user_mode_bg_reset"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_text_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxWidth="@dimen/reset_dialog_content_maxWidth"
        android:text="@string/reset_dialog_content"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/reset_dialog_content_textSize"
        app:layout_constraintBottom_toBottomOf="@+id/line_view"
        app:layout_constraintEnd_toEndOf="@+id/iv_reset_mode_dialog_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_reset_mode_dialog_bg"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/line_view"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_reset_mode_dialog_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_reset_mode_dialog_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_reset_mode_dialog_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_reset_mode_dialog_bg" />

    <ImageButton
        android:id="@+id/btn_csc_asp_user_reset_mode_ok"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:src="@drawable/csc_asp_user_mode_icon_reset_ok"
        app:layout_constraintBottom_toBottomOf="@+id/iv_reset_mode_dialog_bg"
        app:layout_constraintEnd_toStartOf="@+id/btn_csc_asp_user_reset_mode_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/line_view" />


    <ImageButton
        android:id="@+id/btn_csc_asp_user_reset_mode_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:src="@drawable/csc_asp_user_mode_icon_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_csc_asp_user_reset_mode_ok"
        app:layout_constraintTop_toTopOf="@+id/btn_csc_asp_user_reset_mode_ok" />


</androidx.constraintlayout.widget.ConstraintLayout>
