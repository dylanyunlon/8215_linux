<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_music_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_artist_height"
    android:orientation="vertical"
    tools:ignore="MissingDefaultResource">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginEnd="10dp"
        tools:ignore="UselessParent">

        <ImageView
            android:id="@+id/ivAlbumIcon"
            android:layout_width="@dimen/music_list_item_music_icon"
            android:layout_height="@dimen/music_list_item_music_icon"
            android:scaleType="fitXY"
            android:contentDescription="@string/todo" />

        <LinearLayout
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/tvAlbumName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@drawable/list_text_color"
                android:textSize="@dimen/item_artist_list_albumname" />

            <TextView
                android:id="@+id/tvAlbumTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/list_text_color_tip"
                android:textSize="@dimen/item_artist_list_albumtotal" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>