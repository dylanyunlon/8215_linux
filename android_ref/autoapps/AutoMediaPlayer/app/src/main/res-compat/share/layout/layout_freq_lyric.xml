<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MissingDefaultResource">

    <LinearLayout
        android:id="@+id/lin_lyric"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.hcn.media_view.lyrics.LyricsView
            android:id="@+id/lyrics_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/tvNoLyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="15dp"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:padding="2dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0.6"
            android:singleLine="true"
            android:text="@string/StrNoLrc"
            android:textColor="@color/id3_text_color"
            android:textSize="32.0sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lin_freq"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <com.hcn.media_view.PlayFlashView
            android:id="@+id/FrequencyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="15dp"
            android:alpha="0.5" />
    </LinearLayout>

</FrameLayout>
