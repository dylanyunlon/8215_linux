<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:contentDescription="mcc153-music"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <include
        layout="@layout/layout_music_id3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewpager_center"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/ivPageBg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:background="@drawable/page_1"
            android:contentDescription="@string/todo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:gravity="center">

            <Button
                android:id="@+id/btnPage0"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:alpha="0"
                style="?android:attr/buttonBarButtonStyle" />

            <Button
                android:id="@+id/btnPage1"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:alpha="0"
                style="?android:attr/buttonBarButtonStyle" />
        </LinearLayout>
    </FrameLayout>

    <include
        android:id="@+id/layout_bottom"
        layout="@layout/layout_music_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
