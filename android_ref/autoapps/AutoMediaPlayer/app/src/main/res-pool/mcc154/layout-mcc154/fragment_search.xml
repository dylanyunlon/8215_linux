<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64.px"
        android:background="@drawable/center_tip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStorageType"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30.0px"
            android:layout_weight="1"
            android:textSize="24.0px"
            android:layout_marginStart="30.0px" />

        <ImageView
            android:layout_width="106.0px"
            android:layout_height="60.0px"
            android:background="@drawable/small_search_n" />

        <EditText
            android:id="@+id/etSearchText"
            android:layout_width="0dp"
            android:layout_height="44.0px"
            android:layout_weight="1"
            android:singleLine="true"
            android:layout_marginRight="20.0px"
            android:background="@drawable/search_text_bg"
            android:hint="@string/text_search_hint"
            android:maxLength="24"
            android:paddingLeft="20.0px"
            android:paddingRight="20.0px"
            android:textColor="#FFBDC0C5"
            android:textSize="24.0sp"
            android:layout_marginEnd="20.0px"
            android:paddingStart="20.0px"
            android:paddingEnd="20.0px" />
    </LinearLayout>

    <GridView
        android:id="@+id/gridview_music"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16.0px"
        android:layout_marginRight="16.0px"
        android:layout_marginTop="5.0px"
        android:layout_marginBottom="10.0px"
        android:cacheColorHint="@android:color/transparent"
        android:gravity="center"
        android:horizontalSpacing="4.0px"
        android:listSelector="@android:color/transparent"
        android:numColumns="1"
        android:stretchMode="columnWidth"
        android:layout_marginEnd="16.0px"
        android:layout_marginStart="16.0px" />

</LinearLayout>