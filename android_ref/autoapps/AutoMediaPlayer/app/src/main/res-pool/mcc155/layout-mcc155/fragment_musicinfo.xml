<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/rel_id3_infos"
            android:layout_width="match_parent"
            android:layout_height="@dimen/id3_info_layout_height"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="50dp"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="50dp"
            android:layout_marginRight="50dp"
            android:background="@drawable/playing_bg"
            android:padding="20dp">

            <ImageView
                android:id="@+id/ivdefalt"
                android:layout_width="@dimen/album_cover_default_width"
                android:layout_height="@dimen/album_cover_default_height"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_gravity="center"
                android:background="@drawable/zj_bg"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/ivMusicImage"
                android:layout_width="@dimen/album_cover_width"
                android:layout_height="@dimen/album_cover_height"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_gravity="center"
                android:layout_marginStart="18dp"
                android:layout_marginTop="12dp"
                android:scaleType="fitXY" />

            <com.hcn.media_view.HTextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/tv_title_margin_top"
                android:layout_toEndOf="@id/ivdefalt"
                android:drawableStart="@drawable/title_img"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center|center_vertical|start"
                android:padding="2dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="-2"
                android:shadowRadius="1.5"
                android:singleLine="true"
                android:textColor="@color/id3_text_color"
                android:textSize="28sp" />

            <!-- android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever" -->

            <com.hcn.media_view.HTextView
                android:id="@+id/tvAlbum"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvTitle"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/tv_title_margin_top"
                android:layout_toEndOf="@id/ivdefalt"
                android:drawableStart="@drawable/album_img"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center|center_vertical|start"
                android:padding="2dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="0.6"
                android:singleLine="true"
                android:textColor="@color/id3_text_color"
                android:textSize="24sp" />

            <com.hcn.media_view.HTextView
                android:id="@+id/tvArtist"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvAlbum"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/tv_title_margin_top"
                android:layout_toEndOf="@id/ivdefalt"
                android:drawableStart="@drawable/artist_img"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center|center_vertical|start"
                android:padding="2dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="0.6"
                android:singleLine="true"
                android:textColor="@color/id3_text_color"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvTotalValue"
                android:layout_width="138dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvTitle"
                android:layout_marginTop="20dp"
                android:layout_toEndOf="@id/tvAlbum"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/id3_text_color"
                android:textSize="24.0sp" />

            <Button
                android:id="@+id/btn_change_lyric"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvTotalValue"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="40dp"
                android:layout_toEndOf="@id/tvAlbum"
                android:background="@null"
                android:text="@string/frequency_label"
                android:textColor="@color/id3_text_color"
                android:textSize="24.0sp" />

            <include
                layout="@layout/layout_music_ctrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/ivdefalt"
                android:layout_marginTop="20dp" />

            <FrameLayout
                android:layout_width="@dimen/lyric_width"
                android:background="@drawable/adams_logo"
                android:layout_height="match_parent"
                android:layout_below="@id/tvTitle"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="25dp">

                <LinearLayout
                    android:id="@+id/lin_lyric"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:orientation="vertical">

                    <com.hcn.media_view.lyrics.LyricsView
                        android:id="@+id/lyrics_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp" />

                    <TextView
                        android:id="@+id/tvNoLyrics"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="15dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:gravity="center"
                        android:padding="2dp"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="0.6"
                        android:singleLine="true"
                        android:text="@string/StrNoLrc"
                        android:textColor="@color/id3_text_color"
                        android:textSize="32.0sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lin_freq"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.hcn.media_view.PlayFlashView
                        android:id="@+id/FrequencyView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="15dp"
                        android:alpha="0.5" />
                </LinearLayout>

            </FrameLayout>
        </RelativeLayout>

        <include
            layout="@layout/layout_music_seek"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_below="@id/rel_id3_infos"
            android:layout_centerHorizontal="true" />

        <View
            android:background="#CEE100"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="2dp">
        </View>
    </RelativeLayout>
</LinearLayout>