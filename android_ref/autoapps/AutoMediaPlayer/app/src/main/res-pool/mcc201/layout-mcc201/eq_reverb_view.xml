<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <RadioGroup
        android:id="@+id/id_reverb_group"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/id_reverb_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hcn_eq_mode_bg_zx"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="10dp"
            android:textSize="25dp"
            android:text="@string/eq_reverb_user"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/id_reverb_news"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-125dp"
            android:layout_marginTop="84dp"
            android:background="@drawable/hcn_eq_mode_bg_zx"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="10dp"
            android:text="@string/eq_reverb_lift"
            android:textSize="25dp"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/id_reverb_jazz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hcn_eq_mode_bg_zx"
            android:button="@null"
            android:layout_marginLeft="35dp"
            android:textSize="25dp"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="10dp"
            android:text="@string/eq_reverb_jazz"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/id_reverb_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-125dp"
            android:layout_marginTop="84dp"
            android:background="@drawable/hcn_eq_mode_bg_zx"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="10dp"
            android:text="@string/eq_reverb_dance"
            android:textSize="25dp"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/id_reverb_pop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hcn_eq_mode_bg_zx"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="10dp"
            android:textSize="25dp"
            android:layout_marginLeft="35dp"
            android:text="@string/eq_reverb_pop"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/id_reverb_electronic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-125dp"
            android:layout_marginTop="84dp"
            android:textSize="25dp"
            android:background="@drawable/hcn_eq_mode_bg_zx"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="10dp"
            android:text="@string/eq_reverb_electronic"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/id_reverb_classiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hcn_eq_mode_bg_zx"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="10dp"
            android:text="@string/eq_reverb_classiz"
            android:layout_marginLeft="35dp"
            android:textSize="25dp"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/id_reverb_movie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-125dp"
            android:layout_marginTop="84dp"
            android:background="@drawable/hcn_eq_mode_bg_zx"
            android:button="@null"
            android:textSize="25dp"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="10dp"
            android:text="@string/eq_reverb_rb"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/id_reverb_rock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hcn_eq_mode_bg_zx"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="10dp"
            android:text="@string/eq_reverb_rock"
            android:layout_marginLeft="35dp"
            android:textSize="25dp"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/id_reverb_techno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-125dp"
            android:layout_marginTop="84dp"
            android:textSize="25dp"
            android:background="@drawable/hcn_eq_mode_bg_zx"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="10dp"
            android:text="@string/eq_reverb_Absolute_music"
            android:textColor="@color/white" />
    </RadioGroup>

</LinearLayout>