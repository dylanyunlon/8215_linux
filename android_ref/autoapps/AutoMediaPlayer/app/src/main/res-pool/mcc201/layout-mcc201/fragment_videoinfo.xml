<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <FrameLayout
        android:id="@+id/fl_SurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/layout_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:orientation="vertical"
        android:visibility="visible" />

    <FrameLayout
        android:id="@+id/layout_control"
        android:layout_width="match_parent"
        android:layout_height="158dp"
        android:background="@drawable/mcc201_videoinfo_bottom_bg"
        android:layout_gravity="bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:layout_marginEnd="30dp"
            android:layout_marginStart="232dp">

            <TextView
                android:id="@+id/tvTotalValue"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/button_text_color_n"
                android:textSize="20.0sp" />

            <com.hcn.media_view.HTextView
                android:id="@+id/tvVideoName"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="@color/button_text_color_n"
                android:textSize="20.0sp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_bottom"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_gravity="bottom">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                tools:ignore="UselessParent">

                <RelativeLayout
                    android:id="@+id/layout_progress"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentTop="true">

                    <SeekBar
                        android:id="@+id/seekbar_progress"
                        android:layout_width="800dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:maxHeight="15dp"
                        android:minHeight="15dp"
                        android:layout_centerHorizontal="true"
                        android:progressDrawable="@drawable/mcc201_video_seekbar_bg"
                        android:thumb="@drawable/mcc201_seekbar_video_thumb"
                        android:thumbOffset="30dp"
                        android:paddingTop="3dp" />

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="80dp"
                        android:layout_height="35dp"
                        android:layout_toStartOf="@+id/seekbar_progress"
                        android:gravity="center"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="0.6"
                        android:singleLine="true"
                        android:textColor="#ffffff"
                        android:textSize="18.0sp" />

                    <TextView
                        android:id="@+id/tvTotalTime"
                        android:layout_width="80dp"
                        android:layout_height="35dp"
                        android:layout_toEndOf="@+id/seekbar_progress"
                        android:gravity="center"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="0.6"
                        android:singleLine="true"
                        android:textColor="#ffffff"
                        android:textSize="18.0sp" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="800dp"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@+id/layout_progress">

                    <ImageButton
                        android:id="@+id/btnEQ"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:src="@drawable/mcc201_btn_video_eq_selector"
                        android:contentDescription="@string/todo" />

                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:src="@drawable/mcc201_btn_video_prev_bg"
                        android:contentDescription="@string/todo" />

                    <ImageButton
                        android:id="@+id/btnPlay"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:src="@drawable/btn_video_play_bg"
                        android:contentDescription="@string/todo" />

                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:src="@drawable/mcc201_btn_video_next_bg"
                        android:contentDescription="@string/todo" />

                    <ImageButton
                        android:id="@+id/btnRepeatMode"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:src="@drawable/btn_video_repeat_queue_bg"
                        android:contentDescription="@string/todo" />

                    <ImageButton
                        android:id="@+id/btnList"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:src="@drawable/mcc201_btn_video_list_bg"
                        android:contentDescription="@string/todo" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutBrightness"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbBrightness"
            android:layout_width="20dp"
            android:layout_height="150dp"
            android:layout_margin="20dp"
            android:indeterminateOnly="false"
            android:progressDrawable="@drawable/main_progress_vertical" />

        <ImageView
            android:layout_width="67dp"
            android:layout_height="72dp"
            android:background="@drawable/icon_brightness"
            android:contentDescription="@string/todo" />

        <TextView
            android:id="@+id/tvBrightnessValue"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/button_text_color_n"
            android:textSize="26.0sp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutVolume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbVolume"
            android:layout_width="20dp"
            android:layout_height="150dp"
            android:layout_margin="20dp"
            android:indeterminateOnly="false"
            android:max="40"
            android:progress="10"
            android:progressDrawable="@drawable/main_progress_vertical" />

        <ImageView
            android:id="@+id/ivVolumeIcon"
            android:layout_width="67dp"
            android:layout_height="72dp"
            android:background="@drawable/icon_volume"
            android:contentDescription="@string/todo" />

        <TextView
            android:id="@+id/tvVolumeValue"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/button_text_color_n"
            android:textSize="40.0sp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSeekTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNewTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/button_text_color_n"
            android:textSize="40.0sp" />

        <TextView
            android:id="@+id/tvDelayTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/button_text_color_n"
            android:textSize="24.0sp" />
    </LinearLayout>
</FrameLayout>