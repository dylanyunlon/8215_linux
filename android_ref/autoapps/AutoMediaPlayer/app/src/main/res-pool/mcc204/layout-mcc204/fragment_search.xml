<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/center_tip_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/small_search_n" />

        <EditText
            android:id="@+id/etSearchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:background="@drawable/search_text_bg"
            android:hint="@string/text_search_hint"
            android:textColorHint="@color/gray_white"
            android:maxLength="24"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"      
            android:textColor="#FFBDC0C5"
            android:textSize="24sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/gridview_music"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:cacheColorHint="@android:color/transparent"
        android:listSelector="@android:color/transparent"
        android:divider="#FF00F6F8"
        android:dividerHeight="1dp"/>

</LinearLayout>