<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="80dp"
            android:layout_height="35dp"
            android:gravity="center|end"
            android:singleLine="true"
            android:textColor="#00f6f8"
            android:textSize="18.0sp"
            tools:text="00:01" />

        <SeekBar
            android:id="@+id/seekbar_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxHeight="93dp"
            android:minHeight="93dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:thumbOffset="26dp"
            android:progressDrawable="@drawable/video_seekbar_bg"
            android:thumb="@drawable/seekbar_thumb"
            android:splitTrack="false"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="80dp"
            android:layout_height="35dp"
            android:gravity="center|start"
            android:singleLine="true"
            android:textColor="#00f6f8"
            android:textSize="18.0sp"
            tools:text="55:32" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/video_player_bg"
        android:gravity="center">

        <ImageView
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_video_prev_bg"
            android:contentDescription="@string/todo" />

        <ImageView
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_video_play_bg"
            android:contentDescription="@string/todo" />

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_video_next_bg"
            android:contentDescription="@string/todo" />

        <ImageView
            android:id="@+id/btnRepeatMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_video_repeat_queue_bg"
            android:contentDescription="@string/todo" />

        <ImageView
            android:id="@+id/btnList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_video_list_bg"
            android:contentDescription="@string/todo" />

        <ImageView
            android:id="@+id/btnEQ"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_video_eq_bg"
            android:contentDescription="@string/todo" />
    </LinearLayout>
</LinearLayout>