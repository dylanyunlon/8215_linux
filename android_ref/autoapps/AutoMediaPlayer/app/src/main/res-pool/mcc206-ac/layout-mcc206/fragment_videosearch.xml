<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="@dimen/status_bar_height"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStorageType"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@drawable/video_list_text_color"
            android:textSize="24sp"
            android:layout_marginStart="30dp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/small_search_n" />

        <EditText
            android:id="@+id/etSearchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/search_bg"
            android:hint="@string/text_search_hint"
            android:textColorHint="@color/gray_white"
            android:maxLength="24"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textColor="#FFFFFFFF"
            android:textSize="24.0sp"
            android:paddingEnd="20dp"
            android:layout_marginEnd="20dp"
            android:paddingStart="20dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/gridview_music"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:cacheColorHint="@android:color/transparent"
        android:fastScrollEnabled="true"
        android:focusable="true"
        android:listSelector="@android:color/transparent"
        android:divider="@color/video_list_divider_color"
        android:dividerHeight="1dp"
        android:scrollbarStyle="insideInset"
        android:scrollbars="none"/>

</LinearLayout>