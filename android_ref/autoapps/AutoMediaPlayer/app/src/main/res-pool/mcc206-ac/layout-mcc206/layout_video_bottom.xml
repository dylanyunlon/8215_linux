<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_video_play_bg"/>

    <Button
        android:id="@+id/btnPrev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_video_prev_bg"
        android:layout_marginStart="5dp" />

    <LinearLayout
        android:id="@+id/layout_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0.6"
            android:singleLine="true"
            android:textColor="@color/id3_text_color"
            android:textSize="18.0sp" />

        <com.hcn.media_view.ScrollableSeekBar
            android:id="@+id/seekbar_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:maxHeight="60dp"
            android:minHeight="60dp"
            android:thumbOffset="10dp"
            android:progressDrawable="@drawable/video_seekbar_bg"
            android:thumb="@drawable/seekbar_video_thumb"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:splitTrack="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            tools:ignore="NestedWeights" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|start"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0.6"
            android:singleLine="true"
            android:textColor="@color/id3_text_color"
            android:textSize="18.0sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_video_next_bg"
        android:layout_marginEnd="5dp" />

    <Button
        android:id="@+id/btnRepeatMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_video_repeat_queue_bg" />

    <Button
        android:id="@+id/btnList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_video_list_bg" />

    <Button
        android:id="@+id/btnEQ"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        android:background="@drawable/btn_video_eq_bg" />
</LinearLayout>