<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="mcc207-music"
    tools:ignore="HardcodedText">

    <RelativeLayout
        android:id="@+id/rel_id3_infos"
        android:layout_width="match_parent"
        android:layout_height="@dimen/id3_info_layout_height"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="@dimen/id3_info_layout_marginTop"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/id3_info_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/id3_card_layout_marginStart"
            android:layout_marginTop="@dimen/id3_card_layout_marginTop"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">

            <com.hcn.media_view.CircleImageView
                android:id="@+id/ivMusicImage"
                android:layout_width="@dimen/album_cover_width"
                android:layout_height="@dimen/album_cover_height"
                android:layout_marginStart="@dimen/music_album_cover_layout_marginStart"
                android:layout_marginTop="10dp" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">

                    <com.hcn.media_view.HTextView
                        android:id="@+id/tvTitle"
                        android:layout_width="380dp"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/title_img"
                        android:ellipsize="marquee"
                        android:focusableInTouchMode="true"
                        android:gravity="center|center_vertical|start"
                        android:padding="2dp"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="-2"
                        android:shadowRadius="1.5"
                        android:singleLine="true"
                        android:textColor="@color/id3_text_color"
                        android:textSize="28sp" />

                    <com.hcn.media_view.HTextView
                        android:id="@+id/tvAlbum"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tv_title_margin_top"
                        android:drawableStart="@drawable/album_img"
                        android:focusableInTouchMode="true"
                        android:gravity="center|center_vertical|start"
                        android:padding="2dp"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="0.6"
                        android:singleLine="true"
                        android:textColor="@color/id3_text_color"
                        android:textSize="24sp" />

                    <com.hcn.media_view.HTextView
                        android:id="@+id/tvArtist"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tv_title_margin_top"
                        android:drawableStart="@drawable/artist_img"
                        android:focusableInTouchMode="true"
                        android:gravity="center|center_vertical|start"
                        android:padding="2dp"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="0.6"
                        android:singleLine="true"
                        android:textColor="@color/id3_text_color"
                        android:textSize="24sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTotalValue"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="155dp"
                    android:layout_marginStart="260dp"
                    android:gravity="center_vertical|end"
                    android:textColor="@color/id3_text_color"
                    android:textSize="24.0sp" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/lrc_layout"
            android:layout_width="@dimen/lyric_width"
            android:layout_height="@dimen/lyric_height"
            android:layout_alignTop="@id/tvTitle"
            android:layout_toEndOf="@id/id3_info_card">

            <LinearLayout
                android:id="@+id/lin_lyric"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.hcn.media_view.lyrics.LyricsView
                    android:id="@+id/lyrics_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="15dp" />

                <TextView
                    android:id="@+id/tvNoLyrics"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:padding="2dp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="0.6"
                    android:singleLine="true"
                    android:text="@string/StrNoLrc"
                    android:textColor="@color/id3_text_color"
                    android:textSize="32.0sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lin_freq"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.hcn.media_view.PlayFlashView
                    android:id="@+id/FrequencyView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.5" />
            </LinearLayout>
        </FrameLayout>

        <include
            layout="@layout/layout_music_ctrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/music_menu_layout_marginStart"
            android:layout_toStartOf="@id/lrc_layout" />
    </RelativeLayout>

    <include
        layout="@layout/layout_music_seek"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="5dp"
        android:layout_below="@id/rel_id3_infos"
        android:layout_centerHorizontal="true" />
</RelativeLayout>