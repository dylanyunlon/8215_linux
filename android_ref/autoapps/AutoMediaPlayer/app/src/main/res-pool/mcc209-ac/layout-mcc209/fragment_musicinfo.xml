<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:apps="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:contentDescription="mcc209-music"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="30dp"
            android:orientation="vertical">

            <com.hcn.media_view.widget.RoundImageView
                android:id="@+id/ivMusicImage"
                android:layout_width="@dimen/zj_bg_width"
                android:layout_height="@dimen/zj_bg_height"
                android:layout_gravity="center"
                apps:corner_radius="10dp"
                apps:external_border_width="2dp"
                apps:external_border_color="@android:color/white" />

            <TextView
                android:id="@+id/tvTotalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/id3_text_color"
                android:textSize="24.0sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:paddingEnd="30dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <com.hcn.media_view.HTextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_title_margin_top"
                    android:layout_gravity="center"
                    android:ellipsize="marquee"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:shadowColor="#000000"
                    android:shadowDx="3"
                    android:shadowDy="-3"
                    android:shadowRadius="1.5"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="34sp" />

                <com.hcn.media_view.HTextView
                    android:id="@+id/tvAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:padding="2dp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="0.6"
                    android:singleLine="true"
                    android:textColor="@color/id3_text_color"
                    android:textSize="24sp" />

                <com.hcn.media_view.HTextView
                    android:id="@+id/tvArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:padding="2dp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="0.6"
                    android:singleLine="true"
                    android:textColor="@color/id3_text_color"
                    android:textSize="24sp" />


                <FrameLayout
                    android:id="@+id/lin_lyric"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.hcn.media_view.lyrics.LyricsView
                        android:id="@+id/lyrics_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tvNoLyrics"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:padding="2dp"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="0.6"
                        android:singleLine="true"
                        android:text="@string/StrNoLrc"
                        android:textColor="@color/id3_text_color"
                        android:textSize="30sp" />
                </FrameLayout>
            </LinearLayout>

            <com.hcn.media_view.PlayFlashView
                android:id="@+id/FrequencyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="25dp"
                android:layout_marginTop="60dp"
                android:layout_marginEnd="65dp"
                android:alpha="1"
                android:visibility="invisible"/>
        </FrameLayout>
    </LinearLayout>

    <include
        layout="@layout/layout_music_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
