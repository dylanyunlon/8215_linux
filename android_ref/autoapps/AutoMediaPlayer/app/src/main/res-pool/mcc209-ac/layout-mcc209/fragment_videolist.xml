<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/layout_top"
        layout="@layout/layout_video_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/list_layout_bg_color"
        android:orientation="horizontal">

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/music_list_radio_group_margin_start"
            android:layout_marginEnd="@dimen/music_list_radio_group_margin_end"
            android:gravity="top"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/btnStorageFlash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/small_local_bg"
                android:button="@null" />

            <RadioButton
                android:id="@+id/btnStorageUSB1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/small_usb1_bg"
                android:button="@null" />

            <RadioButton
                android:id="@+id/btnStorageSD1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/small_sd1_bg"
                android:button="@null" />

        </RadioGroup>

        <View
            android:layout_width="11dp"
            android:layout_height="match_parent"
            android:background="@drawable/divider_vertical" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ListView
                android:id="@+id/main_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/music_list_layout_margin_start"
                android:layout_marginEnd="@dimen/music_list_layout_margin_end"
                android:cacheColorHint="@android:color/transparent"
                android:divider="@color/list_divider_color"
                android:dividerHeight="1dp"
                android:fastScrollEnabled="true"
                android:focusable="true"
                android:listSelector="@android:color/transparent"
                android:scrollbarStyle="insideInset"
                android:scrollbars="none" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_loading"
                    android:layout_width="@dimen/video_list_img_loading_width"
                    android:layout_height="@dimen/video_list_img_loading_height"
                    android:layout_gravity="center"
                    android:background="@drawable/pb_loading"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/tv_main_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:text="@string/tip_no_video_file"
                    android:textColor="@color/video_list_text_color_tip"
                    android:textSize="46.0sp"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

