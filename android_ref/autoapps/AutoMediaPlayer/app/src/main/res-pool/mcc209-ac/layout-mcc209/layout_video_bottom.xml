<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="80dp"
            android:layout_height="35dp"
            android:gravity="center|end"
            android:singleLine="true"
            android:textColor="@color/duration_text_color"
            android:textSize="@dimen/music_bottom_time_text_size" />

        <SeekBar
            android:id="@+id/seekbar_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxHeight="@dimen/video_seekbar_maxheight"
            android:minHeight="@dimen/video_seekbar_minheight"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:progressDrawable="@drawable/seekbar_bg"
            android:thumb="@drawable/seekbar_thumb"
            android:thumbOffset="0dp" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="80dp"
            android:layout_height="35dp"
            android:gravity="center|start"
            android:singleLine="true"
            android:textColor="@color/duration_text_color"
            android:textSize="@dimen/music_bottom_time_text_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/video_info_bottom_bg_width"
        android:layout_height="@dimen/video_info_bottom_bg_height"
        android:background="@drawable/video_bottom_ctrl_bg"
        android:gravity="center">

        <ImageView
            android:id="@+id/btnRepeatMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_video_repeat_queue_bg" />

        <ImageView
            android:id="@+id/btnVideoScale"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_video_scale_auto" />

        <ImageView
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_prev_bg" />

        <ImageView
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_video_play_bg" />

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_next_bg" />

        <ImageView
            android:id="@+id/btnList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_list_bg" />

        <ImageView
            android:id="@+id/btnEQ"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/btn_eq_bg" />

    </LinearLayout>

</LinearLayout>