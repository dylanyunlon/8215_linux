<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="98.0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStorageType"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="24.0sp"
            android:layout_marginStart="30.0dp"
            tools:ignore="RtlHardcoded" />

        <ImageView
            android:layout_width="106.0dp"
            android:layout_height="60.0dp"
            android:background="@drawable/small_search_n" />

        <EditText
            android:id="@+id/etSearchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20.0dp"
            android:background="@drawable/search_bg"
            android:hint="@string/text_search_hint"
            android:textColorHint="@color/gray_white"
            android:maxLength="24"
            android:paddingLeft="20.0dp"
            android:paddingRight="20.0dp"
            android:textColor="#FFFFFF"
            android:textSize="24.0sp"
            android:paddingEnd="20.0dp"
            android:paddingStart="20.0dp"
            android:layout_marginEnd="20.0dp"
            tools:ignore="RtlHardcoded" />
    </LinearLayout>

    <ListView
        android:id="@+id/gridview_music"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="98dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@color/list_divider_color"
        android:dividerHeight="1dp"
        android:gravity="center"
        android:listSelector="@android:color/transparent" />
</FrameLayout>