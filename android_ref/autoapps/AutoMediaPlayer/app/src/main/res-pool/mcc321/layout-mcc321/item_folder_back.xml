<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_folder_back"
    android:layout_width="@dimen/music_folder_item_width"
    android:layout_height="@dimen/music_folder_item_height"
    android:layout_marginBottom="@dimen/music_folder_back_margin_bottom"
    android:orientation="vertical"
    android:background="@drawable/gridview_item_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/music_folder_item_icon_width"
            android:layout_height="@dimen/music_folder_item_height"
            android:layout_marginStart="@dimen/music_folder_item_icon_marginstart"
            android:layout_marginEnd="@dimen/music_folder_item_icon_marginend"
            android:scaleType="fitXY"
            android:src="@drawable/icon_list_return" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="70dp"
            android:singleLine="true"
            android:text="..."
            android:textColor="#000000"
            android:textSize="22sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/list_divider_color" />
</LinearLayout>