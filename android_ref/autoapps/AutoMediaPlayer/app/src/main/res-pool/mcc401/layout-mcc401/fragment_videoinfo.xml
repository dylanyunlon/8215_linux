<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <FrameLayout
        android:id="@+id/fl_SurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/layout_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible" >
        <TextView
            android:id="@+id/txt_prompt_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textColor="@color/button_text_color_n"
            android:textSize="32sp"
            android:text="@string/tip_unsupport_video"
            android:visibility="invisible" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layout_control"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/llVideoTitleInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/status_bar_height"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTotalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:gravity="center"
                android:textColor="@color/button_text_color_n"
                android:textSize="25sp" />

            <com.hcn.media_view.HTextView
                android:id="@+id/tvVideoName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="@color/button_text_color_n"
                android:textSize="25sp" />
        </LinearLayout>

        <include
            android:id="@+id/layout_bottom"
            layout="@layout/layout_video_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutBrightness"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbBrightness"
            android:layout_width="20dp"
            android:layout_height="150dp"
            android:layout_margin="20dp"
            android:indeterminateOnly="false"
            android:progressDrawable="@drawable/main_progress_vertical" />

        <ImageView
            android:layout_width="67dp"
            android:layout_height="72dp"
            android:background="@drawable/icon_brightness"
            android:contentDescription="@string/todo" />

        <TextView
            android:id="@+id/tvBrightnessValue"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:textColor="@color/button_text_color_n"
            android:textSize="26.0sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutVolume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbVolume"
            android:layout_width="20dp"
            android:layout_height="150dp"
            android:layout_margin="20dp"
            android:indeterminateOnly="false"
            android:max="40"
            android:progress="10"
            android:progressDrawable="@drawable/main_progress_vertical" />

        <ImageView
            android:id="@+id/ivVolumeIcon"
            android:layout_width="67dp"
            android:layout_height="72dp"
            android:background="@drawable/icon_volume"
            android:contentDescription="@string/todo" />

        <TextView
            android:id="@+id/tvVolumeValue"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:textColor="@color/button_text_color_n"
            android:textSize="40.0sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSeekTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNewTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/button_text_color_n"
            android:textSize="40.0sp" />

        <TextView
            android:id="@+id/tvDelayTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/button_text_color_n"
            android:textSize="24.0sp" />
    </LinearLayout>
</FrameLayout>