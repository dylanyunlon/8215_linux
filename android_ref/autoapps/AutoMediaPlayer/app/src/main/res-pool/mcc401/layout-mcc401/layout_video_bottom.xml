<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0.6"
            android:singleLine="true"
            android:textColor="#ffffff"
            android:textSize="20sp" />

        <SeekBar
            android:id="@+id/seekbar_progress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:maxHeight="2dp"
            android:minHeight="2dp"
            android:layout_weight="1"
            android:progressDrawable="@drawable/video_seekbar_bg"
            android:thumb="@drawable/seekbar_video_thumb"
            android:paddingEnd="10dp"
            android:paddingStart="10dp" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0.6"
            android:singleLine="true"
            android:textColor="#ffffff"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_video_prev_bg"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_video_play_bg"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_video_next_bg"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btnRepeatMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_video_repeat_queue_bg"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btnList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_video_list_bg"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btnEQ"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_video_eq_bg"
            style="?android:attr/buttonBarButtonStyle" />
    </LinearLayout>
</LinearLayout>