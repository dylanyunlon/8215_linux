<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="10dp"
        android:background="@drawable/eq_left_bg"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="@dimen/eq_seekbar_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/scroll_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/eq_bandtext_top"
                android:text="@string/BAND_60HZ" />

            <com.hcn.media_view.SeekBarRotator
                android:layout_width="wrap_content"
                android:layout_height="@dimen/eq_slider_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/eq_seekbar_top">

                <SeekBar
                    android:id="@+id/one_seek"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/eq_slider_margin"
                    android:maxHeight="40dp"
                    android:minHeight="40dp"
                    android:progressDrawable="@drawable/hcn_eq_band_seekbar_bg"
                    android:tag="0"
                    android:thumb="@drawable/hcn_eq_band_seekbar_thumb"
                    android:thumbOffset="@dimen/eq_thumb_offset" />
            </com.hcn.media_view.SeekBarRotator>

            <TextView
                android:id="@+id/one_value"
                style="@style/scroll_values"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:gravity="center_horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/eq_seekbar_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/scroll_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/eq_bandtext_top"
                android:text="@string/BAND_230HZ" />

            <com.hcn.media_view.SeekBarRotator
                android:layout_width="wrap_content"
                android:layout_height="@dimen/eq_slider_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/eq_seekbar_top">

                <SeekBar
                    android:id="@+id/two_seek"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/eq_slider_margin"
                    android:maxHeight="40dp"
                    android:minHeight="40dp"
                    android:progressDrawable="@drawable/hcn_eq_band_seekbar_bg"
                    android:tag="1"
                    android:thumb="@drawable/hcn_eq_band_seekbar_thumb"
                    android:thumbOffset="@dimen/eq_thumb_offset" />
            </com.hcn.media_view.SeekBarRotator>

            <TextView
                android:id="@+id/two_value"
                style="@style/scroll_values"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:gravity="center_horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/eq_seekbar_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/scroll_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/eq_bandtext_top"
                android:text="@string/BAND_910HZ" />

            <com.hcn.media_view.SeekBarRotator
                android:layout_width="wrap_content"
                android:layout_height="@dimen/eq_slider_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/eq_seekbar_top">

                <SeekBar
                    android:id="@+id/three_seek"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/eq_slider_margin"
                    android:maxHeight="40dp"
                    android:minHeight="40dp"
                    android:progressDrawable="@drawable/hcn_eq_band_seekbar_bg"
                    android:tag="2"
                    android:thumb="@drawable/hcn_eq_band_seekbar_thumb"
                    android:thumbOffset="@dimen/eq_thumb_offset" />
            </com.hcn.media_view.SeekBarRotator>

            <TextView
                android:id="@+id/three_value"
                style="@style/scroll_values"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:gravity="center_horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/eq_seekbar_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/scroll_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/eq_bandtext_top"
                android:text="@string/BAND_3600HZ" />

            <com.hcn.media_view.SeekBarRotator
                android:layout_width="wrap_content"
                android:layout_height="@dimen/eq_slider_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/eq_seekbar_top">

                <SeekBar
                    android:id="@+id/four_seek"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/eq_slider_margin"
                    android:maxHeight="40dp"
                    android:minHeight="40dp"
                    android:progressDrawable="@drawable/hcn_eq_band_seekbar_bg"
                    android:tag="3"
                    android:thumb="@drawable/hcn_eq_band_seekbar_thumb"
                    android:thumbOffset="@dimen/eq_thumb_offset" />
            </com.hcn.media_view.SeekBarRotator>

            <TextView
                android:id="@+id/four_value"
                style="@style/scroll_values"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:gravity="center_horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/eq_seekbar_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/scroll_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/eq_bandtext_top"
                android:text="@string/BAND_14000HZ" />

            <com.hcn.media_view.SeekBarRotator
                android:layout_width="wrap_content"
                android:layout_height="@dimen/eq_slider_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/eq_seekbar_top">

                <SeekBar
                    android:id="@+id/five_seek"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/eq_slider_margin"
                    android:maxHeight="40dp"
                    android:minHeight="40dp"
                    android:progressDrawable="@drawable/hcn_eq_band_seekbar_bg"
                    android:tag="4"
                    android:thumb="@drawable/hcn_eq_band_seekbar_thumb"
                    android:thumbOffset="@dimen/eq_thumb_offset" />
            </com.hcn.media_view.SeekBarRotator>

            <TextView
                android:id="@+id/five_value"
                style="@style/scroll_values"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:gravity="center_horizontal" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/eq_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@drawable/hcn_eq_reset" />

    </LinearLayout>
</FrameLayout>
