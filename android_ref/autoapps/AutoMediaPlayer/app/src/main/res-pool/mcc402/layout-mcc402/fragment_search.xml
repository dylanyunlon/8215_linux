<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="10dp">

    <EditText
        android:id="@+id/etSearchText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/search_text_bg"
        android:hint="@string/text_search_hint"
        android:maxLength="24"
        android:textColor="@color/search_text_color"
        android:textSize="24.0sp"
        android:layout_marginStart="@dimen/music_search_edittext_marginstart"
        android:layout_marginEnd="@dimen/music_search_edittext_marginend"
        android:paddingStart="@dimen/music_search_edittext_paddingStart"
        android:paddingEnd="@dimen/music_search_edittext_paddingEnd" />

    <ListView
        android:id="@+id/gridview_music"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:cacheColorHint="@android:color/transparent"
        android:gravity="center"
        android:divider="@color/list_divider_color"
        android:dividerHeight="1dp"
        android:listSelector="@android:color/transparent" />

</LinearLayout>