<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llVideoSearch"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="16dp"
    android:paddingTop="@dimen/status_bar_height">

    <TextView
        android:id="@+id/tvStorageType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:visibility="gone"/>

    <EditText
        android:id="@+id/etSearchText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/search_text_bg"
        android:hint="@string/text_search_hint"
        android:maxLength="24"
        android:textColor="@color/search_text_color"
        android:textSize="24.0sp"
        android:layout_marginStart="@dimen/music_search_edittext_marginstart"
        android:layout_marginEnd="@dimen/music_search_edittext_marginend"
        android:paddingStart="@dimen/music_search_edittext_paddingStart"
        android:paddingEnd="@dimen/music_search_edittext_paddingEnd" />
    <ListView
        android:id="@+id/gridview_music"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/list_bg"
        android:cacheColorHint="@android:color/transparent"
        android:gravity="center"
        android:horizontalSpacing="4dp"
        android:listSelector="@android:color/transparent"
        android:divider="@drawable/musiclist_divider"
        android:stretchMode="columnWidth"/>

</LinearLayout>