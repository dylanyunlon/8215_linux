<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/video_player_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTotalValue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:textColor="@color/button_text_color_n"
            android:textSize="20sp"
            android:focusable="false"
            android:focusableInTouchMode="false"/>

        <com.hcn.media_view.HTextView
            android:id="@+id/tvVideoName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="3"
            android:ellipsize="marquee"
            android:gravity="center_vertical|start"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:textColor="@color/button_text_color_n"
            android:textSize="20.0sp"
            android:focusable="false"
            android:focusableInTouchMode="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="50dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="50dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:gravity="center_vertical|end"
            android:paddingEnd="5dp"
            android:singleLine="true"
            android:textColor="@color/duration_text_color"
            android:textSize="20sp"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <SeekBar
            android:id="@+id/seekbar_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxHeight="@dimen/video_seekbar_max_height"
            android:minHeight="@dimen/video_seekbar_min_height"
            android:progressDrawable="@drawable/video_seekbar_bg"
            android:thumb="@drawable/seekbar_video_thumb"
            android:thumbOffset="0dp"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:gravity="center_vertical|start"
            android:paddingStart="5dp"
            android:singleLine="true"
            android:textColor="@color/duration_text_color"
            android:textSize="20sp"
            android:focusable="false"
            android:focusableInTouchMode="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:src="@drawable/btn_video_list_bg" />

        <ImageView
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:src="@drawable/btn_video_prev_bg" />

        <ImageView
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:src="@drawable/btn_video_play_bg" />

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:src="@drawable/btn_video_next_bg" />

        <ImageView
            android:id="@+id/btnRepeatMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:src="@drawable/btn_video_repeat_queue_bg" />

        <ImageView
            android:id="@+id/btnVideoScale"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:src="@drawable/btn_video_scale_auto" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>