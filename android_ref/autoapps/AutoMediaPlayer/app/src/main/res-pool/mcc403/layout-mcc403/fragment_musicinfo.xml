<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    
    <RelativeLayout
        android:id="@+id/bg_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A0000000">
    </RelativeLayout>
        
    <LinearLayout 
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="36dp"
                android:orientation="vertical"
                tools:ignore="NestedWeights">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/ivPlayingAnim"
                        android:layout_width="@dimen/zj_bg_width"
                        android:layout_height="@dimen/zj_bg_height"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/music_album_anim_marginstart"
                        android:scaleType="fitXY"
                        android:src="@drawable/default_thumbnails_bg"
                        android:visibility="gone"/>

                    <ImageView
                        android:id="@+id/ivMusicImage"
                        android:layout_width="@dimen/zj_bg_width"
                        android:layout_height="@dimen/zj_bg_height"
                        android:layout_gravity="center"
                        android:scaleType="fitXY" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTotalValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/id3_text_color"
                    android:textSize="24.0sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:paddingEnd="38dp"
                android:layout_weight="1"
                tools:ignore="RtlSymmetry">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:orientation="vertical">

                    <com.hcn.media_view.HTextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/tv_title_margin_top"
                        android:ellipsize="marquee"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:gravity="center"
                        android:shadowColor="#000000"
                        android:shadowDx="3"
                        android:shadowDy="-3"
                        android:shadowRadius="1.5"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="32sp" />

                    <com.hcn.media_view.HTextView
                        android:id="@+id/tvAlbum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:gravity="center"
                        android:padding="2dp"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="0.6"
                        android:singleLine="true"
                        android:textColor="@color/id3_text_color"
                        android:textSize="20sp" />

                    <com.hcn.media_view.HTextView
                        android:id="@+id/tvArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:gravity="center"
                        android:padding="2dp"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="0.6"
                        android:singleLine="true"
                        android:textColor="@color/id3_text_color"
                        android:textSize="20sp" />

                    <FrameLayout
                        android:id="@+id/lin_lyric"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:visibility="invisible">

                        <TextView
                            android:id="@+id/tvNoLyrics"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:gravity="center"
                            android:padding="2dp"
                            android:shadowColor="#000000"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="0.6"
                            android:singleLine="true"
                            android:text="@string/StrNoLrc"
                            android:textColor="@color/id3_text_color"
                            android:textSize="30sp" />

                        <com.hcn.media_view.lyrics.LyricsView
                            android:id="@+id/lyrics_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>
                </LinearLayout>

                <com.hcn.media_view.PlayFlashView
                    android:id="@+id/FrequencyView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="72dp"
                    android:layout_marginEnd="65dp"
                    android:alpha="1" />

                <ImageView
                    android:id="@+id/btn_change_lyric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_gravity="end"
                    android:src="@drawable/btn_freq"
                    android:focusable="false"
                    android:focusableInTouchMode="false"/>
            </FrameLayout>
        </LinearLayout>

        <include
            layout="@layout/layout_music_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</FrameLayout>