<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llVideoSearch"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="@dimen/status_bar_height">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/center_tip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStorageType"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_weight="4"
            android:textSize="@dimen/fragment_search_text_size" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/small_search_n"
            android:contentDescription="@string/todo" />

        <EditText
            android:id="@+id/etSearchText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_weight="5"
            android:background="@drawable/search_text_bg"
            android:hint="@string/text_search_hint"
            android:maxLength="24"
            android:paddingStart="30dp"
            android:paddingLeft="30dp"
            android:paddingEnd="30dp"
            android:paddingRight="30dp"
            android:textColor="#FFBDC0C5"
            android:textSize="@dimen/fragment_search_text_size"
            android:autofillHints=""
            tools:ignore="TextFields" />
    </LinearLayout>

    <ListView
        android:id="@+id/gridview_music"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="10dp"
        android:cacheColorHint="@android:color/transparent"
        android:gravity="center"
        android:listSelector="@android:color/transparent"
        android:divider="@color/video_list_divider_color"
        android:dividerHeight="1dp"
        android:numColumns="1"
        android:stretchMode="columnWidth" />

</LinearLayout>