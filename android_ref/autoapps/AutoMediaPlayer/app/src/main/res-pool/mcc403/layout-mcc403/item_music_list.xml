<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_music_item"
    android:layout_width="@dimen/music_list_item_width"
    android:layout_height="@dimen/music_list_item_height"
    android:background="@drawable/gridview_item_bg"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivMusicIcon"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_margin="@dimen/music_list_item_icon_margin_start"
        android:scaleType="fitXY"/>

    <LinearLayout
        android:layout_width="0px"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginEnd="10dp"
        android:layout_marginRight="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginLeft="10dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:textColor="@drawable/list_text_color"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvSongArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@drawable/list_text_color"
            android:textSize="16.0sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivPlayingIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        android:layout_marginRight="14dp"
        android:background="@drawable/playing" />
</LinearLayout>
