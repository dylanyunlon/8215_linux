<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_music_item"
    android:layout_width="200.0px"
    android:layout_height="200.0px"
    android:background="@drawable/album_bg_p"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/ivMusicIcon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="6.0px"
        android:layout_marginLeft="6.0px"
        android:layout_marginRight="6.0px"
        android:layout_marginTop="6.0px"
        android:scaleType="fitXY"
        android:background="@drawable/default_thumbnails_bg"
        android:layout_marginStart="6.0px"
        android:layout_marginEnd="6.0px" />

    <TextView
        android:id="@+id/tvSongTitle"
        android:layout_width="match_parent"
        android:layout_height="16.0px"
        android:layout_marginLeft="5.0px"
        android:layout_marginTop="110.0px"
        android:ellipsize="marquee"
        android:focusableInTouchMode="true"
        android:gravity="start"
        android:marqueeRepeatLimit="marquee_forever"
        android:padding="2.0px"
        android:shadowColor="#000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="0.6"
        android:singleLine="true"
        android:textColor="#ffffff"
        android:textSize="7.0sp"
        android:layout_marginStart="5.0px" />

</FrameLayout>