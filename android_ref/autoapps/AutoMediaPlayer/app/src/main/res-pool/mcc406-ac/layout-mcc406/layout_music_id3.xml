<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="60dp">

        <ImageView
            android:layout_width="98dp"
            android:layout_height="98dp"
            android:layout_gravity="center"
            android:background="@drawable/default_thumbnails_bg"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/ivMusicImage"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:layout_gravity="center"
            android:scaleType="fitXY" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1.5"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <com.hcn.media_view.HTextView
            android:id="@+id/tvSongStorage"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:ellipsize="marquee"
            android:focusableInTouchMode="true"
            android:gravity="center|center_vertical|start"
            android:marqueeRepeatLimit="marquee_forever"
            android:padding="2dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0.6"
            android:singleLine="true"
            android:textColor="@color/id3_text_color"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/icon_album" />

            <com.hcn.media_view.HTextView
                android:id="@+id/tvAlbum"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginStart="12dp"
                android:ellipsize="marquee"
                android:focusableInTouchMode="true"
                android:gravity="center|center_vertical|start"
                android:marqueeRepeatLimit="marquee_forever"
                android:padding="2dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="0.6"
                android:singleLine="true"
                android:textColor="@color/id3_text_color"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/icon_artist" />

            <com.hcn.media_view.HTextView
                android:id="@+id/tvArtist"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginStart="12dp"
                android:ellipsize="marquee"
                android:focusableInTouchMode="true"
                android:gravity="center|center_vertical|start"
                android:marqueeRepeatLimit="marquee_forever"
                android:padding="2dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="0.6"
                android:singleLine="true"
                android:textColor="@color/id3_text_color"
                android:textSize="24sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="4"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <com.hcn.media_view.HTextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="marquee"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:padding="2dp"
            android:shadowColor="#000000"
            android:shadowDx="3"
            android:shadowDy="-3"
            android:shadowRadius="1.5"
            android:singleLine="true"
            android:textColor="@color/id3_text_color"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvTotalValue"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:ellipsize="marquee"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:padding="2dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0.6"
            android:singleLine="true"
            android:textColor="@color/id3_text_color"
            android:textSize="24sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnFavorite"
        android:layout_width="78dp"
        android:layout_height="49dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="45dp"
        android:background="@drawable/btn_favorite_bg"
        android:visibility="gone" />

</LinearLayout>