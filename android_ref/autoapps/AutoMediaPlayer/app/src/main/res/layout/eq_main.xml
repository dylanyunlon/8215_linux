<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/eq_main_bg"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:fitsSystemWindows="true"
              android:gravity="center"
              android:background="@drawable/background">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_weight="3">

        <include
            android:id="@+id/id_reverb_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/eq_reverb_view"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_weight="4">

        <include
            android:id="@+id/id_band_view"
            android:layout_width="@dimen/eq_band_width"
            android:layout_height="@dimen/eq_band_height"
            layout="@layout/eq_bands"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_weight="2">

        <include
            android:id="@+id/id_other_view"
            android:layout_width="@dimen/eq_bass_width"
            android:layout_height="@dimen/eq_bass_height"
            layout="@layout/eq_other"/>
    </LinearLayout>
</LinearLayout>
