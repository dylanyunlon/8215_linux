<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="horizontal">

    <RadioGroup
        android:id="@+id/id_reverb_group"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/id_reverb_user"
            android:layout_width="@dimen/eq_reverb_width"
            android:layout_height="@dimen/eq_reverb_height"
            android:background="@drawable/hcn_eq_mode_user"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="@dimen/eq_reverb_text_padding"
            android:text="@string/eq_reverb_user"
            android:textSize="@dimen/eq_text_size"
            android:textColor="@color/white"/>

        <RadioButton
            android:id="@+id/id_reverb_news"
            android:layout_width="@dimen/eq_reverb_width"
            android:layout_height="@dimen/eq_reverb_height"
            android:layout_marginTop="@dimen/eq_reverb_top_padding"
            android:background="@drawable/hcn_eq_mode_news"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="@dimen/eq_reverb_text_padding"
            android:text="@string/eq_reverb_lift"
            android:textSize="@dimen/eq_text_size"
            android:textColor="@color/white"
            android:layout_marginStart="@dimen/eq_reverb_width"/>

        <RadioButton
            android:id="@+id/id_reverb_jazz"
            android:layout_width="@dimen/eq_reverb_width"
            android:layout_height="@dimen/eq_reverb_height"
            android:background="@drawable/hcn_eq_mode_jazz"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="@dimen/eq_reverb_text_padding"
            android:text="@string/eq_reverb_jazz"
            android:textSize="@dimen/eq_text_size"
            android:textColor="@color/white"/>

        <RadioButton
            android:id="@+id/id_reverb_city"
            android:layout_width="@dimen/eq_reverb_width"
            android:layout_height="@dimen/eq_reverb_height"
            android:layout_marginTop="@dimen/eq_reverb_top_padding"
            android:background="@drawable/hcn_eq_mode_city"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="@dimen/eq_reverb_text_padding"
            android:text="@string/eq_reverb_dance"
            android:textSize="@dimen/eq_text_size"
            android:textColor="@color/white"
            android:layout_marginStart="@dimen/eq_reverb_width"/>

        <RadioButton
            android:id="@+id/id_reverb_pop"
            android:layout_width="@dimen/eq_reverb_width"
            android:layout_height="@dimen/eq_reverb_height"
            android:background="@drawable/hcn_eq_mode_pop"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="@dimen/eq_reverb_text_padding"
            android:text="@string/eq_reverb_pop"
            android:textSize="@dimen/eq_text_size"
            android:textColor="@color/white"/>

        <RadioButton
            android:id="@+id/id_reverb_electronic"
            android:layout_width="@dimen/eq_reverb_width"
            android:layout_height="@dimen/eq_reverb_height"
            android:layout_marginTop="@dimen/eq_reverb_top_padding"
            android:background="@drawable/hcn_eq_mode_electronic"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="@dimen/eq_reverb_text_padding"
            android:text="@string/eq_reverb_electronic"
            android:textSize="@dimen/eq_text_size"
            android:textColor="@color/white"
            android:layout_marginStart="@dimen/eq_reverb_width"/>

        <RadioButton
            android:id="@+id/id_reverb_classiz"
            android:layout_width="@dimen/eq_reverb_width"
            android:layout_height="@dimen/eq_reverb_height"
            android:background="@drawable/hcn_eq_mode_classic"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="@dimen/eq_reverb_text_padding"
            android:text="@string/eq_reverb_classiz"
            android:textSize="@dimen/eq_text_size"
            android:textColor="@color/white"/>

        <RadioButton
            android:id="@+id/id_reverb_movie"
            android:layout_width="@dimen/eq_reverb_width"
            android:layout_height="@dimen/eq_reverb_height"
            android:layout_marginTop="@dimen/eq_reverb_top_padding"
            android:background="@drawable/hcn_eq_mode_movie"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="@dimen/eq_reverb_text_padding"
            android:text="@string/eq_reverb_rb"
            android:textSize="@dimen/eq_text_size"
            android:textColor="@color/white"
            android:layout_marginStart="@dimen/eq_reverb_width"/>

        <RadioButton
            android:id="@+id/id_reverb_rock"
            android:layout_width="@dimen/eq_reverb_width"
            android:layout_height="@dimen/eq_reverb_height"
            android:background="@drawable/hcn_eq_mode_rock"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="@dimen/eq_reverb_text_padding"
            android:text="@string/eq_reverb_rock"
            android:textSize="@dimen/eq_text_size"
            android:textColor="@color/white"/>

        <RadioButton
            android:id="@+id/id_reverb_techno"
            android:layout_width="@dimen/eq_reverb_width"
            android:layout_height="@dimen/eq_reverb_height"
            android:layout_marginTop="@dimen/eq_reverb_top_padding"
            android:background="@drawable/hcn_eq_mode_techno"
            android:button="@null"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="@dimen/eq_reverb_text_padding"
            android:text="@string/eq_reverb_Absolute_music"
            android:textSize="@dimen/eq_text_size"
            android:textColor="@color/white"
            android:layout_marginStart="@dimen/eq_reverb_width"/>
    </RadioGroup>

</LinearLayout>