<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewpager_center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp" />

    <RadioGroup
        android:id="@+id/rgList"
        android:layout_width="match_parent"
        android:layout_height="79dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/btnPlaying"
            android:layout_width="0dp"
            android:layout_height="79dp"
            android:layout_weight="1"
            android:button="@null"
            android:checked="true"
            android:drawableTop="@drawable/rb_playing_bg"
            android:gravity="center"
            android:textColor="@drawable/btn_text_color"
            android:textSize="24.0sp" />

        <RadioButton
            android:id="@+id/btnStorageFlash"
            android:layout_width="0dp"
            android:layout_height="79.0dp"
            android:layout_weight="1"
            android:button="@null"
            android:drawableTop="@drawable/rb_flash_bg"
            android:gravity="center"
            android:textColor="@drawable/btn_text_color"
            android:textSize="24.0sp" />

        <RadioButton
            android:id="@+id/btnStorageUSB1"
            android:layout_width="0dp"
            android:layout_height="79.0dp"
            android:layout_weight="1"
            android:button="@null"
            android:drawableTop="@drawable/rb_usb_bg"
            android:gravity="center"
            android:textColor="@drawable/btn_text_color"
            android:textSize="24.0sp" />

        <RadioButton
            android:id="@+id/btnStorageSD"
            android:layout_width="0dp"
            android:layout_height="79.0dp"
            android:layout_weight="1"
            android:button="@null"
            android:drawableTop="@drawable/rb_sd_bg"
            android:gravity="center"
            android:textColor="@drawable/btn_text_color"
            android:textSize="24.0sp" />

        <RadioButton
            android:id="@+id/btnListFolder"
            android:layout_width="0dp"
            android:layout_height="79.0dp"
            android:layout_weight="1"
            android:button="@null"
            android:drawableTop="@drawable/rb_folder_bg"
            android:gravity="center"
            android:textColor="@drawable/btn_text_color"
            android:textSize="24.0sp" />

        <Button
            android:id="@+id/btnEQ"
            android:layout_width="0dp"
            android:layout_height="79.0dp"
            android:layout_weight="1"
            android:background="@null"
            android:drawableTop="@drawable/rb_eq_bg"
            android:gravity="center"
            android:textColor="@drawable/btn_text_color"
            android:textSize="24sp" />
    </RadioGroup>
</LinearLayout>