<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llVideoSearch"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="@dimen/status_bar_height">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_search_menu_layout_height"
        android:background="@drawable/center_tip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStorageType"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_weight="1"
            android:textSize="@dimen/fragment_search_text_size"
            android:textColor="@color/gray_white"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/small_search_n"
            android:contentDescription="@string/todo" />

        <EditText
            android:id="@+id/etSearchText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="@dimen/search_EditText_layout_marginBottom"
            android:layout_weight="1"
            android:background="@drawable/search_text_bg"
            android:hint="@string/text_search_hint"
            android:textColorHint="@color/gray_white"
            android:maxLength="24"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#FFBDC0C5"
            android:textSize="@dimen/fragment_search_text_size"
            android:autofillHints="" />
    </LinearLayout>

    <ListView
        android:id="@+id/gridview_music"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="@dimen/video_search_list_layout_marginTop"
        android:layout_marginBottom="@dimen/video_search_list_layout_marginBottom"
        android:cacheColorHint="@android:color/transparent"
        android:gravity="center"
        android:listSelector="@android:color/transparent"
        android:divider="@color/video_list_divider_color"
        android:dividerHeight="1dp"
        android:numColumns="1"
        android:stretchMode="columnWidth"/>
</LinearLayout>