<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_music_item"
    android:layout_width="135dp"
    android:layout_height="135dp"
    android:background="@drawable/album_bg_p"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/ivMusicIcon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="6dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:layout_marginTop="6dp"
        android:scaleType="fitXY"
        android:background="@drawable/default_thumbnails_bg"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/none" />

    <TextView
        android:id="@+id/tvSongTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="110dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="marquee"
        android:focusableInTouchMode="true"
        android:gravity="start"
        android:textDirection="locale"
        android:padding="2dp"
        android:shadowColor="@color/song_title_shadowColor"
        android:shadowDx="@integer/song_title_shadowDx"
        android:shadowDy="@integer/song_title_shadowDy"
        android:shadowRadius="1"
        android:singleLine="true"
        android:textColor="#ffffff"
        android:textSize="10sp"
        tools:ignore="SmallSp" />
</FrameLayout>