<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/layout_musiclist_top_ctrl" />

        <ListView
            android:id="@+id/gridview_music"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@color/list_divider_color"
            android:dividerHeight="1dp"
            android:listSelector="@android:color/transparent"
            android:stretchMode="columnWidth" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvShowTip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/tip_no_music_file"
        android:textColor="@color/list_text_color_tip"
        android:textSize="@dimen/tv_showtip_size"
        android:visibility="gone" />

</FrameLayout>