<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <Button
        android:id="@+id/btnPrev"
        android:layout_width="134.0px"
        android:layout_height="112.0px"
        android:background="@drawable/btn_prev_bg" />

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="108.0px"
        android:layout_height="112.0px"
        android:layout_gravity="center_vertical"
        android:layout_marginBottom="3px"
        android:background="@drawable/btn_play_bg" />

    <Button
        android:id="@+id/btnNext"
        android:layout_width="110.0px"
        android:layout_height="112.0px"
        android:background="@drawable/btn_next_bg" />

    <LinearLayout
        android:id="@+id/layout_progress"
        android:layout_width="500.0px"
        android:layout_height="112.0px"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="80.0px"
            android:layout_height="35.0px"
            android:layout_marginTop="32.0px"
            android:gravity="bottom|end"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0.6"
            android:singleLine="true"
            android:textColor="#ffffff"
            android:textSize="18.0sp" />

        <SeekBar
            android:id="@+id/seekbar_progress"
            android:layout_width="340.0px"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:maxHeight="2.0px"
            android:minHeight="2.0px"
            android:paddingLeft="10.0px"
            android:paddingRight="10.0px"
            android:progressDrawable="@drawable/seekbar_bg"
            android:thumb="@drawable/seekbar_thumb"
            android:paddingStart="10.0px"
            android:paddingEnd="10.0px" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="80.0px"
            android:layout_height="35.0px"
            android:layout_marginTop="32.0px"
            android:gravity="bottom|start"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0.6"
            android:singleLine="true"
            android:textColor="#ffffff"
            android:textSize="18.0sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRepeatMode"
        android:layout_width="70.0px"
        android:layout_height="112.0px"
        android:background="@drawable/btn_repeat_queue_bg" />

    <Button
        android:id="@+id/btnList"
        android:layout_width="102.0px"
        android:layout_height="112.0px"
        android:background="@drawable/btn_list_bg" />

</LinearLayout>