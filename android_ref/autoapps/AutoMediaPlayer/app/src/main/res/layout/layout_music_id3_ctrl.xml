<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hcn.media_view.HTextView
        android:id="@+id/tvTitle"
        android:layout_width="482dp"
        android:layout_height="62.0px"
        android:layout_marginLeft="10dp"
        android:ellipsize="marquee"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical|start"
        android:marqueeRepeatLimit="marquee_forever"
        android:padding="2.0px"
        android:shadowColor="#000000"
        android:shadowDx="3"
        android:shadowDy="-3"
        android:shadowRadius="1.5"
        android:singleLine="true"
        android:textColor="#ffffff"
        android:textSize="38sp"
        android:layout_marginStart="10dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:layout_marginStart="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_artist" />

            <com.hcn.media_view.HTextView
                android:id="@+id/tvArtist"
                android:layout_width="160dp"
                android:layout_height="35dp"
                android:layout_marginLeft="10.0px"
                android:ellipsize="marquee"
                android:focusableInTouchMode="true"
                android:gravity="center|center_vertical|start"
                android:marqueeRepeatLimit="marquee_forever"
                android:padding="2.0px"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="0.6"
                android:singleLine="true"
                android:textColor="#ffffff"
                android:textSize="24sp"
                android:layout_marginStart="10.0px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="35dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:layout_marginStart="35dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_album" />

            <com.hcn.media_view.HTextView
                android:id="@+id/tvAlbum"
                android:layout_width="160dp"
                android:layout_height="35dp"
                android:layout_marginLeft="17.0px"
                android:ellipsize="marquee"
                android:focusableInTouchMode="true"
                android:gravity="center|center_vertical|start"
                android:marqueeRepeatLimit="marquee_forever"
                android:padding="2.0px"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="0.6"
                android:singleLine="true"
                android:textColor="#ffffff"
                android:textSize="24sp"
                android:layout_marginStart="17.0px" />
        </LinearLayout>
    </LinearLayout>

    <com.hcn.media_view.HTextView
        android:id="@+id/tvSongStorage"
        android:layout_width="232.0px"
        android:layout_height="35.0px"
        android:layout_marginLeft="133.0px"
        android:ellipsize="marquee"
        android:focusableInTouchMode="true"
        android:gravity="center|center_vertical|start"
        android:marqueeRepeatLimit="marquee_forever"
        android:padding="2.0px"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="0.6"
        android:singleLine="true"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:visibility="gone"
        android:layout_marginStart="133.0px" />

    <TextView
        android:id="@+id/tvTotalValue"
        android:layout_width="30.0px"
        android:layout_height="30.0px"
        android:ellipsize="marquee"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical|start"
        android:marqueeRepeatLimit="marquee_forever"
        android:padding="2.0px"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="0.6"
        android:singleLine="true"
        android:textColor="#ffffff"
        android:textSize="24sp" />

</LinearLayout>