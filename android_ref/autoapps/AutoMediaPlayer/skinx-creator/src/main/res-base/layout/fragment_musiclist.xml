<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_musicListPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include
        android:id="@+id/layout_top"
        layout="@layout/layout_music_list_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_top_layout_marginTop"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/btnStorageFlash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/small_local_music_bg"
                    android:button="@null"
                    android:gravity="center" />

                <RadioButton
                    android:id="@+id/btnStorageUSB1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/small_usb1_bg"
                    android:button="@null"
                    android:gravity="center" />

                <RadioButton
                    android:id="@+id/btnStorageSD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/small_sd1_bg"
                    android:button="@null"
                    android:gravity="center" />

                <RadioButton
                    android:id="@+id/btnListFolder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/small_folder_bg"
                    android:button="@null"
                    android:gravity="center" />
            </RadioGroup>
        </ScrollView>

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@drawable/divider_vertical" />

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewpager_center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="@dimen/music_list_layout_marginEnd"
            android:layout_marginBottom="10dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>