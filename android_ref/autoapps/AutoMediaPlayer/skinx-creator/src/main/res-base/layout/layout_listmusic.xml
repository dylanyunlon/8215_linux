<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ListView
        android:id="@+id/gridview_music"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/music_list_paddingEnd"
        android:cacheColorHint="@android:color/transparent"
        android:listSelector="@android:color/transparent"
        android:divider="@color/list_divider_color"
        android:dividerHeight="1dp"
        android:scrollbarStyle="outsideInset"
        android:scrollbarThumbVertical="@drawable/list_slider_thumb"
        android:scrollbarTrackVertical="@drawable/list_slider_bg"
        android:scrollbarSize="2dp"
        tools:ignore="RtlSymmetry" />

    <TextView
        android:id="@+id/tvShowTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@drawable/list_text_color"
        android:text="@string/tip_no_music_file"
        android:textSize="40.0sp"
        android:visibility="gone" />
</FrameLayout>