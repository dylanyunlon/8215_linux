<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/center_tip_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/btnPlaying"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/btn_playing_layout_marginStart"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/small_playing_bg"
        android:contentDescription="@string/todo" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/layout_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/search_button_layout_marginStart"
            android:layout_marginEnd="@dimen/search_button_layout_marginEnd"
            android:src="@drawable/small_search_bg"
            android:contentDescription="@string/todo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="@dimen/search_hint_paddingStart"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/search_icon_hint_tip"
            android:textColor="@color/search_hint_color"
            android:textSize="28.0sp"
            tools:ignore="RtlSymmetry" />
    </FrameLayout>

    <ImageView
        android:id="@+id/btnUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/update_button_layout_marginStart"
        android:layout_marginEnd="@dimen/update_button_layout_marginEnd"
        android:src="@drawable/small_update_bg"
        android:contentDescription="@string/todo" />
</LinearLayout>
