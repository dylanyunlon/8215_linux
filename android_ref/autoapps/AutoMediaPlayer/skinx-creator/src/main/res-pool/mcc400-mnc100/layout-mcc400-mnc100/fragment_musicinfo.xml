<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/todo" />

    <RelativeLayout
        android:id="@+id/bg_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A0000000">
    </RelativeLayout>

    <com.hcn.media_view.widget.DrawerLayoutEx
        android:id="@+id/music_drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        app:elevation="@dimen/drawer_elevation"
        tools:openDrawer="end">

        <LinearLayout
            android:id="@+id/drawer_content_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/music_info_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <include
                    layout="@layout/layout_music_card_top"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="@dimen/music_card_top_height_layout_weight"
                    tools:ignore="NestedWeights" />

                <include
                    layout="@layout/layout_music_card_upper_middle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="@dimen/music_card_upper_middle_height_layout_weight" />

                <include
                    layout="@layout/layout_music_card_lower_middle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="@dimen/music_card_lower_middle_height_layout_weight"
                    android:layout_marginTop="@dimen/lower_middle_layout_marginTop" />

                <include
                    layout="@layout/layout_music_card_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="@dimen/music_card_bottom_height_layout_weight" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_drawer_handle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingStart="@dimen/drawer_handle_paddingStart"
                android:src="@drawable/drawer_handle"
                android:contentDescription="@string/todo"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawer_sideslip_page"
            android:layout_width="@dimen/drawer_view_layout_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center"
            android:paddingTop="4dp"
            android:orientation="vertical">

            <include
                layout="@layout/layout_simple_list_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/music_list_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="@dimen/music_list_pager_layout_marginBottom"
                android:orientation="horizontal">
            </androidx.viewpager2.widget.ViewPager2>
        </LinearLayout>
    </com.hcn.media_view.widget.DrawerLayoutEx>

    <include
        layout="@layout/layout_wallpaper_widget"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
</FrameLayout>