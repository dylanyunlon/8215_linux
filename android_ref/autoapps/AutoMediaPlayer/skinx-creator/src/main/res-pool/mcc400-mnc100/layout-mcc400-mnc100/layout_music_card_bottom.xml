<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_menu_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/music_info_bottom_bg_height"
    android:paddingBottom="@dimen/bottom_menu_layout_paddingBottom"
    android:background="@drawable/music_bottom_ctrl_bg"
    android:gravity="center"
    tools:ignore="MissingDefaultResource">

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.8"/>

    <ImageView
        android:id="@+id/btnEQ"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:src="@drawable/btn_eq_bg"
        android:contentDescription="@string/todo" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>

    <ImageView
        android:id="@+id/btnPrev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:src="@drawable/btn_prev_bg"
        android:contentDescription="@string/todo" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>

    <ImageView
        android:id="@+id/btnPlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:src="@drawable/btn_play_bg"
        android:contentDescription="@string/todo" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>

    <ImageView
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:src="@drawable/btn_next_bg"
        android:contentDescription="@string/todo" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>

    <ImageView
        android:id="@+id/btnList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:src="@drawable/btn_list_bg"
        android:contentDescription="@string/todo" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.8"/>
</LinearLayout>