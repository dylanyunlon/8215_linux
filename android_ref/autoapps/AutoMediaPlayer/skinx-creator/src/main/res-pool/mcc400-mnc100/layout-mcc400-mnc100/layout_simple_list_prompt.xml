<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/simplePromptLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="MissingDefaultResource">

    <Space
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/ivSimpleIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/ivSimpleIcon_layout_marginTop"
        android:scaleType="fitXY"
        android:src="@drawable/empty_list_icon"
        android:contentDescription="@string/todo" />

    <TextView
        android:id="@+id/tvSimplePrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/tvSimplePrompt_layout_marginTop"
        android:gravity="center"
        android:text="@string/ellipsis_symbol"
        android:textSize="@dimen/simple_prompt_info_textSize"
        android:textColor="@color/gray">
    </TextView>

    <Space
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>