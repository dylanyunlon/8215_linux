<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/BottomMenu"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content"
              android:background="@drawable/bottom_bg"
              android:gravity="center">

    <ImageView
        android:id="@+id/butt_band"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="bottom|center"
        android:src="@drawable/butt_xml_band"
        android:textColor="@drawable/text_color_selector"/>

    <ImageView
        android:id="@+id/butt_asps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="bottom|center"
        android:src="@drawable/butt_xml_scan"
        android:textColor="@drawable/text_color_selector"/>

    <ImageView
        android:id="@+id/butt_locdx"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="bottom|center"
        android:src="@drawable/butt_xml_loc"
        android:textColor="@drawable/text_color_selector"/>


    <ImageView
        android:id="@+id/butt_keypad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="bottom|center"
        android:src="@drawable/butt_xml_keyboard"
        android:textColor="@drawable/text_color_selector"/>


    <ImageView
        android:id="@+id/rds_imgbtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="bottom|center"
        android:src="@drawable/butt_xml_rds"
        android:textColor="@drawable/text_color_selector"/>

    <ImageView
        android:id="@+id/butt_scan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:gravity="bottom|center"
        android:textColor="@drawable/text_color_selector"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/butt_eq"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="bottom|center"
        android:src="@drawable/butt_xml_eq"
        android:textColor="@drawable/text_color_selector"/>
</LinearLayout>

