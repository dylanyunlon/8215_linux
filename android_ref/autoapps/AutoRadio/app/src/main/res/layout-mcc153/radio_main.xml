<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:autofm="http://schemas.android.com/apk/res-auto"
    android:id="@+id/radio_main"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@drawable/radio_main_bg"
    android:fitsSystemWindows="true">

    <com.hcn.autoradio.view.FMSeekBarView
        android:id="@+id/id_china_seekbar_fm"
        android:layout_width="fill_parent"
        android:layout_height="82dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/radio_scroll_background"
        android:src="@drawable/radio_scroll_fm_china"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_layout"
        android:layout_alignParentStart="true"
        android:orientation="horizontal">

        <com.hcn.autoradio.view.VerticalViewPager
            android:id="@+id/PresetViewPaper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="0.9"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:layout_weight="2"
            android:background="@drawable/radio_info_bg"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_radio_status_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <include
                    layout="@layout/radio_status_icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5"/>

                <Button
                    android:id="@+id/auto_test"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="0.3"
                    android:background="@android:color/transparent"/>
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:layout_weight="1">
                <LinearLayout
                    android:id="@+id/radio_rds_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingEnd="20dp"
                    android:layout_marginTop="@dimen/radio_rds_info_margin_top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rds_ps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/pty_text_color"
                        android:textSize="@dimen/rds_ps_text_size"/>

                    <TextView
                        android:id="@+id/rds_rt_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_weight="4"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:textColor="@color/pty_text_color"
                        android:textSize="@dimen/rds_rt_info_text_size"/>
                </LinearLayout>

                <include
                    layout="@layout/radio_show_info_txt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"/>
            </FrameLayout>

            <RadioGroup
                android:id="@+id/band_layout"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="center"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/band_info_fm1"
                    style="@style/band_info_btn_style"
                    android:layout_marginStart="5dp"
                    android:text="FM1"/>

                <RadioButton
                    android:id="@+id/band_info_fm2"
                    style="@style/band_info_btn_style"
                    android:layout_marginStart="5dp"
                    android:text="FM2"/>

                <RadioButton
                    android:id="@+id/band_info_fm3"
                    style="@style/band_info_btn_style"
                    android:layout_marginStart="5dp"
                    android:text="FM3"/>

                <RadioButton
                    android:id="@+id/band_info_am1"
                    style="@style/band_info_btn_style"
                    android:layout_marginStart="5dp"
                    android:text="AM1"/>
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>
    <include
        android:id="@+id/bottom_layout"
        layout="@layout/bottom_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>