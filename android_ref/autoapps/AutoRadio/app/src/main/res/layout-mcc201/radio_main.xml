<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:autofm="http://schemas.android.com/apk/res-auto"
                android:id="@+id/radio_main"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:background="@drawable/radio_main_bg"
                android:fitsSystemWindows="true">
    <com.hcn.autoradio.view.FMSeekBarView
        android:id="@+id/id_china_seekbar_fm"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/radio_scroll_fm_china"
        autofm:scroll_begin="50"
        autofm:scroll_end="974"
        autofm:scroll_item="@drawable/radio_scroll_thumb"
        autofm:scroll_uid="8"/>
    <LinearLayout
        android:id="@+id/ll_radio_status_icon"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/id_china_seekbar_fm"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/rds_imgbtn"
            style="@style/hcn_rds_icon_style"
            android:layout_weight="0.5"
            android:src="@drawable/rds_styles_selector"/>

        <include
            layout="@layout/radio_status_icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"/>

        <Button
            android:id="@+id/auto_test"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="0.5"
            android:background="@android:color/transparent"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent"
                 android:layout_height="match_parent"
                 android:layout_below="@+id/ll_radio_status_icon"
                 android:layout_above="@+id/bottom_layout">
        <LinearLayout
            android:id="@+id/radio_rds_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rds_ps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/main_text_color"
                android:textSize="20.0sp"/>

            <TextView
                android:id="@+id/rds_rt_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="5"
                android:gravity="center_vertical"
                android:textColor="@color/main_text_color"
                android:textSize="18.0sp"/>
        </LinearLayout>
        <include layout="@layout/radio_show_info_txt"
                 android:layout_width="match_parent"
                 android:layout_height="match_parent"
                 android:layout_gravity="center"/>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/bottom_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <com.hcn.autoradio.view.ViewPager
            android:id="@+id/PresetViewPaper"
            android:layout_width="match_parent"
            android:layout_height="@dimen/preset_viewpager_height"
            android:layout_marginStart="@dimen/preset_viewpager_margin_start"
            android:layout_marginEnd="@dimen/preset_viewpager_margin_end">

        </com.hcn.autoradio.view.ViewPager>
        <!--include layout="@layout/screen_segment"/-->
        <include layout="@layout/bottom_menu"/>
    </LinearLayout>

</RelativeLayout>