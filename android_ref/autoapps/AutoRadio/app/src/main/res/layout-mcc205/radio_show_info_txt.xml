<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginEnd="80dp"
    android:layoutDirection="ltr">

    <ImageView
        android:id="@+id/radio_icon_anim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="@dimen/freq_margin_hz" />


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/icon_margin_start"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/rds_imgbtn"
            style="@style/hcn_rds_icon_style"
            android:layout_weight="1"
            android:src="@drawable/rds_styles_selector" />

        <ImageView
            android:id="@+id/butt_eq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_margin_rds"
            android:layout_weight="1"
            android:gravity="bottom|center"
            android:src="@drawable/butt_xml_eq"
            android:textColor="@drawable/text_color_selector" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="5"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/freq_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/main_text_color"
            android:textSize="98sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/digital_frequency"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical|start"
            android:gravity="center">

            <TextView
                android:id="@+id/number_A"
                style="@style/hcn_radio_num_style_textview" />

            <TextView
                android:id="@+id/number_B"
                style="@style/hcn_radio_num_style_textview" />

            <TextView
                android:id="@+id/number_C"
                style="@style/hcn_radio_num_style_textview" />

            <TextView
                android:id="@+id/number_D"
                style="@style/hcn_radio_num_style_textview" />

            <TextView
                android:id="@+id/number_E"
                style="@style/hcn_radio_num_style_textview" />

            <TextView
                android:id="@+id/number_F"
                style="@style/hcn_radio_num_style_textview" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/freq_margin_hz"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_band_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/fm1"
                    android:textColor="@color/pty_band_text_color"
                    android:textSize="@dimen/band_info_text_size" />

                <TextView
                    android:id="@+id/radio_info_hz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/mhz"
                    android:textColor="@color/pty_text_color"
                    android:textSize="@dimen/unit_text_size" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>