<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp">

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_01"
            style="@style/hcn_preset_view_style"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/present01_margin_start"
            android:layout_marginTop="0dp" />

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_02"
            style="@style/hcn_preset_view_style"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/present02_margin_start"
            android:layout_marginTop="@dimen/present02_margin_top" />

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_03"
            style="@style/hcn_preset_view_style"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/present03_margin_start"
            android:layout_marginTop="@dimen/present03_margin_top" />

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_04"
            style="@style/hcn_preset_view_style"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/present04_margin_start"
            android:layout_marginTop="@dimen/present04_margin_top" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp">

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_05"
            style="@style/hcn_preset_view2_style"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="@dimen/present01_margin_start" />

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_06"
            style="@style/hcn_preset_view2_style"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/present02_margin_top"
            android:layout_marginEnd="@dimen/present02_margin_start" />

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_07"
            style="@style/hcn_preset_view2_style"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/present03_margin_top"
            android:layout_marginEnd="@dimen/present03_margin_start" />

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_08"
            style="@style/hcn_preset_view2_style"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/present04_margin_top"
            android:layout_marginEnd="@dimen/present04_margin_start" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/radio_info_text_bg">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/radio_freq_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/text_band_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginTop="@dimen/band_info_margin_bottom" />

            <TextView
                android:id="@+id/freq_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/main_text_color"
                android:textSize="75sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/digital_frequency"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center">

                <ImageView
                    android:id="@+id/number_A"
                    style="@style/hcn_radio_num_style"
                    android:src="@drawable/radio_num_1" />

                <ImageView
                    android:id="@+id/number_B"
                    style="@style/hcn_radio_num_style"
                    android:src="@drawable/radio_num_0" />

                <ImageView
                    android:id="@+id/number_C"
                    style="@style/hcn_radio_num_style"
                    android:src="@drawable/radio_num_8" />

                <ImageView
                    android:id="@+id/number_D"
                    style="@style/hcn_radio_dot_style"
                    android:src="@drawable/radio_num_point" />

                <ImageView
                    android:id="@+id/number_E"
                    style="@style/hcn_radio_num_style"
                    android:src="@drawable/radio_num_0" />

                <ImageView
                    android:id="@+id/number_F"
                    style="@style/hcn_radio_num_style"
                    android:src="@drawable/radio_num_0" />
            </LinearLayout>

            <ImageView
                android:id="@+id/radio_info_hz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginBottom="@dimen/band_info_margin_bottom" />
        </LinearLayout>

    </RelativeLayout>


</RelativeLayout>