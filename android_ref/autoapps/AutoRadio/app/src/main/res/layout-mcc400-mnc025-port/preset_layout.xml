<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingEnd="21dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp">

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_01"
            style="@style/hcn_preset_view_style" />

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_02"
            style="@style/hcn_preset_view_style" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp">

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_03"
            style="@style/hcn_preset_view_style" />

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_04"
            style="@style/hcn_preset_view_style" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp">

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_05"
            style="@style/hcn_preset_view_style" />

        <com.hcn.autoradio.view.FMPresetView
            android:id="@+id/preset_06"
            style="@style/hcn_preset_view_style" />
    </LinearLayout>
</LinearLayout>