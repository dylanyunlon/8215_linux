<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:autofm="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/radio_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/radio_main_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_band_status_icon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="30dp"
        android:orientation="horizontal">

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/text_band_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/radio_fm1" />

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/digital_frequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center">

                <ImageView
                    android:id="@+id/number_A"
                    style="@style/hcn_radio_num_style"
                    android:src="@drawable/radio_num_1" />

                <ImageView
                    android:id="@+id/number_B"
                    style="@style/hcn_radio_num_style"
                    android:src="@drawable/radio_num_0" />

                <ImageView
                    android:id="@+id/number_C"
                    style="@style/hcn_radio_num_style"
                    android:src="@drawable/radio_num_8" />

                <ImageView
                    android:id="@+id/number_D"
                    style="@style/hcn_radio_dot_style"
                    android:src="@drawable/radio_num_point" />

                <ImageView
                    android:id="@+id/number_E"
                    style="@style/hcn_radio_num_style"
                    android:src="@drawable/radio_num_0" />

                <ImageView
                    android:id="@+id/number_F"
                    style="@style/hcn_radio_num_style"
                    android:src="@drawable/radio_num_0" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="35dp">
                <ImageView
                    android:id="@+id/radio_info_hz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/radio_khz" />
            </FrameLayout>

        </LinearLayout>

        <Button
            android:id="@+id/auto_test"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:background="@android:color/transparent" />

        <ImageView
            android:id="@+id/rds_imgbtn"
            style="@style/hcn_rds_icon_style"
            android:scaleType="fitCenter"
            android:layout_marginEnd="30dp"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/rds_styles_selector" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_radio_status_icon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:gravity="center"
        android:orientation="horizontal">

        <include
            layout="@layout/radio_status_icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/radio_rds_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.3"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rds_ps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/main_text_color"
            android:textSize="20.0sp"
            tools:text="ps"/>

        <TextView
            android:id="@+id/rds_rt_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="5"
            android:gravity="center_vertical"
            android:textColor="@color/main_text_color"
            android:textSize="18.0sp"
            tools:text="rt"/>
    </LinearLayout>

    <include
        android:id="@+id/radio_show_info_img"
        layout="@layout/radio_show_info_img"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.2" />

    <LinearLayout
        android:id="@+id/ll_china_seekbar_fm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.hcn.autoradio.view.FMSeekBarView
            android:id="@+id/id_china_seekbar_fm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/radio_scroll_fm_china"
            autofm:scroll_begin="6"
            autofm:scroll_end="506"
            autofm:scroll_item="@drawable/radio_scroll_thumb"
            autofm:scroll_uid="8" />

    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.6" />

    <include
        layout="@layout/bottom_menu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.5"
        android:orientation="vertical">

        <com.hcn.autoradio.view.ViewPager
            android:id="@+id/PresetViewPaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.5" />
</LinearLayout>