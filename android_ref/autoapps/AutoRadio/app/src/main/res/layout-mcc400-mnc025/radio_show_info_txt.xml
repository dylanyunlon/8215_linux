<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/btn_seek_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/butt_xml_prev" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="5"
        android:gravity="center">

        <TextView
            android:id="@+id/freq_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/main_text_color"
            android:textSize="@dimen/freq_name_textSize"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/digital_frequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/text_band_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/fm1"
                android:textColor="@color/main_text_color"
                android:textSize="@dimen/band_info_text_size" />

            <TextView
                android:id="@+id/number_A"
                style="@style/hcn_radio_num_style_textview" />

            <TextView
                android:id="@+id/number_B"
                style="@style/hcn_radio_num_style_textview" />

            <TextView
                android:id="@+id/number_C"
                style="@style/hcn_radio_num_style_textview" />

            <TextView
                android:id="@+id/number_D"
                style="@style/hcn_radio_num_style_textview" />

            <TextView
                android:id="@+id/number_E"
                style="@style/hcn_radio_num_style_textview" />

            <TextView
                android:id="@+id/number_F"
                style="@style/hcn_radio_num_style_textview" />

            <TextView
                android:id="@+id/radio_info_hz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/mhz"
                android:textColor="@color/main_text_color"
                android:textSize="@dimen/band_info_text_size" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/btn_seek_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/butt_xml_next" />
    </FrameLayout>
</LinearLayout>