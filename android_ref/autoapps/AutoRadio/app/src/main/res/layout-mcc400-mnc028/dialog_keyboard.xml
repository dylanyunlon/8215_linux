<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:background="@drawable/keybg"
              android:orientation="vertical">
    <LinearLayout
        android:id="@+id/key_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:layout_weight="2"
            android:background="@drawable/key_input_bg"
            android:gravity="center"
            android:hint="Enter a number"
            android:textColor="@android:color/white"
            android:textSize="@dimen/keyboard_input_text_size"/>
        <Button
            android:id="@+id/key_del"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:layout_weight="0.97"
            android:background="@drawable/key_del_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="30sp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/key_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <Button
            android:id="@+id/key_1"
            style="@style/keyboard_btn_style"
            android:layout_margin="6dp"
            android:background="@drawable/key_btn_bg"
            android:text="@string/num1"/>

        <Button
            android:id="@+id/key_2"
            style="@style/keyboard_btn_style"
            android:layout_margin="6dp"
            android:background="@drawable/key_btn_bg"
            android:text="@string/num2"/>

        <Button
            android:id="@+id/key_3"
            style="@style/keyboard_btn_style"
            android:layout_margin="6dp"
            android:background="@drawable/key_btn_bg"
            android:text="@string/num3"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/key_row3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <Button
            android:id="@+id/key_4"
            style="@style/keyboard_btn_style"
            android:layout_margin="6dp"
            android:background="@drawable/key_btn_bg"
            android:text="@string/num4"/>

        <Button
            android:id="@+id/key_5"
            style="@style/keyboard_btn_style"
            android:layout_margin="6dp"
            android:background="@drawable/key_btn_bg"
            android:text="@string/num5"/>

        <Button
            android:id="@+id/key_6"
            style="@style/keyboard_btn_style"
            android:layout_margin="6dp"
            android:background="@drawable/key_btn_bg"
            android:text="@string/num6"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/key_row4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <Button
            android:id="@+id/key_7"
            style="@style/keyboard_btn_style"
            android:layout_margin="6dp"
            android:background="@drawable/key_btn_bg"
            android:text="@string/num7"/>

        <Button
            android:id="@+id/key_8"
            style="@style/keyboard_btn_style"
            android:layout_margin="6dp"
            android:background="@drawable/key_btn_bg"
            android:text="@string/num8"/>

        <Button
            android:id="@+id/key_9"
            style="@style/keyboard_btn_style"
            android:layout_margin="6dp"
            android:background="@drawable/key_btn_bg"
            android:text="@string/num9"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/key_row5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <Button
            android:id="@+id/key_0"
            style="@style/keyboard_btn_style"
            android:layout_margin="6dp"
            android:background="@drawable/key_btn_bg"
            android:text="@string/num0"/>

        <Button
            android:id="@+id/key_dot"
            style="@style/keyboard_btn_style"
            android:layout_margin="6dp"
            android:background="@drawable/key_dot_bg"/>
        <Button
            android:id="@+id/key_enter"
            style="@style/keyboard_btn_style"
            android:layout_margin="6dp"
            android:background="@drawable/key_enter_bg"/>
    </LinearLayout>
</LinearLayout>