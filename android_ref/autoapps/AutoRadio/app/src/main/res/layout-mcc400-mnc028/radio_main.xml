<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:autofm="http://schemas.android.com/apk/res-auto"
    android:id="@+id/radio_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/radio_main_bg"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical">

    <com.hcn.autoradio.view.ViewPager
        android:id="@+id/PresetViewPaper"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        />

    <LinearLayout
        android:id="@+id/ll_radio_status_icon"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:gravity="center">

        <Button
            android:id="@+id/auto_test"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent" />

        <include
            layout="@layout/radio_status_icon"
            android:layout_width="0dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="@dimen/radio_status_icon_layout_marginStart"
            android:layout_height="wrap_content"
            android:layout_weight="6" />

        <ImageView
            android:id="@+id/rds_imgbtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="5dp"
            android:gravity="bottom|center"
            android:src="@drawable/rds_styles_selector"
            android:textColor="@drawable/text_color_selector"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/radio_rds_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rds_ps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/main_text_color"
            android:textSize="20.0sp" />

        <TextView
            android:id="@+id/rds_rt_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="5"
            android:gravity="center_vertical"
            android:textColor="@color/main_text_color"
            android:textSize="18.0sp" />


    </LinearLayout>

    <include
        android:id="@+id/radio_show_info_txt"
        layout="@layout/radio_show_info_txt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.8" />

    <com.hcn.autoradio.view.FMSeekBarView
        android:id="@+id/id_china_seekbar_fm"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1.9"
        android:src="@drawable/radio_scroll_fm_china"
        autofm:scroll_begin="50"
        autofm:scroll_end="974"
        android:visibility="gone"
        autofm:scroll_item="@drawable/radio_scroll_thumb"
        autofm:scroll_uid="8" />

    <Space
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        />

    <!--<include layout="@layout/screen_segment"/>-->

    <include layout="@layout/bottom_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="110dp"
        android:layout_marginStart="110dp"
        android:layout_marginBottom="20dp"/>

</LinearLayout>