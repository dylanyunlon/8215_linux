<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:layoutDirection="ltr">


    <include
        layout="@layout/right_menu"/>


    <FrameLayout android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginEnd="@dimen/btn_seek_up_layout_marginEnd"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/btn_seek_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/butt_xml_prev"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_weight="1"
        android:orientation="vertical">
        />

        <LinearLayout
            android:id="@+id/digital_frequency"
            android:layout_width="@dimen/digital_frequency_layout_width"
            android:layout_height="@dimen/digital_frequency_layout_width"
            android:gravity="center"
            android:background="@drawable/radio_cover"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:textColor="#494545"
                android:textStyle="bold"
                android:text="RADIO"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:gravity="center"
                android:layout_height="wrap_content"
                >

                <TextView
                    android:id="@+id/freq_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/main_text_color"
                    android:textSize="75sp"
                    android:visibility="visible"/>

                <TextView
                    android:id="@+id/text_band_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/fm1"
                    android:textColor="@color/main_text_color"
                    android:textSize="@dimen/band_info_text_size"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/number_A"
                    style="@style/hcn_radio_num_style_textview"/>

                <TextView
                    android:id="@+id/number_B"
                    style="@style/hcn_radio_num_style_textview"/>

                <TextView
                    android:id="@+id/number_C"
                    style="@style/hcn_radio_num_style_textview"/>

                <TextView
                    android:id="@+id/number_D"
                    style="@style/hcn_radio_num_style_textview"/>

                <TextView
                    android:id="@+id/number_E"
                    style="@style/hcn_radio_num_style_textview"/>

                <TextView
                    android:id="@+id/number_F"
                    style="@style/hcn_radio_num_style_textview"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|bottom">
                <TextView
                    android:id="@+id/radio_info_hz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mhz"
                    android:maxLines="1"
                    android:textColor="@color/main_text_color"
                    android:textSize="@dimen/band_info_text_size"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
    <FrameLayout android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/btn_seek_up_layout_marginEnd"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/btn_seek_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/butt_xml_next"/>
    </FrameLayout>

    <include
        layout="@layout/left_menu"/>
</LinearLayout>