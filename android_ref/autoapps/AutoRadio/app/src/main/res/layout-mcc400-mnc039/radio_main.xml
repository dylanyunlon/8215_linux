<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radio_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/radio_main_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_radio_status_icon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.hcn.autoradio.view.RoundKnobSeekBarView
                android:id="@+id/id_round_knob_seekbar_fm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/id_round_knob_seekbar_fm_layout_marginTop"
                android:layout_gravity="center_horizontal|bottom" />

            <Button
                android:id="@+id/auto_test"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:layout_gravity="top"
                android:background="@android:color/transparent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:layout_marginTop="@dimen/radio_show_info_img_margin_Top"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5">

                    <include
                        android:id="@+id/radio_show_info_img"
                        layout="@layout/radio_show_info_img"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_rds_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="@dimen/ll_rds_status_layout_marginEnd"
                    android:gravity="center"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/checkbox_ta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:background="@drawable/checkbox_xml_rds_ta"
                        android:button="@null" />

                    <CheckBox
                        android:id="@+id/checkbox_af"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/checkbox_xml_rds_af"
                        android:button="@null" />

                </LinearLayout>

            </LinearLayout>

            <com.hcn.autoradio.view.ViewPager
                android:id="@+id/PresetViewPaper"
                android:layout_width="match_parent"
                android:layout_height="@dimen/PresetViewPaper_height"
                android:layout_marginTop="@dimen/preset_viewpager_margin_top" />

            <LinearLayout
                android:id="@+id/ll_radio_rds_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/radio_rds_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="0"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/rds_tp_status"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="TP"
                            android:textColor="@color/main_text_color"
                            android:textSize="@dimen/rds_pty_title_text_size"
                            android:visibility="invisible" />

                        <TextView
                            android:id="@+id/rds_ps"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="15dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="@color/main_text_color"
                            android:textSize="@dimen/rds_rt_text_size" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/rds_pty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/rds_pty_title_layout_marginStart"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/rds_pty_title"
                        android:textColor="#CFDDE5"
                        android:textSize="@dimen/rds_pty_title_text_size" />

                    <TextView
                        android:id="@+id/rds_pty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="15dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/rds_pty_def"
                        android:textColor="#CFDDE5"
                        android:textSize="@dimen/rds_pty_title_text_size" />

                    <TextView
                        android:id="@+id/rds_rt_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="15dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#CFDDE5"
                        android:textSize="@dimen/rds_rt_text_size" />

                    <ImageView
                        android:id="@+id/rds_imgbtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/rds_imgbtn_margin_end"
                        android:gravity="center"
                        android:src="@drawable/butt_xml_pty" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>



    <LinearLayout
        android:id="@+id/ll_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="@dimen/ll_bottom_margin_Bottom">

        <include layout="@layout/bottom_menu" />
    </LinearLayout>

</LinearLayout>
