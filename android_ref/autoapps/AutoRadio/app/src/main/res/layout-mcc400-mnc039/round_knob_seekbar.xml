<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    tools:ignore="MissingDefaultResource">

    <com.hcn.autoradio.view.RoundKnobSeekBar
        android:id="@+id/rksb_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/round_knob_seek_bar_bg"
        app:arc_open_angle="60"
        app:arc_draw_edge="false"
        app:arc_width="@dimen/round_knob_seek_bar_arc_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:pic_transparent_distance="@integer/round_knob_seek_bar_pic_transparent_distance" />


    <ImageView
        android:id="@+id/iv_thumb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/round_knob_seek_bar_thumb"
        app:layout_constraintBottom_toBottomOf="@+id/rksb_main"
        app:layout_constraintEnd_toEndOf="@+id/rksb_main"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="@+id/rksb_main"
        app:layout_constraintTop_toTopOf="@+id/rksb_main"
        app:layout_constraintVertical_bias="0.497"
        android:contentDescription="TODO" />

    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/rksb_main"
        app:layout_constraintEnd_toEndOf="@+id/rksb_main"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="@+id/rksb_main"
        app:layout_constraintTop_toTopOf="@+id/rksb_main"
        app:layout_constraintVertical_bias="0.497"
        android:contentDescription="TODO" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/rksb_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/round_knob_seek_bar_text_margin_bottom">

        <TextView
            android:id="@+id/tv_freq_min"
            android:layout_width="@dimen/round_knob_seek_bar_text_width"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textColor="@android:color/white"
            android:textSize="@dimen/round_knob_seek_bar_text_size"
            android:text="87.5" />

        <TextView
            android:id="@+id/tv_freq_max"
            android:layout_width="@dimen/round_knob_seek_bar_text_width"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@android:color/white"
            android:textSize="@dimen/round_knob_seek_bar_text_size"
            android:text="108.0" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>