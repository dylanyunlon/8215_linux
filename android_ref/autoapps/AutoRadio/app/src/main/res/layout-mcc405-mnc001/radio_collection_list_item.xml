<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/collect_list_item_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:ignore="MissingDefaultResource">

    <TextView
        android:id="@+id/tv_collect_list_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:importantForAccessibility="noHideDescendants"
        android:maxLines="1"
        android:layout_marginStart="15dp"
        android:text="1"
        android:textColor="@drawable/text_color_preset"
        android:textSize="@dimen/PresetViewIndexTextSize" />

    <TextView
        android:id="@+id/tv_collect_list_freq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:importantForAccessibility="noHideDescendants"
        android:maxLines="1"
        android:text="87.5"
        android:textColor="@drawable/text_color_preset"
        android:textSize="@dimen/PresetViewFreqTextSize"
        android:layout_marginStart="@dimen/btn_collect_list_margin_start"/>

</LinearLayout>