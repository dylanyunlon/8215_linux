<resources>
    <style name="AppTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/radio_main_bg</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:statusBarColor">#00000000</item>
    </style>
    <style name="hcn_radio_icon_style">
        <item name="android:layout_width">@dimen/hcn_rds_aftapty_style_layout_width</item>
        <item name="android:layout_height">@dimen/hcn_rds_aftapty_style_layout_width</item>
        <item name="android:layout_marginStart">@dimen/hcn_radio_icon_style_layout_marginStart</item>
        <item name="android:button">@null</item>
        <item name="android:enabled">false</item>
        <item name="android:focusable">false</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textColor">@drawable/text_color_selector</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="hcn_radio_num_style">
        <item name="android:layout_width">@dimen/hcn_radio_num_style_layout_width</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="hcn_radio_num_style_textview">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/main_text_color</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">@dimen/hcn_radio_num_style_textview_textSize</item>
    </style>

    <style name="hcn_radio_dot_style">
        <item name="android:layout_width">@dimen/hcn_radio_num_style_layout_width</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="hcn_rds_icon_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:focusable">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="hcn_rds_aftapty_style">
        <item name="android:layout_width">@dimen/hcn_rds_aftapty_style_layout_width</item>
        <item name="android:layout_height">@dimen/hcn_rds_aftapty_style_layout_width</item>
        <item name="android:layout_marginStart">@dimen/hcn_rds_aftapty_style_layout_marginStart</item>
        <item name="android:button">@null</item>
        <item name="android:enabled">false</item>
        <item name="android:focusable">false</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textColor">@drawable/text_color_selector</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="hcn_eq_mode_btn">
        <item name="android:textSize">@dimen/hcn_eq_mode_btn_textSize</item>

        <item name="android:layout_width">@dimen/hcn_eq_mode_layout_width</item>
        <item name="android:layout_height">@dimen/hcn_eq_mode_layout_height</item>
        <item name="android:singleLine">true</item>

        <item name="android:button">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="hcn_rds_pty">
        <item name="android:textSize">@dimen/hcn_rds_pty_textSize</item>
        <item name="android:layout_width">@dimen/hcn_rds_pty_layout_width</item>
        <item name="android:layout_height">@dimen/hcn_rds_pty_layout_height</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">@dimen/ll_rds_pty_padding_start</item>
        <item name="android:singleLine">true</item>
        <item name="android:button">@null</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="hcn_rds_pty_title">
        <item name="android:textSize">@dimen/hcn_rds_pty_title_textSize</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="PopupAnimation">
        <item name="android:windowEnterAnimation">@anim/popup_enter</item>
        <item name="android:windowExitAnimation">@anim/popup_exit</item>
    </style>

    <style name="hcn_preset_view_style">
        <item name="android:layout_width">@dimen/hcn_preset_view_style_layout_width</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/hcn_preset_view_style_paddingStart</item>
        <item name="android:text">@string/defaultfreq</item>
        <item name="android:textColor">@drawable/text_color_preset</item>
        <item name="android:textSize">@dimen/PresetViewFreqTextSize</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">@dimen/hcn_preset_view_style_layout_marginEnd</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:background">@drawable/preset_xml_selector</item>
    </style>
</resources>