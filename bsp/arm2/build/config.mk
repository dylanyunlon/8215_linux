ifeq "$(target_project)" ""
 $(error "target_project should be confirmed!")
endif

include $(ARM2BUILDDIR)/config-$(target_project).mk
include $(ARM2TOPDIR)/../../../config/rsv.mk

ARM2_INTERNAL_CDEFS := $(foreach t,$(AUTO_ADD_GLOBAL_DEFINE_BY_NAME),$(if $(filter-out no NO none NONE false FALSE,$($(t))),-D$(t)))
ARM2_INTERNAL_CDEFS += $(foreach t,$(AUTO_ADD_GLOBAL_DEFINE_BY_VALUE),$(if $(filter-out no NO none NONE false FALSE,$($(t))),$(foreach v,$(shell echo $($(t)) | tr '[a-z]' '[A-Z]'),-D$(v))))
ARM2_INTERNAL_CDEFS += $(foreach t,$(AUTO_ADD_GLOBAL_DEFINE_BY_NAME_VALUE),$(if $(filter-out no NO none NONE false FALSE,$($(t))),-D$(t)=\"$($(t))\"))

GLOBAL_CFLAG := -D__ARM2__
GLOBAL_CFLAG += -w

# ARM92E6JS: Arch v5te
ARCH_CFLAG := -marm -march=armv5te

# debug option
DEBUG_CFLAG += -g3 -gdwarf-4 -gstrict-dwarf
DEBUG_CFLAG += -fno-omit-frame-pointer

GLOBAL_CFLAG += \
	$(ARCH_CFLAG) \
	$(DEBUG_CFLAG)

GLOBAL_CFLAG += $(ARM2_INTERNAL_CDEFS)
ifeq ($(CONFIG_ARGS_START),)
$(error ***CONFIG_ARGS_START is NULL,please check***)
else
GLOBAL_CFLAG += -DCONFIG_ARGS_START=$(CONFIG_ARGS_START)
endif
ifeq  ($(ATC_DEBUG_TYPE), user)
GLOBAL_CFLAG +=-DCONFIG_ATC_USER
else
GLOBAL_CFLAG +=-DCONFIG_ATC_USERDEBUG
endif

ifeq ($(AC83XX_BOOT_DEVICE),nand)
    GLOBAL_CFLAG +=-DATC_BOOT_NAND
endif

ifeq ($(AC83XX_BOOT_DEVICE),nor)
    GLOBAL_CFLAG +=-DATC_BOOT_NOR
endif

ifeq ($(AC83XX_BOOT_DEVICE),emmc)
    GLOBAL_CFLAG +=-DATC_BOOT_EMMC
endif

ifeq ($(ATC_AB_PARTITION_SUPPORT),true)
    GLOBAL_CFLAG +=-DATC_AB_PARTITION_SUPPORT
endif
GLOBAL_CFLAG += -specs=nosys.specs
GLOBAL_CFLAG += -D__linux__

GLOBAL_LDFLAG := -L$(ARM2TOPDIR)/4.4 -lstdc++
GLOBAL_LDFLAG += -L$(ARM2TOPDIR)/4.4 -lc
GLOBAL_LDFLAG += -L$(ARM2TOPDIR)/4.4 -lm
GLOBAL_LDFLAG += -L$(ARM2TOPDIR)/4.4 -lgcc
#GLOBAL_LDFLAG += -L$(ARM2TOPDIR)/4.4 -lgcc_eh

ifeq ($(CFG_ARGS_RESERVED_ADDR),)
$(error ***CFG_ARGS_RESERVED_ADDR is NULL,please check***)
else
GLOBAL_CFLAG += -DCONFIG_ARGS_START=$(CFG_ARGS_RESERVED_ADDR)
GLOBAL_CFLAG += -DCONFIG_ARGS_SIZE=$(CFG_ARGS_RESERVED_SIZE)
endif

ifeq ($(CFG_DATAZONE_RESERVED_ADDR),)
$(error ***CONFIG_DATAZONE_RESERVED is NULL,please check***)
else
GLOBAL_CFLAG += -DCONFIG_DATAZONE_START=$(CFG_DATAZONE_RESERVED_ADDR)
GLOBAL_CFLAG += -DCONFIG_DATAZONE_SIZE=$(CFG_DATAZONE_RESERVED_SIZE)
endif

GLOBAL_CFLAG += -DARM2

include $(ARM2TOPDIR)/../../../config/rsv.mk

GLOBAL_CFLAG += -DCFG_ARM2_RESERVED_ADDR=$(CFG_ARM2_RESERVED_ADDR)
GLOBAL_CFLAG += -DCFG_ARM2_RESERVED_SIZE=$(CFG_ARM2_RESERVED_SIZE)
# import rsv address from rsv.mk
# Notes: address must be translate to arm2 address: PA - $(CFG_ARM2_RESERVED_ADDR)
GLOBAL_CFLAG += \
	-DCFG_ARGS_RESERVED_ADDR=$(CFG_ARGS_RESERVED_ADDR)                       -DCFG_ARGS_RESERVED_SIZE=$(CFG_ARGS_RESERVED_SIZE) \
	-DCFG_METAZONE_RESERVED_ADDR=$(CFG_METAZONE_RESERVED_ADDR)               -DCFG_METAZONE_RESERVED_SIZE=$(CFG_METAZONE_RESERVED_SIZE) \
	-DCFG_FRAMEBUFFER_RESERVED_ADDR=$(CFG_FRAMEBUFFER_RESERVED_ADDR)         -DCFG_FRAMEBUFFER_RESERVED_SIZE=$(CFG_FRAMEBUFFER_RESERVED_SIZE) \
	-DCFG_WCH_RESERVED_ADDR=$(CFG_WCH_RESERVED_ADDR)                         -DCFG_WCH_RESERVED_SIZE=$(CFG_WCH_RESERVED_SIZE) \
	-DCFG_ARM2_BACKCAR_UI_RESERVED_ADDR=$(CFG_ARM2_BACKCAR_UI_RESERVED_ADDR) -DCFG_ARM2_BACKCAR_UI_RESERVED_SIZE=$(CFG_ARM2_BACKCAR_UI_RESERVED_SIZE) \
	-DCFG_IMAGERESIZE_RESERVED_ADDR=$(CFG_IMAGERESIZE_RESERVED_ADDR)         -DCFG_IMAGERESIZE_RESERVED_SIZE=$(CFG_IMAGERESIZE_RESERVED_SIZE) \
	-DCFG_MM_RESERVED_ADDR=$(CFG_MM_RESERVED_ADDR)                           -DCFG_MM_RESERVED_SIZE=$(CFG_MM_RESERVED_SIZE) \
	-DCFG_VBA_RESERVED_ADDR=$(CFG_VBA_RESERVED_ADDR)                         -DCFG_VBA_RESERVED_SIZE=$(CFG_VBA_RESERVED_SIZE) \
	-DCFG_AUDIO_R1_ADDR=$(CFG_AUDIO_R1_ADDR)                                 -DCFG_AUDIO_R1_SIZE=$(CFG_AUDIO_R1_SIZE) \
	-DCFG_ANIMATION_RESERVED_ADDR=$(CFG_ANIMATION_RESERVED_ADDR)             -DCFG_ANIMATION_RESERVED_SIZE=$(CFG_ANIMATION_RESERVED_SIZE) \
	-DCFG_DATAZONE_RESERVED_ADDR=$(CFG_DATAZONE_RESERVED_ADDR)               -DCFG_DATAZONE_RESERVED_SIZE=$(CFG_DATAZONE_RESERVED_SIZE) \
