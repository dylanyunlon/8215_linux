HARDWARE_PATH := $(TOPDIR)/../lib/preloader_hardware
exist := $(shell if [ -d $(HARDWARE_PATH) ]; then echo "exist"; else echo "notexist"; fi)
ifeq ($(exist), exist)
all:
	@echo "Running Make libs"
	mkdir -p $(OBJDIR)/libhardware
	$(MAKE) -C $(HARDWARE_PATH) libs  "O=$(OBJDIR)/libhardware" "G_INCLUDE=$(GINCLUDE)" "SHELL=$(SHELL)" "COMPILER=$(CC)" "ARCHIVER=$(AR)" "STRIP=$(STRIP)" "COMPILER_FLAGS=$(GOPTION)  -O2" "EXTRA_COMPILER_FLAGS=-g"
else
PREBUILD_LIBRARIES = $(PREBUILDDIR)/libhardware.a
all:
	@echo 'Using prebuild security libraries'
	mkdir -p $(OBJDIR)/libhardware
	@cp $(PREBUILD_LIBRARIES) $(OBJDIR)/libhardware
endif
.PHONY: clean
clean:
	@echo 'Cleanning prebuild security libraries'
