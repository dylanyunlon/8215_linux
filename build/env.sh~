# $RCSfile: env.sh,v $
# $Revision: #30 $
# $Date: 2016/02/15 $
# $Author: jianghong.lin $
#
# Description:
#         script to setup DA build environment 
#         The following commands are supported:
#             TARGET : ac8317 or ac8015 
#             BOOTTYPE : sd2, nand or emmc
#             BUILD_CFG: debug or rel
#                 Builds the specified target with symbolic debug info#
#############################################################################
#!/bin/sh

#### src root dir name can be changed#########

export SRC_ROOT_DIR=atc_linux
export TOP_MAKE=build/mak

TARGET=ac8317
PROJECT_CONFIG=evb_8317

function dump_var()
{
    echo "###########Proj  Config################"
    echo "## Target=${TARGET}                    "
    echo "## Proj: ${PROJECT}                    "
    echo "## Boot Type: ${AC83XX_BOOT_DEVICE}    "
    echo "## Build Type: ${BUILD_CFG}            "
    echo "## DA Top dir: ${DA_TOP}               "
    echo "## DA out dir: ${DA_OUTPUT}            "
    echo "## Drive Lib: ${DRVLIB_DIR}            "
    echo "## Proj root: ${PROJECT_DIR}              "
    echo "## Parallel Build job : -j${JOB_NUM}   "
    echo "######## env setup finish!!!###########"
}

if [ "$PROJECT" = "" ];then
    export PROJECT=atc
fi
export CUSTOMER=${PROJECT}
export MODEL_NAME=${TARGET}

export BUILD_ROOT=`pwd`
BUILD_ROOT=`echo ${BUILD_ROOT%/${SRC_ROOT_DIR}*}`
BUILD_ROOT=${BUILD_ROOT}/${SRC_ROOT_DIR}
if [ ${BUILD_ROOT} ];then
    export DA_TOP=${BUILD_ROOT}
fi

if [ "$BUILD_CFG" = "" ];then
    export BUILD_CFG=rel
fi

if [ "$BUILD_CFG" = "rel" ];then
   export DRIVER_DEBUG_BUILD=false
else 
   export DRIVER_DEBUG_BUILD=true
fi

#	directory var
#
export TOOL_CHAIN_DIR=/mtkoss/gnuarm/vfp_4.8.2_2.6.35_cortex-a9-ubuntu/i686/bin
export KERNEL_SRC=$DA_TOP/kernel/kernel-3.18
export SCRIPTS_PATH=$DA_TOP/kernel/kernel-3.18/scripts
export KERNELDIR=${KERNEL_SRC}
export KERNEL_PATH=${KERNEL_SRC}
export ARM2_SRC=$DA_TOP/arm2
export UBOOT_SRC=$DA_TOP/bootloader/uboot
export DA_OUTPUT=$DA_TOP/out/${CUSTOMER}/${TARGET}/${BUILD_CFG}
export OSS_TOP=$DA_TOP/oss
export OSS_LIB_TOP=$DA_TOP/oss/lib
export DA_LIBDIR=$DA_TOP/lib
#export DA_SYSROOT=$OSS_LIB_TOP/gnuarm-4.8.2_vfp/${TARGET}/sysroot
export DA_INCPATH=$DA_LIBDIR/include
export DRVLIB_DIR=$DA_LIBDIR/drv_lib
export DRVKO_DIR=$DA_LIBDIR/drv_ko
export BUILD_TOOLDIR=$DA_TOP/build/tools
export IMG_REL=$DA_TOP/image-release
export APP_PATH=$DA_TOP/application
export AVIN_PATH=$DA_TOP/avin
export CONNECTIVE_PATH=$DA_TOP/connectivity
export GRAPHICS_PATH=$DA_TOP/graphics
export MM_PATH=$DA_TOP/multimedia
export SDK_PATH=$DA_TOP/sdk
export AUTOTOOL_ROOT=$OSS_LIB_TOP/x86-linux
export METADATA_OUTPUT=$DA_TOP/out/atc/ac8317
export METADATA_OUTPUT_ROOT=$DA_TOP/out/atc/ac8317/rel
export OBJ_ROOT=$DA_TOP/out/atc/ac8317/rel
export ROOTFS_OUT=$OBJ_ROOT/root

#	common makefile
#
export BUILD_EXECUTABLE=$DA_TOP/build/mak/build_exe.mak
export BUILD_SHARED_LIBRARY=$DA_TOP/build/mak/build_share_lib.mak
export BUILD_STATIC_LIBRARY=$DA_TOP/build/mak/build_static_lib.mak
export RECURSION_MAK=$DA_TOP/build/mak/recursion_build.mak
export OSS_COMMON_MAK=$DA_TOP/build/mak/oss_common.mak

export PKG_CONFIG_GST=0.1
export MM_SUPPORT_SWDEC=true

#	cpu number
#
export JOB_NUM=`grep processor /proc/cpuinfo |wc -l`


if [ ! -d "${DA_TOP}/build/log" ];then
  mkdir -p ${DA_TOP}/build/log
fi


export CUST_DIR=${DA_TOP}/project/${MODEL_NAME}
export PROJECT_DIR=${DA_TOP}/project/${PROJECT_CONFIG}

if [ "$1" = "systemd" ]; then
   INIT_TYPE=sysd
else
   INIT_TYPE=sysv
fi

#Select SDK path according to init type
export INIT_TYPE
if [ "$INIT_TYPE" = "sysv" ]; then
  SDKPATH=/mtkoss/yptool/1.7/qtsdk
else
  SDKPATH=/mtkoss/yptool/1.7/qtsdk_sysd
fi

#Specify sysroot path for different version
#export DA_SYSROOT=$OSS_LIB_TOP/arm-poky-linux/${TARGET}_${INIT_TYPE}/sysroot
export DA_SYSROOT=$DA_LIBDIR/sysroot/${TARGET}-arm-${INIT_TYPE}
mkdir -p $DA_SYSROOT

#	pkg-config
#
export PKG_CONFIG_PATH=$DA_SYSROOT/usr/lib/pkgconfig:$DA_SYSROOT/lib/pkgconfig:$DA_SYSROOT/usr/share/pkgconfig
export PKG_CONFIG_SYSROOT_DIR=$DA_SYSROOT
export PKG_CONFIG_DIABLE_UNINSTALLED=no
export PKG_CONFIG_ALLOW_SYSTEM_LIBS=yes
export PKG_CONFIG_LIBDIR=$DA_SYSROOT
export PKG_CONFIG_DIR=$DA_SYSROOT/usr/lib

export SDKTARGETSYSROOT=${SDKPATH}/sysroots/armv7a-vfp-neon-poky-linux-gnueabi
export PATH=$PATH:${SDKPATH}/sysroots/x86_64-pokysdk-linux/usr/bin:${SDKPATH}/sysroots/x86_64-pokysdk-linux/usr/bin/arm-poky-linux-gnueabi
#export PKG_CONFIG_SYSROOT_DIR=$SDKTARGETSYSROOT
#export PKG_CONFIG_PATH=$SDKTARGETSYSROOT/usr/lib/pkgconfig

export SDKFILEVER=${SDKTARGETSYSROOT}/../../version-armv7a-vfp-neon-poky-linux-gnueabi
export LOCALSDKVER=${OBJ_ROOT}/../version-armv7a-vfp-neon-poky-linux-gnueabi
export YP_SDK_VER=`grep -ri ^Timestamp: ${SDKFILEVER} |cut -d' ' -f 2`

#Check local SDK is existing or not
if [ -f $LOCALSDKVER ];then
  LOCAL_VER=`grep -ri ^Timestamp: ${LOCALSDKVER} |cut -d' ' -f 2`
else
  mkdir -p ${OBJ_ROOT}
  touch $LOCALSDKVER
  LOCAL_VER=
fi
export LOCAL_VER

export SDK_EXCLUDE=${DA_TOP}/build/exclude.list
if [ ! -f $SDK_EXCLUDE ]; then
  SDK_EXCLUDE=
fi

make init

#	autotool
#
export PATH=$AUTOTOOL_ROOT/usr/bin:$PATH
export PATH=$PATH:$BUILD_TOOLDIR
export PATH=$DA_TOP/build:$PATH
export PATH=$TOOL_CHAIN_DIR:$PATH
export PATH=$DA_TOP:$PATH
export PATH=$DA_TOP/tool/commonapi_dbus_generator:$PATH
export PATH=$DA_TOP/tool/commonapi-generator:$PATH
export PATH=/mtkoss/jdk/jdk1.7.0_09/bin:$PATH

export BUILD_SYSTEM=atc

export CONFIG_SITE=${SDKPATH}/site-config-armv7a-vfp-neon-poky-linux-gnueabi
export OECORE_NATIVE_SYSROOT="${SDKPATH}/sysroots/x86_64-pokysdk-linux"
export OECORE_TARGET_SYSROOT="$DA_SYSROOT"
#export DA_SYSROOT="$SDKTARGETSYSROOT"
export OECORE_ACLOCAL_OPTS="-I ${SDKPATH}/sysroots/x86_64-pokysdk-linux/usr/share/aclocal"
#export PYTHONHOME=${SDKPATH}/sysroots/x86_64-pokysdk-linux/usr
export CC="arm-poky-linux-gnueabi-gcc  -march=armv7-a -mthumb-interwork -mfloat-abi=softfp -mfpu=neon --sysroot=$DA_SYSROOT"
export CXX="arm-poky-linux-gnueabi-g++  -march=armv7-a -mthumb-interwork -mfloat-abi=softfp -mfpu=neon --sysroot=$DA_SYSROOT"
export CPP="arm-poky-linux-gnueabi-gcc -E  -march=armv7-a -mthumb-interwork -mfloat-abi=softfp -mfpu=neon --sysroot=$DA_SYSROOT"
export AS="arm-poky-linux-gnueabi-as "
export LD="arm-poky-linux-gnueabi-ld  --sysroot=$DA_SYSROOT"
export GDB=arm-poky-linux-gnueabi-gdb
export STRIP=arm-poky-linux-gnueabi-strip
export RANLIB=arm-poky-linux-gnueabi-ranlib
export OBJCOPY=arm-poky-linux-gnueabi-objcopy
export OBJDUMP=arm-poky-linux-gnueabi-objdump
export AR=arm-poky-linux-gnueabi-ar
export NM=arm-poky-linux-gnueabi-nm
export M4=m4
export TARGET_PREFIX=arm-poky-linux-gnueabi-
export CONFIGURE_FLAGS="--target=arm-poky-linux-gnueabi --host=arm-poky-linux-gnueabi --build=x86_64-linux --with-libtool-sysroot=$SDA_SYSROOT"
export CFLAGS=" -O2 -pipe -g -feliminate-unused-debug-types"
export CXXFLAGS=" -O2 -pipe -g -feliminate-unused-debug-types"
export LDFLAGS="-Wl,-O1 -Wl,--hash-style=gnu -Wl,--as-needed"
export CPPFLAGS=""
export KCFLAGS="--sysroot=$DA_SYSROOT"
export OECORE_DISTRO_VERSION="1.7.2"
export OECORE_SDK_VERSION="1.7.2"
export ARCH=arm
export CROSS_COMPILE=arm-poky-linux-gnueabi-

# Append environment subscripts
if [ -d "$OECORE_TARGET_SYSROOT/environment-setup.d" ]; then
    for envfile in $OECORE_TARGET_SYSROOT/environment-setup.d/*.sh; do
            source $envfile
    done
fi
if [ -d "$OECORE_NATIVE_SYSROOT/environment-setup.d" ]; then
    for envfile in $OECORE_NATIVE_SYSROOT/environment-setup.d/*.sh; do
            source $envfile
    done
fi
export CROSS_COMPILE_PREFIX=arm-poky-linux-gnueabi-

dump_var
