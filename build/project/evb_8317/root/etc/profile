# For Ash

export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/libexec:/usr/libexec/udev
#LD_LIBRARY_PATH=$QTDIR/lib:$LD_LIBRARY_PATH
export UDEV_CONFIG_FILE=/etc/udev/udev.conf
export PATH runlevel prevlevel QTDIR UDEV_CONFIG_FILE

export QT_QPA_PLATFORM_PLUGIN_PATH=/usr/plugins
#export QT_QPA_PLATFORM=eglfs
#export QT_QPA_GENERIC_PLUGINS=libinput

export XDG_RUNTIME_DIR=/tmp/weston_runtime_dir

alias ls='ls --color=never'
alias ll='ls -al --color=never'
