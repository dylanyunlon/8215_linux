+   <http://www.gnu.org/licenses/>.  */
+
+#include <sys/uio.h>
+#include <_itoa.h>
+#include <sys/ucontext.h>
+
+/* We will print the register dump in this format:
+
+ R0: XXXXXXXX    R1: XXXXXXXX    R2: XXXXXXXX     R3: XXXXXXXX
+ R4: XXXXXXXX    R5: XXXXXXXX    R6: XXXXXXXX     R7: XXXXXXXX
+ R8: XXXXXXXX    R9: XXXXXXXX    R10: XXXXXXXX    R11: XXXXXXXX
+ R12: XXXXXXXX   R13: XXXXXXXX   R14: XXXXXXXX   R15: XXXXXXXX
+ R16: XXXXXXXX   R17: XXXXXXXX   R18: XXXXXXXX   R19: XXXXXXXX
+ R20: XXXXXXXX   R21: XXXXXXXX   R22: XXXXXXXX   R23: XXXXXXXX
+ R24: XXXXXXXX   R25: XXXXXXXX   R26: XXXXXXXX   R27: XXXXXXXX
+ R28: XXXXXXXX   R29: XXXXXXXX   R30: XXXXXXXX   SP: XXXXXXXX
+ CP: XXXXXXXX
+
+ pstate: XXXXXXXX
+
+ Trap: XXXXXXXX   Error: XXXXXXXX   OldMask: XXXXXXXX
+ Addr: XXXXXXXX
+
+ */
+
+static void
+hexvalue (unsigned long int value, char *buf, size_t len)
+{
+  char *cp = _itoa_word (value, buf + len, 16, 0);
+  while (cp > buf)
+    *--cp = '0';
+}
+
+static void
+register_dump (int fd, int tmp_fd, const ucontext_t *ctx)
+{
+  char regs[35][16];
+  struct iovec iov[97];
+  size_t nr = 0;
+
+#define ADD_STRING(str)                 \
+  iov[nr].iov_base = (char *) str;		\
+  iov[nr].iov_len = strlen (str);		\
+  ++nr
+#define ADD_MEM(str, len)               \
+  iov[nr].iov_base = str;				\
+  iov[nr].iov_len = len;				\
+  ++nr
+
+  /* Generate strings of register contents.  */
+  hexvalue (ctx->uc_mcontext.regs[0],  regs[0], 16);
+  hexvalue (ctx->uc_mcontext.regs[1],  regs[1], 16);
+  hexvalue (ctx->uc_mcontext.regs[2],  regs[2], 16);
+  hexvalue (ctx->uc_mcontext.regs[3],  regs[3], 16);
+  hexvalue (ctx->uc_mcontext.regs[4],  regs[4], 16);
+  hexvalue (ctx->uc_mcontext.regs[5],  regs[5], 16);
+  hexvalue (ctx->uc_mcontext.regs[6],  regs[6], 16);
+  hexvalue (ctx->uc_mcontext.regs[7],  regs[7], 16);
+  hexvalue (ctx->uc_mcontext.regs[8],  regs[8], 16);
+  hexvalue (ctx->uc_mcontext.regs[9],  regs[9], 16);
+  hexvalue (ctx->uc_mcontext.regs[10], regs[10], 16);
+  hexvalue (ctx->uc_mcontext.regs[11], regs[11], 16);
+  hexvalue (ctx->uc_mcontext.regs[12], regs[12], 16);
+  hexvalue (ctx->uc_mcontext.regs[13], regs[13], 16);
+  hexvalue (ctx->uc_mcontext.regs[14], regs[14], 16);
+  hexvalue (ctx->uc_mcontext.regs[15], regs[15], 16);
+  hexvalue (ctx->uc_mcontext.regs[16], regs[16], 16);
+  hexvalue (ctx->uc_mcontext.regs[17], regs[17], 16);
+  hexvalue (ctx->uc_mcontext.regs[18], regs[18], 16);
+  hexvalue (ctx->uc_mcontext.regs[19], regs[19], 16);
+  hexvalue (ctx->uc_mcontext.regs[20], regs[20], 16);
+  hexvalue (ctx->uc_mcontext.regs[21], regs[21], 16);
+  hexvalue (ctx->uc_mcontext.regs[22], regs[22], 16);
+  hexvalue (ctx->uc_mcontext.regs[23], regs[23], 16);
+  hexvalue (ctx->uc_mcontext.regs[24], regs[24], 16);
+  hexvalue (ctx->uc_mcontext.regs[25], regs[25], 16);
+  hexvalue (ctx->uc_mcontext.regs[26], regs[26], 16);
+  hexvalue (ctx->uc_mcontext.regs[27], regs[27], 16);
+  hexvalue (ctx->uc_mcontext.regs[28], regs[28], 16);
+  hexvalue (ctx->uc_mcontext.regs[29], regs[29], 16);
+  hexvalue (ctx->uc_mcontext.regs[30], regs[30], 16);
+  hexvalue (ctx->uc_mcontext.sp,       regs[31], 16);
+  hexvalue (ctx->uc_mcontext.pc,       regs[32], 16);
+  hexvalue (ctx->uc_mcontext.pstate,   regs[33], 16);
+  hexvalue (ctx->uc_mcontext.fault_address, regs[34], 16);
+
+  /* Generate the output.  */
+  ADD_STRING ("\nRegister dump:");
+  ADD_STRING ("\n PC(Program-Counter): ");
+  ADD_MEM (regs[32], 16);
+  ADD_STRING ("\n LR(Link-Register):   ");
+  ADD_MEM (regs[30], 16);
+  ADD_STRING ("\n FP(Frame-Pointer):   ");
+  ADD_MEM (regs[29], 16);
+  ADD_STRING ("\n SP(Stack-Pointer):   ");
+  ADD_MEM (regs[31], 16);
+  ADD_STRING ("\n CPSR(Process-State): ");
+  ADD_MEM (regs[33], 16);
+  ADD_STRING ("\n Fault Addr:          ");
+  ADD_MEM (regs[34], 16);
+
+  ADD_STRING ("\n X0:  ");
+  ADD_MEM (regs[0], 16);
+  ADD_STRING ("   X1:  ");
+  ADD_MEM (regs[1], 16);
+  ADD_STRING ("   X2:  ");
+  ADD_MEM (regs[2], 16);
+  ADD_STRING ("   X3:  ");
+  ADD_MEM (regs[3], 16);
+  ADD_STRING ("\n X4:  ");
+  ADD_MEM (regs[4], 16);
+  ADD_STRING ("   X5:  ");
+  ADD_MEM (regs[5], 16);
+  ADD_STRING ("   X6:  ");
+  ADD_MEM (regs[6], 16);
+  ADD_STRING ("   X7:  ");
+  ADD_MEM (regs[7], 16);
+  ADD_STRING ("\n X8:  ");
+  ADD_MEM (regs[8], 16);
+  ADD_STRING ("   X9:  ");
+  ADD_MEM (regs[9], 16);
+  ADD_STRING ("   X10: ");
+  ADD_MEM (regs[10], 16);
+  ADD_STRING ("   X11: ");
+  ADD_MEM (regs[11], 16);
+  ADD_STRING ("\n X12: ");
+  ADD_MEM (regs[12], 16);
+  ADD_STRING ("   X13: ");
+  ADD_MEM (regs[13], 16);
+  ADD_STRING ("   X14: ");
+  ADD_MEM (regs[14], 16);
+  ADD_STRING ("   X15: ");
+  ADD_MEM (regs[15], 16);
+  ADD_STRING ("\n X16: ");
+  ADD_MEM (regs[16], 16);
+  ADD_STRING ("   X17: ");
+  ADD_MEM (regs[17], 16);
+  ADD_STRING ("   X18: ");
+  ADD_MEM (regs[18], 16);
+  ADD_STRING ("   X19: ");
+  ADD_MEM (regs[19], 16);
+  ADD_STRING ("\n X20: ");
+  ADD_MEM (regs[20], 16);
+  ADD_STRING ("   X21: ");
+  ADD_MEM (regs[21], 16);
+  ADD_STRING ("   X22: ");
+  ADD_MEM (regs[22], 16);
+  ADD_STRING ("   X23: ");
+  ADD_MEM (regs[23], 16);
+  ADD_STRING ("\n X24: ");
+  ADD_MEM (regs[24], 16);
+  ADD_STRING ("   X25: ");
+  ADD_MEM (regs[25], 16);
+  ADD_STRING ("   X26: ");
+  ADD_MEM (regs[26], 16);
+  ADD_STRING ("   X27: ");
+  ADD_MEM (regs[27], 16);
+  ADD_STRING ("\n X28: ");
+  ADD_MEM (regs[28], 16);
+
+  /* Write the stuff out.  */
+  if (fd >= 0)
+    writev (fd, iov, nr);
+  if (tmp_fd >= 0)
+    writev (tmp_fd, iov, nr);
+}
+
+
+#define REGISTER_DUMP register_dump(fd, tmp_fd, ctx)
+
