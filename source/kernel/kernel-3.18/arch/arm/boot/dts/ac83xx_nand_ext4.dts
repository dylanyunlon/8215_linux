/******************************************************************/
/***************    MSDC Setting Define   *************************/
/******************************************************************/
&pio {
	mmc0_pins_default: mmc0@default {
			pins_cmd {
				drive-strength = /bits/ 8 <0x2F>;
			};
			pins_dat {
				drive-strength = /bits/ 8 <0x2F>;
			};
			pins_clk {
				drive-strength = /bits/ 8 <0x2F>;
			};
	};

	mmc0_register_setting_default: mmc0@register_default {
					dat0rddly      = /bits/ 8 <0>;
        	dat1rddly      = /bits/ 8 <0>;
        	dat2rddly      = /bits/ 8 <0>;
       		dat3rddly      = /bits/ 8 <0>;
        	dat4rddly      = /bits/ 8 <0>;
        	dat5rddly      = /bits/ 8 <0>;
        	dat6rddly      = /bits/ 8 <0>;
        	dat7rddly      = /bits/ 8 <0>;
        	datwrddly      = /bits/ 8 <0>;
        	cmdrrddly      = /bits/ 8 <0>;
        	cmdrddly       = /bits/ 8 <0>;
        	cmd_edge 			= /bits/ 8 <MSDC_SMPL_FALLING>;
			rdata_edge 		= /bits/ 8 <MSDC_SMPL_FALLING>;
			wdata_edge 		= /bits/ 8 <MSDC_SMPL_FALLING>;
	};

	mmc1_pins_default: mmc1@default {
			pins_cmd {
				drive-strength = /bits/ 8 <0x2F>;
			};
			pins_dat {
				drive-strength = /bits/ 8 <0x2F>;
			};
			pins_clk {
				drive-strength = /bits/ 8 <0x2F>;
			};
	};

	mmc1_pins_sdr104: mmc1@sdr104 {
#ifdef CONFIG_ATC_WIFI_CHIP_AIC8800_SDIO
			pins_cmd {
				drive-strength = /bits/ 8 <0x2>;
			};
			pins_dat {
				drive-strength = /bits/ 8 <0x2>;
			};
			pins_clk {
				drive-strength = /bits/ 8 <0x2>;
			};
#else
			pins_cmd {
				drive-strength = /bits/ 8 <0x2F>;
			};
			pins_dat {
				drive-strength = /bits/ 8 <0x2F>;
			};
			pins_clk {
				drive-strength = /bits/ 8 <0x2F>;
			};
#endif
	};

	mmc1_pins_sdr50: mmc1@sdr50 {
			pins_cmd {
				drive-strength = /bits/ 8 <2>;
			};
			pins_dat {
				drive-strength = /bits/ 8 <2>;
			};
			pins_clk {
				drive-strength = /bits/ 8 <3>;
			};
	};

	mmc1_pins_ddr50: mmc1@ddr50 {
			pins_cmd {
				drive-strength = /bits/ 8 <2>;
			};
			pins_dat {
				drive-strength = /bits/ 8 <2>;
			};
			pins_clk {
				drive-strength = /bits/ 8 <3>;
			};
	};

	mmc1_register_setting_default: mmc1@register_default {
							dat0rddly      = /bits/ 8 <0>;
        			dat1rddly      = /bits/ 8 <0>;
        			dat2rddly      = /bits/ 8 <0>;
        			dat3rddly      = /bits/ 8 <0>;
        			datwrddly      = /bits/ 8 <0>;
        			cmdrrddly      = /bits/ 8 <0>;
        			cmdrddly       = /bits/ 8 <0>;
        			cmd_edge 		= /bits/ 8 <MSDC_SMPL_FALLING>;
					rdata_edge 	= /bits/ 8 <MSDC_SMPL_FALLING>;
					wdata_edge 	= /bits/ 8 <MSDC_SMPL_FALLING>;
	};

	mmc2_pins_default: mmc2@default {
			pins_cmd {
				drive-strength = /bits/ 8 <0xC>;
			};
			pins_dat {
				drive-strength = /bits/ 8 <0xC>;
			};
			pins_clk {
				drive-strength = /bits/ 8 <0x7>;
			};
	};

	mmc2_pins_sdr104: mmc2@sdr104 {
			pins_cmd {
				drive-strength = /bits/ 8 <2>;
			};
			pins_dat {
				drive-strength = /bits/ 8 <2>;
			};
			pins_clk {
				drive-strength = /bits/ 8 <3>;
			};
	};

	mmc2_pins_sdr50: mmc2@sdr50 {
			pins_cmd {
				drive-strength = /bits/ 8 <2>;
			};
			pins_dat {
				drive-strength = /bits/ 8 <2>;
			};
			pins_clk {
				drive-strength = /bits/ 8 <3>;
			};
	};

	mmc2_pins_ddr50: mmc2@ddr50 {
			pins_cmd {
				drive-strength = /bits/ 8 <2>;
			};
			pins_dat {
				drive-strength = /bits/ 8 <2>;
			};
			pins_clk {
				drive-strength = /bits/ 8 <3>;
			};
	};

	mmc2_register_setting_default: mmc2@register_default {
							dat0rddly      = /bits/ 8 <0>;
        			dat1rddly      = /bits/ 8 <0>;
        			dat2rddly      = /bits/ 8 <0>;
        			dat3rddly      = /bits/ 8 <0>;
        			datwrddly      = /bits/ 8 <0>;
        			cmdrrddly      = /bits/ 8 <0>;
        			cmdrddly       = /bits/ 8 <0>;
        			cmd_edge 		= /bits/ 8 <MSDC_SMPL_FALLING>;
					rdata_edge 	= /bits/ 8 <MSDC_SMPL_FALLING>;
					wdata_edge 	= /bits/ 8 <MSDC_SMPL_FALLING>;
	};
};
