/dts-v1/;

/include/ "skeleton.dtsi"

#include <generated/autoconf.h>
#include <dt-bindings/mmc/ac83xx-msdc.h>
#include <dt-bindings/clock/ac8317-clk.h>
#include <dt-bindings/pinctrl/ac8317-pinmux.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "Autochips,ac83xx";
	interrupt-parent = <&intc>;
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
        i2c0 = &i2c0;
        i2c1 = &i2c1;
        gpio = &gpio;
	};


  	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		enable-method = "ac83xx,ac83xx-cpu-method";

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <1>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <2>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <3>;
		};
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupts =
			<1 13
				3848>,
			<1 14
				3848>,
			<1 11
				3848>,
			<1 10
				3848>;
		clock-frequency = <6750000>;
	};

	chosen {
	/*according to boottype: normal or recovery,  overwrite bootarg by bootarg1 or bootarg2, so not modify bootargs,modify bootargs1 or bootargs2 according to boot type*/
	bootargs = "noinitrd root=/dev/mtkd9 rw rootfstype=ext4 rootwait init=/sbin/init systemd.log_target=console console=ttyMT0 nohlt loglevel=8 user_debug=31 no_console_suspend vmalloc=400M";

	/*for boot normal*/
	bootargs1 = "noinitrd root=/dev/mtkd9 ro rootfstype=ext4 rootwait init=/sbin/init systemd.log_target=console console=ttyMT0 nohlt loglevel=8 user_debug=31 no_console_suspend vmalloc=400M";

	/*for boot recovery*/
	bootargs2 = "root=/dev/ram0 rw initrd=0xC800000,0x3200000 init=/init systemd.log_target=console console=ttyMT0 nohlt loglevel=8 user_debug=31 no_console_suspend vmalloc=400M";
		/********
		* bootargs = "root=/dev/ram0 rw initrd=0x07000000,0x200000 init=/init console=ttyMT0 mem=370M nohlt loglevel=8 user_debug=31 parts=0x400000@0x0(boot)0,0x200000@0x400000(env)0,0x200000@0x600000(arm2)0,0x400000@0x800000(logo)0,0x400000@0xc00000(kernel)0,0x200000@0x1000000(rootfs)0,300M@0x1200000(system)1,300M@0x13E00000(data)1,100M@0x26A00000(cache)1,300M@0x2CE00000(swap)0,0x400000@0x3FA00000(recovery)0,0x200000@0x3FE00000(misc)0,0x3200000@0x40000000(backup)0,0x400000@0x43200000(metazone)0,0x400000@0x43600000(dvp)0,300M@0x43a00000(data4write)1,-(usrdata)1";
		********/
	};

	/* Do not put any bus before atc-msdc, because it should be atc-msdc.0 for partition device node usage */
	/*workaround for .0*/
  atc-msdc.0 {
        compatible = "simple-bus";
        #address-cells = <1>;
        #size-cells = <1>;
        ranges = <0 0 0xffffffff>;

        MSDC1@0xF0021000 {
            compatible = "autochips,MSDC1";
            reg = <0xF0021000 0x108>;  /* MSDC1_BASE */
            interrupts = <0 156 0x4>;
            clocks = <&topselect TOP_MUX_CLK_SD11>,
            		<&topselect TOP_MUX_CLK_SD10>,
            		<&audioperisys AUDIO_PERI_CLK_MSDC_PD1>;
			clock-names="MSDC1-CLKSRC",
						"MSDC1-HCLK",
						"MSDC1-CLKGATE";
#ifdef CONFIG_ATC_WIFI_CHIP_AIC8800_SDIO
            clk_src = /bits/ 8 <MSDC_CLKSRC_108MHZ>;
#else
            clk_src = /bits/ 8 <MSDC_CLKSRC_200MHZ>;
#endif
            cd_method = /bits/ 8 <MSDC_CD_METHOD_INTERRUPT>;
            tuning_method = /bits/ 8 <TUNE_EACH_DAT_LINE>;
            slew_rate			= /bits/ 8 <0x0>;
            clk_resistor	= /bits/ 8 <MSDC_RESISTOR_50K>;
            cmd_resistor	= /bits/ 8 <MSDC_RESISTOR_10K>;
            dat_resistor	= /bits/ 8 <MSDC_RESISTOR_10K>;
            bus-width = <4>;
#ifdef CONFIG_ATC_WIFI_CHIP_AIC8800_SDIO
            max-frequency = <50000000>;
#else
            max-frequency = <200000000>;
#endif
            msdc-sys-suspend;
            cap-sd-highspeed;
            sd-uhs-sdr50;
            sd-uhs-sdr104;
            read_pre_setting_en				= <0>;
            read_dat_latch_ck_sel			= <0>;
            read_ckgen_delay_sel			= <12>;
            read_sample_edge				= <1>;
            read_pad_delay					= <12>;
            ddr_read_dat_latch_ck_sel		= <5>;
            ddr_read_ckgen_delay_sel		= <15>;
            read_patch_bit1_wrdat_crcs		= <1>;
            read_patch_bit1_cmdrsp_ta		= <1>;
            read_rxdly0						= <0>;
            read_rxdly1						= <0>;
            write_pre_setting_en			= <0>;
            write_dat_latch_ck_sel			= <0>;
            write_ckgen_delay_sel			= <12>;
            write_sample_edge				= <1>;
            write_pad_delay					= <12>;
            write_internal_delay			= <12>;
            ddr_write_dat_latch_ck_sel		= <5>;
            ddr_write_ckgen_delay_sel		= <15>;
            write_patch_bit1_wrdat_crcs		= <1>;
            write_patch_bit1_cmdrsp_ta		= <1>;
            write_rxdly0					= <0>;
            cmdrtactr_sdr104                = <4>;
            wdatcrctactr_sdr104				= <3>;
            intdatlatcksel_sdr104			= <1>;
            cd_gpio							= <71>;
            flags 							= <SD_SDIO_30_FLAGS>;
#ifdef CONFIG_ATC_WIFI_CHIP_AIC8800_SDIO
            clk_max							= <50>;
#else
            clk_max							= <200>;
#endif
            pinctl = <&mmc1_pins_default>;
            pinctl_sdr104 = <&mmc1_pins_sdr104>;
            pinctl_sdr50 = <&mmc1_pins_sdr50>;
            pinctl_ddr50 = <&mmc1_pins_ddr50>;
            register_setting = <&mmc1_register_setting_default>;
            host_function = /bits/ 8 <MSDC_SDIO>;
            cd_level = /bits/ 8 <MSDC_CD_LOW>;
            msdc1sw-gpios = <&gpio PIN_115_SD_V33_18_SW1 GPIO_ACTIVE_HIGH>;
            msdc1cd-gpios = <&gpio PIN_71_GPIO71 GPIO_ACTIVE_HIGH>;
        };

        MSDC2@0xF000A000 {
            compatible = "autochips,MSDC2";
            reg = <0xF000A000 0x108>;  /* MSDC2_BASE   */
            interrupts = <0 157 0x4>;
            clocks = <&topselect TOP_MUX_CLK_SD21>,
           			 <&topselect TOP_MUX_CLK_SD20>,
           			 <&audioperisys AUDIO_PERI_CLK_MSDC_PD2>;
			clock-names="MSDC2-CLKSRC",
						"MSDC2-HCLK",
						"MSDC2-CLKGATE";
            clk_src = /bits/ 8 <MSDC_CLKSRC_108MHZ>;
            cd_method = /bits/ 8 <MSDC_CD_METHOD_INTERRUPT>;
            tuning_method = /bits/ 8 <TUNE_EACH_DAT_LINE>;
            slew_rate			= /bits/ 8 <0x0>;
            clk_resistor	= /bits/ 8 <MSDC_RESISTOR_50K>;
            cmd_resistor	= /bits/ 8 <MSDC_RESISTOR_50K>;
            dat_resistor	= /bits/ 8 <MSDC_RESISTOR_50K>;
            bus-width = <4>;
            max-frequency = <200000000>;
            msdc-sys-suspend;
            cap-sd-highspeed;
            read_pre_setting_en				= <1>;
            read_dat_latch_ck_sel			= <0>;
            read_ckgen_delay_sel			= <12>;
            read_sample_edge				= <1>;
            read_pad_delay					= <12>;
            ddr_read_dat_latch_ck_sel		= <5>;
            ddr_read_ckgen_delay_sel		= <15>;
            read_patch_bit1_wrdat_crcs		= <1>;
            read_patch_bit1_cmdrsp_ta		= <1>;
            read_rxdly0						= <0>;
            read_rxdly1						= <0>;
            write_pre_setting_en			= <1>;
            write_dat_latch_ck_sel			= <0>;
            write_ckgen_delay_sel			= <12>;
            write_sample_edge				= <1>;
            write_pad_delay					= <12>;
            write_internal_delay			= <12>;
            ddr_write_dat_latch_ck_sel		= <5>;
            ddr_write_ckgen_delay_sel		= <15>;
            write_patch_bit1_wrdat_crcs		= <1>;
            write_patch_bit1_cmdrsp_ta		= <1>;
            write_rxdly0					= <0>;
            flags							= <MSDC_REMOVABLE>;
            cd_gpio							= <72>;
            clk_max							= <54>;
            pinctl = <&mmc2_pins_default>;
            pinctl_sdr104 = <&mmc2_pins_sdr104>;
            pinctl_sdr50 = <&mmc2_pins_sdr50>;
            pinctl_ddr50 = <&mmc2_pins_ddr50>;
            register_setting = <&mmc2_register_setting_default>;
            host_function = /bits/ 8 <MSDC_SD>;
            cd_level = /bits/ 8 <MSDC_CD_LOW>;
            msdc2sw-gpios = <&gpio PIN_116_SD_V33_18_SW2 GPIO_ACTIVE_HIGH>;
            msdc2cd-gpios = <&gpio PIN_72_GPIO72 GPIO_ACTIVE_HIGH>;
        };
  };

	/* 0x1A300000 0x25D00000 */
	memory {
		//reg = <0x00000000 0xFF00000
		//	0x1A900000 0x5700000>;
		reg = <0x0 0x10000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		boot_reserved: bootcode@0 {
			no-map;
			reg = <0x0 0x10000>;
		};

		lask_kmsg_reserved: last_kmsg@0x10000{
			no-map;
			reg = <0x10000 0x40000>;
		};

		metazone_reserved: metazone@0x50000{
			compatible = "atc-metazone-mem";
			no-map;
			reg = <0x50000 0x80000>;
		};

		trustzone_share_reserved: trustzoneshare@0xd0000{
			no-map;
			reg = <0xd0000 0x1000>;
		};

		trustzone_reserved: trustzone@0x100000 {
			no-map;
			reg = <0x00100000 0x00100000>;
		};

		framebuffer_reserved: framebuffer@200000 {
			compatible = "atc-framebuffer";
			no-map;
			reg = <0x200000 0x800000>;
		};

		wch_reserved: wch_rsv@0xa00000 {
			compatible = "atc-wch";
			no-map;
			reg = <0xa00000 0x400000>;
		};

		/*reserve 4kto pass static reserve memory to arm2/trustzone
		* do not modify the location,it is match with the MACRO  STATIC_RSV_MEM_INFO_START_ADDR in uboot*/
		args_reserved: args_rsv@0xf00000{
			no-map;
			reg = <0xf00000 0x1000>;
			//only used by arm2/trustzone/
		};

		/*static reserved memory, from 256M*/
		dvp_reserved: dvp@7200000{
			compatible = "atc-dvp";
			no-map;
			reg = <0x7200000 0xb00000>;
		};

		audio_r1: dsp@7d00000{
			compatible = "atc-audio-dsp";
			no-map;
			reg = <0x7d00000 0x580000>;
		};

		imageresize_reserved: imageresize@8280000 {
			compatible = "atc-imageresize";
			no-map;
			reg = <0x8280000 0xa10000>;
		};

		arm2_reserved: arm2@8c90000 {
			compatible = "atc-arm2-reserved";
			reg = <0x8c90000 0x350000>;
		};

		animation_reserved: animation@8fe0000 {
			compatible = "atc-animation-reserved";
			reg = <0x8fe0000 0xf00000>;
		};

		arm2_backcar_ui_reserved: arm2_backcar_ui@0x9ee0000 {
			compatible = "atc-arm2-backcar-ui";
			reg = <0x9ee0000 0x280000>;
		};

		dal_reserved: dal@0xa160000 {
			compatible = "atc-dal";
			no-map;
			reg = <0xa160000 0x130000>;
		};

		/*below is dynamic alloc reserved memory*/

		/*ext_display_fb_reserved: extdisfb{
			compatible = "atc-extdisfb";
			no-map;
			size = <0x00800000>;
			alignment = <0x1000>;
		};*/

		mm_reserved: multimedia {
			compatible = "atc-multimedia";
			no-map;
			size = <0x02A00000>;
			alignment = <0x1000>;
		};

		audio_r2: afifo{
			compatible = "atc-audio-fifo";
			no-map;
			size  = <0x116000>;
			alignment = <0x100000>;
		};
		/*added by mtk68119*/
              imglinebuf_reserved: imgresz{
			compatible = "atc-image-linebuf";
			no-map;
			size  = <0x6000>;
			alignment = <0x10>;
		};
	};


	intc: interrupt-controller {
		compatible = "arm,cortex-a15-gic";
		reg = <0xf1001000 0x1000
		       0xf1002000 0x1000>;
		interrupt-controller;
		#interrupt-cells = <3>;
	};

	timer@f0008148 {
		compatible = "Autochips,ac83xx-timer";
		reg = <0xf0008148 0x20>;
		interrupts = <0 57 4>,
			     <0 58 4>,
			     <0 59 4>;

	 };

	 serial@f000c000 {
	   compatible = "Autochips,ac83xx-serial";
	   reg = <0xf000c000 0x1000>;
	   clocks = <&topselect TOP_MUX_CLK_RFI>,<&topselect TOP_MUX_CLK_RFI1>,<&topselect TOP_MUX_CLK_RFI2>,
	   			<&topselect TOP_MUX_CLK_RFI3>,<&topselect TOP_MUX_CLK_RFI4>,<&topselect TOP_MUX_CLK_RFI5>,
	   			<&topselect TOP_MUX_CLK_RFI6>;
	   clock-names = "uart0","uart1","uart2","uart3","uart4","uart5","uart6";
	   interrupts = <0 46 4>;
	 };

	 extint@f0008740 {
	   compatible = "Autochips,ac83xx-extint";
	   reg = <0xf0008740 0x10>;
	   interrupts = <0 35 4>;
	 };


    kpd: keypad@f00a9000 {
        compatible = "Autochips,ac83xx-keypad";
        reg = <0xf00A9000 0x200>;
        interrupts = <0 139 4>;
        kp1-gpios = <&gpio 12 1>;
		kp2-gpios = <&gpio 13 1>;
    };
    spi0:spi0@f0023400 {
        compatible = "Autochips,ac83xx-spi0";
        reg = <0xf0023400 0x24>;
        clocks = <&topselect TOP_MUX_CLK_SPI_MOTO>,<&audioperisys AUDIO_PERI_CLK_SPI_MOTO1>;
		clock-names = "spi-mux","spi-select1";

        spi01-gpios = <&gpio PIN_119_SP0_CLK GPIO_ACTIVE_HIGH>;
        spi02-gpios = <&gpio PIN_120_SP0_CS GPIO_ACTIVE_HIGH>;
        spi03-gpios = <&gpio PIN_121_SP0_SI GPIO_ACTIVE_HIGH>;
        spi04-gpios = <&gpio PIN_122_SP0_SO GPIO_ACTIVE_HIGH>;
    };

    spi1:spi1@f0023800 {
        compatible = "Autochips,ac83xx-spi1";
        reg = <0xf0023800 0x24>;
        clocks = <&topselect TOP_MUX_CLK_SPI_MOTO>,<&audioperisys AUDIO_PERI_CLK_SPI_MOTO2>;
		clock-names = "spi-mux","spi-select2";

        spi11-gpios = <&gpio PIN_123_SP1_CLK GPIO_ACTIVE_HIGH>;
        spi12-gpios = <&gpio PIN_126_SP1_CS GPIO_ACTIVE_HIGH>;
        spi13-gpios = <&gpio PIN_127_SP1_SI GPIO_ACTIVE_HIGH>;
        spi14-gpios = <&gpio PIN_128_SP1_SO GPIO_ACTIVE_HIGH>;
    };

    syscfg_pctl_a: syscfg_pctl_a@0xf0000000 {
			compatible = "autocips,ac83xx-pctl-a-syscfg", "syscon";
			reg = <0 0xf0000000 0 0x1000>;
		};


     pio: pinctrl@0xf0000000 {
		  	compatible = "autochips,ac83xx-pinctrl";
		   	reg = <0 0xf0000000 0 0x1000>;
		    	mediatek,pctl-regmap = <&syscfg_pctl_a>;
		    	pins-are-numbered;
		    	gpio-controller;

		};


	clocks {
		clk_null: clk_null {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <0>;
		};

		clk27m: clk27m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <27000000>;
		};

		clk32k: clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32000>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		apmixedsys: apmixedsys@0xf0000000 {
			compatible = "atc,ac8317-apmixedsys";
			reg = <0xf0000000 0x200>;
			#clock-cells = <1>;
		};

		topckgen: topckgen@0xf0000000 {
			compatible = "atc,ac8317-topckgen";
			reg = <0xf0000000 0x200>;
			#clock-cells = <1>;
		};

		subdivider: subdivider@0xf0000000 {
			compatible = "atc,ac8317-divider";
			reg = <0xf0000000 0x200>;
			#clock-cells = <1>;
		};

		topselect: topselect@0xf0000000 {
			compatible = "atc,ac8317-topselect";
			reg = <0xf0000000 0x200>;
			#clock-cells = <1>;
		};

		vdecsys: vdecsys@0xf0000000 {
			compatible = "atc,ac8317-vdecsys";
			reg = <0xf0000000 0x300>;
			#clock-cells = <1>;
		};

		imgdramcsys: imgdramcsys@0xf0000000 {
			compatible = "atc,ac8317-imgdramcsys";
			reg = <0xf0000000 0x300>;
			#clock-cells = <1>;
		};

		audioperisys: audioperisys@0xf0000000 {
			compatible = "atc,ac8317-audioperisys";
			reg = <0xf0000000 0x300>;
			#clock-cells = <1>;
		};

		dvdsys: dvdsys@0xf0000000 {
			compatible = "atc,ac8317-dvdsys";
			reg = <0xf0000000 0x300>;
			#clock-cells = <1>;
		};

		lvdssys: lvdssys@0xf0000000 {
			compatible = "atc,ac8317-lvdssys";
			reg = <0xf0000000 0x300>;
			#clock-cells = <1>;
		};

		vdoutsys: vdoutsys@0xf0000000 {
			compatible = "atc,ac8317-vdoutsys";
			reg = <0xf0000000 0x300>;
			#clock-cells = <1>;
		};

		rtc@0xf0051000 {
			compatible = "atc,rtc";
			reg = <0xf0051000 0x80>;
			interrupts = <0 142 4>;
			clocks = <&subdivider TOP_RISCCLK_RATIO>;
			clock-names = "rtc-device";
		};

		metazone: metazone {
			compatible = "atc,metazone";
			memory-region = <&metazone_reserved>;
		};

		usb0@0xf000e000 {
			compatible = "autochip,USB0";
			cell-index = <0>;
			reg = <0xf000e000 0x1000>,<0xf000f000 0x1000>;
			interrupts = <0 54 0x4>;
			multipoint = <1>;
			dyn_fifo = <1>;
			dma = <1>;
			num_eps = <6>;
			dma_channels = <2>;
		};
		usbphy0: usbphy@0 {
			compatible = "usb-nop-xceiv";
		};

		usb1@0xf003c000 {
			compatible = "autochip,USB1";
			cell-index = <0>;
			reg = <0xf003c000 0x1000>,<0xf000f000 0x1000>;
			interrupts = <0 117 0x4>;
			multipoint = <1>;
			dyn_fifo = <1>;
			dma = <1>;
			num_eps = <8>;
			dma_channels = <4>;
		};

                nandflash@f001E400 {
                         compatible = "Autochips,ac83xx-nandflash";
                         reg = <0xf001E400  0x204
                         0xf001EC00  0x148>;
                         interrupts = <0 33 4>;
                         clocks = <&topselect TOP_MUX_CLK_NFLASH> , <&imgdramcsys IMG_DRAMC_CLK_NFI> ;
                         clock-names = "nandflash-device" , "nandflash-clk-onoff";

			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x0 0x400000>;
				read-only;
			};

			partition@400000 {
				label = "env";
				reg = <0x400000 0x200000>;
				read-only;
			};

			partition@600000 {
				label = "arm2";
				reg = <0x600000 0x200000>;
			};

			partition@800000 {
				label = "logo";
				reg = <0x800000 0x400000>;
			};


			partition@C00000 {
				label = "kernel";
				reg = <0xC00000 0x600000>;
			};

			partition@1200000 {
				label = "rootfs";
				reg = <0x1200000 0x600000>;
			};

			partition@1900000 {
				label = "system";
				reg = <0x1800000 0x1F400000>;
			};
                };

		dmx: demuxer@0xf0012000 {
		  compatible = "atc,demuxer";
		  reg = <0xf0012000 0x1000
		  			 0xf0013000 0x1000
		  			 0xf0014000 0x4000
		  			 0xf0018000 0x1000
		  			 0xf0019000 0x1000>;
		  interrupts = <0 82 4
		                0 80 4>;
		  clocks = <&topselect TOP_MUX_CLK_DEMUX>,
					  	<&topselect TOP_MUX_CLK_TS0>,
					  	<&topselect TOP_MUX_CLK_TS1>,
					  	<&imgdramcsys IMG_DRAMC_CLK_DEMUX>,
					  	<&imgdramcsys IMG_DRAMC_CLK_DEMUX_TS0>,
					  	<&imgdramcsys IMG_DRAMC_CLK_DEMUX_TS1>,
					  	<&imgdramcsys IMG_DRAMC_CLK_DEMUX_27M>;
		  clock-names = "demuxer-topselclk",
		  							"demuxer-ts0selclk",
		  							"demuxer-ts1selclk",
		  							"demuxer-clk",
		  							"demuxer-ts0-clk",
		  							"demuxer-ts1-clk",
		  							"demuxer-27m-clk";
		};

		aud: adec@0xf00A8000 {
		  compatible = "atc,adec";
		  memory-region = <&audio_r2>;
		  reg = <0xf00A8000 0x1000>;

		  interrupts = <0 82 4
		                0 80 4>;

		  clocks = <&topselect TOP_MUX_CLK_DEMUX>,
					  	<&topselect TOP_MUX_CLK_TS0>,
					  	<&topselect TOP_MUX_CLK_TS1>,
					  	<&imgdramcsys IMG_DRAMC_CLK_DEMUX>,
					  	<&imgdramcsys IMG_DRAMC_CLK_DEMUX_TS0>,
					  	<&imgdramcsys IMG_DRAMC_CLK_DEMUX_TS1>,
					  	<&imgdramcsys IMG_DRAMC_CLK_DEMUX_27M>;
		  clock-names = "adec-topselclk",
		  							"adec-ts0selclk",
		  							"adec-ts1selclk",
		  							"adec-clk",
		  							"adec-ts0-clk",
		  							"adec-ts1-clk",
		  							"adecr-27m-clk";
		};

		vdec@0xf0027000 {
		  compatible = "atc,vdec";
		  reg = <0xf0027000 0x9000>;
		  interrupts = <0 123 4>;
		  clocks = <&topselect TOP_MUX_CLK_VDEC>,
		           <&vdecsys VDEC_FULL_CLK>;
		  clock-names = "vdec-topselclk",
		                "vdec-fullclk";
		};

		mmisc: mmisc {
			compatible = "atc,mmisc";
			memory-region = <&mm_reserved>;
		};

		stc@0xf003B000 {
		  compatible = "atc,stc";
		  reg = <0xf003B000 0x1000>;
		};

		bkl: bkl {
			compatible = "Autochips,backlight";
			backlight-gpios = <&gpio PIN_124_GPIO124 GPIO_ACTIVE_HIGH>;
		};

		pwm: pwm@0xf0032200  {
			compatible = "Autochips,pwm";
	    reg = <0xf0032200 0x20>;
			clocks = <&topselect TOP_MUX_CLK_PWM0>,<&topselect TOP_MUX_CLK_PWM1>,
                              <&topselect TOP_MUX_CLK_PWM2>,<&topselect TOP_MUX_CLK_PWM3>,
                              <&audioperisys AUDIO_PERI_CLK_PWMX6_0>,<&audioperisys AUDIO_PERI_CLK_PWMX6_1>,
			      <&audioperisys AUDIO_PERI_CLK_PWMX6_2>,<&audioperisys AUDIO_PERI_CLK_PWMX6_3>;
			clock-names = "mux-pwm0","mux-pwm1","mux-pwm2","mux-pwm3",
                                    "pwm0-select","pwm1-select","pwm2-select","pwm3-select";
		};


		vcp@0xf0042600 {
			compatible = "Autochips,colorprocess";
			reg = <0xf0042600 0x6C>;
			clocks = <&vdoutsys VDOUT_CLK_LCPROC_VDO>;
			clock-names = "vcp-device";
		};

		wch: wch@0xf0042300 {
			compatible = "Autochips,writechannel";
			memory-region = <&wch_reserved>;
			reg = <0xf0042300 0x60
		       	   0xf0042500 0x60>;
			interrupts = <0 83 4>,
						 <0 87 4>;
			clocks = <&vdoutsys VDOUT_CLK_WRITE_CHANEL>,
					 <&vdoutsys VDOUT_CLK_WRITE_CHANEL2>;
			clock-names = "wch0-device","wch1-device";
		};

		imgresz@0xf0004400 {
			compatible = "Autochips,ac83xx-imgresz";
			memory-region = <&imglinebuf_reserved>;
			reg = <0xf0004400 0x200
		       	   0xf0004600 0x200>;
			interrupts = <0 75 4>,
						 <0 74 4>;
			clocks = <&imgdramcsys IMG_DRAMC_CLK_IMG_RESZ>,
					 <&imgdramcsys IMG_DRAMC_CLK_OSD_RESZ>,
					 <&topselect TOP_MUX_CLK_RESZ>;
			clock-names = "imgr0-device","imgr1-device","imgr-clkselect";
		};


		fb: fb@0xf0020000 {
			compatible = "Autochips,framebuffer";
			memory-region = <&framebuffer_reserved>;
			reg = <0xf0020000 0xb0
		       	   0xf0020100 0xb0
		       	   0xf0020200 0xb0
		       	   0xf0020300 0xb0
		       	   0xf0020a00 0xb0
		       	   0xf0020b00 0xb0
		       	   0xf00a3000 0xb0
		       	   0xf00a3100 0xb0
		       	   0xf00a3200 0xb0
		       	   0xf00a3300 0xb0
		       	   0xf0042000 0x100
		       	   0xf0042100 0x100
		       	   0xf0043000 0x100
		       	   0xf0043100 0x100
		       	   0xf00a4500 0x100
		       	   0xf00a4600 0x100
		       	   0xf001f000 0x84
		       	   0xf00a4400 0x100
		       	   0xf00a4700 0x100
		       	   0xf00a4800 0x100
		       	   0xf0052c00 0x50
		       	   0xf00a5000 0x94
		       	   0xf00a6000 0x40
		       	   0xf0002000 0x80
		       	   0xf0002100 0x20
		       	   0xf0002180 0x20>;
			interrupts = <0 63 4>,
						 <0 49 4>,
						 <0 77 4>;
			clocks = <&vdoutsys IMG_DRAMC_CLK_IMG_RESZ>,
					 <&vdoutsys IMG_DRAMC_CLK_OSD_RESZ>,
					 <&vdoutsys LVDS_CLK_LVDS>,
					 <&vdoutsys VDOUT_CLK_SCLER>,
					 <&vdoutsys VDOUT_CLK_OSD>,
					 <&vdoutsys VDOUT_CLK_OSD_R>,
					 <&vdoutsys VDOUT_CLK_FPD>,
					 <&vdoutsys VDOUT_CLK_FMT_VDO_F>,
					 <&vdoutsys VDOUT_CLK_FMT_VDO_R>,
					 <&vdoutsys VDOUT_CLK_TVE>,
					 <&vdoutsys VDOUT_CLK_DVD_MIX_2AP>,
					 <&vdoutsys VDOUT_CLK_OSD1>,
					 <&vdoutsys VDOUT_CLK_OSD2>,
					 <&vdoutsys VDOUT_CLK_OSD3>,
					 <&vdoutsys VDOUT_CLK_OSD4>,
					 <&vdoutsys VDOUT_CLK_OSD_R_2>,
					 <&vdoutsys VDOUT_CLK_OSD_R_3>,
					 <&vdoutsys VDOUT_CLK_SCLER_TG>;
			clock-names = "imgrsz-clk",
			            "osdrsz-clk",
			            "lvds-clk",
			            "scl-clk",
			            "osdf-clk",
			            "osdr-clk",
			            "fpd-clk",
			            "fmtf-clk",
			            "fmtr-clk",
			            "tve-clk",
			            "dvd2ap-clk",
			            "osd1-clk",
			            "osd2-clk",
			            "osd3-clk",
			            "osd4-clk",
			            "osdr2-clk",
			            "osdr3-clk",
			            "scl-tg-clk";
		};

		/*fb1 {
			compatible = "Autochips,extframebuffer";
			memory-region = <&ext_display_fb_reserved>;
		};*/
		vout {
			compatible = "Autochips,vout";
			memory-region = <&imageresize_reserved>;
		};

		mhl: mhl@0xf0022900 {
			compatible = "atc,mhl";
			reg = <0xf0022900 0x8c
			       0xf0022c00 0x2f0>;
			interrupts = <0 73 4>,
			             <0 62 4>;
			hdmi_hpd-gpios = <&gpio PIN_40_HDMI_HPD_RX GPIO_ACTIVE_HIGH>;
			mhl_sense-gpios = <&gpio PIN_79_MHL_SENSE GPIO_ACTIVE_HIGH>;
			clocks = <&vdoutsys VDOUT_CLK_HDMI>;
			clock-names = "mhl-device";
			#clock-cells = <1>;
		};

		ybr@0xf0022000 {
			compatible = "atc,ybr";
			reg = <0xf0022000 0x400>;
			interrupts = <0 61 4>;
			clocks = <&vdoutsys VDOUT_CLK_YPBPR>;
			clock-names = "ybr-device";
			#clock-cells = <1>;
		};

		tvd@0xf00a7000 {
		  compatible = "atc,tvd";
		  reg = <0xf00a7000 0x7F0>;
		  interrupts = <0 38 4>;
		  clocks = <&vdoutsys VDOUT_CLK_TVD1>,
		           <&vdoutsys VDOUT_CLK_TVD2>;
		  clock-names = "tvd-clock1", "tvd-clock2";
		};
		png@0xf0004e00 {
            compatible = "atc,ac83xx-pngdecoder";
            reg = <0xf0004e00 0xfc>,
                  <0xf0004f00 0x74>;
            interrupts = <0 103 4>,
                         <0 104 4>,
                         <0 126 4>;
            clocks = <&imgdramcsys IMG_DRAMC_CLK_PNG>,
                     <&topselect TOP_MUX_CLK_PNG>;
            clock-names = "png-device", "png1-device";
        };

        gif@0xf0004c00 {
            compatible = "atc,ac83xx-gifdecoder";
            reg = <0xf0004c00 0xbc>;
            interrupts = <0 105 4>,
                         <0 106 4>,
                         <0 127 4>;
            clocks = <&imgdramcsys IMG_DRAMC_CLK_GIF>;
            clock-names = "gif-device";
        };
        gfx@0xf0004000 {
			compatible = "Autochips,ac83xx-gfx";
			reg = <0xf0004000 0x200>;
			interrupts = <0 39 4>;
			clocks = <&imgdramcsys IMG_DRAMC_CLK_GFX>,
			<&topselect TOP_MUX_CLK_GRAPH>;
			clock-names = "gfx-device","gfx-select";
		};

        i2c0:i2c0@f003000 {
			compatible = "autochips,i2c0";

			i2c01-gpios = <&gpio PIN_112_SCL0 GPIO_ACTIVE_HIGH>;
            i2c02-gpios = <&gpio PIN_117_SDA0 GPIO_ACTIVE_HIGH>;
			clocks = <&topselect TOP_MUX_CLK_SIFM0>,<&audioperisys AUDIO_PERI_CLK_SIFM0>;
			clock-names = "i2c-mux0","i2c-select0";

			gt9xx:gt9xx@5d {
					compatible = "goodix,gt9xx";
			        reg = <0x5d>;
                    goodix,panel-coords = <0 0 600 1024>;
                    goodix,display-coords = <0 0 1024 600>;
                    goodix,no-force-update;
                    goodix,enable-power-off;
                    goodix,product-id = "911";
                    goodix,fw_name = "_goodix_update_.bin";
                    interrupts = <0 42 4>;
			              touchscreen-size-x = <4096>;
			              touchscreen-size-y = <4096>;
			              gtreset-gpios = <&gpio PIN_55_GPIO55 GPIO_ACTIVE_HIGH>;
			              gtexinit-gpios = <&gpio PIN_37_EINT2 GPIO_ACTIVE_HIGH>;

			};

		};

		i2c1:i2c1@f003000 {
			compatible = "autochips,i2c1";

            i2c11-gpios = <&gpio PIN_113_SCL1 GPIO_ACTIVE_HIGH>;
            i2c12-gpios = <&gpio PIN_118_SDA1 GPIO_ACTIVE_HIGH>;
            clocks = <&topselect TOP_MUX_CLK_SIFM1>,<&audioperisys AUDIO_PERI_CLK_SIFM1>;
			clock-names = "i2c-mux1","i2c-select1";
		};


		gpio: gpio@f0000000 {
				compatible = "Autochips,ac83xx-gpio";
				reg = <0xf0000000 0x1000>;
				ngpios = <202>;
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;

			};

		jdec@0xf003e000 {
			compatible = "Autochips,ac83xx-jdec";
			reg = <0xf003e000 0x3f8>;
			interrupts = <0 40 4>;
			clocks = <&imgdramcsys IMG_DRAMC_CLK_JPGDEC>, <&topselect TOP_MUX_CLK_JPEG>;
			clock-names = "jdec-clk1", "jdec-clk2";
		};
		gps {
		  	compatible = "Autochips,ac83xx-gps";
			reset-gpios = <&gpio PIN_31_GPIO31 GPIO_ACTIVE_HIGH>;
		};
#ifdef CONFIG_ATC_WIFI_CHIP_MT6630_SDIO
		CNNdynamic {
			compatible = "Autochips,ac83xx-CNNdynamic";
			pwn-gpios = <&gpio PIN_43_GPIO43 GPIO_ACTIVE_HIGH>;
			rst-gpios = <&gpio PIN_44_GPIO44 GPIO_ACTIVE_HIGH>;
			status = "okay";
		};
#endif
#ifdef CONFIG_ATC_WIFI_CHIP_CYPRESS_SDIO
		ExtBluetooth:ExtBluetooth {
			compatible = "Autochips,ac8x-ExtBluetooth";
			extbt-gpios = <&gpio PIN_44_GPIO44 GPIO_ACTIVE_HIGH>;
			status = "okay";
		};
#endif
		atc_combo {
			compatible = "autochips,atc_combo";
			status = "okay";
#ifdef CONFIG_ATC_WIFI_CHIP_SELF_ADAPTIVE
			mt6630_pwn-gpios = <&gpio PIN_43_GPIO43 GPIO_ACTIVE_HIGH>;
			mt6630_rst-gpios = <&gpio PIN_44_GPIO44 GPIO_ACTIVE_HIGH>;
#endif
#ifdef CONFIG_ATC_WIFI_CHIP_AIC8800_SDIO
			bt_enable-gpios = <&gpio PIN_44_GPIO44 GPIO_ACTIVE_HIGH>;
			bt_enable_delay_us = <20000>;     // >= 8ms
#endif
#if defined(CONFIG_ATC_WIFI_CHIP_SELF_ADAPTIVE) \
	|| !defined(CONFIG_ATC_WIFI_CHIP_MT6630_SDIO)
			wlan_enable-gpios = <&gpio PIN_43_GPIO43 GPIO_ACTIVE_HIGH>;
			wlan_enable_delay_us = <20000>;   // >= 8ms
#endif
		};
	};
};

