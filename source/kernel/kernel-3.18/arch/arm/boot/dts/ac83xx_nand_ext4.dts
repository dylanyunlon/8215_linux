&pwm {
      pinctrl-names = "backlight_gpio125_pwm3",
      								"backlight_gpio125_gpio",
                      "backlight_gpio150_pwm1",
                      "backlight_gpio150_gpio";
      pinctrl-0 = <&backlight_gpio125_pwm3_cfg>;
      pinctrl-1 = <&backlight_gpio125_gpio_cfg>;
      pinctrl-2 = <&backlight_gpio150_pwm1_cfg>;
      pinctrl-3 = <&backlight_gpio150_gpio_cfg>;
      status = "okay";
    };
    &pio{
        kp_state_default:kpdefault1{
    				    pins_cmd_data{
    				        pins=<PIN_42_GPIO42__TS_SEL0>;
                            bias-pull-up = <PULLUP>;
                            drive-strength = <CURRENT_6MA>;
