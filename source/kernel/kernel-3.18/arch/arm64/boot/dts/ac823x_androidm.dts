    	pinctrl-names="gt9xx_default",
    	    "gt9xx_exint";
    	pinctrl-0=<&gt9xx_state_default>;
    	pinctrl-1=<&gt9xx_state_st1>;
    	status = "okay";
};







/******************************************************************/
/***************    MSDC Setting Define   *************************/
/******************************************************************/
&pio {
	msdc1_gpio_cfg:msdc1_gpio{
		pins_cmd_dat{
			pins=<PIN_70_EINT_SEL>;
		};
	};
	msdc2_gpio_cfg:msdc2_gpio{
		pins_cmd_dat{
			pins=<PIN_71_EINT_SEL>;
		};
	};
	mmc0_pins_default: mmc0@default {
			pins_clk {
				drive-strength = /bits/ 8 <0x1d>;
				slew_rate		= /bits/ 8 <0>;
				resistor	= /bits/ 8 <MSDC_RESISTOR_10K>;
			};
			pins_cmd {
				drive-strength = /bits/ 8 <0x15>;
				slew_rate		= /bits/ 8 <0>;
				resistor	= /bits/ 8 <MSDC_RESISTOR_10K>;
			};
			pins_dat {
				drive-strength = /bits/ 8 <0x1d>;
				slew_rate		= /bits/ 8 <0>;
				resistor	= /bits/ 8 <MSDC_RESISTOR_10K>;
			};
			pins_ds {
				drive-strength = /bits/ 8 <0x1d>;
				slew_rate		= /bits/ 8 <0>;
				resistor		= /bits/ 8 <MSDC_RESISTOR_10K>;
			};            
	};

	mmc0_register_setting_default: mmc0@register_default {
					dat0rddly      = /bits/ 8 <0>;
        	dat1rddly      = /bits/ 8 <0>;
        	dat2rddly      = /bits/ 8 <0>;
       		dat3rddly      = /bits/ 8 <0>;
        	dat4rddly      = /bits/ 8 <0>;
        	dat5rddly      = /bits/ 8 <0>;
        	dat6rddly      = /bits/ 8 <0>;
        	dat7rddly      = /bits/ 8 <0>;
        	datwrddly      = /bits/ 8 <0>;
        	cmdrrddly      = /bits/ 8 <0>;
        	cmdrddly       = /bits/ 8 <0>;
        	cmd_edge 			= /bits/ 8 <MSDC_SMPL_FALLING>;
			rdata_edge 		= /bits/ 8 <MSDC_SMPL_FALLING>;
			wdata_edge 		= /bits/ 8 <MSDC_SMPL_FALLING>;
	};

	mmc1_pins_default: mmc1@default {
			pins_clk {
				drive-strength = /bits/ 8 <0x1F>;
				slew_rate			= /bits/ 8 <0x0>;
				resistor	= /bits/ 8 <MSDC_RESISTOR_10K>;
			};   
			pins_cmd {
				drive-strength = /bits/ 8 <0x15>;
				slew_rate			= /bits/ 8 <0x0>;
				resistor	= /bits/ 8 <MSDC_RESISTOR_10K>;
			};
			pins_dat {
				drive-strength = /bits/ 8 <0x15>;
				slew_rate			= /bits/ 8 <0x0>;
				resistor	= /bits/ 8 <MSDC_RESISTOR_10K>;
			};           
	};

	mmc1_register_setting_default: mmc1@register_default {
							dat0rddly      = /bits/ 8 <0>;
