/************************************************************/

&mhl {
		pinctrl-names="hdmi_hpd_default",
					  "hdmi_hpd_sel_gpio40_in",
					  "hdmi_hpd_clr_gpio40_in",
					  "mhl_sense_sel_gpio79_in",
					  "hdmi_scl_rx",
					  "hdmi_sda_rx";
		pinctrl-0=<&hdmi_hpd_state_default>;
		pinctrl-1=<&hdmi_hpd_sel_gpio>;
		pinctrl-2=<&hdmi_hpd_clr_gpio>;
		pinctrl-3=<&mhl_sense_sel_gpio>;
		pinctrl-4=<&hdmi_scl_sel_gpio>;
		pinctrl-5=<&hdmi_sda_sel_gpio>;
		status = "okay";
};

