}

INT32 GFX_HwGlobalBypassWT(BOOL fgBypass)
{
    if (fgBypass)
    {
        WT_WRITE32(0, (WT_READ32(0) | 0x00010000)); //[16] = 1;
    }
    else
    {
        WT_WRITE32(0, (WT_READ32(0) & ~0x00010000)); //[16] = 0;
    }
    return (INT32)E_GFX_OK;
}

// For 8550 Sample IC ECO
INT32 GFX_HwPreProcEn(BOOL fgEnable)
{
    if (fgEnable)
    {
        WT_WRITE32(0, (WT_READ32(0) & ~0x03000000)); //[25:24] = 00;
    }
    else
    {
        WT_WRITE32(0, (WT_READ32(0) | 0x03000000));    //[25:24] = 11;
    }
    return (INT32)E_GFX_OK;
}

void GFX_SetFifo(
    uint32_t u4GfxHwId,
    uint32_t   ui4_sdfifo,
    uint32_t   ui4_cmdfifo,
    uint32_t   ui4_postthrs)
{
    uint32_t   u4Value;

    u4Value = GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG);

    u4Value = (u4Value) & (~(GREG_MSK_SDFIFO_THRS));
    u4Value = (u4Value) | (ui4_sdfifo << GREG_SHT_SDFIFO_THRS);

    // set CMDFIFO threshold
    u4Value = (u4Value) & (~(GREG_MSK_CMDFIFO_THRS));
    u4Value = (u4Value) | (ui4_cmdfifo << GREG_SHT_CMDFIFO_THRS);

    // set POST threshold
    u4Value = (u4Value) & (~(GREG_MSK_POST_THRS));
    u4Value = (u4Value) | (ui4_postthrs << GREG_SHT_POST_THRS);
    

    GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, u4Value);
    
}
//-------------------------------------------------------------------------
/** GFX_HwGetIdle
 *  get gfx hardware idle status
 */
//-------------------------------------------------------------------------
INT32 GFX_HwGetIdle(uint32_t u4GfxHwId)
{
    volatile uint32_t u4Value;

    u4Value = GFX_READ32(u4GfxHwId, GFX_REG_G_STATUS);
    u4Value = ((u4Value & GREG_MSK_IDLE) >> GREG_SHT_IDLE);

    return (INT32)(u4Value);
}


//-------------------------------------------------------------------------
/** GFX_HwGetHwVersion
 *  get gfx hw version (control register)
 */
//-------------------------------------------------------------------------
INT32 GFX_HwGetHwVersion(uint32_t u4GfxHwId, uint32_t *pu4HwVersion)
{
    volatile uint32_t u4Value;

    if (pu4HwVersion == NULL)
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    u4Value = GFX_READ32(u4GfxHwId, GFX_REG_G_STATUS);
    u4Value = ((u4Value & GREG_MSK_VERSION_ID) >> GREG_SHT_VERSION_ID);
    
    *pu4HwVersion = u4Value;

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_HwEnableLowPowerMode
 *  enable gfx engine advanced low power mode
 *  legacy, left blanc here for future use
 */
//-------------------------------------------------------------------------
void GFX_HwEnableLowPowerMode(uint32_t u4GfxHwId)
{
    volatile uint32_t u4Value;

    u4Value = GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG);
    u4Value = (u4Value) | (GREG_MSK_ENG_LP);
    GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, u4Value);
}


//-------------------------------------------------------------------------
/** GFX_HwDisableLowPowerMode
 *  disable gfx engine advanced low power mode
 *  legacy, left blanc here for future use
 */
//-------------------------------------------------------------------------
void GFX_HwDisableLowPowerMode(uint32_t u4GfxHwId)
{
    volatile uint32_t u4Value;

    u4Value = GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG);
    u4Value = (u4Value) & (~GREG_MSK_ENG_LP);
    GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, u4Value);
}


//-------------------------------------------------------------------------
/** GFX_HwAction
 *  start gfx hardware engine
 *  used in interrupt mode only
 *  in command queue mode, use command queue action
 */
//-------------------------------------------------------------------------
INT32 GFX_HwAction(uint32_t u4GfxHwId)
{
    // busy mode
    GFX_DifSetIdle(u4GfxHwId, FALSE);
    
    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_HwWait
 *  busy wait for gfx hw complete
 */
//-------------------------------------------------------------------------
void GFX_HwWait(void )
{
  return;
}


