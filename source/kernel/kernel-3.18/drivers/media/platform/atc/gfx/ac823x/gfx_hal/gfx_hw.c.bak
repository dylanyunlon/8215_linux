 *  enter any non-zero gfx mode (start clock)
 *  enable interrupt
 *  set register to default
 */
//-------------------------------------------------------------------------
INT32 GFX_HwResetWT(uint32_t u4GfxHwId, uint32_t u4Reset)
{
    volatile uint32_t u4Value;


    UNUSED(u4Reset);
#if 0

    if (!_fgWtResetOnce)
    {
       _fgWtResetOnce = TRUE;

       u4Value =(*(volatile uint32_t *) (0x70040800)) ; 
       (*(volatile uint32_t *) (0x70040800)) = u4Value & 0x3fffffff; //[31:30] = 00
       x_thread_delay(100);

       u4Value = (*(volatile uint32_t *) (0x70040800)) ; 
       (*(volatile uint32_t *) (0x70040800)) = u4Value | 0xf0000000; //[31:30] = 11
       x_thread_delay(100);

       u4Value = (*(volatile uint32_t *) (0x70040800)) ; 

       u4Value &= 0xfffffffe;  //[0]  = 0;
       u4Value &= 0xfffeffff;  //[16] = 0;

       if (IC_8530_VER_B == BSP_GetIcVersion())
       {
           u4Value |=0x07820000;
       }

       (*(volatile uint32_t *) (0x70040800)) = u4Value;

       // Test Only: Set 40800[26] = 1
       u4Value = (*(volatile uint32_t *) (0x70040800)) ; 
       (*(volatile uint32_t *) (0x70040800)) = u4Value | 0x04000000; //[26]=1
    }
#else

    if (!_fgWtResetOnce)
    {
       _fgWtResetOnce = TRUE;

       u4Value = WT_READ32(-4); // 0xF0040800
       u4Value &= ~0x20;
       WT_WRITE32(-4, u4Value);


       u4Value =WT_READ32(0);
       WT_WRITE32(0, u4Value & 0x3fffffff); //[31:30] = 00
       x_thread_delay(100);

       u4Value = WT_READ32(0) ; 
       WT_WRITE32(0, u4Value | 0xf0000000); //[31:30] = 11
       x_thread_delay(100);

       u4Value = WT_READ32(0) ; 

       u4Value &= 0xfffffffe;  //[0]  = 0;
       u4Value &= 0xfffeffff;  //[16] = 0;
