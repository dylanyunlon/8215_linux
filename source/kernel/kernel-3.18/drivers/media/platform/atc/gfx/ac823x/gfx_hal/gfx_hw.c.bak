//-------------------------------------------------------------------------
/** GFX_HwInit
 *  init gfx hardware
 *  set control register address to default
 *  set default isr
 *  do hw reset
 */
//-------------------------------------------------------------------------
INT32 GFX_HwInit(void)
{
    INT32   i4,i4Ret = 1;
    CHAR  szEvName[16] = "GHwEv0";
    //x_os_isr_fct pfnOldIsr;
	int irq;
   
    // setup ISR
    if (_i4GfxSetupISR == GFX_DISABLE)
    {
       for (i4=0; i4 < GFX_HAL_HW_INST_NUM; i4++)
       {
          
          szEvName[5] = 0x30 + i4;
          i4Ret = x_ev_group_create(&_tGfx_Hal_Inst[i4].hEvent, szEvName, GFX_HAL_EV_INITIAL);
	      VERIFY(i4Ret == OSR_OK);
        }
       //VERIFY(x_reg_isr(7, _GfxHwRealIsr, &pfnOldIsr) == OSR_OK);
       // VERIFY(x_reg_isr((UINT16)VECTOR_SRCQ, _GfxHwPgigQueueIsr, &pfnOldIsr) == OSR_OK);
       // VERIFY(x_reg_isr((UINT16)VECTOR_PSTQ, _GfxHwPgigQueueIsr, &pfnOldIsr) == OSR_OK);
       irq = gfxirq;
	
	   request_irq(irq,GfxHwRealIsr,0,"ac83xx_gfx",NULL);
	   printk("requese irq,gfxirq is %d\n",gfxirq);
      _i4GfxSetupISR = GFX_ENABLE;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_HwUninit
 *  uninit gfx hardware
 *  set control register address to default
 *  set default isr to NULL
 *  do hw reset
 */
//-------------------------------------------------------------------------
INT32 GFX_HwUninit(void)
{
    INT32   i4,i4Ret = 1;
    x_os_isr_fct pfnOldIsr;

    // setup ISR
    if (_i4GfxSetupISR == GFX_ENABLE)
    {
		for (i4= 0; i4< GFX_HAL_HW_INST_NUM; i4++)
		{
			i4Ret = x_ev_group_delete(_tGfx_Hal_Inst[i4].hEvent);
			VERIFY(i4Ret == OSR_OK);
		}
    
        //VERIFY(x_reg_isr(7, NULL, &pfnOldIsr) == OSR_OK);
        _i4GfxSetupISR = GFX_DISABLE;
    }

    return (INT32)E_GFX_OK;
}
