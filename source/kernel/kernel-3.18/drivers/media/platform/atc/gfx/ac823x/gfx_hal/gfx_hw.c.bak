#if 0
//extern void mt3363_mask_ack_bim_irq(unsigned int irq);
//#include <mach/memory.h>
#include <asm/io.h>

#define IO_SPACE_LIMIT 0xffffffff
#define BIM_BASE_VA                    (0xFD000000 + 0x00008000)
#define PCI0_BASE           0

#define __io(a)         ((void __iomem *)(PCI0_BASE + (a)))
#define __mem_pci(a)    (a)
#define __mem_isa(a)    (a)
#define REG_IRQST           0x0030        //RISC L1 IRQ Status Register
#define REG_IRQEN           0x0034        //RISC L1 IRQ Enable Register
#define REG_IRQCL           0x0038        //RISC L1 IRQ Clear Register

#define __bim_writel(val,add)  __raw_writel(val,__io(BIM_BASE_VA+add))
#define __bim_readl(add)       __raw_readl(__io(BIM_BASE_VA+add))

void mt3363_mask_ack_bim_irq(unsigned int irq)
{
    u32 regval32;
    unsigned long flags;



    //assert(irq < NR_IRQS);

    local_irq_save(flags);

    if(irq < 32)
    {
        //set 1 to clear
        regval32 = (1 << irq);
        __bim_writel(regval32, REG_IRQCL);
        __bim_writel(regval32, REG_IRQST);
    }
    else
    {

    }

    local_irq_restore(flags);
}
#endif
extern void ac83xx_mask_ack_bim_irq(unsigned int irq);

static irqreturn_t GfxHwRealIsr(int irq, void *dev_id)
{
    uint32_t u4GfxHwId = 0;
    UNUSED(irq);  

	//pr_debug("Enter gfx isr:%d!\n",irq);
    u4GfxHwId = 0;
	// for lint happy
    if (1)//(BIM_ClearIrq(irq))
    {
    	ac83xx_mask_ack_bim_irq(irq);
        #ifdef GFX_QUE_REG
        GFX_MoniterQueueReset();
        #endif
        _fgGfxInt = TRUE;
        ++_u4GfxHwIntCount[u4GfxHwId];         // hw interrupt count
     //   GFX_SET_CUR_STATUS(u4GfxHwId, (INT32)EGFX_IDLE);

        GFX_HwISR(u4GfxHwId);

        GFX_UnlockCmdque(u4GfxHwId);         // release cmdque resource

        // use for verify code
    
        _gu4GfxCheckSum = GFX_READ32(u4GfxHwId, 0x258);

        UNUSED(_u4GfxHwIntCount[u4GfxHwId]);   // for lint happy
       // GFX_INC_DRV_INT_COUNT(u4GfxHwId);    // for debug use
    }
	return IRQ_HANDLED;
}

