//-------------------------------------------------------------------------
uint32_t _GFX_GetInterruptCount(uint32_t u4GfxHwId)
{
    return _u4GfxHwIntCount[u4GfxHwId];
}

void _GFX_DecInterruptCount(uint32_t u4GfxHwId)
{
    if (_u4GfxHwIntCount[u4GfxHwId])
        _u4GfxHwIntCount[u4GfxHwId]--;
}


