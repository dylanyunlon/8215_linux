INT32 i4GfxHwProc(uint32_t u4HwInstId)
{
    GFX_HAL_INST_T*      prGfx_HalInst = &(_tGfx_Hal_Inst[u4HwInstId]);
    INT32               i4Ret = 1;

    //clean event
    i4Ret = x_ev_group_set_event(prGfx_HalInst->hEvent, 0x00, X_EV_OP_CLEAR);
    VERIFY(i4Ret == OSR_OK);

    i4Ret = x_ev_group_set_event(prGfx_HalInst->hEvent, GFX_HAL_EV_PROC, X_EV_OP_OR);
    VERIFY(i4Ret == OSR_OK);
    return 0;
}

INT32 i4GfxHwWait(uint32_t u4HwInstId)
{
    GFX_HAL_INST_T*      prGfx_HalInst = &(_tGfx_Hal_Inst[u4HwInstId]);
    INT32               i4Ret = 1;
    EV_GRP_EVENT_T      eGfxEvent;
    EV_GRP_EVENT_T      eGfxEventGet;

    eGfxEvent = GFX_HAL_EV_DONE_IRQ; 
    i4Ret = x_ev_group_wait_event(prGfx_HalInst->hEvent, eGfxEvent, &eGfxEventGet, X_EV_OP_OR_CONSUME);
    VERIFY(i4Ret == OSR_OK);
    return 0;
}

