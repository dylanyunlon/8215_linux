//-------------------------------------------------------------------------
/** GFX_HwGetRegBase
 *  get gfx hw control register base
 */
//-------------------------------------------------------------------------
INT32 GFX_HwGetRegBase(uint32_t u4GfxHwId, uint32_t **ppu4RegBase)
{
    if ((ppu4RegBase != NULL)/* && (*ppu4RegBase != NULL)*/)
    {
        *ppu4RegBase = gfx_base;
        return (INT32)E_GFX_OK;
    }

    return -(INT32)E_GFX_INV_ARG;
}

//-------------------------------------------------------------------------
/** GFX_HwISR
 *  gfx hw isr
 *  reset crash detection vars
 *  set engine to idle
 *  notify if notification was set
 */
//-------------------------------------------------------------------------
void GFX_HwISR(uint32_t u4GfxHwId)
{
#ifdef GFX_PERFORMANCE_TEST
    if (g_fgGfxPfmTesting)
    {
        HAL_TIME_T rTmp;
      	HAL_GetTime(&g_rGfxEndTime);
		UTIL_Printf("	   g_rGfxEndTime.u4Seconds = %d, g_rGfxEndTime.u4Micros = %d\n", g_rGfxEndTime.u4Seconds, g_rGfxEndTime.u4Micros);
        HAL_GetDeltaTime(&rTmp, &g_rGfxStartTime, &g_rGfxEndTime);
        g_rGfxResultTime.u4Seconds += rTmp.u4Seconds;
        g_rGfxResultTime.u4Micros += rTmp.u4Micros;
        g_rGfxResultTime.u4Seconds += (g_rGfxResultTime.u4Micros/1000000);
        g_rGfxResultTime.u4Micros %= 1000000;
    }
#endif
      GFX_DifSetIdle(u4GfxHwId,TRUE);
	//GFX_HalSetNotify(u4GfxHwId);
}

#define REG_WT_BASE   (IO_BASE_VA +0x40804)

/// Read 32 bits data from GFX HW registers.
#define WT_READ32(offset)           IO_READ32((REG_WT_BASE), (offset))

/// Write 32 bits data into GFX HW registers.
#define WT_WRITE32(offset, value)   IO_WRITE32((REG_WT_BASE), (offset), (value))

//-------------------------------------------------------------------------
/** GFX_HwReset
 *  gfx hw reset
 *  trigger hw reset
 *  enter any non-zero gfx mode (start clock)
 *  enable interrupt
 *  set register to default
 */
//-------------------------------------------------------------------------
INT32 GFX_HwReset(uint32_t u4GfxHwId, uint32_t u4Reset)
{
	printk("enter hwreset\n");
    volatile uint32_t u4Value;
    uint32_t u4ResHi = (uint32_t)0x3;
    uint32_t u4ResLo = (uint32_t)0x0;
    #if 1//((CONFIG_DRV_VERIFY_SUPPORT) && (!GFX_PERFORMANCE_TEST_SUPPORT))
	printk("begin read32\n");
    volatile uint32_t u4i = GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG);
	printk("end read32\n");
	//UTIL_Printf("[Gfx][Ev] ->u4i:0x%8x \n",u4i);
    #endif
	printk("begin unsed\n");
    UNUSED(u4Reset);
	printk("end unsed\n");

    ///??
    // do GFX module clock selection
    /*CLKSRC_ChangeGFXClock();*/
    // reset gfx config register

	//UTIL_Printf("[Gfx][Ev] ->GFX_IO_base:0x%8x \n",IMAGE_BASE);
	printk("begin write32\n");
    GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, 0xA0000000);
	printk("end write32\n");
    //GFX_MB();
    // enable gfx engine clock (set non-zero value)
    GFX_WRITE32(u4GfxHwId, GFX_REG_G_MODE, 0xC00001F0);        // fg_OP_MODE = 0x1F;
    //GFX_MB();
    
    // reset engine and cmdque :
    // 1. set fg_G_RST to 0x3 and fg_CQ_RST to 0x3
    // 2. set fg_G_RST to 0x0 and fg_CQ_RST to 0x0
    u4Value = GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG);

    u4Value = (u4Value & (~(GREG_MSK_G_RST | GREG_MSK_CQ_RST)));
    u4Value = (u4Value) | (u4ResHi << GREG_SHT_G_RST) | (u4ResHi << GREG_SHT_CQ_RST);
    GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, u4Value);

    u4Value = (u4Value & (~(GREG_MSK_G_RST | GREG_MSK_CQ_RST)));
    u4Value = (u4Value) | (u4ResLo << GREG_SHT_G_RST) | (u4ResLo << GREG_SHT_CQ_RST);
    GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, u4Value);
	printk("11111\n");

    // wait gfx hw reset ready
    for ( ; ; )
    {
    printk("enter for\n");
        u4Value = GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG);

        if (((u4Value & GREG_MSK_G_RST)  == GFX_G_RST_READY) &&
            ((u4Value & GREG_MSK_CQ_RST) == GFX_CQ_RST_READY))
        {	
        printk("leave for\n");
            break;
        }
    }
#if 1//((CONFIG_DRV_VERIFY_SUPPORT) && (!GFX_PERFORMANCE_TEST_SUPPORT))
	printk("2222t\n");

    u4i     = u4i & (GREG_MSK_REQ_INTVAL | GREG_MSK_SDFIFO_THRS | GREG_MSK_CMDFIFO_THRS | GREG_MSK_POST_THRS | GREG_MSK_INT_MASK);
    u4Value = u4Value & (~(GREG_MSK_REQ_INTVAL | GREG_MSK_SDFIFO_THRS | GREG_MSK_CMDFIFO_THRS | GREG_MSK_POST_THRS | GREG_MSK_INT_MASK));
    u4Value = u4Value | u4i;
	//UTIL_Printf("[Gfx][Ev] ->u4Value:0x%8x \n",u4Value);
#else
    // set SDFIFO threshold
    u4Value = (u4Value) & (~(GREG_MSK_SDFIFO_THRS));
    u4Value = (u4Value) | (0x1 << GREG_SHT_SDFIFO_THRS);

    // set CMDFIFO threshold
    u4Value = (u4Value) & (~(GREG_MSK_CMDFIFO_THRS));
    u4Value = (u4Value) | (0x1 << GREG_SHT_CMDFIFO_THRS);

    // set POST threshold
    u4Value = (u4Value) & (~(GREG_MSK_POST_THRS));
    u4Value = (u4Value) | (0x3 << GREG_SHT_POST_THRS);

    // set REQ INTVAL
    u4Value = (u4Value) & (~(GREG_MSK_REQ_INTVAL));
    u4Value = (u4Value) | (0x1 << GREG_SHT_REQ_INTVAL);
#endif

	#ifdef GFXMMU
	#ifndef GFX_RISC_MODE
    u4Value = u4Value | GREG_MSK_MMU_CMQ;
	#endif
	#endif
    printk("33333\n");
    // set CMDAdv power down
    u4Value = (u4Value) & (~(GREG_MSK_ENG_LP));
    u4Value = (u4Value) | (0x1 << GREG_SHT_ENG_LP);

    u4Value = (u4Value | GREG_MSK_INT_MASK);
    
    GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, u4Value);

	//set new sw mode
	u4Value = GFX_READ32(u4GfxHwId, GFX_REG_DRAMQ_LEN);
	u4Value =  u4Value | (0x1 << GREG_SHT_SW_MODE);
	GFX_WRITE32(u4GfxHwId, GFX_REG_DRAMQ_LEN, u4Value);
	printk("44444t\n");

//Default Set WDLE
#if 1 //(((CONFIG_CHIP_VER_CURR >= CONFIG_CHIP_VER_MT8560)||(CONFIG_CHIP_VER_CURR == CONFIG_CHIP_VER_MT3363)) && CONFIG_ENABLE_IOMMU)
	u4Value = GFX_READ32(u4GfxHwId, GFX_REG_DST_RING);
	
    {
        u4Value =  u4Value | (0x1 << GREG_SHT_WDLE);
		//u4Value =  u4Value | 0x5;
    }
	GFX_WRITE32(u4GfxHwId, GFX_REG_DST_RING, u4Value);
	printk("55555\n");
	
#endif

    if(GFX_RESET_POWERDOWN==u4Reset)
    {
        GFX_WRITE32(u4GfxHwId, GFX_REG_G_MODE, 0x1f0); 
		printk("666\n");
    }
    return (INT32)E_GFX_OK;
	printk("leave hwreset\n");
}



INT32 GFX_HwEnableWT(BOOL fgEnable)
{
    if (fgEnable)
    {   // Enable WT
        WT_WRITE32(0, (WT_READ32(0) & 0xfffefffe)); //[0]  = 0; [16] = 0;
    }
    else
    {
        // Disable WT
        WT_WRITE32(0, (WT_READ32(0) | 0x00010000)); //[16] = 1
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_HwEnableWTEx(BOOL fgEnable, BOOL fgCompactMode)
{
    if (fgEnable)
    {   // Enable WT
        WT_WRITE32(0, (WT_READ32(0) & 0xfffeffff)); //[16] = 0;
    }
    else
    {
        // Disable WT
        WT_WRITE32(0, (WT_READ32(0) | 0x00010000)); //[16] = 1
    }

    if (fgCompactMode)
    {   // CompactMode Mode
        WT_WRITE32(0, (WT_READ32(0) | 0x00200000)); //[21] = 1
    }
    else
    {
        // !CompactMode Mode
        WT_WRITE32(0, (WT_READ32(0) & 0xFFDFFFFF)); //[21] = 0
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_HwSetWTMode(BOOL fg4888Mode)
{
    if (fg4888Mode)
    { //4888 mode
        WT_WRITE32(0, (WT_READ32(0) | 0x00400000)); //[22]=1     
    }
    else
    { // 8888 mode
        WT_WRITE32(0, (WT_READ32(0) & 0xffbfffff)); //[22]=0
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_HwSetWTModeEx(BOOL fg4888Mode, BOOL fgNoRnd)
{
    if (fg4888Mode)
    { //4888 mode
        WT_WRITE32(0, (WT_READ32(0) | 0x00400000)); //[22]=1     
    }
    else
    { // 8888 mode
        WT_WRITE32(0, (WT_READ32(0) & 0xffbfffff)); //[22]=0
    }

    if (fgNoRnd)
    {
        WT_WRITE32(0, (WT_READ32(0) | 0x00020000)); //17]=1
    }
    else
    {
        WT_WRITE32(0, (WT_READ32(0) & 0xfffdffff)); //[17]=0        
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_HwEnableWTQualityECO(BOOL fgEnableQualityECO)
{
    if (!fgEnableQualityECO)
    {
        // 40804:[7:6]   --> 2'b11
        // 40804:[25:24] --> 2'b11
        WT_WRITE32(0, (WT_READ32(0) | 0x030000C0));
    }
    else
    {
        WT_WRITE32(0, (WT_READ32(0) & 0xFCFFFF3F));
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_HwWTConfig(WT_CONFIG_T *prCfg)
{
    volatile uint32_t u4CurVal;
    volatile WT_CONFIG_REG_T rCurCfg;

    if (!prCfg)
    {
        return (INT32)E_GFX_OK;
    }

    u4CurVal = WT_READ32(0);
    rCurCfg = *(WT_CONFIG_REG_T *)&u4CurVal;

    if (prCfg->u4Flag & WT_CF_WEIGHT_PAD)
    {
        rCurCfg.fg_WT_WEIGHT_PAD = prCfg->rReg.fg_WT_WEIGHT_PAD;
    }
    if (prCfg->u4Flag & WT_CF_EDGE57_BYP)
    {
        rCurCfg.fg_WT_EDGE57_BYP = prCfg->rReg.fg_WT_WEIGHT_PAD;
    }
    if (prCfg->u4Flag & WT_CF_FIFO_LEVEL)
    {
        rCurCfg.fg_WT_FIFO_LEVEL = prCfg->rReg.fg_WT_FIFO_LEVEL;
    }
    if (prCfg->u4Flag & WT_CF_PQ_RGB_PROC)
    {
        rCurCfg.fg_PQ_RGB_PROC = prCfg->rReg.fg_PQ_RGB_PROC;
    }
    if (prCfg->u4Flag & WT_CF_PQ_EDGE_PROC)
    {
        rCurCfg.fg_PQ_EDGE_PROC = prCfg->rReg.fg_PQ_EDGE_PROC;
    }
    if (prCfg->u4Flag & WT_CF_CONT_BE)
    {
        rCurCfg.fg_WT_CONT_BE = prCfg->rReg.fg_WT_CONT_BE;
    }
    if (prCfg->u4Flag & WT_CF_PQ_SMART_MODE_A)
    {
        rCurCfg.fg_PQ_SMART_MODE_A = prCfg->rReg.fg_PQ_SMART_MODE_A;
    }
    if (prCfg->u4Flag & WT_CF_EDGE_THR)
    {
        rCurCfg.fg_EDGE_THR = prCfg->rReg.fg_EDGE_THR;
    }
    if (prCfg->u4Flag & WT_CF_EDGE_DIFF)
    {
        rCurCfg.fg_EDGE_DIFF = prCfg->rReg.fg_EDGE_DIFF;
    }
    if (prCfg->u4Flag & WT_CF_BYPASS)
    {
        rCurCfg.fg_WT_BYPASS = prCfg->rReg.fg_WT_BYPASS;
    }
    if (prCfg->u4Flag & WT_CF_EDGE_THR2)
    {
        rCurCfg.fg_EDGE_THR2 = prCfg->rReg.fg_EDGE_THR2;
    }
    if (prCfg->u4Flag & WT_CF_BURST)
    {
        rCurCfg.fg_WT_BURST = prCfg->rReg.fg_WT_BURST;
    }
    if (prCfg->u4Flag & WT_CF_CHKSUM_SHFT)
    {
        rCurCfg.fg_WT_CHKSUM_SHFT = prCfg->rReg.fg_WT_CHKSUM_SHFT;
    }
    if (prCfg->u4Flag & WT_CF_COMPACT)
    {
        rCurCfg.fg_WT_COMPACT = prCfg->rReg.fg_WT_COMPACT;
    }
    if (prCfg->u4Flag & WT_CF_ARGB4888)
    {
        rCurCfg.fg_WT_ARGB4888 = prCfg->rReg.fg_WT_ARGB4888;
    }
    if (prCfg->u4Flag & WT_CF_MON_SEL)
    {
        rCurCfg.fg_WT_MON_SEL = prCfg->rReg.fg_WT_MON_SEL;
    }
    if (prCfg->u4Flag & WT_CF_PQ_PRE)
    {
        rCurCfg.fg_PQ_PRE = prCfg->rReg.fg_PQ_PRE;
    }
    if (prCfg->u4Flag & WT_CF_EDGE_MEAN)
    {
        rCurCfg.fg_EDGE_MEAN = prCfg->rReg.fg_EDGE_MEAN;
    }
    if (prCfg->u4Flag & WT_CF_SE_THR)
    {
        rCurCfg.fg_SE_THR = prCfg->rReg.fg_SE_THR;
    }
    if (prCfg->u4Flag & WT_CF_SW_DRAM_RSTB)
    {
        rCurCfg.fg_WT_SW_DRAM_RSTB = prCfg->rReg.fg_WT_SW_DRAM_RSTB;
    }
    if (prCfg->u4Flag & WT_CF_SW_RSTB)
    {
        rCurCfg.fg_WT_SW_RSTB = prCfg->rReg.fg_WT_SW_RSTB;
    }

    u4CurVal = *(uint32_t *)&rCurCfg;
    WT_WRITE32(0, u4CurVal);

    return (INT32)E_GFX_OK;
}

