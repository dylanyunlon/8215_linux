//-------------------------------------------------------------------------
/** GFX_HwDbgInfo
 *  show gfx hw debug information
 */
//-------------------------------------------------------------------------
void GFX_HwDbgInfo(uint32_t u4GfxHwId)
{
    LOG(5, "\ngfx hw dump - begin\n");

    LOG(5, "\tflush count = %u\n", _GFX_GetFlushCount(u4GfxHwId));
    LOG(5, "\tinterrupt count = %u\n", _GFX_GetInterruptCount(u4GfxHwId));
    LOG(5, "\thw fire count = %u\n", 
            (GFX_READ32(u4GfxHwId, GFX_REG_0x40E0) & 0x0000ffff));
    LOG(5, "\thw cmdq index = %u\n", 
            ((GFX_READ32(u4GfxHwId, GFX_REG_0x40E4) & 0x3fff0000) >> 16));
    LOG(5, "\thw read  count of dram word = %u\n", GFX_READ32(u4GfxHwId, GFX_REG_0x40EC));
    LOG(5, "\thw write count of dram word = %u\n", GFX_READ32(u4GfxHwId, GFX_REG_0x40F0));

    LOG(5, "gfx hw dump - end\n\n");
}


//-------------------------------------------------------------------------
/** GFX_HwResetEngine
 *  gfx hw reset engine only (for debug use)
 */
//-------------------------------------------------------------------------
INT32 GFX_HwResetEngine(uint32_t u4GfxHwId)
{
    volatile uint32_t u4Value;
    uint32_t u4ResHi = (uint32_t)0x3;
    uint32_t u4ResLo = (uint32_t)0x0;
        
    // reset engine :
    // 1. set fg_G_RST to 0x3
    // 2. set fg_G_RST to 0x0
    u4Value = GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG);

    u4Value = (u4Value) & (~(GREG_MSK_G_RST));
    u4Value = (u4Value) | (u4ResHi << GREG_SHT_G_RST);
    GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, u4Value);
    GFX_MB();

    u4Value = (u4Value) & (~(GREG_MSK_G_RST));
    u4Value = (u4Value) | (u4ResLo << GREG_SHT_G_RST);
    GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, u4Value);
    GFX_MB();

    // wait gfx hw reset ready
    for ( ; ; )
    {
        u4Value = GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG);

        if ((u4Value & GREG_MSK_G_RST) == GFX_G_RST_READY)
        {
            break;
        }
    }

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_HwResetCmdQue
 *  gfx hw reset cmd queue only (for debug use)
 */
//-------------------------------------------------------------------------
INT32 GFX_HwResetCmdQue(uint32_t u4GfxHwId)
{
    volatile uint32_t u4Value;
    uint32_t u4ResHi = (uint32_t)0x3;
    uint32_t u4ResLo = (uint32_t)0x0;

    // reset cmdque :
    // 1. set fg_CQ_RST to 0x3
    // 2. set fg_CQ_RST to 0x0
    u4Value = GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG);

    u4Value = (u4Value) & (~(GREG_MSK_CQ_RST));
    u4Value = (u4Value) | (u4ResHi << GREG_SHT_CQ_RST);
    GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, u4Value);
    GFX_MB();

    u4Value = (u4Value) & (~(GREG_MSK_CQ_RST));
    u4Value = (u4Value) | (u4ResLo << GREG_SHT_CQ_RST);
    GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, u4Value);
    GFX_MB();

    // wait gfx hw reset ready
    for ( ; ; )
    {
        u4Value = GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG);

        if ((u4Value & GREG_MSK_CQ_RST) == GFX_CQ_RST_READY)
        {
            break;
        }
    }

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_HwGetMemCompareResult
 *  gfx get memory compare result from hw register
 *  if no error, return 0
 */
//-------------------------------------------------------------------------
INT32 GFX_HwGetMemCompareResult(uint32_t u4GfxHwId)
{
    volatile uint32_t u4Value;

    u4Value = GFX_READ32(u4GfxHwId, GFX_REG_ROP);
    u4Value = (u4Value & GREG_MSK_CMP_FLAG) >> GREG_SHT_CMP_FLAG;

    return (INT32)u4Value;
}


//-------------------------------------------------------------------------
/** GFX_HwSetReqInterval
 *  set REQ_INTERVAL
 *  only for rectangle fill.
 */
//-------------------------------------------------------------------------
void GFX_HwSetReqInterval(uint32_t u4GfxHwId, uint32_t u4ReqInterval)
{
    volatile uint32_t u4Value;
    
    u4Value = GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG);
    
    // set request interval
    u4Value = (u4Value) & (~(GREG_MSK_REQ_INTVAL));
    u4Value = (u4Value) | (u4ReqInterval << GREG_SHT_REQ_INTVAL);
    
    GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, u4Value);
}


static GFX_BPCOMP_STOP_ID_T _rBpCompStopID;

INT32 GFX_HwGetBpCompStopID(uint32_t u4GfxHwId, GFX_BPCOMP_STOP_ID_T *prBpCompStopID)
{
    _rBpCompStopID.u4StopID[0] = GFX_READ32(u4GfxHwId, GREG_BPCOMP_STOP_ID_0*4);
    _rBpCompStopID.u4StopID[1] = GFX_READ32(u4GfxHwId, GREG_BPCOMP_STOP_ID_1*4);
    _rBpCompStopID.u4StopID[2] = GFX_READ32(u4GfxHwId, GREG_BPCOMP_STOP_ID_2*4);
    _rBpCompStopID.u4StopID[3] = GFX_READ32(u4GfxHwId, GREG_BPCOMP_STOP_ID_3*4);
   
    if (NULL != prBpCompStopID)
    {
        prBpCompStopID->u4StopID[0] = _rBpCompStopID.u4StopID[0];
        prBpCompStopID->u4StopID[1] = _rBpCompStopID.u4StopID[1];
        prBpCompStopID->u4StopID[2] = _rBpCompStopID.u4StopID[2];
        prBpCompStopID->u4StopID[3] = _rBpCompStopID.u4StopID[3];
    }
   
    if ((_rBpCompStopID.u4StopID[0]) || 
        (_rBpCompStopID.u4StopID[1]) || 
        (_rBpCompStopID.u4StopID[2]) || 
        (_rBpCompStopID.u4StopID[3]))
    {
        //return -(INT32)E_GFX_BPCOMP_STOP;
    }

    return (INT32)E_GFX_OK;
}


#ifdef GFX_PERFORMANCE_TEST
VOID  vGfxStartPfmTest()
{
    g_fgGfxPfmTesting = TRUE;
    g_rGfxResultTime.u4Seconds = 0;
    g_rGfxResultTime.u4Micros = 0;
}

VOID vGfxEndPfmTest()
{
    g_fgGfxPfmTesting = FALSE;
}

uint32_t u4GetAverageMicrosPerLoop(uint32_t u4Loop)
{
    uint32_t u4Micros;

    u4Micros = (g_rGfxResultTime.u4Seconds * 1000000 + g_rGfxResultTime.u4Micros) / u4Loop;

    return (u4Micros);
}
#endif
