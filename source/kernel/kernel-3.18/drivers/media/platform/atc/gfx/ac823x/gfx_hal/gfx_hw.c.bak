//-------------------------------------------------------------------------
/** _GfxStartMonitorCrash
 *  start to monitor GFX engine crash status
 *  
 */
//-------------------------------------------------------------------------
#if 0
static void _GfxStartMonitorCrash(uint32_t u4GfxHwId)
{
    _rGfxCrashStartTime[u4GfxHwId].u4Seconds = 0;
    _rGfxCrashStartTime[u4GfxHwId].u4Micros  = 0;

    _i4GfxStartToMonitorFlag[u4GfxHwId] = 1;
}


//-------------------------------------------------------------------------
/** _GfxKeepMonitorCrash
 *  check whether GFX engine is crash or not
 *  
 */
//-------------------------------------------------------------------------
static INT32 _GfxKeepMonitorCrash(uint32_t u4GfxHwId)
{
    HAL_TIME_T rCurrentTime;
    HAL_TIME_T rDiffTime;

    // first time to record crash-time
    if (_i4GfxStartToMonitorFlag[u4GfxHwId])
    {
        _i4GfxStartToMonitorFlag[u4GfxHwId] = 0;
        HAL_GetTime(&_rGfxCrashStartTime[u4GfxHwId]);        
        return (INT32)EGFX_SEMIIDLE;
    }
    
    HAL_GetTime(&rCurrentTime);
    HAL_GetDeltaTime(&rDiffTime, &_rGfxCrashStartTime[u4GfxHwId], &rCurrentTime);

    if (rDiffTime.u4Seconds > D_GFX_CRASH_DEAD_LINE)
    {
        LOG(5, "\tCrash start time = %u\n", _rGfxCrashStartTime[u4GfxHwId].u4Seconds);
        LOG(5, "\tCrash end time = %u\n", rCurrentTime.u4Seconds);
        LOG(5, "\tCrash diff time = %u\n", rDiffTime.u4Seconds);
        return (INT32)EGFX_CRASHED;
    }

    return (INT32)EGFX_SEMIIDLE;
}


//-------------------------------------------------------------------------
/** _GfxStopMonitorCrash
 *  stop to monitor GFX engine crash status
 *  
 */
//-------------------------------------------------------------------------
static void _GfxStopMonitorCrash(void)
{
    return;
}

