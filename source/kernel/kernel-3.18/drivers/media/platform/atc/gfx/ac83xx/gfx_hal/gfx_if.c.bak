    GFX_MMUCfgA1(u4GfxHwId, 1, 1, 0, 1, 0, 0, 0);
    GFX_MMUCfgA2(u4GfxHwId, 1, 4, 0, 1, 0, 0, 0);
    GFX_MMUCfgA3(u4GfxHwId, 0, 0, 0, 0, 0, 0, 0);

