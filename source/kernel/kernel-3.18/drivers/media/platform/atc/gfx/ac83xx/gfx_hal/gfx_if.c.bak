    REG(u4GfxHwId, fg_A1_MMU_EN) = u4DstRead;
    REG(u4GfxHwId, fg_A2_MMU_EN) = u4DstWrite;
    GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG2);
    GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG3);
#endif
    #if 0
    if ((g_Gfx_MMU_Cfg.u4ID != 3) || (g_Gfx_MMU_Cfg.u4Enable != u4Enable) || (g_Gfx_MMU_Cfg.u4SrcRead != u4SrcRead) ||
        (g_Gfx_MMU_Cfg.u4DstRead != u4DstRead) || (g_Gfx_MMU_Cfg.u4DstWrite != u4DstWrite))
    {
        GFX_MMUCfgA4(u4GfxHwId);
    GFX_MMUEnable(u4GfxHwId, u4Enable);
    GFX_MMUCfgA0(u4GfxHwId, u4SrcRead, 3, 1, 1, 0, 0, 0);
    GFX_MMUCfgA1(u4GfxHwId, 0, 4, 1, 1, 0, 0, 0);
    GFX_MMUCfgA2(u4GfxHwId, u4DstWrite, 1, 1, 1, 0, 0, 0);
    GFX_MMUCfgA3(u4GfxHwId, 0, 0, 0, 0, 0, 0, 0);
    }
    #endif
    return (E_GFX_OK);
}

