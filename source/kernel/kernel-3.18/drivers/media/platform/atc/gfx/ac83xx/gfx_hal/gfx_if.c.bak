INT32 GFX_MMUCfgA4(UINT32 u4GfxHwId)
{
    if ((0x0a == (GFX_READ32(u4GfxHwId,GFX_REG_WAIT_MMU)>>27))||(0x0b == (GFX_READ32(u4GfxHwId,GFX_REG_WAIT_MMU)>>27)))
    {
        REG(u4GfxHwId, fg_IOMMU_FIRE) = TRUE;
        GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG4);
        REG(u4GfxHwId, fg_DUMMY) = FALSE;
        GFX_CMDENQ(u4GfxHwId, GREG_DUMMY);
    }

    return (E_GFX_OK);
}
/*
IOMMU_CFG2:
<compression> GFX = 0x00390037
<other>       GFX = 0x00390031
IOMMU_CFG3:
<compression> GFX = 0x00000033
<other>       GFX = 0x00000033
*/

INT32 GFX_MMUCfg(UINT32 u4GfxHwId, UINT32 u4Enable,	UINT32 u4SrcRead, UINT32 u4DstRead, UINT32 u4DstWrite)
{
    //GFX_IOMMU_WORKAROUND_BEFORE_ECO
    #if 0//(CONFIG_CHIP_VER_CURR >= CONFIG_CHIP_VER_MT8560)
    REG(u4GfxHwId, fg_A0_MMU_EN) = u4SrcRead;
    REG(u4GfxHwId, fg_A1_MMU_EN) = u4DstRead;
    REG(u4GfxHwId, fg_A2_MMU_EN) = u4DstWrite;
    GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG2);
    GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG3);
    #endif
    return (E_GFX_OK);
}

INT32 GFX_MMUCfgFill(UINT32 u4GfxHwId, UINT32 u4Enable,	UINT32 u4SrcRead, UINT32 u4DstRead, UINT32 u4DstWrite)
{

#if 0//GFX_IOMMU_SET_SELF_FIRE
    if (_gu4AllocFreeMemForGfx)
    {
        REG(u4GfxHwId, fg_IOMMU_FIRE) = 1;
        GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG4);
    }
#endif

    return (E_GFX_OK);
}

INT32 i4GfxSetMmuSelfFire(UINT32 u4GfxHwId)
{
    REG(u4GfxHwId, fg_IOMMU_FIRE)   = (UINT32)1; //add by +e
    GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG4);
    return (INT32)E_GFX_OK;
}

INT32 GFX_MMUCfgEx(UINT32 u4GfxHwId, UINT32 u4Enable,	UINT32 u4SrcRead, UINT32 u4DstRead, UINT32 u4DstWrite)
{
