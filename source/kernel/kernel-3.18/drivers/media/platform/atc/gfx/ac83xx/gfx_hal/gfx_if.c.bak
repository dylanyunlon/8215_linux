//-------------------------------------------------------------------------
/** GFX_Init
 *  gfx init.
 *  reset gfx.
 *  reset gfx timer.
 *  clear soft reg file.
 *  init dif.
 *  init command que.
 */
//-------------------------------------------------------------------------
struct clk * gfx_parent = NULL;
extern struct clk * gfxclk;
extern struct clk * gfxselect;

INT32 i4GfxDrvInstInit(void)
{
    INT32   i4Ret = 1;
    INT32   i4;
    CHAR  szEvName[16] = "GfxEv0";

    //zero instance data
    x_memset((void *)_arGfxDrvInst, 0, sizeof(_arGfxDrvInst));

    for (i4=0; i4<GFX_HAL_HW_INST_NUM; i4++)
    {
        _arGfxDrvInst[i4].u4GfxHwId = (UINT32)i4;
        _arGfxDrvInst[i4].fgGfxHwActive = FALSE;
        _arGfxDrvInst[i4].fgUninit = FALSE;
        //create event
        szEvName[4] = 0x30 + i4;
        i4Ret = x_ev_group_create(&_arGfxDrvInst[i4].hEventHandle, szEvName, GFX_EV_INITIAL);
        VERIFY(i4Ret == OSR_OK);
    }

    return i4Ret;
}

