#endif
//-------------------------------------------------------------------------
/** GFX_MemCompare
 *  do gfx memory comparison.
 *  use GFX_2DMemCompare() to complete this function.
 */
//-------------------------------------------------------------------------
INT32 GFX_MemCompare(UINT32 u4GfxHwId, UINT8 *pu1SrcBase, UINT8 *pu1DstBase, UINT32 u4Size)
{
    INT32 i4Ret;
    UINT32 u4Pitch = 16384;     // WIDTH[14:0]
    UINT32 i, u4Loops, u4LastSize;
    UINT8 *pu1SrcAddr, *pu1DstAddr;

    if (u4Size == 0)
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    u4Loops    = u4Size / u4Pitch;
    u4LastSize = u4Size % u4Pitch;

    for (i = 0; i < u4Loops; i++)
    {
        pu1SrcAddr = (UINT8 *)((UINT32)pu1SrcBase + (i * u4Pitch));
        pu1DstAddr = (UINT8 *)((UINT32)pu1DstBase + (i * u4Pitch));

        i4Ret = GFX_SetSrc(u4GfxHwId, pu1SrcAddr, CM_RGB_CLUT8, u4Pitch);
        GFX_CHECK_RET_VALUE(i4Ret);

        i4Ret = GFX_SetDst(u4GfxHwId, pu1DstAddr, CM_RGB_CLUT8, u4Pitch);
        GFX_CHECK_RET_VALUE(i4Ret);

        i4Ret = GFX_2DMemCompare(u4GfxHwId, 0, 0, 0, 0, u4Pitch, 1);
        GFX_CHECK_RET_VALUE(i4Ret);

        // flush and check compare result
        i4Ret = GFX_Flush(u4GfxHwId);
        //GFX_Wait();
        GFX_CHECK_RET_VALUE(i4Ret);

        if (GFX_GetMemCompareResult(u4GfxHwId) != 0)
        {
            return -(INT32)E_GFX_INV_ARG;
        }
    } // ~for

    if (u4LastSize > 0)
    {
        pu1SrcAddr = (UINT8 *)((UINT32)pu1SrcBase + (i * u4Pitch));
        pu1DstAddr = (UINT8 *)((UINT32)pu1DstBase + (i * u4Pitch));

        i4Ret = GFX_SetSrc(u4GfxHwId, pu1SrcAddr, CM_RGB_CLUT8, u4Pitch);
        GFX_CHECK_RET_VALUE(i4Ret);

        i4Ret = GFX_SetDst(u4GfxHwId, pu1DstAddr, CM_RGB_CLUT8, u4Pitch);
        GFX_CHECK_RET_VALUE(i4Ret);

        i4Ret = GFX_2DMemCompare(u4GfxHwId, 0, 0, 0, 0, u4LastSize, 1);
        GFX_CHECK_RET_VALUE(i4Ret);

        // flush and check compare result
        i4Ret = GFX_Flush(u4GfxHwId);
       // GFX_Wait();
        GFX_CHECK_RET_VALUE(i4Ret);

        if (GFX_GetMemCompareResult(u4GfxHwId) != 0)
        {
            return -(INT32)E_GFX_INV_ARG;
        }
    }

    return (INT32)E_GFX_OK;
}


//static UINT32 _u4GfxMmuWaitMode;

INT32 i4GfxSetMmuWaitMode(UINT32 u4Mode)
{
    _u4GfxMmuWaitMode = u4Mode;
    return (INT32)E_GFX_OK;
}

INT32 i4GfxSetMmuGlbBypss(UINT32 u4Mode)
{
    _u4GfxMmuGlbBypss = u4Mode;
    return (INT32)E_GFX_OK;
}

INT32 GFX_SetMmuWaitMode(UINT32 u4GfxHwId, UINT32 u4Mode)
{
    UINT32 u4Value;
	
    //for(i4 = 0;i4<GFX_HAL_HW_INST_NUM;i4++)
    {
        GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG) & 0x000FFFFE);

        //Default WDLE
        u4Value = GFX_READ32(u4GfxHwId, GFX_REG_DST_RING);
        u4Value =  u4Value | (0x1 << GREG_SHT_WDLE);
        GFX_WRITE32(u4GfxHwId, GFX_REG_DST_RING, u4Value);

        //Default HW self fire MMU
        u4Value = GFX_READ32(u4GfxHwId, GFX_REG_WAIT_MMU);
        u4Value = u4Value & 0x00FFFF00;

        switch (u4Mode)
        {
        case 0:
            u4Value = u4Value |  (0x1  << GREG_SHT_HW_SELF_FIRE_EN);
            //u4Value = u4Value & ~(0x1  << GREG_SHT_CMQ_SELF_FIRE_EN);
            //u4Value = u4Value & ~(0x1  << GREG_SHT_ORG_FIRE_EN);
            u4Value = u4Value |  (0x1  << GREG_SHT_SELF_FIRE_EN);
            //u4Value = u4Value & ~(0x1  << GREG_SHT_CMQ_BYPASS_MMU);
            //u4Value = u4Value & ~(0xff << GREG_SHT_CMQ_SELF_FIRE_CYC);
            u4Value = u4Value |  (0x100 << GREG_SHT_CMQ_SELF_FIRE_CYC);
        break;
        case 1:
            u4Value = u4Value |  (0x1  << GREG_SHT_HW_SELF_FIRE_EN);
            //u4Value = u4Value & ~(0x1  << GREG_SHT_CMQ_SELF_FIRE_EN);
            //u4Value = u4Value & ~(0x1  << GREG_SHT_ORG_FIRE_EN);
            u4Value = u4Value |  (0x1  << GREG_SHT_SELF_FIRE_EN);
            u4Value = u4Value |  (0x1  << GREG_SHT_CMQ_BYPASS_MMU);
            //u4Value = u4Value & ~(0xff << GREG_SHT_CMQ_SELF_FIRE_CYC);
        break;
        case 2:
            //u4Value = u4Value & ~(0x1  << GREG_SHT_HW_SELF_FIRE_EN);
            u4Value = u4Value |  (0x1  << GREG_SHT_CMQ_SELF_FIRE_EN);
            //u4Value = u4Value & ~(0x1  << GREG_SHT_ORG_FIRE_EN);
            u4Value = u4Value |  (0x1  << GREG_SHT_SELF_FIRE_EN);
            //u4Value = u4Value & ~(0x1  << GREG_SHT_CMQ_BYPASS_MMU);
            u4Value = u4Value |  (0x20 << GREG_SHT_CMQ_SELF_FIRE_CYC);
        break;
        case 3:
        default:
            //u4Value = u4Value & ~(0x1  << GREG_SHT_HW_SELF_FIRE_EN);
            u4Value = u4Value |  (0x1  << GREG_SHT_CMQ_SELF_FIRE_EN);
            //u4Value = u4Value & ~(0x1  << GREG_SHT_ORG_FIRE_EN);
            u4Value = u4Value |  (0x1  << GREG_SHT_SELF_FIRE_EN);
            u4Value = u4Value |  (0x1  << GREG_SHT_CMQ_BYPASS_MMU);
            u4Value = u4Value |  (0x20 << GREG_SHT_CMQ_SELF_FIRE_CYC);
        break;
        }
        GFX_WRITE32(u4GfxHwId,GFX_REG_WAIT_MMU, u4Value);

    #ifndef GFX_RISC_MODE
        GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG) | 0x00C00001);
    #endif
    }

    return ((INT32)E_GFX_OK);
}

INT32 GFX_SetPreColorize(UINT32 u4GfxHwId, UINT32 u4PreColorize, UINT32 u4ColorRepEn, UINT32 u4ColorRep)
{
    GFX_HW_FX_ENTRY;

    REG(u4GfxHwId, fg_COLORIZE_REP)    = u4ColorRepEn;
    REG(u4GfxHwId, fg_PRE_COLORIZE)    = u4PreColorize;
    GFX_CMDENQ(u4GfxHwId, GREG_ROP);
    REG(u4GfxHwId, fg_JAVA_XOR_COLOR)  = u4ColorRep;
    return GFX_CMDENQ(u4GfxHwId, GREG_XOR_COLOR);

}

#define Gfx_PreColorize(u4PreColorize, u4ColorRepEn, u4ColorRep, u4OpCode) \
    UINT32 u4PreColorize, u4ColorRepEn, u4ColorRep; \
    u4PreColorize = (u4OpCode & 0x00010000)>>16; \
    u4ColorRepEn = (u4OpCode & 0x00020000)>>17; \
    u4ColorRep = (u4OpCode & 0xFF000000); \
    u4OpCode = (u4OpCode & 0xFFFF); \
    REG(u4GfxHwId, fg_COLORIZE_REP)    = u4ColorRepEn; \
    REG(u4GfxHwId, fg_PRE_COLORIZE)    = u4PreColorize; \
    GFX_CMDENQ(u4GfxHwId, GREG_ROP); \
    REG(u4GfxHwId, fg_JAVA_XOR_COLOR)  = u4ColorRep; \
    GFX_CMDENQ(u4GfxHwId, GREG_XOR_COLOR); \


INT32 GFX_PreColorizeComposeLoop(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX,
    UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height, UINT32 u4Ar,
    UINT32 u4OpCode, UINT32 u4RectSrc)

{
    INT32 i4MhpPatch = GFX_ENABLE;
    UINT32 u4SrcAddr, u4DstAddr;
    //8580 support PreColorize

    Gfx_PreColorize(u4PreColorize, u4ColorRepEn, u4ColorRep, u4OpCode);

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif
    // Add CLEAR, SRC, SRC_OVER patches for MHP project
    // 1. CLEAR    -> use Rect Fill (fill 0x0 in rect_color)
    // 2. SRC      -> use Pass0 and Pass5 of Alpha Composition
    // 3. SRC_OVER -> consider two corner cases
    //          case1: Ar=1.0 & As=1.0
    //          case2: Ar=1.0 & As=0.0
    //          note: Ar=0.0 is the same as case2
    if (((UINT32)CM_ARGB8888_DIRECT32 == _u4SrcCM[u4GfxHwId]) &&
        ((UINT32)CM_ARGB8888_DIRECT32 == _u4DstCM[u4GfxHwId]) &&
        (GFX_ENABLE == i4MhpPatch))
    {
        if ((UINT32)E_AC_CLEAR == u4OpCode)
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_Fill(u4GfxHwId, u4DstX, u4DstY, u4Width, u4Height);

            // restore original value
            GFX_SetColor(u4GfxHwId, u4RectColor);
            return (INT32)E_GFX_OK;
        }
        else if ((UINT32)E_AC_SRC == u4OpCode)
        {
            if (0 == u4Ar)
            {
                UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

                GFX_SetColor(u4GfxHwId, 0x0);
                GFX_Fill(u4GfxHwId, u4DstX, u4DstY, u4Width, u4Height);

                // restore original value
                GFX_SetColor(u4GfxHwId, u4RectColor);
                return (INT32)E_GFX_OK;
            }
            else if(255 == u4Ar)
            {
                UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

                GFX_SetColor(u4GfxHwId, 0x0);
                GFX_SetBltOpt(u4GfxHwId, (UINT32)D_GFXFLAG_NONE, 0x00000000, 0xffffffff);

                GFX_SetAlpha(u4GfxHwId, u4Ar);

                GFX_BitBlt(u4GfxHwId, u4SrcX, u4SrcY, u4DstX, u4DstY, u4Width, u4Height);
                // restore original value
                GFX_SetColor(u4GfxHwId, u4RectColor);
                return (INT32)E_GFX_OK;
            }
        }
        else if (((UINT32)E_AC_SRC_OVER == u4OpCode) &&
                 (0 == u4Ar))
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);
            UINT32 u4MinColor  = REG(u4GfxHwId, fg_COLOR_KEY_MIN);
            UINT32 u4MaxColor  = REG(u4GfxHwId, fg_COLOR_KEY_MAX);
            UINT32 u4Switch    = 0x0;

            if (REG(u4GfxHwId, fg_TRANS_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_TRANSPARENT);
            }

            if (REG(u4GfxHwId, fg_KEYNOT_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYNOT);
            }

            if (REG(u4GfxHwId, fg_COLCHG_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_COLORCHANGE);
            }

            if (REG(u4GfxHwId, fg_KEYSDSEL))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYSDSEL);
            }

            // BitBlt with ColorChange (from Dst to Dst)
            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_SetBltOpt(u4GfxHwId, D_GFXFLAG_COLORCHANGE, 0x00000000, 0x00FFFFFF);

            // set new src & dst pitch
            REG(u4GfxHwId, fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4DstPitch[u4GfxHwId] >> 4;

            u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) +
                (u4DstX << _u4DstShift[u4GfxHwId]));
            REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
            u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
            REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

            REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_BITBLT;
            REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
            REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
            REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
            REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

            VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
            VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
            GFX_VA_MSB_CMDENQ(u4GfxHwId);

            if (GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH)    |
                GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
                GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
                GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }

            // restore original value
            REG(u4GfxHwId, fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4SrcPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
            GFX_SetColor(u4GfxHwId, u4RectColor);
            GFX_SetBltOpt(u4GfxHwId, u4Switch, u4MinColor, u4MaxColor);
            if (GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH) |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)    |
                GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }
            return (INT32)E_GFX_OK;
        }
        else
        {
            //do nothing, for lint happy
        }
    }

    GFX_Disable2SrcBlending();
    // normal compose in LOOP mode

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4Height - 1);
    REG(u4GfxHwId, fg_ALCOM_AR)       = u4Ar;
    REG(u4GfxHwId, fg_ALCOM_OPCODE)   = u4OpCode;
    REG(u4GfxHwId, fg_ALCOM_RECT_SRC) = u4RectSrc;

    REG(u4GfxHwId, fg_ALCOM_NORMAL) = 0;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP)     |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

#if GFX_IOMMU_WORKAROUND_BEFORE_ECO
    if (fgRunBelowSegmentBefore(IC_8560_VER_A)) //for before 8560ECO
    {
    	REG(u4GfxHwId, fg_ALCOM_OPCODE)   = (UINT32)0; //add by +e
		GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP);
    }
#endif

    return (INT32)E_GFX_OK;
}

INT32 GFX_GetStartRegion(UINT32 *pu4Height, UINT32 u4Y, UINT32 u4RegionCnt)
{
    UINT32 u4StartReg = 0;
    UINT32 u4i = 0;

    for (; u4i < u4RegionCnt; u4i++)
    {
        if ((u4Y+1) < pu4Height[u4i])
        {
            u4StartReg = u4i;
            break;
        }
    }

    return u4StartReg;
}

INT32 GFX_SetLosslessRegionEnable(UINT32 u4GfxHwId, UINT32 u4RegionCount)
{
    UINT32 u4Val = 0;

    if (u4RegionCount <= 32)
    {
        u4Val = 0xFFFFFFFF >> (33 - u4RegionCount);
        //UTIL_Printf("u4Val = 0x%x\n", u4Val);
        REG_LL(u4GfxHwId, fg_REGION_ENA_1) = u4Val;
        GFX_CMDENQ_LL(u4GfxHwId, GREG_REGION_ENA_1);
    }
    else if (u4RegionCount <= 64)
    {
        u4Val = 0xFFFFFFFF >> (65 - u4RegionCount);
        REG_LL(u4GfxHwId, fg_REGION_ENA_1) = 0xFFFFFFFF;
        REG_LL(u4GfxHwId, fg_REGION_ENA_2) = u4Val;
        GFX_CMDENQ_LL(u4GfxHwId, GREG_REGION_ENA_1);
        GFX_CMDENQ_LL(u4GfxHwId, GREG_REGION_ENA_2);
    }

    return E_GFX_OK;
}

INT32 GFX_SetLosslessRegionDisableAll(UINT32 u4GfxHwId)
{
    REG_LL(u4GfxHwId, fg_REGION_ENA_1) = 0x0;
    REG_LL(u4GfxHwId, fg_REGION_ENA_2) = 0x0;
    GFX_CMDENQ_LL(u4GfxHwId, GREG_REGION_ENA_1);
    GFX_CMDENQ_LL(u4GfxHwId, GREG_REGION_ENA_2);

    return E_GFX_OK;
}

INT32 GFX_SetLosslessRegionHeight(UINT32 u4GfxHwId, UINT32 *pu4Height, UINT32 u4RegionCount)
{
    UINT32 u4Value = 0;
    UINT32 u4i = 0, u4j = 0;

    for (; u4i < u4RegionCount - 1; u4i++, u4j++)
    {
        u4Value = pu4Height[u4i++] & 0xffff;
        u4Value |= (pu4Height[u4i] << 16);
        REGFILE_LL(u4GfxHwId, u4j) = u4Value;
        GFX_CMDENQ_LL(u4GfxHwId, u4j);
    }

    return E_GFX_OK;
}

INT32 GFX_SetLosslessRegionAddr(UINT32 u4GfxHwId, UINT32 *pu4Addr, UINT32 u4RegionCount)
{
    UINT32 u4Value = 0;
    UINT32 u4i = 0;

    for (; u4i < u4RegionCount - 1; u4i++)
    {
        u4Value = pu4Addr[u4i];
        REGFILE_LL(u4GfxHwId, u4i + GREG_REGION_ADDR_0) = u4Value;
        GFX_CMDENQ_LL(u4GfxHwId, u4i + GREG_REGION_ADDR_0);
    }

    return E_GFX_OK;
}

INT32 GFX_SetLosslessMultiRegionEnable(UINT32 u4GfxHwId, UINT32 u4Enable)
{
    REG(u4GfxHwId, fg_MULTREG_ENA) = u4Enable;
    GFX_CMDENQ(u4GfxHwId, GREG_BMP_STATUS);

    return E_GFX_OK;
}

INT32 GFX_SetLosslessDecSettings(UINT32 u4GfxHwId, UINT32 u4Y, UINT32 u4RegionCount, UINT32 *pu4Height, UINT32 *pu4Addr)
{
    INT32 i4Ret = 0, u4i = 0;
    UINT32 u4StartReg = 0;
    UINT32 u4RegCnt = 0;
    UINT32 arHeight[64] = {0};
    UINT32 arAddr[64] = {0};

    // rebuild region height array
    u4StartReg = GFX_GetStartRegion(pu4Height, u4Y, u4RegionCount);
    u4RegCnt = u4RegionCount - u4StartReg;
    //UTIL_Printf("[GFX_SetLosslessDecSettings] u4StartReg=%d,u4RegCnt=%d\n", u4StartReg, u4RegCnt);
    x_memcpy(&arHeight[0], &pu4Height[u4StartReg], u4RegCnt << 2);
    for (u4i = 0; u4i < u4RegCnt; u4i++)
    {
        arHeight[u4i] -= u4Y;
        //UTIL_Printf("[GFX_SetLosslessDecSettings] arHeight[%d] = %d\n", u4i, arHeight[u4i]);
    }
    i4Ret = GFX_SetLosslessMultiRegionEnable(u4GfxHwId, 1);
    i4Ret |= GFX_SetLosslessRegionHeight(u4GfxHwId, arHeight, u4RegCnt);
    x_memcpy(&arAddr[0], &pu4Addr[u4StartReg], u4RegCnt << 2);
    i4Ret |= GFX_SetLosslessRegionAddr(u4GfxHwId, arAddr, u4RegCnt);
    i4Ret |= GFX_SetLosslessRegionEnable(u4GfxHwId, u4RegCnt);

    return i4Ret;
}

INT32 GFX_SetLosslessDecSettings_new(UINT32 u4GfxHwId, UINT32 u4Y, UINT32 u4RegionCount, UINT32 *pu4Height, UINT32 *pu4Addr)
{
    INT32 i4Ret = 0, u4i = 0;
    UINT32 u4StartReg = 0;
    UINT32 u4EndReg = 0;
    UINT32 u4RegCnt = 0;
    UINT32 arHeight[64] = {0};
    UINT32 arAddr[64] = {0};

    // rebuild region height array
    u4StartReg = GFX_GetStartRegion(pu4Height, u4Y, u4RegionCount);
    u4RegCnt = 1;
    u4EndReg = u4StartReg+1; // GFX_GetStartRegion(pu4Height, u4Y_end-1, u4RegionCount);
    UTIL_Printf("[GFX_SetLosslessDecSettings] u4StartReg=%d, u4EndReg=%d, u4RegCnt=%d\n", u4StartReg,u4EndReg,u4RegCnt);
    x_memcpy(&arHeight[0], &pu4Height[u4StartReg], u4RegCnt << 2);
    for (u4i = 0; u4i < u4RegCnt; u4i++)
    {
        arHeight[u4i] -= u4Y;
        UTIL_Printf("[GFX_SetLosslessDecSettings] arHeight[%d] = %d\n", u4i, arHeight[u4i]);
    }
    i4Ret = GFX_SetLosslessMultiRegionEnable(u4GfxHwId, 1);
    i4Ret |= GFX_SetLosslessRegionHeight(u4GfxHwId, arHeight, u4RegCnt);
    x_memcpy(&arAddr[0], &pu4Addr[u4StartReg], u4RegCnt << 2);
    i4Ret |= GFX_SetLosslessRegionAddr(u4GfxHwId, arAddr, u4RegCnt);
    i4Ret |= GFX_SetLosslessRegionEnable(u4GfxHwId, u4RegCnt);

    return i4Ret;
}


