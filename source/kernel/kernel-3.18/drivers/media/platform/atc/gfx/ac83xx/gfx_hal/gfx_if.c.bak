        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetMirrorFlipFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_StretchJavaXor(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                         UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH, UINT32 u4JavaXorClr)
{
    UINT32 u4SrcAddr, u4DstAddr;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));

    REG(u4GfxHwId, fg_DST_BSAD)  = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)  = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4SrcH - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    // Stretch part
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Java XOR part
    GFX_SetJavaXorOpt(u4GfxHwId, u4JavaXorClr);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_STRETCH_JAVA_XOR;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_StretchRotateJavaXor(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                               UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH,
                               UINT32 u4Is90CCW, UINT32 u4JavaXorClr)
{
    UINT32 u4SrcAddr, u4DstAddr;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));

    REG(u4GfxHwId, fg_DST_BSAD)  = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)  = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4SrcH - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    // Stretch part
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Rotate part
    GFX_SetRotateOpt(u4GfxHwId, FALSE, u4Is90CCW);

    // Java XOR part
    GFX_SetJavaXorOpt(u4GfxHwId, u4JavaXorClr);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_STRETCH_ROTATE_JAVA_XOR;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetRotateMirrorFlipFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

INT32 GFX_BpCompressBase(UINT32 u4GfxHwId, UINT32 u4SrcW, UINT32 u4RollBackEn, UINT32 u4QulityMode, UINT32 u4LineSeparate)
{
    GFX_HW_FX_ENTRY;

#ifndef GFX_SUPPORT_DIFF_CM
    if ((_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId]) || (u4SrcW%8 != 0))
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#else
    if (u4SrcW%8 != 0)
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_BPCOMP;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;

    REG(u4GfxHwId, fg_ROLL_BACK_EN)      = u4RollBackEn;
    REG(u4GfxHwId, fg_QUALITY_MODE)      = u4QulityMode;
    REG(u4GfxHwId, fg_LINE_SEPRATE)      = u4LineSeparate;

    // Maxnium Address
    REG(u4GfxHwId, fg_BPCOMP_AD_END)     = 0x3fff0000;

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    //VA_MSB_REG(u4GfxHwId, fg_BPCOMP_AD_END_H, _pu1DstBase[u4GfxHwId]);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END)  |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


INT32 GFX_BpCompressSpecial(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY,
    UINT32 u4DstX, UINT32 u4DstY, UINT32 u4SrcW, UINT32 u4SrcH)
{
    UINT32 u4SrcAddr, u4DstAddr;

    GFX_HW_FX_ENTRY;

#ifndef GFX_SUPPORT_DIFF_CM
    if ((_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId]) || (u4SrcW%8 != 0))
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#else
    if (u4SrcW%8 != 0)
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));

    REG(u4GfxHwId, fg_DST_BSAD)  = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)  = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4SrcH - 1;

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_BpCompress(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
    UINT32 u4DstX, UINT32 u4DstY, UINT32 u4RollBackEn, UINT32 u4QulityMode, UINT32 u4LineSeparate)
{
    UINT32 u4Size;
    GFX_HW_FX_ENTRY;

    u4Size = _u4DstPitch[u4GfxHwId] * u4SrcH;

    return (GFX_BpCompressEx(u4GfxHwId, u4SrcX, u4SrcY, u4SrcW, u4SrcH, u4DstX, u4DstY, u4RollBackEn, u4QulityMode, u4LineSeparate, u4Size));
}

INT32 GFX_BpCompressEx(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
    UINT32 u4DstX, UINT32 u4DstY, UINT32 u4RollBackEn, UINT32 u4QulityMode, UINT32 u4LineSeparate, UINT32 u4Size)
{
    UINT32 u4SrcAddr, u4DstAddr, u4EndAddr;

    GFX_HW_FX_ENTRY;

#ifndef GFX_SUPPORT_DIFF_CM
    if ((_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId]) || (u4SrcW%8 != 0))
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#else
    if (u4SrcW%8 != 0)
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    u4EndAddr = u4DstAddr + u4Size;
    u4EndAddr = 0xffffffff;

    REG(u4GfxHwId, fg_A0_MID) = 3;
    GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG2);

    REG(u4GfxHwId, fg_DST_BSAD)  = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)  = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_BPCOMP;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4SrcH - 1;
    //u4RollBackEn = 0;
    REG(u4GfxHwId, fg_ROLL_BACK_EN)      = u4RollBackEn;
    REG(u4GfxHwId, fg_QUALITY_MODE)      = u4QulityMode;
    REG(u4GfxHwId, fg_LINE_SEPRATE)      = u4LineSeparate;
    REG(u4GfxHwId, fg_BURST_MODE)    = 0;//Gfx Burst mode must be 0

    // Maxnium Address
    //REG(u4GfxHwId, fg_BPCOMP_AD_END)     = 0x3fff0000;
    REG(u4GfxHwId, fg_BPCOMP_AD_END) = GFX_PHYSICAL(u4EndAddr);

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    //VA_MSB_REG(u4GfxHwId, fg_BPCOMP_AD_END_H, u4EndAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END)  |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        GFX_CMDENQ(u4GfxHwId, GREG_DUMMY);
        REG(u4GfxHwId, fg_A0_MID) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG2);
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    GFX_CMDENQ(u4GfxHwId, GREG_DUMMY);
    REG(u4GfxHwId, fg_A0_MID) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG2);

    return (INT32)E_GFX_OK;
}

#endif /* end of #if (CONFIG_CHIP_VER_CURR >= CONFIG_CHIP_VER_MT8550) */

//#if (CONFIG_CHIP_VER_CURR < CONFIG_CHIP_VER_MT8555)
INT32 GFX_PremultipliedConvert(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY, 
                               UINT32 u4Width, UINT32 u4Height, GFX_PREMULTIPLIED_CNV_TYPE eCvtType)
{
	UINT32 u4SrcAddr, u4DstAddr;
    GFX_HW_FX_ENTRY;

//#ifndef GFX_SUPPORT_DIFF_CM
#if 1
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId]) 
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

	u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
	
	REG(u4GfxHwId, fg_DST_BSAD)  = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)  = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4Height - 1;

    if (E_NOT_PREMULTIPLIED_2_PREMULTIPLIED == eCvtType)
    {
        REG(u4GfxHwId, fg_NONPRE2PREMUTLI_ENA)   = 1;
        REG(u4GfxHwId, fg_PRE2NONPREMUTLI_ENA)   = 0;
        REG(u4GfxHwId, fg_SRC_OVERFLOW_ENA)      = 0;
    }
    else
    {
        REG(u4GfxHwId, fg_NONPRE2PREMUTLI_ENA)   = 0;
        REG(u4GfxHwId, fg_PRE2NONPREMUTLI_ENA)   = 1;
        REG(u4GfxHwId, fg_SRC_OVERFLOW_ENA)      = 1;
    }
    
    REG(u4GfxHwId, fg_ALCOM_NORMAL)   = 1;
    REG(u4GfxHwId, fg_ALCOM_AR)       = 255;
    REG(u4GfxHwId, fg_ALCOM_OPCODE)   = E_AC_SRC;
    REG(u4GfxHwId, fg_ALCOM_RECT_SRC) = 0;

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

	VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);
	
    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP)     |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    REG(u4GfxHwId, fg_NONPRE2PREMUTLI_ENA)   = 0;
    REG(u4GfxHwId, fg_PRE2NONPREMUTLI_ENA)   = 0;
    REG(u4GfxHwId, fg_SRC_OVERFLOW_ENA)      = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP);

    return (INT32)E_GFX_OK;
}

#if 1//(CONFIG_CHIP_VER_CURR >= CONFIG_CHIP_VER_MT8560)||(CONFIG_CHIP_VER_CURR == CONFIG_CHIP_VER_MT3363)
INT32 GFX_YCbCr2RGBAlphaCompose(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height,
        UINT8 *p1LumaSA, UINT32 u4SrcLumaPitch, UINT8 *p1ChromaSA, UINT32 u4SrcChromaPitch,
        UINT32 u4YCFmt, UINT32 u4SwapMode, UINT32 u4VidStd, UINT32 u4VidSys, UINT32 u4VsClip, UINT32 u4FldPic,
        UINT32 u4AlComNormal, UINT32 u4Ar, UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 u4DstAddr;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));

    REG(u4GfxHwId, fg_DST_BSAD)  = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4Height - 1;

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // YCbCr 2 RGB
    if (E_GFX_OK != GFX_SetColCnvFmtEx(u4GfxHwId, u4YCFmt, u4SwapMode, u4VidStd, u4VidSys, u4VsClip))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    if (E_GFX_OK != GFX_SetColCnvSrcEx(u4GfxHwId, p1LumaSA, u4SrcLumaPitch, p1ChromaSA, u4SrcChromaPitch, u4FldPic))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // Loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlComNormal, u4Ar, u4OpCode, u4RectSrc);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_YCBCR2RGB_ALCOM;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_YCbCr2RGBStretchAlphaCompose(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4Width, UINT32 u4Height,
            UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstWidth, UINT32 u4DstHeight,
            UINT8 *p1LumaSA, UINT32 u4SrcLumaPitch, UINT8 *p1ChromaSA, UINT32 u4SrcChromaPitch,
            UINT32 u4YCFmt, UINT32 u4SwapMode, UINT32 u4VidStd, UINT32 u4VidSys, UINT32 u4VsClip, UINT32 u4FldPic,
            UINT32 u4AlComNormal, UINT32 u4Ar, UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 u4DstAddr;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));

    REG(u4GfxHwId, fg_DST_BSAD)  = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4Height - 1;

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // YCbCr 2 RGB
    if (E_GFX_OK != GFX_SetColCnvFmtEx(u4GfxHwId, u4YCFmt, u4SwapMode, u4VidStd, u4VidSys, u4VsClip))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    if (E_GFX_OK != GFX_SetColCnvSrcEx(u4GfxHwId, p1LumaSA, u4SrcLumaPitch, p1ChromaSA, u4SrcChromaPitch, u4FldPic))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // Stretch part:
    GFX_SetStretchBltOpt(u4GfxHwId, u4Width, u4Height, u4DstWidth, u4DstHeight);

    // Loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlComNormal, u4Ar, u4OpCode, u4RectSrc);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_STRETCH_YCBCR2RGB_ALCOM;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_YCbCr2RGBStretchMFlipAlphaCompose(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4Width, UINT32 u4Height,
                                       UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstWidth, UINT32 u4DstHeight,
                                       UINT8 *p1LumaSA, UINT32 u4SrcLumaPitch, UINT8 *p1ChromaSA, UINT32 u4SrcChromaPitch,
                                       UINT32 u4YCFmt, UINT32 u4SwapMode, UINT32 u4VidStd, UINT32 u4VidSys, UINT32 u4VsClip, UINT32 u4FldPic,
                                       UINT32 u4AlComNormal, UINT32 u4Ar, UINT32 u4MFOpt, UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 u4SrcAddr = 0, u4DstAddr = 0;
#if 0

    switch (u4MFOp)
    {
    case E_BITBLT_SRC_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            (u4SrcY * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4SrcW-1)<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            ((u4SrcY+u4SrcH-1) * _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            ((u4SrcY+u4SrcH-1) * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4SrcW-1)<< _u4SrcShift[u4GfxHwId]));
        break;
#if 0
    case E_BITBLT_DST_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + ((u4DstX+u4DstW-1) << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
            (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_DST_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase +
            ((u4DstY  +u4DstH-1)* _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
            (u4SrcY* _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;

    case E_BITBLT_DST_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase +
            ((u4DstY  +u4DstH-1)* _u4DstPitch[u4GfxHwId]) + ((u4DstX+u4DstW-1) << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
            (u4SrcY* _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;
#endif
    default:
        return E_GFX_INV_ARG;
    }
#endif
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4Height - 1;

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // YCbCr 2 RGB
    if (E_GFX_OK != GFX_SetColCnvFmtEx(u4GfxHwId, u4YCFmt, u4SwapMode, u4VidStd, u4VidSys, u4VsClip))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    if (E_GFX_OK != GFX_SetColCnvSrcEx(u4GfxHwId, p1LumaSA, u4SrcLumaPitch, p1ChromaSA, u4SrcChromaPitch, u4FldPic))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // Stretch part:
    GFX_SetStretchBltOpt(u4GfxHwId, u4Width, u4Height, u4DstWidth, u4DstHeight);

    // Loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlComNormal, u4Ar, u4OpCode, u4RectSrc);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_STRETCH_YCBCR2RGB_ALCOM;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetMirrorFlipFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

INT32 GFX_YCbCr2RGBStretchJavaXor(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4Width, UINT32 u4Height,
            UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstWidth, UINT32 u4DstHeight,
            UINT8 *p1LumaSA, UINT32 u4SrcLumaPitch, UINT8 *p1ChromaSA, UINT32 u4SrcChromaPitch,
            UINT32 u4YCFmt, UINT32 u4SwapMode, UINT32 u4VidStd, UINT32 u4VidSys, UINT32 u4VsClip, UINT32 u4FldPic,
            UINT32 u4JavaXorClr)
{
    UINT32 u4DstAddr;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));

    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4Height - 1;

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // YCbCr 2 RGB
    if (E_GFX_OK != GFX_SetColCnvFmtEx(u4GfxHwId, u4YCFmt, u4SwapMode, u4VidStd, u4VidSys, u4VsClip))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    if (E_GFX_OK != GFX_SetColCnvSrcEx(u4GfxHwId, p1LumaSA, u4SrcLumaPitch, p1ChromaSA, u4SrcChromaPitch, u4FldPic))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // Stretch part:
    GFX_SetStretchBltOpt(u4GfxHwId, u4Width, u4Height, u4DstWidth, u4DstHeight);

    // Loop mode compose part
    GFX_SetJavaXorOpt(u4GfxHwId, u4JavaXorClr);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_STRETCH_YCBCR2RGB_JAVAXOR;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_LosslessDecodeComposeLoop(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY,
    UINT32 u4DstX, UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height, UINT32 u4Ar, UINT32 u4OpCode,
    UINT32 u4RectSrc, UINT32 u4PixelWidth, UINT32 u4PacketWidth, UINT32 u4QulityMode, UINT8 *p1IdxSA)
{
    UINT32 u4XStart = 0, u4XEnd = 0, u4ActiveWidth = 0;
    UINT32 u4SrcAddr, u4DstAddr, u4SrcWBAddr;
    UINT8 *u4IdxTblAddr = p1IdxSA;

#if 1//(CONFIG_CHIP_VER_CURR >= CONFIG_CHIP_VER_MT8560)||(CONFIG_CHIP_VER_CURR == CONFIG_CHIP_VER_MT3363)
    //REG(u4GfxHwId, fg_DIFF_CM)  = ((_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]?1:0));
#else
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    GFX_Disable2SrcBlending();

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId]);
    u4SrcWBAddr = u4SrcAddr;
    u4SrcAddr += (u4SrcX % 2) << 2;
    u4IdxTblAddr += ((((u4PacketWidth + 1) << 1) + 15) & ~15) * u4SrcY;
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WBBSAD) = GFX_PHYSICAL(u4SrcWBAddr);
    REG(u4GfxHwId, fg_DST_WBBSAD) = GFX_PHYSICAL(u4DstAddr);
    //REG(u4GfxHwId, fg_INDEX_BASD) = GFX_PHYSICAL(u4IdxTblAddr);//p1IdxSA);

    u4Height -= 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4Height & 0x007FF;
    REG(u4GfxHwId, fg_SRC_CM_2)       = (u4Height >> 11) & 0x0F;
    REG(u4GfxHwId, fg_SRC_HEIGHT_15)  = (u4Height >> 15) & 0x01;
    REG(u4GfxHwId, fg_SRC_HEIGHT_19_16) = (u4Height >> 16) & 0x0F;

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    //REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4Height - 1);
    REG(u4GfxHwId, fg_ALCOM_AR)       = u4Ar;
    REG(u4GfxHwId, fg_ALCOM_OPCODE)   = u4OpCode;
    REG(u4GfxHwId, fg_ALCOM_RECT_SRC) = u4RectSrc;
    REG(u4GfxHwId, fg_ALCOM_NORMAL)   = (u4Ar == 0xff);

    REG(u4GfxHwId, fg_LINE_SEPRATE)      = 0;
    REG(u4GfxHwId, fg_ROLL_BACK_EN)      = 0;
    REG(u4GfxHwId, fg_PIXEL_SEPARATE)    = 1;
    REG(u4GfxHwId, fg_DEC_ENA)           = 1;
    REG(u4GfxHwId, fg_DEC_MODE)          = 2;
    REG(u4GfxHwId, fg_QUALITY_MODE)      = u4QulityMode;
    REG(u4GfxHwId, fg_PIXEL_WIDTH)       = u4PixelWidth >> 3;
    REG(u4GfxHwId, fg_PACKET_WIDTH)      = u4PacketWidth;

    u4XStart = u4SrcX / u4PixelWidth;
    u4XEnd = (u4SrcX + u4Width - 1) / u4PixelWidth;
    u4ActiveWidth = u4XEnd - u4XStart + 1;

    //REG(u4GfxHwId, fg_LINE_WIDTH)          = u4ActiveWidth * u4PixelWidth;
    REG(u4GfxHwId, fg_SRCX)                = u4SrcX;
    REG(u4GfxHwId, fg_SRCY)                = u4SrcY;
    REG(u4GfxHwId, fg_PACKET_X_START)      = u4XStart;
    REG(u4GfxHwId, fg_PACKET_ACTIVE_WIDTH) = u4ActiveWidth;

    // Maximum Address
    REG(u4GfxHwId, fg_BPCOMP_AD_END) = 0x3fff0000;  // not care?

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_WBBSAD_H, u4SrcWBAddr);
    VA_MSB_REG(u4GfxHwId, fg_DST_WBBSAD_H, u4DstAddr);
    //VA_MSB_REG(u4GfxHwId, fg_BPCOMP_AD_END_H, u4DstAddr);
//    VA_MSB_REG(u4GfxHwId, fg_INDEX_BASD_H, u4IdxTblAddr);//p1IdxSA);
    VA_PAL_MSB_REG(u4GfxHwId, fg_INDEX_BASD_H, u4IdxTblAddr);//pu1DstIdxAddr);

    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_PGIG)         |
        GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END)  |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_DST_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E0)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E4)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E8)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40EC)         |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_XY)         |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

#if GFX_IOMMU_WORKAROUND_BEFORE_ECO
	if (fgRunBelowSegmentBefore(IC_8560_VER_A)) //for before 8560ECO
	{
		REG(u4GfxHwId, fg_OP_MODE)		  = (UINT32) 0;
		GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP);
	}
#endif

    REG(u4GfxHwId, fg_SRC_CM_2) = 0;
    REG(u4GfxHwId, fg_SRC_HEIGHT_15)  = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
    REG(u4GfxHwId, fg_SRC_HEIGHT_19_16) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_G_PGIG);  
    REG(u4GfxHwId, fg_DEC_ENA) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
    
    GFX_SetLosslessMultiRegionEnable(u4GfxHwId, 0);

    return (INT32)E_GFX_OK;
}

INT32 GFX_LosslessDecodeStretchBitblt(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                                              UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH, UINT32 u4PixelWidth,
                                              UINT32 u4PacketWidth, UINT32 u4QulityMode, UINT8 *p1IdxSA)
{
    UINT32 u4MnV = 0;
    UINT32 u4MnH = 0;
    UINT32 u4XStart = 0, u4XEnd = 0, u4ActiveWidth = 0;
    UINT32 u4SrcAddr, u4DstAddr, u4SrcWBAddr;
    UINT8 *u4IdxTblAddr = p1IdxSA;

    GFX_HW_FX_ENTRY;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId]);
    u4SrcWBAddr = u4SrcAddr;
    u4SrcAddr += (u4SrcX % 2) << 2;
    u4IdxTblAddr += ((((u4PacketWidth + 1) << 1) + 15) & ~15) * u4SrcY;

    REG(u4GfxHwId, fg_DST_BSAD)   = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)   = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WBBSAD) = GFX_PHYSICAL(u4SrcWBAddr);
    REG(u4GfxHwId, fg_DST_WBBSAD) = GFX_PHYSICAL(u4DstAddr);
    //REG(u4GfxHwId, fg_INDEX_BASD) = GFX_PHYSICAL(u4IdxTblAddr);//p1IdxSA);

    // calculate m n ratio for scale up and down
    if ((u4DstW == u4SrcW) || (u4DstW == 1))
    {
        u4MnH = 0x00010000;
        u4SrcW = u4DstW;
    }
    else if (u4SrcW > u4DstW)    // scale down
    {
        u4MnH = (u4SrcW << 16) / (u4DstW - 1);  /* m/(n-1) */
        if (((u4SrcW << 16) % (u4DstW - 1)) == 0)
        {
            u4MnH--;  /* replace m/(n-1) with m/(n-1)-2e-16, hardware limitation */
        }
    }
    else /* scale up (u4DstW > u4SrcW) */
    {
        UINT32 u4Step;

        u4Step = (u4SrcW << 16) / (u4DstW);
        if ((u4Step * (u4DstW - 1)) < ((u4SrcW - 1) << 16))
        {
            u4MnH = (u4SrcW << 16) / (u4DstW - 1);
            if (u4MnH == 0x10000)
            {
                u4MnH--;
            }
        }
        else
        {
            u4MnH = u4Step;
        }
    }

    if ((u4DstH == u4SrcH) || (u4DstH == 1))
    {
        u4MnV = 0x00010000;
        u4SrcH = u4DstH;
    }
    else
    {
        u4MnV = (u4SrcH << 16) / (u4DstH - 1);
        if (u4MnV == 0x00010000)
        {
            u4MnV = (u4SrcH << 16) / (u4DstH);
        }
    }

    u4SrcH -= 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4SrcH & 0x007FF;
    REG(u4GfxHwId, fg_SRC_CM_2)       = (u4SrcH >> 11) & 0x0F;
    REG(u4GfxHwId, fg_SRC_HEIGHT_15)  = (u4SrcH >> 15) & 0x01;
    REG(u4GfxHwId, fg_SRC_HEIGHT_19_16) = (u4SrcH >> 16) & 0x0F;

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_STRETCH_BITBLT;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    //REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4SrcH - 1);
    REG(u4GfxHwId, fg_STR_DST_WIDTH)  = u4DstW;
    REG(u4GfxHwId, fg_STR_DST_HEIGHT) = (u4DstH - 1);
    REG(u4GfxHwId, fg_STR_BLT_H)      = u4MnH;
    REG(u4GfxHwId, fg_STR_BLT_V)      = u4MnV;

    REG(u4GfxHwId, fg_LINE_SEPRATE)      = 0;
    REG(u4GfxHwId, fg_ROLL_BACK_EN)      = 0;
    REG(u4GfxHwId, fg_PIXEL_SEPARATE)    = 1;
    REG(u4GfxHwId, fg_DEC_ENA)           = 1;
    REG(u4GfxHwId, fg_DEC_MODE)          = 2;
    REG(u4GfxHwId, fg_QUALITY_MODE)      = u4QulityMode;
    REG(u4GfxHwId, fg_PIXEL_WIDTH)       = u4PixelWidth >> 3;
    REG(u4GfxHwId, fg_PACKET_WIDTH)      = u4PacketWidth;

    u4XStart = u4SrcX / u4PixelWidth;
    u4XEnd = (u4SrcX + u4SrcW - 1) / u4PixelWidth;
    u4ActiveWidth = u4XEnd - u4XStart + 1;

    UTIL_Printf("[GFX] u4XStart=%d, u4XEnd=%d, u4ActiveWidth=%d, u4ActiveWidth * u4PixelWidth=%d\n",
                 u4XStart, u4XEnd, u4ActiveWidth, u4ActiveWidth * u4PixelWidth);
     
    //REG(u4GfxHwId, fg_LINE_WIDTH)          = u4ActiveWidth * u4PixelWidth;
    REG(u4GfxHwId, fg_SRCX)                = u4SrcX;
    REG(u4GfxHwId, fg_SRCY)                = u4SrcY;
    REG(u4GfxHwId, fg_PACKET_X_START)      = u4XStart;
    REG(u4GfxHwId, fg_PACKET_ACTIVE_WIDTH) = u4ActiveWidth;

    // Maxnium Address
    REG(u4GfxHwId, fg_BPCOMP_AD_END) = 0x3fff0000;  // not care?

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_WBBSAD_H, u4SrcWBAddr);
    VA_MSB_REG(u4GfxHwId, fg_DST_WBBSAD_H, u4DstAddr);
    //VA_MSB_REG(u4GfxHwId, fg_BPCOMP_AD_END_H, u4DstAddr);
    //VA_MSB_REG(u4GfxHwId, fg_INDEX_BASD_H, u4IdxTblAddr);//p1IdxSA);
    VA_PAL_MSB_REG(u4GfxHwId, fg_INDEX_BASD_H, u4IdxTblAddr);//pu1DstIdxAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_PGIG)         |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END)  |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_DST_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_STR_BLT_H)      |
        GFX_CMDENQ(u4GfxHwId, GREG_STR_BLT_V)      |
        GFX_CMDENQ(u4GfxHwId, GREG_STR_DST_SIZE)   |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E0)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E4)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E8)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40EC)         |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_XY)         |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    REG(u4GfxHwId, fg_SRC_CM_2) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = 0;
    REG(u4GfxHwId, fg_PIXEL_WIDTH)       = 0;
    REG(u4GfxHwId, fg_PACKET_WIDTH)      = 0;
    REG(u4GfxHwId, fg_BPCOMP_AD_END)  = 0;
    REG(u4GfxHwId, fg_DEC_MODE)          = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
    GFX_CMDENQ(u4GfxHwId, GREG_G_PGIG);
    GFX_CMDENQ(u4GfxHwId, GREG_0x40E0);
    GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END);
    GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
    REG(u4GfxHwId, fg_DEC_ENA) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);

    GFX_SetLosslessMultiRegionEnable(u4GfxHwId, 0);
    return (INT32)E_GFX_OK;
}

INT32 GFX_LosslessDecodeStretchCompose(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                                       UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH, UINT32 u4AlcomNormal, UINT32 u4Ar, UINT32 u4OpCode,
                                       UINT32 u4RectSrc, UINT32 u4PicWidth, UINT32 u4PicHeight, UINT32 u4PixelWidth,
                                       UINT32 u4PacketWidth, UINT32 u4QulityMode, UINT8 *p1IdxSA)
{
    UINT32 u4XStart = 0, u4XEnd = 0, u4ActiveWidth = 0;
    UINT32 u4SrcAddr, u4DstAddr, u4SrcWBAddr;
    UINT8 *u4IdxTblAddr = p1IdxSA;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId]);
    u4SrcWBAddr = u4SrcAddr;
    u4SrcAddr += (u4SrcX % 2) << 2;
    u4IdxTblAddr += ((((u4PacketWidth + 1) << 1) + 15) & ~15) * u4SrcY;

    REG(u4GfxHwId, fg_DST_BSAD)   = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)   = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WBBSAD) = GFX_PHYSICAL(u4SrcWBAddr);
    REG(u4GfxHwId, fg_DST_WBBSAD) = GFX_PHYSICAL(u4DstAddr);
    //REG(u4GfxHwId, fg_INDEX_BASD) = GFX_PHYSICAL(u4IdxTblAddr);//p1IdxSA);
    
#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 1;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    // Stretch part:
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlcomNormal, u4Ar, u4OpCode, u4RectSrc);

    //

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_STRETCH_LOOP_ALPHA_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    // set src height
    u4SrcH -= 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4SrcH & 0x007FF;
    REG(u4GfxHwId, fg_SRC_CM_2)       = (u4SrcH >> 11) & 0x0F;
    REG(u4GfxHwId, fg_SRC_HEIGHT_15)  = (u4SrcH >> 15) & 0x01;
    REG(u4GfxHwId, fg_SRC_HEIGHT_19_16) = (u4SrcH >> 16) & 0x0F;

    REG(u4GfxHwId, fg_LINE_SEPRATE)      = 0;
    REG(u4GfxHwId, fg_ROLL_BACK_EN)      = 0;
    REG(u4GfxHwId, fg_PIXEL_SEPARATE)    = 1;
    REG(u4GfxHwId, fg_DEC_ENA)           = 1;
    REG(u4GfxHwId, fg_DEC_MODE)          = 2;
    REG(u4GfxHwId, fg_QUALITY_MODE)      = u4QulityMode;
    REG(u4GfxHwId, fg_PIXEL_WIDTH)       = u4PixelWidth >> 3;
    REG(u4GfxHwId, fg_PACKET_WIDTH)      = u4PacketWidth;

    u4XStart = u4SrcX / u4PixelWidth;
    u4XEnd = (u4SrcX + u4SrcW - 1) / u4PixelWidth;
    u4ActiveWidth = u4XEnd - u4XStart + 1;

    UTIL_Printf("[GFX] u4XStart=%d, u4XEnd=%d, u4ActiveWidth=%d, u4ActiveWidth * u4PixelWidth=%d\n",
                u4XStart, u4XEnd, u4ActiveWidth, u4ActiveWidth * u4PixelWidth);

    //REG(u4GfxHwId, fg_LINE_WIDTH)          = u4ActiveWidth * u4PixelWidth;
    REG(u4GfxHwId, fg_SRCX)                = u4SrcX;
    REG(u4GfxHwId, fg_SRCY)                = u4SrcY;
    REG(u4GfxHwId, fg_PACKET_X_START)      = u4XStart;
    REG(u4GfxHwId, fg_PACKET_ACTIVE_WIDTH) = u4ActiveWidth;

    // Maxnium Address
    REG(u4GfxHwId, fg_BPCOMP_AD_END) = 0x3fff0000;  // not care?

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_WBBSAD_H, u4SrcWBAddr);
    VA_MSB_REG(u4GfxHwId, fg_DST_WBBSAD_H, u4DstAddr);
    //VA_MSB_REG(u4GfxHwId, fg_BPCOMP_AD_END_H, u4DstAddr);
    VA_PAL_MSB_REG(u4GfxHwId, fg_INDEX_BASD_H, p1IdxSA);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_PGIG)         |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END)  |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_DST_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E0)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E4)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E8)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40EC)         |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_XY)         |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        REG(u4GfxHwId, fg_SRC_CM_2) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
        REG(u4GfxHwId, fg_DEC_ENA) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
    #ifdef GFX_SUPPORT_DIFF_CM
        //REG(u4GfxHwId, fg_DIFF_CM) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
    #endif
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    REG(u4GfxHwId, fg_SRC_CM_2) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
    REG(u4GfxHwId, fg_DEC_ENA) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    GFX_SetLosslessMultiRegionEnable(u4GfxHwId, 0);

    return (E_GFX_OK);
}

INT32 GFX_LosslessDecodeStretchFlipCompose(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                                       UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH, UINT32 u4AlcomNormal, UINT32 u4Ar, UINT32 u4OpCode,
                                       UINT32 u4RectSrc, UINT32 u4PicWidth, UINT32 u4PicHeight, UINT32 u4PixelWidth,
                                       UINT32 u4PacketWidth, UINT32 u4QulityMode, UINT8 *p1IdxSA)
{
    UINT32 u4XStart = 0, u4XEnd = 0, u4ActiveWidth = 0;
    UINT32 u4SrcAddr, u4DstAddr, u4SrcWBAddr;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId]);
    u4SrcWBAddr = u4SrcAddr;
    u4SrcAddr += (u4SrcX % 2) << 2;

    REG(u4GfxHwId, fg_DST_BSAD)   = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)   = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WBBSAD) = GFX_PHYSICAL(u4SrcWBAddr);

#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 1;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    // Mirror/Flip part
    GFX_SetMirrorFlipOpt(u4GfxHwId, E_BITBLT_SRC_FLIP);

    // Stretch part:
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlcomNormal, u4Ar, u4OpCode, u4RectSrc);

    //
    //REG(u4GfxHwId, fg_INDEX_BASD) = GFX_PHYSICAL((UINT32)p1IdxSA);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_STRETCH_LOOP_ALPHA_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    // set src height
    u4SrcH -= 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4SrcH & 0x007FF;
    REG(u4GfxHwId, fg_SRC_CM_2)       = (u4SrcH >> 11) & 0x0F;
    REG(u4GfxHwId, fg_SRC_HEIGHT_15)  = (u4SrcH >> 15) & 0x01;
    REG(u4GfxHwId, fg_SRC_HEIGHT_19_16) = (u4SrcH >> 16) & 0x0F;

    REG(u4GfxHwId, fg_LINE_SEPRATE)      = 0;
    REG(u4GfxHwId, fg_ROLL_BACK_EN)      = 0;
    REG(u4GfxHwId, fg_PIXEL_SEPARATE)    = 1;
    REG(u4GfxHwId, fg_DEC_ENA)           = 1;
    REG(u4GfxHwId, fg_DEC_MODE)          = 2;
    REG(u4GfxHwId, fg_QUALITY_MODE)      = u4QulityMode;
    REG(u4GfxHwId, fg_PIXEL_WIDTH)       = u4PixelWidth >> 3;
    REG(u4GfxHwId, fg_PACKET_WIDTH)      = u4PacketWidth;

    u4XStart = u4SrcX / u4PixelWidth;
    u4XEnd = (u4SrcX + u4SrcW - 1) / u4PixelWidth;
    u4ActiveWidth = u4XEnd - u4XStart + 1;

    //REG(u4GfxHwId, fg_LINE_WIDTH)          = u4ActiveWidth * u4PixelWidth;
    REG(u4GfxHwId, fg_SRCX)                = u4SrcX;
    REG(u4GfxHwId, fg_SRCY)                = u4SrcY;
    REG(u4GfxHwId, fg_PACKET_X_START)      = u4XStart;
    REG(u4GfxHwId, fg_PACKET_ACTIVE_WIDTH) = u4ActiveWidth;

    // Maxnium Address
    REG(u4GfxHwId, fg_BPCOMP_AD_END) = 0x3fff0000;  // not care?

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_WBBSAD_H, u4SrcWBAddr);
    //VA_MSB_REG(u4GfxHwId, fg_BPCOMP_AD_END_H, u4DstAddr);
    VA_PAL_MSB_REG(u4GfxHwId, fg_INDEX_BASD_H, p1IdxSA);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_PGIG)         |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END)  |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E0)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E4)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E8)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40EC)         |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_XY)         |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        ResetMirrorFlipFlag(u4GfxHwId);
        REG(u4GfxHwId, fg_SRC_CM_2) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
        REG(u4GfxHwId, fg_DEC_ENA) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
    #ifdef GFX_SUPPORT_DIFF_CM
        //REG(u4GfxHwId, fg_DIFF_CM) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
    #endif
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetMirrorFlipFlag(u4GfxHwId);
    REG(u4GfxHwId, fg_SRC_CM_2) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
    REG(u4GfxHwId, fg_DEC_ENA) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    return (E_GFX_OK);
}

INT32 GFX_LosslessDecodeStretchRotateCompose(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                                             UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH, UINT32 u4AlcomNormal, UINT32 u4Ar, UINT32 u4OpCode,
                                             UINT32 u4RectSrc, UINT32 u4Is90CCW, UINT32 u4PicWidth, UINT32 u4PicHeight, UINT32 u4PixelWidth,
                                             UINT32 u4PacketWidth, UINT32 u4QulityMode, UINT8 *p1IdxSA)
{
    UINT32 u4XStart = 0, u4XEnd = 0, u4ActiveWidth = 0;
    UINT32 u4SrcAddr, u4DstAddr, u4SrcWBAddr;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId]);
    u4SrcWBAddr = u4SrcAddr;
    u4SrcAddr += (u4SrcX % 2) << 2;

    REG(u4GfxHwId, fg_DST_BSAD)   = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)   = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WBBSAD) = GFX_PHYSICAL(u4SrcWBAddr);

#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 1;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    // Rotate part
    SetRotateRd(u4GfxHwId, TRUE);
    GFX_SetRotateOpt(u4GfxHwId, TRUE, u4Is90CCW);

    // Stretch part:
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlcomNormal, u4Ar, u4OpCode, u4RectSrc);

    //
    //REG(u4GfxHwId, fg_INDEX_BASD) = GFX_PHYSICAL(p1IdxSA);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_STRETCH_ROTATE_LOOP_ALPHA_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    // set src height
    u4SrcH -= 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4SrcH & 0x007FF;
    REG(u4GfxHwId, fg_SRC_CM_2)       = (u4SrcH >> 11) & 0x0F;
    REG(u4GfxHwId, fg_SRC_HEIGHT_15)  = (u4SrcH >> 15) & 0x01;
    REG(u4GfxHwId, fg_SRC_HEIGHT_19_16) = (u4SrcH >> 16) & 0x0F;

    REG(u4GfxHwId, fg_LINE_SEPRATE)      = 0;
    REG(u4GfxHwId, fg_ROLL_BACK_EN)      = 0;
    REG(u4GfxHwId, fg_PIXEL_SEPARATE)    = 1;
    REG(u4GfxHwId, fg_DEC_ENA)           = 1;
    REG(u4GfxHwId, fg_DEC_MODE)          = 2;
    REG(u4GfxHwId, fg_QUALITY_MODE)      = u4QulityMode;
    REG(u4GfxHwId, fg_PIXEL_WIDTH)       = u4PixelWidth >> 3;
    REG(u4GfxHwId, fg_PACKET_WIDTH)      = u4PacketWidth;

    u4XStart = u4SrcX / u4PixelWidth;
    u4XEnd = (u4SrcX + u4SrcW - 1) / u4PixelWidth;
    u4ActiveWidth = u4XEnd - u4XStart + 1;

    //REG(u4GfxHwId, fg_LINE_WIDTH)          = u4ActiveWidth * u4PixelWidth;
    REG(u4GfxHwId, fg_SRCX)                = u4SrcX;
    REG(u4GfxHwId, fg_SRCY)                = u4SrcY;
    REG(u4GfxHwId, fg_PACKET_X_START)      = u4XStart;
    REG(u4GfxHwId, fg_PACKET_ACTIVE_WIDTH) = u4ActiveWidth;

    // Maxnium Address
    REG(u4GfxHwId, fg_BPCOMP_AD_END) = 0x3fff0000;  // not care?

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_WBBSAD_H, u4SrcWBAddr);
    //VA_MSB_REG(u4GfxHwId, fg_BPCOMP_AD_END_H, u4DstAddr);
    VA_PAL_MSB_REG(u4GfxHwId, fg_INDEX_BASD_H, p1IdxSA);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_PGIG)         |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END)  |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E0)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E4)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E8)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40EC)         |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_XY)         |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        REG(u4GfxHwId, fg_SRC_CM_2) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
        REG(u4GfxHwId, fg_DEC_ENA) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
    #ifdef GFX_SUPPORT_DIFF_CM
        //REG(u4GfxHwId, fg_DIFF_CM) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
    #endif
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetRotateFlag(u4GfxHwId);
    REG(u4GfxHwId, fg_SRC_CM_2) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
    REG(u4GfxHwId, fg_DEC_ENA) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    return (E_GFX_OK);
}

INT32 GFX_LosslessDecodeStretchRotateFlipCompose(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
            UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH, UINT32 u4AlcomNormal, UINT32 u4Ar, UINT32 u4OpCode,
            UINT32 u4RectSrc, UINT32 u4Is90CCW, UINT32 u4PicWidth, UINT32 u4PicHeight, UINT32 u4PixelWidth,
            UINT32 u4PacketWidth, UINT32 u4QulityMode, UINT8 *p1IdxSA)
{
    UINT32 u4XStart = 0, u4XEnd = 0, u4ActiveWidth = 0;
    UINT32 u4SrcAddr, u4DstAddr, u4SrcWBAddr;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId]);
    u4SrcWBAddr = u4SrcAddr;
    u4SrcAddr += (u4SrcX % 2) << 2;

    REG(u4GfxHwId, fg_DST_BSAD)   = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)   = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WBBSAD) = GFX_PHYSICAL(u4SrcWBAddr);

#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 1;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    // Mirror/Flip part
    GFX_SetMirrorFlipOpt(u4GfxHwId, E_BITBLT_SRC_FLIP);

    // Rotate part
    SetRotateRd(u4GfxHwId, TRUE);
    GFX_SetRotateOpt(u4GfxHwId, TRUE, u4Is90CCW);

    // Stretch part:
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlcomNormal, u4Ar, u4OpCode, u4RectSrc);

    //
    //REG(u4GfxHwId, fg_INDEX_BASD) = GFX_PHYSICAL(p1IdxSA);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_STRETCH_ROTATE_LOOP_ALPHA_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    // set src height
    u4SrcH -= 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4SrcH & 0x007FF;
    REG(u4GfxHwId, fg_SRC_CM_2)       = (u4SrcH >> 11) & 0x0F;
    REG(u4GfxHwId, fg_SRC_HEIGHT_15)  = (u4SrcH >> 15) & 0x01;
    REG(u4GfxHwId, fg_SRC_HEIGHT_19_16) = (u4SrcH >> 16) & 0x0F;

    REG(u4GfxHwId, fg_LINE_SEPRATE)      = 0;
    REG(u4GfxHwId, fg_ROLL_BACK_EN)      = 0;
    REG(u4GfxHwId, fg_PIXEL_SEPARATE)    = 1;
    REG(u4GfxHwId, fg_DEC_ENA)           = 1;
    REG(u4GfxHwId, fg_DEC_MODE)          = 2;
    REG(u4GfxHwId, fg_QUALITY_MODE)      = u4QulityMode;
    REG(u4GfxHwId, fg_PIXEL_WIDTH)       = u4PixelWidth >> 3;
    REG(u4GfxHwId, fg_PACKET_WIDTH)      = u4PacketWidth;

    u4XStart = u4SrcX / u4PixelWidth;
    u4XEnd = (u4SrcX + u4SrcW - 1) / u4PixelWidth;
    u4ActiveWidth = u4XEnd - u4XStart + 1;

    //REG(u4GfxHwId, fg_LINE_WIDTH)          = u4ActiveWidth * u4PixelWidth;
    REG(u4GfxHwId, fg_SRCX)                = u4SrcX;
    REG(u4GfxHwId, fg_SRCY)                = u4SrcY;
    REG(u4GfxHwId, fg_PACKET_X_START)      = u4XStart;
    REG(u4GfxHwId, fg_PACKET_ACTIVE_WIDTH) = u4ActiveWidth;

    // Maxnium Address
    REG(u4GfxHwId, fg_BPCOMP_AD_END) = 0x3fff0000;  // not care?

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_WBBSAD_H, u4SrcWBAddr);
    //VA_MSB_REG(u4GfxHwId, fg_BPCOMP_AD_END_H, u4DstAddr);
    VA_PAL_MSB_REG(u4GfxHwId, fg_INDEX_BASD_H, p1IdxSA);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_PGIG)         |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END)  |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E0)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E4)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E8)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40EC)         |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_XY)         |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        REG(u4GfxHwId, fg_SRC_CM_2) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
        REG(u4GfxHwId, fg_DEC_ENA) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
    #ifdef GFX_SUPPORT_DIFF_CM
        //REG(u4GfxHwId, fg_DIFF_CM) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
    #endif
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetRotateMirrorFlipFlag(u4GfxHwId);
    REG(u4GfxHwId, fg_SRC_CM_2) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
    REG(u4GfxHwId, fg_DEC_ENA) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    return (E_GFX_OK);
}

INT32 GFX_LosslessDecodeStretchJavaXor(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                                       UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH, UINT32 u4JavaXorColor,
                                       UINT32 u4PicWidth, UINT32 u4PicHeight, UINT32 u4PixelWidth,
                                       UINT32 u4PacketWidth, UINT32 u4QulityMode, UINT8 *p1IdxSA)
{
    UINT32 u4XStart = 0, u4XEnd = 0, u4ActiveWidth = 0;
    UINT32 u4SrcAddr, u4DstAddr, u4SrcWBAddr;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId]);
    u4SrcWBAddr = u4SrcAddr;
    u4SrcAddr += (u4SrcX % 2) << 2;

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WBBSAD) = GFX_PHYSICAL(u4SrcWBAddr);

#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 1;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    // Stretch part
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Java XOR part
    GFX_SetJavaXorOpt(u4GfxHwId, u4JavaXorColor);

    //
    //REG(u4GfxHwId, fg_INDEX_BASD) = GFX_PHYSICAL(p1IdxSA);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_STRETCH_JAVA_XOR;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    // set src height
    u4SrcH -= 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4SrcH & 0x007FF;
    REG(u4GfxHwId, fg_SRC_CM_2)       = (u4SrcH >> 11) & 0x0F;
    REG(u4GfxHwId, fg_SRC_HEIGHT_15)  = (u4SrcH >> 15) & 0x01;
    REG(u4GfxHwId, fg_SRC_HEIGHT_19_16) = (u4SrcH >> 16) & 0x0F;

    REG(u4GfxHwId, fg_LINE_SEPRATE)      = 0;
    REG(u4GfxHwId, fg_ROLL_BACK_EN)      = 0;
    REG(u4GfxHwId, fg_PIXEL_SEPARATE)    = 1;
    REG(u4GfxHwId, fg_DEC_ENA)           = 1;
    REG(u4GfxHwId, fg_DEC_MODE)          = 2;
    REG(u4GfxHwId, fg_QUALITY_MODE)      = u4QulityMode;
    REG(u4GfxHwId, fg_PIXEL_WIDTH)       = u4PixelWidth >> 3;
    REG(u4GfxHwId, fg_PACKET_WIDTH)      = u4PacketWidth;

    u4XStart = u4SrcX / u4PixelWidth;
    u4XEnd = (u4SrcX + u4SrcW - 1) / u4PixelWidth;
    u4ActiveWidth = u4XEnd - u4XStart + 1;

    //REG(u4GfxHwId, fg_LINE_WIDTH)          = u4ActiveWidth * u4PixelWidth;
    REG(u4GfxHwId, fg_SRCX)                = u4SrcX;
    REG(u4GfxHwId, fg_SRCY)                = u4SrcY;
    REG(u4GfxHwId, fg_PACKET_X_START)      = u4XStart;
    REG(u4GfxHwId, fg_PACKET_ACTIVE_WIDTH) = u4ActiveWidth;

    // Maxnium Address
    REG(u4GfxHwId, fg_BPCOMP_AD_END) = 0x3fff0000;  // not care?

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_WBBSAD_H, u4SrcWBAddr);
    //VA_MSB_REG(u4GfxHwId, fg_BPCOMP_AD_END_H, u4DstAddr);
    VA_PAL_MSB_REG(u4GfxHwId, fg_INDEX_BASD_H, p1IdxSA);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_PGIG)         |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END)  |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E0)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E4)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E8)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40EC)         |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_XY)         |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        REG(u4GfxHwId, fg_SRC_CM_2) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
        REG(u4GfxHwId, fg_DEC_ENA) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
    #ifdef GFX_SUPPORT_DIFF_CM
        //REG(u4GfxHwId, fg_DIFF_CM) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
    #endif
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    REG(u4GfxHwId, fg_SRC_CM_2) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
    REG(u4GfxHwId, fg_DEC_ENA) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    return (E_GFX_OK);
}

INT32 GFX_LosslessDecodeStretchFlipJavaXor(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                                       UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH, UINT32 u4JavaXorColor,
                                       UINT32 u4PicWidth, UINT32 u4PicHeight, UINT32 u4PixelWidth,
                                       UINT32 u4PacketWidth, UINT32 u4QulityMode, UINT8 *p1IdxSA)
{
    UINT32 u4XStart = 0, u4XEnd = 0, u4ActiveWidth = 0;
    UINT32 u4SrcAddr, u4DstAddr, u4SrcWBAddr;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId]);
    u4SrcWBAddr = u4SrcAddr;
    u4SrcAddr += (u4SrcX % 2) << 2;

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WBBSAD) = GFX_PHYSICAL(u4SrcWBAddr);

#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 1;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    // Mirror/Flip part
    GFX_SetMirrorFlipOpt(u4GfxHwId, E_BITBLT_SRC_FLIP);

    // Stretch part
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Java XOR part
    GFX_SetJavaXorOpt(u4GfxHwId, u4JavaXorColor);

    //
    //REG(u4GfxHwId, fg_INDEX_BASD) = GFX_PHYSICAL((UINT32)p1IdxSA);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_STRETCH_JAVA_XOR;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    // set src height
    u4SrcH -= 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4SrcH & 0x007FF;
    REG(u4GfxHwId, fg_SRC_CM_2)       = (u4SrcH >> 11) & 0x0F;
    REG(u4GfxHwId, fg_SRC_HEIGHT_15)  = (u4SrcH >> 15) & 0x01;
    REG(u4GfxHwId, fg_SRC_HEIGHT_19_16) = (u4SrcH >> 16) & 0x0F;

    REG(u4GfxHwId, fg_LINE_SEPRATE)      = 0;
    REG(u4GfxHwId, fg_ROLL_BACK_EN)      = 0;
    REG(u4GfxHwId, fg_PIXEL_SEPARATE)    = 1;
    REG(u4GfxHwId, fg_DEC_ENA)           = 1;
    REG(u4GfxHwId, fg_DEC_MODE)          = 2;
    REG(u4GfxHwId, fg_QUALITY_MODE)      = u4QulityMode;
    REG(u4GfxHwId, fg_PIXEL_WIDTH)       = u4PixelWidth >> 3;
    REG(u4GfxHwId, fg_PACKET_WIDTH)      = u4PacketWidth;

    u4XStart = u4SrcX / u4PixelWidth;
    u4XEnd = (u4SrcX + u4SrcW - 1) / u4PixelWidth;
    u4ActiveWidth = u4XEnd - u4XStart + 1;

    //REG(u4GfxHwId, fg_LINE_WIDTH)          = u4ActiveWidth * u4PixelWidth;
    REG(u4GfxHwId, fg_SRCX)                = u4SrcX;
    REG(u4GfxHwId, fg_SRCY)                = u4SrcY;
    REG(u4GfxHwId, fg_PACKET_X_START)      = u4XStart;
    REG(u4GfxHwId, fg_PACKET_ACTIVE_WIDTH) = u4ActiveWidth;

    // Maxnium Address
    REG(u4GfxHwId, fg_BPCOMP_AD_END) = 0x3fff0000;  // not care?

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_WBBSAD_H, u4SrcWBAddr);
    //VA_MSB_REG(u4GfxHwId, fg_BPCOMP_AD_END_H, u4DstAddr);
    VA_PAL_MSB_REG(u4GfxHwId, fg_INDEX_BASD_H, p1IdxSA);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_PGIG)         |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END)  |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E0)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E4)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E8)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40EC)         |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_XY)         |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        REG(u4GfxHwId, fg_SRC_CM_2) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
        REG(u4GfxHwId, fg_DEC_ENA) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
    #ifdef GFX_SUPPORT_DIFF_CM
        //REG(u4GfxHwId, fg_DIFF_CM) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
    #endif
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetMirrorFlipFlag(u4GfxHwId);
    REG(u4GfxHwId, fg_SRC_CM_2) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
    REG(u4GfxHwId, fg_DEC_ENA) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    return (E_GFX_OK);
}

INT32 GFX_LosslessDecodeStretchRotateJavaXor(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                                             UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH,
                                             UINT32 u4JavaXorColor, UINT32 u4Is90CCW,
                                             UINT32 u4PicWidth, UINT32 u4PicHeight, UINT32 u4PixelWidth,
                                             UINT32 u4PacketWidth, UINT32 u4QulityMode, UINT8 *p1IdxSA)
{
    UINT32 u4XStart = 0, u4XEnd = 0, u4ActiveWidth = 0;
    UINT32 u4SrcAddr, u4DstAddr, u4SrcWBAddr;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId]);
    u4SrcWBAddr = u4SrcAddr;
    u4SrcAddr += (u4SrcX % 2) << 2;

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WBBSAD) = GFX_PHYSICAL(u4SrcWBAddr);

#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 1;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    // Rotate part
    SetRotateRd(u4GfxHwId, TRUE);
    GFX_SetRotateOpt(u4GfxHwId, TRUE, u4Is90CCW);

    // Stretch part
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Java XOR part
    GFX_SetJavaXorOpt(u4GfxHwId, u4JavaXorColor);

    //
    //REG(u4GfxHwId, fg_INDEX_BASD) = GFX_PHYSICAL(p1IdxSA);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_STRETCH_ROTATE_JAVA_XOR;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    // set src height
    u4SrcH -= 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4SrcH & 0x007FF;
    REG(u4GfxHwId, fg_SRC_CM_2)       = (u4SrcH >> 11) & 0x0F;
    REG(u4GfxHwId, fg_SRC_HEIGHT_15)  = (u4SrcH >> 15) & 0x01;
    REG(u4GfxHwId, fg_SRC_HEIGHT_19_16) = (u4SrcH >> 16) & 0x0F;

    REG(u4GfxHwId, fg_LINE_SEPRATE)      = 0;
    REG(u4GfxHwId, fg_ROLL_BACK_EN)      = 0;
    REG(u4GfxHwId, fg_PIXEL_SEPARATE)    = 1;
    REG(u4GfxHwId, fg_DEC_ENA)           = 1;
    REG(u4GfxHwId, fg_DEC_MODE)          = 2;
    REG(u4GfxHwId, fg_QUALITY_MODE)      = u4QulityMode;
    REG(u4GfxHwId, fg_PIXEL_WIDTH)       = u4PixelWidth >> 3;
    REG(u4GfxHwId, fg_PACKET_WIDTH)      = u4PacketWidth;

    u4XStart = u4SrcX / u4PixelWidth;
    u4XEnd = (u4SrcX + u4SrcW - 1) / u4PixelWidth;
    u4ActiveWidth = u4XEnd - u4XStart + 1;

    //REG(u4GfxHwId, fg_LINE_WIDTH)          = u4ActiveWidth * u4PixelWidth;
    REG(u4GfxHwId, fg_SRCX)                = u4SrcX;
    REG(u4GfxHwId, fg_SRCY)                = u4SrcY;
    REG(u4GfxHwId, fg_PACKET_X_START)      = u4XStart;
    REG(u4GfxHwId, fg_PACKET_ACTIVE_WIDTH) = u4ActiveWidth;

    // Maxnium Address
    REG(u4GfxHwId, fg_BPCOMP_AD_END) = 0x3fff0000;  // not care?

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_WBBSAD_H, u4SrcWBAddr);
    //VA_MSB_REG(u4GfxHwId, fg_BPCOMP_AD_END_H, u4DstAddr);
    VA_PAL_MSB_REG(u4GfxHwId, fg_INDEX_BASD_H, p1IdxSA);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_PGIG)         |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END)  |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E0)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E4)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E8)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40EC)         |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_XY)         |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        REG(u4GfxHwId, fg_SRC_CM_2) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
        REG(u4GfxHwId, fg_DEC_ENA) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
    #ifdef GFX_SUPPORT_DIFF_CM
        //REG(u4GfxHwId, fg_DIFF_CM) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
    #endif
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetRotateFlag(u4GfxHwId);
    REG(u4GfxHwId, fg_SRC_CM_2) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
    REG(u4GfxHwId, fg_DEC_ENA) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    return (E_GFX_OK);
}

INT32 GFX_LosslessDecodeStretchRotateFlipJavaXor(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                                                 UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH,
                                                 UINT32 u4JavaXorColor, UINT32 u4Is90CCW,
                                                 UINT32 u4PicWidth, UINT32 u4PicHeight, UINT32 u4PixelWidth,
                                                 UINT32 u4PacketWidth, UINT32 u4QulityMode, UINT8 *p1IdxSA)
{
    UINT32 u4XStart = 0, u4XEnd = 0, u4ActiveWidth = 0;
    UINT32 u4SrcAddr, u4DstAddr, u4SrcWBAddr;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId]);
    u4SrcWBAddr = u4SrcAddr;
    u4SrcAddr += (u4SrcX % 2) << 2;

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WBBSAD) = GFX_PHYSICAL(u4SrcWBAddr);

#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 1;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif
    // Mirror/Flip part
    GFX_SetMirrorFlipOpt(u4GfxHwId, E_BITBLT_SRC_FLIP);

    // Rotate part
    SetRotateRd(u4GfxHwId, TRUE);
    GFX_SetRotateOpt(u4GfxHwId, TRUE, u4Is90CCW);

    // Stretch part
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Java XOR part
    GFX_SetJavaXorOpt(u4GfxHwId, u4JavaXorColor);

    //
    //REG(u4GfxHwId, fg_INDEX_BASD) = GFX_PHYSICAL(p1IdxSA);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_STRETCH_ROTATE_JAVA_XOR;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    // set src height
    u4SrcH -= 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4SrcH & 0x007FF;
    REG(u4GfxHwId, fg_SRC_CM_2)       = (u4SrcH >> 11) & 0x0F;
    REG(u4GfxHwId, fg_SRC_HEIGHT_15)  = (u4SrcH >> 15) & 0x01;
    REG(u4GfxHwId, fg_SRC_HEIGHT_19_16) = (u4SrcH >> 16) & 0x0F;

    REG(u4GfxHwId, fg_LINE_SEPRATE)      = 0;
    REG(u4GfxHwId, fg_ROLL_BACK_EN)      = 0;
    REG(u4GfxHwId, fg_PIXEL_SEPARATE)    = 1;
    REG(u4GfxHwId, fg_DEC_ENA)           = 1;
    REG(u4GfxHwId, fg_DEC_MODE)          = 2;
    REG(u4GfxHwId, fg_QUALITY_MODE)      = u4QulityMode;
    REG(u4GfxHwId, fg_PIXEL_WIDTH)       = u4PixelWidth >> 3;
    REG(u4GfxHwId, fg_PACKET_WIDTH)      = u4PacketWidth;

    u4XStart = u4SrcX / u4PixelWidth;
    u4XEnd = (u4SrcX + u4SrcW - 1) / u4PixelWidth;
    u4ActiveWidth = u4XEnd - u4XStart + 1;

    //REG(u4GfxHwId, fg_LINE_WIDTH)          = u4ActiveWidth * u4PixelWidth;
    REG(u4GfxHwId, fg_SRCX)                = u4SrcX;
    REG(u4GfxHwId, fg_SRCY)                = u4SrcY;
    REG(u4GfxHwId, fg_PACKET_X_START)      = u4XStart;
    REG(u4GfxHwId, fg_PACKET_ACTIVE_WIDTH) = u4ActiveWidth;

    // Maxnium Address
    REG(u4GfxHwId, fg_BPCOMP_AD_END) = 0x3fff0000;  // not care?

    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_WBBSAD_H, u4SrcWBAddr);
    //VA_MSB_REG(u4GfxHwId, fg_BPCOMP_AD_END_H, u4DstAddr);
    VA_PAL_MSB_REG(u4GfxHwId, fg_INDEX_BASD_H, p1IdxSA);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_PGIG)         |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_AD_END)  |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_WBBSAD)     |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E0)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E4)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40E8)         |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40EC)         |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_XY)         |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        REG(u4GfxHwId, fg_SRC_CM_2) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
        REG(u4GfxHwId, fg_DEC_ENA) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
    #ifdef GFX_SUPPORT_DIFF_CM
        //REG(u4GfxHwId, fg_DIFF_CM) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
    #endif
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetRotateMirrorFlipFlag(u4GfxHwId);
    REG(u4GfxHwId, fg_SRC_CM_2) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
    REG(u4GfxHwId, fg_DEC_ENA) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BPCOMP_CFG);
#ifdef GFX_SUPPORT_DIFF_CM
    //REG(u4GfxHwId, fg_DIFF_CM) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#endif

    return (E_GFX_OK);
}

INT32 GFX_SetRacingMode(UINT32 u4GfxHwId, UINT32 u4Mode)
{
    REG(u4GfxHwId, fg_RACING_EN)                = (u4Mode & GFX_RM_EN) > 0;
    REG(u4GfxHwId, fg_RACING_MODE_TEST)         = (u4Mode & GFX_RM_TEST) > 0;
    REG(u4GfxHwId, fg_OSD3_NEXT_RIGHT_DRAW_CMD) = (u4Mode & GFX_RM_OSD3_NEXT_RIGHT_DRAW_CMD) > 0;
    REG(u4GfxHwId, fg_OSD3_NEXT_LEFT_DRAW_CMD)  = (u4Mode & GFX_RM_OSD3_NEXT_LEFT_DRAW_CMD) > 0;
    REG(u4GfxHwId, fg_OSD2_NEXT_RIGHT_DRAW_CMD) = (u4Mode & GFX_RM_OSD2_NEXT_RIGHT_DRAW_CMD) > 0;
    REG(u4GfxHwId, fg_OSD2_NEXT_LEFT_DRAW_CMD)  = (u4Mode & GFX_RM_OSD2_NEXT_LEFT_DRAW_CMD) > 0;
    REG(u4GfxHwId, fg_OSD3_RACING_RIGHT_COMP_EN)= (u4Mode & GFX_RM_OSD3_RACING_RIGHT_COMP_EN) > 0;
    REG(u4GfxHwId, fg_OSD3_RACING_LEFT_COMP_EN) = (u4Mode & GFX_RM_OSD3_RACING_LEFT_COMP_EN) > 0;
    REG(u4GfxHwId, fg_OSD2_RACING_RIGHT_COMP_EN)= (u4Mode & GFX_RM_OSD2_RACING_RIGHT_COMP_EN) > 0;
    REG(u4GfxHwId, fg_OSD2_RACING_LEFT_COMP_EN) = (u4Mode & GFX_RM_OSD2_RACING_LEFT_COMP_EN) > 0;

    return (GFX_CMDENQ(u4GfxHwId, GREG_RACING_MODE));
}

INT32 GFX_MMUEnable(UINT32 u4GfxHwId, UINT32 u4Enable)
{
    volatile UINT32 u4Val = 0;

    // Enable cmdque mode
    if (u4Enable)
    {
        u4Val = u4GfxHwId ? (*(volatile UINT32 *)(IO_BASE_VA + 0x40000)):(*(volatile UINT32 *)(IO_BASE_VA + 0x4000));
        if ((u4Val & 0x00800000) != 0x00800000)
        {
            u4Val |= 0x00800000;
            if (u4GfxHwId)
            {
                *(volatile UINT32 *)(IO_BASE_VA + 0x40000) = u4Val;
            }
            else
            {
                *(volatile UINT32 *)(IO_BASE_VA + 0x4000) = u4Val;
				UTIL_Printf("[GFX]MMU Enable with CMDQ!\n");
            }
        }
    }
    else
    {
        u4Val = u4GfxHwId ? (*(volatile UINT32 *)(IO_BASE_VA + 0x40000)):(*(volatile UINT32 *)(IO_BASE_VA + 0x4000));
        if ((u4Val & 0x00800000) == 0x00800000)
        {
            u4Val &= 0xFF7FFFFF;
            if (u4GfxHwId)
            {
                *(volatile UINT32 *)(IO_BASE_VA + 0x40000) = u4Val;
            }
            else
            {
                *(volatile UINT32 *)(IO_BASE_VA + 0x4000) = u4Val;
				UTIL_Printf("[GFX]MMU Disable without CMDQ!\n");
            }
        }
    }

    // IOMMU_CFG0 = 0xFF / 0xFE
    REG(u4GfxHwId, fg_IOMMU_EN)    = u4Enable;
    REG(u4GfxHwId, fg_TLBLAST)     = 1;
    REG(u4GfxHwId, fg_AUTODISCARD) = 1;
    REG(u4GfxHwId, fg_MIF_ENTRY)   = 1;
    REG(u4GfxHwId, fg_SMT_RESZ)    = 1;
    REG(u4GfxHwId, fg_CFG0_BIT5)   = 1;
    REG(u4GfxHwId, fg_CFG0_BIT6)   = 1;
    REG(u4GfxHwId, fg_CFG0_BIT7)   = 1;

    GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG0);
    if (u4Enable)
    {
        REG(u4GfxHwId, fg_RG_TTB) = u4HalGetTTB0();
        GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG1);
    }

    return (E_GFX_OK);
}

typedef struct {
    UINT32 u4Enable;
    UINT32 u4ID;
    UINT32 u4SrcRead;
    UINT32 u4DstRead;
    UINT32 u4DstWrite;
} GFX_MMU_CFG_T;

GFX_MMU_CFG_T g_Gfx_MMU_Cfg={0,0,0,0,0};

INT32 GFX_MMUEnableEx(UINT32 u4GfxHwId, UINT32 u4Enable)
{

    // IOMMU_CFG0 = 0xFF / 0xFE
    if (g_Gfx_MMU_Cfg.u4Enable != u4Enable)
    {
        REG(u4GfxHwId, fg_IOMMU_EN)    = u4Enable;
        GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG0);
        g_Gfx_MMU_Cfg.u4Enable = u4Enable;
    }

    return (E_GFX_OK);
}

INT32 GFX_MMUCfgA0(UINT32 u4GfxHwId, UINT32 u4En, UINT32 u4Mid, UINT32 u4Prefetch, UINT32 u42DPrefetch,
