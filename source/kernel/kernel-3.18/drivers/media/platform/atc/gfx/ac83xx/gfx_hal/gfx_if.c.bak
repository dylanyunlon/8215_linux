void GFX_EnableClk(void)
{
	clk_prepare_enable(gfxclk);
		
	gfx_parent= clk_get(NULL, "dmpll_ck");


	clk_set_parent(gfxselect, gfx_parent);


	gfx_parent= clk_get_parent(gfxclk);

}

