//-------------------------------------------------------------------------
/** GFX_LockCmdque
 *  use lock_timeout to do gfx engine crash detection
 *  crash cause 1 : engine eats invalid cmd
 *
 */
//-------------------------------------------------------------------------
void GFX_LockCmdque(UINT32 u4GfxHwId)
{
#if (CONFIG_DRV_LINUX) && (0 == GFX_SYNC_OLD_METHOD)
    EV_GRP_EVENT_T eGfxEventGet = GFX_EV_INITIAL;
    INT32   i4EventRet = 0;

    if (_fgGfxDelay[u4GfxHwId] == TRUE)
    {
        x_thread_delay(1);
    }

	UTIL_Printf("[GFX][GFX_LockCmdque]before wait timeout GFX_EV_HW_DONE!!\n");
	
    i4EventRet = x_ev_group_wait_event_timeout(_arGfxDrvInst[u4GfxHwId].hEventHandle,
        GFX_EV_HW_DONE,
        &eGfxEventGet,
        X_EV_OP_OR_CONSUME,
        _u4GfxAllowedBusyTime);
    if ((OSR_OK != i4EventRet) || (!(eGfxEventGet & GFX_EV_HW_DONE)))
    {
        UTIL_Printf("[GFX] GFX_EV_HW_DONE x_ev_group_wait_event_timeout return = %d\n", i4EventRet);
        UTIL_Printf("[GFX] wait GFX_EV_HW_DONE and event result = %x\n", eGfxEventGet);

        if (!GFX_HwGetIdle(u4GfxHwId))
        {
            UTIL_Printf("[GFX] GFX HW busy!!!\n");
            VERIFY(0);
        }
    }
#if CONFIG_LOSSLESS_COMPRESS_AUTO_FLIP_MODE
#if GFX_LOSSLESS_CALLBACK_BDJ_FROM_GFX
    else if (_u4LosslessAutoFlipFlag == 1)
    {
        // call back to BDJ
        //Printf("%s -----> Lossless Done !!!! Call back to BDJ\n", __FUNCTION__);
        vCBAgent_Cb_Nfy(_gfxLosslessFlipCBFct.pf_cb_nfy_fct, _gfxLosslessFlipCBFct.pv_nfy_tag, (void *)(&_gfxLosslessFlipCBInfo), sizeof(OSD_FLIP_CB_INFO_T));
        _u4LosslessAutoFlipFlag = 0;
        //Printf("%s -----> Lossless Done !!!! Call back to BDJ -- end\n", __FUNCTION__);
    }
#endif
#endif
#else
    if (OSR_TIMEOUT ==
        x_sema_lock_timeout(_semGfxCmdque[u4GfxHwId], _u4GfxAllowedBusyTime))
    {
        LOG(1, "GFX engine works too long (300 secs)......\n");

        if (!GFX_HwGetIdle(u4GfxHwId))
        {
            LOG(1, "GFX engine still busy ......\n");

            // recover hw engine
            //GFX_RECOVER_ENGINE();

            /*lint -save -e506 */
            VERIFY(0);
            /*lint -restore */
        }
    }
#endif
}

void GFX_UnlockCmdque(UINT32 u4GfxHwId)
{
#if (CONFIG_DRV_LINUX) && (0 == GFX_SYNC_OLD_METHOD)
    VERIFY(OSR_OK == x_ev_group_set_event(_arGfxDrvInst[u4GfxHwId].hEventHandle, GFX_EV_HW_DONE, X_EV_OP_OR));
#else
    GFX_UNUSED_RET(x_sema_unlock(_semGfxCmdque[u4GfxHwId]))
#endif
}


