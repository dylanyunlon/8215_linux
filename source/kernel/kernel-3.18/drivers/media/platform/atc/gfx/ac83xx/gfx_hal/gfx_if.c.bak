    }
}
#endif

//-------------------------------------------------------------------------
/** GFX_RotateBmp
 *  use "horizontal line to vertical line operation" to
 *  complete this function.
 */
//-------------------------------------------------------------------------
INT32 GFX_RotateBmp(UINT32 u4GfxHwId, UINT8 *pu1SrcBase, UINT8 *pu1DstBase,
    UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4CM, UINT32 u4SrcPitch, UINT32 u4DstPitch,
    UINT32 u4Width, UINT32 u4Height, UINT32 u4Is90CCW)
{
    INT32 i4Ret;
    UINT32 i, u4Dx, u4Dy;
    UINT32 u4Sx = u4SrcX, u4Sy = u4SrcY;
    UINT32 u4WidthStep=2047;
    UINT32 u4WidthFlush;
    //UINT32 u4CMByte=_GetGfxBytrPerPixel(u4CM);
    //if(SwHwSelect==0)  //HW mode is selected
    {
        // set src base address
        i4Ret = GFX_SetSrc(u4GfxHwId, pu1SrcBase, u4CM, u4SrcPitch);
        GFX_CHECK_RET_VALUE(i4Ret);

        // set dst base address
         i4Ret = GFX_SetDst(u4GfxHwId, pu1DstBase, u4CM, u4DstPitch);
         GFX_CHECK_RET_VALUE(i4Ret);

        // set horizontal to vertical line option
        i4Ret = GFX_SetHoriToVertLineOpt(u4GfxHwId, u4Is90CCW);
        GFX_CHECK_RET_VALUE(i4Ret);

    #if 0//CONFIG_ENABLE_IOMMU
        GFX_MMUCfg(u4GfxHwId, 1, 1, 1, 1);
        GFX_MMUOverReadProtection(u4GfxHwId, 1, GFX_MMU_OTHER, (UINT32)pu1SrcBase,
                                  u4SrcPitch * (u4SrcY + u4Height),
                                  (UINT32)pu1DstBase, u4DstPitch * (u4DstY + u4Height));
    #endif

        if (u4Is90CCW == (UINT32)TRUE)
        {
            // rotated by 90" counter-clock-wise

            u4Dx = u4DstX;
            u4Dy = u4DstY;
            while(u4Width!=0)
            {

                u4WidthFlush=(u4Width>u4WidthStep) ? u4WidthStep:u4Width;
                
                UTIL_Printf("[gfx] _GfxRotate90 width=%d, u4Is90CCW = %d\n", u4WidthFlush,u4Is90CCW );
                
                for(i = 0; i < u4Height; i++)
                {
                    i4Ret = GFX_HoriToVertLine(u4GfxHwId, u4Sx, u4Sy++,
                                u4Dx++, u4Dy, u4WidthFlush, u4Is90CCW);
                    GFX_CHECK_RET_VALUE(i4Ret);
                    //GFX_Flush(u4GfxHwId);
                 } // ~for
                 u4Sx+=u4WidthFlush;
                 u4Sy=u4SrcY;
                 u4Dx=u4DstX;
                 u4Dy-=u4WidthFlush;
                 u4Width -=u4WidthFlush;
             }


        }
        else
        {
            // rotated by 90" clock-wise
            u4Dx = u4DstX;//+(u4Height-1);
            u4Dy = u4DstY;//-(u4Width-1);
            while(u4Width!=0)
            {
                u4WidthFlush=(u4Width>u4WidthStep) ? u4WidthStep:u4Width;
                
                UTIL_Printf("[gfx] _GfxRotate90 width = %d, u4Is90CCW = %d\n", u4WidthFlush,u4Is90CCW );
                
                for(i = 0; i < u4Height; i++)
                {
                    i4Ret = GFX_HoriToVertLine(u4GfxHwId, u4Sx, u4Sy++,
                                u4Dx--, u4Dy, u4WidthFlush, u4Is90CCW);
                    GFX_CHECK_RET_VALUE(i4Ret);
                    //GFX_Flush(u4GfxHwId);
                } // ~for
                u4Sy=u4SrcY;
                u4Dx=u4DstX;
                u4Sx+=u4WidthFlush;
                u4Dy+=u4WidthFlush;
                u4Width -=u4WidthFlush;
            }
        }

        // flush and wait
        i4Ret = GFX_Flush(u4GfxHwId);

        REG(u4GfxHwId, fg_DSTPITCH_DEC) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
        GFX_CHECK_RET_VALUE(i4Ret);
    }

    return (INT32)E_GFX_OK;
}

#if 1//(CONFIG_CHIP_VER_CURR >= CONFIG_CHIP_VER_MT8550)
UINT32 Gfx_BytePerPixel(UINT32 u4ColorMode)
{
    switch (u4ColorMode)
    {
    case CM_YCbCr_CLUT8:
    case CM_RGB_CLUT8:
        return 1;

    case CM_CbYCrY422_DIRECT16:
    case CM_YCbYCr422_DIRECT16:
    case CM_RGB565_DIRECT16:
    case CM_ARGB1555_DIRECT16:
    case CM_ARGB4444_DIRECT16:
        return 2;

    case CM_AYCbCr8888_DIRECT32:
    case CM_ARGB8888_DIRECT32:
    default:
        return 4;
    }
}
#endif

//-------------------------------------------------------------------------
/** GFX_RotateBmp
 *  use "horizontal line to vertical line operation" to
 *  complete this function.
 */
//-------------------------------------------------------------------------
INT32 GFX_RotateMirrorFlipBmp(UINT32 u4GfxHwId, UINT8 *pu1SrcBase, UINT8 *pu1DstBase,
    UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4CM, UINT32 u4SrcPitch, UINT32 u4DstPitch,
    UINT32 u4Width, UINT32 u4Height, UINT32 u4Is90CCW,UINT8 u1AddOpt)
{
    INT32 i4Ret;
    UINT32 i, u4Dx, u4Dy;
    UINT32 u4Sx = u4SrcX, u4Sy = u4SrcY;
    UINT32 u4WidthStep=100;
    UINT32 u4WidthFlush;
    //UINT32 u4CMByte=_GetGfxBytrPerPixel(u4CM);
    //if(SwHwSelect==0)  //HW mode is selected
    {
        // set src base address
        i4Ret = GFX_SetSrc(u4GfxHwId, pu1SrcBase, u4CM, u4SrcPitch);
        GFX_CHECK_RET_VALUE(i4Ret);

        // set dst base address
         i4Ret = GFX_SetDst(u4GfxHwId, pu1DstBase, u4CM, u4DstPitch);
         GFX_CHECK_RET_VALUE(i4Ret);

        // set horizontal to vertical line option
        i4Ret = GFX_SetHoriToVertLineOpt(u4GfxHwId, u4Is90CCW);
        GFX_CHECK_RET_VALUE(i4Ret);

        if (u4Is90CCW == (UINT32)TRUE)
        {
            // rotated by 90" counter-clock-wise

            u4Dx = u4DstX;
            u4Dy = u4DstY;
            while(u4Width!=0)
            {

                u4WidthFlush=(u4Width>u4WidthStep) ? u4WidthStep:u4Width;
                for(i = 0; i < u4Height; i++)
                {
                    i4Ret = GFX_HoriToVertLine(u4GfxHwId, u4Sx, u4Sy++,
                                u4Dx++, u4Dy, u4WidthFlush, u4Is90CCW);
                    GFX_CHECK_RET_VALUE(i4Ret);
                    GFX_Flush(u4GfxHwId);
                 } // ~for
                 u4Sx+=u4WidthFlush;
                 u4Sy=u4SrcY;
                 u4Dx=u4DstX;
                 u4Dy-=u4WidthFlush;
                 u4Width -=u4WidthFlush;
             }


        }
        else
        {
            // rotated by 90" clock-wise
            u4Dx = u4DstX;//+(u4Height-1);
            u4Dy = u4DstY;//-(u4Width-1);
            while(u4Width!=0)
            {
                u4WidthFlush=(u4Width>u4WidthStep) ? u4WidthStep:u4Width;
                for(i = 0; i < u4Height; i++)
                {
                    i4Ret = GFX_HoriToVertLine(u4GfxHwId, u4Sx, u4Sy++,
                                u4Dx--, u4Dy, u4WidthFlush, u4Is90CCW);
                    GFX_CHECK_RET_VALUE(i4Ret);
                    GFX_Flush(u4GfxHwId);
                } // ~for
                u4Sy=u4SrcY;
                u4Dx=u4DstX;
                u4Sx+=u4WidthFlush;
                u4Dy+=u4WidthFlush;
                u4Width -=u4WidthFlush;
            }
        }

        // flush and wait
        i4Ret = GFX_Flush(u4GfxHwId);

        REG(u4GfxHwId, fg_DSTPITCH_DEC) = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
        GFX_CHECK_RET_VALUE(i4Ret);
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_RotateBmpSw(UINT8 *pu1SrcBase, UINT8 *pu1DstBase,
    UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4CM, UINT32 u4SrcPitch, UINT32 u4DstPitch,
    UINT32 u4Width, UINT32 u4Height, UINT32 u4Is90CCW)
{

#if 1
    volatile UINT32 u4Sx, u4Sy;

    volatile UINT32 u4CMByte;
    //define the following varities for software
    volatile UINT32 i, j, m, n;
    volatile UINT16 *pu2Src, *pu2Dst;
    volatile UINT32 *pu4Src, *pu4Dst;
    volatile UINT8 *pu1Src, *pu1Dst;
    volatile UINT32 SumSrcPitch;
    volatile UINT32 u4SrcOsdWidth;
    volatile UINT32 u4DstOsdPitch;
    pu4Src=(UINT32 *)pu1SrcBase;
    pu4Dst=(UINT32 *)pu1DstBase;
    pu2Src=(UINT16 *)pu1SrcBase;
    pu2Dst=(UINT16 *)pu1DstBase;
    pu1Src=(UINT8 *)pu1SrcBase;
    pu1Dst=(UINT8 *)pu1DstBase;

    u4Sx = u4SrcX;
    u4Sy = u4SrcY;
    u4CMByte=Gfx_BytePerPixel(u4CM);

   //define over
    {
        if(u4CMByte==4) //32bpp
        {
            u4SrcOsdWidth=u4SrcPitch/4;
            u4DstOsdPitch=u4DstPitch/4;
            //ccw
             if (u4Is90CCW == (UINT32)TRUE)
            {
                for(j=u4Sy,m=u4DstX;j<u4Height+u4Sy;j++,m++)
                {
                    SumSrcPitch=j*u4SrcOsdWidth;
                    for(i=u4Sx,n=u4DstY;i<u4Width+u4Sx;i++,n--)
                    {
                        pu4Dst[m+n*u4DstOsdPitch]=pu4Src[i+SumSrcPitch];
                    }
                }
            }
            //cw
            else
            {
                 for(j=u4Sy,m=u4DstX+u4Height-1;j<u4Height+u4Sy;j++,m--)
                {
                    SumSrcPitch=j*u4SrcOsdWidth;
                    for(i=u4Sx,n=u4DstY;i<u4Width+u4Sx;i++,n++)
                    {
                        pu4Dst[m+n*u4DstOsdPitch]=pu4Src[i+SumSrcPitch];
                    }
                }
            }
        }
        else if(u4CMByte==2)  //16bpp
        {
            u4SrcOsdWidth=u4SrcPitch/2;
            u4DstOsdPitch=u4DstPitch/2;
            //ccw
             if (u4Is90CCW == (UINT32)TRUE)
            {
                for(j=u4Sy,m=u4DstX;j<u4Height+u4Sy;j++,m++)
                {
                    SumSrcPitch=j*u4SrcOsdWidth;
                    for(i=u4Sx,n=u4DstY;i<u4Width+u4Sx;i++,n--)
                    {
                        pu2Dst[m+n*u4DstOsdPitch]=pu2Src[i+SumSrcPitch];
                    }
                }
            }
            //cw
            else
            {
                 for(j=u4Sy,m=u4DstX+u4Height-1;j<u4Height+u4Sy;j++,m--)
                {
                    SumSrcPitch=j*u4SrcOsdWidth;
                    for(i=u4Sx,n=u4DstY;i<u4Width+u4Sx;i++,n++)
                    {
                        pu2Dst[m+n*u4DstOsdPitch]=pu2Src[i+SumSrcPitch];
                    }
                }
            }
        }
        else if(u4CMByte==1)   //sbpp
        {
            u4SrcOsdWidth=u4SrcPitch;
            u4DstOsdPitch=u4DstPitch;
            //ccw
             if (u4Is90CCW == (UINT32)TRUE)
            {
                for(j=u4Sy,m=u4DstX;j<u4Height+u4Sy;j++,m++)
                {
                    SumSrcPitch=j*u4SrcOsdWidth;
                    for(i=u4Sx,n=u4DstY;i<u4Width+u4Sx;i++,n--)
                    {
                        pu1Dst[m+n*u4DstOsdPitch]=pu1Src[i+SumSrcPitch];
                    }
                }
            }
            //cw
            else
            {
                 for(j=u4Sy,m=u4DstX+u4Height-1;j<u4Height+u4Sy;j++,m--)
                {
                    SumSrcPitch=j*u4SrcOsdWidth;
                    for(i=u4Sx,n=u4DstY;i<u4Width+u4Sx;i++,n++)
                    {
                        pu1Dst[m+n*u4DstOsdPitch]=pu1Src[i+SumSrcPitch];
                    }
                }
            }
        }
    }
   #endif
    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_Blend
 *  gfx alpha blend.
 *  calculate input and output address.
 *  set op mode.
 *  set width and height.
 *  enque registers.
 */
//-------------------------------------------------------------------------
INT32 GFX_Blend(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4Width, UINT32 u4Height)
{
    UINT32 u4SrcAddr, u4DstAddr;

    GFX_HW_FX_ENTRY;
#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_ALPHA_BITBLT;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


/*********************************************************
 *GFX_MsBlend 
 *caculate input and output address
 * set OpMode 
 *set width and height
 * enque register
 *********************************************************/
 INT32 GFX_MsBlend(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY, 
                       UINT32 u4Width, UINT32 u4Height, UINT32 u4MsSel)
{
    UINT32 u4SrcAddr, u4DstAddr;

    GFX_HW_FX_ENTRY;
#ifndef GFX_SUPPORT_DIFF_CM
    if(_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
      return -(INT32) E_GFX_INV_ARG;
    }
#endif
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + 
         u4DstY * _u4DstPitch[u4GfxHwId] + (u4DstX << _u4DstShift[u4GfxHwId]));
	REG(u4GfxHwId, fg_DST_BSAD)   =  GFX_PHYSICAL(u4DstAddr);

	u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + 
		 u4SrcY * _u4SrcPitch[u4GfxHwId] + (u4SrcX << _u4SrcShift[u4GfxHwId]));
	REG(u4GfxHwId, fg_SRC_BSAD)   = GFX_PHYSICAL(u4SrcAddr);

	REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_MS_ALPHA_BITBLT;

	REG(u4GfxHwId, fg_SRC_PREMULT)= u4MsSel;

	
	REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
	REG(u4GfxHwId, fg_SRC_HEIGHT) = u4Height - 1;
	REG(u4GfxHwId, fg_FIRE)       =  GFX_ENGINE_FIRE;

	VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);
	
	if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)	   |
		 GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)		|
		 GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)		|
		 GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)	|
		 GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
	{
	 	return -(INT32)E_GFX_OUT_OF_MEM;
	}

 return (INT32)E_GFX_OK;

}


//-------------------------------------------------------------------------
/** GFX_Compose
 *  gfx alpha composition.
 *  set input gfx region.
 *  set output gfx region.
 *  do pass 0 ~ pass 3.
 */
//-------------------------------------------------------------------------
/*lint -save -e534 -e774 -e831  */
#if GFX_USE
INT32 GFX_Compose(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4Width, UINT32 u4Height, UINT32 u4Ar, UINT32 u4Mode)
{
    UINT32 u4MaxLines = 0;
    UINT32 u4Line = 0, u4TotalLines = 0;
    INT32 i4Ret = 0;
    INT32 i4MhpPatch = GFX_ENABLE;

    GFX_HW_FX_ENTRY;
#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif
    // Add CLEAR, SRC, SRC_OVER patches for MHP project
    // 1. CLEAR    -> use Rect Fill (fill 0x0 in rect_color)
    // 2. SRC      -> use Pass0 and Pass5 of Alpha Composition
    // 3. SRC_OVER -> consider two corner cases
    //          case1: Ar=1.0 & As=1.0
    //          case2: Ar=1.0 & As=0.0
    //          note: Ar=0.0 is the same as case2
    if (((UINT32)CM_ARGB8888_DIRECT32 == _u4SrcCM[u4GfxHwId]) &&
        ((UINT32)CM_ARGB8888_DIRECT32 == _u4DstCM[u4GfxHwId]) &&
        (GFX_ENABLE == i4MhpPatch))
    {
        if ((UINT32)E_AC_CLEAR == u4Mode)
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_Fill(u4GfxHwId, u4DstX, u4DstY, u4Width, u4Height);

            // restore original value
            GFX_SetColor(u4GfxHwId, u4RectColor);
            return (INT32)E_GFX_OK;
        }
        else if ((UINT32)E_AC_SRC == u4Mode)
        {
            if (0 == u4Ar)
            {
                UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

                GFX_SetColor(u4GfxHwId,0x0);
                GFX_Fill(u4GfxHwId,u4DstX, u4DstY, u4Width, u4Height);

                // restore original value
                GFX_SetColor(u4GfxHwId, u4RectColor);
            }
            else
            {
                // 1. Pass 0
                GFX_AlphaComposePass(u4GfxHwId, u4SrcX, u4SrcY, u4DstX, u4DstY,
                    u4Width, u4Height, 0, u4Ar);
                GFX_Flush(u4GfxHwId);     // flush queue
            }
            return (INT32)E_GFX_OK;
        }
        else if (((UINT32)E_AC_SRC_OVER == u4Mode) &&
                 (0 == u4Ar))
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);
            UINT32 u4MinColor  = REG(u4GfxHwId, fg_COLOR_KEY_MIN);
            UINT32 u4MaxColor  = REG(u4GfxHwId, fg_COLOR_KEY_MAX);
            UINT32 u4Switch    = 0x0;

            if (REG(u4GfxHwId, fg_TRANS_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_TRANSPARENT);
            }

            if (REG(u4GfxHwId, fg_KEYNOT_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYNOT);
            }

            if (REG(u4GfxHwId, fg_COLCHG_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_COLORCHANGE);
            }

            if (REG(u4GfxHwId, fg_KEYSDSEL))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYSDSEL);
            }

            // BitBlt with ColorChange (from Dst to Dst)
            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_SetBltOpt(u4GfxHwId, D_GFXFLAG_COLORCHANGE, 0x00000000, 0x00FFFFFF);

            // set new src & dst pitch
            REG(u4GfxHwId ,fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4DstPitch[u4GfxHwId] >> 4;

            REG(u4GfxHwId, fg_DST_BSAD) = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) +
                                    (u4DstX << _u4DstShift[u4GfxHwId]));
            REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) +
                                    (u4DstX << _u4DstShift[u4GfxHwId]));

            REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_BITBLT;
            REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
            REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
            REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
            REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

            if (GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH)    |
                GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
                GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
                GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }

            // restore original value
            REG(u4GfxHwId, fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4SrcPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
            GFX_SetColor(u4GfxHwId, u4RectColor);
            GFX_SetBltOpt(u4GfxHwId, u4Switch, u4MinColor, u4MaxColor);
            if (GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH) |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)    |
                GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }
            return (INT32)E_GFX_OK;
        }
        else
        {
            //do nothing, for lint happy
        }
    }

    // calculate how many lines can we handle using working buffer
    _u4WorkingPitch[u4GfxHwId] = ((u4Width << _u4DstShift[u4GfxHwId]) + 0xf) & ~0xf;
    u4MaxLines = (_u4WorkingBufSize / _u4WorkingPitch[u4GfxHwId]);

    if (u4Height > u4MaxLines)
    {
        // break down whole area into sets of lines
        u4TotalLines = (u4Height - u4MaxLines);
        for (u4Line = 0; u4Line < u4TotalLines; u4Line += u4MaxLines)
        {
            if (_GfxAlphaCompPass0(u4GfxHwId, u4SrcX, (u4SrcY + u4Line), u4DstX,
                    (u4DstY + u4Line), u4Ar)                |
                _GfxAlphaCompPass(u4GfxHwId, u4Width, u4MaxLines)      |
                _GfxAlphaCompPass1a(u4GfxHwId)                       |
                _GfxAlphaCompPass(u4GfxHwId, u4Width, u4MaxLines)      |
                _GfxAlphaCompPass1b(u4GfxHwId, u4SrcX, (u4SrcY + u4Line), u4DstX,
                    (u4DstY + u4Line))                      |
                _GfxAlphaCompPass(u4GfxHwId, u4Width, u4MaxLines)      |
                _GfxAlphaCompPass2(u4GfxHwId, u4SrcX, (u4SrcY + u4Line), u4DstX,
                    (u4DstY + u4Line), u4Mode)              |
                _GfxAlphaCompPass(u4GfxHwId, u4Width, u4MaxLines)      |
                _GfxAlphaCompPass3(u4GfxHwId, u4SrcX, (u4SrcY + u4Line), u4DstX,
                    (u4DstY + u4Line))                      |
                _GfxAlphaCompPass(u4GfxHwId, u4Width, u4MaxLines))
            {
                REG(u4GfxHwId ,fg_OSD_WIDTH) = (_u4DstPitch[u4GfxHwId] >> 4);
                REG(u4GfxHwId ,fg_SRC_PITCH) = (_u4SrcPitch[u4GfxHwId] >> 4);

                i4Ret = GFX_CMDENQ(u4GfxHwId,GREG_S_OSD_WIDTH);
                VERIFY(i4Ret == (INT32)E_GFX_OK);

                return -(INT32)E_GFX_OUT_OF_MEM;
            }
        }
        u4MaxLines = (u4Height - u4Line);
    }
    else
    {
        u4Line = 0;
        u4MaxLines = u4Height;
    }

    // process last few lines
    if (u4MaxLines)
    {
        if (_GfxAlphaCompPass0(u4GfxHwId, u4SrcX, (u4SrcY + u4Line), u4DstX,
                (u4DstY + u4Line), u4Ar)                |
            _GfxAlphaCompPass(u4GfxHwId, u4Width, u4MaxLines)      |
            _GfxAlphaCompPass1a(u4GfxHwId)                       |
            _GfxAlphaCompPass(u4GfxHwId, u4Width, u4MaxLines)      |
            _GfxAlphaCompPass1b(u4GfxHwId, u4SrcX, (u4SrcY + u4Line), u4DstX,
                (u4DstY + u4Line))                      |
            _GfxAlphaCompPass(u4GfxHwId, u4Width, u4MaxLines)      |
            _GfxAlphaCompPass2(u4GfxHwId, u4SrcX, (u4SrcY + u4Line), u4DstX,
                (u4DstY + u4Line), u4Mode)              |
            _GfxAlphaCompPass(u4GfxHwId, u4Width, u4MaxLines)      |
            _GfxAlphaCompPass3(u4GfxHwId, u4SrcX, (u4SrcY + u4Line), u4DstX,
                (u4DstY + u4Line))                      |
            _GfxAlphaCompPass(u4GfxHwId, u4Width, u4MaxLines))
        {
            REG(u4GfxHwId, fg_OSD_WIDTH) = (_u4DstPitch[u4GfxHwId] >> 4);
            REG(u4GfxHwId, fg_SRC_PITCH) = (_u4SrcPitch[u4GfxHwId] >> 4);

            i4Ret = GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH);
            VERIFY(i4Ret == (INT32)E_GFX_OK);

            return -(INT32)E_GFX_OUT_OF_MEM;
        }
    }

    if (((UINT32)CM_ARGB8888_DIRECT32 == _u4SrcCM[u4GfxHwId]) &&
        ((UINT32)CM_ARGB8888_DIRECT32 == _u4DstCM[u4GfxHwId]) &&
        (GFX_ENABLE == i4MhpPatch))
    {
        if ((u4Mode == (UINT32)E_AC_SRC_OVER) &&
            (255 == u4Ar))
        {
            UINT32 u4MinColor = REG(u4GfxHwId, fg_COLOR_KEY_MIN);
            UINT32 u4MaxColor = REG(u4GfxHwId, fg_COLOR_KEY_MAX);
            UINT32 u4Switch = 0x0;

            if (REG(u4GfxHwId, fg_TRANS_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_TRANSPARENT);
            }

            if (REG(u4GfxHwId, fg_KEYNOT_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYNOT);
            }

            if (REG(u4GfxHwId, fg_COLCHG_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_COLORCHANGE);
            }

            if (REG(u4GfxHwId, fg_KEYSDSEL))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYSDSEL);
            }

            // restore src & dst pitch
            REG(u4GfxHwId, fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4SrcPitch[u4GfxHwId] >> 4;
            if (GFX_CMDENQ(u4GfxHwId,GREG_S_OSD_WIDTH))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }

            // do (Transparent & Keynot)-BitBlt
            GFX_SetBltOpt(u4GfxHwId, (D_GFXFLAG_TRANSPARENT | D_GFXFLAG_KEYNOT), 0xFF000000, 0xFFFFFFFF);
            GFX_BitBlt(u4GfxHwId, u4SrcX, u4SrcY, u4DstX, u4DstY, u4Width, u4Height);

            // restore bltopt
            GFX_SetBltOpt(u4GfxHwId, u4Switch, u4MinColor, u4MaxColor);
            if (GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }
        }
    }

    // restore src & dst pitch
    REG(u4GfxHwId, fg_OSD_WIDTH) = (_u4DstPitch[u4GfxHwId] >> 4);
    REG(u4GfxHwId, fg_SRC_PITCH) = (_u4SrcPitch[u4GfxHwId] >> 4);
    return GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH);
}
#endif
/*lint -restore */
/*lint -restore */


//-------------------------------------------------------------------------
/** GFX_AlphaComposePass
 *  gfx alpha compose pass.
 *  exported for pass 4 copy color and pass 5 copy alpha.
 */
//-------------------------------------------------------------------------
INT32 GFX_NormalComposePass(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY,
    UINT32 u4DstX, UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height,
    UINT32 u4Pass, UINT32 u4Param)
{
    UINT32 u4SrcAddr, u4DstAddr;
    GFX_HW_FX_ENTRY;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_ALCOM_PASS)  = u4Pass;
    REG(u4GfxHwId, fg_ALPHA_VALUE) = u4Param;
    REG(u4GfxHwId, fg_OSD_WIDTH)   = (_u4DstPitch[u4GfxHwId] >> 4);
    REG(u4GfxHwId, fg_SRC_PITCH)   = (_u4SrcPitch[u4GfxHwId] >> 4);

    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_ALPHA_COMPOS_BITBLT;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_ALCOM_NORMAL) = 1;
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_AlphaComposePass
 *  gfx alpha compose pass.
 *  exported for pass 4 copy color and pass 5 copy alpha.
 */
//-------------------------------------------------------------------------
INT32 GFX_AlphaComposePass(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY,
    UINT32 u4DstX, UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height,
    UINT32 u4Pass, UINT32 u4Param)
{
    UINT32 u4SrcAddr, u4DstAddr;
    GFX_HW_FX_ENTRY;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_ALCOM_PASS)  = u4Pass;
    REG(u4GfxHwId, fg_ALPHA_VALUE) = u4Param;
    REG(u4GfxHwId, fg_OSD_WIDTH)   = (_u4DstPitch[u4GfxHwId] >> 4);
    REG(u4GfxHwId, fg_SRC_PITCH)   = (_u4SrcPitch[u4GfxHwId] >> 4);

    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_ALPHA_COMPOS_BITBLT;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    
    REG(u4GfxHwId, fg_ALCOM_NORMAL) = 0;
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_SetColCnvFmt
 *  gfx set ycbcr to rgb color conversion format.
 *  set yc format.
 *  set video standard.
 *  set video system.
 *  set mtk swap mode.
 *  enable saturate.
 */
//-------------------------------------------------------------------------
INT32 GFX_SetColCnvFmt(UINT32 u4GfxHwId, UINT32 u4YCFmt, UINT32 u4SwapMode, UINT32 u4VidStd,
    UINT32 u4VidSys)
{
    REG(u4GfxHwId, fg_YC_FMT)        = u4YCFmt;
    REG(u4GfxHwId, fg_VSTD)          = u4VidStd;
    REG(u4GfxHwId, fg_VSYS)          = u4VidSys;
    //REG(u4GfxHwId, fg_SWAP_NEW_MODE) = 0x1;
    REG(u4GfxHwId, fg_SWAP_MODE)     = u4SwapMode;
    REG(u4GfxHwId, fg_VSCLIP)        = GFX_ENABLE;
    REG(u4GfxHwId, fg_ALPHA_VALUE)   = 0xFF;

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_SetColCnvSrc
 *  gfx set color conversion source.
 *  luma input address, line size.
 *  chroma input address, linesize.
 *  field/frame mode.
 */
//-------------------------------------------------------------------------
INT32 GFX_SetColCnvSrc(UINT32 u4GfxHwId, UINT8 *pu1SrcLuma, UINT32 u4SrcLumaPitch,
    UINT8 *pu1SrcChroma, UINT32 u4SrcChromaPitch, UINT32 u4FieldPic)
{
    REG(u4GfxHwId, fg_SRC_BSAD)      = (UINT32)pu1SrcLuma;
    REG(u4GfxHwId, fg_SRC_PITCH)     = (u4SrcLumaPitch >> 4);//u4SrcLumaPitch;//(u4SrcLumaPitch >> 4);
    REG(u4GfxHwId, fg_SRCCBCR_BSAD)  = (UINT32)pu1SrcChroma;
    REG(u4GfxHwId, fg_SRCCBCR_PITCH) = (u4SrcChromaPitch >> 4);//u4SrcChromaPitch;//(u4SrcChromaPitch >> 4);
    REG(u4GfxHwId, fg_FLD_PIC)       = u4FieldPic;

    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, pu1SrcLuma);
    VA_MSB_REG(u4GfxHwId, fg_SRCCBCR_BSAD_H, pu1SrcChroma);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH)    |
        GFX_CMDENQ(u4GfxHwId, GREG_SRCCBCR_BSAD)   |
        GFX_CMDENQ(u4GfxHwId, GREG_SRCCBCR_PITCH)  |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
INT32 GFX_SetColCnvFmtEx(UINT32 u4GfxHwId, UINT32 u4YCFmt, UINT32 u4SwapMode, UINT32 u4VidStd,
    UINT32 u4VidSys, UINT32 u4VSCLIP)
{
    REG(u4GfxHwId, fg_YC_FMT)      = u4YCFmt;
    REG(u4GfxHwId, fg_VSTD)        = u4VidStd;
    REG(u4GfxHwId, fg_VSYS)        = u4VidSys;
    #if 0//(CONFIG_CHIP_VER_CURR >= CONFIG_CHIP_VER_MT8555)
    REG(u4GfxHwId, fg_SWAP_NEW_MODE)   = u4SwapMode >> 2;
    REG(u4GfxHwId, fg_SWAP_MODE)   = u4SwapMode & 0x3;
    #else
    REG(u4GfxHwId, fg_SWAP_MODE)   = u4SwapMode;
    #endif
    REG(u4GfxHwId, fg_VSCLIP)      = u4VSCLIP;
    REG(u4GfxHwId, fg_ALPHA_VALUE) = 0xFF;

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_SetColCnvSrc
 *  gfx set color conversion source.
 *  luma input address, line size.
 *  chroma input address, linesize.
 *  field/frame mode.
 */
//-------------------------------------------------------------------------
INT32 GFX_SetColCnvSrcEx(UINT32 u4GfxHwId, UINT8 *pu1SrcLuma, UINT32 u4SrcLumaPitch,
    UINT8 *pu1SrcChroma, UINT32 u4SrcChromaPitch, UINT32 u4FieldPic)
{
    REG(u4GfxHwId, fg_SRC_BSAD)      = (UINT32)pu1SrcLuma;
    REG(u4GfxHwId, fg_SRC_PITCH)     = (u4SrcLumaPitch >> 4);
    REG(u4GfxHwId, fg_SRCCBCR_BSAD)  = (UINT32)pu1SrcChroma;
    REG(u4GfxHwId, fg_SRCCBCR_PITCH) = (u4SrcChromaPitch >> 4);
    REG(u4GfxHwId, fg_FLD_PIC)       = u4FieldPic;

    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, pu1SrcLuma);
    VA_MSB_REG(u4GfxHwId, fg_SRCCBCR_BSAD_H, pu1SrcChroma);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH)    |
        GFX_CMDENQ(u4GfxHwId, GREG_SRCCBCR_BSAD)   |
        GFX_CMDENQ(u4GfxHwId, GREG_SRCCBCR_PITCH)  |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ColConv
 *  gfx convert ycbcr to rgb.
 *  calculate output address.
 *  set output width height.
 */
//-------------------------------------------------------------------------
INT32 GFX_ColConv(UINT32 u4GfxHwId, UINT32 u4X, UINT32 u4Y, UINT32 u4Width, UINT32 u4Height)
{
    UINT32 u4DstAddr;

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                        (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);

    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_YCRCB_RGB_CNV;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ColConv
 *  gfx convert ycbcr to rgb.
 *  calculate output address.
 *  set output width height.
 */
//-------------------------------------------------------------------------
INT32 GFX_ColConv420(UINT32 u4GfxHwId, UINT32 u4SX, UINT32 u4SY,UINT32 u4X, UINT32 u4Y, UINT32 u4Width, UINT32 u4Height)
{
    UINT32 u4SrcAddr, u4DstAddr;

    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                        (u4SY * _u4SrcPitch[u4GfxHwId]) + (u4SX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                        (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);

    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_YCRCB_RGB_CNV;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


#define GFX_CLIP_TOP_EN       (UINT32)(1 << 0)
#define GFX_CLIP_BOT_EN       (UINT32)(1 << 1)
#define GFX_CLIP_LEFT_EN      (UINT32)(1 << 2)
#define GFX_CLIP_RIGHT_EN     (UINT32)(1 << 3)

INT32 GFX_SetClipOpt(UINT32 u4GfxHwId, UINT32 u4ClipEnMask, UINT32 u4DstX, UINT32 u4DstY, UINT32 u4ClipTop, UINT32 u4ClipBot, UINT32 u4ClipLeft, UINT32 u4ClipRight)
{
    UINT32 u4TopEn, u4BotEn, u4LeftEn, u4RightEn;
    UINT32 u4ClipEn = 0;

    GFX_HW_FX_ENTRY;

    // Error Check
    if ((u4ClipTop  > u4ClipBot) || (u4ClipLeft > u4ClipRight))
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_DSTX)   = u4DstX;
    REG(u4GfxHwId, fg_DSTY)   = u4DstY;

    u4TopEn   = (u4ClipEnMask & GFX_CLIP_TOP_EN)   ? 1 : 0;
    u4BotEn   = (u4ClipEnMask & GFX_CLIP_BOT_EN)   ? 1 : 0;
    u4LeftEn  = (u4ClipEnMask & GFX_CLIP_LEFT_EN)  ? 1 : 0;
    u4RightEn = (u4ClipEnMask & GFX_CLIP_RIGHT_EN) ? 1 : 0;

    u4ClipEn  = (u4TopEn | u4BotEn | u4LeftEn | u4RightEn);

    REG(u4GfxHwId, fg_CLIP_TOP)   = u4ClipTop;
    REG(u4GfxHwId, fg_CLT_ENA)    = u4TopEn;
    REG(u4GfxHwId, fg_CLIP_BOT)   = u4ClipBot;
    REG(u4GfxHwId, fg_CLB_ENA)    = u4BotEn;
    REG(u4GfxHwId, fg_CLIP_LEFT)  = u4ClipLeft;
    REG(u4GfxHwId, fg_CLL_ENA)    = u4LeftEn;
    REG(u4GfxHwId, fg_CLIP_RIGHT) = u4ClipRight;
    REG(u4GfxHwId, fg_CLR_ENA)    = u4RightEn;

    REG(u4GfxHwId, fg_CLIP_ENA)   = u4ClipEn;

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_XY)   |
        GFX_CMDENQ(u4GfxHwId, GREG_CLIP_BR)  |
        GFX_CMDENQ(u4GfxHwId, GREG_CLIP_TL)  |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE) )
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_StretchBlt
 *  gfx stretch bitblt.
 *  calculate output address.
 *  calculate input address.
 *  calculate ration.
 *  set input width height.
 *  set output width height.
 *  enque registers.
 */
//-------------------------------------------------------------------------
INT32 GFX_StretchBlt(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
    UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH)
{

    UINT32 u4MnV = 0;
    UINT32 u4MnH = 0;
    UINT32 u4SrcAddr, u4DstAddr;

    GFX_HW_FX_ENTRY;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    // calculate m n ratio for scale up and down
    if ((u4DstW == u4SrcW) || (u4DstW == 1))
    {
        u4MnH = 0x00010000;
        u4SrcW = u4DstW;
    }
    else if (u4SrcW > u4DstW)    // scale down
    {
        u4MnH = (u4SrcW << 16) / (u4DstW - 1);  /* m/(n-1) */
        if (((u4SrcW << 16) % (u4DstW - 1)) == 0)
        {
            u4MnH--;  /* replace m/(n-1) with m/(n-1)-2e-16, hardware limitation */
        }
    }
    else /* scale up (u4DstW > u4SrcW) */
    {
        UINT32 u4Step;

        u4Step = (u4SrcW << 16) / (u4DstW);
        if ((u4Step * (u4DstW - 1)) < ((u4SrcW - 1) << 16))
        {
            u4MnH = (u4SrcW << 16) / (u4DstW - 1);
            if (u4MnH == 0x10000)
            {
                u4MnH--;
            }
        }
        else
        {
            u4MnH = u4Step;
        }
    }

    if ((u4DstH == u4SrcH) || (u4DstH == 1))
    {
        u4MnV = 0x00010000;
        u4SrcH = u4DstH;
    }
    else
    {
        u4MnV = (u4SrcH << 16) / (u4DstH - 1);
        if (u4MnV == 0x00010000)
        {
            u4MnV = (u4SrcH << 16) / (u4DstH);
        }
    }

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32)OP_STRETCH_BITBLT;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    

    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4SrcH - 1);

    REG(u4GfxHwId, fg_STR_DST_WIDTH)  = u4DstW;
    REG(u4GfxHwId, fg_STR_DST_HEIGHT) = (u4DstH - 1);
    REG(u4GfxHwId, fg_STR_BLT_H)      = u4MnH;
    REG(u4GfxHwId, fg_STR_BLT_V)      = u4MnV;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |  
        GFX_CMDENQ(u4GfxHwId, GREG_STR_BLT_H)      |
        GFX_CMDENQ(u4GfxHwId, GREG_STR_BLT_V)      |
        GFX_CMDENQ(u4GfxHwId, GREG_STR_DST_SIZE)   |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_AlphaMapBitBlt
 *  gfx alpha map bitblt.
 *  calculate output address.
 *  calculate input address.
 *  set alpha map bitblt op mode.
 *  set color conversion flag.
 *  enque output address register.
 *  enque input address register.
 *  enque size registers.
 *  enque mode register.
 */
//-------------------------------------------------------------------------
INT32 GFX_AlphaMapBitBlt(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY,
    UINT32 u4DstX, UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height)
{
    UINT32 u4SrcAddr, u4DstAddr;

    if (_u4SrcCM[u4GfxHwId] != (UINT32)CM_RGB_CLUT8)
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    if ((_u4DstCM[u4GfxHwId] != (UINT32)CM_ARGB8888_DIRECT32) &&
        (_u4DstCM[u4GfxHwId] != (UINT32)CM_ARGB4444_DIRECT16) &&
        (_u4DstCM[u4GfxHwId] != (UINT32)CM_ARGB1555_DIRECT16))
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_ALPHA_MAP_BITBLT;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)    |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)    |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}



// normal driver
#if !defined(GFX_MINI_DRIVER)
//-------------------------------------------------------------------------
/** GFX_SetGradOpt
 *  gfx set gradient options.
 *  x increment pixels.
 *  y increment pixels.
 *  x delta in color components (a, r, g, b), 7.1 format.
 *  y delta in color components.
 */
//-------------------------------------------------------------------------
INT32 GFX_SetGradOpt(UINT32 u4GfxHwId, UINT32 u4IncX, UINT32 u4IncY,
    const UINT32 asu4DeltaX[4], const UINT32 asu4DeltaY[4])
{
    if ((NULL == asu4DeltaX) || (NULL == asu4DeltaY))
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_GRAD_X_PIX_INC) = u4IncX;
    REG(u4GfxHwId, fg_GRAD_Y_PIX_INC) = u4IncY;

    REG(u4GfxHwId, fg_DELTA_X_C0) = asu4DeltaX[0] & 0xff;
    REG(u4GfxHwId, fg_DELTA_X_C1) = asu4DeltaX[1] & 0xff;
    REG(u4GfxHwId, fg_DELTA_X_C2) = asu4DeltaX[2] & 0xff;
    REG(u4GfxHwId, fg_DELTA_X_C3) = asu4DeltaX[3] & 0xff;

    REG(u4GfxHwId, fg_DELTA_Y_C0) = asu4DeltaX[0] & 0xff;
    REG(u4GfxHwId, fg_DELTA_Y_C1) = asu4DeltaX[1] & 0xff;
    REG(u4GfxHwId, fg_DELTA_Y_C2) = asu4DeltaX[2] & 0xff;
    REG(u4GfxHwId, fg_DELTA_Y_C3) = asu4DeltaX[3] & 0xff;

    if (GFX_CMDENQ(u4GfxHwId, GREG_GRAD_X_DELTA)   |
        GFX_CMDENQ(u4GfxHwId, GREG_GRAD_Y_DELTA))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_GradFill
 *  gfx gradient rectangle fill.
 *  calculate output address.
 *  set gradient fill op mode.
 *  set width and height.
 *  enque registers.
 */
//-------------------------------------------------------------------------
INT32 GFX_GradFill(UINT32 u4GfxHwId, UINT32 u4X, UINT32 u4Y, UINT32 u4Width, UINT32 u4Height,
    UINT32 u4Mode)
{
    UINT32 u4DstAddr;

    GFX_HW_FX_ENTRY;

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);

    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_GRAD_FILL;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_GRAD_MODE)  = u4Mode;
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_GRAD_XY_INC)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_DMA
 *  gfx dram to dram dma function.
 *  32bit align.
 *  set output address.
 *  set input address.
 *  set number of 32bit words.
 */
//-------------------------------------------------------------------------
INT32 _GFX_DMA(UINT32 u4GfxHwId, UINT32 *pu4Dst, UINT32 *pu4Src, UINT32 u4NumWrd)
{
  return -(INT32)E_GFX_OUT_OF_MEM;
}
INT32 GFX_DMA(UINT32 *pu4Dst, UINT32 *pu4Src, UINT32 u4NumWrd)
{
  return  _GFX_DMA(0, pu4Dst, pu4Src,  u4NumWrd);
}

extern INT32 GFX_DMA_CLI(UINT32 *pu4Counter, UINT32 *pu4NumByte)
{
    *pu4Counter=u4DmaCounter;
    *pu4NumByte=u4DmaNum;
    return (INT32)E_GFX_OK;
}

