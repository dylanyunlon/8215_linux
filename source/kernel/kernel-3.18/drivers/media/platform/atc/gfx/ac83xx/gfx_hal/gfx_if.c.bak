//---------------------------------------------------------------------------
// Static functions
//---------------------------------------------------------------------------

#if GFX_USE
//-------------------------------------------------------------------------
/** _GfxAlphaCompPass
 *  gfx alpha compose pass.
 */
//-------------------------------------------------------------------------
static INT32 _GfxAlphaCompPass(UINT32 u4GfxHwId, UINT32 u4Width, UINT32 u4Height)
{
    REG(u4GfxHwId, fg_OP_MODE)    = (INT32)OP_ALPHA_COMPOS_BITBLT;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)    |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)    |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE) |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** _GfxAlphaCompPass0
 *  gfx alpha composite pass 0.
 *  apply ext alpha to color.
 */
//-------------------------------------------------------------------------
static INT32 _GfxAlphaCompPass0(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX,
    UINT32 u4DstY, UINT32 u4Ar)
{
    UNUSED(u4DstX);
    UNUSED(u4DstY);

    // pass 0 : apply ar to source (put into working buffer)
    REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = (UINT32)(_pu1WorkingBuf);

    REG(u4GfxHwId, fg_ALPHA_VALUE) = u4Ar;
    REG(u4GfxHwId, fg_ALCOM_PASS)  = 0;

    REG(u4GfxHwId, fg_OSD_WIDTH) = (_u4WorkingPitch[u4GfxHwId] >> 4);
    REG(u4GfxHwId, fg_SRC_PITCH) = (_u4SrcPitch[u4GfxHwId] >> 4);

    return GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH);
}


//-------------------------------------------------------------------------
/** _GfxAlphaCompPass1a
 *  gfx alpha composite pass 1a.
 *  apply pixel alpha to color.
 */
//-------------------------------------------------------------------------
static INT32 _GfxAlphaCompPass1a(UINT32 u4GfxHwId)
{
    // pass 1a : apply source alpha to color components
    REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1WorkingBuf);
    REG(u4GfxHwId, fg_DST_BSAD) = (UINT32)(_pu1WorkingBuf);

    REG(u4GfxHwId, fg_ALPHA_VALUE) = 255;
    REG(u4GfxHwId, fg_ALCOM_PASS)  = 1;

    REG(u4GfxHwId, fg_OSD_WIDTH) = (_u4WorkingPitch[u4GfxHwId] >> 4);
    REG(u4GfxHwId, fg_SRC_PITCH) = (_u4WorkingPitch[u4GfxHwId] >> 4);

    return GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH);
}


//-------------------------------------------------------------------------
/** _GfxAlphaCompPass1b
 *  gfx alpha composite pass 1b.
 *  apply pixel alpha to color.
 */
//-------------------------------------------------------------------------
static INT32 _GfxAlphaCompPass1b(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX,
    UINT32 u4DstY)
{
    UNUSED(u4SrcX);
    UNUSED(u4SrcY);

    // pass 1b : apply destination alpha to color components
    REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1DstBase[u4GfxHwId] +
                        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = REG(u4GfxHwId,fg_SRC_BSAD);

    REG(u4GfxHwId, fg_ALPHA_VALUE) = 255;
    REG(u4GfxHwId, fg_ALCOM_PASS)  = 1;

    REG(u4GfxHwId, fg_OSD_WIDTH) = (_u4DstPitch[u4GfxHwId] >> 4);
    REG(u4GfxHwId, fg_SRC_PITCH) = (_u4DstPitch[u4GfxHwId] >> 4);

    return GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH);
}


//-------------------------------------------------------------------------
/** _GfxAlphaCompPass2
 *  gfx alpha composite pass 2.
 *
 */
//-------------------------------------------------------------------------
static INT32 _GfxAlphaCompPass2(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX,
    UINT32 u4DstY, UINT32 u4Mode)
{
    UNUSED(u4SrcX);
    UNUSED(u4SrcY);

    REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1WorkingBuf);
    REG(u4GfxHwId, fg_DST_BSAD) = (UINT32)(_pu1DstBase[u4GfxHwId] +
                        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));

    REG(u4GfxHwId, fg_ALPHA_VALUE) = u4Mode;
    REG(u4GfxHwId, fg_ALCOM_PASS)  = 2;

    REG(u4GfxHwId, fg_OSD_WIDTH) = (_u4DstPitch[u4GfxHwId] >> 4);
    REG(u4GfxHwId, fg_SRC_PITCH) = (_u4WorkingPitch[u4GfxHwId] >> 4);

    return GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH);
}


//-------------------------------------------------------------------------
/** _GfxAlphaCompPass3
 *  gfx alpha composite pass 3.
 *  extrace color from composite color.
 */
//-------------------------------------------------------------------------
static INT32 _GfxAlphaCompPass3(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX,
    UINT32 u4DstY)
{
    UNUSED(u4SrcX);
    UNUSED(u4SrcY);

    REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1DstBase[u4GfxHwId] +
                        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = REG(u4GfxHwId,fg_SRC_BSAD);

    REG(u4GfxHwId, fg_ALPHA_VALUE) = 255;
    REG(u4GfxHwId, fg_ALCOM_PASS)  = 3;

    REG(u4GfxHwId, fg_OSD_WIDTH) = (_u4DstPitch[u4GfxHwId] >> 4);
    REG(u4GfxHwId, fg_SRC_PITCH) = (_u4DstPitch[u4GfxHwId] >> 4);

    return GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH);
}
