    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetMirrorFlipFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

