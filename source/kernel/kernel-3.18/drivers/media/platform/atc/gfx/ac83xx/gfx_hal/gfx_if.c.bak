INT32 GFX_MMUOverReadProtectionEx(UINT32 u4GfxHwId, UINT32 u4Enalbe, GFX_MMU_TYPE eType, UINT32 u4Addr1, UINT32 u4Size1, UINT32 u4Addr2, UINT32 u4Size2)
{
        if (u4Enalbe)
        {
            if (GFX_MMU_OTHER == eType)
            {
                /*
                IOMMU_WRITE32(REG_RW_IOMMU_CFG9, IOMMU_GFX,  ((ui4_StartAddr0+ui4_Buff_sz0-1)&0xFFFFF000)|(0x0<<1)|0x1);
                IOMMU_WRITE32(REG_RW_IOMMU_CFGA, IOMMU_GFX,  ((ui4_StartAddr1+ui4_Buff_sz1-1)&0xFFFFF000)|(0x4<<1)|0x1);
                IOMMU_WRITE32(REG_RW_IOMMU_CFGB, IOMMU_GFX,  (0x2<<4)|(0x1<<0));
                */
                REG(u4GfxHwId, fg_IOMMU_CFG9) = ((u4Addr1+u4Size1-1)&0xFFFFF000)|(0x0<<1)|0x1;
                REG(u4GfxHwId, fg_IOMMU_CFG10) = ((u4Addr2+u4Size2-1)&0xFFFFF000)|(0x4<<1)|0x1;
                REG(u4GfxHwId, fg_IOMMU_CFG11) = (0x2<<4)|(0x1<<0);
            }
            else if (GFX_MMU_COMPRESS == eType)
            {
                /*
                IOMMU_WRITE32(REG_RW_IOMMU_CFG9, IOMMU_GFX,  ((ui4_StartAddr0+ui4_Buff_sz0-1)&0xFFFFF000)|(0x3<<1)|0x1);
                IOMMU_WRITE32(REG_RW_IOMMU_CFGA, IOMMU_GFX,  ((ui4_StartAddr1+ui4_Buff_sz1-1)&0xFFFFF000)|(0x4<<1)|0x1);
                IOMMU_WRITE32(REG_RW_IOMMU_CFGB, IOMMU_GFX,  (0x2<<4)|(0x1<<0));
                */
                REG(u4GfxHwId, fg_IOMMU_CFG9) = ((u4Addr1+u4Size1-1)&0xFFFFF000)|(0x3<<1)|0x1;
                REG(u4GfxHwId, fg_IOMMU_CFG10) = ((u4Addr2+u4Size2-1)&0xFFFFF000)|(0x4<<1)|0x1;
                REG(u4GfxHwId, fg_IOMMU_CFG11) = (0x2<<4)|(0x1<<0);
            }
            else
            {
                return (E_GFX_INV_ARG);
            }
        }
        else
        {
            REG(u4GfxHwId, fg_IOMMU_CFG9) = 0;
            REG(u4GfxHwId, fg_IOMMU_CFG10) = 0;
            REG(u4GfxHwId, fg_IOMMU_CFG11) = 0;
            REG(u4GfxHwId, fg_IOMMU_CFG12) = 0;
            REG(u4GfxHwId, fg_IOMMU_CFG13) = 0;
        }

        if (GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG9)  |
            GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG10) |
            GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG11) |
            GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG12) |
            GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG13))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

    return (E_GFX_OK);
}

inline INT32 GFX_MMUOverReadProtection(UINT32 u4GfxHwId, UINT32 u4Enalbe, GFX_MMU_TYPE eType, UINT32 u4Addr1, UINT32 u4Size1, UINT32 u4Addr2, UINT32 u4Size2)
{
#if 0
