//-------------------------------------------------------------------------
/** GFX_CopyTopfieldToBotfield
 *  copy top-field to bottom field
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_CopyTopfieldToBotfield(UINT32 u4GfxHwId, UINT8 *pu1TopStartAddr,
    UINT32 u4TotalLines, UINT32 u4LineWidth)
{
    UINT8 *pu1BotStartAddr;
    UINT8 *pu1TopCurAddr;
    UINT8 *pu1BotCurAddr;
    UINT32 i, u4Pitch;

    VERIFY(pu1TopStartAddr != NULL);
    VERIFY(u4LineWidth != 0);

    u4Pitch = (u4LineWidth + 0xF) & ~(0xF);

    // bottom field start address
    pu1BotStartAddr = (UINT8 *)((UINT32)pu1TopStartAddr + u4LineWidth);

    // set top and bottom current address
    pu1TopCurAddr = pu1TopStartAddr;
    pu1BotCurAddr = pu1BotStartAddr;

    //GFX_Lock();

    if (GFX_SetBltOpt(u4GfxHwId, (UINT32)D_GFXFLAG_NONE, 0x00000000, 0xffffffff))
    {
        //GFX_Unlock();
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    for (i = 0; i < u4TotalLines; i++)
    {
        if (GFX_SetSrc(u4GfxHwId, pu1TopCurAddr, (UINT32)CM_RGB_CLUT8, u4Pitch))
        {
            //GFX_Unlock();
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        if (GFX_SetDst(u4GfxHwId, pu1BotCurAddr, (UINT32)CM_RGB_CLUT8, u4Pitch))
        {
          //  GFX_Unlock();
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        if (GFX_BitBlt(u4GfxHwId, 0, 0, 0, 0, u4LineWidth, 1))
        {
           // GFX_Unlock();
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        pu1TopCurAddr = (UINT8 *)((UINT32)pu1TopCurAddr + (2 * u4LineWidth));
        pu1BotCurAddr = (UINT8 *)((UINT32)pu1BotCurAddr + (2 * u4LineWidth));

    } // ~for

    if (GFX_Flush(u4GfxHwId))
    {
       // GFX_Unlock();
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    //GFX_Wait();

  //  GFX_Unlock();

    return (INT32)E_GFX_OK;
}


INT32 Gfx_RegFileInit(void)
{
	printk("enter gfx_regfileint\n");

    INT32 i4;
    for(i4 = 0; i4 < GFX_HAL_HW_INST_NUM; i4++)
    {
        GfxRegFile[i4].prRegFile =( MI_DIF_UNION_T *) (&REGFILE(i4,0));
        GfxLosslessRegFile[i4].prRegFile =( MI_DIF_LOSSLESS_UNION_T *) (&REGFILE_LL(i4,0));
    }
	printk("leave rgefileinit\n");
    return E_GFX_OK;
}

