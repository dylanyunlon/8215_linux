 */
//-------------------------------------------------------------------------
INT32 GFX_VLine(UINT32 u4GfxHwId, UINT32 u4X, UINT32 u4Y, UINT32 u4Height)
{
    UINT32 u4DstAddr;

    GFX_HW_FX_ENTRY;
    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);

    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_DRAW_VLINE;
    REG(u4GfxHwId, fg_SRC_WIDTH) = 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)   |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)   |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ObliqueLine
 *  gfx draw oblique line.
 */
//-------------------------------------------------------------------------
UINT32 _u4LineWidth=1;
INT32 GFX_ObliqueLine(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY)
{
    UINT32 u4DstAddr;

    GFX_HW_FX_ENTRY;
    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4SrcY * _u4DstPitch[u4GfxHwId]) + (u4SrcX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);

    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32) OP_OBLIQUE_LINE;
    REG(u4GfxHwId, fg_SRCX)       = u4SrcX;
    REG(u4GfxHwId, fg_SRCY)       = u4SrcY;
    REG(u4GfxHwId, fg_DSTX)       = u4DstX;
    REG(u4GfxHwId, fg_DSTY)       = u4DstY;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = _u4LineWidth;

    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)   |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_XY)     |
        GFX_CMDENQ(u4GfxHwId, GREG_DST_XY)     |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)   |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_SetBltOpt
 *  gfx set bitblt option.
 *  set transparent enable bit.
 *  set color change enable bit.
 *  set keynot enable bit.
 *  set clip enable bit.
 *  set 4bpp special mode bit.
 *  set color key min.
 *  set color key max.
 *  set color conversion enable to false.
 *  enque color key min and max.
 */
//-------------------------------------------------------------------------
INT32 GFX_SetBltOptEx(UINT32 u4GfxHwId, UINT32 u4Switch, UINT32 u4DisSrcKey, UINT32 u4SrcKeyIn, UINT32 u4ColorMin, UINT32 u4ColorMax, UINT32 u4DisDstKey, UINT32 u4DstKeyIn, UINT32 u4DstColorMin, UINT32 u4DstColorMax)
{
    GFX_HW_FX_ENTRY;

    REG(u4GfxHwId, fg_TRANS_ENA)   = (u4Switch & D_GFXFLAG_TRANSPARENT) ? 1 : 0;
    REG(u4GfxHwId, fg_KEYNOT_ENA)  = (u4Switch & D_GFXFLAG_KEYNOT)      ? 1 : 0;
    REG(u4GfxHwId, fg_COLCHG_ENA)  = (u4Switch & D_GFXFLAG_COLORCHANGE) ? 1 : 0;
    REG(u4GfxHwId, fg_KEYSDSEL)    = !u4DisDstKey;//(u4DisDstKey == 0) ? 1 : 0;
    REG(u4GfxHwId, fg_DIS_SRC_KEY)   = u4DisSrcKey;
    REG(u4GfxHwId, fg_DIS_DST_KEY)   = u4DisDstKey;
    REG(u4GfxHwId, fg_SRC_KEY_IN)    = u4SrcKeyIn;
    REG(u4GfxHwId, fg_DST_KEY_IN)    = u4DstKeyIn;


    REG(u4GfxHwId, fg_COLOR_KEY_MIN)     = u4ColorMin;
    REG(u4GfxHwId, fg_COLOR_KEY_MAX)     = u4ColorMax;
    REG(u4GfxHwId, fg_DST_COLOR_KEY_MIN) = u4DstColorMin;
    REG(u4GfxHwId, fg_DST_COLOR_KEY_MAX) = u4DstColorMax;
    REG(u4GfxHwId, fg_CFMT_ENA)      = 0;
    

    if (GFX_CMDENQ(u4GfxHwId, GREG_0x40E8)  |
        GFX_CMDENQ(u4GfxHwId, GREG_0x40EC)  |
        GFX_CMDENQ(u4GfxHwId, GREG_KEY_DATA0)  |
        GFX_CMDENQ(u4GfxHwId, GREG_KEY_DATA1)  |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE) )
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_SetBltOpt
 *  gfx set bitblt option.
 *  set transparent enable bit.
 *  set color change enable bit.
 *  set keynot enable bit.
 *  set clip enable bit.
 *  set 4bpp special mode bit.
 *  set color key min.
 *  set color key max.
 *  set color conversion enable to false.
 *  enque color key min and max.
 */
//-------------------------------------------------------------------------
INT32 GFX_SetBltOpt(UINT32 u4GfxHwId, UINT32 u4Switch, UINT32 u4ColorMin, UINT32 u4ColorMax)
{
    GFX_HW_FX_ENTRY;
    if ((u4Switch & D_GFXFLAG_TRANSPARENT) &&
        (u4Switch & D_GFXFLAG_COLORCHANGE))
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_TRANS_ENA)   = (u4Switch & D_GFXFLAG_TRANSPARENT) ? 1 : 0;
    REG(u4GfxHwId, fg_KEYNOT_ENA)  = (u4Switch & D_GFXFLAG_KEYNOT)      ? 1 : 0;
    REG(u4GfxHwId, fg_COLCHG_ENA)  = (u4Switch & D_GFXFLAG_COLORCHANGE) ? 1 : 0;
    REG(u4GfxHwId, fg_KEYSDSEL)    = (u4Switch & D_GFXFLAG_KEYSDSEL)    ? 1 : 0;

    REG(u4GfxHwId, fg_COLOR_KEY_MIN) = u4ColorMin;
    REG(u4GfxHwId, fg_COLOR_KEY_MAX) = u4ColorMax;
    REG(u4GfxHwId, fg_CFMT_ENA)      = 0;

    if (GFX_CMDENQ(u4GfxHwId, GREG_KEY_DATA0)  |
        GFX_CMDENQ(u4GfxHwId, GREG_KEY_DATA1)  |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE) )
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_SetBltOpt2(UINT32 u4GfxHwId, UINT32 u4Enable, UINT32 u4Y2R, UINT32 uEn709)
{

    UINT32 u4YuvRgbMode=0;

    GFX_HW_FX_ENTRY;

    u4YuvRgbMode= (u4Enable<<2)+(u4Y2R<<1)+uEn709;

    REG(u4GfxHwId, fg_TRANS_ENA)   =  0;
    REG(u4GfxHwId, fg_KEYNOT_ENA)  = 0;
    REG(u4GfxHwId, fg_COLCHG_ENA)  = 0;
    REG(u4GfxHwId, fg_KEYSDSEL)    =  0;

    REG(u4GfxHwId, fg_COLOR_KEY_MIN) = 0;
    REG(u4GfxHwId, fg_COLOR_KEY_MAX) = 0xffffffff;
    REG(u4GfxHwId, fg_CFMT_ENA)      = 1;
    REG(u4GfxHwId, fg_YUVRGB_MODE)      = u4YuvRgbMode;

    if (GFX_CMDENQ(u4GfxHwId, GREG_KEY_DATA0)  |
        GFX_CMDENQ(u4GfxHwId, GREG_KEY_DATA1)  |
        GFX_CMDENQ(u4GfxHwId, GREG_ROP))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


INT32 GFX_24Bpp24BPP_SetBltOpt(UINT32 u4GfxHwId, UINT32 u4Switch, UINT32 u4ColorMin, UINT32 u4ColorMax)
{
    GFX_HW_FX_ENTRY;
    if ((u4Switch & D_GFXFLAG_TRANSPARENT) &&
        (u4Switch & D_GFXFLAG_COLORCHANGE))
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_TRANS_ENA)   = (u4Switch & D_GFXFLAG_TRANSPARENT) ? 1 : 0;
    REG(u4GfxHwId, fg_KEYNOT_ENA)  = (u4Switch & D_GFXFLAG_KEYNOT)      ? 1 : 0;
    REG(u4GfxHwId, fg_COLCHG_ENA)  = (u4Switch & D_GFXFLAG_COLORCHANGE) ? 1 : 0;
    
    REG(u4GfxHwId, fg_PRCN_OPTIONG_1555)   = (u4Switch & D_GFX_24Bpp24BPP_PRCN_1555) ? 1 : 0;
    REG(u4GfxHwId, fg_PRCN_KEY_1555)  = (u4Switch & D_GFX_24Bpp24BPP_PRCN_KEY_1555) ? 1 : 0;
    REG(u4GfxHwId, fg_ROUNDING_1555)  = (u4Switch & D_GFX_24Bpp24BPP_ROUND_1555) ? 1 : 0;
    REG(u4GfxHwId, fg_ROUNDING_4444)  = (u4Switch & D_GFX_24Bpp24BPP_ROUND_4444) ? 1 : 0;
    REG(u4GfxHwId, fg_ROUNDING_565)   = (u4Switch & D_GFX_24Bpp24BPP_ROUND_565)  ? 1 : 0;

    REG(u4GfxHwId, fg_COLOR_KEY_MIN) = u4ColorMin;
    REG(u4GfxHwId, fg_COLOR_KEY_MAX) = u4ColorMax;
    REG(u4GfxHwId, fg_CFMT_ENA)      = 0;

    if (GFX_CMDENQ(u4GfxHwId, GREG_KEY_DATA0)  |
        GFX_CMDENQ(u4GfxHwId, GREG_KEY_DATA1)  |
        GFX_CMDENQ(u4GfxHwId, GREG_G_256CPT)   |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE) )
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_BitBlt
 *  gfx bitblt.
 *  calculate output address.
 *  calculate input address.
 *  set bitblt op mode.
 *  set color conversion flag.
 *  enque output address register.
 *  enque input address register.
 *  enque size and clip registers.
 *  enque bitblp option register.
 *  enque mode register.
 */
//-------------------------------------------------------------------------

/*! \fn INT32 GFX_BitBlt(UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4Width, UINT32 u4Height)
    \this function set the bibblt parameters
    \param u4SrcX  x position of source
    \param u4SrcY  y position of source
    \param u4DstX  x position of destination
    \param u4DstY  y position of destination
    \param u4Width   width of bitblt rectangle
    \param u4Height  height of bitblt rectangle
    \retval INT32 if 0, the routine successful;else, the routine failed
*/
INT32 GFX_BitBlt(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4Width, UINT32 u4Height)
{
    UINT32 u4SrcAddr, u4DstAddr;

    GFX_HW_FX_ENTRY;

    //destination base address
    if(u4Height<=2048)
    {
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

        REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_BITBLT;
        REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
        REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
        REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
        REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

        VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
        VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
        GFX_VA_MSB_CMDENQ(u4GfxHwId);

        if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
            GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
            GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }
    }
    else
    {
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

        REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_BITBLT;
        REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
        REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
        REG(u4GfxHwId, fg_SRC_HEIGHT) = 2047;
        REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

        VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
        VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
        GFX_VA_MSB_CMDENQ(u4GfxHwId);

        if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
            GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
            GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + ((u4DstY + 2048) * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + ((u4SrcY + 2048) * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

        REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_BITBLT;
        REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
        REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
        REG(u4GfxHwId, fg_SRC_HEIGHT) = u4Height - 2049;
        REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

        VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
        VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
        GFX_VA_MSB_CMDENQ(u4GfxHwId);

        if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
            GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
            GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }
    }

    return (INT32)E_GFX_OK;

}

INT32 GFX_24Bpp24BPP_BitBlt(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4Width, UINT32 u4Height)
{
    UINT32 u4SrcAddr, u4DstAddr;

    GFX_HW_FX_ENTRY;
    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX * 3));
    REG(u4GfxHwId, fg_SRC_BSAD_24BPP) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_BITBLT;
    REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
    REG(u4GfxHwId, fg_SRC_WIDTH_24BPP)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT_24BPP) = (u4Height - 1);
    REG(u4GfxHwId, fg_SRC_CM_24BPP)= TRUE;
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

	VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
	VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);//fix bug,must write normal src_bsad_h
    VA_MSB_REG(u4GfxHwId, fg_SRC_24BPP_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);
		
    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_0x4154)       |
        GFX_CMDENQ(u4GfxHwId, GREG_0x4158)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

	Reset24BppFlag(u4GfxHwId);
    return (INT32)E_GFX_OK;
}


#ifdef GL_XOR
    //-------------------------------------------------------------------------
/** GFX_MirrorFlip
 *  gfx mirror flip.
 *  calculate output address.
 *  calculate input address.
 *  set bitblt op mode.
 *  set color conversion flag.
 *  enque output address register.
 *  enque input address register.
 *  enque size and clip registers.
 *  enque bitblp option register.
 *  enque mode register.
 */
//-------------------------------------------------------------------------

/*! \fn INT32 GFX_MirrorFlip(UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4Width, UINT32 u4Height,UINT32 u4MirrorOpt)
    \this function set the bibblt parameters
    \param u4SrcX  x position of source
    \param u4SrcY  y position of source
    \param u4DstX  x position of destination
    \param u4DstY  y position of destination
    \param u4Width   width of bitblt rectangle
    \param u4Height  height of bitblt rectangle
    \param u4MirrorOpt  mirror operation address increase or decrease
    \retval INT32 if 0, the routine successful;else, the routine failed
*/
INT32 GFX_MirrorFlip(UINT32 u4GfxHwId,
    UINT32 u4SrcX,
    UINT32 u4SrcY,
    UINT32 u4DstX,
    UINT32 u4DstY,
    UINT32 u4Width,
    UINT32 u4Height,
    EGFX_BITBLT_OPT_T u4Opt,
    UINT8 u1AddOpt)
{
    UINT32 u4SrcWidth = 0;
    UINT32 u4SrcHeight = 0;
    UINT32 u4SrcAddr, u4DstAddr;

    GFX_HW_FX_ENTRY;

    if (E_BITBLT_SRC_MIRROR == u4Opt)
    {
        u4SrcWidth = u4SrcX + u4Width - 1;
        u4SrcHeight = u4SrcY;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) = u1AddOpt; //0-address increase  1- address decrease
    }
    else if (E_BITBLT_SRC_FLIP == u4Opt)
    {
        u4SrcWidth = u4SrcX;
        u4SrcHeight = u4SrcY + u4Height - 1;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) = u1AddOpt; //0-address increase  1- address decrease
    }
    else if (E_BITBLT_SRC_FLIPMIRROR == u4Opt)
    {
        u4SrcWidth = u4SrcX + u4Width -1;
        u4SrcHeight = u4SrcY + u4Height- 1;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) = u1AddOpt; //0-address increase  1- address decrease
        REG(u4GfxHwId, fg_SRC_MIRR_OR) = u1AddOpt; //0-address increase  1- address decrease
    }
    else if( E_BITBLT_NORMAL ==  u4Opt )
    {
        u4SrcWidth = u4SrcX ;
        u4SrcHeight = u4SrcY ;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) = u1AddOpt; //0-address increase  1- address decrease
        REG(u4GfxHwId, fg_SRC_MIRR_OR) = u1AddOpt;
    }
    else
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcHeight * _u4SrcPitch[u4GfxHwId]) + (u4SrcWidth << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_BITBLT;
    REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    
    REG(u4GfxHwId, fg_SRC_HEIGHT)     =(u4Height -1);     

    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetMirrorFlipFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}


#endif


INT32 GFX_BitBlt2(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4Width, UINT32 u4Height, UINT32 u4op)
{
    UINT32 u4SrcAddr, u4DstAddr;

    GFX_HW_FX_ENTRY;
    //destination base address
  switch(u4op)
  {
    case E_BITBLT_SRC_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4Width-1)<< _u4SrcShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DSTPITCH_DEC) =0;
        REG(u4GfxHwId, fg_DST_MIRR_OR) =0;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) =0;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) =1;
        break;
    case E_BITBLT_SRC_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + ((u4SrcY+u4Height-1) * _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DSTPITCH_DEC) =0;
        REG(u4GfxHwId, fg_DST_MIRR_OR) =0;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) =1;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) =0;
        break;
    case E_BITBLT_SRC_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + ((u4SrcY+u4Height-1) * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4Width-1)<< _u4SrcShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DSTPITCH_DEC) =0;
        REG(u4GfxHwId, fg_DST_MIRR_OR) =0;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) =1;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) =1;
        break;
    case E_BITBLT_DST_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) + ((u4DstX+u4Width-1) << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DSTPITCH_DEC) =0;
        REG(u4GfxHwId, fg_DST_MIRR_OR) =1;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) =0;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) =0;
        break;
    case E_BITBLT_DST_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + ((u4DstY  +u4Height-1)* _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY* _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DSTPITCH_DEC) =1;
        REG(u4GfxHwId, fg_DST_MIRR_OR) =0;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) =0;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) =0;
        break;
    case E_BITBLT_DST_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + ((u4DstY  +u4Height-1)* _u4DstPitch[u4GfxHwId]) + ((u4DstX+u4Width-1) << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY* _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DSTPITCH_DEC) =1;
        REG(u4GfxHwId, fg_DST_MIRR_OR) =1;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) =0;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) =0;
        break;
      default:
        return -1;
    }

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_BITBLT;
    REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

#if 0 /* msz00247 remove for random bug */
    GFX_Flush();
    GFX_Wait();
#endif

    GFX_Flush(u4GfxHwId);
    ResetMirrorFlipFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

INT32 GFX_BitBlt_NewMethod(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4Width, UINT32 u4Height)
{
    UINT32 u4DstAddr, u4SrcAddr;
    UINT32 u4BppWidth;

    GFX_HW_FX_ENTRY;
    u4BppWidth = u4Width<<_u4DstShift[u4GfxHwId];
    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_OP_MODE)     = (UINT32)OP_BITBLT;
    REG(u4GfxHwId, fg_CFMT_ENA)    = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
    REG(u4GfxHwId, fg_SRC_WIDTH)   = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)  = (u4Height - 1);
    if (u4BppWidth > 32)
    {
    REG(u4GfxHwId, fg_BARREL_ENA)  = 1;
    REG(u4GfxHwId, fg_PASS_ALU_ENA)= 1;
    }
    else // MT8530,MT8550,MT8555,MT8560 has this limitation.
    { // bppWidth <= 32, use normal bitblt.
        REG(u4GfxHwId, fg_BARREL_ENA)  = 0;
        REG(u4GfxHwId, fg_PASS_ALU_ENA)= 0;
    }
    REG(u4GfxHwId, fg_FIRE)        = GFX_ENGINE_FIRE;

	VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);
	
    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    //[YgLi][20090218](Must Clean the two bits after blt complete, Or, maybe effects others function, such as compose)
    REG(u4GfxHwId, fg_BARREL_ENA)  = 0;
    REG(u4GfxHwId, fg_PASS_ALU_ENA)= 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
#if 0 /* msz00247 remove for random bug */
    GFX_Flush();
    GFX_Wait();
#endif

    return (INT32)E_GFX_OK;
}
//-------------------------------------------------------------------------
/** GFX_RopBitblt
 *  gfx RopBitblt.
 *  calculate output address.
 *  calculate input address.
 *  set bitblt op mode.
 *  set color conversion flag.
 *  enque output address register.
 *  enque input address register.
 *  enque size and clip registers.
 *  enque bitblp option register.
 *  enque mode register.
 */
//-------------------------------------------------------------------------
INT32 GFX_RopBitblt(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4Width, UINT32 u4Height, UINT32 u4RopCode)
{
    UINT32 u4SrcAddr, u4DstAddr;

    GFX_HW_FX_ENTRY;
    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_SRCALPHA_CHECK)    = 1;
    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_ROP_BITBLT;
    REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_ROP_OPCODE) = u4RopCode;
    REG(u4GfxHwId, fg_NO_WR)      = GFX_DISABLE;  ///??
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
		GFX_CMDENQ(u4GfxHwId, GREG_ROP)            |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_RopBitbltEx
 *  gfx RopBitblt.
 *  calculate output address.
 *  calculate input address.
 *  set bitblt op mode.
 *  set color conversion flag.
 *  enque output address register.
 *  enque input address register.
 *  enque size and clip registers.
 *  enque bitblp option register.
 *  enque mode register.
 */
//-------------------------------------------------------------------------
INT32 GFX_RopBitbltEx(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4Width, UINT32 u4Height, UINT32 u4RopCode, UINT32 u4JavaXorClr)
{
    UINT32 u4SrcAddr, u4DstAddr;
    GFX_HW_FX_ENTRY;
    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);


    REG(u4GfxHwId, fg_JAVA_XOR_COLOR)    = (UINT32)u4JavaXorClr;

#if 0 //(CONFIG_CHIP_VER_CURR >= CONFIG_CHIP_VER_MT8555)||(CONFIG_CHIP_VER_CURR == CONFIG_CHIP_VER_MT3363)
	REG(u4GfxHwId, fg_SRCALPHA_CHECK)    = 1;
#endif
    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_ROP_BITBLT;
    REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_ROP_OPCODE) = u4RopCode;
    REG(u4GfxHwId, fg_NO_WR)      = GFX_DISABLE;  ///??
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_XOR_COLOR)      |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
		GFX_CMDENQ(u4GfxHwId, GREG_ROP)            |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_SetIdx2DirOpt
 *  gfx set index to direct color bitblt option.
 *  set palette start address in bytes in DRAM (must 16 bytes aligned)
 *  set flag of left pixel index location in one byte of source.
 *  set flag of source line start byte aligned.
 *  enque idx2dir registers.
 */
//-------------------------------------------------------------------------
INT32 GFX_SetIdx2DirOpt(UINT32 u4GfxHwId, UINT8 *pu1PaletteBase, UINT32 u4MsbLeft,
    UINT32 u4StartByteAligned)
{
    // check 128 bits (16 bytes) alignment
    if (((UINT32)pu1PaletteBase) & 0xF)
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_PAL_BSAD)      = GFX_PHYSICAL_SAFE(pu1PaletteBase);
    REG(u4GfxHwId, fg_MSB_LEFT)      = u4MsbLeft;
    REG(u4GfxHwId, fg_LN_ST_BYTE_AL) = u4StartByteAligned;

    VA_PAL_MSB_REG(u4GfxHwId, fg_PAL_BSAD_H, (UINT32)pu1PaletteBase) ;
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_IDX2DIR))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_Idx2DirBitBlt
 *  gfx index to direct color bitblt.
 *  gfx.op.idx2dirblt {sx} {sy} {dx} {dy} {w} {h} {palette} {msb_left} {sb_align}
 */
//-------------------------------------------------------------------------
INT32 GFX_Idx2DirBitblt(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4Width, UINT32 u4Height, UINT8 *pv_pal_base,
    UINT32 u4MsbLeft, UINT32 u4StartByteAligned)
{
    UINT32 u4SrcAddr, u4DstAddr;
    GFX_HW_FX_ENTRY;
    /* must be OW aligned */
    if ( ((UINT32)pv_pal_base) & 0xf )
    {
        return E_GFX_INV_ARG;
    }
    /* destination base address */
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    /* source base address */
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_CHAR_CM)    = _u4CharCM[u4GfxHwId];
    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_IDX2DIR_BITBLT;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_LN_ST_BYTE_AL) = u4StartByteAligned;
    REG(u4GfxHwId, fg_MSB_LEFT)   = u4MsbLeft;
    REG(u4GfxHwId, fg_PAL_BSAD)   = GFX_PHYSICAL_SAFE(pv_pal_base);
#if 0
    if (IC_VER_A == BSP_GetIcVersion())
    {
        GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, GFX_READ32(u4GfxHwId,GFX_REG_G_CONFIG) & (~1));

        GFX_WRITE32(u4GfxHwId, GFX_REG_IDX2DIR, ((UINT32)pv_pal_base & 0x3FFFFFFF));

        u4Val = GFX_READ32(u4GfxHwId, GFX_REG_G_256CPT);
        u4Val |= 0x7;
        GFX_WRITE32(u4GfxHwId, GFX_REG_G_256CPT, u4Val);

        u4Val = GFX_READ32(u4GfxHwId, GFX_REG_G_MODE);
        GFX_WRITE32(u4GfxHwId, GFX_REG_G_MODE, u4Val | 0x20);

        while (GFX_READ32(u4GfxHwId, GFX_REG_G_256CPT) & 0x01);

        GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG) | 0x1);

        REG(u4GfxHwId, fg_IDX2DIR_EN)   = 1;
        REG(u4GfxHwId, fg_CPT_DRAM_EN)  = 1;
        REG(u4GfxHwId, fg_USE_256CPT)   = 1;
    }
    else
 #endif
    {
        REG(u4GfxHwId, fg_IDX2DIR_EN)   = 1;
        REG(u4GfxHwId, fg_CPT_DRAM_EN)  = 1;
        REG(u4GfxHwId, fg_USE_256CPT)   = 1;
        REG(u4GfxHwId, fg_256CPT_FIRE)  = 1;
    }

    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    VA_PAL_MSB_REG(u4GfxHwId, fg_PAL_BSAD_H, ((UINT32)pv_pal_base));
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_IDX2DIR)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_256CPT)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        REG(u4GfxHwId, fg_IDX2DIR_EN)   = 0;
        REG(u4GfxHwId, fg_CPT_DRAM_EN)  = 0;
        REG(u4GfxHwId, fg_USE_256CPT)   = 0;
        REG(u4GfxHwId, fg_256CPT_FIRE)  = 0;
        REG(u4GfxHwId, fg_LN_ST_BYTE_AL) = 0;
        REG(u4GfxHwId, fg_MSB_LEFT)   = 0;
        GFX_Flush(u4GfxHwId);
        GFX_CMDENQ(u4GfxHwId, GREG_IDX2DIR);
        GFX_CMDENQ(u4GfxHwId, GREG_G_256CPT) ;
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    //GFX_Flush(u4GfxHwId);
    ResetI2DFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_Idx2DirBitBlt
 *  gfx index to direct color bitblt.
 *  gfx.op.idx2dirblt {sx} {sy} {dx} {dy} {w} {h} {palette} {msb_left} {sb_align}
 */
//-------------------------------------------------------------------------
INT32 GFX_Idx2DirBitbltEx(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY,
    UINT32 u4Width, UINT32 u4Height, UINT32 u4SrcPitchEn, UINT8 *pv_pal_base,
    UINT32 u4MsbLeft, UINT32 u4StartByteAligned)
{
    UINT32 u4SrcAddr, u4DstAddr;

    GFX_HW_FX_ENTRY;
    /* must be OW aligned */
    if ( ((UINT32)pv_pal_base) & 0xf )
    {
        return E_GFX_INV_ARG;
    }
    /* destination base address */
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    /* source base address */
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_CHAR_CM)    = _u4CharCM[u4GfxHwId];
    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_IDX2DIR_BITBLT;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
    REG(u4GfxHwId, fg_SRC_PITCH_ENA) = 0;//u4SrcPitchEn;//
    REG(u4GfxHwId, fg_LN_ST_BYTE_AL) = u4SrcPitchEn ? 1 : u4StartByteAligned;
    REG(u4GfxHwId, fg_MSB_LEFT)   = u4MsbLeft;
    REG(u4GfxHwId, fg_PAL_BSAD)   = GFX_PHYSICAL_SAFE(pv_pal_base);
#if 0
    if (IC_VER_A == BSP_GetIcVersion())
    {
        GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, GFX_READ32(u4GfxHwId,GFX_REG_G_CONFIG) & (~1));

        GFX_WRITE32(u4GfxHwId, GFX_REG_IDX2DIR, ((UINT32)pv_pal_base & 0x3FFFFFFF));

        u4Val = GFX_READ32(u4GfxHwId, GFX_REG_G_256CPT);
        u4Val |= 0x7;
        GFX_WRITE32(u4GfxHwId, GFX_REG_G_256CPT, u4Val);

        u4Val = GFX_READ32(u4GfxHwId, GFX_REG_G_MODE);
        GFX_WRITE32(u4GfxHwId, GFX_REG_G_MODE, u4Val | 0x20);

        while (GFX_READ32(u4GfxHwId, GFX_REG_G_256CPT) & 0x01);

        GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG) | 0x1);

        REG(u4GfxHwId, fg_IDX2DIR_EN)   = 1;
        REG(u4GfxHwId, fg_CPT_DRAM_EN)  = 1;
        REG(u4GfxHwId, fg_USE_256CPT)   = 1;
    }
    else
 #endif
    {
        REG(u4GfxHwId, fg_IDX2DIR_EN)   = 1;
        REG(u4GfxHwId, fg_CPT_DRAM_EN)  = 1;
        REG(u4GfxHwId, fg_USE_256CPT)   = 1;
        REG(u4GfxHwId, fg_256CPT_FIRE)  = 1;
    }

    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    VA_PAL_MSB_REG(u4GfxHwId, fg_PAL_BSAD_H, ((UINT32)pv_pal_base));
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_IDX2DIR)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_256CPT)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        REG(u4GfxHwId, fg_IDX2DIR_EN)   = 0;
        REG(u4GfxHwId, fg_CPT_DRAM_EN)  = 0;
        REG(u4GfxHwId, fg_USE_256CPT)   = 0;
        REG(u4GfxHwId, fg_256CPT_FIRE)  = 0;
        REG(u4GfxHwId, fg_LN_ST_BYTE_AL) = 0;
        REG(u4GfxHwId, fg_MSB_LEFT)   = 0;
        GFX_Flush(u4GfxHwId);
        GFX_CMDENQ(u4GfxHwId, GREG_IDX2DIR);
        GFX_CMDENQ(u4GfxHwId, GREG_G_256CPT) ;
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetI2DFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_SetHoriToVertLineOpt
 *  Set DSTPITCH_DEC 0 or 1 to determine whether the bitmap
 *  rotated by 90" clockwise or counterclockwise.
 */
//-------------------------------------------------------------------------
INT32 GFX_SetHoriToVertLineOpt(UINT32 u4GfxHwId, UINT32 u4IsCounterClockWise)
{
    REG(u4GfxHwId, fg_DSTPITCH_DEC) = u4IsCounterClockWise;
    return GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
}


//-------------------------------------------------------------------------
/** GFX_HoriToVertLine
 *  gfx horizontal line to vertical line operation.
 *  calculate output address.
 *  calculate input address.
 *  enque output address register.
 *  enque input address register.
 *  enque width and height registers.
 *  enque str_width and str_height registers.
 *  enque mode register.
 */
//-------------------------------------------------------------------------
INT32 GFX_HoriToVertLine(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX,
    UINT32 u4DstY, UINT32 u4HoriLineWidth, INT32 u4Is90CCW)
{
    UINT32 u4SrcAddr, u4DstAddr;

    GFX_HW_FX_ENTRY;
    VERIFY(u4HoriLineWidth != 0);

    /* must be OW aligned */

    /* destination base address */
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);

    /* source base address */
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_H2V_LINE;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4HoriLineWidth;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = 0;
    REG(u4GfxHwId,fg_STR_DST_WIDTH) = 1;
    REG(u4GfxHwId, fg_STR_DST_HEIGHT) = (u4HoriLineWidth - 1);
    REG(u4GfxHwId, fg_DSTPITCH_DEC) = u4Is90CCW;
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if ( GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH)  |
        GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)        |
        GFX_CMDENQ(u4GfxHwId, GREG_STR_DST_SIZE)  |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)   |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    //[YgLi][20090218](Must Clean the two bits after blt complete, Or, maybe effects others function, such as compose)
    REG(u4GfxHwId, fg_DSTPITCH_DEC) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);
    return (INT32)E_GFX_OK;
}

#if 0
static UINT32 _GetGfxBytrPerPixel(UINT32 u4GfxHwId,UINT32 u4DrvColorMode)
{
    switch (u4DrvColorMode)
    {
    case CM_YCbCr_CLUT8:
