 */
//-------------------------------------------------------------------------
INT32 GFX_RopJavaXorMFilp(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
