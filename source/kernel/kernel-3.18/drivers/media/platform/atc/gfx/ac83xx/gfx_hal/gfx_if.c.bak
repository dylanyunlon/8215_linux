    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    switch (u4MFOp)
    {
    case E_BITBLT_SRC_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            (u4SrcY * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4SrcW-1)<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            ((u4SrcY+u4SrcH-1) * _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            ((u4SrcY+u4SrcH-1) * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4SrcW-1)<< _u4SrcShift[u4GfxHwId]));
        break;
#if 0
    case E_BITBLT_DST_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase +
            (u4DstY * _u4DstPitch) + ((u4DstX+u4DstW-1) << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
            (u4SrcY * _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;
    case E_BITBLT_DST_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase +
            ((u4DstY  +u4DstH-1)* _u4DstPitch) + (u4DstX << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
            (u4SrcY* _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;

    case E_BITBLT_DST_MIRROR_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase +
            ((u4DstY  +u4DstH-1)* _u4DstPitch) + ((u4DstX+u4DstW-1) << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
            (u4SrcY* _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;
#endif
    default:
        return E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4SrcH - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // Mirror/Flip part
    GFX_SetMirrorFlipOpt(u4GfxHwId, u4MFOp);

    // Stretch part
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Rotate part
    GFX_SetRotateOpt(u4GfxHwId, TRUE, u4Is90CCW);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_STRETCH_BITBLT;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetMirrorFlipFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
*  gfx alpha composition loop mode.
*
*/
//-------------------------------------------------------------------------
INT32 GFX_AlphaComposeLoopRotate(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY,
                                 UINT32 u4DstX, UINT32 u4DstY, UINT32 u4Width,
                                 UINT32 u4Height, UINT32 u4Ar, UINT32 u4OpCode,
                                 UINT32 u4RectSrc, UINT32 u4AlcomNormal,
                                 UINT32 u4Is90CCW)
{
#if 1
    INT32 i4MhpPatch = GFX_DISABLE;
    UINT32 u4SrcAddr, u4DstAddr;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    if (u4AlcomNormal)
    {
        u4Ar = 255;
    }

    // Add CLEAR, SRC, SRC_OVER patches for MHP project
    // 1. CLEAR    -> use Rect Fill (fill 0x0 in rect_color)
    // 2. SRC      -> use Pass0 and Pass5 of Alpha Composition
    // 3. SRC_OVER -> consider two corner cases
    //          case1: Ar=1.0 & As=1.0
    //          case2: Ar=1.0 & As=0.0
    //          note: Ar=0.0 is the same as case2
    if (((UINT32)CM_ARGB8888_DIRECT32 == _u4SrcCM[u4GfxHwId]) &&
        ((UINT32)CM_ARGB8888_DIRECT32 == _u4DstCM[u4GfxHwId]) &&
        (GFX_ENABLE == i4MhpPatch))
    {
        if ((UINT32)E_AC_CLEAR == u4OpCode)
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_Fill(u4GfxHwId, u4DstX, u4DstY, u4Width, u4Height);

            // restore original value
            GFX_SetColor(u4GfxHwId, u4RectColor);
            return (INT32)E_GFX_OK;
        }
        else if ((UINT32)E_AC_SRC == u4OpCode)
        {
            if (0 == u4Ar)
            {
                UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

                GFX_SetColor(u4GfxHwId, 0x0);
                GFX_Fill(u4GfxHwId, u4DstX, u4DstY, u4Width, u4Height);

                // restore original value
                GFX_SetColor(u4GfxHwId, u4RectColor);
                return (INT32)E_GFX_OK;
            }
            else if(255 == u4Ar)
            {
                UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

                GFX_SetColor(u4GfxHwId, 0x0);
                GFX_SetBltOpt(u4GfxHwId, (UINT32)D_GFXFLAG_NONE, 0x00000000, 0xffffffff);

                GFX_SetAlpha(u4GfxHwId, u4Ar);

                GFX_BitBlt(u4GfxHwId, u4SrcX, u4SrcY, u4DstX, u4DstY, u4Width, u4Height);
                // restore original value
                GFX_SetColor(u4GfxHwId, u4RectColor);
                return (INT32)E_GFX_OK;
            }
        }
        else if (((UINT32)E_AC_SRC_OVER == u4OpCode) &&
            (0 == u4Ar))
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);
            UINT32 u4MinColor  = REG(u4GfxHwId, fg_COLOR_KEY_MIN);
            UINT32 u4MaxColor  = REG(u4GfxHwId, fg_COLOR_KEY_MAX);
            UINT32 u4Switch    = 0x0;

            if (REG(u4GfxHwId, fg_TRANS_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_TRANSPARENT);
            }

            if (REG(u4GfxHwId, fg_KEYNOT_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYNOT);
            }

            if (REG(u4GfxHwId, fg_COLCHG_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_COLORCHANGE);
            }

            if (REG(u4GfxHwId, fg_KEYSDSEL))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYSDSEL);
            }

            // BitBlt with ColorChange (from Dst to Dst)
            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_SetBltOpt(u4GfxHwId, D_GFXFLAG_COLORCHANGE, 0x00000000, 0x00FFFFFF);

            // set new src & dst pitch
            REG(u4GfxHwId, fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4DstPitch[u4GfxHwId] >> 4;

            u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) +
                (u4DstX << _u4DstShift[u4GfxHwId]));
            u4SrcAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) +
                (u4DstX << _u4DstShift[u4GfxHwId]));
            REG(u4GfxHwId, fg_DST_BSAD)  = GFX_PHYSICAL(u4DstAddr);
            REG(u4GfxHwId, fg_SRC_BSAD)  = GFX_PHYSICAL(u4SrcAddr);

            REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_BITBLT;
            REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
            REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
            REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
            REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

            VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
            VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4DstAddr); // look up REG(u4GfxHwId, fg_SRC_BSAD)
            GFX_VA_MSB_CMDENQ(u4GfxHwId);

            if (GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH)    |
                GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
                GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
                GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }

            // restore original value
            REG(u4GfxHwId, fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4SrcPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
            GFX_SetColor(u4GfxHwId, u4RectColor);
            GFX_SetBltOpt(u4GfxHwId, u4Switch, u4MinColor, u4MaxColor);
            if (GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH) |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)    |
                GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }
            return (INT32)E_GFX_OK;
        }
        else
        {
            //do nothing, for lint happy
        }
    }

    // normal compose in LOOP mode

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));

    REG(u4GfxHwId, fg_DST_BSAD)  = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)  = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4Height - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    // Rotate part
    GFX_SetRotateOpt(u4GfxHwId, TRUE, u4Is90CCW);

    GFX_Disable2SrcBlending();
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_ALCOM_AR)       = u4Ar;
    REG(u4GfxHwId, fg_ALCOM_OPCODE)   = u4OpCode;
    REG(u4GfxHwId, fg_ALCOM_RECT_SRC) = u4RectSrc;
    REG(u4GfxHwId, fg_ALCOM_NORMAL) = u4AlcomNormal;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP)     |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    //[YgLi][20090218](Must Clean the two bits after blt complete, Or, maybe effects others function, such as compose)
    SetRotate(u4GfxHwId, 0);
    REG(u4GfxHwId, fg_DSTPITCH_DEC) = 0;
    REG(u4GfxHwId, fg_DST_MIRR_OR)  = 0;
    REG(u4GfxHwId, fg_SRCPITCH_DEC) = 0;
    REG(u4GfxHwId, fg_SRC_MIRR_OR)  = 0;

#if GFX_IOMMU_WORKAROUND_BEFORE_ECO
    if (fgRunBelowSegmentBefore(IC_8560_VER_A)) //for before 8560ECO
    {
    	REG(u4GfxHwId, fg_ALCOM_OPCODE)   = (UINT32)0; //add by +e
		GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP);
    }
#endif

    return (INT32)E_GFX_OK;
#else
    if (_u4SrcCM != _u4DstCM)
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    if (_u4DstShift != _u4SrcShift)
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_DST_BSAD) = (UINT32)(_pu1DstBase +
        (u4DstY * _u4DstPitch) + (u4DstX << _u4DstShift));
    REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1SrcBase +
        (u4SrcY * _u4SrcPitch) + (u4SrcX << _u4SrcShift));

    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4Height - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // Rotate part
    GFX_SetRotateOpt(u4GfxHwId, TRUE, u4Is90CCW);

    // loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlcomNormal, u4Ar, u4OpCode, u4RectSrc);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    //[YgLi][20090218](Must Clean the two bits after blt complete, Or, maybe effects others function, such as compose)
    SetRotate(u4GfxHwId, 0);
    REG(u4GfxHwId, fg_DSTPITCH_DEC) = 0;

    return (INT32)E_GFX_OK;
#endif
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
*  gfx alpha composition loop mode.
*
*/
//-------------------------------------------------------------------------
INT32 GFX_AlphaComposeLoopMFlip(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY,
                                UINT32 u4DstX, UINT32 u4DstY, UINT32 u4Width,
                                UINT32 u4Height, UINT32 u4Ar, UINT32 u4OpCode,
                                UINT32 u4RectSrc, UINT32 u4AlcomNormal,
                                UINT32 u4MFOp)
{
    UINT32 u4SrcAddr, u4DstAddr;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    switch (u4MFOp)
    {
    case E_BITBLT_SRC_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            (u4SrcY * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4Width-1)<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            ((u4SrcY+u4Height-1) * _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            ((u4SrcY+u4Height-1) * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4Width-1)<< _u4SrcShift[u4GfxHwId]));
        break;
#if 0
    case E_BITBLT_DST_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase +
            (u4DstY * _u4DstPitch) + ((u4DstX+u4-1) << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
            (u4SrcY * _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;
    case E_BITBLT_DST_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase +
            ((u4DstY  +u4DstH-1)* _u4DstPitch) + (u4DstX << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
            (u4SrcY* _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;

    case E_BITBLT_DST_MIRROR_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase +
            ((u4DstY  +u4DstH-1)* _u4DstPitch) + ((u4DstX+u4DstW-1) << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
            (u4SrcY* _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;
#endif
    default:
        return E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4Height - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // Mirror/Flip part
    GFX_SetMirrorFlipOpt(u4GfxHwId, u4MFOp);

    // loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlcomNormal, u4Ar, u4OpCode, u4RectSrc);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetMirrorFlipFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
*  gfx alpha composition loop mode.
*
*/
//-------------------------------------------------------------------------
INT32 GFX_AlphaComposeLoopRotateMFlip(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY,
                                UINT32 u4DstX, UINT32 u4DstY, UINT32 u4Width,
                                UINT32 u4Height, UINT32 u4Ar, UINT32 u4OpCode,
                                UINT32 u4RectSrc, UINT32 u4AlcomNormal,
                                UINT32 u4Is90CCW, UINT32 u4MFOp)
{
    UINT32 u4SrcAddr, u4DstAddr;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    switch (u4MFOp)
    {
    case E_BITBLT_SRC_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            (u4SrcY * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4Width-1)<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            ((u4SrcY+u4Height-1) * _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            ((u4SrcY+u4Height-1) * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4Width-1)<< _u4SrcShift[u4GfxHwId]));
        break;
#if 0
    case E_BITBLT_DST_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase +
            (u4DstY * _u4DstPitch) + ((u4DstX+u4-1) << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
            (u4SrcY * _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;
    case E_BITBLT_DST_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase +
            ((u4DstY  +u4DstH-1)* _u4DstPitch) + (u4DstX << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
            (u4SrcY* _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;

    case E_BITBLT_DST_MIRROR_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase +
            ((u4DstY  +u4DstH-1)* _u4DstPitch) + ((u4DstX+u4DstW-1) << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
            (u4SrcY* _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;
#endif
    default:
        return E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4Height - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // Mirror/Flip part
    GFX_SetMirrorFlipOpt(u4GfxHwId, u4MFOp);

    // Rotate part
    GFX_SetRotateOpt(u4GfxHwId, TRUE, u4Is90CCW);

    // loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlcomNormal, u4Ar, u4OpCode, u4RectSrc);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetRotateMirrorFlipFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_StretchMFlipJavaXor(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                              UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH,
                              UINT32 u4MFOp, UINT32 u4JavaXorClr)
{
    UINT32 u4SrcAddr, u4DstAddr;

