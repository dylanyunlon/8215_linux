#if GFX_REDUCE_WORKINGBUF
void GFX_FreeBottomWorkingBuffer(UINT32 u4GfxHwId)
{
    /*if (pvBuffer != prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBuf)
    {
        UTIL_Printf("[gfx] GFX_FreeBottomWorkingBuffer buffer error\n");
        ASSERT(0);
    }*/

    if (!(prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree))
    {
        return;
    }

#if 1//CONFIG_SYS_MEM_PHASE2
    GFX_FREE_ALGN_MEM(prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree);
#elif CONFIG_SYS_MEM_PHASE3
    #if CONFIG_ENABLE_IOMMU
    x_mem_vfree(prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree);
    #else
    x_kmem_block_aligned_free((HANDLE_T)(prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree));
    #endif
#else
    GFX_MEM_FREE(prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree);
#endif

    prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree = NULL;
    prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBuf = NULL;

    UTIL_Printf("[gfx] GFX_FreeBottomWorkingBuffer buffer Free\n");
}
#endif

void  GFX_WorkingbufInit(void)
{
#if 0
    if (NULL_HANDLE == _semGfxWorkingBuffer1)
    {
        VERIFY(x_sema_create(&_semGfxWorkingBuffer1, X_SEMA_TYPE_BINARY,
            X_SEMA_STATE_UNLOCK) == OSR_OK);
    }

    if (NULL_HANDLE == _semGfxWorkingBuffer2)
    {
        VERIFY(x_sema_create(&_semGfxWorkingBuffer2, X_SEMA_TYPE_BINARY,
            X_SEMA_STATE_UNLOCK) == OSR_OK);
    }
#endif
    /*each working buffer can be used by each HW thread only */
    UINT32 ui4_i = 0;
    while ( ui4_i < GFX_HAL_HW_INST_NUM)
    {
#if 1//CONFIG_SYS_MEM_PHASE2
        pvWokingBuffer[ui4_i] = GFX_ALLOC_ALGN_MEM(GFX_WORKINGBUFFER_SIZE, 16);
#elif CONFIG_SYS_MEM_PHASE3
    #if CONFIG_ENABLE_IOMMU
        pvWokingBuffer[ui4_i] = x_mem_valloc(GFX_WORKINGBUFFER_SIZE);
    #else
        hWokingBufHandle[ui4_i] = x_kmem_block_aligned_alloc(GFX_WORKINGBUFFER_SIZE, 16);
        pvWokingBuffer[ui4_i] = x_kmem_kernel_address(hWokingBufHandle[ui4_i], 0);
    #endif
#else
        UTIL_Printf(" NO CONFIG_SYS_MEM_PHASE2 \r\n");
        pvWokingBufferFree[ui4_i] = GFX_MEM_ALLOC(GFX_WORKINGBUFFER_SIZE + 15);
        pvWokingBuffer[ui4_i]= (void*)(((UINT32)pvWokingBufferFree[ui4_i] +15)&(~15));
#endif

#if !(GFX_REDUCE_WORKINGBUF)
        //pvWokingBufferFree2[ui4_i] = GFX_MEM_ALLOC(GFX_WORKINGBUFFER_SIZE + 15);
        //pvWokingBuffer2[ui4_i]= (void*)(((UINT32)pvWokingBufferFree2[ui4_i] +15)&(~15));
        pvWokingBuffer2[ui4_i] =(void*) ((UINT32)pvWokingBuffer[ui4_i] + GFX_WORKINGBUFFER_SIZE/2);
#else
        prGfxReduceBottomWorkingBuf[ui4_i].pvBottomBuf = NULL;
        prGfxReduceBottomWorkingBuf[ui4_i].pvBottomBufFree = NULL;
#endif

        ui4_i++ ;
    }

}
void GFX_GetWorkingBufferHeight(UINT32 u4GfxHwId, void** ppvBuffer, UINT32 ui4_pitch,UINT32 *pui4_height)
{
    *pui4_height = GFX_WORKINGBUFFER_SIZE /ui4_pitch;
     *ppvBuffer = pvWokingBuffer[u4GfxHwId];

#if GFX_REDUCE_WORKINGBUF
    GFX_FreeBottomWorkingBuffer(u4GfxHwId);
#endif
}

