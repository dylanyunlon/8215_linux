//-------------------------------------------------------------------------
/** GFX_ColorMap
 *  gfx set COLORMAP mode
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_ColorMap(UINT32 u4GfxHwId, UINT32 u4BmpCM, UINT32 u4CM, const UINT32 *psu4ColorMap)
{
    if (NULL == psu4ColorMap)
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    if ((UINT32)E_BMP_CM_2BIT == u4BmpCM)
    {
        switch (u4CM)
        {
        case CM_YCbCr_CLUT8:
        case CM_RGB_CLUT8:
            REG(u4GfxHwId, fg_COLOR_TRANS0) =
                ( psu4ColorMap[0] & 0xff)           |
                ((psu4ColorMap[1] & 0xff) << 8)     |
                ((psu4ColorMap[2] & 0xff) << 16)    |
                ((psu4ColorMap[3] & 0xff) << 24);
            break;

        case CM_RGB565_DIRECT16:
        case CM_ARGB1555_DIRECT16:
        case CM_ARGB4444_DIRECT16:
            REG(u4GfxHwId, fg_COLOR_TRANS0) =
                ( psu4ColorMap[0] & 0xffff)         |
                ((psu4ColorMap[1] & 0xffff) << 16);
            REG(u4GfxHwId, fg_COLOR_TRANS1) =
                ( psu4ColorMap[2] & 0xffff)         |
                ((psu4ColorMap[3] & 0xffff) << 16);
            break;

        case CM_AYCbCr8888_DIRECT32:
        case CM_ARGB8888_DIRECT32:
            REG(u4GfxHwId, fg_COLOR_TRANS0) = psu4ColorMap[0];
            REG(u4GfxHwId, fg_COLOR_TRANS1) = psu4ColorMap[1];
            REG(u4GfxHwId, fg_COLOR_TRANS2) = psu4ColorMap[2];
            REG(u4GfxHwId, fg_COLOR_TRANS3) = psu4ColorMap[3];
            break;

        default:
            return -(INT32)E_GFX_INV_ARG;
        }
    }
    else if ((UINT32)E_BMP_CM_4BIT == u4BmpCM)
    {
        switch (u4CM)
        {
        case CM_YCbCr_CLUT8:
        case CM_RGB_CLUT8:
            REG(u4GfxHwId, fg_COLOR_TRANS0) =
                ( psu4ColorMap[0] & 0xff)           |
                ((psu4ColorMap[1] & 0xff) << 8)     |
                ((psu4ColorMap[2] & 0xff) << 16)    |
                ((psu4ColorMap[3] & 0xff) << 24);
            REG(u4GfxHwId, fg_COLOR_TRANS1) =
                ( psu4ColorMap[4] & 0xff)        |
                ((psu4ColorMap[5] & 0xff) << 8)     |
                ((psu4ColorMap[6] & 0xff) << 16)    |
                ((psu4ColorMap[7] & 0xff) << 24);
            REG(u4GfxHwId, fg_COLOR_TRANS2) =
                ( psu4ColorMap[8]  & 0xff)          |
                ((psu4ColorMap[9]  & 0xff) << 8)    |
                ((psu4ColorMap[10] & 0xff) << 16)   |
                ((psu4ColorMap[11] & 0xff) << 24);
            REG(u4GfxHwId, fg_COLOR_TRANS3) =
                ( psu4ColorMap[12] & 0xff)          |
                ((psu4ColorMap[13] & 0xff) << 8)    |
                ((psu4ColorMap[14] & 0xff) << 16)   |
                ((psu4ColorMap[15] & 0xff) << 24);
            break;

        case CM_RGB565_DIRECT16:
        case CM_ARGB1555_DIRECT16:
        case CM_ARGB4444_DIRECT16:
            REG(u4GfxHwId, fg_COLOR_TRANS0) =
                ( psu4ColorMap[0] & 0xffff)         |
                ((psu4ColorMap[1] & 0xffff) << 16);
            REG(u4GfxHwId, fg_COLOR_TRANS1) =
                ( psu4ColorMap[2] & 0xffff)         |
                ((psu4ColorMap[3] & 0xffff) << 16);
            REG(u4GfxHwId, fg_COLOR_TRANS2) =
                ( psu4ColorMap[4] & 0xffff)         |
                ((psu4ColorMap[5] & 0xffff) << 16);
            REG(u4GfxHwId, fg_COLOR_TRANS3) =
                ( psu4ColorMap[6] & 0xffff)         |
                ((psu4ColorMap[7] & 0xffff) << 16);
            REG(u4GfxHwId, fg_COLOR_TRANS4) =
                ( psu4ColorMap[8] & 0xffff)         |
                ((psu4ColorMap[9] & 0xffff) << 16);
            REG(u4GfxHwId, fg_COLOR_TRANS5) =
                ( psu4ColorMap[10] & 0xffff)        |
                ((psu4ColorMap[11] & 0xffff) << 16);
            REG(u4GfxHwId, fg_COLOR_TRANS6) =
                ( psu4ColorMap[12] & 0xffff)        |
                ((psu4ColorMap[13] & 0xffff) << 16);
            REG(u4GfxHwId, fg_COLOR_TRANS7) =
                ( psu4ColorMap[14] & 0xffff)        |
                ((psu4ColorMap[15] & 0xffff) << 16);
            break;

        default:
            return -(INT32)E_GFX_INV_ARG;
        }
    }
    else            // for lint happy
    {
        ;
    }

    if (GFX_CMDENQ(u4GfxHwId, GREG_COL_TRAN0)  |
        GFX_CMDENQ(u4GfxHwId, GREG_COL_TRAN1)  |
        GFX_CMDENQ(u4GfxHwId, GREG_COL_TRAN2)  |
        GFX_CMDENQ(u4GfxHwId, GREG_COL_TRAN3)  |
        GFX_CMDENQ(u4GfxHwId, GREG_COL_TRAN4)  |
        GFX_CMDENQ(u4GfxHwId, GREG_COL_TRAN5)  |
        GFX_CMDENQ(u4GfxHwId, GREG_COL_TRAN6)  |
        GFX_CMDENQ(u4GfxHwId, GREG_COL_TRAN7))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}
