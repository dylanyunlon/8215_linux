//---------------------------------------------------------------------------
// Type definitions
//---------------------------------------------------------------------------
typedef struct _GFX_REGFILE
{
   UINT32 au4RegFile[GREG_FILE_SIZE];// for debug reserve
   MI_DIF_UNION_T *  prRegFile;
} GFX_REGFILE;

typedef struct _GFX_REGFILE_LOSSLESS
{
   UINT32 au4RegFile[GREG_LOSSLESS_FILE_SIZE];// for debug reserve
   MI_DIF_LOSSLESS_UNION_T *  prRegFile;
} GFX_REGFILE_LOSSLESS;

//---------------------------------------------------------------------------
// Macro definitions
//---------------------------------------------------------------------------

#define  REGFILE(u4GfxHwId, XREG) \
	GfxRegFile[u4GfxHwId].au4RegFile[XREG]

// acronym of gfx register name in register file
#define REG(u4GfxHwId, XREG)  \
	GfxRegFile[u4GfxHwId].prRegFile->rField.XREG

// push back relative register value in register file.
#ifdef GFX_RISC_MODE  // risc mode
#define GFX_CMDENQ(u4GfxHwId, XREG)        \
    (GFX_RiscPushBack(u4GfxHwId, (INT32)(XREG), REGFILE(u4GfxHwId, XREG)))
#else                       // cmdque mode
#define GFX_CMDENQ(u4GfxHwId, XREG)        \
    (GFX_CmdQuePushBack(u4GfxHwId, (INT32)(XREG), REGFILE(u4GfxHwId, XREG)))
#endif // #if defined(GFX_RISC_MODE)

#define  REGFILE_LL(u4GfxHwId, XREG) \
    GfxLosslessRegFile[u4GfxHwId].au4RegFile[XREG]

// acronym of gfx register name in register file
#define REG_LL(u4GfxHwId, XREG)  \
    GfxLosslessRegFile[u4GfxHwId].prRegFile->rField.XREG

// push back relative register value in register file.
#ifdef GFX_RISC_MODE  // risc mode
#define GFX_CMDENQ_LL(u4GfxHwId, XREG)        \
    (GFX_RiscPushBack(u4GfxHwId, (INT32)(XREG + 0xC0), REGFILE_LL(u4GfxHwId, XREG)))
#else                       // cmdque mode
#define GFX_CMDENQ_LL(u4GfxHwId, XREG)        \
    (GFX_CmdQuePushBack(u4GfxHwId, (INT32)(XREG + 0xC0), REGFILE_LL(u4GfxHwId, XREG)))
#endif // #if defined(GFX_RISC_MODE)

#define GFX_CHECK_RET_VALUE(VALUE)          \
        if (VALUE != (INT32)E_GFX_OK)       \
        {                                   \
            return -(INT32)E_GFX_INV_ARG;   \
        }

#if 0 //(CONFIG_CHIP_VER_CURR >= CONFIG_CHIP_VER_MT8555)
#define GFX_Disable2SrcBlending()                           \
         {                                                  \
             REG(u4GfxHwId, fg_SRC2_BSAD_ENA) = 0;          \
             if (GFX_CMDENQ(u4GfxHwId, GREG_SRCCBCR_PITCH)) \
             {                                              \
                 return -(INT32)E_GFX_OUT_OF_MEM;           \
             }                                              \
         }

#define SetRotateWr(u4GfxHwId, fgRotateEn)    REG(u4GfxHwId, fg_DST_WR_ROTATE) = fgRotateEn
#define SetRotateRd(u4GfxHwId, fgRotateEn)    REG(u4GfxHwId, fg_DST_RD_ROTATE) = fgRotateEn
#define SetRotate   SetRotateWr
#else
#define GFX_Disable2SrcBlending()
#define SetRotate(u4GfxHwId, fgRotateEn)    REG(u4GfxHwId, fg_DST_ROTATE) = fgRotateEn
#define SetRotateRd(u4GfxHwId, fgRotateEn)
#endif

#define ResetMirrorFlipFlag(u4GfxHwId)                 \
        {                                              \
            REG(u4GfxHwId, fg_DSTPITCH_DEC) = 0;       \
            REG(u4GfxHwId, fg_DST_MIRR_OR)  = 0;       \
            REG(u4GfxHwId, fg_SRCPITCH_DEC) = 0;       \
            REG(u4GfxHwId, fg_SRC_MIRR_OR)  = 0;       \
            GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);   \
        }

#define ResetRotateFlag(u4GfxHwId)                     \
        {                                              \
            SetRotate(u4GfxHwId, 0);                   \
            SetRotateRd(u4GfxHwId, 0);                 \
            REG(u4GfxHwId, fg_DSTPITCH_DEC) = 0;       \
            GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);   \
        }

#define ResetRotateMirrorFlipFlag(u4GfxHwId)           \
        {                                              \
            REG(u4GfxHwId, fg_DSTPITCH_DEC) = 0;       \
            REG(u4GfxHwId, fg_DST_MIRR_OR)  = 0;       \
            REG(u4GfxHwId, fg_SRCPITCH_DEC) = 0;       \
            REG(u4GfxHwId, fg_SRC_MIRR_OR)  = 0;       \
            SetRotate(u4GfxHwId, 0);                   \
            SetRotateRd(u4GfxHwId, 0);                 \
            GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);   \
        }

#define ResetI2DFlag(u4GfxHwId)                        \
        {                                              \
            REG(u4GfxHwId, fg_IDX2DIR_EN)    = 0;      \
            REG(u4GfxHwId, fg_CPT_DRAM_EN)   = 0;      \
            REG(u4GfxHwId, fg_USE_256CPT)    = 0;      \
            REG(u4GfxHwId, fg_256CPT_FIRE)   = 0;      \
            REG(u4GfxHwId, fg_LN_ST_BYTE_AL) = 0;      \
            REG(u4GfxHwId, fg_MSB_LEFT)      = 0;      \
            REG(u4GfxHwId, fg_SRC_PITCH_ENA) = 0;      \
            GFX_CMDENQ(u4GfxHwId, GREG_IDX2DIR);       \
            GFX_CMDENQ(u4GfxHwId, GREG_G_256CPT);      \
        }

#define ResetI2DMirrorFlipFlag(u4GfxHwId)              \
        {                                              \
            ResetI2DFlag(u4GfxHwId);                   \
            ResetMirrorFlipFlag(u4GfxHwId);            \
        }

#define ResetI2DRotateMirrorFlipFlag(u4GfxHwId)        \
        {                                              \
            ResetI2DFlag(u4GfxHwId);                   \
            ResetRotateMirrorFlipFlag(u4GfxHwId);      \
        }

#define Reset24BppFlag(u4GfxHwId)					   \
		{                                              \
			REG(u4GfxHwId, fg_SRC_CM_24BPP) = 0;       \
			REG(u4GfxHwId, fg_SRC_24BPP_BSAD_H) = 0;   \
			REG(u4GfxHwId, fg_GLOABLE_ALPHA_EN) = 0;   \
			GFX_CMDENQ(u4GfxHwId, GREG_G_256CPT);      \
			GFX_VA_MSB_CMDENQ(u4GfxHwId);              \
		}

