    REG(u4GfxHwId, fg_A0_MID) = u4Mid;
    REG(u4GfxHwId, fg_A0_PREFETCH) = u4Prefetch;
    REG(u4GfxHwId, fg_A0_2D_PREFETCH) = u42DPrefetch;
    REG(u4GfxHwId, fg_A0_PREFETCH_DEC) = u4PrefetchDec;
    REG(u4GfxHwId, fg_A0_TWO_WAY) = u4TwoWay;
    REG(u4GfxHwId, fg_A0_MID_2ND) = u4Mid2nd;
    //GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG2);
    REG(u4GfxHwId, fg_A0_MMU_EN) = u4En;
    GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG2);
    return (E_GFX_OK);
}

