INT32 GFX_SetWTBase(UINT32 u4GfxHwId, UINT32 u4X, UINT32 u4Y)
{
    UINT32 u4SrcAddr, u4DstAddr;

    GFX_HW_FX_ENTRY;

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4Y*_u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
    REG( u4GfxHwId, fg_DST_WBBSAD) = GFX_PHYSICAL(u4DstAddr);
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4Y*_u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
    REG( u4GfxHwId, fg_SRC_WBBSAD)    = GFX_PHYSICAL(u4SrcAddr);

    VA_MSB_REG(u4GfxHwId, fg_DST_WBBSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_WBBSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ( u4GfxHwId, GREG_DST_WBBSAD)   |
        GFX_CMDENQ( u4GfxHwId, GREG_SRC_WBBSAD))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    return (INT32)E_GFX_OK;
}

INT32 GFX_WtBypass(UINT32 u4GfxHwId, UINT32 u4SrcBypass, UINT32 u4DstBypass)
{
    GFX_HW_FX_ENTRY;
    //GFX_UNUSED_RET(x_memset(_au4RegFile, 0, sizeof(_au4RegFile)))

    REG(u4GfxHwId, fg_SRC_WT_EN)    = u4SrcBypass; // 1 - by pass, if use WT -> set to 0
    REG(u4GfxHwId, fg_DST_WT_EN)    = u4DstBypass;

    return 0;
}

