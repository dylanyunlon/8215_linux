                */
                REG(u4GfxHwId, fg_IOMMU_CFG9)  = ((u4Addr1+u4Size1+0xFFF)&0xFFFFF000)| 0x1;
                REG(u4GfxHwId, fg_IOMMU_CFG12) = (u4Addr1 & 0xFFFFF000)| 0x1;
                REG(u4GfxHwId, fg_IOMMU_CFG10) = ((u4Addr2+u4Size2+0xFFF)&0xFFFFF000)| 0x9;
                REG(u4GfxHwId, fg_IOMMU_CFG13) = (u4Addr2 & 0xFFFFF000)| 0x9;
                REG(u4GfxHwId, fg_IOMMU_CFG11) = (0x1<<16)|(0x2<<4)|(0x1<<0);
            }
            else if (GFX_MMU_COMPRESS == eType)
            {
                /*
                IOMMU_WRITE32(REG_RW_IOMMU_CFG9, IOMMU_GFX,  ((ui4_StartAddr0+ui4_Buff_sz0-1)&0xFFFFF000)|(0x3<<1)|0x1);
                IOMMU_WRITE32(REG_RW_IOMMU_CFGA, IOMMU_GFX,  ((ui4_StartAddr1+ui4_Buff_sz1-1)&0xFFFFF000)|(0x4<<1)|0x1);
                IOMMU_WRITE32(REG_RW_IOMMU_CFGB, IOMMU_GFX,  (0x2<<4)|(0x1<<0));
                */
                REG(u4GfxHwId, fg_IOMMU_CFG9)  = ((u4Addr1+u4Size1+0xFFF)&0xFFFFF000)|(0x3<<1)|0x1;
                REG(u4GfxHwId, fg_IOMMU_CFG12) = (u4Addr1 & 0xFFFFF000)| 0x1;
                REG(u4GfxHwId, fg_IOMMU_CFG10) = ((u4Addr2+u4Size2+0xFFF)&0xFFFFF000)|(0x4<<1)|0x1;
                REG(u4GfxHwId, fg_IOMMU_CFG13) = (u4Addr2 & 0xFFFFF000)| 0x9;
                REG(u4GfxHwId, fg_IOMMU_CFG11) = (0x1<<16)|(0x2<<4)|(0x1<<0);
            }
            else
            {
                return (E_GFX_INV_ARG);
            }

            if (GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG9)  |
                GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG10) |
                GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG11) |
                GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG12) |
                GFX_CMDENQ(u4GfxHwId, GREG_IOMMU_CFG13))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }

            //GFX_MMUEnable(u4GfxHwId, TRUE);
