            LOG(1, "GFX engine still busy ......\n");

            // recover hw engine
            //GFX_RECOVER_ENGINE();

            /*lint -save -e506 */
            VERIFY(0);
            /*lint -restore */
        }
    }
	#endif
	  return ;//
}

