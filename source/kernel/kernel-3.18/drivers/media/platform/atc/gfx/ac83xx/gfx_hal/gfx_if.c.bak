 *  set number of 32bit words.
 */
//-------------------------------------------------------------------------


INT32 _GFX_FillChar(UINT32 u4GfxHwId, void *pvBase, UINT8 u1Char, UINT32 u4NumWrd)
{
#if 0
    UINT32  u4Width, u4Height, u4HeightTotal;
