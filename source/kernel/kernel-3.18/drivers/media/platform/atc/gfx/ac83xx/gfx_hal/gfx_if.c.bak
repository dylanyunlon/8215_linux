//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------


INT32 GFX_ComposeLoop(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX,
    UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height, UINT32 u4Ar,
    UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 i4Ret;
    i4Ret = GFX_ComposeLoopEx(u4GfxHwId, u4SrcX, u4SrcY, u4DstX, u4DstY, u4Width, u4Height, 0, u4Ar,
    u4OpCode, u4RectSrc);

    return i4Ret;
}


#if 0//(CONFIG_CHIP_VER_CURR == CONFIG_CHIP_VER_MT8520)
#else
//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
#if 0//(CONFIG_CHIP_VER_CURR <= CONFIG_CHIP_VER_MT8560)
INT32 GFX_NormalComposeLoop(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX,
    UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height, UINT32 u4Ar,
    UINT32 u4OpCode, UINT32 u4RectSrc)
{
    INT32 i4MhpPatch = GFX_ENABLE;
    UINT32 u4SrcAddr, u4DstAddr;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    // Add CLEAR, SRC, SRC_OVER patches for MHP project
    // 1. CLEAR    -> use Rect Fill (fill 0x0 in rect_color)
    // 2. SRC      -> use Pass0 and Pass5 of Alpha Composition
    // 3. SRC_OVER -> consider two corner cases
    //          case1: Ar=1.0 & As=1.0
    //          case2: Ar=1.0 & As=0.0
    //          note: Ar=0.0 is the same as case2
    if (((UINT32)CM_ARGB8888_DIRECT32 == _u4SrcCM[u4GfxHwId]) &&
        ((UINT32)CM_ARGB8888_DIRECT32 == _u4DstCM[u4GfxHwId]) &&
        (GFX_ENABLE == i4MhpPatch))
    {
        if ((UINT32)E_AC_CLEAR == u4OpCode)
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_Fill(u4GfxHwId, u4DstX, u4DstY, u4Width, u4Height);

            // restore original value
            GFX_SetColor(u4GfxHwId, u4RectColor);
            return (INT32)E_GFX_OK;
        }
        else if ((UINT32)E_AC_SRC == u4OpCode)
        {
         #if 0
            if (0 == u4Ar)
            {
                UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

                GFX_SetColor(u4GfxHwId, 0x0);
                GFX_Fill(u4GfxHwId, u4DstX, u4DstY, u4Width, u4Height);

                // restore original value
                GFX_SetColor(u4GfxHwId, u4RectColor);
                return (INT32)E_GFX_OK;
            }
            else if(255 == u4Ar)
            {
                UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

                GFX_SetColor(u4GfxHwId, 0x0);
                GFX_SetBltOpt(u4GfxHwId, (UINT32)D_GFXFLAG_NONE, 0x00000000, 0xffffffff);

                GFX_SetAlpha(u4GfxHwId, u4Ar);

                GFX_BitBlt(u4GfxHwId, u4SrcX, u4SrcY, u4DstX, u4DstY, u4Width, u4Height);
                // restore original value
                GFX_SetColor(u4GfxHwId, u4RectColor);
                return (INT32)E_GFX_OK;
            }

          #endif
        }
        else if (((UINT32)E_AC_SRC_OVER == u4OpCode) &&
                 (0 == u4Ar))
        {
        #if 0
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);
            UINT32 u4MinColor  = REG(u4GfxHwId, fg_COLOR_KEY_MIN);
            UINT32 u4MaxColor  = REG(u4GfxHwId, fg_COLOR_KEY_MAX);
            UINT32 u4Switch    = 0x0;

            if (REG(u4GfxHwId, fg_TRANS_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_TRANSPARENT);
            }

            if (REG(u4GfxHwId, fg_KEYNOT_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYNOT);
            }

            if (REG(u4GfxHwId, fg_COLCHG_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_COLORCHANGE);
            }

            if (REG(u4GfxHwId, fg_KEYSDSEL))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYSDSEL);
            }

            // BitBlt with ColorChange (from Dst to Dst)
            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_SetBltOpt(u4GfxHwId, D_GFXFLAG_COLORCHANGE, 0x00000000, 0x00FFFFFF);

            // set new src & dst pitch
            REG(u4GfxHwId, fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4DstPitch[u4GfxHwId] >> 4;

            u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) +
                (u4DstX << _u4DstShift[u4GfxHwId]));
            REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
            u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
            REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

            REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_BITBLT;
            REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
            REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
            REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
            REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

            VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
            VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
            GFX_VA_MSB_CMDENQ(u4GfxHwId);

            if (GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH)    |
                GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
                GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
                GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }

            // restore original value
            REG(u4GfxHwId, fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4SrcPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
            GFX_SetColor(u4GfxHwId, u4RectColor);
            GFX_SetBltOpt(u4GfxHwId, u4Switch, u4MinColor, u4MaxColor);
            if (GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH) |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)    |
                GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }
            return (INT32)E_GFX_OK;
        #endif
        }
        else
        {
            //do nothing, for lint happy
        }
    }

    GFX_Disable2SrcBlending();
    // normal compose in LOOP mode

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;

    // set src height> 2048
#if (CONFIG_CHIP_VER_CURR == CONFIG_CHIP_VER_MT8580)
    u4Height -= 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = u4Height & 0x007FF;
    REG(u4GfxHwId, fg_SRC_CM_2)       = (u4Height >> 11) & 0x0F;
    REG(u4GfxHwId, fg_SRC_HEIGHT_15)  = (u4Height >> 15) & 0x01;
    REG(u4GfxHwId, fg_SRC_HEIGHT_19_16) = (u4Height >> 16) & 0x0F;
#else
    REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height -1);
#endif

    REG(u4GfxHwId, fg_ALCOM_AR)       = u4Ar;
    REG(u4GfxHwId, fg_ALCOM_OPCODE)   = u4OpCode;
    REG(u4GfxHwId, fg_ALCOM_RECT_SRC) = u4RectSrc;
    REG(u4GfxHwId, fg_ALCOM_NORMAL) = 1;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    GFX_LOG_2048_HAL(u4Height);

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP)     |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

#if (CONFIG_CHIP_VER_CURR == CONFIG_CHIP_VER_MT8580)
        REG(u4GfxHwId, fg_SRC_CM_2)           = 0;
        REG(u4GfxHwId, fg_SRC_HEIGHT_15)      = 0;
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE);
#endif

#if GFX_IOMMU_WORKAROUND_BEFORE_ECO
    if (fgRunBelowSegmentBefore(IC_8560_VER_A)) //for before 8560ECO
    {
    	REG(u4GfxHwId, fg_ALCOM_OPCODE)   = (UINT32)0; //add by +e
		GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP);
    }
#endif

    return (INT32)E_GFX_OK;
}
#else
INT32 GFX_NormalComposeLoop(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX,
    UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height, UINT32 u4Ar,
    UINT32 u4OpCode, UINT32 u4RectSrc)
{
    //GFX_ComposeLoop(u4GfxHwId, u4SrcX, u4SrcY, u4DstX, u4DstY, u4Width, u4Height, 0xff,  u4OpCode, u4RectSrc);
    {
        GFX_ComposeLoopEx(u4GfxHwId, u4SrcX, u4SrcY, u4DstX, u4DstY, u4Width, u4Height, 1, 0x255,
        u4OpCode, u4RectSrc);
    }
    return (INT32)E_GFX_OK;
}
#endif

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_ComposeLoopEx(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX,
    UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height, UINT32 u4AlComNormal, UINT32 u4Ar,
    UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 u4SrcAddr, u4DstAddr;


    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    // normal compose in LOOP mode
    if (u4AlComNormal)
    {
        u4Ar = 255;
    }

    GFX_Disable2SrcBlending();

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4Height - 1);
    REG(u4GfxHwId, fg_ALCOM_AR)       = u4Ar;
    REG(u4GfxHwId, fg_ALCOM_OPCODE)   = u4OpCode;
    REG(u4GfxHwId, fg_ALCOM_RECT_SRC) = u4RectSrc;
    REG(u4GfxHwId, fg_ALCOM_NORMAL)   = u4AlComNormal;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    //GFX_LOG_2048_HAL(u4Height);

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (
        GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP)     |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

#define ALUTest
//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_ComposeLoop2ALU(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX,
    UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height, UINT32 u4Ar,
    UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 u4SrcAddr, u4DstAddr;
    UINT32 u4BppWidth;

    #ifdef ALUTest
    INT32 i4MhpPatch = GFX_ENABLE;
    #endif

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    // Add CLEAR, SRC, SRC_OVER patches for MHP project
    // 1. CLEAR    -> use Rect Fill (fill 0x0 in rect_color)
    // 2. SRC      -> use Pass0 and Pass5 of Alpha Composition
    // 3. SRC_OVER -> consider two corner cases
    //          case1: Ar=1.0 & As=1.0
    //          case2: Ar=1.0 & As=0.0
    //          note: Ar=0.0 is the same as case2
    #ifdef ALUTest
    if (((UINT32)CM_ARGB8888_DIRECT32 == _u4SrcCM[u4GfxHwId]) &&
        ((UINT32)CM_ARGB8888_DIRECT32 == _u4DstCM[u4GfxHwId]) &&
        (GFX_ENABLE == i4MhpPatch))
    {
        if ((UINT32)E_AC_CLEAR == u4OpCode)
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_Fill(u4GfxHwId, u4DstX, u4DstY, u4Width, u4Height);

            // restore original value
            GFX_SetColor(u4GfxHwId, u4RectColor);
            return (INT32)E_GFX_OK;
        }
        else if ((UINT32)E_AC_SRC == u4OpCode)
        {
            if (0 == u4Ar)
            {
                UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

                GFX_SetColor(u4GfxHwId, 0x0);
                GFX_Fill(u4GfxHwId, u4DstX, u4DstY, u4Width, u4Height);

                // restore original value
                GFX_SetColor(u4GfxHwId, u4RectColor);
                return (INT32)E_GFX_OK;
            }
            else if(255 == u4Ar)
            {
                UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

                GFX_SetColor(u4GfxHwId, 0x0);
                GFX_SetBltOpt(u4GfxHwId, (UINT32)D_GFXFLAG_NONE, 0x00000000, 0xffffffff);

                GFX_SetAlpha(u4GfxHwId, u4Ar);

                GFX_BitBlt(u4GfxHwId, u4SrcX, u4SrcY, u4DstX, u4DstY, u4Width, u4Height);
                // restore original value
                GFX_SetColor(u4GfxHwId, u4RectColor);
                return (INT32)E_GFX_OK;
            }
        }
        else if (((UINT32)E_AC_SRC_OVER == u4OpCode) &&
                 (0 == u4Ar))
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);
            UINT32 u4MinColor  = REG(u4GfxHwId, fg_COLOR_KEY_MIN);
            UINT32 u4MaxColor  = REG(u4GfxHwId, fg_COLOR_KEY_MAX);
            UINT32 u4Switch    = 0x0;

            if (REG(u4GfxHwId, fg_TRANS_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_TRANSPARENT);
            }

            if (REG(u4GfxHwId, fg_KEYNOT_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYNOT);
            }

            if (REG(u4GfxHwId, fg_COLCHG_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_COLORCHANGE);
            }

            if (REG(u4GfxHwId, fg_KEYSDSEL))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYSDSEL);
            }

            // BitBlt with ColorChange (from Dst to Dst)
            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_SetBltOpt(u4GfxHwId, D_GFXFLAG_COLORCHANGE, 0x00000000, 0x00FFFFFF);

            // set new src & dst pitch
            REG(u4GfxHwId, fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4DstPitch[u4GfxHwId] >> 4;

            u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) +
                (u4DstX << _u4DstShift[u4GfxHwId]));
            REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
            u4SrcAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) +
                (u4DstX << _u4DstShift[u4GfxHwId]));
            REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

            REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_BITBLT;
            REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
            REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
            REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
            REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

            VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
            VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
            GFX_VA_MSB_CMDENQ(u4GfxHwId);

            if (GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH)    |
                GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
                GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
                GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }

            // restore original value
            REG(u4GfxHwId, fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4SrcPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
            GFX_SetColor(u4GfxHwId, u4RectColor);
            GFX_SetBltOpt(u4GfxHwId, u4Switch, u4MinColor, u4MaxColor);
            if (GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH) |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)    |
                GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }
            return (INT32)E_GFX_OK;
        }
        else
        {
            //do nothing, for lint happy
        }
    }
   #endif

    u4BppWidth = u4Width<<_u4DstShift[u4GfxHwId];

    GFX_Disable2SrcBlending();
    // normal compose in LOOP mode

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4Height - 1);
    REG(u4GfxHwId, fg_ALCOM_AR)       = u4Ar;
    REG(u4GfxHwId, fg_ALCOM_OPCODE)   = u4OpCode;
    REG(u4GfxHwId, fg_ALCOM_RECT_SRC) = u4RectSrc;
    REG(u4GfxHwId, fg_ALCOM_NORMAL)   = 0;
    if (u4BppWidth > 32)
    {
        REG(u4GfxHwId, fg_BARREL_ENA)     = 1;
        REG(u4GfxHwId, fg_PASS_ALU_ENA)   = 0;
    }
    else // MT8530,MT8560 has this limitation.
    { // bppWidth <= 32, cannot enable 2ALU.
        REG(u4GfxHwId, fg_BARREL_ENA)     = 0;
        REG(u4GfxHwId, fg_PASS_ALU_ENA)   = 0;
    }
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP)   |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)|
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    //[YgLi][20090218](Must Clean the two bits after blt complete, Or, maybe effects others function, such as compose)
    REG(u4GfxHwId, fg_BARREL_ENA)  = 0;
    REG(u4GfxHwId, fg_PASS_ALU_ENA) =0;

    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);

#if GFX_IOMMU_WORKAROUND_BEFORE_ECO
    if (fgRunBelowSegmentBefore(IC_8560_VER_A)) //for before 8560ECO
    {
    	REG(u4GfxHwId, fg_ALCOM_OPCODE)   = (UINT32)0; //add by +e
		GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP);
    }
#endif

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_NormalComposeLoop2ALU(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX,
    UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height, UINT32 u4Ar,
    UINT32 u4OpCode, UINT32 u4RectSrc)
{
    INT32 i4MhpPatch = GFX_ENABLE;
    UINT32 u4SrcAddr, u4DstAddr;
    UINT32 u4BppWidth;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif
    if(u4Ar!=255)
    {
        return -(INT32)E_GFX_INV_ARG;
    }
    // Add CLEAR, SRC, SRC_OVER patches for MHP project
    // 1. CLEAR    -> use Rect Fill (fill 0x0 in rect_color)
    // 2. SRC      -> use Pass0 and Pass5 of Alpha Composition
    // 3. SRC_OVER -> consider two corner cases
    //          case1: Ar=1.0 & As=1.0
    //          case2: Ar=1.0 & As=0.0
    //          note: Ar=0.0 is the same as case2
    if (((UINT32)CM_ARGB8888_DIRECT32 == _u4SrcCM[u4GfxHwId]) &&
        ((UINT32)CM_ARGB8888_DIRECT32 == _u4DstCM[u4GfxHwId]) &&
        (GFX_ENABLE == i4MhpPatch))
    {
        if ((UINT32)E_AC_CLEAR == u4OpCode)
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_Fill(u4GfxHwId, u4DstX, u4DstY, u4Width, u4Height);

            // restore original value
            GFX_SetColor(u4GfxHwId, u4RectColor);
            return (INT32)E_GFX_OK;
        }
        else if ((UINT32)E_AC_SRC == u4OpCode)
        {
            if (0 == u4Ar)
            {
                UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

                GFX_SetColor(u4GfxHwId, 0x0);
                GFX_Fill(u4GfxHwId, u4DstX, u4DstY, u4Width, u4Height);

                // restore original value
                GFX_SetColor(u4GfxHwId, u4RectColor);
                return (INT32)E_GFX_OK;
            }
            else if(255 == u4Ar)
            {
                UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

                GFX_SetColor(u4GfxHwId, 0x0);
                GFX_SetBltOpt(u4GfxHwId, (UINT32)D_GFXFLAG_NONE, 0x00000000, 0xffffffff);

                GFX_SetAlpha(u4GfxHwId, u4Ar);

                GFX_BitBlt(u4GfxHwId, u4SrcX, u4SrcY, u4DstX, u4DstY, u4Width, u4Height);
                // restore original value
                GFX_SetColor(u4GfxHwId, u4RectColor);
                return (INT32)E_GFX_OK;
            }
        }
        else if (((UINT32)E_AC_SRC_OVER == u4OpCode) &&
                 (0 == u4Ar))
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);
            UINT32 u4MinColor  = REG(u4GfxHwId, fg_COLOR_KEY_MIN);
            UINT32 u4MaxColor  = REG(u4GfxHwId, fg_COLOR_KEY_MAX);
            UINT32 u4Switch    = 0x0;

            if (REG(u4GfxHwId, fg_TRANS_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_TRANSPARENT);
            }

            if (REG(u4GfxHwId, fg_KEYNOT_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYNOT);
            }

            if (REG(u4GfxHwId, fg_COLCHG_ENA))
            {
                u4Switch = (u4Switch | D_GFXFLAG_COLORCHANGE);
            }

            if (REG(u4GfxHwId, fg_KEYSDSEL))
            {
                u4Switch = (u4Switch | D_GFXFLAG_KEYSDSEL);
            }

            // BitBlt with ColorChange (from Dst to Dst)
            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_SetBltOpt(u4GfxHwId, D_GFXFLAG_COLORCHANGE, 0x00000000, 0x00FFFFFF);

            // set new src & dst pitch
            REG(u4GfxHwId, fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4DstPitch[u4GfxHwId] >> 4;

            u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) +
                (u4DstX << _u4DstShift[u4GfxHwId]));
            REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
            u4SrcAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4DstY * _u4DstPitch[u4GfxHwId]) +
                (u4DstX << _u4DstShift[u4GfxHwId]));
            REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

            REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_BITBLT;
            REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);
            REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
            REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
            REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

            VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
            VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
            GFX_VA_MSB_CMDENQ(u4GfxHwId);

            if (GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH)    |
                GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
                GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
                GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }

            // restore original value
            REG(u4GfxHwId, fg_OSD_WIDTH) = _u4DstPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_PITCH) = _u4SrcPitch[u4GfxHwId] >> 4;
            REG(u4GfxHwId, fg_SRC_BSAD) = (UINT32)(_pu1SrcBase[u4GfxHwId] + (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
            GFX_SetColor(u4GfxHwId, u4RectColor);
            GFX_SetBltOpt(u4GfxHwId, u4Switch, u4MinColor, u4MaxColor);
            if (GFX_CMDENQ(u4GfxHwId, GREG_S_OSD_WIDTH) |
                GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)    |
                GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE))
            {
                return -(INT32)E_GFX_OUT_OF_MEM;
            }
            return (INT32)E_GFX_OK;
        }
        else
        {
            //do nothing, for lint happy
        }
    }

    u4BppWidth = u4Width<<_u4DstShift[u4GfxHwId];

    GFX_Disable2SrcBlending();
    // normal compose in LOOP mode

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    //source base address
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4Height - 1);
    REG(u4GfxHwId, fg_ALCOM_AR)       = u4Ar;
    REG(u4GfxHwId, fg_ALCOM_OPCODE)   = u4OpCode;
    REG(u4GfxHwId, fg_ALCOM_RECT_SRC) = u4RectSrc;
    REG(u4GfxHwId, fg_ALCOM_NORMAL) = 1;
    if (u4BppWidth > 32)
    {
        REG(u4GfxHwId, fg_BARREL_ENA)     = 1;
        REG(u4GfxHwId, fg_PASS_ALU_ENA)   = 0;
    }
    else // MT8530,MT8560 has this limitation.
    { // bppWidth <= 32, cannot enable 2ALU.
        REG(u4GfxHwId, fg_BARREL_ENA)     = 0;
        REG(u4GfxHwId, fg_PASS_ALU_ENA)   = 0;
    }
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP)     |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    //[YgLi][20090218](Must Clean the two bits after blt complete, Or, maybe effects others function, such as compose)
    REG(u4GfxHwId, fg_BARREL_ENA)  = 0;
    REG(u4GfxHwId, fg_PASS_ALU_ENA) =0;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);

#if GFX_IOMMU_WORKAROUND_BEFORE_ECO
    if (fgRunBelowSegmentBefore(IC_8560_VER_A)) //for before 8560ECO
    {
    	REG(u4GfxHwId, fg_ALCOM_OPCODE)   = (UINT32)0; //add by +e
		GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP);
    }
#endif
    return (INT32)E_GFX_OK;
}
#endif

//#if (CONFIG_CHIP_VER_CURR >= CONFIG_CHIP_VER_MT8550)
#if 1
INT32 GFX_BurstEn(UINT32 u4GfxHwId, UINT32 u4BurstEn, UINT32 u4BurstMode)
{
    GFX_HW_FX_ENTRY;

    if (u4BurstEn)
    {
        REG(u4GfxHwId, fg_BURST_EN)     = 1; // support 16 x 128 bit burst read.
        REG(u4GfxHwId, fg_BURST_MODE)   = u4BurstMode;
    }
    else
    {
        REG(u4GfxHwId, fg_BURST_EN)     = 0; // burst read off
        REG(u4GfxHwId, fg_BURST_MODE)   = 0;
    }

    //return GFX_CMDENQ(u4GfxHwId, GREG_G_MODE);
    return (INT32)E_GFX_OK;
}

INT32 GFX_SetHighPriority(UINT32 u4GfxHwId, UINT32 u4DynaHiPri)
{
    GFX_HW_FX_ENTRY;

    if (u4DynaHiPri)
    { //  Dynamic High Priority
        REG(u4GfxHwId, fg_STATIC_HIGH_PRIORITY)     = 0;
    }
    else
    { // Static High Priority
        REG(u4GfxHwId, fg_STATIC_HIGH_PRIORITY)     = 1;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_Idx2DirBitBlt
 *  gfx index to direct color bitblt.
 *  gfx.op.idx2dirblt {sx} {sy} {dx} {dy} {w} {h} {palette} {msb_left} {sb_align}
 */
//-------------------------------------------------------------------------
INT32 GFX_SetI2DBltOpt(UINT32 u4GfxHwId, UINT32 u4SrcPitchEn, UINT8 *pv_pal_base, UINT32 u4MsbLeft, UINT32 u4StartByteAligned)
{

    GFX_HW_FX_ENTRY;
    /* must be OW aligned */
    if ( ((UINT32)pv_pal_base) & 0xf )
    {
        return E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_CHAR_CM)    = _u4CharCM[u4GfxHwId];
    REG(u4GfxHwId, fg_SRC_PITCH_ENA)   = (UINT32)u4SrcPitchEn;
    REG(u4GfxHwId, fg_LN_ST_BYTE_AL) = u4StartByteAligned;
    REG(u4GfxHwId, fg_MSB_LEFT)   = u4MsbLeft;
    REG(u4GfxHwId, fg_PAL_BSAD)   = GFX_PHYSICAL_SAFE(pv_pal_base);
#if 0
    if (IC_VER_A == BSP_GetIcVersion())
    {
        GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, GFX_READ32(u4GfxHwId,GFX_REG_G_CONFIG) & (~1));

        GFX_WRITE32(u4GfxHwId, GFX_REG_IDX2DIR, ((UINT32)pv_pal_base & 0x3FFFFFFF));

        u4Val = GFX_READ32(u4GfxHwId, GFX_REG_G_256CPT);
        u4Val |= 0x7;
        GFX_WRITE32(u4GfxHwId, GFX_REG_G_256CPT, u4Val);

        u4Val = GFX_READ32(u4GfxHwId, GFX_REG_G_MODE);
        GFX_WRITE32(u4GfxHwId, GFX_REG_G_MODE, u4Val | 0x20);

        while (GFX_READ32(u4GfxHwId, GFX_REG_G_256CPT) & 0x01);

        GFX_WRITE32(u4GfxHwId, GFX_REG_G_CONFIG, GFX_READ32(u4GfxHwId, GFX_REG_G_CONFIG) | 0x1);

        REG(u4GfxHwId, fg_IDX2DIR_EN)   = 1;
        REG(u4GfxHwId, fg_CPT_DRAM_EN)  = 1;
        REG(u4GfxHwId, fg_USE_256CPT)   = 1;
    }
    else
 #endif
    {
        REG(u4GfxHwId, fg_IDX2DIR_EN)   = 1;
        REG(u4GfxHwId, fg_CPT_DRAM_EN)  = 1;
        REG(u4GfxHwId, fg_USE_256CPT)   = 1;
        REG(u4GfxHwId, fg_256CPT_FIRE)  = 1;
    }

    VA_PAL_MSB_REG(u4GfxHwId, fg_PAL_BSAD_H, ((UINT32)pv_pal_base));
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_IDX2DIR)        |
        GFX_CMDENQ(u4GfxHwId, GREG_G_256CPT))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_StretchBlt
 *  gfx stretch bitblt.
 *  calculate output address.
 *  calculate input address.
 *  calculate ration.
 *  set input width height.
 *  set output width height.
 *  enque registers.
 */
//-------------------------------------------------------------------------
INT32 GFX_SetStretchBltOpt(UINT32 u4GfxHwId, UINT32 u4SrcW, UINT32 u4SrcH, UINT32 u4DstW, UINT32 u4DstH)
{
    UINT32 u4MnV, u4MnH;

    GFX_HW_FX_ENTRY;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    // calculate m n ratio for scale up and down
    if ((u4DstW == u4SrcW) || (u4DstW == 1))
    {
        u4MnH = 0x00010000;
        u4SrcW = u4DstW;
    }
    else if (u4SrcW > u4DstW)    // scale down
    {
        u4MnH = (u4SrcW << 16) / (u4DstW - 1);  /* m/(n-1) */
        if (((u4SrcW << 16) % (u4DstW - 1)) == 0)
        {
            u4MnH--;  /* replace m/(n-1) with m/(n-1)-2e-16, hardware limitation */
        }
    }
    else /* scale up (u4DstW > u4SrcW) */
    {
        UINT32 u4Step;

        u4Step = (u4SrcW << 16) / (u4DstW);
        if ((u4Step * (u4DstW - 1)) < ((u4SrcW - 1) << 16))
        {
            u4MnH = (u4SrcW << 16) / (u4DstW - 1);
            if (u4MnH == 0x10000)
            {
                u4MnH--;
            }
        }
        else
        {
            u4MnH = u4Step;
        }
    }

    if ((u4DstH == u4SrcH) || (u4DstH == 1))
    {
        u4MnV = 0x00010000;
        u4SrcH = u4DstH;
    }
    else
    {
        u4MnV = (u4SrcH << 16) / (u4DstH - 1);
        if (u4MnV == 0x00010000)
        {
            u4MnV = (u4SrcH << 16) / (u4DstH);
        }
    }

    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;//add for DstW = 1
    REG(u4GfxHwId, fg_STR_DST_WIDTH)  = u4DstW;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4SrcH - 1);//add for DstH=1
    REG(u4GfxHwId, fg_STR_DST_HEIGHT) = (u4DstH - 1);
    REG(u4GfxHwId, fg_STR_BLT_H)      = u4MnH;
    REG(u4GfxHwId, fg_STR_BLT_V)      = u4MnV;

    if (GFX_CMDENQ(u4GfxHwId, GREG_STR_BLT_H)      |
        GFX_CMDENQ(u4GfxHwId, GREG_STR_BLT_V)      |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |//add for Dst =1
        GFX_CMDENQ(u4GfxHwId, GREG_STR_DST_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_SetComposeLoopOpt(UINT32 u4GfxHwId, UINT32 u4AlComNormal, UINT32 u4Ar, UINT32 u4OpCode, UINT32 u4RectSrc)
{
    // normal compose in LOOP mode
    if (u4AlComNormal)
    {
        u4Ar = 255;
    }

    GFX_Disable2SrcBlending();

    REG(u4GfxHwId, fg_ALCOM_AR)       = u4Ar;
    REG(u4GfxHwId, fg_ALCOM_OPCODE)   = u4OpCode;
    REG(u4GfxHwId, fg_ALCOM_RECT_SRC) = u4RectSrc;
    REG(u4GfxHwId, fg_ALCOM_NORMAL)   = u4AlComNormal;

    if (GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_SetRotateOpt(UINT32 u4GfxHwId, BOOL fgRotateEn, UINT32 u4Is90CCW)
{
    GFX_HW_FX_ENTRY;

    REG(u4GfxHwId, fg_DSTPITCH_DEC) = u4Is90CCW;
    SetRotate(u4GfxHwId, fgRotateEn);
    if (GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_SetJavaXorOpt(UINT32 u4GfxHwId, UINT32 u4XorColor)
{
    GFX_HW_FX_ENTRY;

    REG(u4GfxHwId, fg_CFMT_ENA)   = (UINT32)(_u4DstCM[u4GfxHwId] != _u4SrcCM[u4GfxHwId]);

    REG(u4GfxHwId, fg_ROP_OPCODE) = E_ROP_JAVA_XOR;
    REG(u4GfxHwId, fg_NO_WR)      = GFX_DISABLE;
    REG(u4GfxHwId, fg_JAVA_XOR_COLOR) = u4XorColor;

    REG(u4GfxHwId, fg_SRCALPHA_CHECK)    = 1;

    if (GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE)    |
        GFX_CMDENQ(u4GfxHwId, GREG_XOR_COLOR)      |
        GFX_CMDENQ(u4GfxHwId, GREG_ROP))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

INT32 GFX_SetMirrorFlipOpt(UINT32 u4GfxHwId, UINT32 u4op)
{
    GFX_HW_FX_ENTRY;
    //destination base address
    switch(u4op)
    {
    case E_BITBLT_SRC_MIRROR:
        REG(u4GfxHwId, fg_DSTPITCH_DEC) =0;
        REG(u4GfxHwId, fg_DST_MIRR_OR) =0;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) =0;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) =1;
        break;
    case E_BITBLT_SRC_FLIP:
        REG(u4GfxHwId, fg_DSTPITCH_DEC) =0;
        REG(u4GfxHwId, fg_DST_MIRR_OR) =0;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) =1;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) =0;
        break;
    case E_BITBLT_DST_MIRROR:
        REG(u4GfxHwId, fg_DSTPITCH_DEC) =0;
        REG(u4GfxHwId, fg_DST_MIRR_OR) =1;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) =0;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) =0;
        break;
    case E_BITBLT_DST_FLIP:
        REG(u4GfxHwId, fg_DSTPITCH_DEC) =1;
        REG(u4GfxHwId, fg_DST_MIRR_OR) =0;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) =0;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) =0;
        break;
    case E_BITBLT_SRC_FLIPMIRROR:
        REG(u4GfxHwId, fg_DSTPITCH_DEC) =0;
        REG(u4GfxHwId, fg_DST_MIRR_OR) =0;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) =1;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) =1;
        break;
    case E_BITBLT_DST_FLIPMIRROR:
        REG(u4GfxHwId, fg_DSTPITCH_DEC) =1;
        REG(u4GfxHwId, fg_DST_MIRR_OR) =1;
        REG(u4GfxHwId, fg_SRCPITCH_DEC) =0;
        REG(u4GfxHwId, fg_SRC_MIRR_OR) =0;
        break;

    default:
        return -1;
    }

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_StretchComposeLoop(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                             UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH,
                             UINT32 u4AlComNormal, UINT32 u4Ar, UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 u4SrcAddr, u4DstAddr;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4SrcH - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // Stretch part:
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

#if GFX_IOMMU_WORKAROUND_BEFORE_ECO
    // normal compose in LOOP mode
    if (u4AlComNormal)
    {
        u4Ar = 255;
    }

    GFX_Disable2SrcBlending();

    REG(u4GfxHwId, fg_ALCOM_AR)       = u4Ar;
    REG(u4GfxHwId, fg_ALCOM_OPCODE)   = u4OpCode;
    REG(u4GfxHwId, fg_ALCOM_RECT_SRC) = u4RectSrc;
    REG(u4GfxHwId, fg_ALCOM_NORMAL)   = u4AlComNormal;

    if (GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
#else
    // Loop mode compose blt part:
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlComNormal, u4Ar, u4OpCode, u4RectSrc);
#endif

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_STRETCH_LOOP_ALPHA_COMPOS;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

#if GFX_IOMMU_WORKAROUND_BEFORE_ECO
    if (fgRunBelowSegmentBefore(IC_8560_VER_A)) //for before 8560ECO
    {
    	REG(u4GfxHwId, fg_ALCOM_OPCODE)   = (UINT32)0; //add by +e
		GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP);
    }
#endif

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_I2DComposeLoop(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4DstX, UINT32 u4DstY, UINT32 u4Width, UINT32 u4Height, UINT32 u4SrcPitchEn,
                         UINT8 *pv_pal_base, UINT32 u4MsbLeft, UINT32 u4StartByteAligned,
                         UINT32 u4AlComNormal, UINT32 u4Ar, UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 u4SrcAddr, u4DstAddr;

    /* destination base address */
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4Height - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // Idx2Dir part
    GFX_SetI2DBltOpt(u4GfxHwId, u4SrcPitchEn, pv_pal_base, u4MsbLeft, u4StartByteAligned);

    // Loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlComNormal, u4Ar, u4OpCode, u4RectSrc);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_IDX2DIR_LOOP_ALPHA_COMPOS;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetI2DFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_StretchRotateComposeLoop(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                                   UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH,
                                   UINT32 u4Is90CCW, UINT32 u4AlComNormal, UINT32 u4Ar, UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 u4SrcAddr, u4DstAddr;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));

    REG(u4GfxHwId, fg_DST_BSAD)  = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)  = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4SrcH - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    // Stretch part
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Rotate part
    GFX_SetRotateOpt(u4GfxHwId, FALSE, u4Is90CCW);

    // loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlComNormal, u4Ar, u4OpCode, u4RectSrc);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_STRETCH_ROTATE_LOOP_ALPHA_COMPOS;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    SetRotate(u4GfxHwId, 0);
    //[YgLi][20090218](Must Clean the two bits after blt complete, Or, maybe effects others function, such as compose)
    REG(u4GfxHwId, fg_DSTPITCH_DEC) = 0;
    GFX_CMDENQ(u4GfxHwId, GREG_BITBLT_MODE);

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_StretchMFlipComposeLoop(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                                       UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH,
                                       UINT32 u4MFOp, UINT32 u4AlComNormal, UINT32 u4Ar, UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 u4SrcAddr, u4DstAddr;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    switch (u4MFOp)
    {
    case E_BITBLT_SRC_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                            (u4SrcY * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4SrcW-1)<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                            ((u4SrcY+u4SrcH-1) * _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                            ((u4SrcY+u4SrcH-1) * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4SrcW-1)<< _u4SrcShift[u4GfxHwId]));
        break;
#if 0
    case E_BITBLT_DST_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase +
                        (u4DstY * _u4DstPitch) + ((u4DstX+u4DstW-1) << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
                            (u4SrcY * _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;
    case E_BITBLT_DST_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase +
                        ((u4DstY  +u4DstH-1)* _u4DstPitch) + (u4DstX << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
                            (u4SrcY* _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;

    case E_BITBLT_DST_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase +
                        ((u4DstY  +u4DstH-1)* _u4DstPitch) + ((u4DstX+u4DstW-1) << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
                            (u4SrcY* _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;
#endif
    default:
       return E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4SrcH - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    // Stretch part
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Mirror/Flip part
    GFX_SetMirrorFlipOpt(u4GfxHwId, u4MFOp);

    // loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlComNormal, u4Ar, u4OpCode, u4RectSrc);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_STRETCH_LOOP_ALPHA_COMPOS;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetMirrorFlipFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
 *  gfx alpha composition loop mode.
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_StretchRotateMFlipComposeLoop(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY, UINT32 u4SrcW, UINT32 u4SrcH,
                                        UINT32 u4DstX, UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH,
                                        UINT32 u4Is90CCW, UINT32 u4MFOp, UINT32 u4AlComNormal, UINT32 u4Ar, UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 u4SrcAddr, u4DstAddr;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    switch (u4MFOp)
    {
    case E_BITBLT_SRC_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                            (u4SrcY * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4SrcW-1)<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                            ((u4SrcY+u4SrcH-1) * _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
                            ((u4SrcY+u4SrcH-1) * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4SrcW-1)<< _u4SrcShift[u4GfxHwId]));
        break;
#if 0
    case E_BITBLT_DST_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase +
                        (u4DstY * _u4DstPitch) + ((u4DstX+u4DstW-1) << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
                            (u4SrcY * _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;
    case E_BITBLT_DST_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase +
                        ((u4DstY  +u4DstH-1)* _u4DstPitch) + (u4DstX << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
                            (u4SrcY* _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;

    case E_BITBLT_DST_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase +
                        ((u4DstY  +u4DstH-1)* _u4DstPitch) + ((u4DstX+u4DstW-1) << _u4DstShift));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase +
                            (u4SrcY* _u4SrcPitch) + (u4SrcX<< _u4SrcShift));
        break;
#endif
    default:
       return E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4SrcH - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    // Mirror/Flip part
    GFX_SetMirrorFlipOpt(u4GfxHwId, u4MFOp);

    // Stretch part
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Rotate part
    GFX_SetRotateOpt(u4GfxHwId, TRUE, u4Is90CCW);

    // loop mode compose part
    GFX_SetComposeLoopOpt(u4GfxHwId, u4AlComNormal, u4Ar, u4OpCode, u4RectSrc);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_STRETCH_ROTATE_LOOP_ALPHA_COMPOS;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetRotateMirrorFlipFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
*  gfx alpha composition loop mode.
*
*/
//-------------------------------------------------------------------------
INT32 GFX_StretchRotate(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY,
                        UINT32 u4SrcW, UINT32 u4SrcH, UINT32 u4DstX,
                        UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH,
                        UINT32 u4Is90CCW)
{
    UINT32 u4SrcAddr, u4DstAddr;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
    u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
        (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX << _u4SrcShift[u4GfxHwId]));

    REG(u4GfxHwId, fg_DST_BSAD)  = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD)  = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4SrcH - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // Stretch part
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Rotate part
    GFX_SetRotateOpt(u4GfxHwId, TRUE, u4Is90CCW);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_STRETCH_BITBLT;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    SetRotate(u4GfxHwId, 0);
    //[YgLi][20090218](Must Clean the two bits after blt complete, Or, maybe effects others function, such as compose)
    REG(u4GfxHwId, fg_DSTPITCH_DEC) = 0;

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_ComposeLoop
*  gfx alpha composition loop mode.
*
*/
//-------------------------------------------------------------------------
INT32 GFX_StretchMFlip(UINT32 u4GfxHwId, UINT32 u4SrcX, UINT32 u4SrcY,
                       UINT32 u4SrcW, UINT32 u4SrcH, UINT32 u4DstX,
                       UINT32 u4DstY, UINT32 u4DstW, UINT32 u4DstH,
                       UINT32 u4MFOp)
{
    UINT32 u4SrcAddr, u4DstAddr;

#ifndef GFX_SUPPORT_DIFF_CM
    if (_u4SrcCM[u4GfxHwId] != _u4DstCM[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
    if (_u4DstShift[u4GfxHwId] != _u4SrcShift[u4GfxHwId])
    {
        return -(INT32)E_GFX_INV_ARG;
    }
#endif

    switch (u4MFOp)
    {
    case E_BITBLT_SRC_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            (u4SrcY * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4SrcW-1)<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            ((u4SrcY+u4SrcH-1) * _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_SRC_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            ((u4SrcY+u4SrcH-1) * _u4SrcPitch[u4GfxHwId]) + ((u4SrcX+u4SrcW-1)<< _u4SrcShift[u4GfxHwId]));
        break;
#if 1
    case E_BITBLT_DST_MIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4DstY * _u4DstPitch[u4GfxHwId]) + ((u4DstX+u4DstW-1) << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            (u4SrcY * _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;
    case E_BITBLT_DST_FLIP:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            ((u4DstY  +u4DstH-1)* _u4DstPitch[u4GfxHwId]) + (u4DstX << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            (u4SrcY* _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;

    case E_BITBLT_DST_FLIPMIRROR:
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            ((u4DstY  +u4DstH-1)* _u4DstPitch[u4GfxHwId]) + ((u4DstX+u4DstW-1) << _u4DstShift[u4GfxHwId]));
        //source base address
        u4SrcAddr = (UINT32)(_pu1SrcBase[u4GfxHwId] +
            (u4SrcY* _u4SrcPitch[u4GfxHwId]) + (u4SrcX<< _u4SrcShift[u4GfxHwId]));
        break;
#endif
    default:
        return E_GFX_INV_ARG;
    }

    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_SRC_BSAD) = GFX_PHYSICAL(u4SrcAddr);
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4SrcW;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4SrcH - 1);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }
    // Stretch part
    GFX_SetStretchBltOpt(u4GfxHwId, u4SrcW, u4SrcH, u4DstW, u4DstH);

    // Mirror/Flip part
    GFX_SetMirrorFlipOpt(u4GfxHwId, u4MFOp);

    // Fire...
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_STRETCH_BITBLT;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    VA_MSB_REG(u4GfxHwId, fg_SRC_BSAD_H, u4SrcAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    GFX_Flush(u4GfxHwId);
    ResetMirrorFlipFlag(u4GfxHwId);

    return (INT32)E_GFX_OK;
}

