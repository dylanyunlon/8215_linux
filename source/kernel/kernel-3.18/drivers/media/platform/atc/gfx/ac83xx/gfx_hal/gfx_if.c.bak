//-------------------------------------------------------------------------
/** GFX_Fill
 *  gfx rectangle fill.
 *  calculate start memory address base + (y * width) + x.
 *  set fill width.
 *  set fill height.
 *  enque output address.
 *  enque input size.
 *  enque gfx mode (include fire control).
 */
//-------------------------------------------------------------------------
INT32 GFX_Fill(UINT32 u4GfxHwId, UINT32 u4X, UINT32 u4Y, UINT32 u4Width, UINT32 u4Height)
{
    UINT32 u4DstAddr;

    GFX_HW_FX_ENTRY;

    //destination base address
    if(u4Height<=2048)
    {
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);

        REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_RECT_FILL;
        REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
        REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
        REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

        VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
        GFX_VA_MSB_CMDENQ(u4GfxHwId);

        if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)   |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)   |
            GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        return (INT32)E_GFX_OK;
    }
    else
    {
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);

        REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_RECT_FILL;
        REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
        REG(u4GfxHwId, fg_SRC_HEIGHT) = 2047;
        REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

        VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
        GFX_VA_MSB_CMDENQ(u4GfxHwId);

        if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)   |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)   |
            GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
            ((u4Y+2048) * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);

        REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_RECT_FILL;
        REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
        REG(u4GfxHwId, fg_SRC_HEIGHT) = u4Height-2049;
        REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

        VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
        GFX_VA_MSB_CMDENQ(u4GfxHwId);

        if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)   |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)   |
            GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }
        return (INT32)E_GFX_OK;
    }

}

//-------------------------------------------------------------------------
/** GFX_Draw
 *  gfx draw rectangle.
 *  calculate start memory address base + (y * width) + x.
 *  set fill width.
 *  set fill height.
 *  enque output address.
 *  enque input size.
 *  enque gfx mode (include fire control).
 */
//-------------------------------------------------------------------------
INT32 GFX_Draw(UINT32 u4GfxHwId, UINT32 u4X, UINT32 u4Y, UINT32 u4Width, UINT32 u4Height)
{
    UINT32 u4DstAddr;

    GFX_HW_FX_ENTRY;

    //destination base address
    if(u4Height <= 2048)
    {
        // top line
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                    (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
        REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_RECT_FILL;
        REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
        REG(u4GfxHwId, fg_SRC_HEIGHT) = 0;
        REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

        VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
        GFX_VA_MSB_CMDENQ(u4GfxHwId);

        if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)   |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)   |
            GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        // left line
        REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_RECT_FILL;
        REG(u4GfxHwId, fg_SRC_WIDTH)  = 1;
        REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
        REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

        VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
        GFX_VA_MSB_CMDENQ(u4GfxHwId);

        if (GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)   |
            GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        // bottom line
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4Y + u4Height - 1) * _u4DstPitch[u4GfxHwId] +
                             (u4X << _u4DstShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
        REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_RECT_FILL;
        REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
        REG(u4GfxHwId, fg_SRC_HEIGHT) = 0;
        REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

        VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
        GFX_VA_MSB_CMDENQ(u4GfxHwId);

        if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)   |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)   |
            GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        // right line
        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + u4Y * _u4DstPitch[u4GfxHwId] +
                             ((u4X + u4Width - 1) << _u4DstShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
        REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_RECT_FILL;
        REG(u4GfxHwId, fg_SRC_WIDTH)  = 1;
        REG(u4GfxHwId, fg_SRC_HEIGHT) = (u4Height - 1);
        REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;

        VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
        GFX_VA_MSB_CMDENQ(u4GfxHwId);

        if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)   |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)   |
            GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        return (INT32)E_GFX_OK;
    }
    else
    {
        return (INT32)E_GFX_INV_ARG;
    }
}

//-------------------------------------------------------------------------
/** GFX_DrawCompose
 *  gfx draw rectangle + alpha composition.
 *  calculate start memory address base + (y * width) + x.
 *  set fill width.
 *  set fill height.
 *  enque output address.
 *  enque input size.
 *  enque gfx mode (include fire control).
 */
//-------------------------------------------------------------------------
INT32 GFX_DrawCompose(UINT32 u4GfxHwId, UINT32 u4X, UINT32 u4Y, UINT32 u4Width, UINT32 u4Height,
                      UINT32 u4Ar, UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 u4DstAddr;

    #if 0//(CONFIG_CHIP_VER_CURR <= CONFIG_CHIP_VER_MT8560)
    if (((UINT32)CM_ARGB8888_DIRECT32 == _u4SrcCM[u4GfxHwId]) &&
        ((UINT32)CM_ARGB8888_DIRECT32 == _u4DstCM[u4GfxHwId]))
    #endif
    {
        if (((UINT32)E_AC_CLEAR == u4OpCode) || ((UINT32)E_AC_SRC == u4OpCode))
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_Draw(u4GfxHwId, u4X, u4Y, u4Width, u4Height);

            // restore original value
            GFX_SetColor(u4GfxHwId, u4RectColor);
            return (INT32)E_GFX_OK;
        }
        else
        {
            //do nothing, for lint happy
        }
    }

    GFX_Disable2SrcBlending();

    // top line
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = 0;
    REG(u4GfxHwId, fg_ALCOM_AR)       = u4Ar;
    REG(u4GfxHwId, fg_ALCOM_OPCODE)   = u4OpCode;
    REG(u4GfxHwId, fg_ALCOM_RECT_SRC) = u4RectSrc;

    REG(u4GfxHwId, fg_ALCOM_NORMAL) = (u4Ar == 255);
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP)     |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // left line
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4Height - 1);
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // bottom line
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + (u4Y + u4Height - 1) * _u4DstPitch[u4GfxHwId] +
                         (u4X << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = 0;
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    // right line
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] + u4Y * _u4DstPitch[u4GfxHwId] +
                         ((u4X + u4Width - 1) << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = 1;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = (u4Height - 1);
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_FillTriangle
 *  gfx fill triangle.
 *  calculate start memory address base + (y * width) + x.
 *  set fill width.
 *  set fill height.
 *  enque output address.
 *  enque input size.
 *  enque gfx mode (include fire control).
 */
//-------------------------------------------------------------------------
INT32 GFX_FillTriangle(UINT32 u4GfxHwId, UINT32 u4X1, UINT32 u4Y1, UINT32 u4X2, UINT32 u4Y2, UINT32 u4X3, UINT32 u4Y3)
{
    UINT32 u4DstAddr;
    UINT32 u4Width = 2, u4Index = 0;
    UINT32 u4X = u4X1, u4Y = u4Y1;

    GFX_HW_FX_ENTRY;
    //UTIL_Printf("[%s] Entry\n", __FUNCTION__);

    // First fill rectangle
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
    REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_RECT_FILL;
    REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = 0;
    REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;
    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);
    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)   |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)   |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    u4Y++;
    for (u4Index = 1; u4Index < 256; u4Index++, u4Y++)
    {
        if (u4Index < 128)
        {
            u4Width += 2;
        }
        else if (u4Index == 192)
        {
            u4Width--;
        }
        else
        {
            u4Width -= 2;
        }
        //UTIL_Printf("[%s] u4Index = %d, u4Width = %d\n", __FUNCTION__, u4Index, u4Width);

        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                    (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
        REG(u4GfxHwId, fg_OP_MODE)    = (UINT32)OP_RECT_FILL;
        REG(u4GfxHwId, fg_SRC_WIDTH)  = u4Width;
        REG(u4GfxHwId, fg_FIRE)       = GFX_ENGINE_FIRE;
        if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)   |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)   |
            GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }
    }

    return (INT32)E_GFX_OK;
}

//-------------------------------------------------------------------------
/** GFX_FillTriangleCompose
 *  gfx fill triangle + alpha composition.
 *  calculate start memory address base + (y * width) + x.
 *  set fill width.
 *  set fill height.
 *  enque output address.
 *  enque input size.
 *  enque gfx mode (include fire control).
 */
//-------------------------------------------------------------------------
INT32 GFX_FillTriangleCompose(UINT32 u4GfxHwId, UINT32 u4X1, UINT32 u4Y1, UINT32 u4X2, UINT32 u4Y2, UINT32 u4X3, UINT32 u4Y3,
                              UINT32 u4Ar, UINT32 u4OpCode, UINT32 u4RectSrc)
{
    UINT32 u4DstAddr;
    UINT32 u4Width = 2, u4Index = 0;
    UINT32 u4X = u4X1, u4Y = u4Y1;

    #if 0//(CONFIG_CHIP_VER_CURR <= CONFIG_CHIP_VER_MT8560)
    if (((UINT32)CM_ARGB8888_DIRECT32 == _u4SrcCM[u4GfxHwId]) &&
        ((UINT32)CM_ARGB8888_DIRECT32 == _u4DstCM[u4GfxHwId]))
    #endif
    {
        if (((UINT32)E_AC_CLEAR == u4OpCode) || ((UINT32)E_AC_SRC == u4OpCode))
        {
            UINT32 u4RectColor = REG(u4GfxHwId, fg_RECT_COLOR);

            GFX_SetColor(u4GfxHwId, 0x0);
            GFX_FillTriangle(u4GfxHwId, u4X1, u4Y1, u4X2, u4Y2, u4X3, u4Y3);

            // restore original value
            GFX_SetColor(u4GfxHwId, u4RectColor);
            return (INT32)E_GFX_OK;
        }
        else
        {
            //do nothing, for lint happy
        }
    }

    GFX_Disable2SrcBlending();
    // normal compose in LOOP mode

    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);

    REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
    REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT)     = 0;
    REG(u4GfxHwId, fg_ALCOM_AR)       = u4Ar;
    REG(u4GfxHwId, fg_ALCOM_OPCODE)   = u4OpCode;
    REG(u4GfxHwId, fg_ALCOM_RECT_SRC) = u4RectSrc;

    REG(u4GfxHwId, fg_ALCOM_NORMAL) = (u4Ar == 255);
    REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
        GFX_CMDENQ(u4GfxHwId, GREG_ALCOM_LOOP)     |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    u4Y++;
    for (u4Index = 1; u4Index < 256; u4Index++, u4Y++)
    {
        if (u4Index < 128)
        {
            u4Width += 2;
        }
        else if (u4Index == 192)
        {
            u4Width--;
        }
        else
        {
            u4Width -= 2;
        }

        u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
                    (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
        REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);
        REG(u4GfxHwId, fg_OP_MODE)        = (UINT32) OP_LOOP_ALPAH_COMPOS;
        REG(u4GfxHwId, fg_SRC_WIDTH)      = u4Width;
        REG(u4GfxHwId, fg_FIRE)           = GFX_ENGINE_FIRE;

        VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
        GFX_VA_MSB_CMDENQ(u4GfxHwId);

        if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)       |
            GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)       |
            GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
        {
            return -(INT32)E_GFX_OUT_OF_MEM;
        }
    }

    return (INT32)E_GFX_OK;
}

