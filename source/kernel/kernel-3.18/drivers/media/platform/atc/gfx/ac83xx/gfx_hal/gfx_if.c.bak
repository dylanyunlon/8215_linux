//-------------------------------------------------------------------------
/** GFX_Uninit
 *  gfx uninit.
 *  reset gfx.
 *  reset gfx timer.
 *  clear soft reg file.
 *  init dif.
 *  init command que.
 */
//-------------------------------------------------------------------------
INT32 i4GFXUninit(void)
{
    INT32 i4Ret;
    INT32 i4;
#ifdef GL_XOR
    UINT32 ui4_i = 0;
#endif
    LOG(1, "GFX engine uninit......\n");



#if 0//(!CONFIG_DRV_FPGA_BOARD)
         // LOG(1, "GFX engine works too long (300 secs)......\n");
    CKGEN_AgtSelClk(e_CLK_GRAPH, CLK_CLK_GRAPH_SEL_SYSPLL2_1_2);
#endif //#if (!CONFIG_DRV_FPGA_BOARD)
	
   x_sema_delete(_semGfxLock);

   for(i4 = 0;i4 < GFX_HAL_HW_INST_NUM;i4++)
   {
       x_sema_delete(_semGfxCmdque[i4]);
   }

#if 0
    if (_semGfxOp != NULL_HANDLE)
    {
        x_sema_delete(_semGfxOp);
        x_sema_delete(_semGfxLock);
        x_sema_delete(_semGfxLockCmdque);
        x_sema_delete(_semGfxSrcQ);
        x_sema_delete(_semGfxDstQ);
        x_sema_delete(_semGfxBmp);
        //added by msz00441 for  buffer and height 2k
        x_sema_delete(_semGfxBuffer);
        x_sema_delete(_semGfxHeight);
    }
#endif
    //HW uninit
    for(i4 = 0;i4 < GFX_HAL_HW_INST_NUM;i4++)
   {
         i4Ret = GFX_Reset(i4,GFX_RESET_POWERDOWN);
         if (i4Ret != (INT32)E_GFX_OK)
         {
             return i4Ret;
         }
    }
    //sw resource  interrupt
    GFX_HwUninit();
for(i4 = 0;i4 < GFX_HAL_HW_INST_NUM;i4++)
{
    i4Ret = GFX_DifUninit(i4);
    if (i4Ret != (INT32)E_GFX_OK)
    {
        return i4Ret;
    }
    i4Ret = GFX_CmdQueUninit(i4);
    #ifdef GL_XOR
    while ( ui4_i < GFX_HAL_HW_INST_NUM)
    {

#if 1//CONFIG_SYS_MEM_PHASE2
        GFX_FREE_ALGN_MEM(pvWokingBuffer[ui4_i]);
#elif CONFIG_SYS_MEM_PHASE3
    #if CONFIG_ENABLE_IOMMU
        x_mem_vfree(pvWokingBuffer[ui4_i]);
    #else
        //x_mem_aligned_free(pvWokingBuffer[ui4_i]);
        x_kmem_block_aligned_free(hWokingBufHandle[ui4_i]);
    #endif
#else
        GFX_MEM_FREE(pvWokingBufferFree[ui4_i]);
        pvWokingBufferFree[ui4_i] = NULL;
#endif

        pvWokingBuffer[ui4_i] = NULL;
        //x_mem_free(pvWokingBufferFree2[ui4_i]);
        //pvWokingBufferFree2[ui4_i] = NULL;
        pvWokingBuffer2[ui4_i] = NULL;
        ui4_i++ ;
    }
    #endif
}

    //Delete event
    for (i4=0; i4<GFX_HAL_HW_INST_NUM; i4++)
    {
        i4Ret = x_ev_group_delete(_arGfxDrvInst[i4].hEventHandle);
		_arGfxDrvInst[i4].hEventHandle = 0;
        VERIFY(i4Ret == OSR_OK);
    }

    return i4Ret;
}
