    GFX_MMUCfgA2(u4GfxHwId, 1, 1, 1, 1, 0, 0, 0);
    GFX_MMUCfgA3(u4GfxHwId, 0, 0, 0, 0, 0, 0, 0);
#endif
    return (E_GFX_OK);
}

/*
IOMMU_CFG2:
<compression> GFX = 0x00390037
<other>       GFX = 0x00390031
IOMMU_CFG3:
<compression> GFX = 0x00000033
<other>       GFX = 0x00000033
*/
INT32 GFX_MMUCfgForCompressFunc(UINT32 u4GfxHwId, UINT32 u4Enable, UINT32 u4SrcRead, UINT32 u4DstRead, UINT32 u4DstWrite)
