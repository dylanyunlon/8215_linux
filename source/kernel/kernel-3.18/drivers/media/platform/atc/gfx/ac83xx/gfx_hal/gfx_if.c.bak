//-------------------------------------------------------------------------
/** GFX_SetLegalAddress
 *  set legal-written start and end addresses
 */
//-------------------------------------------------------------------------
INT32 GFX_SetLegalAddress(UINT32 u4GfxHwId, UINT32 u4Start, UINT32 u4End)
{
    REG(u4GfxHwId, fg_WR_PROT_EN)       = GFX_ENABLE;
    REG(u4GfxHwId, fg_LEGAL_AD_START)   = GFX_PHYSICAL_SAFE(u4Start);
    REG(u4GfxHwId, fg_LEGAL_AD_END)     = GFX_PHYSICAL_SAFE(u4End);

    VA_MSB_REG(u4GfxHwId, fg_LEGAL_AD_START_H, u4Start);
    VA_MSB_REG(u4GfxHwId, fg_LEGAL_AD_END_H, u4End);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_LEGAL_START_ADDR)  |
        GFX_CMDENQ(u4GfxHwId, GREG_LEGAL_END_ADDR))
    {
        return -(INT32)E_GFX_INV_ARG;
    }

    return (INT32)E_GFX_OK;
}
#endif // #if defined(GFX_DEBUG_MODE)


//-------------------------------------------------------------------------
/** GFX_Memset
 *  use GFX hw engine to do memset
 *
 */
//-------------------------------------------------------------------------
INT32 GFX_Memset(UINT32 u4GfxHwId, UINT8 *pu1Addr, UINT32 u4Size, UINT32 u4Color)
{
    UINT8 *pu1NextAddr;
    UINT32 i, u4Loops, u4Last;
    UINT32 u4Pitch = 16384;

    VERIFY(pu1Addr != NULL);
    VERIFY(u4Size > 0);

    pu1NextAddr = pu1Addr;
    u4Loops = u4Size / u4Pitch;
    u4Last  = u4Size % u4Pitch;

    //GFX_Lock();

    for (i = 0; i < u4Loops; i++)
    {
        if (GFX_SetDst(u4GfxHwId, pu1NextAddr, (UINT32)CM_RGB_CLUT8, u4Pitch))
        {
           // GFX_Unlock();
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        if (GFX_SetColor(u4GfxHwId, u4Color))
        {
           // GFX_Unlock();
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        if (GFX_Fill(u4GfxHwId, 0, 0, u4Pitch, 1))
        {
           // GFX_Unlock();
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        pu1NextAddr = (UINT8 *)((UINT32)pu1NextAddr + u4Pitch);
    } // ~for

    if (u4Last)
    {
        if (GFX_SetDst(u4GfxHwId, pu1NextAddr, (UINT32)CM_RGB_CLUT8, u4Pitch))
        {
           // GFX_Unlock();
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        if (GFX_SetColor(u4GfxHwId, u4Color))
        {
           // GFX_Unlock();
            return -(INT32)E_GFX_OUT_OF_MEM;
        }

        if (GFX_Fill(u4GfxHwId, 0, 0, u4Last, 1))
        {
           // GFX_Unlock();
            return -(INT32)E_GFX_OUT_OF_MEM;
        }
    }

    if (GFX_Flush(u4GfxHwId))
    {
        //GFX_Unlock();
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    //GFX_Wait();

    //GFX_Unlock();

    return (INT32)E_GFX_OK;
}


