//-------------------------------------------------------------------------
/** GFX_HLine
 *  gfx draw horizontal line.
 *  calculate output address.
 *  set operation mode.
 *  set width.
 *  enque relative registers.
 */
//-------------------------------------------------------------------------
INT32 GFX_HLine(UINT32 u4GfxHwId, UINT32 u4X, UINT32 u4Y, UINT32 u4Width)
{
    UINT32 u4DstAddr;

    GFX_HW_FX_ENTRY;
    //destination base address
    u4DstAddr = (UINT32)(_pu1DstBase[u4GfxHwId] +
        (u4Y * _u4DstPitch[u4GfxHwId]) + (u4X << _u4DstShift[u4GfxHwId]));
    REG(u4GfxHwId, fg_DST_BSAD) = GFX_PHYSICAL(u4DstAddr);

    REG(u4GfxHwId, fg_OP_MODE)   = (UINT32)OP_DRAW_HLINE;
    REG(u4GfxHwId, fg_SRC_WIDTH) = u4Width;
    REG(u4GfxHwId, fg_SRC_HEIGHT) = 0;
    REG(u4GfxHwId, fg_FIRE)      = GFX_ENGINE_FIRE;

    VA_MSB_REG(u4GfxHwId, fg_DST_BSAD_H, u4DstAddr);
    GFX_VA_MSB_CMDENQ(u4GfxHwId);

    if (GFX_CMDENQ(u4GfxHwId, GREG_DST_BSAD)   |
        GFX_CMDENQ(u4GfxHwId, GREG_SRC_SIZE)   |
        GFX_CMDENQ(u4GfxHwId, GREG_G_MODE))
    {
        return -(INT32)E_GFX_OUT_OF_MEM;
    }

    return (INT32)E_GFX_OK;
}


//-------------------------------------------------------------------------
/** GFX_VLine
 *  gfx draw vertical line.
 *  calculate output address.
 *  set operation mode.
