void GFX_GetTopWorkingBufferWidth(UINT32 u4GfxHwId, UINT32 ui4_height,UINT32 *pui4_width)
{
#if !(GFX_REDUCE_WORKINGBUF)
    *pui4_width = GFX_WORKINGBUFFER_SIZE /ui4_height/2;
#else
