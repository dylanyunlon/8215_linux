#endif
}

void GFX_GetBottomWorkingBufferHeight(UINT32 u4GfxHwId, void** ppvBuffer, UINT32 ui4_pitch,UINT32 *pui4_height)
{
#if !(GFX_REDUCE_WORKINGBUF)
    *pui4_height = GFX_WORKINGBUFFER_SIZE /ui4_pitch/2;
     *ppvBuffer = pvWokingBuffer2[u4GfxHwId];
#else
    *pui4_height = GFX_WORKINGBUFFER_SIZE /ui4_pitch;

    if ((!(prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree)) ||
        (!(prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBuf)))
    {
        #if 1//CONFIG_SYS_MEM_PHASE2
			//ATC68024 -- dont find symbol:x_alloc_aligned_mem
            prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree =
                            GFX_ALLOC_ALGN_MEM(GFX_WORKINGBUFFER_SIZE, 16);//x_alloc_aligned_mem(GFX_WORKINGBUFFER_SIZE, 16);
            prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBuf =
                            prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree;
        #elif CONFIG_SYS_MEM_PHASE3
            #if CONFIG_ENABLE_IOMMU
            prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree = x_mem_valloc(GFX_WORKINGBUFFER_SIZE);
            prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBuf = prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree;
            #else
            prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree =
                    (VOID*)x_kmem_block_aligned_alloc(GFX_WORKINGBUFFER_SIZE, 16);

            prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBuf =
                    x_kmem_kernel_address((HANDLE_T)(prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree), 0);
            #endif
        #else
            UTIL_Printf(" NO CONFIG_SYS_MEM_PHASE2 \r\n");
            prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree
                            = GFX_ALLOC_VMEM(GFX_WORKINGBUFFER_SIZE + 15);
            prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBuf
                            = (void*)(((UINT32)prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBufFree +15)&(~15));
        #endif

        UTIL_Printf("[gfx] GFX_GetBottomWorkingBufferHeight buffer malloc\n");
    }
    else
    {
        UTIL_Printf("[gfx] GFX_GetBottomWorkingBufferHeight buffer not need malloc\n");
    }

    *ppvBuffer = prGfxReduceBottomWorkingBuf[u4GfxHwId].pvBottomBuf;
#endif
}

void GFX_GetBottomWorkingBufferWidth(UINT32 u4GfxHwId, UINT32 ui4_height,UINT32 *pui4_width)
{
#if !(GFX_REDUCE_WORKINGBUF)
    *pui4_width = GFX_WORKINGBUFFER_SIZE /ui4_height/2;
#else
    *pui4_width = GFX_WORKINGBUFFER_SIZE /ui4_height;
#endif
}

