INT32 GFX_MMUCfgA3(UINT32 u4GfxHwId, UINT32 u4En, UINT32 u4Mid, UINT32 u4Prefetch, UINT32 u42DPrefetch,
                   UINT32 u4PrefetchDec, UINT32 u4TwoWay, UINT32 u4Mid2nd)
