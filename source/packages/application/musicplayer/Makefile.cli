# Makefile.cli — Build music_app_cli (headless test tool)
#
# This builds the full music_app stack WITHOUT AWTK dependency.
# Uses awtk_stub.h to replace AWTK's idle_queue/timer with pthread stubs.
#
# ============================================================================
# Usage:
#
#   1) Cross-compile for AC8215 (on build server):
#
#      cd source/packages/application/musicplayer
#      make -f Makefile.cli
#
#   2) Deploy to board:
#
#      adb push music_app_cli /usr/bin/
#      adb shell chmod +x /usr/bin/music_app_cli
#
#   3) Run on board (insert USB with music first):
#
#      adb shell music_app_cli
#
#   4) Or specify scan path directly:
#
#      adb shell music_app_cli /mnt/usb0
#
# ============================================================================

TOPDIR      ?= $(shell cd ../../../.. && pwd)

# ===========================================================================
# Toolchain
# ===========================================================================
CROSS_COMPILE ?= $(TOPDIR)/out/host/bin/arm-buildroot-linux-gnueabi-
CC            = $(CROSS_COMPILE)gcc
CXX           = $(CROSS_COMPILE)g++
SYSROOT_DIR  ?= $(TOPDIR)/out/host/arm-buildroot-linux-gnueabi/sysroot

TARGET        = music_app_cli

# ===========================================================================
# Source files
# ===========================================================================
# CLI main
CLI_SRC       = music_app_cli.c

# music_app layer (the code under test)
APP_C_SRCS    = awtk_app/src/music_app.c \
                awtk_app/src/usb_monitor.c \
                awtk_app/src/favorite_manager.c \
                awtk_app/src/cmus_bridge.c

# cmus ported modules (id3/cue/charset)
CMUS_C_SRCS   = $(filter-out awtk_app/src/cmus/test_cmus_port.c, $(wildcard awtk_app/src/cmus/*.c))

# Shared library sources
LIB_C_SRCS    =
LIB_CPP_SRCS  = music_scanner.cpp music_player.cpp

# musikcube soft player sources
SOFT_CPP_SRCS = awtk_app/src/musikcube/soft_player.cpp \
                awtk_app/src/musikcube/audio/Buffer.cpp \
                awtk_app/src/musikcube/io/LocalFileStream.cpp \
                awtk_app/src/musikcube/plugins/ffmpegdecoder/FfmpegDecoder.cpp \
                awtk_app/src/musikcube/plugins/alsaout/AlsaOut.cpp

# All sources
C_SRCS        = $(CLI_SRC) $(APP_C_SRCS) $(CMUS_C_SRCS) $(LIB_C_SRCS)
CPP_SRCS      = $(LIB_CPP_SRCS) $(SOFT_CPP_SRCS)

C_OBJS        = $(C_SRCS:.c=.o)
CPP_OBJS      = $(CPP_SRCS:.cpp=.o)
OBJS          = $(C_OBJS) $(CPP_OBJS)

# ===========================================================================
# Flags
# ===========================================================================
# Key: -DAWTK_STUB makes music_app.h include awtk_stub.h instead of awtk.h
COMMON_FLAGS  = -Wall -Wextra -Wno-unused-parameter -O2
COMMON_FLAGS += -DAWTK_STUB
COMMON_FLAGS += -DUSE_CMUS_ID3
COMMON_FLAGS += -DUSE_SOFT_PLAYER
COMMON_FLAGS += -D_GNU_SOURCE

INC_FLAGS     = -I. -Iawtk_app/src -Iawtk_app/src/cmus
INC_FLAGS    += -Iawtk_app/src/musikcube
INC_FLAGS    += -Iawtk_app/src/musikcube/sdk
INC_FLAGS    += --sysroot=$(SYSROOT_DIR)
INC_FLAGS    += -I$(TOPDIR)/prebuild/multimedia/mediaplayerserver/include
INC_FLAGS    += -I$(TOPDIR)/prebuild/multimedia/libatcmultimedia/include
INC_FLAGS    += -I$(TOPDIR)/prebuild/multimedia/mmisc/include
INC_FLAGS    += -I$(TOPDIR)/prebuild/multimedia/mmisc/osal/include
INC_FLAGS    += -I$(TOPDIR)/source/packages/multimedia/directrender/include
INC_FLAGS    += -I$(TOPDIR)/source/packages/multimedia/directrender/src/utils
# display.h, types.h, etc. (found via: find out -name "display.h")
OUTDIR       ?= $(TOPDIR)/out
INC_FLAGS    += -I$(OUTDIR)/build/ac83xx/linux-local/include/media/atc
INC_FLAGS    += -I$(OUTDIR)/build/ac83xx/linux-local/drivers/misc/atc/inc
INC_FLAGS    += -I$(OUTDIR)/build/ac83xx/directrender-1.0/src/utils
INC_FLAGS    += -I$(OUTDIR)/build/ac83xx/directrender-1.0/include
INC_FLAGS    += -I$(OUTDIR)/build/ac83xx/atcmultimedia-1.0/include

CFLAGS        = $(COMMON_FLAGS) $(INC_FLAGS) -std=c11
CXXFLAGS      = $(COMMON_FLAGS) $(INC_FLAGS) -std=c++14 -fexceptions -Wno-unused-variable -Wno-reorder -Wno-sign-compare

LDFLAGS       = --sysroot=$(SYSROOT_DIR)
LDFLAGS      += -L$(SYSROOT_DIR)/usr/lib
LDFLAGS      += -latcmediaplayer
LDFLAGS      += -lavformat -lavcodec -lavutil -lswresample
LDFLAGS      += -lasound
LDFLAGS      += -lpthread -lm -ldl -lz
LDFLAGS      += -Wl,-rpath,/usr/lib

# ===========================================================================
# Rules
# ===========================================================================
.PHONY: all clean

all: $(TARGET)
	@echo ""
	@echo "============================================"
	@echo " Built: $(TARGET)"
	@echo ""
	@echo " Deploy to board:"
	@echo "   adb push $(TARGET) /usr/bin/"
	@echo "   adb shell chmod +x /usr/bin/$(TARGET)"
	@echo ""
	@echo " Run:"
	@echo "   adb shell $(TARGET)"
	@echo "============================================"
	@echo ""

$(TARGET): $(OBJS)
	$(CXX) $(OBJS) -o $@ $(LDFLAGS)

# C files
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# C++ files
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)
	@echo "Cleaned."
