																anim_image_id,
														#endif
																&new_cliped_farther_rect/*all father insection zone*/
																,pfather_alpha_scale
																);
											}
										}
										else{}	
										/*save last index at p2*/
									#ifdef HMI_SIMULATE_QD
										memset(&custom_object_prop,0,sizeof(HMI_CUSTOM_PROP_STR));
										custom_object_prop.begin	= HMI_MAX_INT16;/*no modify*/		
										custom_object_prop.end		= HMI_MAX_INT16;		
										custom_object_prop.x		= HMI_MAX_INT16;
