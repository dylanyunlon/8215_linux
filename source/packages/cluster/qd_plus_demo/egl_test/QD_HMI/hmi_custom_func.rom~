U08 *hmi_get_public_memory(U32				buffer_len)
{
	U08 		*pbuffer	= NULL;

	if(hmi_public_buffer.ppublic_buffer != NULL)
	{										
		if(buffer_len > hmi_public_buffer.buffer_len)
		{
			hmi_dealloc_vram(hmi_public_buffer.ppublic_buffer);
			hmi_public_buffer.ppublic_buffer	= (BYTE *)hmi_malloc_vram(buffer_len);
			if(hmi_public_buffer.ppublic_buffer != NULL)
			{
				hmi_public_buffer.buffer_len	= buffer_len;							
			}
			else
			{
				hmi_public_buffer.buffer_len	= 0U;
			}
		}
	}
	else	/*not malloc memory*/
	{
		hmi_public_buffer.ppublic_buffer	= (BYTE *)hmi_malloc_vram(buffer_len);
		if(hmi_public_buffer.ppublic_buffer != NULL)
		{
			hmi_public_buffer.buffer_len	= buffer_len;
		}
		else
		{
			hmi_public_buffer.buffer_len	= 0U;
		}
	}
	pbuffer = hmi_public_buffer.ppublic_buffer;
				
	return	pbuffer;
}



