/*
pvector1,pvector2 is normal vector
angle . pvector1 CW to pvector2
*/
float_32 hmi_2vector_angle(SPOINT_TP *pvector1,POINT_FLOAT_TP *pvector2)
{
	float_32	angle		= 0.0f;
	float_32	dot_mul_f	= 0.0f;

	if((pvector1 != NULL)&&(pvector2 != NULL))
	{
		dot_mul_f		= (float_32)(HMI_DOT_MUL_XY((*pvector1),(*pvector2)));
		if(dot_mul_f > 1.0f)
		{
			dot_mul_f	= 1.0f;
		}
		else if(dot_mul_f < -1.0f)
		{
			dot_mul_f	= -1.0f;
		}
		else
		{
		}
		angle	= (float_32)( (acosf(dot_mul_f) / HMI_PI) * HMI_HALF_CIRCLE_ANGEL);
		if(angle < 0.0f)
		{
			angle	-= angle;
		}
		/*ccw*/
		dot_mul_f = HMI_CROSS_MUL2((*pvector1), (*pvector2));
		if(dot_mul_f < 0.0f)/*p2 ccw to p1*/
		{
			angle	= HMI_CIRCLE_ANGEL - angle;
		}
	}

	return	angle;
}

