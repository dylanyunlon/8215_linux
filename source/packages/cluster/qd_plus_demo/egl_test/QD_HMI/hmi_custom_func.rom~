void hmi_init_sub_model_3d_fifo(void)
{
	hmi_sub_model_3d_normal.sub_m3d_head		= 0u;
	hmi_sub_model_3d_normal.sub_m3d_tail		= 0u;
	hmi_sub_model_3d_alpha.sub_m3d_head		= 0u;
	hmi_sub_model_3d_alpha.sub_m3d_tail		= 0u;
}
BOOLEAN	hmi_sub_model_3d_fifo_in(HMI_SUB_MODEL_3D_FIFO_STR	*pfifo,HMI_SUB_MODEL_3D_INFO_STR *p3d_info)
{
	BOOLEAN						success				= FALSE;
	UINT32						next_tail			= 0;
	HMI_SUB_MODEL_3D_INFO_STR	*pelem				= NULL;
	if((pfifo != NULL) && (p3d_info != NULL))
	{
		next_tail	= pfifo->sub_m3d_tail + 1;
		if(next_tail >= HMI_SUB_MODEL_3D_FIFO_CNT)
		{
			next_tail	= 0;
		}
		if(next_tail != pfifo->sub_m3d_head)/*not full*/
		{
			if(pfifo->sub_m3d_tail < HMI_SUB_MODEL_3D_FIFO_CNT)
			{
				pelem	= &(pfifo->hmi_sub_model_3d_list[pfifo->sub_m3d_tail]);
				if(pelem != NULL)
				{
					pelem->sub_m3d_farther_rect 		= p3d_info->sub_m3d_farther_rect ;
					pelem->sub_m3d_dirty_rect			= p3d_info->sub_m3d_dirty_rect;
					pelem->sub_m3d_depth				= p3d_info->sub_m3d_depth;
					pelem->sub_m3d_cliped_farther_rect	= p3d_info->sub_m3d_cliped_farther_rect;
					pelem->sub_m3d_id					= p3d_info->sub_m3d_id;
					pelem->sub_m3d_father_alpha_scale	= p3d_info->sub_m3d_father_alpha_scale;
					pelem->sub_m3d_dyn_texture			= p3d_info->sub_m3d_dyn_texture;
					pelem->sub_m3d_father_matrix		= p3d_info->sub_m3d_father_matrix;
					success								= TRUE;
				}
				pfifo->sub_m3d_tail = next_tail;
			}
		}
	}
	return	success;
}
