										else if(align == 1/*center align*/)
										{
											cur_scroll_total	= -cur_scroll_total;
											dsp_num_zone.x	= (HMI_X_STR)((custom_rect.w / 2u) - (dsp_num_zone.w / 2u) + cur_scroll_total);
											dsp_num_zone.y	= (HMI_Y_STR)((custom_rect.h / 2u) - (dsp_num_zone.h / 2u));
										}
										else if(align == 2/*right align*/)
										{
											dsp_num_zone.x	= (HMI_X_STR)(custom_rect.w - dsp_num_zone.w + cur_scroll_total);
											dsp_num_zone.y	= (HMI_Y_STR)((custom_rect.h / 2u) - (dsp_num_zone.h / 2u));
										}
										else
										{
											dsp_num_zone.x	= 0;
