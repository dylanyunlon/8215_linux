/*
0:3d object,
1:sub 3d object
2:camera
3:light spot
4:light direct
5:light point
6: 3d container custom
*/

INT32	is3dcameralightcustom(HMI_OBJECT_ID_STR				custom_id)
{
	INT32								ielemtype				= -1;
	HMI_3D_SUB_CUSTOM_USR_DATA_STR		*psub_mode				= NULL;	
	BOOLEAN 							hmi_get_success 		= FALSE;
	HMI_OBJECT_ID_STR					hmi_object_index		= 0U;
	HMI_CUSTOM_USR_DATA_STR	CONST		*pcustom_data			= NULL;

	if(HMI_IS_CUSTOM_SXY(custom_id))
	{
	#if HMI_SXY_CUSTOM_CNT  > 0
		hmi_object_index = HMI_GET_CUSTOM_SXY_ID_INDEX(custom_id);
		if(hmi_object_index	< HMI_SXY_CUSTOM_CNT)
		{
			pcustom_data	= &hmi_sxy_custom_lib_data[hmi_object_index];			
		}
	#endif
	}
	else if(HMI_IS_DYN_XY_CUSTOM(custom_id))
	{
	#if	HMI_DXY_CUSTOM_CNT > 0
		hmi_object_index	= HMI_GET_DXY_CUSTOM_INDEX(custom_id);
		if(hmi_object_index	< HMI_DXY_CUSTOM_CNT)
		{			
			pcustom_data	= &hmi_dxy_custom_lib_data[hmi_object_index];					
		}
	#endif
	}
	else{}

	if(pcustom_data != NULL)
	{
		ielemtype	= pcustom_data->custom_type;
	}
	
	return	ielemtype;
}


HMI_OBJECT_ID_STR	getsceneview(HMI_OBJECT_ID_STR		hmi_object_id)
{
	HMI_OBJECT_ID_STR			camera_id					= HMI_NB_ELEMENTS;
	HMI_OBJECT_ID_STR			hmi_object_index			= 0;
	UINT32						i							= 0u;
	UINT32						object_number				= 0u;
	HMI_OBJECT_TABLE_STR CONST	*pcontainer_object_table	= NULL;
	HMI_OBJECT_PROP_STR CONST	*p_object_table				= NULL;
	BOOLEAN						find						= FALSE;
	INT32						iType						= 0;

	if(HMI_IS_DYN_XY_CONTAINER(hmi_object_id))
	{		
		hmi_object_index = HMI_GET_DYN_XY_CONTAINER_INDEX(hmi_object_id );
		if(hmi_object_index < HMI_DXY_CONTAINERS_NUMBER)
		{
		#if HMI_DXY_CONTAINERS_NUMBER > 0
			if(hmi_dxy_container_video_fmt[hmi_object_index].video_fmt_channel &
				HMI_SCENE_WINDOW)
			{
				pcontainer_object_table	= 
						&(hmi_dyn_xy_container_table[hmi_object_index].container_object_table);
				p_object_table			= pcontainer_object_table->p_object_table;
				object_number			= pcontainer_object_table->object_number;
				if(p_object_table != NULL)
				{
					for(i = 0;(i < object_number)&&(find == FALSE);i++)
					{
						if((HMI_IS_CUSTOM_SXY(p_object_table[i].object_id))||
							(HMI_IS_DYN_XY_CUSTOM(p_object_table[i].object_id)))
						{
							iType	= is3dcameralightcustom(p_object_table[i].object_id);
							if((iType == 2)/*camera*/)
							{
								camera_id	= p_object_table[i].object_id;
								find		= TRUE;
							}
						}
					}
				}
			}
		#endif
		}
	}
		
	return		camera_id;
}


HMI_OBJECT_TABLE_STR	CONST	*get_scene_childtype_list(HMI_OBJECT_ID_STR	custom_id)
{
	HMI_OBJECT_TABLE_STR CONST	*pojb_tlb			= NULL;
	HMI_OBJECT_ID_STR			hmi_object_index	= 0;

	/*only dxy contaien can as scene container*/
	if(HMI_IS_DYN_XY_CONTAINER(custom_id))
	{
	#if HMI_DXY_CONTAINERS_NUMBER
		hmi_object_index = HMI_GET_DYN_XY_CONTAINER_INDEX(custom_id);
		if(hmi_object_index < HMI_DXY_CONTAINERS_NUMBER)
		{
			if(hmi_dxy_container_video_fmt[hmi_object_index].video_fmt_channel &
				HMI_SCENE_WINDOW)
			{
				pojb_tlb	= &(hmi_dyn_xy_container_table[hmi_object_index].container_object_table);
			}
		}
	#endif
	}

	return	pojb_tlb;
}

