	if(pmatrix != NULL)
	{
		for(index = 0;index < path_len;index++)
		{
			xyz1.x	= path[index].x;
			xyz1.y	= path[index].y;
			xyz1.z	= 0.0f;
			xyz1.a	= 1.0f;

			matrix_multiply_vector_vertical(pmatrix,
