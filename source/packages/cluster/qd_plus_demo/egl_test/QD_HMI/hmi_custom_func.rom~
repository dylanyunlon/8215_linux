			pvertex		= p3d_node->pvertex_range;

			size				= (UINT32)(mesh_cnt * sizeof(HMI_VERTEX_ATTR_STR));
			pvertex_info		= hmi_get_qd_buffer(size);
			size				= (UINT32)(mesh_cnt * sizeof(HMI_MATERIAL_PROPERTIES));
