/*return	angle must at[0,360) degree*/
float_32	hmi_angle_at_one_circle(float_32	angle)
{
	float_32	angle_ret	= 0.0f;
	INT32		up1_angle	= 0;
	up1_angle	= (INT32)angle;
	up1_angle	= (up1_angle / HMI_CIRCLE_ANGEL);
	up1_angle	= (INT32)(up1_angle * HMI_CIRCLE_ANGEL);
	angle	-= up1_angle;
	if(angle < 0.0f)
	{
		angle	= (float_32)(angle + HMI_CIRCLE_ANGEL);
	}
	if(angle > HMI_CIRCLE_ANGEL)
	{
		angle	= (float_32)(angle - HMI_CIRCLE_ANGEL);
	}
	angle_ret	= angle;
	return		angle_ret;
}
