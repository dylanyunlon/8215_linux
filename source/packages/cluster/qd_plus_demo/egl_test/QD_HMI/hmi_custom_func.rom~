			{
				p3d_qd_node->pvertex_info		= pvertex_info;
				p3d_qd_node->pmaterial_info		= pmaterial_info;

				for(mesh_index = 0U; mesh_index < mesh_cnt; mesh_index++)
				{
					if(pindex[mesh_index].end > pindex[mesh_index].begin)
					{
						pvertex_info[mesh_index].numIndices		= (GLint)(pindex[mesh_index].end - pindex[mesh_index].begin);
					#if HMI_DXY_SXY_3D_INDEX_LEN > 0
						pvertex_info[mesh_index].pindices		= &hmi_dxy_sxy_3d_index[pindex[mesh_index].begin];
