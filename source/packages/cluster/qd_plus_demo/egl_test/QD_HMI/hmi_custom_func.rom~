										custom_object_prop.w		= HMI_MAX_INT16;
										custom_object_prop.h		= HMI_MAX_INT16;
										custom_object_prop.p1		= HMI_MAX_INT16;
										custom_object_prop.p2		= index;		
										custom_object_prop.p3		= HMI_MAX_INT16;
										hmi_engine_set_custom_prop(custom_id,&custom_object_prop);
									#else
										custom_p2_id	= hmi_get_obj_pro_id(custom_id,HMI_ELEMENT_P2);
										hmi_engine_set_object_info(custom_p2_id,(HMI_OBJECT_DATA_STR)index);
									#endif
