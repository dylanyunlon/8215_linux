	HMI_CONTAINER_LAYOUT_STR				hmi_layerout_attr ={0U,0U,0U,0U,0U,0U};
	HMI_CONTAINER_CENTER_ALPHA_CLIP_STR		hmi_container_alpha_clip={0}; 
