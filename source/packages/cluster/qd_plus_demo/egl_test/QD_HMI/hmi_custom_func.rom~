#define		MAX_INT16_VALUE_F					(32767.0f)
#define		MIN_INT16_VALUE_F					(-32767.0f)

BOOLEAN	get_path_bound_box_s32(POINT_FLOAT_TP	path_data32[],U08  path_data32_len,							
										POINT_FLOAT_TP		bound_box[])
{	
	BOOLEAN			success						= FALSE;
	U08				i							= 0u;					
	float_32		hmi_min_x 					= MAX_INT16_VALUE_F;
	float_32		hmi_min_y 					= MAX_INT16_VALUE_F;
	float_32		hmi_max_x 					= MIN_INT16_VALUE_F;	
	float_32		hmi_max_y 					= MIN_INT16_VALUE_F;
			
	if(path_data32_len > 0)
	{						
		/*get bounding recting*/
		for(i = 0u;i < path_data32_len;i++)
		{						
			if(path_data32[i].x < hmi_min_x)
			{
				hmi_min_x	= path_data32[i].x;
			}
			if(path_data32[i].x > hmi_max_x)
			{
				hmi_max_x	= path_data32[i].x;
			}
						
			if(path_data32[i].y < hmi_min_y)
			{
				hmi_min_y	= path_data32[i].y;
			}
			if(path_data32[i].y > hmi_max_y)
			{
				hmi_max_y	= path_data32[i].y;
			}
			
		}
		/*top left*/
		bound_box[0].x	= hmi_min_x;
		bound_box[0].y	= hmi_min_y;
		bound_box[1].x	= hmi_max_x;
		bound_box[1].y	= hmi_max_y;		
		
		success	= TRUE;
	}
	else
	{
		bound_box[0].x	= 0.0f;
		bound_box[0].y	= 0.0f;

		bound_box[1].x	= 0.0f;
		bound_box[1].y	= 0.0f;		
	}

	return	success;
}

void	hmi_two_rect_bound(POINT_FLOAT_TP pa[/*2*/],POINT_FLOAT_TP pb[/*2*/],POINT_FLOAT_TP bound[/*2*/])
{
	float_32		hmi_min_x 		= MAX_INT16_VALUE_F;
	float_32		hmi_min_y 		= MAX_INT16_VALUE_F;
	float_32		hmi_max_x 		= MIN_INT16_VALUE_F;	
	float_32		hmi_max_y 		= MIN_INT16_VALUE_F;
	
	
	/*get left top*/
	if(pa[0/*top,left*/].x < hmi_min_x)
	{
		hmi_min_x	= pa[0/*top,left*/].x;
	}
	if(pa[0/*top,left*/].y < hmi_min_y)
	{
		hmi_min_y	= pa[0/*top,left*/].y;
	}

	if(pb[0/*top,left*/].x < hmi_min_x)
	{
		hmi_min_x	= pb[0/*top,left*/].x;
	}
	if(pb[0/*top,left*/].y < hmi_min_y)
	{
		hmi_min_y	= pb[0/*top,left*/].y;
	}

	/*get right bottom*/
	if(pa[1/*right bottom*/].x > hmi_max_x)
	{
		hmi_max_x	= pa[1/*right bottom*/].x;
	}
	if(pa[1/*right bottom*/].y > hmi_max_y)
	{
		hmi_max_y	= pa[1/*right bottom*/].y;
	}

	if(pb[1/*right bottom*/].x > hmi_max_x)
	{
		hmi_max_x	= pb[1/*right bottom*/].x;
	}
	if(pb[0/*right bottom*/].y > hmi_max_y)
	{
		hmi_max_y	= pb[1/*right bottom*/].y;
	}

	bound[0].x	= hmi_min_x;
	bound[0].y	= hmi_min_y;
	bound[1].x	= hmi_max_x;
	bound[1].y	= hmi_max_y;
	
}

BOOLEAN	get_path_transform(ES_MATRIX_STR *pmatrix,POINT_FLOAT_TP	path[],U08 path_len,BOOLEAN bnormal)
{	
