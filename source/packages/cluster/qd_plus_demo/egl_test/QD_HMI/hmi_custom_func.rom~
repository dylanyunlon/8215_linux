U16 get_bezier_step_array(SPOINT_TP *pbezier_step,UINT16 pbezier_step_array_len,UINT16 bezier_step_num,UINT32 nPoint, POINT32_TP CONST *pPointArray)
{
	U32 				actLen		= 0u;	
	U16 				index		= 0u;	
	POINT32_TP CONST	*pPoint 	=NULL;	
	double_64			tt			= 0.0;
	double_64			step		= 0.0;
	U16 				j			= 0u;
	POINT32_TP			point32 	= {0,0};
	U16 			need_array_len= 0u;

	if((pbezier_step != NULL)&&(pPointArray != NULL))	/*lq*/
	{
		pPoint	= pPointArray;	
		index	= nPoint ;

		/* check array length*/
		need_array_len	= (((nPoint + 2u) / 3u) * 3u) * (bezier_step_num + 1u);
		if((bezier_step_num > 0u)&&(pbezier_step_array_len >= need_array_len))
		{
			step	= (double_64)(1.0 / (double_64)(bezier_step_num));		
			while(index >= 4u/*min bezier ctrl point*/)
			{
				for(tt = 0.0,j = 0u;tt < (1.0f + HMI_FLOAT_TOLERANCE)/*1.01*/;tt = tt + step,j++)//get bezier point
				{
					point32 			= hor(3,pPoint,tt);
					pbezier_step[actLen].x	= (SINT16)(point32.x);
					pbezier_step[actLen].y	= (SINT16)(point32.y);
					actLen++;
				}			
				index	-= HMI_BEZIER_POINT_CNT;
				pPoint	+= HMI_BEZIER_POINT_CNT;
			}		
		}
	}
	
	return actLen;
}

BOOLEAN hmi_straddle_line(SPOINT_TP *p1,SPOINT_TP *p2,SPOINT_TP *q1,SPOINT_TP *q2)
{
	BOOLEAN 	intersection	= FALSE;
	BOOLEAN 	straddle		= FALSE;
	SPOINT_TP	p1_sub_q1		= {0,0};
	SPOINT_TP	q2_sub_q1		= {0,0};	
	SPOINT_TP	p2_sub_q1		= {0,0};
	SINT32		dot_mul1		= 0;
	SINT32		dot_mul2		= 0;
	

	if((p1 != NULL)&&(p2 != NULL)&&(q1 != NULL)&&((q2 != NULL)))
	{
		HMI_SUB_POINT2((*p1),(*q1),p1_sub_q1);
		HMI_SUB_POINT2((*q2),(*q1),q2_sub_q1);
		HMI_SUB_POINT2((*p2),(*q1),p2_sub_q1);

		//HMI_DOT_MUL(p1_sub_q1,q2_sub_q1,dot_mul1);
		//HMI_DOT_MUL(p2_sub_q1,p2_sub_q1,dot_mul2);

		dot_mul1	= HMI_CROSS_MUL2(p1_sub_q1,q2_sub_q1);
		dot_mul2	= HMI_CROSS_MUL2(q2_sub_q1,p2_sub_q1);

		if((dot_mul1 >= 0)&&(dot_mul2 >= 0))
		{
			intersection	= TRUE;
		}
		else if((dot_mul1 <= 0)&&(dot_mul2 <= 0))
		{
			intersection	= TRUE;
		}
		else
		{
			intersection	= FALSE;
		}

		if(intersection == TRUE)
		{
			HMI_SUB_POINT2((*q1),(*p1),p1_sub_q1);
			HMI_SUB_POINT2((*p2),(*p1),q2_sub_q1);
			HMI_SUB_POINT2((*q2),(*p1),p2_sub_q1);

			//HMI_DOT_MUL(p1_sub_q1,q2_sub_q1,dot_mul1);
			//HMI_DOT_MUL(p2_sub_q1,p2_sub_q1,dot_mul2);
			
			dot_mul1	= HMI_CROSS_MUL2(p1_sub_q1,q2_sub_q1);
			dot_mul2	= HMI_CROSS_MUL2(q2_sub_q1,p2_sub_q1);

			if((dot_mul1 >= 0)&&(dot_mul2 >= 0))
			{
				straddle	= TRUE;
			}
			else if((dot_mul1 <= 0)&&(dot_mul2 <= 0))
			{
				straddle	= TRUE;
			}
			else
			{
				straddle	= FALSE;
			}			
		}				
	}

	return	straddle;
}


BOOLEAN	hmi_intersection_bezier_vector(SPOINT_TP *pbezier_step,UINT16 bezier_array_len,
												SPOINT_TP *pstep1,SPOINT_TP *pstep2,
												SPOINT_TP *pvector1,SPOINT_TP *pvector2,BOOLEAN increase,
												SINT16	*pindex/*2024 04 17*/)
{
	BOOLEAN 	line_intersection	= FALSE;
	BOOLEAN 	rect_intersection	= FALSE;
	SPOINT_TP	*pp1				= NULL;
	SPOINT_TP	*pp2				= NULL; 
	SINT16		loop				= 0u;

	if(bezier_array_len > 2u/*at least 2 point*/)
	{		
		if(increase == TRUE)
		{
			pp1 	= &pbezier_step[0];
			for(loop = 1u;(loop < (SINT16)bezier_array_len)&&(line_intersection == FALSE);loop++)
			{
				pp2 			= &pbezier_step[loop];
				if((pp1->x != pp2->x)||(pp1->y != pp2->y))
				{
					rect_intersection	= hmi_intersection_line(pp1,pp2,pvector1,pvector2);
					if(rect_intersection == TRUE)
					{
						line_intersection	= hmi_straddle_line(pp1,pp2,pvector1,pvector2);
						if(line_intersection == FALSE)
						{
							pp1 = pp2;
						}
						else
						{
							if(pindex != NULL)
							{
								*pindex	= loop;
							}
						}
					}
					else
					{
						pp1 = pp2;
					}
				}
			}
		}
		else
		{
			pp2 	= &pbezier_step[bezier_array_len - 1u];
			for(loop = (SINT16)(bezier_array_len - 2u);(loop > 0u)&&(line_intersection == FALSE);loop--)
			{
				pp1 			= &pbezier_step[loop];
				if((pp1->x != pp2->x)||(pp1->y != pp2->y))
				{
					rect_intersection	= hmi_intersection_line(pp1,pp2,pvector1,pvector2);
					if(rect_intersection == TRUE)
					{
						line_intersection	= hmi_straddle_line(pp1,pp2,pvector1,pvector2);
						if(line_intersection == FALSE)
						{
							pp2 = pp1;
						}
						else
						{
							if(pindex != NULL)
							{
								*pindex	= loop;
							}
						}
					}
					else
					{
						pp2 = pp1;
					}
				}
			}
		}
		if((line_intersection == TRUE)&&(pstep1 != NULL)&&(pstep2 != NULL))
		{			
			pstep1->x	= pp1->x;
			pstep1->y	= pp1->y;

			pstep2->x	= pp2->x;
			pstep2->y	= pp2->y;						
		}
	}

	return	line_intersection;
}


