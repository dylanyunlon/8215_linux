													if((new_cliped_farther_rect.w != 0u) && (new_cliped_farther_rect.h != 0u))
													{
														call_C_hmi_driver_draw_image((HMI_RECT_STR CONST	*)(&container_rect),
																				container_prop2.img_compress,
																				&rect_angle_alpha,
																				container_prop2.pimage_prop_info,
																				&new_cliped_farther_rect,
																				pcustom_dirty_rect,
																				0,
																				NULL,
																				anim_image_id,
																				pfather_alpha_scale);
														dsp_x	+= (HMI_X_STR)(container_prop.w + char_space);
													}
												}
											}																									
										}
									}
								else if(disp_mode == 1/*text*/)
								{
									anim_image_id	= phmi_container_object_table[0].object_id;
									if((HMI_IS_DYN_TEXT_SXY(anim_image_id))||
