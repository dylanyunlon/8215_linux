		hmi_object_index = HMI_GET_DXY_CUSTOM_INDEX(custom_id);
		if(hmi_object_index	< HMI_DXY_CUSTOM_CNT)
		{	
			pgen_user_data	= (&hmi_dxy_custom_lib_data[hmi_object_index]);
			if(pgen_user_data != NULL)
			{
				if(pgen_user_data->custom_type == 1/*sub 3d object*/)
				{
					psub_mode	= (HMI_3D_SUB_CUSTOM_USR_DATA_STR	*)(pgen_user_data->pusr_data);
				}
				else if(pgen_user_data->custom_type == 6/*3d container*/)
				{
					psub_mode	= (HMI_3D_SUB_CUSTOM_USR_DATA_STR	*)(pgen_user_data->pusr_data);
				}
				else{}
			}	
			
		}	
	#endif
	}
	else{}

	/*For child,get current node matrix*/
	if(puser_data != NULL)
	{
		pfather_model	= (ES_MATRIX_STR	*)puser_data;
		matrix_multiply(&final_model, pfather_model, &model);
	}
	else
	{
		memcpy(&final_model,&model,sizeof(ES_MATRIX_STR));
	}
	puser_child_data	= (void *)(&final_model);

	if(psub_mode != NULL)
	{		
		p_object_table	= psub_mode->child.container_object_table.p_object_table;
		child_cnt		= psub_mode->child.container_object_table.object_number;
		for(i = 0u;i < child_cnt;i++)
		{
			custom_id	= p_object_table[i].object_id;			
			if(HMI_IS_DYN_XY_CUSTOM(custom_id))
			{
			#if HMI_DXY_CUSTOM_CNT > 0
				hmi_object_index = HMI_GET_DXY_CUSTOM_INDEX(custom_id);
				if(hmi_object_index	< HMI_DXY_CUSTOM_CNT)
				{
					pgen_user_data	= &hmi_dxy_custom_lib_data[hmi_object_index];
					if(pgen_user_data != NULL)
					{
						if((pgen_user_data->custom_type == 1/*sub 3d object*/)||
							(pgen_user_data->custom_type == 6/*3d container*/))
						{
							psub_mode	= (HMI_3D_SUB_CUSTOM_USR_DATA_STR	*)(pgen_user_data->pusr_data);
							hmi_get_success = hmi_engine_get_dyn_custom_index(hmi_object_index,
														&hmi_custom_type_index);
							if(hmi_get_success == TRUE)
							{
								phmi_custom_function = hmi_dxy_custom_widget_info[hmi_custom_type_index].attr_fun.pmanager_fun;
								if(phmi_custom_function != NULL)
								{
									/*parent matrix multi self matrix*/																		
									phmi_custom_function(pcustom_farther_rect,
															pcustom_dirty_rect,
															custom_depth,
															pcustom_cliped_farther_rect,
															custom_id,
															pfather_alpha_scale,
															puser_child_data);
								}
							}
						}
					}										
				}
			#endif
			}
			else if(HMI_IS_CUSTOM_SXY(custom_id))
			{
			#if HMI_SXY_CUSTOM_CNT > 0
				hmi_object_index = HMI_GET_CUSTOM_SXY_ID_INDEX(custom_id);
				if(hmi_object_index	< HMI_SXY_CUSTOM_CNT)
				{
					pgen_user_data	= &hmi_sxy_custom_lib_data[hmi_object_index];
					if(pgen_user_data != NULL)
					{
						if((pgen_user_data->custom_type == 1/*sub 3d object*/)||
							(pgen_user_data->custom_type == 6/*3d container*/))
						{
							psub_mode	= (HMI_3D_SUB_CUSTOM_USR_DATA_STR	*)(pgen_user_data->pusr_data);
							hmi_get_success = hmi_engine_get_static_custom_index(hmi_object_index,
														&hmi_custom_type_index);
							if(hmi_get_success == TRUE)
							{
								phmi_custom_function = hmi_sxy_custom_widget_info[hmi_custom_type_index].attr_fun.pmanager_fun;
								if(phmi_custom_function != NULL)
								{
									/*parent matrix multi self matrix*/																		
									phmi_custom_function(pcustom_farther_rect,
															pcustom_dirty_rect,
															custom_depth,
															pcustom_cliped_farther_rect,
															custom_id,
															pfather_alpha_scale,
															puser_child_data);
								}
							}
						}
					}										
				}
			#endif
			}						
			/*else if(HMI_IS_DYN_XY_CUSTOM(custom_id))*/ // 3d container
			else{}			
		}
	}
#endif			
}


HMI_OBJECT_ID_STR	hmi_get_child_index_container(HMI_OBJECT_ID_STR				container_id,U08 child_no/*begin as 0*/)
{
	HMI_OBJECT_ID_STR			child									= 0;
	HMI_CONTAINER_STR	CONST	*phmi_container_table					= NULL;
	UINT8						hmi_number_object						= 0u;
	HMI_OBJECT_ID_STR			new_texture_fill						= container_id;
	HMI_OBJECT_PROP_STR CONST	*phmi_container_object_table			= NULL;

#if HMI_DYN_CONTAINERS_NUMBER > 0
	if(HMI_IS_DYN_CONTAINER(new_texture_fill))
	{
		new_texture_fill  = HMI_GET_DYN_CONTAINERS_ID_INDEX(new_texture_fill);
		hmi_engine_get_static_container_id(&new_texture_fill);/*get static container ID*/
	}
#endif

	if((HMI_IS_CONTAINERS_SXY(new_texture_fill))||
		(HMI_IS_DYN_XY_CONTAINER(new_texture_fill)))
	{
		phmi_container_table	= hmi_engine_get_container_child_addr(
														new_texture_fill);
		if(phmi_container_table != NULL)
		{
			hmi_number_object  = 
				(phmi_container_table->container_object_table.object_number);
			if(child_no < hmi_number_object)
			{					
				phmi_container_object_table	= 
					phmi_container_table->container_object_table.p_object_table;
				
				child	= phmi_container_object_table[child_no].object_id;							
			}				
		}	
	}
	


	return	child;
}


