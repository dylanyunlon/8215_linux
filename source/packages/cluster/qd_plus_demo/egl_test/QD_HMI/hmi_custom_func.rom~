					}
					else
					{
						pvertex_info[mesh_index].numIndices		= 0;
						pvertex_info[mesh_index].pindices		= NULL;
					}

					pmaterial_info[mesh_index].twoSideEn	= FALSE;/*TEST*/
					if(pnormal[mesh_index].end > pnormal[mesh_index].begin)
					{
						pmaterial_info[mesh_index].normalEn		= TRUE;	
					#if HMI_DXY_SXY_3D_NORMAL_LEN > 0
						pvertex_info[mesh_index].pnormalArray	= 
								&hmi_dxy_sxy_3d_normal[pnormal[mesh_index].begin];
					#endif
					}
					else
					{
						pmaterial_info[mesh_index].normalEn 	= FALSE;					
						pvertex_info[mesh_index].pnormalArray	= NULL;
					}

					if(pcolor[mesh_index].end > pcolor[mesh_index].begin)
					{
						pmaterial_info[mesh_index].colorlEn		= TRUE;					
						pmaterial_info[mesh_index].texturelEn	= FALSE;					
					#if HMI_DXY_SXY_3D_COLOR_LEN > 0
						pvertex_info[mesh_index].pcolorArray	= 
									&hmi_dxy_sxy_3d_color[pcolor[mesh_index].begin];
					#endif
					}
					else
					{ 
						pmaterial_info[mesh_index].colorlEn		= FALSE;					
						pmaterial_info[mesh_index].texturelEn	= FALSE;					
						pvertex_info[mesh_index].pcolorArray	= NULL;
					}
					
					if(puv[mesh_index].end > puv[mesh_index].begin)
					{
						pmaterial_info[mesh_index].texturelEn	= TRUE;
					#if HMI_DXY_SXY_3D_UV_LEN > 0
						pvertex_info[mesh_index].puvArray		= 
										&hmi_dxy_sxy_3d_uv[puv[mesh_index].begin];
					#endif
					#if HMI_DXY_SXY_3D_MATERIAL_LEN > 0
						pmaterial_info[mesh_index].pimg_data	= 
										(HMI_BITMAP_STR	CONST	*)
										(&hmi_dxy_sxy_3d_texture[pmaterial[mesh_index].begin]);
					#endif
					}
					else
					{
						pmaterial_info[mesh_index].texturelEn	= FALSE;
						pvertex_info[mesh_index].puvArray		= NULL;
						pmaterial_info[mesh_index].pimg_data	= NULL;
					}
					
					pvertex_info[mesh_index].textureID	= 0;//HMI_NB_ELEMENTS;
					material_color_index				= pmaterial[mesh_index].begin;
					for(color_index = 0U; color_index < HMI_COLOR_COMPONENT_COUNT;color_index++)
					{
					#if HMI_DXY_SXY_3D_MATERIAL_LEN > 0
						pmaterial_info[mesh_index].materialProp.ambient_color[color_index]	= 
													hmi_dxy_sxy_3d_material[material_color_index].ambient_color[color_index];
						pmaterial_info[mesh_index].materialProp.diffuse_color[color_index]	= 
													hmi_dxy_sxy_3d_material[material_color_index].diffuse_color[color_index];
						pmaterial_info[mesh_index].materialProp.specular_color[color_index]	= 
													hmi_dxy_sxy_3d_material[material_color_index].specular_color[color_index];
					#endif
					}
					pmaterial_info[mesh_index].textureID = 0;//HMI_NB_ELEMENTS;
				#if HMI_DXY_SXY_3D_VER_BUF_LEN > 0
					pvertex_info[mesh_index].pvboIds	= 
							hmi_dxy_sxy_3d_ver_buf[material_color_index].vboIds;
				#endif
						
					if(pvertex[mesh_index].end > pvertex[mesh_index].begin)
					{
						pvertex_info[mesh_index].vertexNum		= (GLint)(pvertex[mesh_index].end - pvertex[mesh_index].begin) / VERTEX_POS_SIZE;
					#if HMI_DXY_SXY_3D_VERTEX_LEN > 0
						pvertex_info[mesh_index].pvertexArray	= 
									&hmi_dxy_sxy_3d_vertex[pvertex[mesh_index].begin];					
					#endif
					}
					else
					{
						pvertex_info[mesh_index].vertexNum		= 0;
						pvertex_info[mesh_index].pvertexArray	= NULL;
					}
				}
			}
			else	/* lq */
			{				
				p3d_qd_node->pvertex_info		= NULL;
				p3d_qd_node->pmaterial_info 	= NULL;

				hmi_release_qd_buf(pvertex_info);
				hmi_release_qd_buf(pmaterial_info);
			}
		}
	}	
}

