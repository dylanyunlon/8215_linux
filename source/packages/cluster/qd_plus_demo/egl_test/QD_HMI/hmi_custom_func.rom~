			if((hmi_light_prop.attr & HMI_CON_F2) !=0)
			{
				const_p2_ry  = (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(hmi_light_prop.const_p2));
			}
			else
			{
