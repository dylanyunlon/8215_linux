void	hmi_get_planar_shadow_matrix(ES_MATRIX_STR *pshadow_matrix,
												INT32		light_type,
												GLfloat		l[/*HMI_POS_COMPONENT_COUNT*/],
												GLfloat		n[/*HMI_POS_COMPONENT_COUNT*/],
												float_32	d/*planar distance to origin*/)
{
	GLfloat		nl		= 0.0f;
	GLfloat		lxnx	= 0.0f;
	GLfloat		lyny	= 0.0f;
	GLfloat		lznz	= 0.0f;
	GLfloat		lx		= 0.0f;
	GLfloat		ly		= 0.0f;
	GLfloat		lz		= 0.0f;
	GLfloat		nx		= 0.0f;
	GLfloat		ny		= 0.0f;
	GLfloat		nz		= 0.0f;
	GLfloat 	nDotl	= 0.0f;

	
	if(pshadow_matrix != NULL)
	{	

		if(light_type == 0/*direct light*/)	/*lq add*/ 
		{
			l[HMI_POS_X]	= -l[HMI_POS_X];
			l[HMI_POS_Y]	= -l[HMI_POS_Y];
			l[HMI_POS_Z]	= -l[HMI_POS_Z];
		}
		nx 						= n[HMI_POS_X];
		ny 						= n[HMI_POS_Y];
		nz 						= n[HMI_POS_Z];
		lx 						= l[HMI_POS_X];
		ly 						= l[HMI_POS_Y];
		lz 						= l[HMI_POS_Z];
		if(light_type == 0/*direct light*/) 		
		{			
			lxnx 					= lx * nx;
			lyny 					= ly * ny;
			lznz 					= lz * nz;
			nDotl 		   			= lxnx + lyny + lznz;
			
			pshadow_matrix->m[0][0] 	= ny * ly + nz * lz;
			pshadow_matrix->m[0][1] 	= -ly * nx;
			pshadow_matrix->m[0][2] 	= -lz * nx;
			pshadow_matrix->m[0][3] 	= 0;

			pshadow_matrix->m[1][0] 	= -lx * ny;
			pshadow_matrix->m[1][1] 	= nx * lx + nz * lz;
			pshadow_matrix->m[1][2]		= -lz * ny;
			pshadow_matrix->m[1][3] 	= 0;

			pshadow_matrix->m[2][0] 	= -lx * nz;
			pshadow_matrix->m[2][1] 	= -ly * nz;
			pshadow_matrix->m[2][2] 	= nx * lx + ny * ly;
			pshadow_matrix->m[2][3] 	= 0;

			pshadow_matrix->m[3][0] 	= -lx * d;
			pshadow_matrix->m[3][1] 	= -ly * d;
			pshadow_matrix->m[3][2] 	= -lz * d;
			pshadow_matrix->m[3][3] 	= nDotl;
		}
		else if(light_type == 1/*spot light*/)	/*Not Support spot light,As piont light*/
		{			
			lxnx 						= lx * nx;
			lyny 						= ly * ny;
			lznz 						= lz * nz;
			nDotl 		   				= lxnx + lyny + lznz;
			pshadow_matrix->m[0][0] 	= nDotl + d - lxnx;
			pshadow_matrix->m[0][1] 	= -ly * nx;
			pshadow_matrix->m[0][2] 	= -lz * nx;
			pshadow_matrix->m[0][3] 	= -nx;

			pshadow_matrix->m[1][0] 	= -lx * ny;
			pshadow_matrix->m[1][1] 	= nDotl + d - lyny;
			pshadow_matrix->m[1][2]	= -lz * ny;
			pshadow_matrix->m[1][3] 	= -ny;

			pshadow_matrix->m[2][0] 	= -lx * nz;
			pshadow_matrix->m[2][1] 	= -ly * nz;
			pshadow_matrix->m[2][2] 	= nDotl + d - lznz;
			pshadow_matrix->m[2][3] 	= -nz;

			pshadow_matrix->m[3][0] 	= -lx * d;
			pshadow_matrix->m[3][1] 	= -ly * d;
			pshadow_matrix->m[3][2] 	= -lz * d;
			pshadow_matrix->m[3][3] 	= nDotl;
		}
		else if(light_type == 2/*point light*/)
		{			
			lxnx 						= lx * nx;
			lyny 						= ly * ny;
			lznz 						= lz * nz;
			nDotl 		   				= lxnx + lyny + lznz;
			pshadow_matrix->m[0][0] 	= nDotl + d - lxnx;
			pshadow_matrix->m[0][1] 	= -ly * nx;
			pshadow_matrix->m[0][2] 	= -lz * nx;
			pshadow_matrix->m[0][3] 	= -nx;

			pshadow_matrix->m[1][0] 	= -lx * ny;
			pshadow_matrix->m[1][1] 	= nDotl + d - lyny;
			pshadow_matrix->m[1][2]	= -lz * ny;
			pshadow_matrix->m[1][3] 	= -ny;

			pshadow_matrix->m[2][0] 	= -lx * nz;
			pshadow_matrix->m[2][1] 	= -ly * nz;
			pshadow_matrix->m[2][2] 	= nDotl + d - lznz;
			pshadow_matrix->m[2][3] 	= -nz;

			pshadow_matrix->m[3][0] 	= -lx * d;
			pshadow_matrix->m[3][1] 	= -ly * d;
			pshadow_matrix->m[3][2] 	= -lz * d;
			pshadow_matrix->m[3][3] 	= nDotl;
			
		}
		else
		{
			lxnx 						= lx * nx;
			lyny 						= ly * ny;
			lznz 						= lz * nz;
			nDotl 		   				= lxnx + lyny + lznz;
			pshadow_matrix->m[0][0] 	= nDotl + d - lxnx;
			pshadow_matrix->m[0][1] 	= -ly * nx;
			pshadow_matrix->m[0][2] 	= -lz * nx;
			pshadow_matrix->m[0][3] 	= -nx;

			pshadow_matrix->m[1][0] 	= -lx * ny;
			pshadow_matrix->m[1][1] 	= nDotl + d - lyny;
			pshadow_matrix->m[1][2]	= 	-lz * ny;
			pshadow_matrix->m[1][3] 	= -ny;

			pshadow_matrix->m[2][0] 	= -lx * nz;
			pshadow_matrix->m[2][1] 	= -ly * nz;
			pshadow_matrix->m[2][2] 	= nDotl + d - lznz;
			pshadow_matrix->m[2][3] 	= -nz;

			pshadow_matrix->m[3][0] 	= -lx * d;
			pshadow_matrix->m[3][1] 	= -ly * d;
			pshadow_matrix->m[3][2] 	= -lz * d;
			pshadow_matrix->m[3][3] 	= nDotl;
		}
	}	
}


/*
two connect cublic bezier ,convert one bezier 
*/
#define	HMI_TWO_CUBLIC_POINT_CNT		7
BOOLEAN hmi_merge_bezier_curves(POINT_FLOAT_TP two_bezier_cublic_point[],INT32	point_cnt)	
{	
	BOOLEAN			success			= FALSE;
	POINT_FLOAT_TP	begin_control	= {0.0f,0.0f};
	POINT_FLOAT_TP	end_control		= {0.0f,0.0f};	
	float_32		e				= 0.0f;
	float_32		ex				= 0.0f;
	float_32		ey				= 0.0f;
	float_32		p4x_p2x_delta	= 0.0f;	
	float_32		p4y_p2y_delta	= 0.0f;	

	if(point_cnt >= HMI_TWO_CUBLIC_POINT_CNT)
	{
		p4x_p2x_delta	= two_bezier_cublic_point[4].x - two_bezier_cublic_point[2].x;
		p4y_p2y_delta	= two_bezier_cublic_point[4].y - two_bezier_cublic_point[2].y;

		if(( (p4x_p2x_delta > HMI_FLOAT_TOLERANCE) ||
			(p4x_p2x_delta < -HMI_FLOAT_TOLERANCE))&&
			((p4y_p2y_delta > HMI_FLOAT_TOLERANCE) ||
			(p4y_p2y_delta < -HMI_FLOAT_TOLERANCE)))
		{
			ex	= (float_32)((two_bezier_cublic_point[3].x - two_bezier_cublic_point[2].x) / p4x_p2x_delta);
			ey	= (float_32)((two_bezier_cublic_point[3].y - two_bezier_cublic_point[2].y) / p4y_p2y_delta);
			e	= (float_32)((ex + ey) / 2.0f);
			if((e > HMI_FLOAT_TOLERANCE) && (e < 1.0f - HMI_FLOAT_TOLERANCE))
			{
				begin_control.x	=  (float_32)((two_bezier_cublic_point[1].x - two_bezier_cublic_point[0].x * (1.0f - e)) / e);
				end_control.x	=  (float_32)((two_bezier_cublic_point[5].x - two_bezier_cublic_point[6].x * e) / (1.0f - e));
				begin_control.y =  (float_32)((two_bezier_cublic_point[1].y - two_bezier_cublic_point[0].y * (1.0f - e)) / e);
				end_control.y	=  (float_32)((two_bezier_cublic_point[5].y - two_bezier_cublic_point[6].y * e) / (1.0f - e));
				
				success			= TRUE;
			}
		}

		if(success == TRUE)
		{
			/*two_bezier_cublic_point[0] not changed*/
		
			two_bezier_cublic_point[1].x	= begin_control.x;
			two_bezier_cublic_point[1].y	= begin_control.y;

			two_bezier_cublic_point[2].x	= end_control.x;
			two_bezier_cublic_point[2].y	= end_control.y;

			two_bezier_cublic_point[3].x	= two_bezier_cublic_point[6].x;
			two_bezier_cublic_point[3].y	= two_bezier_cublic_point[6].y;
		}
		else
		{
			/*two_bezier_cublic_point[0] not changed*/
		
			/*two_bezier_cublic_point[1] not changed*/

			two_bezier_cublic_point[2].x	= two_bezier_cublic_point[5].x;
			two_bezier_cublic_point[2].y	= two_bezier_cublic_point[5].y;

			two_bezier_cublic_point[3].x	= two_bezier_cublic_point[6].x;
			two_bezier_cublic_point[3].y	= two_bezier_cublic_point[6].y;
		}
	}

	return	success;
}


