POINT_FLOAT_TP hmi_tangent_direction(POINT_FLOAT_TP center, POINT_FLOAT_TP point_on_circle) 
{
    POINT_FLOAT_TP	direction	= {0.0f,0.0f};
	float_32		length		= 0.0f;
	float_32		delta_x		= 0.0f;
	float_32		delta_y		= 0.0f;
	float_32		m			= 0.0f;
    
    /* Calculate the slope of the line passing through the center and the point on the circle */
	delta_x	= point_on_circle.x - center.x;
	if((delta_x > HMI_FLOAT_TOLERANCE) || (delta_x < -HMI_FLOAT_TOLERANCE))
	{
	    m = (float_32)((point_on_circle.y - center.y) / delta_x);
		if((m > HMI_FLOAT_TOLERANCE) || (m < -HMI_FLOAT_TOLERANCE))
		{
		    /* The direction of the tangent is the negative reciprocal of this slope */
		    direction.x		= 1.0f;
		    direction.y		= (float_32)(-1.0f / m);

		    /* Normalize the direction to unit length for consistent representation*/
		    length = (float_32)(sqrt(direction.x * direction.x + direction.y * direction.y));
			if((m > HMI_FLOAT_TOLERANCE) || (m < -HMI_FLOAT_TOLERANCE))
			{
			    direction.x = (float_32)(direction.x / length);
			    direction.y = (float_32)(direction.y / length);
			}
			else
			{
				direction.x	= 0.0f;
				direction.y	= 1.0f;
			}
		}
		else
		{
			direction.x	= 0.0f;
			direction.y	= 1.0f;
		}
	}
	else
	{
		direction.x	= 1.0f;
		direction.y	= 0.0f;
	}

    return direction;
}


float_32 hmi_up_angle(float_32 y,POINT_FLOAT_TP center,float_32 r,BOOLEAN left)
{
	float_32		angle						= 0.0f;
	float_32		delta_y_center				= 0.0f;		
	POINT_FLOAT_TP	up_vector 					= {0.0f,1.0f};
	POINT_FLOAT_TP	tan_circle_vector			= {0.0f};		
	POINT_FLOAT_TP	point_on_circle_left		= {0.0f,0.0f};
	POINT_FLOAT_TP	point_on_circle_right		= {0.0f,0.0f};
	float_32		sqrt_y						= 0.0f;	
	float_32		cos_angle					= 0.0f;

	delta_y_center	= center.y - y;
	if(delta_y_center < 0.0f)
	{
		delta_y_center	= -delta_y_center;
	}

	if(delta_y_center <= r)
	{
		sqrt_y			= r * r - (y - center.y) * (y - center.y);
		if(sqrt_y > HMI_FLOAT_TOLERANCE)
		{
			sqrt_y		= (float_32)(sqrt(sqrt_y));
		}
		else
		{
			sqrt_y		= 0.0f;
		}
		point_on_circle_left.y	= y;
		point_on_circle_right.y	= y;
		if(left == TRUE)
		{
			point_on_circle_left.x	= center.x	- sqrt_y;
			tan_circle_vector		= hmi_tangent_direction(center,point_on_circle_left);			
		}
		else
		{
			point_on_circle_right.x	= center.x	+ sqrt_y;
			tan_circle_vector	= hmi_tangent_direction(center,	point_on_circle_right);			
		}
		cos_angle	= (float_32)(HMI_DOT_MUL_XY(up_vector,tan_circle_vector));
		if(cos_angle < 0.0f)
		{
			tan_circle_vector.x	= -tan_circle_vector.x;
			tan_circle_vector.y	= -tan_circle_vector.y;
		}
		angle 	= hmi_2vector_angle2(&up_vector , &tan_circle_vector);	
	}
	else
	{
		angle	= 0.0f;
	}	
	
	return angle;	
}


float_32 hmi_distance_f(float_32 t, float_32 x10, float_32 x21, float_32 x32, float_32 y10, float_32 y21, float_32 y32) 
{
    float_32 lenx = 3 * (1 - t) * (1 - t) * x10 + 6 * t * (1 - t) * x21 + 3 * t * t * x32;
    float_32 leny = 3 * (1 - t) * (1 - t) * y10 + 6 * t * (1 - t) * y21 + 3 * t * t * y32;
	
    return (float_32)(sqrt(lenx * lenx + leny * leny));
}


float_32 hmi_curve_length_t(float_32 t, float_32 x0, float_32 x1, float_32 x2, float_32 x3, float_32 y0, float_32 y1, float_32 y2, float_32 y3) 
{
    float_32 c1 = 0.3626838f;
    float_32 c2 = 0.3626838f;
    float_32 c3 = 0.3137067f;
    float_32 c4 = 0.3137067f;
    float_32 c5 = 0.2223810f;
    float_32 c6 = 0.2223810f;
    float_32 c7 = 0.1012285f;
    float_32 c8 = 0.1012285f;
    float_32 t1 = -0.1834346f;
    float_32 t2 = 0.1834346f;
    float_32 t3 = -0.5255324f;
    float_32 t4 = 0.5255324f;
    float_32 t5 = -0.7966665f;
    float_32 t6 = 0.7966665f;
    float_32 t7 = -0.9602899f;
    float_32 t8 = 0.9602899f;
    
    float_32 tz = 0.5f * t;
    float_32 x10 = x1 - x0;
    float_32 x21 = x2 - x1;
    float_32 x32 = x3 - x2;
    float_32 y10 = y1 - y0;
    float_32 y21 = y2 - y1;
    float_32 y32 = y3 - y2;
    float_32 l1 = (float_32)(c1 * hmi_distance_f(tz * t1 + tz, x10, x21, x32, y10, y21, y32));
    float_32 l2 = (float_32)(c2 * hmi_distance_f(tz * t2 + tz, x10, x21, x32, y10, y21, y32));
    float_32 l3 = (float_32)(c3 * hmi_distance_f(tz * t3 + tz, x10, x21, x32, y10, y21, y32));
    float_32 l4 = (float_32)(c4 * hmi_distance_f(tz * t4 + tz, x10, x21, x32, y10, y21, y32));
    float_32 l5 = (float_32)(c5 * hmi_distance_f(tz * t5 + tz, x10, x21, x32, y10, y21, y32));
    float_32 l6 = (float_32)(c6 * hmi_distance_f(tz * t6 + tz, x10, x21, x32, y10, y21, y32));
    float_32 l7 = (float_32)(c7 * hmi_distance_f(tz * t7 + tz, x10, x21, x32, y10, y21, y32));
    float_32 l8 = (float_32)(c8 * hmi_distance_f(tz * t8 + tz, x10, x21, x32, y10, y21, y32));
    float_32 length = (float_32)((l1 + l2 + l3 + l4 + l5 + l6 + l7 + l8) * tz);
	
    return length;
}

#define		HMI_BEZIER_TORRENT_F	(0.0001f)
float_32 hmi_find_t(float_32				target_length, 
				POINT_FLOAT_TP		    one_bezier_vertex[], 
				UINT32       			 one_bezier_len) 
{
	float_32	t		= 0.0f;
    float_32	low		= 0.0f;
    float_32	high	= 1.0f;
    float_32	epsilon	= HMI_BEZIER_TORRENT_F; 
    float_32	mid		= 0.0f;
	float_32	length	= 0.0f;
	float_32	x0		= 0.0f;
	float_32	x1		= 0.0f;
	float_32	x2		= 0.0f;
	float_32	x3		= 0.0f;
	float_32	y0		= 0.0f;
	float_32	y1		= 0.0f;
	float_32	y2		= 0.0f;
	float_32	y3		= 0.0f;
	

	if((one_bezier_len >= 4/*cublic bezier ctrl point cnt*/)&&
		(target_length >= 0.0f))
	{
		x0		= one_bezier_vertex[0].x;
		x1		= one_bezier_vertex[1].x;
		x2		= one_bezier_vertex[2].x;
		x3		= one_bezier_vertex[3].x;
		y0		= one_bezier_vertex[0].y;
		y1		= one_bezier_vertex[1].y;
		y2		= one_bezier_vertex[2].y;
		y3		= one_bezier_vertex[3].y;
		
	    while (high - low > epsilon) 
		{
	        mid		= (float_32)((low + high) / 2.0f);
	        length	= hmi_curve_length_t(mid, x0, x1, x2, x3, y0, y1, y2, y3);

	        if (length < target_length) 
			{
	            low = mid;
	        } 
			else 
			{
	            high = mid;
	        }
	    }
		t	= (float_32)((low + high) / 2.0f);
		if(t > (1.0f - HMI_BEZIER_TORRENT_F))
		{
			t	= 1.0f;
		}
	}

    return t;
}

float_32 hmi_find_t_by_pos(POINT_FLOAT_TP				point_at_bezier/*only  y*/,
								POINT_FLOAT_TP			one_bezier_vertex[]/*one cublic bezier ctrl point*/,
								UINT32					 one_bezier_len/*always 4*/)

{
	float_32	t			= -1.0f;
	double_64	one_sub_t	= 0.0f;
	double_64	one_sub_t_3	= 0.0f;
	double_64	one_sub_t_2	= 0.0f;
    double_64	low			= 0.0f;
    double_64	high		= 1.0f;
    double_64	epsilon		= HMI_BEZIER_TORRENT_F; 
    double_64	mid			= 0.0f;
	double_64	bezier_y	= 0.0f;
	BOOLEAN		bup			= FALSE;
	BOOLEAN		bin			= FALSE;
	double_64	t_2			= 0.0f;
	double_64	t_3			= 0.0f;
	
	if(one_bezier_len >= 4/*cublic bezier ctrl point cnt*/)
	{
		if(one_bezier_vertex[0].y > one_bezier_vertex[3].y)
		{
			bup		= TRUE;
			if((point_at_bezier.y > one_bezier_vertex[3].y) &&
				(point_at_bezier.y < one_bezier_vertex[0].y))
			{
				bin		= TRUE;
			}
			else if(point_at_bezier.y == one_bezier_vertex[3].y)
			{
				
				bin		= FALSE;
				t			= 1.0f;
			}
			else if(point_at_bezier.y == one_bezier_vertex[0].y)
			{
				
				bin		= FALSE;
				t			= 0.0f;
			}
			else{}
		}
		else
		{

			bup		= FALSE;			
			if((point_at_bezier.y > one_bezier_vertex[0].y) &&
				(point_at_bezier.y < one_bezier_vertex[3].y))
			{
				bin		= TRUE;
			}
			else if(point_at_bezier.y == one_bezier_vertex[3].y)
			{
				
				bin		= FALSE;
				t			= 1.0f;
			}
			else if(point_at_bezier.y == one_bezier_vertex[0].y)
			{
				
				bin		= FALSE;
				t			= 0.0f;
			}
			else{}
		}

		if(bin == TRUE)
		{
		    while ((high - low) > epsilon) 
			{
		        mid			= (double_64)((low + high) / 2.0f);	        
		        one_sub_t	= 1.0f - mid;
				one_sub_t_2	= (double_64)(one_sub_t * one_sub_t);
				one_sub_t_3	= (double_64)(one_sub_t_2 * one_sub_t);
				t_2			= (double_64)(mid * mid);
				t_3			= (double_64)(t_2 * mid);
				bezier_y	= (double_64)(one_sub_t_3 * one_bezier_vertex[0].y +
										3 * one_sub_t_2 * mid * one_bezier_vertex[1].y +
										3 * one_sub_t * t_2 * one_bezier_vertex[2].y +
										t_3 * one_bezier_vertex[3].y );

				if(bup == FALSE)
				{
					if(bezier_y < point_at_bezier.y)
					{
						low = mid;
					}
					else
					{
						high = mid;
					}
				}
				else
				{
					if(bezier_y < point_at_bezier.y)
					{
						high = mid;
					}
					else
					{
						low = mid;
					}
				}										       
		    }
			t	= (float_32)((low + high) / 2.0f);
			if(t > (1.0f - HMI_BEZIER_TORRENT_F))
			{
				t	= 1.0f;
			}
		}
	}

    return t;
}

/*
shengJin equation
*/
#define		HMI_SQRT_3		(1.73205081)
INT32 hmi_cubic_equation(float_32 a,float_32 b,float_32 c,float_32 d,double_64	root[])
{
	double_64		A				= 0;
	double_64		B				= 0;
	double_64		C				= 0;
	double_64		delta			= 0;
	double_64		delta_sq		= 0;
	double_64		Z1				= 0;
	double_64		Z2				= 0;
	double_64		Z3				= 0;
	double_64		Y1				= 0;
	double_64		Y2				= 0;
	double_64		T				= 0;// [-1,1]
	double_64		angle			= 0;	
	double_64		Ab				= 0;
	double_64		cubic_root_Y1	= 0;
	double_64		cubic_root_Y2	= 0;
	double_64		A_cu			= 0;
	double_64		sqrt_A			= 0;	
	INT32			i				= 0;
	BOOLEAN			bfinished		= FALSE;
	double_64 		a3				= 0;
	INT32			root_number		= 0;
	double_64		number_i_part	= 0;

	if((a > HMI_FLOAT_TOLERANCE) ||
		(a < -HMI_FLOAT_TOLERANCE))
	{
		a3 = 3 * a;
		A = b * b - 3 * a * c;
		B = b * c - 9 * a * d;
		C = c * c - 3 * b * d;
		delta = B * B - 4 * A * C;

		/*A=B=0*/
		if(((A < HMI_FLOAT_TOLERANCE) && (A > -HMI_FLOAT_TOLERANCE)) &&
			((B < HMI_FLOAT_TOLERANCE) && (B > -HMI_FLOAT_TOLERANCE)))
		{
			
			root[0] = (-b) / (a3);
			root[1] = root[0];/*(float_32)(-c) / b;*/
			root[2] = root[0];/*(float_32)(-3 * d) / c;*/
			root_number = 1;

		}
		/*delta > 0*/
		else if(delta > HMI_FLOAT_TOLERANCE)
		{
			Ab = A * b;
			delta_sq = sqrt(delta);
			Y1 = Ab + a3 * ((-B + delta_sq) / 2);
			Y2 = Ab + a3 * ((-B - delta_sq) / 2);
			if(Y1 > HMI_FLOAT_TOLERANCE)
			{
				cubic_root_Y1 = pow((Y1), 1.0 / 3.0);

			}
			else
			{
				cubic_root_Y1 =  -pow((-Y1), 1.0 / 3.0);

			}
			if(Y2 > HMI_FLOAT_TOLERANCE)
			{
				cubic_root_Y2 = pow((Y2), 1.0 / 3.0);

			}
			else
			{
				cubic_root_Y2 = -pow((-Y2), 1.0 / 3.0);

			}
			
			root[0] = ((-b) - (cubic_root_Y1 + cubic_root_Y2)) / (a3);
			number_i_part	= (HMI_SQRT_3 * 0.5 * (cubic_root_Y1 - cubic_root_Y2)) / a3;
			if((number_i_part < HMI_FLOAT_TOLERANCE) &&
				(number_i_part > -HMI_FLOAT_TOLERANCE))
			{
				root[1] = ((-b) + 0.5 * (cubic_root_Y1 + cubic_root_Y2)) / (a3);
				root[2] = root[1];
				root_number = 2;
			}
			else
			{
				root_number = 1;
			}

		}
		/*delta = 0*/
		else if(((delta < HMI_FLOAT_TOLERANCE) && 
				(delta > -HMI_FLOAT_TOLERANCE)) &&
				(A > HMI_FLOAT_TOLERANCE))
		{
			root[0] = (float_32)((- b / a) + (B / A));
			root[1] = (float_32)((-B) / (2 * A));
			root[2] = (float_32)(root[1]);
			root_number = 2;

		}
		/*delta < 0*/
		else if((delta < HMI_FLOAT_TOLERANCE) && 
			(A > HMI_FLOAT_TOLERANCE))
		{
			A_cu	= sqrt(A * A * A);
			T		= (2 * A * b - a3 * B) / (2 * A_cu);
			if(T >= 1.0)
			{
				T	= 1.0 - HMI_FLOAT_TOLERANCE;
			}
			else if(T <= -1.0)
			{

				T	= -1.0 + HMI_FLOAT_TOLERANCE;
			}
			else{}
			
			sqrt_A		= sqrt(A);
			angle		= acos(T);				
			root[0] = ((-b) - 2 * sqrt_A * cos(angle / 3)) / (a3);
			root[1] = ((-b) + 2 * sqrt_A * cos(angle / 3 + ((HMI_PI * 2) / 3) )) / (a3);
			root[2] = ((-b) + 2 * sqrt_A * cos(angle / 3 - ((HMI_PI * 2) / 3) )) / (a3);
							
			root_number = 3;
			
		}
		else
		{}
	}
	else	/*a *x *x + b *x +c =0*/
	{
		a	= b;
		b	= c;
		c	= d;

		/*a == 0*/
		if((a < HMI_FLOAT_TOLERANCE) && (a > -HMI_FLOAT_TOLERANCE))
		{
			if((b > HMI_FLOAT_TOLERANCE) || (b < -HMI_FLOAT_TOLERANCE))
			{
				root[0]		= (-c) / b;
				root_number = 1;
			}
		}
		else 
		{
			delta	= b * b - 4 * a * c;
			if(delta > HMI_FLOAT_TOLERANCE)
			{
				delta_sq	= sqrt(delta);
				root[0]		= ((-b) + delta_sq) / (2 * a);
				root[1]		= ((-b) - delta_sq) / (2 * a);
				root_number = 2;

			}
		}
	}


	return root_number;
}

