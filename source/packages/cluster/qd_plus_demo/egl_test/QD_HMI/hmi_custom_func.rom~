				hmi_engine_set_object_info(id1_p3,
								(HMI_OBJECT_DATA_STR)(pbuff_parameter->buffer_h));
				
				
			}
			else
			{				
				final_img.pbitmap_data.seg_no	= (pimage_prop_info->pbitmap_data).seg_no;
				final_img.pbitmap_data.index	= (pimage_prop_info->pbitmap_data).index;
				final_img.pbitmap_data.fmt_index= (pimage_prop_info->pbitmap_data).fmt_index;
				final_img.pbitmap_data.x		= (pimage_prop_info->pbitmap_data).x;
				final_img.pbitmap_data.y		= (pimage_prop_info->pbitmap_data).y;
				if((p1 == 0)||(p2 == 0))
				{
					final_img.pbitmap_data.w		= (U16)((pimage_prop_info->pbitmap_data).w);
					final_img.pbitmap_data.h		= (U16)((pimage_prop_info->pbitmap_data).h);
				}

				else
				{
					final_img.pbitmap_data.w		= (U16)(p1);
					final_img.pbitmap_data.h		= (U16)(p2);
				}
			}
			
			call_C_hmi_driver_draw_image((HMI_RECT_STR CONST *)(&screen_target),
											img_compress,
											palpha_pos_angel,
											(HMI_BITMAP_STR CONST *)(&final_img),
