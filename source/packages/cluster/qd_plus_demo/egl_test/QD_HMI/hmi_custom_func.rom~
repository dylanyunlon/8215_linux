void	hmi_max_min_position(SPOINT_TP *pbezier_step,
										UINT16 bezier_array_len,										
										SINT16	beg_index,
										SINT16	end_index,
										SPOINT_TP	*pmin_xy,
										SPOINT_TP	*pmax_xy
										)
{		
	SINT16		loop				= 0u;
    UINT16      swap				= 0;
	
	if((bezier_array_len > 2u/*at least 2 point*/) &&
		(beg_index < bezier_array_len) && (end_index < bezier_array_len))
	{	
		
		if(beg_index > end_index)
		{
			swap = end_index;
			end_index = beg_index;
			beg_index = swap;
		}
		if((pmin_xy != NULL) && (pmax_xy != NULL))
		{
			pmin_xy->x	= pbezier_step[beg_index].x;
			pmin_xy->y	= pbezier_step[beg_index].y;

			pmax_xy->x	= pbezier_step[beg_index].x;
			pmax_xy->y	= pbezier_step[beg_index].y;
		}
		for(loop = beg_index;loop <= end_index;loop++)
		{				
			if(pbezier_step[loop].x < pmin_xy->x)
			{
				pmin_xy->x = pbezier_step[loop].x;
			}
			if(pbezier_step[loop].y < pmin_xy->y)
			{
				pmin_xy->y = pbezier_step[loop].y;
			}

			if(pbezier_step[loop].x > pmax_xy->x)
			{
				pmax_xy->x = pbezier_step[loop].x;
			}
			if(pbezier_step[loop].y > pmax_xy->y)
			{
				pmax_xy->y = pbezier_step[loop].y;
			}				
		}				
	}	
}


