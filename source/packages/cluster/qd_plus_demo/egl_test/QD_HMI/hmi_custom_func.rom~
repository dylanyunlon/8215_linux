#define		HMI_MAX_CNT_PRISM		3
BOOLEAN	hmi_get_element_at_prism_position(float_32				dt/*[1--0] or [-1,0]*/,
												HMI_CONTAINER_PRISM_STR		*playout_attr,
												HMI_RECT_STR				*pcircle_rect/*screen coordinate*/,
												SINT16						head_index,
												SINT16						last_head_index,
												BYTE						first_element_alpha,													
												HMI_CONTAINER_PUBLIC_AXIS_ANGLE_STR 	*pcontainer_attr,
												SINT16						index/*container_at_distortion*/
												)
{	
	BOOLEAN			success							= FALSE;					
	SINT16			container_element_cnt			= 0;	
	float_32		container_interal				= 0.0f;
	SINT16			container_interal_int			= 0;	
	float_32		angle							= 0.0f;
	float_32		last_head_angle					= 0.0f;
	float_32		motion_last_head_angle			= 0.0f;
	SINT16			motion_last_head_angle_int		= 0;
	SINT16			search_index					= 0;
	SINT16			ccw_index						= 0;
	SINT16			cw_index						= 0;
	SINT16			begin_container_index			= 0;	
	SINT16			begin_container_angle			= 0;
	SINT16			new_container_angle				= 0;
	SINT16			distance_angle_begin			= 0;
	SINT16			new_index						= 0;
	BOOLEAN			bnegative							= FALSE;
	HMI_WIDTH_STR		container_w					= 0u;
	float_32			dis_tanf					= 0.0f;
		
	if(playout_attr != NULL)
	{
		container_w					= playout_attr->container_w;
		container_element_cnt		= playout_attr->container_element_cnt;		
		if(container_element_cnt >= HMI_MAX_CNT_PRISM/*three container*/)
		{
			container_interal	= (float_32)(HMI_CIRCLE_ANGEL / ((float_32)(container_element_cnt)));			
		}
	}

	if((pcircle_rect != NULL)&&(container_element_cnt >= HMI_MAX_CNT_PRISM/*three container*/)&&
		(index < container_element_cnt)&&(pcontainer_attr != NULL))
	{						
		
		/*check time elapse*/		
		if(dt > HMI_MAX_TIME_DELTA_ACTION)
		{
			dt = HMI_MAX_TIME_DELTA_ACTION;
		}
		else if(dt < (-HMI_MAX_TIME_DELTA_ACTION))
		{
			dt = -HMI_MAX_TIME_DELTA_ACTION;
		}
		else
		{
		}
		
		last_head_angle	= 180.0f;/*last head container at center position*/					
		/*Get shortest path*/
		/*ccw length*/
		search_index	= last_head_index;
		ccw_index		= 0;
		while(search_index != head_index)
		{
			search_index++;
			if(search_index >= container_element_cnt)
			{
				search_index	= 0;
			}
			ccw_index++;
		}
		/*cw length*/
		search_index	= last_head_index;
		cw_index		= 0;
		while(search_index != head_index)
		{
			search_index--;
			if(search_index < 0)
			{
				search_index	= container_element_cnt - 1;
			}
			cw_index++;
		}
		
		if(ccw_index < cw_index)
		{
			angle	= -((float_32)(ccw_index * container_interal));
		}
		else
		{
			angle	= (float_32)(cw_index * container_interal);
		}

		/*get rotate last head index*/
		angle	= angle * dt ; 
		motion_last_head_angle	= last_head_angle	+ angle;	
		
		/*get 0 angle container index*/
		motion_last_head_angle_int	= (SINT16)(motion_last_head_angle + 0.5f);
		container_interal_int		= (SINT16)(container_interal + 0.5f);
		if(container_interal_int != 0)
		{			
			begin_container_index	= motion_last_head_angle_int / container_interal_int;
			begin_container_angle	= motion_last_head_angle_int % container_interal_int;
			if(begin_container_angle > (container_interal_int - begin_container_angle))
			{
				begin_container_index++;
				begin_container_angle	= begin_container_angle - container_interal_int;
				bnegative	= TRUE;
			}

			begin_container_index	= last_head_index - begin_container_index;
			if(begin_container_index < 0)
			{
				begin_container_index	+= container_element_cnt;
			}
			else if(begin_container_index >= container_element_cnt)
			{
				begin_container_index	-= container_element_cnt;
			}

			else
			{
			}
		}

		if(bnegative == TRUE)
		{
			if(index & 0x01)/*odd*/
			{
				new_container_angle	= begin_container_angle + 
										container_interal_int * ((index + 1) >> 1);	
			}
			else
			{
				new_container_angle	= begin_container_angle - 
										container_interal_int * (index >> 1);
			}
		}
		else
		{
			if(index & 0x01)/*odd*/
			{
				new_container_angle	= begin_container_angle	 -
									container_interal_int * ((index +1) >> 1) ;	
			}
			else
			{
				new_container_angle	= begin_container_angle + 
										container_interal_int * (index >> 1);
			}
		}

		/*[0--360) */
		if(new_container_angle < 0)
		{
			new_container_angle	+= HMI_CIRCLE_ANGEL;
		}
		else if(new_container_angle >= HMI_CIRCLE_ANGEL)
		{
			new_container_angle	-= HMI_CIRCLE_ANGEL;
		}
		else
		{
		}

		distance_angle_begin	= new_container_angle - begin_container_angle;
		if(container_interal_int != 0)
		{
		new_index	= begin_container_index + (distance_angle_begin / container_interal_int);
		}
		if(new_index >= container_element_cnt)
		{
			new_index	-= container_element_cnt;
		}
		
		/*circle*/
		if((container_element_cnt >= HMI_MAX_CNT_PRISM/*two container*/) && 
			(container_w > 0u)&&(pcontainer_attr->distance == 0))
		{
			dis_tanf	= (float_32)(tanf((float_32)(HMI_ANGEL_TO_RADIAN(container_interal / 2.0f))));
			pcontainer_attr->distance		= (SINT16)(container_w / (2.0f * dis_tanf) + 0.5f);
			
		}

		/*left container index at distortion*/
		pcontainer_attr->index		= new_index;
		pcontainer_attr->angle		= new_container_angle;
		//pcontainer_attr->distance	= distance_to_origin;

		success	= TRUE;
		
	}

	return	success;
}

#if HMI_DXY_CUSTOM_CNT + HMI_SXY_CUSTOM_CNT >0U
void hmi_engine_draw_prism_container(HMI_RECT_STR CONST 	*pcustom_farther_rect,
											HMI_RECT_STR			*pcustom_dirty_rect,
											U08						custom_depth,
											HMI_RECT_STR			*pcustom_cliped_farther_rect,
											HMI_OBJECT_ID_STR		custom_id,											
											HMI_ALPHA_SCALE_PT_STR *pfather_alpha_scale
										#if defined(HMI_GRAPHIC_OPENGLES)
											,void					*puser_data
										#endif
											)
{	
	HMI_RECT_STR		hmi_custom_rect			= {0U,0U,0U,0U};
	BOOLEAN 			get_success				= FALSE;
	HMI_OBJECT_ID_STR	hmi_front_container_id	= 0;
	HMI_OBJECT_ID_STR	hmi_container_child_id	= 0;
	HMI_RECT_STR		hmi_screen_rect 		= {0};
	UINT8				hmi_number_object		= 0U;
	HMI_OBJECT_PROP_STR CONST * phmi_container_object_table= NULL;
	UINT8				hmi_child_is_container_nb  = 0U;
	HMI_OBJECT_ID_STR	hmi_child_id		= 0U;
	HMI_OBJECT_ID_STR   hmi_head_id			= 0U;
	U16					hmi_head_index		= 0U;
	HMI_OBJECT_ID_STR   hmi_old_head_id		= 0U;
	U16					hmi_old_head_index	= 0U;
	HMI_TIME			hmi_dt				= 0.0f;
	UINT8				hmi_layerout_mode	= 0U;
	UINT8				layerout_alpha 		= 0U;
	HMI_CONTAINER_PRISM_STR	hmi_layerout_attr ={0U,0U,0U,0U};
	HMI_CONTAINER_PUBLIC_AXIS_ANGLE_STR		hmi_container_pub_axis={0}; 
	U16					hmi_container_index	= 0U;
	U16					index				= 0U;
	BOOLEAN				success				= FALSE;
	HMI_CUSTOM_PROP_STR	custom_object_prop  = {0U};
	HMI_ELEMENT_PROP_STR hmi_object_prop	= {0U};
	HMI_CONTAINER_STR CONST * phmi_container_table	= NULL;
	HMI_CUBE_STR		cube_str			= {0};
	HMI_CUBE_FACE_STR	cube_textrue		= {0};
	HMI_CUBE_AXIS_ELEM_PROP	axis_attr		= {0};
	S3POINT_TP		axis[HMI_ROTATION_AXIS_CNT] = {{0,0,0},{0,0,0},{0,0,0}};
	HMI_CAMERA_STR		camera				= {0};
	UINT8 				father_alpha		= HMI_MAX_ALPHA_VALUE;
	POINT32_TP			custom_center		= {0,0};
								
	
	get_success = hmi_engine_get_custom_prop(custom_id,&custom_object_prop);
	if(get_success == TRUE)
	{
		if((custom_object_prop.attr & HMI_ID1) != 0u)
		{
			hmi_front_container_id = custom_object_prop.id1;
		#if HMI_DYN_CONTAINERS_NUMBER > 0
			if(HMI_IS_DYN_CONTAINER(hmi_front_container_id))
			{
				hmi_front_container_id  = HMI_GET_DYN_CONTAINERS_ID_INDEX(hmi_front_container_id);
				hmi_engine_get_static_container_id(&hmi_front_container_id);/*get static container ID*/	
			}
		#endif
		
			phmi_container_table	= hmi_engine_get_container_child_addr(hmi_front_container_id);
			if(phmi_container_table != NULL)
			{
				hmi_number_object  			= phmi_container_table->container_object_table.object_number;
				phmi_container_object_table	= phmi_container_table->container_object_table.p_object_table;
			}
			if(phmi_container_object_table != NULL)
			{
			/*get container child valid number*/
			hmi_child_is_container_nb = 0u;
			for(index = 0u;index < hmi_number_object; index++)
			{
				hmi_child_id = phmi_container_object_table[index].object_id;
				if((HMI_IS_DYN_XY_CONTAINER(hmi_child_id))||(HMI_IS_CONTAINERS_SXY(hmi_child_id)))
				{
					hmi_child_is_container_nb++;
				}
			}
			/*get  custom widget screen rect and clip rect*/
			hmi_custom_rect.x = custom_object_prop.x;
			hmi_custom_rect.y = custom_object_prop.y;
			hmi_custom_rect.w = custom_object_prop.w;
			hmi_custom_rect.h = custom_object_prop.h;
			hmi_get_object_screen_coor((HMI_RECT_STR CONST *)pcustom_farther_rect,
						&hmi_custom_rect,&(hmi_screen_rect));			
			
			hmi_head_index		= hmi_number_object;
			hmi_old_head_index	= hmi_number_object;
			if((custom_object_prop.attr & HMI_P1) != 0u)
			{	
				if((custom_object_prop.attr & HMI_P1_F) != 0u)
				{
				#ifndef HMI_SIMULATE_QD
					hmi_head_id 		= (HMI_OBJECT_ID_STR)(HMI_U32_TO_F32(custom_object_prop.p1));
				#endif
				}
				else
				{
					hmi_head_id 		= (HMI_OBJECT_ID_STR)(custom_object_prop.p1);
				}
				
			}
			if((custom_object_prop.attr & HMI_P2) != 0u)
			{
				if((custom_object_prop.attr & HMI_P2_F) != 0u)
				{
					hmi_dt 		= (HMI_TIME)(HMI_U32_TO_F32(custom_object_prop.p2));
				}
				else
				{
					hmi_dt 		= (HMI_TIME)(custom_object_prop.p2);
				}
			}
			if((custom_object_prop.attr & HMI_P3) != 0u)
			{
				if((custom_object_prop.attr & HMI_P3_F) != 0u)
				{
				#ifndef HMI_SIMULATE_QD
					hmi_old_head_id 		= (HMI_OBJECT_ID_STR)(HMI_U32_TO_F32(custom_object_prop.p3));
				#endif
				}
				else
				{
					hmi_old_head_id 		= (HMI_OBJECT_ID_STR)(custom_object_prop.p3);
				}
				index	= 0U;
				while(index < hmi_number_object)
				{
				#ifndef HMI_SIMULATE_QD
					if(hmi_head_id == phmi_container_object_table[index].object_id)
					{
						hmi_head_index	= index;
					}
					if(hmi_old_head_id == phmi_container_object_table[index].object_id)
					{
						hmi_old_head_index	= index;
					}
				#else
					if(hmi_cmp_cstring(hmi_head_id , phmi_container_object_table[index].object_id))
					{
						hmi_head_index	= index;
					}
					if(hmi_cmp_cstring(hmi_old_head_id ,phmi_container_object_table[index].object_id))
					{
						hmi_old_head_index	= index;
					}
				#endif
					index++;
				}
			}
			if((custom_object_prop.attr & HMI_CON_P1) != 0u)
			{
				if((custom_object_prop.attr & HMI_CON_F1) != 0u)
				{
					hmi_layerout_mode	= (UINT8)(HMI_U32_TO_F32(custom_object_prop.const_p1));
				}
				else
				{
					hmi_layerout_mode	= (UINT8)(custom_object_prop.const_p1);
				}
			}
			
			if((custom_object_prop.attr & HMI_CON_P2) != 0u)
			{
				if((custom_object_prop.attr & HMI_CON_F2) != 0u)
				{
					layerout_alpha	= (UINT8)(HMI_U32_TO_F32(custom_object_prop.const_p2));
				}
				else
				{
					layerout_alpha	= (UINT8)(custom_object_prop.const_p2);
				}
			}
			
			hmi_engine_get_object_prop(hmi_head_id,&hmi_object_prop);
			hmi_layerout_attr.container_w				= hmi_object_prop.w;
			hmi_layerout_attr.container_h				= hmi_object_prop.h;
			hmi_layerout_attr.container_element_cnt		= hmi_child_is_container_nb;
			hmi_layerout_attr.layerout_mode				= hmi_layerout_mode;

			custom_center.x	= hmi_screen_rect.x + (hmi_screen_rect.w >> 1u);
			custom_center.y	= hmi_screen_rect.y + (hmi_screen_rect.h >> 1u);
			
			axis[HMI_ROTATION_PRIVATE_AXIS].x			= 0;
			axis[HMI_ROTATION_PRIVATE_AXIS].y			= 0;
			axis[HMI_ROTATION_PRIVATE_AXIS].z			= 1;

			axis[HMI_ROTATION_PUBLIC_AXIS1].x			= (SINT16)(custom_center.x);
			axis[HMI_ROTATION_PUBLIC_AXIS1].y			= (SINT16)(custom_center.y);
			axis[HMI_ROTATION_PUBLIC_AXIS1].z			= 0;

			axis[HMI_ROTATION_PUBLIC_AXIS2].x			= (SINT16)(custom_center.x);
			axis[HMI_ROTATION_PUBLIC_AXIS2].y			= (SINT16)(custom_center.y + 1/*center axis*/);
			axis[HMI_ROTATION_PUBLIC_AXIS2].z			= 0;
			
			hmi_engine_get_object_prop(custom_object_prop.id2/*fill as camera*/,&hmi_object_prop);
			/*fill position is camera position*/
			camera.position.x	= (SINT16)(hmi_object_prop.x);
			camera.position.y	= (SINT16)(hmi_object_prop.y);
			camera.position.z	= (SINT16)(hmi_object_prop.z);
			/*camera screen position */ // 2020 10 23
			camera.position.x	+=	pcustom_farther_rect->x;
			camera.position.y	+=	pcustom_farther_rect->y;
			/*prism at 0,0,0 position*/
			camera.target.x	=  (SINT16)(custom_center.x);
			camera.target.y	=  (SINT16)(custom_center.y);
			camera.target.z	=  0;
			/*Camera top is up*/
			camera.up.x		=  0;
			camera.up.y		=  -1;
			camera.up.z		=  0;
			/*fill width/height is camera near/far plane*/
			camera.camera_near	= (float_32)(hmi_object_prop.w);
			camera.camera_far	= (float_32)(hmi_object_prop.h);
			/*cube position*/
			cube_str.cube_rect.x	= (HMI_X_STR)(custom_center.x - (hmi_layerout_attr.container_w >> 1u));
			cube_str.cube_rect.y	= (HMI_Y_STR)(custom_center.y - (hmi_layerout_attr.container_h >> 1u));
			cube_str.cube_rect.w	= hmi_layerout_attr.container_w ;
			cube_str.cube_rect.h	= hmi_layerout_attr.container_h ;

			cube_str.bump			= FALSE;
			cube_str.private_angel	= 0.0f;
			cube_str.scale			= 1.0f;

			
			
			for(index = 0u;index < hmi_number_object ;index++)			
			{
				success	= hmi_get_element_at_prism_position(hmi_dt,
														&hmi_layerout_attr,
														&hmi_screen_rect,
														(SINT16)hmi_head_index,
														(SINT16)hmi_old_head_index,																											
														layerout_alpha,													
														&hmi_container_pub_axis,
														(SINT16)index
														);
				
				if(success == TRUE)
				{
					hmi_container_index	= (U16)(hmi_container_pub_axis.index);
					if(hmi_container_index >= hmi_number_object)
					{
						hmi_container_index	= hmi_container_index % hmi_number_object;
					}
									
					hmi_container_child_id	= phmi_container_object_table[hmi_container_index].object_id;
					
					phmi_container_table	= hmi_engine_get_container_child_addr(hmi_container_child_id);
					if(phmi_container_table != NULL)
					{
						
						cube_str.angel			= hmi_container_pub_axis.angle - HMI_HALF_CIRCLE_ANGEL/*cube 0 angle at front*/ ;
						cube_str.z				= hmi_container_pub_axis.distance;
						
						
						axis_attr.attribute	= 0u;
						axis_attr.attribute	|= HMI_CUBE_ROTATION_USERDEFINE;
						if(hmi_layerout_mode == 0u)
						{
							axis_attr.attribute	|= HMI_SURFACE_DOUBLE_SIDE;
						}
						else if(hmi_layerout_mode == 1u)
						{
							axis_attr.attribute	|= HMI_SURFACE_CCW;
						}
						else if(hmi_layerout_mode == 2u)
						{
							axis_attr.attribute	|= HMI_SURFACE_CW;
						}
						else
						{
							axis_attr.attribute	|= HMI_SURFACE_DOUBLE_SIDE;
						}
						if(hmi_layerout_mode != 3)
						{
							/*Only get the image ,not all container element*/
							hmi_cube_get_container_prop3(hmi_container_child_id,
													&(cube_textrue.cube_face1_texture),
													NULL,NULL);
						}
						else	/*all container as renderbuffer*/
						{
							hmi_cube_get_container_prop(hmi_container_child_id,
													&(cube_textrue.cube_face1_texture),
													NULL,NULL);
						}
						call_C_hmi_driver_draw_3d_image((HMI_RECT_STR CONST *)(&hmi_screen_rect),
												(HMI_CUBE_STR CONST	*)(&cube_str),
												(HMI_CUBE_FACE_STR	*)(&cube_textrue),
												NULL,/*bump texture*/
												pcustom_cliped_farther_rect,
												pcustom_dirty_rect,
												custom_depth,																	
												pfather_alpha_scale,
												(HMI_CUBE_AXIS_ELEM_PROP CONST *)(&axis_attr),
												axis,
												&camera);
									
					}
					}
				}
			}
		}
	}	
} 

