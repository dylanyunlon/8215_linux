void hmi_draw_gaussion_blur(HMI_OBJECT_ID_STR				blur_image_id,
									HMI_RECT_STR			*pimg_zone,
									HMI_CUSTOM_P_FLOAT		blur_size,
									HMI_CUSTOM_P_FLOAT 		resolution_x,
									HMI_CUSTOM_P_FLOAT 		resolution_y,
									HMI_RECT_STR			*pcustom_dirty_rect,							
									HMI_RECT_STR			*pcustom_cliped_farther_rect,																		
									HMI_ALPHA_SCALE_PT_STR *pfather_alpha_scale)
{	
	GLenum 						readType		= GL_UNSIGNED_BYTE;
	GLenum 						readFormat		= GL_RGBA;
	//GLubyte					*pixels			= 0;
	UINT32						bytesPerPixel	= 0;
	UINT32						size			= 0u;
	HMI_ELEMENT_PROP2_STR		object_prop2	= {0};
	HMI_ELEMENT_PROP_STR		object_prop		= {0};
	GLuint						texture_id		= 0;
	HMI_RECT_ALPHA_ANGEL_STR	alpha_pos_angel	= {0};
	HMI_RECT_STR				clip_rect		= {0};
	HMI_ROTATION_STR			rotation		= {0};
	float_32					fresolution[2]	= {resolution_x,resolution_y};
	TEXTURE_2D_PIXEL_FORMAT		color_fmt		= TEXTURE_2D_PIXEL_FORMAT_RGBA8888;

#if 0
	glGetIntegerv(GL_IMPLEMENTATION_COLOR_READ_TYPE,
					&readType);
	glGetIntegerv(GL_IMPLEMENTATION_COLOR_READ_FORMAT,
					&readFormat);

#endif
	
	switch(readType)
	{
		case GL_UNSIGNED_BYTE:
			switch(readFormat)
			{
				case GL_RGBA:
					bytesPerPixel	= 4;
					color_fmt		= TEXTURE_2D_PIXEL_FORMAT_RGBA8888;
					break;
				case GL_RGB:
					bytesPerPixel	= 3;
					color_fmt		= TEXTURE_2D_PIXEL_FORMAT_RGB888;
					break;
			#if 0
				case GL_LUMINANCE_ALPHA:
					bytesPerPixel	= 2;
					color_fmt		= TEXTURE_2D_PIXEL_FORMAT_RGB565;
					break;
			#endif
				case GL_ALPHA:
				//case GL_LUMINANCE:
					bytesPerPixel	= 1;
					color_fmt		= TEXTURE_2D_PIXEL_FORMAT_A8;
					break;
			}
			break;
	#if 0
		case GL_UNSIGNED_SHORT_4444:	/* GL_RGBA format */
		case GL_UNSIGNED_SHORT_555_1:	/* GL_RGBA format */
		case GL_UNSIGNED_SHORT_565: 	/* GL_RGB format */
			bytesPerPixel	= 2;
			color_fmt		= TEXTURE_2D_PIXEL_FORMAT_RGB565;
			break;
	#endif
	}	
	hmi_engine_get_object_prop2(blur_image_id,
								&object_prop2);
	hmi_engine_get_object_prop(blur_image_id,
								&object_prop);
#if defined(HMI_SIMULATE_QD)	
	texture_id	= create_texture_id_from_frmbuf(
							TEXTURE_2D_PIXEL_FORMAT_RGBA8888,
							(GLint)(pimg_zone->x),
							(GLint)(hmi_screen_size[0].y - (pimg_zone->y + pimg_zone->h)),
							(GLint)(pimg_zone->w),
							(GLint)(pimg_zone->h),
							HMI_TEXURE_UINT_CUSTOM1);
#else
	texture_id	= create_texture_id_from_frmbuf(
							TEXTURE_2D_PIXEL_FORMAT_RGBA8888,
							(GLint)(pimg_zone->x),
							(GLint)(HMI_MAX_HEIGHT - (pimg_zone->y + pimg_zone->h)),
							(GLint)(pimg_zone->w),
							(GLint)(pimg_zone->h),
							HMI_TEXURE_UINT_CUSTOM1);

#endif
	
	if(texture_id != 0)
	{				
		/*set background texture to GPU*/
		hmi_set_qd_attributte(HMI_QD_GAUSSIAN,FALSE);
		glUniform1f(hmi_user_data.u_blur_size,blur_size);
		glUniform2fv(hmi_user_data.u_resolution, 
					1, (GLfloat*)(fresolution));
			
		/*draw image*/
		hmi_get_union_rect(pimg_zone,
							pcustom_cliped_farther_rect,
							&clip_rect);
		if((clip_rect.w > 0)&&(clip_rect.h > 0))
		{
			alpha_pos_angel.alpha	= object_prop.alpha;
			alpha_pos_angel.angel	= 0.0f;

			rotation.x	= (HMI_X_STR)(object_prop2.rotation.x);
			rotation.y	= (HMI_X_STR)(object_prop2.rotation.y);
			call_C_hmi_driver_draw_image((HMI_RECT_STR CONST 	*)pimg_zone,
									object_prop2.img_compress,
									&alpha_pos_angel,
									(HMI_BITMAP_STR CONST 	*)(object_prop2.pimage_prop_info),
									&clip_rect,
									pcustom_dirty_rect,
									0/*layer*/,
									&rotation,/*rotation point,NULL mean center point*/
									blur_image_id,	
									pfather_alpha_scale);
		}
		glDeleteTextures(1, &texture_id);
		hmi_set_qd_attributte(HMI_QD_GAUSSIAN,TRUE);
	}


}




void hmi_engine_gauss_blur(HMI_RECT_STR CONST 	*pcustom_farther_rect,
							HMI_RECT_STR				*pcustom_dirty_rect,
							U08 						custom_depth,
							HMI_RECT_STR				*pcustom_cliped_farther_rect,
							HMI_OBJECT_ID_STR			custom_id,											
							HMI_ALPHA_SCALE_PT_STR		*pfather_alpha_scale,
							void						*puser_data)

{
	BOOLEAN 				get_success 				= FALSE;
	BOOLEAN 				bzone 						= FALSE;
	HMI_CUSTOM_PROP_STR 	custom_object_prop			= {0U};
	HMI_CUSTOM_P_FLOAT		p1_blur_size				= 0.0f;	
	HMI_OBJECT_ID_STR		blur_image_id				= 0;			
	HMI_RECT_STR			custom_rect					= {0};
	HMI_RECT_STR			dsp_rect					= {0};
	UINT32					hmi_number_object			= 0u;
	HMI_CUSTOM_P_INT		disp_mode					= 0; 
	HMI_CUSTOM_P_FLOAT		resolutoin_x				= 0.0f;
	HMI_CUSTOM_P_FLOAT		resolutoin_y				= 0.0f;
	HMI_CONTAINER_STR CONST	*phmi_container_table		= NULL; 
	HMI_OBJECT_PROP_STR CONST *phmi_container_object_table	= NULL;
	HMI_ELEMENT_PROP_STR	container_prop				= {0};
		
	get_success = hmi_engine_get_custom_prop(custom_id,
									&custom_object_prop);
	if(get_success == TRUE)
	{	
		custom_rect.x		=  (HMI_X_STR)(pcustom_farther_rect->x + 
										custom_object_prop.x); 	
		custom_rect.y		=  (HMI_Y_STR)(pcustom_farther_rect->y + 
										custom_object_prop.y);
		custom_rect.w		= custom_object_prop.w;
		custom_rect.h		= custom_object_prop.h;
		hmi_get_union_rect(&custom_rect,
					pcustom_cliped_farther_rect,
					&dsp_rect);
		if((dsp_rect.w > 0)&&(dsp_rect.h))
		{
			bzone	= TRUE;
		}
														
		/*p1*/
		if((custom_object_prop.attr & HMI_P1) != 0)
		{	
			if((custom_object_prop.attr & HMI_P1_F) != 0)
			{
				p1_blur_size		= (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(custom_object_prop.p1));
			}
			else
			{
				//p1_blur_size		= (HMI_CUSTOM_P_INT)(custom_object_prop.p1);
			}			
		}


		/*id1*/
		get_success = FALSE;
		if((custom_object_prop.attr & HMI_ID1) != 0)
		{
			blur_image_id	= custom_object_prop.id1;						
#if HMI_DYN_CONTAINERS_NUMBER > 0
			if(HMI_IS_DYN_CONTAINER(blur_image_id))
			{
				blur_image_id  = HMI_GET_DYN_CONTAINERS_ID_INDEX(blur_image_id);
				hmi_engine_get_static_container_id(&blur_image_id);/*get static container ID*/	
			}
#endif
			if((HMI_IS_S_XY_BITMAP(blur_image_id))||
				(HMI_IS_DYN_XY_BITMAP(blur_image_id)))
			{		
				hmi_engine_get_object_prop(
										blur_image_id,
										&container_prop);
				custom_rect.x	+= container_prop.x;
				custom_rect.y	+= container_prop.y;
				custom_rect.w	=  container_prop.w;
				custom_rect.h	=  container_prop.h;
				get_success	= TRUE;
			}			
		#if HMI_SXY_CONTAINERS_NUMBER + HMI_DXY_CONTAINERS_NUMBER > 0
			else if((HMI_IS_CONTAINERS_SXY(blur_image_id))||
					(HMI_IS_DYN_XY_CONTAINER(blur_image_id)))
			{
				phmi_container_table	= hmi_engine_get_container_child_addr(
														blur_image_id);
				if(phmi_container_table != NULL)
				{
					hmi_number_object  = 
						(phmi_container_table->container_object_table.object_number);
					if(hmi_number_object > 0u)
					{					
						phmi_container_object_table	= 
							phmi_container_table->container_object_table.p_object_table;
						
						blur_image_id	= phmi_container_object_table[0].object_id;
						if((HMI_IS_S_XY_BITMAP(blur_image_id))||
							(HMI_IS_DYN_XY_BITMAP(blur_image_id)))
						{	
							hmi_engine_get_object_prop(
										blur_image_id,
										&container_prop);
							custom_rect.x	+= container_prop.x;
							custom_rect.y	+= container_prop.y;
							custom_rect.w	=  container_prop.w;
							custom_rect.h	=  container_prop.h;
							get_success		= TRUE;
						}
					}				
				}	
			}
		#endif
			else{}
											
			if((get_success == TRUE)&&
					(bzone == TRUE))
			{			
				/*const p1--p3*/
				if((custom_object_prop.attr & HMI_CON_P1) != 0)
				{
					if((custom_object_prop.attr & HMI_CON_F1) != 0)
					{
						//disp_mode = (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(custom_object_prop.const_p1));
					}
					else
					{
						disp_mode	= (HMI_CUSTOM_P_INT)(custom_object_prop.const_p1);					
					}
				}
				
				if((custom_object_prop.attr & HMI_CON_P2) != 0)
				{
					if((custom_object_prop.attr & HMI_CON_F2) != 0)
					{
						resolutoin_x	= (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(custom_object_prop.const_p2));
					}
					else
					{
						//resolutoin_x	= (HMI_CUSTOM_P_INT)(custom_object_prop.const_p2);					
					}
				}
				
				if((custom_object_prop.attr & HMI_CON_P3) != 0)
				{
					if((custom_object_prop.attr & HMI_CON_F3) != 0)
					{
						resolutoin_y	= (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(custom_object_prop.const_p3));
					}
					else
					{
						//resolutoin_y = (HMI_CUSTOM_P_INT)(custom_object_prop.const_p3);					
					}
				}	
				
				hmi_draw_gaussion_blur(blur_image_id,
									&custom_rect,
									p1_blur_size,
									resolutoin_x,
									resolutoin_y,
									pcustom_dirty_rect,
									&dsp_rect,
									pfather_alpha_scale);
				
				
			}	
		}
	}
