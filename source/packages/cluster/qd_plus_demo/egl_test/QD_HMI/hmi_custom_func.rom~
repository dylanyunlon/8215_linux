					{
						//p2_player_program		= (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(custom_object_prop.p2));
					}
					else
					{
						p2_player_program		= (HMI_CUSTOM_P_INT)(custom_object_prop.p2);
					}			
				}
