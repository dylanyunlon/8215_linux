			}
		}
		if((hmi_light_prop.attr & HMI_CON_P3) !=0)
		{
			if((hmi_light_prop.attr & HMI_CON_F3) !=0)
			{
				const_p3_rz   = (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(hmi_light_prop.const_p3));
			}
			else
			{
				//const_p3_rz	 = (HMI_CUSTOM_P_INT)(hmi_view_prop.const_p3);
