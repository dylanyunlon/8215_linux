#define	HMI_BEZIER_XY_SOLUTION_CNT		3
INT32	get_cublic_bezier_xy(POINT_FLOAT_TP		*pbezier,INT32	len/*always 4*/,
							float_32	fval/*input*/,BOOLEAN	bget_x,
							float_32	fxy_result[/*HMI_BEZIER_XY_SOLUTION_CNT*/])
{
	INT32			solution_cnt		= 0;	
	POINT_FLOAT_TP	bound_box[2]		= {0.0f};
	INT32			k					= 0;
	POINT_FLOAT_TP	p0					= {0.0f};
	POINT_FLOAT_TP	p1					= {0.0f};
	POINT_FLOAT_TP	p2					= {0.0f};
	POINT_FLOAT_TP	p3					= {0.0f};
	float_32		px01				= 0.0f;
	float_32		px02				= 0.0f;
	float_32		px03				= 0.0f;
	float_32		px12				= 0.0f;
	float_32		px13				= 0.0f;
	float_32		px23				= 0.0f;
	float_32		py01				= 0.0f;
	float_32		py02				= 0.0f;
	float_32		py03				= 0.0f;
	float_32		py12				= 0.0f;
	float_32		py13				= 0.0f;
	float_32		py23				= 0.0f;
	float_32		a					= 0.0f;
	float_32		b					= 0.0f;
	float_32		c					= 0.0f;
	float_32		d					= 0.0f;
	float_32		A					= 0.0f;
	float_32		B					= 0.0f;
	float_32		C					= 0.0f;
	float_32		cublic_C			= 0.0f;
	float_32		D					= 0.0f;
	float_32		dis					= 0.0f;
	float_32		xA[HMI_BEZIER_XY_SOLUTION_CNT]		= {0.0f};	
	float_32		yA					= 0.0f;
	float_32		yB					= 0.0f;
	float_32		yC					= 0.0f;
	float_32		t					= 0.0f;
	float_32		tx					= 0.0f;
	float_32		m[HMI_BEZIER_XY_SOLUTION_CNT]			= {0.0f};	
	float_32		b_3a				= 0.0f;
	float_32		c_3a				= 0.0f;
	float_32		d_2a				= 0.0f;
	float_32		e					= 0.0f;
	float_32		f					= 0.0f;
	float_32		a_sq				= 0.0f;
	float_32		a_cu				= 0.0f;
	float_32		b_sq				= 0.0f;
	float_32		b_cu				= 0.0f;	
	float_32		e_sq				= 0.0f;
	float_32		f_cu				= 0.0f;
	float_32		p					= 0.0f;
	float_32		q					= 0.0f;
	float_32		r					= 0.0f;
	float_32		angle				= 0.0f;
	float_32		arc_val				= 0.0f;
	//POINT_FLOAT_TP	ctl_pt[HMI_BEZIER_XY_SOLUTION_CNT];		


	//get_path_bound_box_s32(pbezier,len,bound_box);lq

	if((len >= 4/*cublic	Bezier ctrl point cnt*/)&&
		(pbezier != NULL))
	{	
		get_path_bound_box_s32(pbezier,len,bound_box);/*lq*/
		
		p0.x	= pbezier[0].x;
		p0.y	= pbezier[0].y;

		p1.x	= pbezier[1].x;
		p1.y	= pbezier[1].y;

		p2.x	= pbezier[2].x;
		p2.y	= pbezier[2].y;

		p3.x	= pbezier[3].x;
		p3.y	= pbezier[3].y;
		
		if(bget_x == TRUE)/*GET y*/
		{
			if((fval >= bound_box[0].x)&&(fval <= bound_box[1].x))
			{
				// get bezier y
				px01 = p0.x * p1.x;
				px02 = p0.x * p2.x;
				px03 = p0.x * p3.x;
				px12 = p1.x * p2.x;
				px13 = p1.x * p3.x;
				px23 = p2.x * p3.x;
				py01 = p0.y * p1.y;
				py02 = p0.y * p2.y;
				py03 = p0.y * p3.y;
				py12 = p1.y * p2.y;
				py13 = p1.y * p3.y;
				py23 = p2.y * p3.y;
				a    = p3.x - (3 * p2.x) + (3 * p1.x) - p0.x;
				b    = 3 * (px12 - px03 - 2 * p1.x * p1.x + 2 * px02);
				c    = 3 * (p1.x * p1.x * p1.x - 2 * px01 * p2.x + px03 * p0.x - px02 * p0.x + px01 * p1.x);
				d    = (3 * px01 * px02 - 2 * px01 * p1.x * p1.x - px03 * p0.x * p0.x) - 
						fval * (p1.x - p0.x) * (p1.x - p0.x) * (p1.x - p0.x);
				B    = (- b) / (3 * a);
				C    = B * B - (c / (3 * a));
				D    = - B * B * B + 3 * B * C - (d / a);// a != 0 ??
				dis  = D * D - 4 * C * C * C;
				if(dis >= 0)
				{
					xA[0] = (float_32)(B + pow(((D + pow(dis,2)) * 0.5),3) + pow(((D - pow(dis,2)) * 0.5),3));
					if(p1.y != p0.y)
					{
						yA = ((p1.y - p0.y) / (p1.x - p0.x)) * xA[0] + ((p1.x * p0.y - p0.x * p1.y) / (p1.x -p0.x));
						fxy_result[solution_cnt++]  = ((p3.y - 3 * p2.y + 3 * p1.y - p0.y) * yA * yA * yA + 3 * (py12 - py03 - 2 * p1.y * p1.y + 2 * py02) * yA * yA +
						3 * (p1.y * p1.y * p1.y - 2 * py01 * p2.y + py03 * p0.y - py02 * p0.y + py01 * p1.y) * yA + 
						(3 * py01 * py02 - 2 * py01 * p0.y * p0.y - py03 * p0.y * p0.y)) / ((p1.y - p0.y) * (p1.y - p0.y) * (p1.y - p0.y));
					}
					else if((p1.y == p0.y) && (p1.y != p2.y))
					{
						yB = ((p2.y -p1.y) / (p1.x - p0.x)) * xA[0] + ((p1.x * p1.y - p0.x * p2.y) / (p1.x - p0.x));
						fxy_result[solution_cnt++] = ((p3.y - 3 * p2.y + 2 * p1.y) * yB * yB * yB + (3 * p2.y * p2.y - 3 * py13 + py02 - py01 - 2 * p1.y * p1.y + 2 * py12) * yB * yB +
							(3 * py13 * p1.y - 4 * py12 * p2.y - 2 * py02 * p2.y + 2 * py01 * p2.y + py12 * p1.y) + 
							(py02 * p2.y - py02 * py12 + py12 * py12 - py13 * p1.y * p1.y)) / ((p2.y - p1.y) *(p2.y - p1.y) * (p2.y - p1.y));
					}
					else if((p1.y == p0.y) && (p1.y == p2.y) && (p2.y != p3.y))
					{
						yC = ((p3.y - p2.y) / (p1.x - p0.x)) * xA[0] + ((p1.x * p2.y - p0.x * p3.y)  / (p1.x - p0.x));
						fxy_result[solution_cnt++] = ((yC * yC * yC) - (p0.y + 2 * p2.y) * yC * yC + (2 * py02 + p2.y * p2.y) * yC +
													(py03 * p3.y * p3.y - 2 * py02 * p3.y)) / ((p3.y - p2.y) * (p3.y - p2.y));
					}
					else
					{
						fxy_result[solution_cnt++] = ((p1.y - p0.y) / (p1.x - p0.x)) * xA[0] + ((p1.x * p0.y - p0.x * p1.y) / (p1.x -p0.x));
					}				
				}
				else
				{
					cublic_C	= (float_32)(C * C * C);
				#if 0
					xA[0] = (float_32)(B + 2 * pow(C,2) * cos((float_32)(acosf(D / (2 * pow(cublic_C,2) )) + 2  * HMI_PI) / 3));
					xA[1] = (float_32)(B + 2 * pow(C,2) * cos((acosf(D / (2 * pow(cublic_C,2) )) + 4  * HMI_PI) / 3));
					xA[2] = (float_32)(B + 2 * pow(C,2) * cos((acosf(D / (2 * pow(cublic_C,2) )) + 6  * HMI_PI) / 3));
				#endif
					xA[0] = (float_32)(B + 2 * pow(C,2) * cos((acosf(D / (2 * (float_32)pow(cublic_C,2) )) + 2  * HMI_PI) / 3));
					xA[1] = (float_32)(B + 2 * pow(C,2) * cos((acosf(D / (2 * (float_32)pow(cublic_C,2) )) + 4  * HMI_PI) / 3));
					xA[2] = (float_32)(B + 2 * pow(C,2) * cos((acosf(D / (2 * (float_32)pow(cublic_C,2) )) + 6  * HMI_PI) / 3));
					for(k = 0;k < HMI_BEZIER_XY_SOLUTION_CNT;k++)
					{					
						if(p1.y != p0.y)
						{
							yA = ((p1.y - p0.y) / (p1.x - p0.x)) * xA[k] + ((p1.x * p0.y - p0.x * p1.y) / (p1.x -p0.x));
							fxy_result[solution_cnt++]  = ((p3.y - 3 * p2.y + 3 * p1.y - p0.y) * yA * yA * yA + 3 * (py12 - py03 - 2 * p1.y * p1.y + 2 * py02) * yA * yA +
														3 * (p1.y * p1.y * p1.y - 2 * py01 * p2.y + py03 * p0.y - py02 * p0.y + py01 * p1.y) * yA + 
														(3 * py01 * py02 - 2 * py01 * p0.y * p0.y - py03 * p0.y * p0.y)) / ((p1.y - p0.y) * (p1.y - p0.y) * (p1.y - p0.y));
						}
						else if((p1.y == p0.y) && (p1.y != p2.y))
						{
							yB = ((p2.y -p1.y) / (p1.x - p0.x)) * xA[k]  + ((p1.x * p1.y - p0.x * p2.y) / (p1.x - p0.x));
							fxy_result[solution_cnt++] = ((p3.y - 3 * p2.y + 2 * p1.y) * yB * yB * yB + (3 * p2.y * p2.y - 3 * py13 + py02 - py01 - 2 * p1.y * p1.y + 2 * py12) * yB * yB +
															(3 * py13 * p1.y - 4 * py12 * p2.y - 2 * py02 * p2.y + 2 * py01 * p2.y + py12 * p1.y) + 
															(py02 * p2.y - py02 * py12 + py12 * py12 - py13 * p1.y * p1.y)) / ((p2.y - p1.y) *(p2.y - p1.y) * (p2.y - p1.y));
						}
						else if((p1.y == p0.y) && (p1.y == p2.y) && (p2.y != p3.y))
						{
							yC = ((p3.y - p2.y) / (p1.x - p0.x)) * xA[k]  + ((p1.x * p2.y - p0.x * p3.y)  / (p1.x - p0.x));
							fxy_result[solution_cnt++] = ((yC * yC * yC) - (p0.y + 2 * p2.y) * yC * yC + (2 * py02 + p2.y * p2.y) * yC +
														(py03 * p3.y * p3.y - 2 * py02 * p3.y)) / ((p3.y - p2.y) * (p3.y - p2.y));
						}
						else
						{
							fxy_result[solution_cnt++]  = ((p1.y - p0.y) / (p1.x - p0.x)) * xA[k]  + ((p1.x * p0.y - p0.x * p1.y) / (p1.x -p0.x));
						}
					}					
				}
			}
		}
		else	/*GET x*/
		{
			if((fval > bound_box[0].y)&&(fval < bound_box[1].y))
			{
				// get bezier x
				a = p0.y - fval;
				if(a == 0)
				{
					fxy_result[solution_cnt++] = p0.x;
				}
				else
				{
					
					b = 3 * (p1.y - fval);
					c = 3 * (p2.y - fval);
					a_sq = a * a;
					a_cu = a * a * a;
					b_sq = b * b;
					b_cu = b * b * b;
					d = p3.y - fval;
					b_3a = (b / (3 * a));
					c_3a = (c / (3 * a));
					d_2a = (d / (3 * a));
					e = ((b * c) / (6 * a_sq)) - ((b_cu) / (27 * a_cu)) - (d / (2 * a));
					f = (c / (3 * a)) - ((b_sq) / (9 * a_sq));
					e_sq = e * e;
					f_cu = f * f * f;
					if(e_sq + f_cu > 0)
					{	
						m[0]	= (float_32)(-b_3a + pow((e + sqrt(e_sq + f_cu)),1.0 / 3) + pow((e - sqrt(e_sq + f_cu)),1.0 / 3));
						t		= 1 / (m[0] + 1);
						if((t >= 0.0f)&&(t <= 1.0f))
						{
							tx		= 1 - t;
							
							fxy_result[solution_cnt++] = p0.x * tx * tx * tx + 3 * p1.x * t * tx * tx +
														3 * p2.x * t * t * tx + p3.x * t * t * t;							
						}
					}
					else
					{
						p		=  ((3 * a * c - b_sq) / (3 * a_sq));
						q		= ((27 * a_sq * d - 9 * a * b * c + 2 * b_cu) / (27 * a_cu));
						r		= (float_32)((sqrt(-(p / 3) * (p / 3) * (p / 3))));
						arc_val	= -(q / (2 * r));
						if(arc_val > 1.0f)
						{
							arc_val = 1.0f;
						}
						else if(arc_val < -1.0f)
						{
							arc_val = -1.0f;
						}
						else{}
						angle	= (float_32)(acos(arc_val) / 3) ; 
					
						m[0]	= (float_32)(2 * (pow(r,1.0 / 3)) * cos(angle) - b_3a);
						m[1]	= (float_32)(2 * (pow(r,1.0 / 3)) * cos(angle + HMI_ANGEL_TO_RADIAN(180)) - b_3a);
						m[2]	= (float_32)(2 * (pow(r,1.0 / 3)) * cos(angle + HMI_ANGEL_TO_RADIAN(240)) - b_3a);

						arc_val	= (m[0] + 1);
						if((arc_val > HMI_FLOAT_TOLERANCE)||
							(arc_val < -HMI_FLOAT_TOLERANCE))
						{
							t = 1 / arc_val;
							if((t >= 0.0f)&&(t <= 1.0f))
							{
								tx = 1 - (1 / arc_val);
								fxy_result[solution_cnt++] =  p0.x * tx * tx * tx + 3 * p1.x * t * tx * tx +
														3 * p2.x * t * t * tx + p3.x * t * t * t;
							}
						}

						arc_val	= (m[1] + 1);
						if((arc_val > HMI_FLOAT_TOLERANCE)||
							(arc_val < -HMI_FLOAT_TOLERANCE))
						{
							t = 1 / arc_val;
							if((t >= 0.0f)&&(t <= 1.0f))
							{
								tx = 1 - (1 / arc_val);
								fxy_result[solution_cnt++] =  p0.x * tx * tx * tx + 3 * p1.x * t * tx * tx +
														3 * p2.x * t * t * tx + p3.x * t * t * t;
							}
						}

						arc_val	= (m[2] + 1);
						if((arc_val > HMI_FLOAT_TOLERANCE)||
							(arc_val < -HMI_FLOAT_TOLERANCE))
						{
							t = 1 / arc_val;
							if((t >= 0.0f)&&(t <= 1.0f))
							{
								tx = 1 - (1 / arc_val);
								fxy_result[solution_cnt++] =  p0.x * tx * tx * tx + 3 * p1.x * t * tx * tx +
														3 * p2.x * t * t * tx + p3.x * t * t * t;
							}
						}									
					}						
				}
			}			
		}

		if(solution_cnt == 0)
		{
			if(bget_x == TRUE)/*GET y*/
			{
				if(fval >= bound_box[1].y)
				{
					if(pbezier[0].y > pbezier[3].y)
					{
						fxy_result[solution_cnt++]	= pbezier[0].y;
					}
				}
				fxy_result[solution_cnt++]	= pbezier[0].y;
			}
			else	/*get x*/
			{
				if(fval >= bound_box[1].y)
				{
					if(pbezier[0].y > pbezier[3].y)
					{
						fxy_result[solution_cnt++]	= pbezier[0].x;
					}
					else
					{
						fxy_result[solution_cnt++]	= pbezier[3].x;
					}
				}
				else
				{
					if(pbezier[0].y > pbezier[3].y)
					{
						fxy_result[solution_cnt++]	= pbezier[3].x;
					}
					else
					{
						fxy_result[solution_cnt++]	= pbezier[0].x;
					}
				}
			}
		}
	}

	
	return	solution_cnt;
}


#define	HMI_LANE_MAX_OFFSET	(0xffff)
BOOLEAN	hmi_draw_tri_road(HMI_RECT_STR	*pscreen_target,		
							HMI_RECT_STR		*pclip_rect,
							POINT_FLOAT_TP		*p_road,//8 * n ctrl point.2*n bezier cure
							INT32				point_cnt,// always 8*n
							INT32				offset,
							INT32				*px,
							INT32				*py,
							BOOLEAN				ball_mask)
{
	BOOLEAN			success				= FALSE;
	POINT_FLOAT_TP	center_bezier[4]	= {0};
	HMI_RECT_STR	offset_rect			= {0};
	POINT_FLOAT_TP	bound_box[2]		= {0};
	HMI_RECT_STR	new_clipe			= {0};
	HMI_COLOR_STR	color				= 0xffffffff;
	float_32		fxy					= 0.0f;
	U08				screen				= 0u;
	float_32		fxy_result[HMI_BEZIER_XY_SOLUTION_CNT]	= {0.0f};
	INT32			cnt_resoult			= 0;
	float_32		foffset				= 0.0f;
	INT32			i					= 0;
	INT32			half_point_cnt		= 0;
	BOOLEAN			bfind				= FALSE;
	POINT_FLOAT_TP	path_data_temp[HMI_LANE_LINE_POINT_NB]	={0.0f};
	UINT32			point_index			= 0;
	POINT_FLOAT_TP		*p_spline_point =NULL;	
	POINT_FLOAT_TP	center_bezier_begin	={0};
	POINT_FLOAT_TP	center_bezier_end	={0};
	UINT32			path_data_temp_index	= 0u;/*lq*/
	UINT32			p_road_index			= 0u;
	UINT32			path_data_temp_index2	= 0u;/*lq*/
	UINT32			p_road_index2			= 0u;
	
	if(hmi_loc_qd_unit < HMI_SCREEN_NO)
	{
		screen	= hmi_loc_qd_unit;
	}

	//test
	//offset	= 500;
	
	
	if((point_cnt >= 8/*8 ctrl point.2 bezier cure*/)&&
		(px != NULL) &&
		(py != NULL)&&
		(pscreen_target != NULL)&&
		(pclip_rect != NULL)&&		
		(p_road != NULL))
	{		
		half_point_cnt	= point_cnt / 2;
		
		/*get center bezier cure*/
		center_bezier_begin.x	= (float_32)((p_road[0].x + p_road[point_cnt - 1].x) / 2.0f); 
		center_bezier_begin.y	= (float_32)((p_road[0].y + p_road[point_cnt - 1].y) / 2.0f);

		/*get center bezier cure*/
		center_bezier_end.x		= (float_32)((p_road[half_point_cnt].x + p_road[point_cnt - 1 - half_point_cnt].x) / 2.0f); 
		center_bezier_end.y		= (float_32)((p_road[half_point_cnt].y + p_road[point_cnt - 1 - half_point_cnt].y) / 2.0f);
		if(offset < 0)
		{			
			if(center_bezier_begin.y > center_bezier_end.y)
			{
				foffset	= center_bezier_end.y - offset;
			}
			else
			{
				foffset	= center_bezier_begin.y - offset;
			}
		}
		else
		{
			if(center_bezier_begin.y > center_bezier_end.y)
			{
				foffset	= center_bezier_begin.y - offset;
			}
			else
			{
				foffset	= center_bezier_end.y - offset;
			}
		}
		if(foffset > 0.0f)
		{
			*py	= (INT32)(foffset + 0.5f);
		}
		else
		{
			*py	= (INT32)(foffset - 0.5f);
		}
		for(i = 0;((i + 3) < half_point_cnt) && (bfind == FALSE);i += 3)
		{
			/*get center bezier cure*/
			center_bezier[0].x	= (float_32)((p_road[i].x + p_road[point_cnt - 1 - i].x) / 2.0f); 
			center_bezier[0].y	= (float_32)((p_road[i].y + p_road[point_cnt - 1 - i].y) / 2.0f);
			
			center_bezier[1].x	= (float_32)((p_road[i + 1].x + p_road[point_cnt - 2 - i].x) / 2.0f);
			center_bezier[1].y	= (float_32)((p_road[i + 1].y + p_road[point_cnt - 2 - i].y) / 2.0f);
			
			center_bezier[2].x	= (float_32)((p_road[i + 2].x + p_road[point_cnt - 3 - i].x) / 2.0f);
			center_bezier[2].y	= (float_32)((p_road[i + 2].y + p_road[point_cnt - 3 - i].y) / 2.0f);
			
			center_bezier[3].x	= (float_32)((p_road[i + 3].x + p_road[point_cnt - 4 - i].x) / 2.0f);
			center_bezier[3].y	= (float_32)((p_road[i + 3].y + p_road[point_cnt - 4 - i].y) / 2.0f);
		
			if(center_bezier[0/*bezier begin*/].y > center_bezier[3/*bezier end*/].y)
			{
				if(( (*py) >= center_bezier[3/*bezier end*/].y) &&
					((*py) <= center_bezier[0/*bezier begin*/].y))
				{
					bfind	= TRUE;
				}
			}
			else
			{
				if(( (*py) >= center_bezier[0/*bezier begin*/].y) &&
					((*py) <= center_bezier[3/*bezier end*/].y))
				{
					bfind	= TRUE;
				}
			}
		}
		
		if(bfind	== TRUE)
		{
			cnt_resoult	= get_cublic_bezier_xy(center_bezier,
											4,
											foffset,
											FALSE/*get bezier y*/,
											fxy_result);
			if(cnt_resoult > 0)
			{
				/*only process 1 solution*/
				fxy		= fxy_result[0];
				if(fxy > 0.0f)
				{
					(*px)	= (INT32)(fxy + 0.5f);
				}
				else
				{
					(*px)	= (INT32)(fxy - 0.5f);
				}
			}
			else
			{
				if(center_bezier[0].x > 0.0f)
				{
					(*px)	= (INT32)(center_bezier[0].x + 0.5f);
				}
				else
				{
					(*px)	= (INT32)(center_bezier[0].x - 0.5f);
				}
			}
		}
		else
		{
			if(foffset > 0.0f)
			{
				*px	= (INT32)(center_bezier_end.x + 0.5f);
			}
			else
			{
				*px	= (INT32)(center_bezier_begin.x - 0.5f);
			}
		}
		
		get_path_bound_box_s32(p_road,
							point_cnt,
							bound_box);				
		offset_rect.x	= (HMI_X_STR)(bound_box[0].x);		
		offset_rect.y	= (HMI_Y_STR)(bound_box[0].y);
		offset_rect.w	= (HMI_WIDTH_STR)(bound_box[1].x - bound_box[0].x);
		offset_rect.h	= (HMI_HEIGHT_STR)(bound_box[1].y - bound_box[0].y);
		if(offset >= 0)
		{		
			if(ball_mask == TRUE)
			{
				offset	= HMI_LANE_MAX_OFFSET;
			}
			if(offset < offset_rect.h)
			{
				offset_rect.y	= offset_rect.y + offset_rect.h - offset;
				offset_rect.h	= offset;
			}			
		}
		else
		{
			offset		= -offset;
			if(ball_mask == TRUE)
			{
				offset	= HMI_LANE_MAX_OFFSET;
			}
			if(offset < offset_rect.h)
			{					
				offset_rect.y	= (HMI_Y_STR)(bound_box[0].y + offset);					
			}
			else
			{
				offset_rect.x	= (HMI_X_STR)(bound_box[0].x);		
				offset_rect.y	= (HMI_Y_STR)(bound_box[0].y + offset);
				offset_rect.w	= 0;
				offset_rect.h	= 0;
			}
		}
		/*screen coordinate*/
		offset_rect.x	+= pscreen_target->x;
		offset_rect.y	+= pscreen_target->y;
		hmi_get_union_rect(pclip_rect,&offset_rect,&new_clipe);
		p_spline_point =p_road;
		if(point_cnt == HMI_LANE_SLIOD_ZONE_LEN)/*14 point to 16 point*/
		{
			for(point_index = 0;point_index < 4;point_index ++)
			{
				path_data_temp_index	= 7-point_index;/*lq*/
				p_road_index			= HMI_LANE_SLIOD_ZONE_LEN-1-point_index;
				if((((INT32)p_road_index) < point_cnt) && (((INT32)path_data_temp_index) < HMI_LANE_LINE_POINT_NB))	/*lq*/
				{
					path_data_temp[point_index] = p_road[point_index];
					path_data_temp[path_data_temp_index/*7-point_index*/] = 
									p_road[p_road_index/*HMI_LANE_SLIOD_ZONE_LEN-1-point_index*/];
				}
			}
			for(point_index = 0;point_index < 4;point_index ++)
			{
				path_data_temp_index	= point_index+8;/*lq*/
				path_data_temp_index2	= HMI_LANE_LINE_POINT_NB-1-point_index;/*lq*/
				p_road_index			= point_index+3;
				p_road_index2			= HMI_LANE_SLIOD_ZONE_LEN-4-point_index;
				if((p_road_index < point_cnt) && (path_data_temp_index < HMI_LANE_LINE_POINT_NB)&&
					(p_road_index2 < point_cnt) && (path_data_temp_index2 < HMI_LANE_LINE_POINT_NB))	/*lq*/
				{
					path_data_temp[path_data_temp_index/*point_index+8*/] = p_road[p_road_index/*point_index+3*/];
					path_data_temp[path_data_temp_index2/*HMI_LANE_LINE_POINT_NB-1-point_index*/] = 
										p_road[p_road_index2/*HMI_LANE_SLIOD_ZONE_LEN-4-point_index*/];
				}
			}
			point_cnt = HMI_LANE_LINE_POINT_NB;
			p_spline_point = path_data_temp;
		}
		if((new_clipe.w > 0U)&&((new_clipe.h > 0U)))
		{
			for(point_index = 0;point_index + 8 <= point_cnt;point_index +=8)
			{
				hmi_draw_draw_cublic_bezier_zone(pscreen_target,
												&p_spline_point[point_index],
												8,//point_cnt,
												color,
												&new_clipe,
												1/*NO USED*/);
			}
		}
		
		success	= TRUE;
	}
	return	success;	
}


