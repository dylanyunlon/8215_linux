			hmi_set_qd_attributte(HMI_QD_DIS_MASK,FALSE);/*Clear mask flag*/			
			hmi_render_buffer_qd[HMI_MASK_HMI_RENDER_BUFFER].enable 		= FALSE;// 2020 08 13
		}
		
		/*draw car*/
		if((phmi_container_table != NULL)&&(clip_rect.w > 0)&&(clip_rect.h > 0))
		{
			hmi_number_object  = (phmi_container_table->container_object_table.object_number);
			
			if(hmi_number_object > HMI_CANE_CUSTOM_CHILD_CNT)
			{	
				index	= HMI_CANE_CUSTOM_CHILD_CNT;
				phmi_container_object_table = phmi_container_table->container_object_table.p_object_table;
				while(index < hmi_number_object)
				{
					
					target_id	= phmi_container_object_table[index].object_id;
					hmi_engine_get_object_prop(
									target_id,
									&target_attr);
					if((target_attr.w > 0)&&(target_attr.h > 0) &&(HMI_CANE_PATH_MAX_LEN >= 4/*rect point cnt*/))
					{
						lpath_data32[0].x = (float_32)(target_attr.x);
						lpath_data32[0].y = (float_32)(target_attr.y);
						lpath_data32[1].x = (float_32)(target_attr.x + target_attr.w - 1u);
						lpath_data32[1].y = (float_32)(target_attr.y);
						lpath_data32[2].x = (float_32)(target_attr.x + target_attr.w - 1u);
						lpath_data32[2].y = (float_32)(target_attr.y + target_attr.h - 1u);
						lpath_data32[3].x = (float_32)(target_attr.x);
						lpath_data32[3].y = (float_32)(target_attr.y + target_attr.h - 1u);
						lpath_data32_len = 4;
						
						
						if(project == 0/*project*/)
						{
							/*perspective bezier control point*/
							get_path_transform(&mvp_matrix,
										lpath_data32,
										lpath_data32_len,
										TRUE);
							matrix_load_identity(&view_matrix);		
						#ifdef HMI_SIMULATE_QD							
							/*pixel as unit*/
							matrix_scale(&view_matrix,
									(float_32)(hmi_screen_size[0].x / 2.0f),
									(float_32)(hmi_screen_size[0].y / 2.0f),
									1.0f);							
						#else
							/*pixel as unit*/								
							matrix_scale(&view_matrix,
									(float_32)(HMI_MAX_WIDTH / 2.0f),
									(float_32)(HMI_MAX_HEIGHT / 2.0f),
									1.0f);																						
						#endif
							get_path_transform(&view_matrix,
											lpath_data32,
											lpath_data32_len,
											FALSE);
						}
						else
						{
							/*ortho bezier control point*/
							get_path_transform(&mvp_matrix,
										lpath_data32,
										lpath_data32_len,
										FALSE/*ortho*/);								
						}
						/*custom left top point as coordinate origin*/
						matrix_load_identity(&view_matrix);							
						matrix_translate(&view_matrix,
							(float_32)(custom_object_prop.w / 2.0f),
							(float_32)(custom_object_prop.h / 2.0f),
							0.0f);
						get_path_transform(&view_matrix,
										lpath_data32,
										lpath_data32_len,
										FALSE);
						
						
						#if 0						
						target_area		= polygon_area_f(lpath_data32,lpath_data32_len);
						if(target_area < 0.0f)
						{
							target_area	= -target_area;
						}
						target_scale	= target_area / (target_attr.w * target_attr.h);
						#else
						target_scale = ((lpath_data32[1].x + lpath_data32[2].x+1) / 2.0f - (lpath_data32[0].x + lpath_data32[3].x+1) / 2.0f) 
										/ ((float_32)target_attr.w);      
						#endif
						if(pfather_alpha_scale != NULL)
						{
							if(target_attr.alpha > pfather_alpha_scale->alpha)
							{
								hmi_target_alpha_scale.alpha = pfather_alpha_scale->alpha;
							}
							else
							{
								hmi_target_alpha_scale.alpha = target_attr.alpha;
							}
							hmi_target_alpha_scale.scale = (float_32)(pfather_alpha_scale->scale * target_scale);
						}
						else
						{
							hmi_target_alpha_scale.alpha = HMI_OPAQUE;
							hmi_target_alpha_scale.scale = target_scale;
						}
						#if 0
						center_x		= (SINT32)((lpath_data32[0].x + lpath_data32[1].x + 
											lpath_data32[2].x + lpath_data32[3].x) / 4 + 0.5f);
						center_y		= (SINT32)((lpath_data32[0].y + lpath_data32[1].y + 
											lpath_data32[2].y + lpath_data32[3].y) / 4 + 0.5f);
						#else
						center_x		= (SINT32)((((lpath_data32[1].x + lpath_data32[2].x) / 2.0f) + 
											((lpath_data32[0].x + lpath_data32[3].x) / 2.0f))/2+ 0.5f);
						center_y		= (SINT32)((lpath_data32[0].y + lpath_data32[1].y + 
											lpath_data32[2].y + lpath_data32[3].y) / 4 + 0.5f);
						#endif
					#if 0
						dsp_rect.x		= (HMI_X_STR)(center_x - (target_attr.w / 2)*(hmi_target_alpha_scale.scale) +
													pcustom_farther_rect->x + custom_object_prop.x);
						dsp_rect.y		= (HMI_Y_STR)(center_y - (target_attr.h / 2)*(hmi_target_alpha_scale.scale) + 
													pcustom_farther_rect->y + custom_object_prop.y);
						dsp_rect.w		= (HMI_WIDTH_STR)(target_attr.w * hmi_target_alpha_scale.scale);
						dsp_rect.h		= (HMI_WIDTH_STR)(target_attr.h * hmi_target_alpha_scale.scale);
					#else
						dsp_rect.x		= (HMI_X_STR)(center_x - (target_attr.w / 2) +
													pcustom_farther_rect->x + custom_object_prop.x);
						dsp_rect.y		= (HMI_Y_STR)(center_y - (target_attr.h / 2) + 
													pcustom_farther_rect->y + custom_object_prop.y);
						dsp_rect.w		= (HMI_WIDTH_STR)(target_attr.w );
						dsp_rect.h		= (HMI_WIDTH_STR)(target_attr.h );
					#endif
						hmi_target_alpha_scale.point.x	= center_x + pcustom_farther_rect->x + custom_object_prop.x;
						hmi_target_alpha_scale.point.y	= center_y + pcustom_farther_rect->y + custom_object_prop.y;
							
						phmi_target_container_table		= hmi_engine_get_container_child_addr(target_id);
						if(phmi_target_container_table != NULL)	/*lq*/
						{
						#ifdef HMI_SIMULATE_QD
							hmi_engine_draw_container(phmi_target_container_table,
														(HMI_RECT_STR CONST *)&dsp_rect,
														pcustom_dirty_rect,
														custom_depth,
														target_id,
														pcustom_cliped_farther_rect														
													#if defined(HMI_GRAPHIC_RGL) ||defined(HMI_GRAPHIC_OPENGLES)||defined(HMI_GRAPHIC_VGLITE)||defined(HMI_GRAPHIC_OPENVG)||defined(S6J3200_GRAPHIC)																	
														,&hmi_target_alpha_scale
													#endif
														);

						#else
							hmi_engine_draw_container(phmi_target_container_table,
														(HMI_RECT_STR CONST *)&dsp_rect,
														pcustom_dirty_rect,
														custom_depth,
														pcustom_cliped_farther_rect														
													#if defined(HMI_GRAPHIC_RGL) ||defined(HMI_GRAPHIC_OPENGLES)||defined(HMI_GRAPHIC_VGLITE)||defined(HMI_GRAPHIC_OPENVG)||defined(S6J3200_GRAPHIC)																	
														,&hmi_target_alpha_scale
													#endif
														);
						#endif
						}																		
					}
					index++;
				}
			}
		}
	}
	#endif
}
/*draw road, draw road line, draw line light shadow */
void hmi_engine_draw_line(HMI_RECT_STR	*pscreen_target,	
							HMI_RECT_STR	*pdirty_rect,
							HMI_RECT_STR		*pclip_rect,
							U08					custom_depth,
							HMI_ALPHA_SCALE_PT_STR *pfather_alpha_scale,
							POINT_FLOAT_TP		*p_left_line,
							INT32				left_point_cnt,
							UINT32				left_line_color,
							POINT_FLOAT_TP		*p_right_line,
							INT32				right_point_cnt,
							UINT32				right_line_color,
							POINT_FLOAT_TP		*p_left_road_line,
							INT32				left_road_point_cnt,
							POINT_FLOAT_TP		*p_right_road_line,
							INT32				right_road_point_cnt,	
							HMI_OBJECT_ID_STR	road_texture_id,
							HMI_OBJECT_ID_STR	road_light_shadow_id,
							HMI_OBJECT_ID_STR	road_mask_id,
							HMI_WIDTH_STR		line_width,
							HMI_DRAW_LINE_TYPE  line_type)
{
	POINT_FLOAT_TP			path_data32_road[HMI_CANE_PATH_MAX_LEN]={0};
	POINT_FLOAT_TP			lpath_data32_road_min[HMI_LANE_LINE_POINT_NB]={0};
	POINT_FLOAT_TP			rpath_data32_road_min[HMI_LANE_LINE_POINT_NB]={0};
	HMI_ELEMENT_PROP_STR	road_container_attr 		= {0};
	HMI_ELEMENT_PROP_STR	road_container_shadow_attr	= {0};
	HMI_ELEMENT_PROP_STR	road_container_mask_attr	= {0};
	INT32					road_shadow_left_x			= 0;
	INT32					road_shadow_left_y			= 0;
	INT32					road_shadow_right_x 		= 0;
	INT32					road_shadow_right_y 		= 0;
	INT32					road_shadow_x				= 0;
	INT32					road_shadow_y				= 0;
	INT16					road_x						= 0;	
	GLuint					custom_texture				= 0;
	HMI_IMAGE_ATTR_STR		img_compress				= {0};
	HMI_BITMAP_STR			image_prop_info 			= {0};
	HMI_RECT_ALPHA_ANGEL_STR alpha_pos_angle			= {0,0,0,0,255,0};
	UINT16					point_index 				= 0;
	UINT16					road_index					= 0;
	HMI_RECT_STR			road_clip_rect				= {0};
	HMI_CONTAINER_STR CONST *phmi_road_table			= {0U}; 
	UINT16					path_data32_road_len		= 0u;
	UINT16					hmi_number_object		= 0U;
	HMI_RECT_STR			dsp_rect				={0};
	UINT8					left_line_alpha		= (U08)(left_line_color>> 24);
	UINT8					right_line_alpha	= (U08)(right_line_color>> 24);
	HMI_RECT_STR			road_draw_rect ={0};
	UINT16					half_right_road_point_cnt	= 0;
	UINT16					half_left_point_cnt			= 0;
	POINT_FLOAT_TP			path_data_temp[HMI_LANE_LINE_POINT_NB]={0};
	POINT_FLOAT_TP			*p_spline_point	= NULL;
	UINT32					road_line_index		= 0u;	/*lq*/
	INT32					left_temp_point_cnt		=HMI_LANE_LINE_POINT_NB;
	INT32					right_temp_point_cnt		=HMI_LANE_LINE_POINT_NB;
	/*Get mask buffer and clear*/
#if 0
	if(left_point_cnt == HMI_LANE_SLIOD_ZONE_LEN)
	{
		hmi_merge_bezier_curves(&p_left_line[0],7);  
		hmi_merge_bezier_curves(&p_left_line[7],7);
		p_left_line[4].x = p_left_line[7].x;
		p_left_line[4].y = p_left_line[7].y;
		p_left_line[5].x = p_left_line[8].x;
		p_left_line[5].y = p_left_line[8].y;
		p_left_line[6].x = p_left_line[9].x;
		p_left_line[6].y = p_left_line[9].y;
		p_left_line[7].x = p_left_line[10].x;
		p_left_line[7].y = p_left_line[10].y;
		left_point_cnt = 8;
	}
#endif
	if((p_left_line != NULL)&&
		(p_right_line != NULL)&&
		(p_left_road_line != NULL)&&
		(p_right_road_line != NULL))
	{
		if(road_texture_id != 0)
		{
			#if defined(HMI_SIMULATE_QD)
			hmi_switch_render_buffer(HMI_MASK_HMI_RENDER_BUFFER,
									hmi_screen_size[0].x,
									hmi_screen_size[0].y,
									GL_ALPHA,
									HMI_PHYSICAL_SCREEN_NO + HMI_MASK_HMI_RENDER_BUFFER);
			#else
			hmi_switch_render_buffer(HMI_MASK_HMI_RENDER_BUFFER,
									HMI_LAYER_0_MAX_W_LENGTH,
									HMI_LAYER_0_MAX_H_LENGTH,
									GL_RGBA,
									HMI_PHYSICAL_SCREEN_NO + HMI_MASK_HMI_RENDER_BUFFER);
			#endif

			/*draw to mask buffer*/		
			// not draw border
			#if defined(HMI_SIMULATE_QD)
			hmi_set_qd_attributte(HMI_QD_NO_ELEMENT_BORDER,
									FALSE);
			#endif
			/*Disable blend.just draw alpha*/
			hmi_set_qd_attributte(HMI_QD_NO_BLEND,FALSE);
			#if defined(HMI_SIMULATE_QD)
			//hmi_set_qd_attributte(HMI_QD_A8_FRMBUF,FALSE);
			#endif
			if((left_road_point_cnt >=0)&&
				(right_road_point_cnt >=0))
			{
				half_right_road_point_cnt	= right_road_point_cnt / 2;
				half_left_point_cnt			= left_road_point_cnt / 2;
					
				road_index = 0;
				/*CW zone*/
				for(point_index = 0u; point_index < half_right_road_point_cnt;point_index++)
				{
					road_line_index	= (UINT32)(right_road_point_cnt - 1u -  point_index);/*lq*/
					if((road_index < HMI_CANE_PATH_MAX_LEN)&&(road_line_index < (UINT32)right_road_point_cnt))	/*lq*/
					{
						path_data32_road [road_index].x = p_right_road_line[road_line_index/*right_road_point_cnt - 1u -  point_index*/].x;
						path_data32_road [road_index].y = p_right_road_line[road_line_index/*right_road_point_cnt - 1u - point_index*/].y;
						road_index++;
					}
				}
				for(point_index = 0u; point_index < half_left_point_cnt;point_index++)
				{
					road_line_index	= (UINT32)(half_left_point_cnt - 1u - point_index);/*lq*/
					if((road_index < HMI_CANE_PATH_MAX_LEN)&&(road_line_index < (UINT32)left_road_point_cnt))	/*lq*/
					{
						path_data32_road [road_index].x = p_left_road_line[road_line_index/*half_left_point_cnt - 1u - point_index*/].x;
						path_data32_road [road_index].y = p_left_road_line[road_line_index/*half_left_point_cnt - 1u - point_index*/].y;
						road_index++;
					}
				}
				path_data32_road_len = road_index;									
			}

			
			// road mask														
			hmi_draw_tri_road(pscreen_target,		
								pclip_rect,
								path_data32_road,
								path_data32_road_len,
								8000,
								&road_shadow_x,
								&road_shadow_y,
								FALSE);
		
			
		
			/*Enable blend*/
			hmi_set_qd_attributte(HMI_QD_NO_BLEND,TRUE);
#if defined(HMI_SIMULATE_QD)
			//hmi_set_qd_attributte(HMI_QD_A8_FRMBUF,TRUE);/*render is not A8*/
#else
			//hmi_set_qd_attributte(HMI_QD_A8_FRMBUF,TRUE);/*render is not A8*/
#endif
									
			hmi_set_qd_attributte(HMI_QD_NO_ELEMENT_BORDER,
									TRUE);
			/*active mask,mask texture to GPU*/ 				
			hmi_active_texture_device(HMI_TEXURE_UINT_FRMBUF,
								HMI_MASK_HMI_RENDER_BUFFER);
		
			/*switch to previous Render buffer*/				
			restory_previous_frambuffer(HMI_MASK_HMI_RENDER_BUFFER);
																					
		}
		
		/*draw road*/
		if(road_texture_id != 0)
		{	
			hmi_set_qd_attributte(HMI_QD_DIS_MASK,TRUE);/*SET mask flag*/
		#if HMI_DYN_CONTAINERS_NUMBER > 0
			if(HMI_IS_DYN_CONTAINER(road_texture_id))
			{
				road_texture_id  = HMI_GET_DYN_CONTAINERS_ID_INDEX(road_texture_id);
				hmi_engine_get_static_container_id(&road_texture_id);/*get static container ID*/	
			}
		#endif
			if((HMI_IS_DYN_XY_CONTAINER(road_texture_id))||(HMI_IS_CONTAINERS_SXY(road_texture_id)))
			{
				phmi_road_table	= hmi_engine_get_container_child_addr(road_texture_id);
				if(phmi_road_table != NULL)
				{
					hmi_number_object  = phmi_road_table->container_object_table.object_number;
				}
				if(hmi_number_object > 0u)/*draw mask*/
				{	
					if(road_mask_id == 0/*No mask container*/)
					{									
						// draw road
						hmi_engine_draw_container(phmi_road_table,
												(HMI_RECT_STR CONST *)(pclip_rect),//(pscreen_target),
												pdirty_rect,
												custom_depth,
								#if defined(HMI_SIMULATE_QD)
												road_texture_id,
								#endif
												pclip_rect/*all father insection zone*/
												,pfather_alpha_scale
												);									
					}
					else
					{
						custom_texture	= hmi_draw_container_render_buffer2(
												road_texture_id,
												pclip_rect->x,
												pclip_rect->y,																
												pclip_rect->w,
												pclip_rect->h);
					}
				}
			}
			hmi_set_qd_attributte(HMI_QD_DIS_MASK,FALSE);/*Clear mask flag*/
			/*mask not care by shader*/
			hmi_render_buffer_qd[HMI_MASK_HMI_RENDER_BUFFER].enable 		= FALSE;// 2020 08 13
		}
		
		/*draw line*/
		if((pclip_rect->w > 0)&&(pclip_rect->h > 0))
		{
			hmi_set_qd_attributte(HMI_QD_DIS_MASK,FALSE);/*SET mask flag*/
		#if defined(HMI_SIMULATE_QD) || defined(HMI_GRAPHIC_OPENGLES)
			if((left_line_alpha != 0)&&((line_type ==LINE_LEFT)||(line_type ==LINE_LEFT_RIGHT)))
			{		
				if(road_mask_id != 0/* mask container*/)
				{							
					hmi_switch_render_buffer2(HMI_CUBE_RENDER_BUFFER,
										0,//pscreen_target->w,
										0,//pscreen_target->h,
										GL_RGBA,
										HMI_PHYSICAL_SCREEN_NO + HMI_CUBE_RENDER_BUFFER);
					
					/*custom left top as coordinate*/
					dsp_rect.x	= 0;
					dsp_rect.y	= 0;
				}
				p_spline_point = p_left_line;
				if(left_point_cnt == HMI_LANE_SLIOD_ZONE_LEN)/*14 point to 16 point*/
				{
					for(point_index = 0;point_index < 4;point_index ++)
					{
						path_data_temp[point_index] = p_left_line[point_index];
						path_data_temp[7-point_index] = p_left_line[HMI_LANE_SLIOD_ZONE_LEN-1-point_index];
					}
					for(point_index = 0;point_index < 4;point_index ++)
					{
						path_data_temp[point_index+8] = p_left_line[point_index+3];
						path_data_temp[HMI_LANE_LINE_POINT_NB-1-point_index] = p_left_line[HMI_LANE_SLIOD_ZONE_LEN-4-point_index];
					}
					left_temp_point_cnt = HMI_LANE_LINE_POINT_NB;
					p_spline_point	= path_data_temp;
				}
				else
				{	
					left_temp_point_cnt = left_point_cnt;
				}
				for(point_index = 0;point_index < left_temp_point_cnt;point_index += 8/*2 cublic bezier ctrl cnt*/)
				{
					hmi_draw_draw_cublic_bezier_zone(pscreen_target,
												&p_spline_point[point_index],
												8/*2 cublic bezier ctrl cnt*/,
												left_line_color,
												pclip_rect,
												line_width);						
				}
				if(road_mask_id != 0/* mask container*/)
				{
					restory_previous_frambuffer(HMI_CUBE_RENDER_BUFFER);
				}
				
			}
			
			if((right_line_alpha != 0)&&((line_type ==LINE_RIGHT)||(line_type ==LINE_LEFT_RIGHT)))
			{		
				if(road_mask_id != 0/* mask container*/)
				{														
					hmi_switch_render_buffer2(HMI_CUBE_RENDER_BUFFER,
											0,//pscreen_target->w,
											0,//pscreen_target->h,
											GL_RGBA,
											HMI_PHYSICAL_SCREEN_NO + HMI_CUBE_RENDER_BUFFER);
					
					
					/*custom left top as coordinate*/
					dsp_rect.x	= 0;
					dsp_rect.y	= 0;
				}
				p_spline_point = p_right_line;
				if(right_point_cnt == HMI_LANE_SLIOD_ZONE_LEN)/*14 point to 16 point*/
				{
					for(point_index = 0;point_index < 4;point_index ++)
					{
						path_data_temp[point_index] = p_right_line[point_index];
						path_data_temp[7-point_index] = p_right_line[HMI_LANE_SLIOD_ZONE_LEN-1-point_index];
					}
					for(point_index = 0;point_index < 4;point_index ++)
					{
						path_data_temp[point_index+8] = p_right_line[point_index+3];
						path_data_temp[HMI_LANE_LINE_POINT_NB-1-point_index] = p_right_line[HMI_LANE_SLIOD_ZONE_LEN-4-point_index];
					}
					right_temp_point_cnt = HMI_LANE_LINE_POINT_NB;
					p_spline_point = path_data_temp;
				}
				else
				{	
					right_temp_point_cnt = right_point_cnt;
				}
				#if 1
				for(point_index = 0;point_index < right_temp_point_cnt;point_index += 8/*2 cublic bezier ctrl cnt*/)
				{								
					hmi_draw_draw_cublic_bezier_zone(pscreen_target,
												&p_spline_point[point_index],
												8/*2 cublic bezier ctrl cnt*/,
												right_line_color,
												pclip_rect,
												line_width);						
				}
				#endif
				
				if(road_mask_id != 0/* mask container*/)
				{
					restory_previous_frambuffer(HMI_CUBE_RENDER_BUFFER);
				}
				
			}												
		#else

		#endif
		}
		/*draw light shadow container*/
		if(road_light_shadow_id != 0)
		{
			#if defined(HMI_SIMULATE_QD)
			hmi_switch_render_buffer(HMI_MASK_HMI_RENDER_BUFFER,
									hmi_screen_size[0].x,
									hmi_screen_size[0].y,
									GL_ALPHA,
									HMI_PHYSICAL_SCREEN_NO + HMI_MASK_HMI_RENDER_BUFFER);
			#else
			hmi_switch_render_buffer(HMI_MASK_HMI_RENDER_BUFFER,
									HMI_LAYER_0_MAX_W_LENGTH,
									HMI_LAYER_0_MAX_H_LENGTH,
									GL_RGBA,
									HMI_PHYSICAL_SCREEN_NO + HMI_MASK_HMI_RENDER_BUFFER);
			#endif

			/*draw to mask buffer*/		
			// not draw border
			#if defined(HMI_SIMULATE_QD)
			hmi_set_qd_attributte(HMI_QD_NO_ELEMENT_BORDER,
									FALSE);
			#endif
			/*Disable blend.just draw alpha*/
			hmi_set_qd_attributte(HMI_QD_NO_BLEND,FALSE);
			#if defined(HMI_SIMULATE_QD)
			//hmi_set_qd_attributte(HMI_QD_A8_FRMBUF,FALSE);
			#endif
			hmi_engine_get_object_prop(road_light_shadow_id,
					&road_container_shadow_attr);						
			//left road line mask
			hmi_draw_tri_road(pscreen_target,		
							pclip_rect,
						p_left_line,
						left_point_cnt,
							road_container_shadow_attr.y,
							&road_shadow_left_x,
							&road_shadow_left_y,
							TRUE/*all mask*/);

			//right road line mask										
			hmi_draw_tri_road(pscreen_target,		
							pclip_rect,
						p_right_line,
						right_point_cnt,
							road_container_shadow_attr.y,
							&road_shadow_right_x,
							&road_shadow_right_y,
							TRUE/*all mask*/);

			/*Enable blend*/
			hmi_set_qd_attributte(HMI_QD_NO_BLEND,TRUE);
#if defined(HMI_SIMULATE_QD)
			//hmi_set_qd_attributte(HMI_QD_A8_FRMBUF,TRUE);/*render is not A8*/
#else
			//hmi_set_qd_attributte(HMI_QD_A8_FRMBUF,TRUE);/*render is not A8*/
#endif
									
			hmi_set_qd_attributte(HMI_QD_NO_ELEMENT_BORDER,
									TRUE);
			/*active mask,mask texture to GPU*/ 				
			hmi_active_texture_device(HMI_TEXURE_UINT_FRMBUF,
								HMI_MASK_HMI_RENDER_BUFFER);
		
			/*switch to previous Render buffer*/				
			restory_previous_frambuffer(HMI_MASK_HMI_RENDER_BUFFER);
																						
			hmi_set_qd_attributte(HMI_QD_DIS_MASK,TRUE);/*SET mask flag*/
			#if HMI_DYN_CONTAINERS_NUMBER > 0
			if(HMI_IS_DYN_CONTAINER(road_light_shadow_id))
			{
				road_light_shadow_id  = HMI_GET_DYN_CONTAINERS_ID_INDEX(road_light_shadow_id);
				hmi_engine_get_static_container_id(&road_light_shadow_id);/*get static container ID*/	
			}
			#endif
			if((HMI_IS_DYN_XY_CONTAINER(road_light_shadow_id))||(HMI_IS_CONTAINERS_SXY(road_light_shadow_id)))
			{
				phmi_road_table	= hmi_engine_get_container_child_addr(road_light_shadow_id);
				if(phmi_road_table != NULL)
				{
					hmi_number_object  = phmi_road_table->container_object_table.object_number;
					if(hmi_number_object > 0u)/*draw light shadow container*/
					{		
						dsp_rect.x		= (HMI_X_STR)(pscreen_target->x);
						dsp_rect.y		= (HMI_Y_STR)(pscreen_target->y);
						dsp_rect.x		+= (road_shadow_left_x - (road_container_shadow_attr.w >> 1u));
						dsp_rect.y		+= (road_shadow_left_y - (road_container_shadow_attr.h >> 1u));
						dsp_rect.w		= road_container_shadow_attr.w;
						dsp_rect.h		= road_container_shadow_attr.h;
						if(road_mask_id == 0/*No mask container*/)
						{											
							hmi_engine_draw_container(phmi_road_table,
												(HMI_RECT_STR CONST *)(&dsp_rect),
												pdirty_rect,
												custom_depth,
											#if defined(HMI_SIMULATE_QD)
												road_light_shadow_id,
											#endif
												pclip_rect/*all father insection zone*/
												,pfather_alpha_scale
												);
						}
						else
						{										
							/*draw cube render texture*/
							custom_texture	= hmi_draw_container_render_buffer2(
													road_light_shadow_id,
													dsp_rect.x,//(road_shadow_left_x - (road_container_shadow_attr.w >> 1)),
													dsp_rect.y,//(road_shadow_left_y - (road_container_shadow_attr.h >> 1)),
													pscreen_target->w,
													pscreen_target->h);
						}

						dsp_rect.x		= (HMI_X_STR)(pscreen_target->x);
						dsp_rect.y		= (HMI_Y_STR)(pscreen_target->y);
						
						dsp_rect.x		+= (road_shadow_right_x - (road_container_shadow_attr.w >> 1u));
						dsp_rect.y		+= (road_shadow_left_y/*road_shadow_right_y*/ - (road_container_shadow_attr.h >> 1u));
						
						dsp_rect.w		= road_container_shadow_attr.w;
						dsp_rect.h		= road_container_shadow_attr.h;
						if(road_mask_id == 0/*No mask container*/)
						{											
							hmi_engine_draw_container(phmi_road_table,
													(HMI_RECT_STR CONST *)(&dsp_rect),
													pdirty_rect,
													custom_depth,
												#if defined(HMI_SIMULATE_QD)
													road_light_shadow_id,
												#endif
													pclip_rect/*all father insection zone*/
													,pfather_alpha_scale
													);										
						}
						else
						{
							/*draw cube render texture*/
							custom_texture	= hmi_draw_container_render_buffer2(
													road_light_shadow_id,
													dsp_rect.x,//(road_shadow_right_x - (road_container_shadow_attr.w >> 1)),
													dsp_rect.y,//(road_shadow_right_y - (road_container_shadow_attr.h >> 1)),																
													pscreen_target->w,
													pscreen_target->h);
						}
					}
				}										
			}																	
		}
	}
	hmi_set_qd_attributte(HMI_QD_DIS_MASK,FALSE);/*Clear mask flag*/	
	/*mask not care by shader*/
	hmi_render_buffer_qd[HMI_MASK_HMI_RENDER_BUFFER].enable 		= FALSE;// 2020 08 13
}
