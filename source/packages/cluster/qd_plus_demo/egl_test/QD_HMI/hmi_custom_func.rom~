#define RANGE_SCROLL	100
void hmi_engine_draw_scroll(HMI_RECT_STR CONST	*pcustom_farther_rect,
										HMI_RECT_STR			*pcustom_dirty_rect,
										U08 					custom_depth,
										HMI_RECT_STR			*pcustom_cliped_farther_rect,
										HMI_OBJECT_ID_STR		custom_id,											
										HMI_ALPHA_SCALE_PT_STR *pfather_alpha_scale,
										void					*puser_data)
{
	BOOLEAN 				get_success 				= FALSE;	
	HMI_CUSTOM_PROP_STR 	custom_object_prop			= {0U};
	HMI_CUSTOM_P_INT		p1_player_program			= 0; 
	HMI_OBJECT_ID_STR		anim_image_id				= 0;
	HMI_RECT_STR			custom_rect 				= {0};
	HMI_RECT_STR			container_rect				= {0};
	HMI_RECT_STR			dsp_rect					= {0};
	UINT32					hmi_number_object			= 0u;
	HMI_CUSTOM_P_INT		disp_mode					= 0;	
	HMI_CONTAINER_STR CONST *phmi_container_table		= NULL; 
	HMI_OBJECT_PROP_STR CONST *phmi_container_object_table	= NULL;
	HMI_ELEMENT_PROP_STR	container_prop				= {0};
	HMI_ELEMENT_PROP2_STR	container_prop2 			= {0};
	UINT32					index						= 0;
	HMI_RECT_STR			new_cliped_farther_rect 	= {0};
	HMI_RECT_ALPHA_ANGEL_STR	mode_rect_alpha 		= {0};
	HMI_RECT_STR			scroll_rect_clip			= {0};
	HMI_RECT_STR			scroll_dsp_position 		= {0};
	if(custom_depth < HMI_TOUCH_ELEMENT_FLAG)
	{
		get_success = hmi_engine_get_custom_prop(custom_id,
										&custom_object_prop);
		if(get_success == TRUE)
		{	
			custom_rect.x		=  (HMI_X_STR)(pcustom_farther_rect->x + 
											custom_object_prop.x);	
			custom_rect.y		=  (HMI_Y_STR)(pcustom_farther_rect->y + 
											custom_object_prop.y);
			custom_rect.w		= custom_object_prop.w;
			custom_rect.h		= custom_object_prop.h;
			hmi_get_union_rect(&custom_rect,
						pcustom_cliped_farther_rect,
						&dsp_rect);
			if((dsp_rect.w > 0u)&&(dsp_rect.h > 0u))
			{
				/*p1*/
				if((custom_object_prop.attr & HMI_P1) != 0)
				{	
					if((custom_object_prop.attr & HMI_P1_F) != 0)
					{
						//p1_player_program 	= (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(custom_object_prop.p1));
					}
					else
					{
						p1_player_program		= (HMI_CUSTOM_P_INT)(custom_object_prop.p1);
					}			
				}
				if((custom_object_prop.attr & HMI_CON_P1) != 0)
				{
					if((custom_object_prop.attr & HMI_CON_F1) != 0)
					{
						//disp_mode = (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(custom_object_prop.const_p1));
					}
					else
					{
						disp_mode	= (HMI_CUSTOM_P_INT)(custom_object_prop.const_p1);					
					}
				}
				if(p1_player_program < 0)
				{
					p1_player_program	= 0;
				}
				if(p1_player_program > RANGE_SCROLL)
				{
					p1_player_program	= RANGE_SCROLL;
				}
				/*id1*/
				get_success = FALSE;
				if(p1_player_program != 0)
				{
				if((custom_object_prop.attr & HMI_ID1) != 0)
				{
					anim_image_id	= custom_object_prop.id1;						
#if HMI_DYN_CONTAINERS_NUMBER > 0
					if(HMI_IS_DYN_CONTAINER(anim_image_id))
					{
						anim_image_id  = HMI_GET_DYN_CONTAINERS_ID_INDEX(anim_image_id);
						hmi_engine_get_static_container_id(&anim_image_id);/*get static container ID*/	
					}
#endif
					scroll_rect_clip.x = custom_rect.x ;
					scroll_rect_clip.y = custom_rect.y ;
					scroll_rect_clip.w = custom_rect.w ;
					scroll_rect_clip.h = custom_rect.h ;
					if(disp_mode == 0)
					{
						scroll_rect_clip.w = (HMI_WIDTH_STR)(custom_rect.w * (((float_32)p1_player_program) / RANGE_SCROLL) + 0.5f);
					}
					else if(disp_mode == 1)
					{
						scroll_rect_clip.w -= (HMI_WIDTH_STR)(custom_rect.w * (((float_32)p1_player_program) / RANGE_SCROLL) + 0.5f);
					}
					else if(disp_mode == 2)
					{
						scroll_rect_clip.h = (HMI_WIDTH_STR)(custom_rect.h * (((float_32)p1_player_program) / RANGE_SCROLL) + 0.5f);
					}
					else if(disp_mode == 3)
					{
						scroll_rect_clip.h -= (HMI_WIDTH_STR)(custom_rect.h * (((float_32)p1_player_program) / RANGE_SCROLL) + 0.5f);
					}
					scroll_dsp_position.x	= 0;
					scroll_dsp_position.y	= 0;
					if((HMI_IS_S_XY_BITMAP(anim_image_id))||
						(HMI_IS_DYN_XY_BITMAP(anim_image_id)))
					{
							hmi_engine_get_object_prop(anim_image_id,
														&container_prop);
							hmi_engine_get_object_prop2(anim_image_id,
														&container_prop2);
							//scroll_dsp_position.x = container_prop.w;
							//scroll_dsp_position.y = container_prop.h;
							if(disp_mode == 0)
							{
								scroll_dsp_position.x	= container_prop.x;
								scroll_dsp_position.y	= container_prop.y;
								scroll_dsp_position.w	= scroll_rect_clip.w;
								scroll_dsp_position.h	= container_prop.h;
							}
							if(disp_mode == 1)
							{
								scroll_dsp_position.x	= container_prop.x + scroll_rect_clip.w;
								scroll_dsp_position.y	= container_prop.y;
								scroll_dsp_position.w	= container_prop.w - scroll_rect_clip.w;
								scroll_dsp_position.h	= container_prop.h;
							}
							if(disp_mode == 2)
							{
								scroll_dsp_position.x	= container_prop.x;
								scroll_dsp_position.y	= container_prop.y;
								scroll_dsp_position.w	= container_prop.w;
								scroll_dsp_position.h	= scroll_rect_clip.h;
							}	
							if(disp_mode == 3)
							{
								scroll_dsp_position.x	= container_prop.x;
								scroll_dsp_position.y	= container_prop.y + scroll_rect_clip.h;
								scroll_dsp_position.w	= container_prop.w;
								scroll_dsp_position.h	= container_prop.h - scroll_rect_clip.h;
							}
							mode_rect_alpha.alpha = container_prop.alpha;
							mode_rect_alpha.angel = container_prop.angle;
							hmi_get_union_rect(&scroll_rect_clip,
											&dsp_rect,
											&new_cliped_farther_rect);
							HMI_GET_OBJECT_SCREEN_COOR(pcustom_farther_rect,(&scroll_dsp_position),(&scroll_dsp_position));
							HMI_GET_OBJECT_SCREEN_COOR(pcustom_farther_rect,(&new_cliped_farther_rect),(&new_cliped_farther_rect));
							call_C_hmi_driver_draw_image((HMI_RECT_STR CONST	*)(&scroll_dsp_position),
														container_prop2.img_compress,
														&mode_rect_alpha,
														container_prop2.pimage_prop_info,
														&new_cliped_farther_rect,
														pcustom_dirty_rect,
														0,
														NULL,
														anim_image_id,
														pfather_alpha_scale);
					}
					else if((HMI_IS_CONTAINERS_SXY(anim_image_id))||
							(HMI_IS_DYN_XY_CONTAINER(anim_image_id)))
					{
						hmi_engine_get_object_prop(anim_image_id,
													&container_prop);
						//scroll_dsp_position.w = container_prop.w;
						//scroll_dsp_position.h = container_prop.h;
						if(disp_mode == 0)
						{
							scroll_dsp_position.x	= container_prop.x;
							scroll_dsp_position.y	= container_prop.y;
							scroll_dsp_position.w	= scroll_rect_clip.w;
							scroll_dsp_position.h	= container_prop.h;
						}
						if(disp_mode == 1)
						{
							scroll_dsp_position.x	= container_prop.x + scroll_rect_clip.w;
							scroll_dsp_position.y	= container_prop.y;
							scroll_dsp_position.w	= container_prop.w - scroll_rect_clip.w;
							scroll_dsp_position.h	= container_prop.h;
						}
						if(disp_mode == 2)
						{
							scroll_dsp_position.x	= container_prop.x;
							scroll_dsp_position.y	= container_prop.y;
							scroll_dsp_position.w	= container_prop.w;
							scroll_dsp_position.h	= scroll_rect_clip.h;
						}	
						if(disp_mode == 3)
						{
							scroll_dsp_position.x	= container_prop.x;
							scroll_dsp_position.y	= container_prop.y + scroll_rect_clip.h;
							scroll_dsp_position.w	= container_prop.w;
							scroll_dsp_position.h	= container_prop.h - scroll_rect_clip.h;
						}
						phmi_container_table	= hmi_engine_get_container_child_addr(anim_image_id);
						HMI_GET_OBJECT_SCREEN_COOR(pcustom_farther_rect,(&scroll_dsp_position),(&scroll_dsp_position));
						if(phmi_container_table != NULL)
						{											
							//hmi_get_union_rect(&scroll_rect_clip,
							//				&dsp_rect,
							//				&new_cliped_farther_rect);
							hmi_get_union_rect(&dsp_rect,
											&scroll_dsp_position,
											&new_cliped_farther_rect);
							HMI_GET_OBJECT_SCREEN_COOR(pcustom_farther_rect,(&new_cliped_farther_rect),(&new_cliped_farther_rect));
							/*convert screen coordinate*/
							hmi_engine_draw_container(phmi_container_table,
											(HMI_RECT_STR CONST *)(&(custom_rect)),
											pcustom_dirty_rect,
											custom_depth,
											&new_cliped_farther_rect/*all father insection zone*/
											,pfather_alpha_scale
											);
						}
					}
				}		
			}
			else
			{}
		}																
		}
	}
}
