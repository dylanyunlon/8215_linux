		seg_no			= pbitmap_data->seg_no;
		fmt_index		= pbitmap_data->fmt_index;
		index			= pbitmap_data->index;

		if(pbitmap_data->w != 0u)
		{
			cur_texture_seg		= hmi_cur_texture.seg_no == seg_no;
			cur_texture_fmt		= hmi_cur_texture.fmt_index == fmt_index;
