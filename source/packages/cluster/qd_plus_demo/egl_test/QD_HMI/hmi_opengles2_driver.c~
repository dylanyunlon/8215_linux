	GLuint							texture_id			= 0;	
	TEXTURE_2D_PIXEL_FORMAT			pixel_fmt			= TEXTURE_2D_PIXEL_FORMAT_RGBA8888;
	BYTE							*pbuffer			= NULL;	
	U32								decode_image_len	= 0U;	
	UINT32							seg_no				= 0U;											
	HMI_BIG_IMAGE_INDEX_STR			fmt_index			= HMI_MAX_CNT_BIG_IMAGE;
	UINT32							index				= 0U;
	BOOLEAN							success				= FALSE;
	BOOLEAN							cur_texture_seg		= FALSE;
	BOOLEAN							cur_texture_fmt		= FALSE;
	BOOLEAN							cur_texture_index	= FALSE;
	BOOLEAN							cur_texture			= FALSE;	
	HMI_FMT_ADDR_STR		CONST	*pfmt_addr			= NULL;
	HMI_FMT_ADDR_STR				*pfmt_addr_buf		= NULL;
	U16								w					= 0U;
	U16								h					= 0U;
	UINT32							cnt					= 0U;
	UINT32							img_len				= 0U;
	HMI_BIG_IMAGE_ADDR_STR	CONST	*pbitmap_data		= NULL;
	HMI_FMT_BIG_IMAGE_BUFFER_STR	*pbig_image_buf		= NULL;
	HMI_FMT_BIG_IMAGE_STR 	CONST	*pbig_image			= NULL;
	
	
