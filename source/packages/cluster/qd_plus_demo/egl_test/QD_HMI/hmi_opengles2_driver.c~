BOOLEAN hmi_float_vertex_equal(POINT_FLOAT_3D_TP *pvertex1,
							POINT_FLOAT_3D_TP *pvertex2)
{
	BOOLEAN			equal				= FALSE;
	BOOLEAN			equal_x				= FALSE;
	BOOLEAN			equal_y				= FALSE;
	BOOLEAN			equal_z				= FALSE;
	POINT_FLOAT_3D_TP	vertex_sub			= {0.0f,0.0f,0.0f};
	
	if((pvertex1 != NULL)&&(pvertex2 != NULL))
	{
		vertex_sub.x	= (pvertex1->x) - (pvertex2->x);
		vertex_sub.y	= (pvertex1->y) - (pvertex2->y);
		vertex_sub.z	= (pvertex1->z) - (pvertex2->z);

		equal_x	= (vertex_sub.x < HMI_FLOAT_TOLERANCE)&&(vertex_sub.x > (-HMI_FLOAT_TOLERANCE));
		equal_y	= (vertex_sub.y < HMI_FLOAT_TOLERANCE)&&(vertex_sub.y > (-HMI_FLOAT_TOLERANCE));
		equal_z	= (vertex_sub.z < HMI_FLOAT_TOLERANCE)&&(vertex_sub.z > (-HMI_FLOAT_TOLERANCE));

		equal	= equal_x && equal_y && equal_z;
	}
		
	return equal;
}

/*
angle(-360,360)
*/
BOOLEAN hmi_get_rotation_poly_n90(POINT32_TP	vertex[],
								POINT_FLOAT_TP	vertex_rotation[],
								U16		vertex_cnt,
								float_32	angle)
{
	BOOLEAN			success			= FALSE;			
	float_32				cosA			= 0.0f;
	float_32				sinA				= 0.0f;	
	U16					loop				= 0U;
	INT32				angle_int			= 0;
	BOOLEAN			need_rotation		= FALSE;
	
	if(vertex_cnt > 0U)	
	{	
		#if 0
		if(fabs(angle) >= 360.0f)
		{
			angle_int	= (INT32)angle;
			angle	= angle % 360;
		}
		#endif
		
		if(angle < 0.0f)
		{
			angle	= 360.0f + angle;
		}
		
		need_rotation	= fabs(angle) > HMI_FLOAT_TOLERANCE;
		if(need_rotation == TRUE)
		{					
			if((angle < (90.0f + HMI_FLOAT_TOLERANCE))&&
				(angle > (90.0f - HMI_FLOAT_TOLERANCE)))
			{
				cosA		= 0.0f;
				sinA		= 1.0f;
			}
			else if((angle < (180.0f + HMI_FLOAT_TOLERANCE))&&
				(angle > (180.0f - HMI_FLOAT_TOLERANCE)))
			{
				cosA		= -1.0f;
				sinA		= 0.0f;
			}
			else if((angle < (270.0f + HMI_FLOAT_TOLERANCE))&&
				(angle > (270.0f - HMI_FLOAT_TOLERANCE)))
			{
				cosA		= 0.0f;
				sinA		= -1.0f;
			}
			else /*angel == 0*/
			{
				cosA		= 1.0f;
				sinA		= 0.0f;
			}
			
			for(loop = 0U;loop < vertex_cnt;loop++)
			{
				vertex_rotation[loop].x	= (float_32)(vertex[loop].x * cosA - 
												vertex[loop].y * sinA );
				vertex_rotation[loop].y	= (float_32)(vertex[loop].x * sinA + 
												vertex[loop].y * cosA);				
			}													
		}
		else
		{
			for(loop = 0U;loop < vertex_cnt;loop++)
			{
				vertex_rotation[loop].x	= (float_32)(vertex[loop].x);
				vertex_rotation[loop].y	= (float_32)(vertex[loop].y);				
			}	
		}
		success	= TRUE;
	}
	
	return success;
}

