									((phmi_text_copy_rect->text_rect.w) >> 0x01));
				/*Get center align x position*/
				hmi_print_start_x	-= (hmi_cur_print_width>>0x01);
				/*modify align x position for scroll offset*/
				#if HMI_SCROLL_TEXT_SUPPORT != 0U
				hmi_print_start_x	-= hmi_scroll_offset;/*hmi_scroll_offset >0,scroll to left*/
				#endif
				
				#else
				if(hmi_cur_print_width >= (phmi_text_copy_rect->text_rect.w))
				{
					if(hmi_font_align ==HMI_ALIGN_RIGHT)
					{
						/*Get right align x position*/
						hmi_print_start_x	= phmi_text_copy_rect->text_rect.x+
												(phmi_text_copy_rect->text_rect.w - hmi_cur_print_width);
						/*modify align x position for scroll offset*/
						#if HMI_SCROLL_TEXT_SUPPORT != 0U
						hmi_print_start_x	+= hmi_scroll_offset;/*hmi_scroll_offset >0,scroll to right*/
						#endif
					}
					else
					{
						/*get left align x position*/
						hmi_print_start_x	= phmi_text_copy_rect->text_rect.x - 
										hmi_scroll_offset;	/*hmi_scroll_offset >0,scroll to left*/ 	
					}
				}
				else
				{
					/*get text zone center*/
					hmi_print_start_x	= (phmi_text_copy_rect->text_rect.x + 
										((phmi_text_copy_rect->text_rect.w) >> 0x01));
					/*Get center align x position*/
					hmi_print_start_x	-= (hmi_cur_print_width>>0x01);
					/*modify align x position for scroll offset*/
					#if HMI_SCROLL_TEXT_SUPPORT != 0U
					//hmi_print_start_x -= hmi_scroll_offset;/*hmi_scroll_offset >0,scroll to left*/
					#endif	
				}
				#endif
			}
			else
			{
			}
			
			hmi_end_print_pixel = (phmi_text_copy_rect->text_rect.x +
										phmi_text_copy_rect->text_rect.w);
			hmi_string_actual_index	= index_start;
			if((hmi_cycle_flag)&&((phmi_text_prop_info->properties & HMI_TEXT_PROP_SCROLABLE) != 0U))
			{
				hmi_string_actual_index=index_start;
			}
			else
			{
				/*jump the character which at text 'jump zone'*/
				if(phmi_text_copy_rect->text_rect.x > hmi_print_start_x)
				{
					hmi_copy_x2text_left	= phmi_text_copy_rect->text_rect.x -
												hmi_print_start_x;
				}
				/*get new hmi_string_actual_index and new hmi_copy_start_x*/
				if(hmi_copy_x2text_left > 0)
				{
					index	= index_start;
					while((ptext_string[index] != '\0')&&
						(hmi_copy_x2text_left > 0)&&(index < index_end))
					{
						/*get current character display width*/
						hmi_code_char_len	= 0U;
						hmi_char			= hmi_get_value_char(ptext_string[index],
																ptext_string[index+1],
																&hmi_code_char_len);
						phmi_font_config	= hmi_driver_get_char_data(hmi_char, 
																phmi_font_table, 
																phmi_text_prop_info->font_id);
						if(phmi_font_config !=NULL)
						{
							#if (HMI_TEXT_SCALE_ENABLE==HMI_YES)
							if(scale == TRUE)
							{
								hmi_one_char_width	= (phmi_font_config->owidth)*scale_factor + HMI_CHAR_SPACE;
							}
							else
							{
								hmi_one_char_width	= phmi_font_config->owidth + HMI_CHAR_SPACE;
							}
							#else
							hmi_one_char_width	= phmi_font_config->owidth + HMI_CHAR_SPACE;
							#endif
							
							/*get actual string index*/
							if(hmi_copy_x2text_left > hmi_one_char_width)
							{
								hmi_copy_x2text_left	-= hmi_one_char_width;
								hmi_print_start_x		+= hmi_one_char_width;
							}
							else
							{
								/*set finished flag*/
								hmi_copy_x2text_left	= 0U;
								/*set new string index*/
								hmi_string_actual_index = index;
							}
						}
						index				+= hmi_code_char_len;
						index++;
					}
				}
			}
			
			#ifdef HMI_CLIP_TEXT
			/*Get clip string length*/
			index	= 0U;
			if((phmi_text_prop_info->properties & HMI_TEXT_PROP_SCROLABLE) != 0U)
			{
					hmi_clip_string_width	= 0U;
			}
			else
			{
				while(phmi_clip_char[index] != '\0')
				{
					hmi_code_char_len		= 0U;
					hmi_char			= hmi_get_value_char(phmi_clip_char[index],phmi_clip_char[index+1],&hmi_code_char_len);
					phmi_font_config	= hmi_driver_get_char_data(hmi_char, phmi_font_table, phmi_text_prop_info->font_id);

					if(phmi_font_config !=NULL)
					{
						#if (HMI_TEXT_SCALE_ENABLE==HMI_YES)
						if(scale == TRUE)
						{
							hmi_clip_string_width	+= (phmi_font_config->owidth)*scale_factor + HMI_CHAR_SPACE;
						}
						else
						{
							hmi_clip_string_width	+= phmi_font_config->owidth+HMI_CHAR_SPACE;
						}
						#else
						hmi_clip_string_width	+= phmi_font_config->owidth+HMI_CHAR_SPACE;
						#endif
					}
					index	+= hmi_code_char_len;
					index++;
				}
			}
			#endif
			/*print string from hmi_string_actual_index 
				at hmi_copy_start_x position*/
			if(hmi_clip_string_width > 0U)
			{
				hmi_exist_clip_char	= TRUE;
				hmi_cycle_flag		= 0U;
			}

			if(hmi_cur_print_width <= phmi_text_copy_rect->text_rect.w)
			{
				hmi_exist_clip_char		= FALSE;
				hmi_clip_string_width	= 0U;
			}
			
			while((ptext_string[hmi_string_actual_index] != '\0')&& 
				(!hmi_dis_zone_full)&&
				(hmi_string_actual_index	< index_end))
			{
				#if HMI_FARSI_ENABLE	== HMI_NO
				hmi_char			= hmi_get_value_char(ptext_string[hmi_string_actual_index],
														ptext_string[hmi_string_actual_index+1],
														&hmi_code_char_len);
				#else
				hmi_char			= ptext_string[hmi_string_actual_index];
				#endif
					
				phmi_font_config	= hmi_driver_get_char_data(hmi_char, 
														phmi_font_table, 
														phmi_text_prop_info->font_id);
				if(phmi_font_config != NULL)
				{
					#if (HMI_TEXT_SCALE_ENABLE == HMI_YES)
					if(scale == TRUE)
					{
						text_print_rect.w		= phmi_font_config->w*scale_factor;
						text_print_rect.h		= phmi_font_config->h*scale_factor;
					}
					else
					{
						text_print_rect.w		= phmi_font_config->w;
						text_print_rect.h		= phmi_font_config->h;
					}
					#else
					text_print_rect.w		= phmi_font_config->w;
					text_print_rect.h		= phmi_font_config->h;
					#endif
					hmi_cur_print_clip_width	= hmi_print_start_x +hmi_clip_string_width;
					if(hmi_cur_print_clip_width <= hmi_end_print_pixel)
					{	
						if((hmi_cycle_flag)&&((phmi_text_prop_info->properties & HMI_TEXT_PROP_SCROLABLE) != 0U))
						{
							hmi_dis_zone_full	= FALSE;
						}
						else
						{
							#if (HMI_TEXT_SCALE_ENABLE==HMI_YES)
							if(scale == TRUE)
							{
								hmi_cur_char_width = (phmi_font_config->owidth)*scale_factor + HMI_CHAR_SPACE;
							}
							else
							{
								hmi_cur_char_width = phmi_font_config->owidth + HMI_CHAR_SPACE;
							}
							#else
							hmi_cur_char_width = phmi_font_config->owidth + HMI_CHAR_SPACE;
							#endif
							if((hmi_cur_print_clip_width + hmi_cur_char_width) > hmi_end_print_pixel)
							{
								hmi_dis_zone_full	= TRUE;
							}
						}
					}
					else
					{
						if((hmi_cycle_flag)&&((phmi_text_prop_info->properties & HMI_TEXT_PROP_SCROLABLE) != 0U))
						{
							hmi_dis_zone_full	= FALSE;
						}
						else
						{
							hmi_dis_zone_full	= TRUE;
						}
					}
					
					if((!hmi_exist_clip_char)||(hmi_exist_clip_char&&(!hmi_dis_zone_full)))
					{
						/*display character rect*/
						#if (HMI_TEXT_SCALE_ENABLE == HMI_YES)
						if(scale == TRUE)
						{
							text_print_rect.x		= hmi_print_start_x +(phmi_font_config->x_soffset*scale_factor);
							text_print_rect.y		= (phmi_text_copy_rect->text_rect.y + 
														phmi_font_config->y_soffset*scale_factor);
						}
						else
						{
							text_print_rect.x		= hmi_print_start_x +phmi_font_config->x_soffset;
							text_print_rect.y		= (phmi_text_copy_rect->text_rect.y + 
													phmi_font_config->y_soffset);
						}
						#else
						text_print_rect.x		= hmi_print_start_x +phmi_font_config->x_soffset;
						text_print_rect.y		= (phmi_text_copy_rect->text_rect.y + 
													phmi_font_config->y_soffset);
						#endif
						/*copy character data info*/
						text_data.w 			= phmi_font_config->w;
						text_data.h 			= phmi_font_config->h;
						text_data.pbitmap_data	= phmi_font_config->char_data;
						/*text rect intersection with pclip_rect rect*/ 						
						hmi_get_union_rect(&text_print_rect/*&(phmi_text_copy_rect->text_rect)*/,
												pclip_rect,
												&final_clip_rect);
						
						if((hmi_cycle_flag)&&((phmi_text_prop_info->properties & HMI_TEXT_PROP_SCROLABLE) != 0U))
						{
							
							if((final_clip_rect.x ==HMI_INVALID_COOR) &&(final_clip_rect.y ==HMI_INVALID_COOR))
							{
								if(HMI_TEXT_PROP_ALIGN_IS_LEFT(phmi_text_prop_info->properties))
								{
									text_print_rect.x +=hmi_cur_print_width+HMI_TEXT_CYCLE_RANGE*hmi_cycle_step;
								}
								else if(HMI_TEXT_PROP_ALIGN_IS_RIGHT(phmi_text_prop_info->properties))
								{
									text_print_rect.x  -=hmi_cur_print_width+HMI_TEXT_CYCLE_RANGE*hmi_cycle_step;
								}
								else if(HMI_TEXT_PROP_ALIGN_IS_CENTRE(phmi_text_prop_info->properties))
								{
									#if(HMI_TEXT_ALIGN_CENTER_SCROLL==HMI_YES)
									text_print_rect.x +=hmi_cur_print_width+HMI_TEXT_CYCLE_RANGE*hmi_cycle_step;
									#else
									if(hmi_cur_print_width >= (phmi_text_copy_rect->text_rect.w))
									{
										if(hmi_font_align ==HMI_ALIGN_RIGHT)
										{
											text_print_rect.x  -=hmi_cur_print_width+HMI_TEXT_CYCLE_RANGE*hmi_cycle_step;
										}
										else
										{
											text_print_rect.x +=hmi_cur_print_width+HMI_TEXT_CYCLE_RANGE*hmi_cycle_step;
										}
									}
									else
									{
									}
									#endif
								}
								
								/*text rect intersection with pclip_rect rect*/ 						
								hmi_get_union_rect(&text_print_rect/*&(phmi_text_copy_rect->text_rect)*/,
														pclip_rect,
														&final_clip_rect);

							}
						}
						if(hmi_string_actual_index==0)
						{
							#if (HMI_TEXT_SCALE_ENABLE == HMI_YES)
							if(scale == TRUE)
							{
								hmi_cycle_firt_char_x		= text_print_rect.x-(phmi_font_config->x_soffset*scale_factor);
							}
							else
							{
								hmi_cycle_firt_char_x		= text_print_rect.x-phmi_font_config->x_soffset;
							}
							#else
							hmi_cycle_firt_char_x			= text_print_rect.x-phmi_font_config->x_soffset;
							#endif
						}
						if((final_clip_rect.w !=0) &&(final_clip_rect.h !=0))
						{
							hmi_driver_copy_image(&text_print_rect,
													&text_data,
													font_format,
													hmi_text_color,
													&final_clip_rect,
													pdirty_rect,
													hmi_trans_color,
													layer
													#ifdef	HMI_GRAPHIC_RGL
													,father_alpha
													,font_id
													,hmi_char
													#endif
													);
						}
						
						#if (HMI_TEXT_SCALE_ENABLE == HMI_YES)
						if(scale == TRUE)
						{
							hmi_print_start_x		+= (phmi_font_config->owidth*scale_factor)+HMI_CHAR_SPACE;
						}
						else
						{
							hmi_print_start_x		+= (phmi_font_config->owidth+HMI_CHAR_SPACE);
						}
						#else
						hmi_print_start_x		+= (phmi_font_config->owidth+HMI_CHAR_SPACE);
						#endif
					}
					
				}
				hmi_string_actual_index ++;
				hmi_string_actual_index += hmi_code_char_len;
			}
			
			/*display clip char */
			#ifdef HMI_CLIP_TEXT
			if((hmi_dis_zone_full) &&(hmi_exist_clip_char))
			{
				index			= 0;				
				while((phmi_clip_char[index]!= '\0')&& 
					(hmi_print_start_x < hmi_end_print_pixel))
				{
					hmi_code_char_len		= 0U;
					hmi_char			= hmi_get_value_char(phmi_clip_char[index],
															phmi_clip_char[index+1],
															&hmi_code_char_len);
					phmi_font_config	= hmi_driver_get_char_data(hmi_char, 
															phmi_font_table, 
															phmi_text_prop_info->font_id);
					if(phmi_font_config != NULL)
					{
						/*if(hmi_cur_print_width <= 
							phmi_text_copy_rect->text_rect.w)*/
						{
							#if (HMI_TEXT_SCALE_ENABLE == HMI_YES)
							if(scale == TRUE)
							{
								text_print_rect.w		= phmi_font_config->w*scale_factor;
								text_print_rect.h		= phmi_font_config->h*scale_factor;
							}
							else
							{
								text_print_rect.w		= phmi_font_config->w;
								text_print_rect.h		= phmi_font_config->h;
							}
							#else
							text_print_rect.w		= phmi_font_config->w;
							text_print_rect.h		= phmi_font_config->h;
							#endif
							/*display character rect*/
							#if (HMI_TEXT_SCALE_ENABLE == HMI_YES)
							text_print_rect.x		= hmi_print_start_x+phmi_font_config->x_soffset*scale_factor;
							#else
							text_print_rect.x		= hmi_print_start_x+phmi_font_config->x_soffset;
							#endif
							text_print_rect.y		= (phmi_text_copy_rect->text_rect.y + 
														phmi_font_config->y_soffset);
							
							/*copy character data info*/
							text_data.w 			= phmi_font_config->w;
							text_data.h 			= phmi_font_config->h;
							text_data.pbitmap_data	= phmi_font_config->char_data;
							/*text rect intersection with pclip_rect rect*/ 						
							hmi_get_union_rect(&text_print_rect/*(phmi_text_copy_rect->text_rect)*/,
													pclip_rect,
													&final_clip_rect);														
							if((final_clip_rect.w != 0U) &&(final_clip_rect.h != 0U))
							{							
								hmi_driver_copy_image(&text_print_rect,
														&text_data,
														font_format,
														hmi_text_color,
														&final_clip_rect,
														pdirty_rect,
														hmi_trans_color,
														layer
														#ifdef	HMI_GRAPHIC_RGL
														,father_alpha
														,font_id
														,hmi_char
														#endif
														);
							}
							#if (HMI_TEXT_SCALE_ENABLE == HMI_YES)
							if(scale == TRUE)
							{
								hmi_print_start_x	+= (phmi_font_config->owidth*scale_factor)+HMI_CHAR_SPACE;
							}
							else
							{
								hmi_print_start_x	+= (phmi_font_config->owidth+HMI_CHAR_SPACE);
							}
							#else
							hmi_print_start_x	+= (phmi_font_config->owidth+HMI_CHAR_SPACE);
							#endif
						}
					}
					index++;
					index += hmi_code_char_len;
				}
			}
			#endif

			#if  HMI_SCROLL_TEXT_SUPPORT != 0U
			if((phmi_text_prop_info->properties & HMI_TEXT_PROP_SCROLABLE) != 0U)
			{
				if(hmi_scroll_offset < 0)
				{
					hmi_scroll_offset = -hmi_scroll_offset;
				}
				if(hmi_scroll_offset >= hmi_cur_print_width)
				{
					if(hmi_cycle_flag)
					{
						if(HMI_TEXT_PROP_ALIGN_IS_LEFT(phmi_text_prop_info->properties))
						{
							hmi_scroll_offset	=phmi_text_copy_rect->text_rect.x - hmi_cycle_firt_char_x;
						}
						else if(HMI_TEXT_PROP_ALIGN_IS_RIGHT(phmi_text_prop_info->properties))
						{
							hmi_scroll_offset	=hmi_cycle_firt_char_x-(phmi_text_copy_rect->text_rect.x+
												(phmi_text_copy_rect->text_rect.w - 
												hmi_cur_print_width));
						}
						else if(HMI_TEXT_PROP_ALIGN_IS_CENTRE(phmi_text_prop_info->properties))
						{
							hmi_print_start_x	= (phmi_text_copy_rect->text_rect.x + 
													((phmi_text_copy_rect->text_rect.w) >> 0x01));
							/*Get center align x position*/
							hmi_print_start_x	-= (hmi_cur_print_width>>0x01);
							#if(HMI_TEXT_ALIGN_CENTER_SCROLL==HMI_YES)
							hmi_scroll_offset	=hmi_print_start_x - hmi_cycle_firt_char_x;
							#else
							if(hmi_cur_print_width >= (phmi_text_copy_rect->text_rect.w))
							{
								if(hmi_font_align ==HMI_ALIGN_RIGHT)
								{
									hmi_scroll_offset	=hmi_cycle_firt_char_x-(phmi_text_copy_rect->text_rect.x+
												(phmi_text_copy_rect->text_rect.w - 
												hmi_cur_print_width));
								}
								else
								{
									hmi_scroll_offset	=phmi_text_copy_rect->text_rect.x - hmi_cycle_firt_char_x;
								}
							}
							else
							{
							}
							#endif
						}
								
						if(hmi_scroll_offset <0)
						{
							hmi_scroll_offset=-hmi_scroll_offset;
							hmi_scroll_step=HMI_SET_SCROLL_STEP_VALUE(1,hmi_cycle_flag,hmi_cycle_step,hmi_scroll_offset);
						}
						else
						{
							hmi_scroll_step=HMI_SET_SCROLL_STEP_VALUE(0,hmi_cycle_flag,hmi_cycle_step,hmi_scroll_offset);
						}
						
						#if HMI_FONT_CODE == HMI_FONT_CODE_UNICODE//pxguo
						ptext_string[phmi_text_prop_info->length+1] = hmi_scroll_step;
						#else
						ptext_string[phmi_text_prop_info->length+1] = (hmi_scroll_step>>8);
						ptext_string[phmi_text_prop_info->length+2] = (hmi_scroll_step&0x0f);
						#endif	
					}
					else
					{
						#if HMI_FONT_CODE == HMI_FONT_CODE_UNICODE//pxguo
						ptext_string[phmi_text_prop_info->length+1] = 0U;
						#else
						ptext_string[phmi_text_prop_info->length+1] = 0U;
						ptext_string[phmi_text_prop_info->length+2] = 0U;
						#endif
					}
				}
			}
			#endif			
			R_DRW2D_CtxEffectsDelete(HMI_LOC_DRW2D_DEV);
			hmi_loc_inc_msg_count(HMI_MONITOR0); 
		}
	}	
	#endif
}

/*AVL tree*/

/*
parray_tree[0],parray_tree[1],parray_tree[2],parray_tree[3],parray_tree[4]	
		|
	|node[0]	|
	|node[1]	|
	|node[2]	|
	|node[3]	|
	|node[4]	|
	|node[5]	|
	|......	|
	|node[HMI_MAX_TREE_CNT-1]|

	
	free_node_head is free node head pointer
	phead is tree root head pointer;

*/
void hmi_avl_init_node(struct HMI_AVL_TREE_NODE_STR *pnode)
{
	if(pnode != NULL)
	{
		(*pnode).key				= 0U;
		(*pnode).height 			= 1;
		(*pnode).pleft				= NULL;
		(*pnode).pright 			= NULL; 	
		(*pnode).next_free_index	= -1;
		(*pnode).x_index			= 0U;
		(*pnode).y_index			= 0U;
		(*pnode).char_w 			= 0U;
		(*pnode).char_h 			= 0U;
	}
}

struct HMI_AVL_TREE_NODE_STR * hmi_avl_get_left(struct HMI_AVL_TREE_NODE_STR * pnode)
{
	struct HMI_AVL_TREE_NODE_STR * pleft	= NULL;
	
	if (pnode != NULL)
	{
		pleft	= pnode->pleft;
	}
	
	return pleft;
}

struct HMI_AVL_TREE_NODE_STR * hmi_avl_get_right(struct HMI_AVL_TREE_NODE_STR * pnode)
{
	struct HMI_AVL_TREE_NODE_STR * pright	= NULL;
	
	if (pnode != NULL)
