TEXTURE_2D_PIXEL_FORMAT hmi_get_pixel_fmt_compress_fmt(HMI_BIG_IMAGE_INDEX_STR	fmt_index)
{
	TEXTURE_2D_PIXEL_FORMAT pixel_fmt	= TEXTURE_2D_PIXEL_FORMAT_RGBA8888;

	if((fmt_index == HMI_JPG_BIG_IMAGE)||
		(fmt_index == HMI_RLE_RGB888_BIG_IMAGE)||
		(fmt_index == HMI_RGB888_BIG_IMAGE))
	{
		pixel_fmt	= TEXTURE_2D_PIXEL_FORMAT_RGB888;
	}
	else if(fmt_index == HMI_ETC1_RGB8888_BIG_IMAGE)
	{
		pixel_fmt	= TEXTURE_2D_PIXEL_FORMAT_ETC1;
	}
	else if(fmt_index == HMI_ETC2_RGB8888_BIG_IMAGE)
	{
		pixel_fmt	= TEXTURE_2D_PIXEL_FORMAT_ETC2RGB888;
	}
	else if(fmt_index == HMI_ETC2_ARGB8888_BIG_IMAGE)
	{
		pixel_fmt	= TEXTURE_2D_PIXEL_FORMAT_ETC2RGBA8888;
	}
	else if(fmt_index == HMI_A8_BIG_IMAGE) // 2023 01 10 
	{  
		pixel_fmt = TEXTURE_2D_PIXEL_FORMAT_A8; 
	}
	else
	{
		pixel_fmt	= TEXTURE_2D_PIXEL_FORMAT_RGBA8888;
	}
	
	return pixel_fmt;
}


