/*
Set blend mode
Dst.cor   = Src.Alpha * Src.cor + (1- Src.Alpha) * Dst.cor) 
Dst.Alpha = Src.Alpha  + (1- Src.Alpha) * Dst.Alpha         
*/
void hmi_blend_mode(HMI_BLEND_MODE_STR mode)
{
	BOOLEAN	bno_blend	= FALSE;
	
	bno_blend	= get_qd_attribute(HMI_QD_NO_BLEND);
	if(bno_blend == FALSE)
	{
		if(mode == HMI_BLEND_TRANSPARENT)
		{
			glBlendFuncSeparate(GL_SRC_ALPHA/*srcRGB*/, 
								GL_ONE_MINUS_SRC_ALPHA/*dstRGB*/,
								GL_ONE/*srcAlpha*/,
								GL_ONE_MINUS_SRC_ALPHA/*dstAlpha*/);	
		}
		else
		{
			glBlendFuncSeparate(GL_SRC_ALPHA/*srcRGB*/, 
								GL_ONE_MINUS_SRC_ALPHA/*dstRGB*/,
								GL_ONE/*srcAlpha*/,
								GL_ONE_MINUS_SRC_ALPHA/*dstAlpha*/);
		}
		glEnable(GL_BLEND);
	}
	else	/*no blend*/
	{
		glDisable(GL_BLEND);
	}
	

	
}


