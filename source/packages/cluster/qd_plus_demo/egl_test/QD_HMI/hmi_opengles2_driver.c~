			image_vertex_pos[screen_no][6]	= width/2.0f;/*x*/
			image_vertex_pos[screen_no][7]	= -(heigh/2.0f);/*y*/
			image_vertex_pos[screen_no][8]	= -HMI_PERSPECTIVE_POS;/*z*/

			image_vertex_pos[screen_no][9]	= width/2.0f;/*x*/
			image_vertex_pos[screen_no][10]	= heigh/2.0f;/*y*/
			image_vertex_pos[screen_no][11]	= -HMI_PERSPECTIVE_POS;/*z*/
