		matrix_by_euler_angle_z0x1y2(&sub_model,
				p3dSubModel->protation[0/*x*/],
				p3dSubModel->protation[1/*y*/],
				p3dSubModel->protation[2/*z*/] + p3dSubModel->angle_z);
#endif

		/*scale*/
		if((p3dSubModel->pscale[0/*x scale*/] != 1.0f)||
			(p3dSubModel->pscale[1/*y scale*/] != 1.0f)||
			(p3dSubModel->pscale[2/*z scale*/] != 1.0f))
		{
			matrix_scale(&sub_model,
						p3dSubModel->pscale[0/*x scale*/],
						p3dSubModel->pscale[1/*y scale*/],
						p3dSubModel->pscale[2/*z scale*/]);
		}
		if(pfather_matrix != NULL)
		{
			matrix_multiply(&model,
							&sub_model,
							pfather_matrix);
		}
		else
		{
			memcpy(&model,&sub_model,sizeof(ES_MATRIX_STR));
		}

		if(pshadow_matrix != NULL)
		{
			
			matrix_multiply(&shadow_model,
							&model,
							pshadow_matrix);
		}
		else
		{
			memcpy(&shadow_model,&model,sizeof(ES_MATRIX_STR));
		}
		/* set worldMatrix to OpenGL*/
		glUniformMatrix4fv(hmi_user_data.m_to_world_unform_id,
						 1, GL_FALSE,
						 (GLfloat*)(&(shadow_model.m[0][0])));
		matrix_multiply(&scene_vp_matrix,
						&scene_v_matrix,
						&scene_p_matrix);
		/*view matrix to model mvp matrix*/
		matrix_multiply(&mvp_matrix,
						 &shadow_model,
						 &scene_vp_matrix); 		
		/* Set the mvp	matrix to uniform */									
		glUniformMatrix4fv(hmi_user_data.mvp_unform_id, 
							1, GL_FALSE, 
						(GLfloat*)(&(mvp_matrix.m[0][0])));
		bset_matrix = TRUE;
		/*draw type */								
		hmi_set_draw_type(HMI_UNIFORM_SHADOW,
						attribute,global_alpha);
								
		glEnable(GL_SCISSOR_TEST);
#ifdef HMI_RENDER_FULL_SCREEN	
		/*scissor,clip is framebuffer all zone*/					
		glScissor(0,0,
				(GLsizei)(hmi_screen_size[screen_no].x),
				(GLsizei)(hmi_screen_size[screen_no].y));
		if(status == HMI_BIG_IMAGE_TEXTURE_READY)
		{	
	#if	(HMI_3D_VERTEX_BUF_ENABLE == HMI_YES)			
			drawPrimitiveWithVBOs((GLfloat **)pvtx_buf, 
											vtx_strides,								
											(*pvertexAttr).numIndices,
											(/*GLushort*/GLuint *)((*pvertexAttr).pindices),
											uv,
											normalEn/*noraml*/,
											colorlEn/*color vertex*/,
											(*pvertexAttr).pvboIds,
											(*pvertexAttr).vertexNum,
											bone_color,pickup_color);	
			
	#else			
			drawPrimitiveWithoutVBOsNormal((GLfloat **)pvtx_buf, 
										vtx_strides,								
										(*pvertexAttr).numIndices,
										(/*GLushort*/GLuint *)((*pvertexAttr).pindices),
										uv,
										normalEn/*noraml*/,
										colorlEn/*color vertex*/,
										bone_color,pickup_color);	
			
	#endif
		}			
#else	/*part refresh*/
		/*scissor,clip is framebuffer all zone*/					
		glScissor(0,0,
				(GLsizei)(hmi_screen_size[screen_no].x),
				(GLsizei)(hmi_screen_size[screen_no].y));					
					
		if(status == HMI_BIG_IMAGE_TEXTURE_READY)
		{
	#if 0	// 2023 06 15
			glUniformMatrix4fv(hmi_user_data.mvp_unform_id, 
							1, GL_FALSE, 
						(GLfloat*)(&(mvp_matrix.m[0][0]))); 
	#endif
	#if	(HMI_3D_VERTEX_BUF_ENABLE == HMI_YES)			
			drawPrimitiveWithVBOs((GLfloat **)pvtx_buf, 
										vtx_strides,								
										(*pvertexAttr).numIndices,
										(/*GLushort*/GLuint *)((*pvertexAttr).pindices),
										uv,
										normalEn/*noraml*/,
										colorlEn/*color vertex*/,
										(*pvertexAttr).pvboIds,
										(*pvertexAttr).vertexNum,
										bone_color,pickup_color);	
			
	#else					
			drawPrimitiveWithoutVBOsNormal((GLfloat **)pvtx_buf, vtx_strides,								
									(*pvertexAttr).numIndices,
									(*pvertexAttr).pindices,
									uv,
									normalEn/*noraml*/,
									colorlEn/*color vertex*/,
									bone_color,pickup_color);
			
	#endif
		}
						
#endif	
									
	}	

#if 0	// 2023 01 28
	/*restory  viewport zone*/			
	glViewport(0,0,
				hmi_screen_size[screen_no].x,
				hmi_screen_size[screen_no].y);
#endif
	glDisable(GL_DEPTH_TEST);	
	glDisable(GL_STENCIL_TEST); 
}

const float polygonOffsetFactor = 1.0f;
const float polygonOffsetUnits = 2.0f;

void hmi_set_polygon_offset_fill_on(void)
{

	glEnable(GL_POLYGON_OFFSET_FILL);
	glPolygonOffset(polygonOffsetFactor, polygonOffsetUnits);
}
void hmi_set_polygon_offset_fill_off(void)
{
	glDisable(GL_POLYGON_OFFSET_FILL);
}

	





