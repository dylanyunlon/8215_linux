		if((hmi_view_prop.attr & HMI_P2) != 0)
		{	
			if((hmi_view_prop.attr & HMI_P2_F) != 0)
			{
				p2_scale 		= (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(hmi_view_prop.p2));
			}
			else
			{
				//p2_scale 		= (HMI_CUSTOM_P_INT)(hmi_view_prop.p1);
			}
			
		}
		
		rotation[0/*x*/]	= const_p1_rx;
		rotation[1/*y*/]	= const_p2_ry;
		rotation[2/*z*/]	= const_p3_rz ;

		scale[0/*x*/]		= p2_scale;
		scale[1/*y*/]		= p2_scale;
		scale[2/*z*/]		= p2_scale;
		
		//get_matrix_by_pos_rot();
		proj.fNearPlanes	= const_p4_near_plane;
		proj.fFarPlanes		= const_p5_far_plane;
		proj.fieldView		= field_view;	
	#ifdef HMI_SIMULATE_QD
		proj.fRatio	= (float_32)(hmi_screen_size[0].x / ((float_32)hmi_screen_size[0].y));
	#else
		proj.fRatio	= (float_32)(HMI_MAX_WIDTH / ((float_32)(HMI_MAX_HEIGHT)));
	#endif
		
	}
	else
	{
		position[0/*x*/]	= 0.0f;
		position[1/*y*/]	= 0.0f;
		position[2/*z*/]	= 0.0f;

		rotation[0/*x*/]	= 0.0f;
		rotation[1/*y*/]	= 0.0f;
		rotation[2/*z*/]	= 0.0f ;

		scale[0/*x*/]		= 1.0f;
		scale[1/*y*/]		= 1.0f;
		scale[2/*z*/]		= 1.0f;
		
		//get_matrix_by_pos_rot();
		proj.fNearPlanes	= const_p4_near_plane;
		proj.fFarPlanes		= const_p5_far_plane;
		proj.fieldView		= field_view;	
	#ifdef HMI_SIMULATE_QD
		proj.fRatio	= (float_32)(hmi_screen_size[0].x / ((float_32)hmi_screen_size[0].y));
	#else
		proj.fRatio	= (float_32)(HMI_MAX_WIDTH / ((float_32)(HMI_MAX_HEIGHT)));
	#endif
					
	}
		
	if(light_cnt > 0)
	{		
	#if HMI_DXY_CUSTOM_CNT + HMI_SXY_CUSTOM_CNT > 0U
		get_light_success	= hmi_engine_get_custom_prop(
											light_id[0],
											&hmi_light_prop);
	#endif
		if(get_light_success == TRUE)
		{
			/*get light parameter*/
			if((hmi_light_prop.attr & HMI_XYZWH_F) == 0u)
			{
				light_position[0/*x*/]	= (float_32)(hmi_light_prop.x);
				light_position[1/*y*/]	= (float_32)(hmi_light_prop.y);
				light_position[2/*z*/]	= (float_32)(hmi_light_prop.z);
			}
			else
			{
				light_position[0/*x*/]	= (HMI_U32_TO_F32(hmi_light_prop.x));
				light_position[1/*y*/]	= (HMI_U32_TO_F32(hmi_light_prop.y));
				light_position[2/*z*/]	= (HMI_U32_TO_F32(hmi_light_prop.z));
			}
			
			if((hmi_light_prop.attr & HMI_ID1) != 0)
			{
				id1_light_color_fill 	= hmi_light_prop.id1;
				/*Fill Color*/						
				if((HMI_IS_DYN_NFILL(id1_light_color_fill))||
					(HMI_IS_SXY_FILL_PAGES(id1_light_color_fill)))
				{
					hmi_engine_get_object_prop(id1_light_color_fill,
										&object_prop);
					light_para.light_ambiend_color	= object_prop.c1;
					
				}									
			}

			if((hmi_light_prop.attr & HMI_ID2) !=0)
			{
				id1_light_color_fill 	= hmi_light_prop.id2;
				/*Fill Color*/						
				if((HMI_IS_DYN_NFILL(id1_light_color_fill))||
					(HMI_IS_SXY_FILL_PAGES(id1_light_color_fill)))
				{
					hmi_engine_get_object_prop(id1_light_color_fill,
										&object_prop);
					light_para.light_diffuse_color	= object_prop.c1;
					
				}	
			}
			if((hmi_light_prop.attr & HMI_ID3) != 0)
			{
				id1_light_color_fill 	= hmi_light_prop.id3;
				/*Fill Color*/						
				if((HMI_IS_DYN_NFILL(id1_light_color_fill))||
					(HMI_IS_SXY_FILL_PAGES(id1_light_color_fill)))
				{
					hmi_engine_get_object_prop(id1_light_color_fill,
										&object_prop);
					light_para.light_specular_color	= object_prop.c1;					
				}	
			}

			if((hmi_light_prop.attr & HMI_CON_P1) != 0)
			{ 
				if((hmi_light_prop.attr & HMI_CON_F1) != 0)
				{
					const_p1_rx   = (HMI_U32_TO_F32(hmi_light_prop.const_p1));
				}
				else
				{
					//const_p1_rx	 = (HMI_CUSTOM_P_INT)(hmi_view_prop.const_p1);
				}
			}
			if((hmi_light_prop.attr & HMI_CON_P2) != 0)
			{
				if((hmi_light_prop.attr & HMI_CON_F2) != 0)
				{
					const_p2_ry  = (HMI_TIME)(HMI_U32_TO_F32(hmi_light_prop.const_p2));
				}
				else
				{
					//const_p2_ry	= (HMI_CUSTOM_P_INT)(hmi_view_prop.const_p2);
				}
			}
			if((hmi_light_prop.attr & HMI_CON_P3) != 0)
			{
				if((hmi_light_prop.attr & HMI_CON_F3) != 0)
				{
					const_p3_rz   = (HMI_U32_TO_F32(hmi_light_prop.const_p3));
				}
				else
				{
					//const_p3_rz	 = (HMI_CUSTOM_P_INT)(hmi_view_prop.const_p3);
				}
			}

			if((hmi_light_prop.attr & HMI_CON_P4) != 0)
			{
				if((hmi_light_prop.attr & HMI_CON_F4) != 0)
				{
					//const_p4_light_type   = (HMI_OBJECT_ID_STR)(HMI_U32_TO_F32(hmi_light_prop.const_p4));
				}
				else
				{
					// light type
					light_para.light_type	 = (HMI_CUSTOM_P_INT)(hmi_light_prop.const_p4);
				}
			}

			if((hmi_light_prop.attr & HMI_CON_P5) !=0)
			{
				if((hmi_light_prop.attr & HMI_CON_F5) !=0)
				{
					//light_para.light_shadows_type   = (HMI_OBJECT_ID_STR)(HMI_U32_TO_F32(hmi_light_prop.const_p5));
				}
				else
				{
					light_para.light_shadows_type	 = (HMI_CUSTOM_P_INT)(hmi_light_prop.const_p5);
				}
			}

			if((hmi_light_prop.attr & HMI_CON_P6) !=0)
			{
				if((hmi_light_prop.attr & HMI_CON_F6) !=0)
				{
					light_para.light_range   = (HMI_U32_TO_F32(hmi_light_prop.const_p6));
				}
				else
				{
					//light_para.light_range	 = (HMI_CUSTOM_P_INT)(hmi_light_prop.const_p6);
				}
			}

			if((hmi_light_prop.attr & HMI_P1) !=0)
			{	
				if((hmi_light_prop.attr & HMI_P1_F) !=0)
				{
					p1_angle_z_light= (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(hmi_light_prop.p1));
				}
				else
				{
					//p1_angle_z_light 		= (HMI_CUSTOM_P_INT)(hmi_light_prop.p1);
				}				
			}

			if((hmi_light_prop.attr & HMI_P2) !=0)
			{	
				if((hmi_light_prop.attr & HMI_P2_F) !=0)
				{
					//p2_scale 		= (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(hmi_light_prop.p2));
					light_para.ground_d 		= (HMI_CUSTOM_P_FLOAT)(HMI_U32_TO_F32(hmi_light_prop.p2));
				}
				else
				{
					//p2_scale 		= (HMI_CUSTOM_P_INT)(hmi_light_prop.p1);
				}			
			}
			
			light_rotation[0/*x*/]	= const_p1_rx;
			light_rotation[1/*y*/]	= const_p2_ry;
			light_rotation[2/*z*/]	= const_p3_rz ;

			//light_scale[0/*x*/]		= p2_scale;
			//light_scale[1/*y*/]		= p2_scale;
			//light_scale[2/*z*/]		= p2_scale;
			
			light_scale[0/*x*/]		= 1.0f;
			light_scale[1/*y*/]		= 1.0f;
			light_scale[2/*z*/]		= 1.0f;
		}
	}
	else
	{	
		if(bPickup == TRUE)
		{			
			//glUniform1i(hmi_user_data.u_light_type_id,-2/*pickup*/);
			light_para.light_type	= -2/*pickup*/;
		}
		else
		{
			//glUniform1i(hmi_user_data.u_light_type_id,-1/*no light*/);
			light_para.light_type	= -1/*no light*/;
		}
	}
	if(get_light_success == FALSE)
	{
		light_position[0/*x*/]	= 0.0f;
		light_position[1/*y*/]	= 0.0f;
		light_position[2/*z*/]	= 0.0f;
			
		light_rotation[0/*x*/]	= 0.0f;
		light_rotation[1/*y*/]	= 0.0f;
		light_rotation[2/*z*/]	= 0.0f;

		light_scale[0/*x*/]		= 1.0f;
		light_scale[1/*y*/]		= 1.0f;
		light_scale[2/*z*/]		= 1.0f;

		light_para.light_type			= -1;
		light_para.light_ambiend_color	= HMI_DEFAULT_LIGHT_AMBIENT_COLOR;
		light_para.light_diffuse_color	= HMI_DEFAULT_LIGHT_DIFFUSE_COLOR;
		light_para.light_specular_color	= HMI_DEFAULT_LIGHT_SPECULAR_COLOR;
		light_para.light_shadows_type	= 0;	/*0:no shadow,1:soft shadow,2:hard shadow*/
		light_para.light_range			= 0.0f;
		light_para.ground_d				= 0;
	}

#if HMI_DXY_CUSTOM_CNT + HMI_SXY_CUSTOM_CNT >0U
	set_3d_scene_light_camera(&pos_rot_scale,
								p1_angle_z_camera,
								&proj,
								&light_pos,
								&light_para,
								p1_angle_z_light,
								bPickup,
								radius,									
								xyz);
#endif

	glEnable(GL_SCISSOR_TEST);
	glScissor(0,0,
				(GLsizei)(hmi_screen_size[0].x),
				(GLsizei)(hmi_screen_size[0].y));	
	glClearStencil(0);
	glClear(GL_STENCIL_BUFFER_BIT);
#ifdef HMI_SIMULATE_QD		
	glScissor(pdsp_zone->x,
				(hmi_screen_size[0].y - (pdsp_zone->y + pdsp_zone->h)),
				pdsp_zone->w,
				pdsp_zone->h);	
#else
	glScissor(pdsp_zone->x,
				(HMI_MAX_HEIGHT - (pdsp_zone->y + pdsp_zone->h)),
				pdsp_zone->w,
				pdsp_zone->h);	
#endif

}

