void	hmi_release_3d_node(struct	HMI_3D_NODE_INFO_STR	*p3d_qd_node,BOOLEAN bchild)
{
	INT32							meshCnt			= 0;
	INT32							i				= 0;
	INT32							j				= 0;
	HMI_VERTEX_ATTR_STR				*pvertex_info	= NULL;
	HMI_MATERIAL_PROPERTIES			*pmaterial_info	= NULL;	
	struct	HMI_3D_NODE_INFO_STR	*pchild			= NULL;
	INT32							childCnt		= 0;
	
	if(p3d_qd_node != NULL)
	{
		pvertex_info	= p3d_qd_node->pvertex_info;
		pmaterial_info	= p3d_qd_node->pmaterial_info;
		pchild			= p3d_qd_node->pchild;
		childCnt		= p3d_qd_node->childCnt;

		for(i = 0;i < meshCnt;i++)
		{
			if(pvertex_info[i].textureID != 0)
			{
				glDeleteTextures(1, &(pvertex_info[i].textureID));
				pvertex_info[i].textureID	= 0;
				//pvertex_info[i].pvboIds;?? destory vbo
				if(pvertex_info[i].pvboIds != NULL)
				{
					for(j = 0;j < HMI_VERTEX_BUF_CNT;j++)
					{
						if(pvertex_info[i].pvboIds[j] != 0u)
						{
							glDeleteBuffers(1, &(pvertex_info[i].pvboIds[j]));
							pvertex_info[i].pvboIds[j]	= 0u;
						}
					}
				}
			}
		}

		if(pvertex_info	!= NULL)
		{
			hmi_release_qd_buf((void *)pvertex_info);
		}
		if(pmaterial_info	!= NULL)
		{
			hmi_release_qd_buf((void *)pmaterial_info);
		}
	}
	
	if(bchild == TRUE)
	{
		for(i = 0;i < childCnt;i++)
		{
		#if HMI_DXY_CUSTOM_CNT + HMI_SXY_CUSTOM_CNT >0U
			hmi_release_3d_node(&pchild[i],bchild);
		#endif
		}
	}
}

float_32	qd_sqrt(double number)
{
	float_32		fresult		= 0.0f;
	double_64		i			= 1.0;
    double_64		j			= number / i;
	BOOLEAN			finished	= FALSE;
    if(number > 0)
    {    
	    while(finished == FALSE)
	    {
	        i = (i + j) / 2;
	        j = number / i;
			if(i < j)
			{
				i	= j - i;
			}
			else
			{
				i	= i - j;
			}
			if(i > HMI_FLOAT_TOLERANCE)
			{
				fresult		= (float_32)i;
				finished	= TRUE;
			}
	    }
    }
	else
	{
		fresult	= 0.0f;
	}
    return fresult;
}


