void set_ortho_matrix2(UINT32	screen_w,UINT32	screen_h)
{	
	float_32	aspect	= 1.0f;
	BYTE		screen	= 0u;

	if(hmi_loc_qd_unit < HMI_SCREEN_NO)
	{
		screen	= hmi_loc_qd_unit;
	}

	if(screen_w != 0)
	{
		hmi_screen_size[screen].x	= (HMI_X_STR)screen_w;
	}
	else
	{
		screen_w	= hmi_screen_size[screen].x;
	}

	if(screen_h != 0u)
	{
		hmi_screen_size[screen].y	= (HMI_Y_STR)screen_h;
	}
	else
	{
		screen_h	= hmi_screen_size[screen].y;
	}
	
	if(screen_h != 0u) 
	{
		aspect	=	((float_32)(screen_w))/screen_h ;
	}
	matrix_load_identity(&ortho_matrix);	
	matrix_perspective(&ortho_matrix, HMI_PERSPECTIVE_FOVY, 
						aspect, HMI_PERSPECTIVE_NEARZ,
						HMI_PERSPECTIVE_FARZ,
						FALSE/*ortho*/);

	matrix_load_identity(&perspective_matrix);	
	matrix_perspective(&perspective_matrix, HMI_PERSPECTIVE_FOVY, 
						aspect, HMI_PERSPECTIVE_NEARZ,
						HMI_PERSPECTIVE_FARZ,
						TRUE/*perspective*/);

	if(11 < HMI_VERTEX_POS_ARRAY_LEN)
	{	
		image_vertex_pos[screen][0]	= -(screen_w/2.0f);/*x*/
		image_vertex_pos[screen][1]	= screen_h/2.0f;/*y*/
		image_vertex_pos[screen][2]	= -HMI_PERSPECTIVE_POS;/*z*/

		image_vertex_pos[screen][3]	= -(screen_w/2.0f);/*x*/
		image_vertex_pos[screen][4]	= -(screen_h/2.0f);/*y*/
		image_vertex_pos[screen][5]	= -HMI_PERSPECTIVE_POS;/*z*/

		image_vertex_pos[screen][6]	= screen_w/2.0f;/*x*/
		image_vertex_pos[screen][7]	= -(screen_h/2.0f);/*y*/
		image_vertex_pos[screen][8]	= -HMI_PERSPECTIVE_POS;/*z*/

		image_vertex_pos[screen][9]	= screen_w/2.0f;/*x*/
		image_vertex_pos[screen][10]= screen_h/2.0f;;/*y*/
		image_vertex_pos[screen][11]= -HMI_PERSPECTIVE_POS;/*z*/
	}
}


