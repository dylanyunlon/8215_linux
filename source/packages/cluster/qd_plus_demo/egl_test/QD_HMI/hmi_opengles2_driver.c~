#if (HMI_LOAD_MULTI_PROCESS == YES)
void hmi_load_bmp_segment_data(UINT32	seg_no)
#else
void hmi_load_bmp_segment(U08	seg_no)
#endif
{
	BOOLEAN						success					= FALSE;
	BYTE						fmt_loop				= 0U;	
	UINT32						cnt						= 0U;
	UINT32						loop_index				= 0U;
	U32							decode_image_len		= 0U;			
	void						*p_decode_buffer		= NULL;
	HMI_FMT_BIG_IMAGE_STR CONST *pbig_img_addr			= NULL;
	BYTE							*pbuffer_data		= NULL;
	HMI_FMT_BIG_IMAGE_BUFFER_STR	*pbig_img_buf		= NULL;
	HMI_DECODE_STATUS_STR		decode_status			= HMI_DECODE_STATUS_CNT;
	TEXTURE_2D_PIXEL_FORMAT		pixel_fmt				= TEXTURE_2D_PIXEL_FORMAT_CNT;
	HMI_SEGMENT_LIST_STR CONST *pseg_info				= hmi_cur_texture.psegment_list;
#if	(HMI_LOAD_RES_CREATE_TEXTURE == YES)
	GLuint						texture_id				= 0;

#endif
	
	if((pseg_info != NULL)&&(seg_no <HMI_BMP_SEGMENT_MAX_CNT ))
	{
		for(fmt_loop = HMI_JPG_BIG_IMAGE;fmt_loop < HMI_MAX_CNT_BIG_IMAGE;fmt_loop++)
		{
			pixel_fmt	= hmi_get_pixel_fmt_compress_fmt(fmt_loop);	
			cnt		= pseg_info[seg_no].fmt_addr[fmt_loop].cnt;
			for(loop_index = 0U;loop_index < cnt;loop_index++)
			{		
				pbig_img_buf	= hmi_get_big_image_buf_addr(seg_no,
										fmt_loop,loop_index);
				if(pbig_img_buf != NULL)
				{
					pbuffer_data	= pbig_img_buf->pbuffer;
					if(pbuffer_data == NULL)/*Not load*/
					{
						pbig_img_addr	= hmi_get_big_image_addr(seg_no,
												fmt_loop,loop_index);
						if(pbig_img_addr != NULL)
						{
							decode_image_len	= pbig_img_addr->data_len;
							if((fmt_loop == HMI_JPG_BIG_IMAGE)||
								(fmt_loop == HMI_RLE_ARGB8888_BIG_IMAGE)||
								(fmt_loop == HMI_RLE_RGB888_BIG_IMAGE))/*need decode*/
							{
								decode_image_len	= hmi_get_decode_buffer_len(pixel_fmt,
																pbig_img_addr->w,
																pbig_img_addr->h);	
							}
						}
						/*malloc decode data memory*/
						p_decode_buffer	= hmi_malloc_memory(decode_image_len);
									
						/*decode every image*/
						if(p_decode_buffer != NULL)
						{			
							#if (HMI_DMA_ENABLE == HMI_NO)																
							/* decode compress image  or copy no compress image to buffer*/
							decode_status	= hmi_decode_image(fmt_loop,
															pbig_img_addr->offset,
															pixel_fmt,
															pbig_img_addr->w,
															pbig_img_addr->h,
															p_decode_buffer,
															decode_image_len,
															pbig_img_addr->data_len,
															seg_no);
							
							if(decode_status == HMI_DECODE_IMAGE_SUCCESS)
							{
								#if 0
								hmi_set_big_image_buffer(p_decode_buffer,seg_no,
													fmt_loop,loop_index);
								pbig_img_buf[loop_index].memory_size	= decode_image_len;
								pbig_img_buf[loop_index].ticks			= 0U;
								#endif
								pbig_img_buf->pbuffer		= p_decode_buffer;
								pbig_img_buf->memory_size	= decode_image_len;
								pbig_img_buf->ticks			= 0U;
								/*Create texture id*/
							#if	(HMI_LOAD_RES_CREATE_TEXTURE == YES)																
								/*Active texture*/		
								//glActiveTexture(GL_TEXTURE0 + HMI_TEXTURE_UNIT_BMP);	2020 05 14					
								texture_id	= create_texture_id(pixel_fmt,
														pbig_img_addr->w,
														pbig_img_addr->h,
														p_decode_buffer,
														decode_image_len,
														TRUE);
								pbig_img_buf->texture_id	= texture_id;	
							#endif
								
								success			= TRUE;
							}					
										
							#else
							
							#endif			
							
							if(success	== FALSE)
							{
								hmi_dealloc_vram(p_decode_buffer);
								p_decode_buffer	= NULL;
							}	
						}
						else
						{		
							hmi_qd_error_handler(HMI_RGL_IMAGE_NOT_ENOUGH_MEM); 
							
							printf("hmi_load_bmp_segment error\n");
							hmi_printf_time("hmi_load_bmp_segment error\n",0);
							#if(HMI_ENDLESS_LOOP == YES)
							while(1);/* malloc memory failed. */
							#endif
						}	
					}
				}
			}
		}				
	}	
}


void hmi_unload_bmp_segment(U08	seg_no)
{
	BYTE							fmt_loop				= 0U;
	HMI_SEGMENT_LIST_STR CONST		*psegment_list			= NULL;
	HMI_FMT_BIG_IMAGE_BUFFER_STR 	*pbig_image_buf_array	= NULL;
	UINT32							cnt						= 0U;
	UINT32							loop					= 0U;
	BYTE							*pbuffer				= NULL;
	
	psegment_list		= hmi_cur_texture.psegment_list;
	if((psegment_list != NULL)&&(seg_no < HMI_BMP_SEGMENT_MAX_CNT))
	{
		for(fmt_loop = HMI_JPG_BIG_IMAGE;fmt_loop < HMI_MAX_CNT_BIG_IMAGE;
							fmt_loop++)
		{
			cnt	= psegment_list[seg_no].fmt_addr[fmt_loop].cnt;		
			pbig_image_buf_array	= psegment_list[seg_no].fmt_addr[fmt_loop].pfmt_big_image_buffer;
			if((pbig_image_buf_array != NULL)&&(cnt > 0U))
			{
				for(loop = 0U;loop < cnt;loop++)
				{
					pbuffer	= pbig_image_buf_array[loop].pbuffer;
					if(pbuffer != NULL)
					{
						hmi_dealloc_vram(pbuffer);									
						pbig_image_buf_array[loop].pbuffer		= NULL;					
						pbig_image_buf_array[loop].ticks			= 0U;
						pbig_image_buf_array[loop].memory_size	= 0U;
					}
					/*Release texture*/
					if(pbig_image_buf_array[loop].texture_id != 0)
					{
						glDeleteTextures(1, &(pbig_image_buf_array[loop].texture_id));
						pbig_image_buf_array[loop].texture_id	= 0;
					}
				}
			}		
		}
	}
}



#if (HMI_LOAD_MULTI_PROCESS == YES)
#define HMI_RES_LOAD_FIFO_CNT					(HMI_BMP_SEGMENT_MAX_CNT + 1)

typedef struct
{
	U08	hmi_segment_list[HMI_RES_LOAD_FIFO_CNT];
	U08					head;
	U08					tail;
}HMI_RES_LOAD_FIFO_STR;

static HMI_RES_LOAD_FIFO_STR hmi_res_load_fifo;
void	init_res_load_fifo(void)
{
	hmi_res_load_fifo.head	= 0U;
	hmi_res_load_fifo.tail	= 0U;
}

BOOLEAN	push_res_load_fifo(U08	segment_no)
{
	BOOLEAN	success	= FALSE;
	BYTE			next		= 0;

	if(segment_no < HMI_BMP_SEGMENT_MAX_CNT)
	{
		next	= hmi_res_load_fifo.tail ;
		
		if(next != hmi_res_load_fifo.head)/*not full*/
		{
			hmi_res_load_fifo.hmi_segment_list[next]	= segment_no;
			next++;
			if(next >= HMI_RES_LOAD_FIFO_CNT)
			{
				next= 0U;
			}
			hmi_res_load_fifo.tail		= next;
			success						= TRUE;
		}
	}

	return	success;
}

U08	popup_res_load_fifo(void)
{
	BYTE		segment_no	= 0xff;
	BYTE		head		= 0U;
	BYTE		head_next	= 0U;

	head		= hmi_res_load_fifo.head ;
	
	if(head  != hmi_res_load_fifo.tail)/*not empty*/
	{
		segment_no	= hmi_res_load_fifo.hmi_segment_list[head];
		head_next	= head++;
		if(head_next >= HMI_RES_LOAD_FIFO_CNT)
		{
			head_next= 0U;
		}
		hmi_res_load_fifo.head	= head_next;
	}

	return	segment_no;
}


void hmi_load_bmp_segment(U08	seg_no)
{
	BOOLEAN	success	= FALSE;
	
	success	= push_res_load_fifo(seg_no);
	//v signal
}

