/*
only get perspective matrix,not multiplay matrix with result
*/
void matrix_perspective2(ES_MATRIX_STR *result, float_32 fovy, 
				float_32 aspect, float_32 nearZ, float_32 farZ,
				BOOLEAN perspective)
{
	float_32	frustumW		= 0.0f;
	float_32	frustumH		= 0.0f;;
	
	fovy			= HMI_ANGEL_TO_RADIAN(fovy);
	frustumH		= tanf(fovy) * nearZ;
	frustumW		= frustumH * aspect;

	if(perspective == TRUE)
	{		
		matrix_frustum2(result, -frustumW, frustumW,
					-frustumH, frustumH, nearZ, farZ );
	}
	else
	{		
		matrix_ortho2(result, -frustumW, frustumW,
					-frustumH, frustumH, nearZ, farZ);
	}   
}


