BOOLEAN hmi_avl_find_comparable(HMI_AVL_TREE_ROOT_NODE_STR *proot,										
										HMI_AVL_TREE_USER_DATA_STR *puser_data) 
{
	BOOLEAN 						find			= FALSE;
	struct HMI_AVL_TREE_NODE_STR		*pnode		= NULL;
	SINT32							cmp 		= 0;
	HMI_AVL_TREE_USER_DATA_STR		user_data	= {0U,0U,0U};
	BOOLEAN						end 			= FALSE;
	
	if((proot != NULL)&&(puser_data != NULL))
	{
		pnode	= proot->phead;
		while ((pnode != NULL)&&(end == FALSE))
		{
			hmi_avl_get_user_data(pnode,&user_data);
			cmp = hmi_avl_cmp(puser_data,&user_data);
			
			if (cmp == 0)
			{				
				puser_data->x_index	= pnode->x_index;
				puser_data->y_index	= pnode->y_index;
				puser_data->char_w	= pnode->char_w;
				puser_data->char_h	= pnode->char_h;
				
				end 					= TRUE;
				find					= TRUE;
			}
			else
			{
				if (cmp < 0)
				{
					pnode = hmi_avl_get_left(pnode);					
				}
				else
				{
					pnode = hmi_avl_get_right(pnode);										
				}
			}
		}
	}

	return	find;
}


