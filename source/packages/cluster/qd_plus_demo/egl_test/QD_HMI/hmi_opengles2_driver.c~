		{
			screen_no	= hmi_loc_qd_unit;
		}
		
		/*Blend*/
		glEnable(GL_DEPTH_TEST);
		//glDisable(GL_BLEND);	
		glEnable(GL_BLEND);
		glEnable(GL_STENCIL_TEST);
		/*set render side*/ 
		glDisable(GL_CULL_FACE);
		
		//glClearStencil(0);
		//glClear(GL_STENCIL_BUFFER_BIT); 
		glStencilFunc(GL_EQUAL,0x00,0x01);	/*stencil buffer & 0x01 == 0x00*/	
		glStencilOp(GL_KEEP,GL_KEEP,GL_INCR);

		
		/* Identity and Set matrix */							
		matrix_load_identity(&sub_model);	
		matrix_translate(&sub_model,
				p3dSubModel->pposition[0/*x*/],
				p3dSubModel->pposition[1/*y*/],
				p3dSubModel->pposition[2/*z*/]);
