/*******************************************************************************
  Function: loc_EventExecuteThreadStart

  The WM event execute thread.
*/

void* loc_WmEvExecLoop(void* Arg)
{
	UINT32		i	= 0U;
	
	for(;;)
	{
	    /* we are greedy: as soon as there are some messages, process them */
	    for (i = 0; i < R_WM_DEV_NUM; ++i)
	    {
	        if (hmi_loc_vout_msg_count[i] > 0)
	        {   				
	            HMI_OS_MUTEX_LOCK(&hmi_mute_greedy);				
	            hmi_loc_vout_msg_count[i] = 0;				
	            HMI_OS_MUTEX_UNLOCK(&hmi_mute_greedy);				
#if (HMI_R_ASYNCHRONOUS_HW_UPDATE == HMI_YES)
				glFlush();
#else
				glFinish();
#endif 
	        }
	    }		
		/*just for switch to another process*/
	    HMI_OS_SLEEP(0);		
	}
	
	return 0;
}

