*/
void matrix_ortho2(ES_MATRIX_STR *result, float_32 left, float_32 right, 
			float_32 bottom, float_32 top, float_32 nearZ, float_32 farZ)
{
	float_32       deltaX		= right - left;
	float_32       deltaY		= top - bottom;
	float_32       deltaZ		= farZ - nearZ;
	

    if ( (fabs(deltaX)  > HMI_FLOAT_TOLERANCE) &&
		(fabs(deltaY)  > HMI_FLOAT_TOLERANCE ) && 
		(fabs(deltaZ)  > HMI_FLOAT_TOLERANCE )&&
		(result != NULL))        
	{		
		result->m[0][0] = 2.0f / deltaX;
		result->m[3][0] = -(right + left) / deltaX;
		result->m[1][1] = 2.0f / deltaY;
		result->m[3][1] = -(top + bottom) / deltaY;
		result->m[2][2] = -2.0f / deltaZ;
		result->m[3][2] = -(nearZ + farZ) / deltaZ;		
    }
}

void matrix_perspective(ES_MATRIX_STR *result, float_32 fovy, 
				float_32 aspect, float_32 nearZ, float_32 farZ,
				BOOLEAN perspective)
{
	GLfloat	frustumW		= 0.0f;
	GLfloat	frustumH		= 0.0f;
	BYTE	screen			= 0u;

	if(hmi_loc_qd_unit < HMI_SCREEN_NO)
	{
		screen	= hmi_loc_qd_unit;
	}
	
	fovy			= HMI_ANGEL_TO_RADIAN(fovy);
	frustumH		= tanf(fovy) * nearZ;
	frustumW	= frustumH * aspect;

	if(perspective == TRUE)
	{
		frustumW		= (GLfloat)(hmi_screen_size[screen].x >> 1 );
		frustumH		= (GLfloat)(hmi_screen_size[screen].y >> 1 );
		matrix_frustum(result, -frustumW, frustumW,
