		}
		HMI_SUB_POINT2((*pb),(*pa),ab);
		hmi_get_rotation_poly_n90(&ab,&verctor_ab_f,
								1/*vertex count*/,
								angle);

		hmi_normalise_2d(&verctor_ab_f);
		HMI_MUL_POINT(distance,verctor_ab_f);
		HMI_ADD_POINT2((*pa),verctor_ab_f,a_parallel_f);
		HMI_ADD_POINT2((*pb),verctor_ab_f,b_parallel_f);
		
		(*pa_parallel).x	= (SINT32)(a_parallel_f.x + 0.5f);
		(*pa_parallel).y	= (SINT32)(a_parallel_f.y + 0.5f);

		(*pb_parallel).x	= (SINT32)(b_parallel_f.x + 0.5f);
		(*pb_parallel).y	= (SINT32)(b_parallel_f.y + 0.5f);
	}
}


void hmi_2d_parallel_line_float(POINT_FLOAT_TP *pa,POINT_FLOAT_TP *pb,
					POINT_FLOAT_TP *pa_parallel,POINT_FLOAT_TP *pb_parallel,
					INT32 distance,BOOLEAN cw)
{
	float_32		angle			= 90.0f;
