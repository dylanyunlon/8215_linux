											#endif
											);
			fragmentShader	= load_shader ( GL_FRAGMENT_SHADER, 
											pf_shader_str 
											#if (HMI_SUPPORT_BIN_SHADER	== HMI_YES)
											,0
											,pf_shader_str
											,(esContext->hmi_fragment_shader_len-1)
											#endif
											);
		}
		else
		{
			hmi_printf_time("pv_shader_str ",0);
			hmi_printf_time("pf_shader_str ",0);
		}
		#else
		vertexShader =loadshaderBinary(vertex_path, GL_VERTEX_SHADER);
		fragmentShader =loadshaderBinary(fragment_path, GL_FRAGMENT_SHADER);
		#endif
		hmi_user_data.vertexShader		= vertexShader;
		hmi_user_data.fragmentShader	= fragmentShader;
		/* Create the program object*/
		program_object = glCreateProgram( );   
		if ( program_object != 0U )
		{	
			error =glGetError();
			if(error != GL_NO_ERROR)
			{
				printf("glCreateProgram failed :0x%x \n",error);
			}
			glAttachShader ( program_object, vertexShader );
			error =glGetError();
			if(error != GL_NO_ERROR)
			{
				printf("glAttachShader vertexShader failed :0x%x \n",error);
			}
			glAttachShader ( program_object, fragmentShader );
			error =glGetError();
			if(error != GL_NO_ERROR)
			{
				printf("glAttachShader fragmentShader failed :0x%x \n",error);
			}
									
			#if defined (HMI_WINDOWS)	
			
			#elif defined (HMI_LINUX)

			#elif defined (HMI_QNX)

			#elif defined (HMI_SYLIXOS)
			
			#elif defined (HMI_NO_OS)

			#else
						
			#endif
					  
			
			/* Bind vPosition to attribute VERTEX_POS_INDX */	 
			glBindAttribLocation ( program_object, 
										VERTEX_POS_INDX, 
										"a_position" );
			
			/* Bind normal to attribute VERTEX_NORMAL_INDX */	
			glBindAttribLocation ( program_object, 
										VERTEX_NORMAL_INDX, 
										"a_normal" );
			
			/* Bind UV to attribute VERTEX_TEXCOORD_INDX */	
			glBindAttribLocation ( program_object, 
										VERTEX_TEXCOORD0_INDX, 
										"a_texCoord" ); 
			/* Bind UV to attribute VERTEX_TEXCOORD_INDX */	
			glBindAttribLocation ( program_object, 
										VERTEX_TEXCOORD1_INDX, 
										"a_etc1_alpha_texCoord" ); 
			/* Bind color to attribute VERTEX_COLOR_INDX */	
			glBindAttribLocation ( program_object, 
										VERTEX_COLOR_INDX, 
										"a_color" ); 
			/* Link the program */
			glLinkProgram ( program_object );
			error =glGetError();
			if(error != GL_NO_ERROR)
			{
				printf("glLinkProgram failed :0x%x \n",error);
			}
			/* Check the link status */
			glGetProgramiv ( program_object, 
						GL_LINK_STATUS, &linked );
			if ( !linked ) 
			{		  
			#if defined (HMI_WINDOWS)
				printf ( "vertex:\n%s \n", pv_shader_str);
				printf ( "fragment:\n%s \n", pf_shader_str);
			#endif
				glGetProgramiv ( program_object, 
								GL_INFO_LOG_LENGTH, 
								&info_len );		  
				if ( info_len > 1 )
				{
				
					pinfo_log = (GLchar *)(HMI_MALLOC (sizeof(char) * info_len ));
					
					hmi_printf_time("load_program malloc pinfo_log address is",(SINT32)pinfo_log);
					hmi_printf_time("load_program malloc pinfo_log len is",(SINT32)(sizeof(char) * info_len ));
					if(pinfo_log != NULL)
					{
					glGetProgramInfoLog ( program_object, 
									info_len, NULL, 
									pinfo_log );
				
					#if defined (HMI_WINDOWS)
					esLogMessage ( "Error linking program:\n%s\n", (SINT32)pinfo_log );
					printf ( "%s \n", pinfo_log);				
					#elif defined (HMI_LINUX)	
					printf ( "%s", pinfo_log);
					fprintf(stderr, "load_program %s\n",pinfo_log);
					hmi_printf_time("load_program!",0);
					hmi_printf_time(pinfo_log,0);
					#elif defined (HMI_QNX)
					printf ( "%s", pinfo_log);
					#elif defined (HMI_SYLIXOS)
					printf ( "%s", pinfo_log);
					#elif defined (HMI_NO_OS)
					printf ( "%s", pinfo_log);
					#else
					 
					#endif
					hmi_printf_time("load_program free pinfo_log address is",(SINT32)pinfo_log);
								 			  			 
					HMI_FREE ( pinfo_log );
					}
					else
					{
						hmi_printf_time("pinfo_log malloc failed len is",(SINT32)(sizeof(char) * info_len ));

					}
			  }

			glDeleteProgram ( program_object );
			success	= FALSE;
			
			printf("Link error\n");
			hmi_printf_time("Link error",0);
			//#if(HMI_ENDLESS_LOOP == YES)
			while(1);/*Link error*/
			//#endif
		   	}
			else
			{
					/*lq*/
				glDeleteShader(hmi_user_data.vertexShader	);
				hmi_user_data.vertexShader	= 0u;
				glDeleteShader(hmi_user_data.fragmentShader);
				hmi_user_data.fragmentShader	= 0u;
			}
		}
		else
		{
			hmi_printf_time("program_object",0);
		}
	}
	else
	{
		hmi_printf_time("esContext",0);
	}

	if(pv_shader_str != NULL)
	{
		hmi_printf_time("load_program free pdata address is",pv_shader_str);
		HMI_FREE ( pv_shader_str );
	}
	if(pf_shader_str != NULL)
	{
		hmi_printf_time("load_program free pdata address is",pf_shader_str);
		HMI_FREE ( pf_shader_str );
	}
#if 0
	query_for_active_uniforms(program_object);
#endif	
	hmi_printf_time("load_program end ",0);

	return program_object;
}



