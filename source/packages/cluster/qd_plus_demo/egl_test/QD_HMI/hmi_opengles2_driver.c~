HMI_GET_AVL_FONT_STATUS hmi_load_font_bmp_avl(HMI_AVL_TREE_ROOT_NODE_STR *proot,
											U08 font_id,HMI_FONT_CHAR_STR char_id,
											GLfloat	uv[]/*u,v*/,UINT16 uv_len)
{
	HMI_GET_AVL_FONT_STATUS		status		= HMI_FONT_BMP_STATUS_CNT;
	HMI_AVL_TREE_USER_DATA_STR	user_data	= {0U,0U,0U,0U,0U};
	BOOLEAN					find			= FALSE;
	BOOLEAN					buffer_full	= FALSE;
	POINT_TP					char_wh		= {0U,0U};
	POINT_TP					char_pos		= {0U,0U};
	struct HMI_AVL_TREE_NODE_STR	*pinsert		= NULL;

	user_data.key	= char_id;
	find			= hmi_avl_find_comparable(proot,&user_data);
	if(find == TRUE)
	{
		hmi_get_font_uv(proot,
						&user_data,
						uv,uv_len);
		status	= HMI_FONT_BMP_EXIST;		
	}
	else	/*not found*/
	{
		buffer_full	= hmi_full_font_buffer(proot);
		if(buffer_full == FALSE)
		{
			status			= HMI_FONT_BMP_NOEXIST_LOAD_FAILED;
			user_data.key	= char_id;	
			char_wh.x		= 0U;
			char_wh.y		= 0U;
			hmi_get_char_w_h(font_id,char_id,&char_wh); 
			/*get char offset,bmp*/
			if((char_wh.x != 0U)&&(char_wh.y != 0U))
			{
				user_data.char_w	= char_wh.x;
				user_data.char_h	= char_wh.y;
				hmi_avl_insert_head_comparable(proot,														
										&user_data,&pinsert);
				if(pinsert != NULL)
				{
					hmi_cpy_char_bmp_avl(proot,font_id,char_id,&char_pos);
					pinsert->x_index	= (UINT8)(char_pos.x);
					pinsert->y_index	= (UINT8)(char_pos.y);
					status			= HMI_FONT_BMP_NOEXIST_LOAD_SUCCESS;	
					/*get UV*/
					user_data.x_index	= (UINT8)(char_pos.x);
					user_data.y_index	= (UINT8)(char_pos.y);
					hmi_get_font_uv(proot,
								&user_data,
								uv,uv_len);
				}
				else
				{
					status	= HMI_FONT_BMP_NOEXIST_NODE_FULL;	
				}
			}
		}
		else	/*buffer full*/
		{
			status			= HMI_FONT_BMP_NOEXIST_BUFFER_FULL;
		}
	}

	return	status;
}


BOOLEAN hmi_get_string_uv(HMI_AVL_TREE_ROOT_NODE_STR *proot,
						U08 font_id,HMI_CHAR_STR *pstring,
						GLfloat	image_text_uv[],UINT16	uv_len,
						U16		string_array_len,
						HMI_TEXT_LENGTH_STR index_start,
						HMI_TEXT_LENGTH_STR index_end,
						BOOLEAN	*pavl_full
						)
{
	BOOLEAN 			success 	= TRUE;
	UINT16					loop			= 0U;
	HMI_FONT_CHAR_STR		char_id 	= 0U;
	UINT16					cur_index	= 0U;
	UINT8					text_offset = 0U;
	HMI_FONT_CHAR_STR		ret_char		= 0U;
	HMI_GET_AVL_FONT_STATUS status		= HMI_FONT_BMP_STATUS_CNT;
	UINT16					uv_offset		= 0U;
	HMI_CHAR_STR			hmi_hb_char = 0U;
	HMI_CHAR_STR			hmi_lb_char = 0U;
	HMI_TEXT_LENGTH_STR 	index		= 0U;	
	HMI_TEXT_LENGTH_STR 	text_len		= 0U;
	UINT16					uv_len_dyn	= 0U;
	GLuint					buf_texture_id= 0;
	HMI_FONT_CHAR_PROP CONST *pchar_prop= NULL;

	if(pavl_full != NULL)
	{
		*pavl_full	= FALSE;
	}
	
	buf_texture_id	= proot->texture_id;
	if(buf_texture_id != 0)
	{
		/*Active texture*/		
		glActiveTexture(GL_TEXTURE0 + HMI_TEXTURE_UNIT_FONT_BUFFER);				
		glBindTexture ( GL_TEXTURE_2D, buf_texture_id );
		uv_len_dyn	= uv_len;
		index		= index_start;
		while((success == TRUE)&&(index < index_end)&&(pstring[index] != '\0'))
		{
			hmi_hb_char = pstring[index];
			hmi_lb_char = pstring[index + 1];
			char_id = hmi_get_value_char(hmi_hb_char,
							hmi_lb_char,&text_offset);
			if(char_id  != HMI_CHAR_TAB)
			{
				pchar_prop	= hmi_driver_get_char_data2(char_id,font_id);
				index++;
				index	+= text_offset;
				text_len++;
				if((char_id > 32/*BLANK*/)&&(pchar_prop->char_data != 0))
				{
					status	= hmi_load_font_bmp_avl(proot,
													font_id,char_id,
													&image_text_uv[uv_offset]/*u,v*/,
													uv_len_dyn);
					if((status == HMI_FONT_BMP_EXIST)||
						(status == HMI_FONT_BMP_NOEXIST_LOAD_SUCCESS))
					{
						if(uv_len_dyn >= HMI_VERTEX_TEX0_ARRAY_LEN)
						{
							uv_len_dyn	-= HMI_VERTEX_TEX0_ARRAY_LEN;
							uv_offset	+= HMI_VERTEX_TEX0_ARRAY_LEN;
						}
						else
						{
							success = FALSE;
						}
					}
					else if(status == HMI_FONT_BMP_NOEXIST_BUFFER_FULL)
					{
						if(string_array_len <= HMI_FONT_BUFFER_FONT_SIZE)
						{
						#if 0
							glFinish();/*finished previous text*/
							
							/*if buffer full,then destory avl tree node*/
							hmi_avl_tree_destory(proot);
							/*load font again*/
						#if 0
							hmi_load_font_bmp_avl(proot,
											font_id,char_id,
											image_text_uv,uv_len);
						#endif
							hmi_get_string_uv(proot,
											font_id,pstring,
											image_text_uv,uv_len,
											string_array_len,
											index_start,
											index_end);
						#endif
							if(pavl_full != NULL)
							{
								*pavl_full	= TRUE;
							}
							success = FALSE;
						}
						else
						{
							/*set uv--0,0,0,0,0*/

							/*end while*/
							success = FALSE;
						}
					}
					else
					{
						success = FALSE;
					}
				}
			}
			else
			{
				index+=2;
			}
		}
	}
	return	success;
}


