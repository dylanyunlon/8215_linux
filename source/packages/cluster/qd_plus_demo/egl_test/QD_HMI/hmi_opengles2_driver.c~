									phmi_temp_string[hmi_string_temp_index+1],
			//						&hmi_text_offset);
									&hmi_text_offset);
			phmi_font_config	= hmi_driver_get_char_data(hmi_char,
									phmi_font_table,
									font_id);
			if(phmi_font_config != 0U)
			{
				#if  HMI_SCROLL_TEXT_SUPPORT != 0U
				/*get text real length*/
				hmi_text_real_width	+= phmi_font_config->owidth+HMI_CHAR_SPACE;
