BYTE	*hmi_get_char_buffer(UINT8 font_id,HMI_FONT_CHAR_STR char_id,
						UINT16/*UINT8*/	*pchar_w,UINT16/*UINT8*/	*pchar_h)
{	
	BYTE						*pchar				= NULL;
	HMI_FONT_CHAR_PROP CONST	*pchar_prop			= NULL;
	UINT32					address_char			= 0U;
	UINT32					buffer_act_len		= 0U;		
	BYTE						*pfont_tmp_buffer		= NULL;
	UINT32					buffer_max_len		= 0U;
	UINT32					char_len				= 0U;

	pfont_tmp_buffer	= hmi_copy_font_buffer.pfont_tmp_buffer;
	pchar_prop			= hmi_driver_get_char_data2(char_id,font_id);
	buffer_max_len		= HMI_MAX_ONE_CHAR_BUFFER_W * HMI_MAX_ONE_CHAR_BUFFER_H;
	if((pchar_prop != NULL)&&(pchar_w != NULL)&&(pchar_h != NULL))
	{
		if(pchar_prop->char_data !=0)/*added by pxguo230712  */
		{
			(*pchar_w)		= pchar_prop->w;
			(*pchar_h)		= pchar_prop->h;
			char_len			= (*pchar_w) * (*pchar_h);		
			if(pfont_tmp_buffer	== NULL)
			{			
				hmi_copy_font_buffer.pfont_tmp_buffer	= (U08 *)hmi_malloc_vram(buffer_max_len);
				pfont_tmp_buffer						= hmi_copy_font_buffer.pfont_tmp_buffer;	
				if(pfont_tmp_buffer != NULL)
				{
					hmi_copy_font_buffer.len	= buffer_max_len;
				}
				else
				{
					hmi_copy_font_buffer.len	= 0U;
				}
			}
			if(pfont_tmp_buffer != NULL)
			{
				buffer_act_len	= hmi_copy_font_buffer.len;
				if(char_len <= buffer_act_len)
				{
					address_char	= pchar_prop->char_data;	
					hmi_read_data(address_char,char_len,
							pfont_tmp_buffer,char_len,
							0/*font data,shader at 0 segment*/);
					pchar	= pfont_tmp_buffer;
				}
				else
				{
					printf("hmi_get_char_buffer tmp buffer free and realloc" );
					hmi_printf_time(" hmi_get_char_buffer tmp buffer free and realloc",0);
					hmi_dealloc_vram(pfont_tmp_buffer);
					pfont_tmp_buffer	= NULL;
					hmi_copy_font_buffer.pfont_tmp_buffer	= (U08 *)hmi_malloc_vram(char_len);
					pfont_tmp_buffer						= hmi_copy_font_buffer.pfont_tmp_buffer;	
					if(pfont_tmp_buffer != NULL)
					{
						hmi_copy_font_buffer.len	= char_len;
						address_char	= pchar_prop->char_data;	
						hmi_read_data(address_char,char_len,
									pfont_tmp_buffer,char_len,
									0/*font data,shader at 0 segment*/);
						pchar	= pfont_tmp_buffer;
					}
					else
					{
						hmi_copy_font_buffer.len	= 0U;
					}
				}
			}
			else
			{
				/*set malloc error*/
				printf("hmi_malloc_vram failed\n");
				hmi_printf_time(" hmi_get_char_buffer hmi_malloc_vram failed",0);
			}
		}
	}

	return	pchar;
}


void hmi_cpy_char_bmp_avl(HMI_AVL_TREE_ROOT_NODE_STR *proot,UINT8 font_id,
						HMI_FONT_CHAR_STR char_id,POINT_TP	*pchar_xy)
{
	UINT16		cur_buffer_index		= 0U;
	BYTE			*pbig_font_buffer		= NULL;
	UINT16		char_w				= 0U;
	UINT16		char_h				= 0U;
	GLint		xoffset				= 0;
	GLint		yoffset				= 0;
	GLsizei		font_buf_height		= 0;
	UINT16		font_w				= 0U;
	UINT16		font_h				= 0U;
	void			*ppixels				= NULL;
	
	if((proot != NULL)&&(pchar_xy != NULL))
	{		
		font_w			= proot->font_w;
		font_h			= proot->font_h;
		cur_buffer_index	= proot->cur_buffer_index;
		pbig_font_buffer	= proot->pbig_font_buffer;		
		if((cur_buffer_index < HMI_FONT_BUFFER_FONT_SIZE)&&(pbig_font_buffer != NULL))
		{
			font_buf_height	= (proot->font_h) * HMI_FONT_BUFFER_FONT_Y;
			pchar_xy->x		= cur_buffer_index % HMI_FONT_BUFFER_FONT_X;
			pchar_xy->y		= cur_buffer_index / HMI_FONT_BUFFER_FONT_X;
			xoffset			= pchar_xy->x;
			yoffset			= pchar_xy->y;
			/*copy font bmp */
			ppixels	= hmi_get_char_buffer(font_id,char_id,&char_w,&char_h);
			if(ppixels != NULL)
			{
				xoffset	= xoffset * font_w;
				yoffset	= yoffset * font_h;
				
				glTexSubImage2D(GL_TEXTURE_2D,0,
								xoffset,yoffset,
								(GLsizei)(char_w),(GLsizei)(char_h),
								GL_ALPHA,GL_UNSIGNED_BYTE,
								ppixels); 
			}
				
			proot->cur_buffer_index++;
		}
	}
}

