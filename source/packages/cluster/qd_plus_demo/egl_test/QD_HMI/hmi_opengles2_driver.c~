void set_light_material(DIRECTIONAL_LIGHT_STR	*pdirectLight ,MATERIAL_PROPERTIES_STR *pvertexMaterial)
{
	U08					screen 					= 0u;
	S3POINT_FLOAT_TP	light_pos				= {0.0f,0.0f,0.0f};
	GLfloat direction[HMI_POS_COMPONENT_COUNT]	= {0.0f,0.0f,0.0f};
	
	if(hmi_loc_qd_unit < HMI_SCREEN_NO)
	{
		screen	= hmi_loc_qd_unit;
	}
	
	if(pdirectLight != NULL)
	{
		/*convert opengl coordinate*/
		light_pos.x	= (*pdirectLight).direction[HMI_POS_X];
		light_pos.y	= (*pdirectLight).direction[HMI_POS_Y];
		light_pos.z	= (*pdirectLight).direction[HMI_POS_Z];
		get_screen_center_coordinate_reverse_y_3d(&light_pos,screen);
		direction[HMI_POS_X]	= light_pos.x;
		direction[HMI_POS_Y]	= light_pos.y;
		direction[HMI_POS_Z]	= light_pos.z;
		/*light*/
		glUniform3fv(hmi_user_data.u_light_direction_id,
					1,direction);

		glUniform4fv(hmi_user_data.u_light_ambient_color_id,
					1,(*pdirectLight).ambient_color);

		glUniform4fv(hmi_user_data.u_light_diffuse_color_id,
					1,(*pdirectLight).diffuse_color);

		glUniform4fv(hmi_user_data.u_light_specular_color_id,
					1,(*pdirectLight).specular_color);

		/*	camera position		*/
		glUniform3fv(hmi_user_data.u_camera_id,
					1,(*pdirectLight).camera_pos);

		glUniform1f(hmi_user_data.u_light_specular_exponent_id,
						(*pdirectLight).specular_exponent);	
	}
	
	if(pvertexMaterial != NULL)
	{
		/*material */
		glUniform4fv(hmi_user_data.u_material_ambient_color_id,
					1,(*pvertexMaterial).ambient_color);

		glUniform4fv(hmi_user_data.u_material_diffuse_color_id,
					1,(*pvertexMaterial).diffuse_color);

		glUniform4fv(hmi_user_data.u_material_specular_color_id,
					1,(*pvertexMaterial).specular_color);
		
	}
}


/*
coordinate transform.
origin at screen center(x-->left,y-->down)
*/
void hmi_convert_clip_rect(HMI_RECT_STR *prect,U08 winNo)
{
	INT32			bottom_y	= 0;
	
	if((prect != NULL)&&(winNo < HMI_SCREEN_NO))
	{
		bottom_y	= prect->y + prect->h;
		prect->y	= (HMI_Y_STR)(hmi_screen_size[winNo].y/*screen height*/ - bottom_y);
	}
}




