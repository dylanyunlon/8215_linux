				axis[HMI_ROTATION_PUBLIC_AXIS2].y	= (float_32)(protation_axis[HMI_ROTATION_PUBLIC_AXIS2].y);
				axis[HMI_ROTATION_PUBLIC_AXIS2].z	= (float_32)(protation_axis[HMI_ROTATION_PUBLIC_AXIS2].z);
				
				/*reverse y */
				axis[HMI_ROTATION_PRIVATE_AXIS].y	= -axis[HMI_ROTATION_PRIVATE_AXIS].y;
				get_screen_center_coordinate_reverse_y_3d(
									&axis[HMI_ROTATION_PUBLIC_AXIS1],
									screen);
				get_screen_center_coordinate_reverse_y_3d(
									&axis[HMI_ROTATION_PUBLIC_AXIS2],
									screen);				
				/*get private axis normal vector*/
				hmi_normalise_s3point_float2(&axis[HMI_ROTATION_PRIVATE_AXIS],
											&private_normal);
				private_normal_x	= private_normal.x;
				private_normal_y	= private_normal.y;
				private_normal_z	= private_normal.z;
				
				/*get public axis normal vector*/	
				pos_to_public1_x = axis[HMI_ROTATION_PUBLIC_AXIS1].x - display_rect_center.x;
				pos_to_public1_y = axis[HMI_ROTATION_PUBLIC_AXIS1].y - display_rect_center.y;
				pos_to_public1_z = axis[HMI_ROTATION_PUBLIC_AXIS1].z - zTrans;
			
				public_axis.x	= axis[HMI_ROTATION_PUBLIC_AXIS2].x - axis[HMI_ROTATION_PUBLIC_AXIS1].x; 
				public_axis.y	= axis[HMI_ROTATION_PUBLIC_AXIS2].y - axis[HMI_ROTATION_PUBLIC_AXIS1].y; ;
				public_axis.z	= axis[HMI_ROTATION_PUBLIC_AXIS2].z - axis[HMI_ROTATION_PUBLIC_AXIS1].z; ;
				
				hmi_normalise_s3point_float2(&public_axis,
											&public_normal);
				normal_x	= public_normal.x;
				normal_y	= public_normal.y;
				normal_z	= public_normal.z;
			}

			ang				= pcube_str->angel;			
			private_ang		= pcube_str->private_angel;
									
			/*set render side*/
			side	= paxis->attribute & HMI_SURFACE_SIDE_MASK;
			if(side == HMI_SURFACE_CCW)
			{								
				glCullFace(GL_BACK);
				glEnable(GL_CULL_FACE);								
			}
			else if(side == HMI_SURFACE_CW)
			{				
				glCullFace(GL_FRONT);
				glEnable(GL_CULL_FACE);
			}
			else if(side == HMI_SURFACE_DOUBLE_SIDE)
			{				
				glDisable(GL_CULL_FACE);
			}
			else
			{				
				glDisable(GL_CULL_FACE);
			}
				
			/* Identity and Set texture */							
			matrix_load_identity(&modelview );						
			hmi_blend_mode(HMI_BLEND_TRANSPARENT);	
						
			if(pcube_textrue != NULL)
			{
				hmi_get_cube_texture(pcube_textrue,texture);
			}
									
			/* Identity matrix */							
			matrix_load_identity(&modelview ); 								
			if(rotation_axis == HMI_CUBE_ROTATION_USERDEFINE)
			{	
				/*Traslate to originate*/					
				matrix_translate(&modelview,
								0.0f, 
								0.0f, 
								HMI_PERSPECTIVE_POS);
																		
				matrix_translate(&modelview,
								display_rect_center.x, 
								display_rect_center.y, 
								zTrans);						
														
				if(fabs(ang) > HMI_FLOAT_TOLERANCE)
				{											
					matrix_translate(&modelview,
									pos_to_public1_x, 
									pos_to_public1_y, 
									pos_to_public1_z);
					
					matrix_rotate(&modelview,
								ang,
								normal_x/*rotation_x*/,
								normal_y/*rotation_y*/,
								normal_z/*rotation_z*/,
								TRUE);
					
					matrix_translate(&modelview,
									-pos_to_public1_x, 
									-pos_to_public1_y, 
									-pos_to_public1_z);
											
				}
				if(fabs(private_ang) > HMI_FLOAT_TOLERANCE)
				{						
					matrix_rotate(&modelview,
								private_ang,
								private_normal_x/*rotation_x*/,
								private_normal_y/*rotation_y*/,
								private_normal_z/*rotation_z*/,
								TRUE);									
				}																			
			}
				
			/*scale display rect*/					
			matrix_scale(&modelview,
					center_scale.scale_x,
					center_scale.scale_y,
					1.0f);	
			/*scale */
			matrix_scale(&modelview,
					pcube_str->scale,
					pcube_str->scale,
					pcube_str->scale);
			if(1/*pcube_str->bump == FALSE*/)
			{
				if((texture[0].pbitmap_data.w)!= 0U)
				{
					/*set big image current texture*/						
					status		= hmi_set_cur_texture(&texture[0]);						
					/*set rect uv coordinate*/
					pbig_img	= hmi_get_big_image_addr(hmi_cur_texture.seg_no,
											hmi_cur_texture.fmt_index ,
											hmi_cur_texture.index);
					
					hmi_get_uv_rect_from_big_image(pbig_img,
											&texture[0],
											image_vertex_tex0,
											HMI_VERTEX_TEX0_ARRAY_LEN);
					/* Set the sampler texture unit to 0 */
					glUniform1i(hmi_user_data.tex_sample_id, HMI_TEXTURE_UNIT_BMP );						
					
					matrix_load_identity(&view);	 
					camera_position.x	= (float_32)(pcamera->position.x);
					camera_position.y	= (float_32)(pcamera->position.y);
					camera_position.z	= (float_32)(pcamera->position.z);
					get_screen_center_coordinate_reverse_y_3d(
									&camera_position,screen);
					
					camera_target.x	= (float_32)(pcamera->target.x);
					camera_target.y	= (float_32)(pcamera->target.y);
					camera_target.z	= (float_32)(pcamera->target.z);
					get_screen_center_coordinate_reverse_y_3d(
									&camera_target,screen);

					camera_up.x		= (float_32)(pcamera->up.x);
					camera_up.y		= (float_32)(pcamera->up.y);
					camera_up.z		= (float_32)(pcamera->up.z);
					camera_up.y		= -camera_up.y;	/*coordinate at object center,only reverse y*/
					
					matrix_look_at(&view,
								camera_position.x,camera_position.y,camera_position.z,
								camera_target.x,camera_target.y,camera_target.z,
								camera_up.x,camera_up.y,camera_up.z);											
					matrix_multiply(&model_x_view,
									&modelview   ,
									&view);
					/*PersProjTrans * CameraRotateTrans * CameraTranslationTrans * 
						TranslationTrans * RotateTrans * ScaleTrans;*/
					if((pcamera->camera_near < pcamera->camera_far)&&
						(pcamera->camera_near > 0.0f))
					{
						matrix_load_identity(&near_far_perspective_matrix);	
						matrix_near_far_perspective(&near_far_perspective_matrix,
													pcamera->camera_near,
													pcamera->camera_far);
						matrix_multiply(&mvp_matrix,
									&model_x_view,
									&near_far_perspective_matrix);																	
					}
					else
					{
						matrix_multiply(&mvp_matrix,
									&model_x_view,
									&perspective_matrix);
					}
							
					glUniformMatrix4fv(hmi_user_data.mvp_unform_id, 
										1, GL_FALSE, 
									(GLfloat*)(&(mvp_matrix.m[0][0])));						
					hmi_set_draw_type(HMI_UNIFORM_CUBE_IMAGE_TYPE,
								attribute, global_alpha);
					glEnable(GL_SCISSOR_TEST);
				#ifdef HMI_RENDER_FULL_SCREEN	
					/*Clip zone is parent zone. pdirty_rect is parent and dirty zone intersection*/	
					hmi_min_dirty_rect.x	= pdirty_rect->x;
					hmi_min_dirty_rect.y	= pdirty_rect->y;
					hmi_min_dirty_rect.w	= pdirty_rect->w;
					hmi_min_dirty_rect.h	= pdirty_rect->h;
					
					/*scissor*/
					hmi_convert_clip_rect(&hmi_min_dirty_rect,screen);
					glScissor((GLint)(hmi_min_dirty_rect.x),(GLint)(hmi_min_dirty_rect.y),
								(GLsizei)(hmi_min_dirty_rect.w),(GLsizei)(hmi_min_dirty_rect.h));					
							    
					if(success_frmbuf == TRUE)
					{
						glUniformMatrix4fv(hmi_user_data.mvp_unform_id, 
										1, GL_FALSE, 
									(GLfloat*)(&(mvp_matrix.m[0][0])));						
						hmi_set_draw_type(HMI_UNIFORM_CUBE_IMAGE_TYPE,
										attribute, global_alpha);
						hmi_draw_primitive_withvbos(HMI_IMAGE_VERTEX_CNT,
										pvtx_buf,
										vtx_strides,
										HMI_VERTEX_INDICS_ARRAY_LEN,
										image_vertex_index,
										HMI_UNIFORM_CUBE_IMAGE_TYPE);
												
						/*restory old framebuffer*/
						restory_frambuffer(old_framebuffer,
									hmi_screen_size[screen].x,
									hmi_screen_size[screen].y);
						restory_frmbuf	= TRUE;
						
						glUniform1i(hmi_user_data.tex_sample_id, 
									HMI_TEXURE_UINT_FRMBUF);
						hmi_driver_draw_image(&hmi_disp_target,
											pdirty_rect,pclip_rect,
											texture_frmbuf,screen,
											255,0.0f,1.0f);
												
					}			
				#else
					clip_index			= 0U;
					next_clip_index 	= HMI_LAYER_MAX_CNT+HMI_DIRTY_FIFO_LEN * layer;
					while((clip_index < HMI_DIRTY_FIFO_LEN)&& 		
							(pdirty_rect[next_clip_index].w > 0U)&&	
							(pdirty_rect[next_clip_index].h > 0U))
					{							
						/*Clip zone is parent zone. pdirty_rect is parent and dirty zone intersection*/	
						hmi_min_dirty_rect.x	= pdirty_rect->x;
						hmi_min_dirty_rect.y	= pdirty_rect->y;
						hmi_min_dirty_rect.w	= pdirty_rect->w;
						hmi_min_dirty_rect.h	= pdirty_rect->h;
					
						if((hmi_min_dirty_rect.w > 0U)&&((hmi_min_dirty_rect.h > 0U)))
						{
							/*scissor*/
							hmi_convert_clip_rect(&hmi_min_dirty_rect,screen);
							glScissor((GLint)(hmi_min_dirty_rect.x),(GLint)(hmi_min_dirty_rect.y),
										(GLsizei)(hmi_min_dirty_rect.w),(GLsizei)(hmi_min_dirty_rect.h));
							
							hmi_draw_primitive_withvbos(HMI_IMAGE_VERTEX_CNT,
													pvtx_buf,
													vtx_strides,
													HMI_VERTEX_INDICS_ARRAY_LEN,
													image_vertex_index,
													HMI_UNIFORM_CUBE_IMAGE_TYPE);
						}
						clip_index++;
						next_clip_index ++;
					}
				#endif						
				}
			}
			else	/*bump*/
			{
				/*not support*/										
			}
			/*restory old framebuffer*/
			if(restory_frmbuf == FALSE)
			{
				restory_frambuffer(old_framebuffer,
							hmi_screen_size[screen].x,
							hmi_screen_size[screen].y);
			}
			/*after finish ,release framebuffer resource*/						
			release_frambuffer_res(&framebuffer,
								&depthRenderbuffer,
								&texture_frmbuf,
								&old_framebuffer);
		}
#endif
}
