										UINT8					layer,
										HMI_ROTATION_STR		*protation,/*rotation point,NULL mean center point*/
										HMI_OBJECT_ID_STR		hmi_object_id,	
										HMI_ALPHA_SCALE_PT_STR *pfather_alpha_scale
	)
{

	HMI_RECT_STR	clip_rect 					= { 0,0,0U,0U };
	BOOLEAN			balpha 						= FALSE;
	UINT8			image_compress_fmt 			= 0U;
	UINT8			bmp_alpha_rotation_flag 	= ((img_compress.image_attr) & 0xf0);
	HMI_RECT_STR	hmi_disp_target				= { 0,0,0U,0U };
