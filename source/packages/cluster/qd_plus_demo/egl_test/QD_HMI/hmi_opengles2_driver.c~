U08 *hmi_Init2DImg(HMI_BITMAP_STR		CONST		*pdata/*flash address*/,							
							TEXTURE_2D_PIXEL_FORMAT		pixel_fmt,							
							U32						*pdecode_image_len)
{
	U08								*p_decode_buffer		= NULL;   	
	U32								decode_image_len		= 0U;	
	BOOLEAN						read_success			= FALSE;
	BOOLEAN						success				= FALSE;
	BOOLEAN							release_success			= FALSE; 	
	UINT32							seg_no					= 0U;
	UINT32							index					= 0U;
	HMI_BIG_IMAGE_INDEX_STR			fmt_index				= HMI_MAX_CNT_BIG_IMAGE;
	HMI_DECODE_STATUS_STR			decode_status			= HMI_DECODE_STATUS_CNT;
	HMI_BIG_IMAGE_ADDR_STR	CONST	*pbitmap_data		= NULL;
	HMI_FMT_BIG_IMAGE_STR	CONST	*pbig_img_addr		= NULL;

	if((pdata != NULL)&&(pdecode_image_len != NULL))
	{
		pbitmap_data	= &(pdata->pbitmap_data);	
		seg_no			= pbitmap_data->seg_no;
		fmt_index		= pbitmap_data->fmt_index;
		index			= pbitmap_data->index;

		pbig_img_addr	= hmi_get_big_image_addr(seg_no,
										fmt_index,index);
		if(pbig_img_addr != NULL)
		{
			decode_image_len	= pbig_img_addr->data_len;
			if((fmt_index == HMI_JPG_BIG_IMAGE)||
				(fmt_index == HMI_RLE_ARGB8888_BIG_IMAGE)||
				(fmt_index == HMI_RLE_RGB888_BIG_IMAGE))/*need decode*/
			{
				decode_image_len	= hmi_get_decode_buffer_len(pixel_fmt,
												pbig_img_addr->w,
												pbig_img_addr->h);	
			}
		}
		/*malloc decode data memory*/
		p_decode_buffer	= hmi_malloc_memory(decode_image_len);
					
		/*decode every image*/
		if(p_decode_buffer != NULL)
		{			
			#if (HMI_DMA_ENABLE == HMI_NO)																
			/* decode compress image  or copy no compress image to buffer*/
			decode_status	= hmi_decode_image(fmt_index,
											pbig_img_addr->offset,
											pixel_fmt,
											pbig_img_addr->w,
											pbig_img_addr->h,
											p_decode_buffer,
											decode_image_len,
											pbig_img_addr->data_len,
											seg_no);
			
			if(decode_status == HMI_DECODE_IMAGE_SUCCESS)
			{
				success			= TRUE;
			}					
						
			#else
			
			#endif			
			
			if(success	== FALSE)
			{
				hmi_dealloc_vram(p_decode_buffer);
				p_decode_buffer	= NULL;
			}	
		}
		else
		{		
			hmi_qd_error_handler(HMI_RGL_IMAGE_NOT_ENOUGH_MEM); 
			hmi_printf_time("error errror HMI_RGL_IMAGE_NOT_ENOUGH_MEM ",0);
			printf("hmi_Init2DImg error\n");
			hmi_printf_time(" hmi_Init2DImg error",0);
			
			#if(HMI_ENDLESS_LOOP == YES)
			//while(1);/* malloc memory failed. */ //2023 05 13
			#endif
		}
		
		*pdecode_image_len	= decode_image_len;			
		
	}
	
	return p_decode_buffer;
}



#define HMI_MUL_TEXTURE_SPACE			0
void call_C_hmi_driver_draw_mul_texture_image(HMI_RECT_STR CONST 	*pscreen_target,
								HMI_IMAGE_ATTR_STR		img_compress,
								HMI_RECT_ALPHA_ANGEL_STR *palpha_pos_angel,											
								HMI_BITMAP_STR CONST 	*pimage_prop_info,
								HMI_RECT_STR			*pclip_rect,
								HMI_RECT_STR			*pdirty_rect,
								UINT8					layer,								
								HMI_ROTATION_STR		*protation,/*rotation point,NULL mean center point*/
								HMI_OBJECT_ID_STR		hmi_object_id,
								#if (defined(HMI_GRAPHIC_OPENGLES)||defined(HMI_GRAPHIC_RGL))
								UINT8					father_alpha,
								#endif
								HMI_MUL_TEXTURE_LEN_INDEX_STR CONST	*pmul_texture_prop,
								HMI_TEXTURE_RECT_STR			*pmul_texture_rect_list
								)	
{
	HMI_RECT_STR	hmi_disp_target			= { 0,0,0U,0U };
	UINT8			mul_texture_len			= pmul_texture_prop->mul_bmp_len;
	UINT8			mul_texture_index		= pmul_texture_prop->mul_bmp_index;
	HMI_BITMAP_STR  mul_image_prop_info		={0};
	
	if((pscreen_target != NULL)&&(palpha_pos_angel != NULL)&&
		(pimage_prop_info != NULL)&&(pclip_rect != NULL))
	{		
		/*display zone*/
		hmi_disp_target.x	= pscreen_target->x;
		hmi_disp_target.y	= pscreen_target->y;	
		hmi_disp_target.w	= pscreen_target->w;
		hmi_disp_target.h	= pscreen_target->h;
		
		mul_image_prop_info.pbitmap_data.seg_no = pimage_prop_info ->pbitmap_data.seg_no;
		mul_image_prop_info.pbitmap_data.index = pimage_prop_info ->pbitmap_data.index;
		mul_image_prop_info.pbitmap_data.fmt_index = pimage_prop_info ->pbitmap_data.fmt_index;
		
		
		while((mul_texture_len > 0U)&&
			(pmul_texture_rect_list[mul_texture_index].texture_w !=0)&&
			(pmul_texture_rect_list[mul_texture_index].texture_h !=0))
		{
			mul_image_prop_info.pbitmap_data.x = pimage_prop_info ->pbitmap_data.x+(pmul_texture_rect_list[mul_texture_index].texture_x);
			mul_image_prop_info.pbitmap_data.y = pimage_prop_info ->pbitmap_data.y+(pmul_texture_rect_list[mul_texture_index].texture_y);
			mul_image_prop_info.pbitmap_data.w = (pmul_texture_rect_list[mul_texture_index].texture_w);
			mul_image_prop_info.pbitmap_data.h = (pmul_texture_rect_list[mul_texture_index].texture_h);
			call_C_hmi_driver_draw_image((&hmi_disp_target),
										img_compress,
										palpha_pos_angel,
										&mul_image_prop_info,
										pclip_rect,
										pdirty_rect,
										layer,
										protation,/*rotation point,NULL mean center point*/
										hmi_object_id,
										NULL/*father_alpha*/);
			hmi_disp_target.x  += pmul_texture_rect_list[mul_texture_index].texture_w+HMI_MUL_TEXTURE_SPACE;
			mul_texture_index++;
			mul_texture_len--;
		} 
	}

}


void hmi_get_uv_rect_from_one_image(					
								GLfloat	*ptexture_uv,
								BYTE	texture_uv_len)
{	
	BYTE		index	= 0U;
	
	if((texture_uv_len <= HMI_VERTEX_TEX0_ARRAY_LEN)&&
		(ptexture_uv != NULL))
	{		
		/*left,upper*/		
		ptexture_uv[index++]	= 0.0f;
		ptexture_uv[index++]	= 1.0f;

		/*left,bottom*/		
		ptexture_uv[index++]	= 0.0f;
		ptexture_uv[index++]	= 0.0f;

		/*right,bottom*/		
		ptexture_uv[index++]	= 1.0f;
		ptexture_uv[index++]	= 0.0f;

		/*right,upper*/				
		ptexture_uv[index++]	= 1.0f;
		ptexture_uv[index++]	= 1.0f;								
	}
}


/*
only draw rect zone
*/
void hmi_draw_primitive_withvbos(GLint numVertices, 
							GLfloat **vtxBuf,
							GLint *vtxStrides, 
							GLint numIndices,
							GLushort *indices,
							HMI_UNIFORM_IMAGE_TYPE_STR draw_type)
{	
		GLenum lastError = GL_NO_ERROR;

		if((vtxStrides != NULL)&&(indices != NULL) && (vtxBuf != NULL))	/*lq*/
		{
			hmi_disable_vertex_Array();
		   /*Load the vertex position */	  
		   glVertexAttribPointer ( VERTEX_POS_INDX, 
		   					VERTEX_POS_SIZE,
							GL_FLOAT, 
							GL_FALSE, 
							vtxStrides[HMI_STRIDE_VERTEX_POSITION], 
							vtxBuf[HMI_STRIDE_VERTEX_POSITION] );
		   
		   
			if((draw_type == HMI_UNIFORM_CUBE_COLOR_TYPE)||
				(draw_type == HMI_UNIFORM_FILL_COLOR_TYPE)/*||
				(draw_type == HMI_UNIFORM_SPLINE_COLOR_TYPE)*/)
			{	
				glVertexAttribPointer(VERTEX_COLOR_INDX, 
									VERTEX_COLOR_SIZE,
									GL_FLOAT,
									GL_FALSE, 
									vtxStrides[HMI_STRIDE_VERTEX_COLOR],
									vtxBuf[HMI_STRIDE_VERTEX_COLOR]);
				
				glEnableVertexAttribArray(VERTEX_COLOR_INDX );
			}
			else
			{
				/* Load the texture coordinate*/
				glVertexAttribPointer( VERTEX_TEXCOORD0_INDX,
			   						VERTEX_TEXCOORD0_SIZE, 
			   						GL_FLOAT,
									GL_FALSE, 
									vtxStrides[HMI_STRIDE_VERTEX_TEXTURE],
									vtxBuf[HMI_STRIDE_VERTEX_TEXTURE]);
				glEnableVertexAttribArray (VERTEX_TEXCOORD0_INDX );
				
				if(draw_type == HMI_UNIFORM_ETC1_ALPHA_TYPE)
				{
					glVertexAttribPointer( VERTEX_TEXCOORD1_INDX,
			   						VERTEX_TEXCOORD1_SIZE, 
			   						GL_FLOAT,
									GL_FALSE, 
									vtxStrides[HMI_STRIDE_VERTEX_TEXTURE_ETC1_ALPHA],
									vtxBuf[HMI_STRIDE_VERTEX_TEXTURE_ETC1_ALPHA]);
					
					glEnableVertexAttribArray (VERTEX_TEXCOORD1_INDX );
				}
			}
				
			glEnableVertexAttribArray (VERTEX_POS_INDX );
			lastError = glGetError();
			if (lastError != GL_NO_ERROR)
			{
				printf("hmi_draw_primitive_withvbos error\n");
				fprintf(stderr, "hmi_draw_primitive_withvbos error\n");
			}
		   
			glDrawElements (GL_TRIANGLES,
							HMI_6_VERTEX, 
							GL_UNSIGNED_SHORT,
							indices);
	  	
		  	lastError = glGetError();
			if (lastError != GL_NO_ERROR)
			{
				printf("hmi_draw_primitive_withvbos error\n");
				fprintf(stderr, "hmi_draw_primitive_withvbos error\n");
			}
		}
}



void drawPrimitiveWithoutVBOs(GLfloat *pvtxBuf[], GLint vtxStride[],
								GLint numIndices, GLushort *pindices,
								BOOLEAN	uv,BOOLEAN oneColor)
{	
	BOOLEAN		bcheck_ok	= TRUE;
	
	if(pindices != NULL)	/*lq*/
	{
		glBindBuffer(GL_ARRAY_BUFFER, 0);
		glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);

		hmi_disable_vertex_Array();
		/*Enable vertex*/
		glEnableVertexAttribArray(VERTEX_POS_INDX);	
		if(uv	== TRUE)
		{
			glEnableVertexAttribArray(VERTEX_TEXCOORD0_INDX);
		}
		else
		{
			if(oneColor == FALSE)
			{
				glEnableVertexAttribArray(VERTEX_COLOR_INDX);
			}
		}


		/*set vertex array*/
		if(pvtxBuf[HMI_STRIDE_VERTEX_POSITION] != NULL) /*lq*/
		{
			glVertexAttribPointer(VERTEX_POS_INDX, VERTEX_POS_SIZE,
								GL_FLOAT, GL_FALSE, 
								vtxStride[HMI_STRIDE_VERTEX_POSITION], 
								pvtxBuf[HMI_STRIDE_VERTEX_POSITION]);
		}
		else
		{
			bcheck_ok	= FALSE;
		}

			
		if(uv == TRUE)
		{		
			if(pvtxBuf[HMI_STRIDE_VERTEX_TEXTURE] != NULL) /*lq*/
			{
				glVertexAttribPointer(VERTEX_TEXCOORD0_INDX,
									VERTEX_TEXCOORD0_SIZE, GL_FLOAT,
									GL_FALSE, 
									vtxStride[HMI_STRIDE_VERTEX_TEXTURE], 
									pvtxBuf[HMI_STRIDE_VERTEX_TEXTURE]);
			}
			else
			{
				bcheck_ok	= FALSE;
			}

			if(pvtxBuf[HMI_STRIDE_VERTEX_TEXTURE_ETC1_ALPHA] != NULL)
			{				
				glVertexAttribPointer(VERTEX_TEXCOORD1_INDX,
									VERTEX_TEXCOORD1_SIZE, GL_FLOAT,
									GL_FALSE, 
									vtxStride[HMI_STRIDE_VERTEX_TEXTURE_ETC1_ALPHA], 
									pvtxBuf[HMI_STRIDE_VERTEX_TEXTURE_ETC1_ALPHA]);
				glEnableVertexAttribArray(VERTEX_TEXCOORD1_INDX);
				
				
			}		
		}
		else
		{
			if(oneColor == FALSE)
			{
				if(pvtxBuf[HMI_STRIDE_VERTEX_COLOR] != NULL) /*lq*/
				{
					glVertexAttribPointer(VERTEX_COLOR_INDX,
									VERTEX_COLOR_SIZE, GL_FLOAT,
									GL_FALSE, 
									vtxStride[HMI_STRIDE_VERTEX_COLOR], 
									pvtxBuf[HMI_STRIDE_VERTEX_COLOR]);
				}
				else
				{
					bcheck_ok	= FALSE;
				}
			}
		}

		if(bcheck_ok == TRUE)	/*lq*/
		{
			glDrawElements(GL_TRIANGLES, numIndices,
								GL_UNSIGNED_SHORT,
								pindices);	
		}
	}		
}

