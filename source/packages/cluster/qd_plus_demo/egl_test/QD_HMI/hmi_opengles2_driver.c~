void hmi_init_avl_array(struct HMI_AVL_TREE_NODE_STR *parray,
							UINT16		max_tree_node_cnt,
							BYTE			array_no,
							SINT16		last_node_free_index)
{
	UINT16		loop		= 0U;
	UINT16		free_no 	= 0U;
	
	if(parray != NULL)
	{
		free_no = array_no * max_tree_node_cnt;
		for(loop = 0U;loop < max_tree_node_cnt;loop++)
		{
			hmi_avl_init_node(&parray[loop]);
			parray[loop].next_free_index	= free_no + loop + 1/*next*/;
		}
		if(max_tree_node_cnt > 0)
		{
			parray[max_tree_node_cnt - 1].next_free_index	= last_node_free_index;
		}
	}
}

/*
get index by pnode,then delete
*/
void hmi_avl_del_node(HMI_AVL_TREE_ROOT_NODE_STR *proot,
						struct HMI_AVL_TREE_NODE_STR *pnode)
{
	BOOLEAN 				end 					= FALSE;
	BYTE						array_no				= 0U;
	BYTE						array_loop			= 0U;
	BYTE						array_index 			= 0U;
	SINT32					free_node			= 0;
	UINT16					max_tree_node_cnt	= 0U;		
	SINT32					free_node_index 		= -1;	
	struct HMI_AVL_TREE_NODE_STR	**pparray_tree	= NULL;
	struct HMI_AVL_TREE_NODE_STR	*parray_begin		= NULL;
	struct HMI_AVL_TREE_NODE_STR	*parray_end 		= NULL;
	
	pparray_tree		= proot->parray_tree;
	max_tree_node_cnt	= proot->max_tree_node_cnt;
	
	for(array_loop = 0U;(array_loop < HMI_MAX_TREE_CNT)&&(end == FALSE);array_loop++)
	{
		if(pparray_tree[array_loop] != NULL)
		{
			parray_begin	= pparray_tree[array_loop]; 		
			parray_end		= parray_begin + max_tree_node_cnt;
			if((pnode >= parray_begin)&&(pnode < parray_end))
			{
				free_node_index = array_loop * max_tree_node_cnt;
				while(parray_begin < pnode)
				{
					free_node_index++;
					parray_begin++;
				}
			}
			end = TRUE; 
		}
	}

	if(free_node_index >= 0)
	{				
		hmi_avl_set_free_index(pnode,
							(SINT16)(proot->free_node_head));
		proot->free_node_head	= free_node_index;
	}
}


struct HMI_AVL_TREE_NODE_STR *hmi_avl_new_node(HMI_AVL_TREE_ROOT_NODE_STR *proot)
{
	struct HMI_AVL_TREE_NODE_STR 	*pret_node 			= NULL;
	UINT16						max_tree_node_cnt	= 0U;		
	SINT32						free_node_head		= 0;
	struct HMI_AVL_TREE_NODE_STR	**pparray_tree		= NULL;
	BYTE							array_no				= 0U;
	BYTE							array_loop			= 0U;
	BYTE							array_index 			= 0U;
	SINT32						free_node			= 0;
	BOOLEAN 					end 					= FALSE;
	UINT32						len 					= 0U;
	UINT32						size					= 0U;
	
	if(proot != NULL)
	{
		pparray_tree		= proot->parray_tree;
		max_tree_node_cnt	= proot->max_tree_node_cnt;
		free_node_head		= proot->free_node_head;
		free_node			= free_node_head;
		if(free_node >= 0)/*get free node*/
		{
			array_no	= (BYTE)(free_node / max_tree_node_cnt);
			array_index = (BYTE)(free_node % max_tree_node_cnt);
			pret_node	= pparray_tree[array_no];
			pret_node	= pret_node + array_index;
			/*out from free list*/
			proot->free_node_head	= pret_node->next_free_index;
		}
		else	/*need malloc*/
		{
			size	= sizeof(struct HMI_AVL_TREE_NODE_STR);
			for(array_loop = 0U;(array_loop < HMI_MAX_TREE_CNT)&&(end == FALSE);array_loop++)
			{
				if(pparray_tree[array_loop] == NULL)
				{
					len 						= max_tree_node_cnt * size;
					pparray_tree[array_loop]	= (struct HMI_AVL_TREE_NODE_STR *)hmi_malloc_vram(len);
					if(pparray_tree[array_loop] == NULL)
					{
						/*set error malloc*/
						printf("malloc failed\n");
						hmi_printf_time(" pparray_tree malloc failed",array_loop);
					}
					else	
					{
						hmi_init_avl_array(pparray_tree[array_loop],
											max_tree_node_cnt,
											array_loop,
											(SINT16)free_node_head);
						proot->free_node_head	= array_loop * max_tree_node_cnt;
						/*get free node again*/
						pret_node	= hmi_avl_new_node(proot);
					}
					end = TRUE;
				}
				else	/*lq*/
				{
					//printf("get font buffer failed \n");
					hmi_printf_time(" get font buffer failed",0);
				}
			}
		}
	}

	return	pret_node;
}

SINT32 hmi_avl_cmp(HMI_AVL_TREE_USER_DATA_STR *pdata1,
						HMI_AVL_TREE_USER_DATA_STR *pdata2)
{
	SINT32		cmp = 0;

	if((pdata1 != NULL)&&((pdata2 != NULL)))
	{
		if((pdata1->key) < (pdata2->key))
		{
			cmp = -1;
		}
		else if((pdata2->key) < (pdata1->key))
		{
			cmp = 1;
		}
		else
		{
			cmp = 0;
		}
	}
	
	return		cmp;
}

