U08 hmi_get_follow_trail_vertex(U08 beg_no,U08 end_no,SPOINT_TP *pbeg_vertex,
						SPOINT_TP *pend_vertex,U16 circle_radius_w,U16 circle_radius_h,
						SPOINT_TP *pdisplay_container_pos,BOOLEAN	CCW)
{
	U08				vertex_num		= 0U;
	SPOINT_TP		quard_vertex[4]	= {0,0};
	float_32		ds				= 0.0f;
	float_32		dx				= 0.0f;
	float_32		dy				= 0.0f;

	if((pbeg_vertex != NULL)&&
		(pend_vertex != NULL)&&
		(pdisplay_container_pos != NULL))	/*lq*/
	{
	
		quard_vertex[0].x = (-circle_radius_w);
		quard_vertex[0].y = (circle_radius_h);

		quard_vertex[1].x = (-circle_radius_w);
		quard_vertex[1].y = (-circle_radius_h);

		quard_vertex[2].x = (circle_radius_w);
		quard_vertex[2].y = (-circle_radius_h);

		quard_vertex[3].x = (circle_radius_w);
		quard_vertex[3].y = (circle_radius_h);
		
		if(beg_no == 1)
		{
			if(end_no == 1)
			{	
				if(CCW == TRUE)
				{
					if(HMI_TRAIL_VERTEX_NUM >= 4)
					{
						trail_segment[vertex_num].x = (0);
						trail_segment[vertex_num].y = (0);
						vertex_num++;

						trail_segment[vertex_num].x = pbeg_vertex->x;
						trail_segment[vertex_num].y = pbeg_vertex->y;
						vertex_num++;
						
						trail_segment[vertex_num].x = pend_vertex->x;
						trail_segment[vertex_num].y = pend_vertex->y;
						vertex_num++; 

						if(pdisplay_container_pos != NULL)
						{
							trail_segment[vertex_num].x = pdisplay_container_pos->x;
							trail_segment[vertex_num].y = pdisplay_container_pos->y;
							vertex_num++; 
						}
					}
				}
				else	/*cw*/
				{
					if(HMI_TRAIL_VERTEX_NUM >= 4)
