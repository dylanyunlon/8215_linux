*/

void get_euler_angle_z0x1y2(ES_MATRIX_STR *presult,	
								float_32 *px_angle,
								float_32 *py_angle,
								float_32 *pz_angle)
{			
	float_32		arcsin_val	= 0.0f;
		
	if(presult != NULL)
 	{			
	 	*pz_angle		= (float_32)atan2(presult->m[1][0],presult->m[1][1]);
		*px_angle		= (float_32)atan2(presult->m[0][2],presult->m[2][2]);
		
		arcsin_val	= -presult->m[1][2];
		if(arcsin_val > 1.0f)
		{
			arcsin_val	= 1.0f;
		}
		if(arcsin_val < -1.0f)
		{
			arcsin_val	= -1.0f;
		}
		*py_angle = (float_32)asin(arcsin_val);

		*px_angle	= (float_32)(((*px_angle) * 180.0f) / HMI_PI);
		*py_angle	= (float_32)(((*py_angle) * 180.0f) / HMI_PI);
		*pz_angle	= (float_32)(((*pz_angle) * 180.0f) / HMI_PI);
 	}
}



