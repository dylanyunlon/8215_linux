		{			
			proot->pbig_font_buffer = pbig_font_buffer;
		}
		else
		{
			proot->pbig_font_buffer	= NULL;/*lq*/
			/*set memory error*/
		}
	}
}




static HMI_AVL_TREE_ROOT_NODE_STR hmi_avl_tree_root[HMI_ALL_FONT_NUMBER];

void hmi_init_font_avl_tree_root(void)
{
	UINT16		loop_font	= 0U;
	UINT16		font_w		= 0U;
	UINT16		font_h		= 0U;
	POINT_TP	font_wh		= {0U,0U};
	
	for(loop_font = 0U;loop_font < HMI_ALL_FONT_NUMBER;loop_font++)
	{		
		hmi_init_font_size_avl_tree(&hmi_avl_tree_root[loop_font]);
		hmi_get_font_w_h(loop_font,&font_wh);
		font_w	= font_wh.x;
		font_h	= font_wh.y;
		hmi_init_font_wh_malloc_buffer_avl_tree(&hmi_avl_tree_root[loop_font],
										font_w,font_h);
	}
}

void hmi_release_avl_node_texture_buffer()
{
	UINT16		loop_font		= 0U;
	BYTE			*pbuffer			= NULL;

	for(loop_font = 0U;loop_font < HMI_ALL_FONT_NUMBER;loop_font++)
	{				
		if(hmi_avl_tree_root[loop_font].pbig_font_buffer != NULL)
		{
			hmi_dealloc_vram(hmi_avl_tree_root[loop_font].pbig_font_buffer);
			hmi_avl_tree_root[loop_font].pbig_font_buffer	= NULL;
		}

		if(hmi_avl_tree_root[loop_font].texture_id != 0)
		{
			glDeleteTextures(1,&(hmi_avl_tree_root[loop_font].texture_id));
			hmi_avl_tree_root[loop_font].texture_id = 0;
		}
		hmi_avl_del_all(&(hmi_avl_tree_root[loop_font]));
	}
	
}



