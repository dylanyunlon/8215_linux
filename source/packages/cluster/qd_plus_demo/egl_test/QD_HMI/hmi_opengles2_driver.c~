#define		HMI_AVL_TREE_BALANCE		2
struct HMI_AVL_TREE_NODE_STR *hmi_avl_bring_balance(struct HMI_AVL_TREE_NODE_STR * pnode)
{	
	SINT32						left_height 		= 0;
	SINT32						right_height		= 0;
	BOOLEAN 					rotate_right		= FALSE;
	struct HMI_AVL_TREE_NODE_STR * pleft			= NULL;
	struct HMI_AVL_TREE_NODE_STR * pleftChild		= NULL;
	struct HMI_AVL_TREE_NODE_STR * prightChild		= NULL;
	struct HMI_AVL_TREE_NODE_STR * pright			= NULL;
	struct HMI_AVL_TREE_NODE_STR * pchild			= NULL;
	SINT32						left_child_height	= 0;
	SINT32						right_child_height	= 0;
		
	if (pnode != NULL)
	{
		pchild			= hmi_avl_get_left(pnode);
		left_height		= hmi_avl_get_height(pchild);

		pchild			= hmi_avl_get_right(pnode);
		right_height		= hmi_avl_get_height(pchild);
		
		if (abs(left_height - right_height) >= HMI_AVL_TREE_BALANCE)
		{
			rotate_right = left_height > right_height;
			if (rotate_right == TRUE)
			{
				pleft				= hmi_avl_get_left(pnode);
				pleftChild			= hmi_avl_get_left(pleft);
				prightChild 		= hmi_avl_get_right(pleft); 
				left_child_height	= hmi_avl_get_height(pleftChild);
				right_child_height	= hmi_avl_get_height(prightChild);
				if (left_child_height > right_child_height)
				{
					hmi_avl_set_left(pnode,prightChild);
					hmi_avl_set_right(pleft,pnode);
					pnode	= pleft;										
				}
				else
				{
					pchild	= hmi_avl_get_right(prightChild);
					hmi_avl_set_left(pnode,pchild);

					pchild	= hmi_avl_get_left(prightChild);
					hmi_avl_set_right(pleft,pchild);

					hmi_avl_set_left(prightChild,pleft);
					hmi_avl_set_right(prightChild,pnode);
					
					pnode	= prightChild;				
				}
			}
			else /*rotation left*/
			{
				pright				= hmi_avl_get_right(pnode);
				pleftChild			= hmi_avl_get_left(pright);
				prightChild 		= hmi_avl_get_right(pright);
				left_child_height	= hmi_avl_get_height(pleftChild);
				right_child_height	= hmi_avl_get_height(prightChild);
				if (left_child_height < right_child_height)
				{
					hmi_avl_set_right(pnode,pleftChild);
					hmi_avl_set_left(pright,pnode); 									
					pnode = pright;
				}
				else
				{
					pchild		= hmi_avl_get_left(pleftChild);
					hmi_avl_set_right(pnode,pchild);

					pchild		= hmi_avl_get_right(pleftChild);
					hmi_avl_set_left(pright,pchild);
					
					hmi_avl_set_right(pleftChild,pright);
					hmi_avl_set_left(pleftChild,pnode);
					
					pnode		= pleftChild;
				}
			}
		}
	}
		
	return	pnode;
}


struct HMI_AVL_TREE_NODE_STR * hmi_avl_insert_comparable(HMI_AVL_TREE_ROOT_NODE_STR *proot,
														struct HMI_AVL_TREE_NODE_STR	*pnode,
													HMI_AVL_TREE_USER_DATA_STR *puser_data,
													struct HMI_AVL_TREE_NODE_STR **ppnew_node)
{
	struct HMI_AVL_TREE_NODE_STR	*pret_node 	= NULL;
	struct HMI_AVL_TREE_NODE_STR	*pins_node 	= NULL;
	SINT32						cmp			= 0;
	HMI_AVL_TREE_USER_DATA_STR	user_data	= {0U,0U,0U,0U,0U};
	struct HMI_AVL_TREE_NODE_STR	*pleft_node 	= NULL;
	struct HMI_AVL_TREE_NODE_STR	*pright_node	= NULL;
	
	if(pnode == NULL)
	{
		pret_node	= hmi_avl_new_node(proot);
		hmi_avl_init_node(pret_node);
		if(pret_node != NULL)
		{
			pret_node->key		= puser_data->key;
			pret_node->x_index	= puser_data->x_index;
			pret_node->y_index	= puser_data->y_index;
			pret_node->char_w		= puser_data->char_w;
			pret_node->char_h		= puser_data->char_h;
		}
		if(ppnew_node != NULL)
		{
			(*ppnew_node)	= pret_node;
		}
	}
	else
	{
		hmi_avl_get_user_data(pnode,&user_data);
		cmp = hmi_avl_cmp(puser_data,&user_data);
		
		if (cmp <= 0)
		{
			pleft_node	= hmi_avl_get_left(pnode);
			pins_node	= hmi_avl_insert_comparable(proot,
									pleft_node,
									puser_data,
									ppnew_node);
			if(pins_node != NULL)
			{
				hmi_avl_set_left(pnode,pins_node);
				pret_node	= hmi_avl_bring_balance(pnode);
			}
						
		}
		else
		{
			pright_node	= hmi_avl_get_right(pnode);
			pins_node	= hmi_avl_insert_comparable(proot,
									pright_node,
									puser_data,
									ppnew_node);
			if(pins_node != NULL)
			{
				hmi_avl_set_right(pnode,pins_node);
				pret_node	= hmi_avl_bring_balance(pnode);
			}
							
		}
	}
	
	return	pret_node;
}

