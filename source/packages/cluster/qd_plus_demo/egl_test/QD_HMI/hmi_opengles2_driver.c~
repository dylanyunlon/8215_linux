BOOLEAN	hmi_set_big_image_buffer(BYTE *ptex_buffer,
								UINT32			seg_no,											
								HMI_BIG_IMAGE_INDEX_STR	fmt_index,
								UINT32			index)
{
	BOOLEAN								success			= FALSE;
	UINT32								cnt				= FALSE;	
	HMI_FMT_ADDR_STR					*pfmt_addr		= NULL;
	BYTE								*pbuffer		= NULL;
	HMI_FMT_BIG_IMAGE_BUFFER_STR		*pbig_image_buf	= NULL;
	
	pfmt_addr	= hmi_get_fmt_addr(seg_no,fmt_index,
									index);
	if(pfmt_addr != NULL)
	{
		cnt	= pfmt_addr->cnt;
		if((cnt > 0U)&&(index < cnt))
		{
			pbig_image_buf	= pfmt_addr->pfmt_big_image_buffer;
			pbuffer			= pbig_image_buf[index].pbuffer;
			if(pbuffer == NULL)
			{
				pbig_image_buf[index].pbuffer	= ptex_buffer;
				success							= TRUE;
			}
		}
	}
	
	return	success;
}

HMI_FMT_ADDR_STR CONST * hmi_rgl_load_to_vram(HMI_OBJECT_ID_STR		hmi_object_id,
							HMI_BITMAP_STR	CONST *pdata,	/*flash data address*/							
							HMI_FONT_CHAR_STR	*pchar_code
							)

										
{	
	HMI_FMT_ADDR_STR	CONST		*pvmem				= NULL;
	U08 	  						*ptex_buffer		= NULL;	
	TEXTURE_2D_PIXEL_FORMAT			pixel_fmt			= TEXTURE_2D_PIXEL_FORMAT_RGB888;
	U32								decode_image_len	= 0U;
	HMI_BIG_IMAGE_INDEX_STR			fmt_index			= HMI_MAX_CNT_BIG_IMAGE;
	HMI_FMT_BIG_IMAGE_BUFFER_STR	*pbig_img_buf		= NULL;
	HMI_BIG_IMAGE_ADDR_STR	CONST	*pbitmap_data		= NULL;
	HMI_FMT_ADDR_STR	CONST		*pfmt_addr			= NULL;
	BYTE							seg_no				= 0U;
	BYTE							index				= 0U;	
	BOOLEAN							success				= FALSE;
	
	if(pdata != NULL)
	{
		pbitmap_data	= &(pdata->pbitmap_data);
		pfmt_addr		= hmi_is_loaded(pdata,NULL);
		if(pfmt_addr != NULL)/*loaded*/
		{
			pvmem	= pfmt_addr;
		}
		else	/*Loading */
		{
			fmt_index	= pdata->pbitmap_data.fmt_index;
			pixel_fmt	= hmi_get_pixel_fmt_compress_fmt(fmt_index);
			ptex_buffer = hmi_Init2DImg(pdata,
										pixel_fmt,
										&decode_image_len);
			seg_no		= pbitmap_data->seg_no;
			fmt_index	= pbitmap_data->fmt_index;
			index		= pbitmap_data->index;
			success		= hmi_set_big_image_buffer(ptex_buffer,
									seg_no,
									fmt_index,
									index);
			if(success == TRUE)
			{
				pfmt_addr	= hmi_get_fmt_addr(seg_no,
									fmt_index,index);
				pvmem		= pfmt_addr;
			}
			
		}
	}
			
	return pvmem;
}


