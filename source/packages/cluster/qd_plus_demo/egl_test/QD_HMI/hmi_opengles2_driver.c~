#define HMI_TXT_BREAK_CHARS " ,.;:-_"

 BOOLEAN hmi_driver_is_break_char(UINT32 letter)
{
    UINT8 i=0;
    BOOLEAN ret = FALSE;

    /* each chinese character can be break */
    if(letter >= 0x4E00 && letter <= 0x9FA5) 
	{
       ret = TRUE;
    }
	else
	{
	    /*Compare the letter to TXT_BREAK_CHARS*/
	    while((ret == FALSE)&&(HMI_TXT_BREAK_CHARS[i] != '\0'))
		{
	        if(letter == (UINT32)HMI_TXT_BREAK_CHARS[i]) 
			{
	            ret = TRUE; /*If match then it is break char*/
	        }
			i++;
	    }
	}

    return ret;
}
SINT16 hmi_driver_cycle_text(HMI_TEXT_PROP_STR CONST		* phmi_text_prop_info,
									HMI_WIDTH_STR				edit_width,
									U08							font_id,
									HMI_CHAR_STR				* phmi_cycle_text,
									UINT16*						pcycle_text_len)
{
	HMI_CHAR_STR		*ptext_string			= (HMI_CHAR_STR		*)(phmi_text_prop_info->hmi_string);
	SINT16				hmi_scroll_offset		= 0;/*text offset which user set the value*/
	UINT8				hmi_cycle_flag			= 0;
	UINT8				hmi_cycle_step			= 0;
	SINT16				hmi_cycle_sign			= 0;
	SINT16				index					= 0;
	HMI_TEXT_LENGTH_STR hmi_string_length		= 0U;
	BOOLEAN				search_end_flag		= FALSE;
	UINT8				hmi_code_char_len		= 0U;/*differene font code .maybe 1,2*/
	HMI_FONT_CHAR_STR	hmi_char				= 0U;
	HMI_FONT_CHAR_PROP	CONST * phmi_font_config= NULL;
	HMI_WIDTH_STR		hmi_char_width			= 0U;
	SINT16				i 						= 0U;
	SINT16				cycle_index 			= 0U;
#if HMI_SCROLL_TEXT_SUPPORT != 0U
	if(HMI_TEXT_PROP_IS_SCROLABLE(phmi_text_prop_info->properties))
	{
		/*get scroll text offset*/
	#if HMI_FONT_CODE == HMI_FONT_CODE_UNICODE
		hmi_scroll_offset	= ptext_string[phmi_text_prop_info->length+1];
	#else
		hmi_scroll_offset	= (ptext_string[phmi_text_prop_info->length+1]<<8);
		hmi_scroll_offset	+= ptext_string[phmi_text_prop_info->length+2];
	#endif
		hmi_cycle_flag	= HMI_GET_SCROLL_STEP_CYCLE_FLAG(hmi_scroll_offset);
		hmi_cycle_step	= HMI_GET_SCROLL_STEP_CYCLE_STEP(hmi_scroll_offset);
		hmi_cycle_sign	= HMI_GET_SCROLL_SIGN_BIT(hmi_scroll_offset);
		if(hmi_cycle_sign)
		{
			hmi_scroll_offset	= -(HMI_GET_SCROLL_STEP_VALUE(hmi_scroll_offset));
		}
		else
		{
			hmi_scroll_offset	= HMI_GET_SCROLL_STEP_VALUE(hmi_scroll_offset);
		}
		index = 0;
		
		if(hmi_cycle_sign ==0)
		{
			while((ptext_string[index] != '\0')&&(search_end_flag == FALSE))
			{
				hmi_char			= hmi_get_value_char(ptext_string[index],
														ptext_string[index+1],
				//										&hmi_code_char_len);
					&hmi_code_char_len);
				phmi_font_config	= hmi_driver_get_char_data(hmi_char, 
																	NULL, 
																	font_id);
				if(phmi_font_config != NULL)
				{
					hmi_char_width = phmi_font_config->owidth;
					if(hmi_char_width < hmi_scroll_offset)
					{
						hmi_scroll_offset	-= hmi_char_width;
						index++;
						index	+= hmi_code_char_len;
					}
					else
					{
						search_end_flag = TRUE;
					}
				}													
			}
			if(phmi_cycle_text != NULL)
			{
				i = index;
				cycle_index =0;
				while(ptext_string[i] != '\0')
				{
					hmi_char			= hmi_get_value_char(ptext_string[i],
														ptext_string[i+1],
					//									&hmi_code_char_len);
						&hmi_code_char_len);
					//if(cycle_index < cycle_text_len)
					{
						phmi_cycle_text[cycle_index] = hmi_char;
					}
					cycle_index++;
					cycle_index	+= hmi_code_char_len;
					i++;
					i	+= hmi_code_char_len;
				}
				//if(cycle_index < cycle_text_len)
				{
					phmi_cycle_text[cycle_index] = HMI_CHAR_TAB;
				}
				cycle_index++;
				//if(cycle_index < cycle_text_len)
				{
					phmi_cycle_text[cycle_index] = hmi_cycle_step*HMI_TEXT_CYCLE_RANGE;
				}
				cycle_index++;
				i =0;
				while(i < index)
				{
					hmi_char			= hmi_get_value_char(ptext_string[i],
														ptext_string[i+1],
					//									&hmi_code_char_len);
						&hmi_code_char_len);
					//if(cycle_index < cycle_text_len)
					{
						phmi_cycle_text[cycle_index] = hmi_char;
					}
					cycle_index++;
					cycle_index	+= hmi_code_char_len;
					i++;
					i	+= hmi_code_char_len;
				}
				phmi_cycle_text[cycle_index] = 0;
			}
		}
	}
	*pcycle_text_len = cycle_index;
	return hmi_scroll_offset;
#endif
}
