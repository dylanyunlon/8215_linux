void hmi_set_draw_type(HMI_UNIFORM_IMAGE_TYPE_STR draw_type,INT32 attribute,
						BYTE	global_alpha)
	{
	GLint		draw_type_int	= (GLint)draw_type;
	GLfloat 	gloabl_alpah_f	= 0.0f;
	GLint		attribute_int	= (GLint)attribute;
	GLuint		screen_w		= 0;
	GLuint		screen_h		= 0;
	GLuint		mask_texture	= hmi_render_buffer_qd[HMI_MASK_HMI_RENDER_BUFFER].texture;
	BOOLEAN		enable			= hmi_render_buffer_qd[HMI_MASK_HMI_RENDER_BUFFER].enable;;
	BYTE		screen			= 0u;

	gloabl_alpah_f	= (GLfloat)global_alpha;
	gloabl_alpah_f	= (GLfloat)(gloabl_alpah_f / HMI_MAX_ALPHA_VALUE);

	if(hmi_loc_qd_unit < HMI_SCREEN_NO)
	{
		screen	= hmi_loc_qd_unit;
	}

	screen_w		= (GLuint)(hmi_screen_size[screen].x);
	screen_h		= (GLuint)(hmi_screen_size[screen].y);
	/*Blind MASK*/
	if((mask_texture != 0u)&&(enable == TRUE))
	{
		/*set MASK flag*/
		if((m_bDLL2QDAttribute & (1 << HMI_QD_DIS_MASK)) == 0)
		{
			attribute_int	+= HMI_MASK_ENABLE;
		}				
	}

	if((m_bDLL2QDAttribute & (1 << HMI_QD_GAUSSIAN)) != 0)
	{
		attribute_int	+= ((GLint)(1 << HMI_QD_GAUSSIAN));
	}	
	if((m_bDLL2QDAttribute & (1 << HMI_QD_A8_FRMBUF)) != 0)
	{
		attribute_int	+= ((GLint)(1 << HMI_QD_A8_FRMBUF));
	}
	
	if((m_bDLL2QDAttribute & (1 << HMI_QD_SHADOW_TYPE)) != 0)
	{
		attribute_int	+= ((GLint)(1 << HMI_QD_SHADOW_TYPE));
	}	
	if((m_bDLL2QDAttribute & (1 << HMI_QD_MULTISAMPLE4)) != 0)
	{
		attribute_int	+= ((GLint)(1 << HMI_QD_MULTISAMPLE4));
	}	
	if((m_bDLL2QDAttribute & (1 << HMI_CAST_ON)) != 0)
	{
		attribute_int	+= ((GLint)(1 << HMI_CAST_ON));
	}	
	if((m_bDLL2QDAttribute & (1 << HMI_QD_ALPHA_0_COPY)) != 0)
	{
		attribute_int	+= ((GLint)(1 << HMI_QD_ALPHA_0_COPY));
	}	

	glUniform1i(hmi_user_data.draw_type_id,draw_type_int);
	glUniform1i(hmi_user_data.attribute_id,attribute_int);
	glUniform1f(hmi_user_data.global_alpha_id,gloabl_alpah_f);	
	

	/*set screen w,h*/
	glUniform1i(hmi_user_data.screen_w_id,screen_w);
	glUniform1i(hmi_user_data.screen_h_id,screen_h);
}

