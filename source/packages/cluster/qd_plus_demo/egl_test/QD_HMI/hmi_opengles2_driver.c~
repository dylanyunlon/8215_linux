BOOLEAN	hmi_copy_sub_img(HMI_BITMAP_STR CONST 	*pimage_prop_info,
								U16			xoffset,U16	yoffset,U16	w,U16	h,
								void	*ppixels,HMI_BITMAP_STR *pnew_image_prop_info)
{
	BOOLEAN							success					= FALSE;
	UINT32							index					= 0U;
	UINT32							cnt						= 0U;
	HMI_FMT_ADDR_STR	CONST		*pfmt_addr				= NULL;	
	GLuint							texture_id				= 0;
	HMI_FMT_BIG_IMAGE_BUFFER_STR	*pbig_image_buf			= NULL;
	HMI_FMT_BIG_IMAGE_STR	CONST	*pfmt_big_image			= NULL;
	HMI_TEXTURE_BIG_IMAGE_LOAD_STR	status					= HMI_BIG_IMAGE_LOAD_CNT;
	UINT32							img_len					= 0u;
	GLenum							format					= GL_RGBA;
	INT32							ioffset					= 0;
	

	if((pimage_prop_info != NULL)&&
		(pnew_image_prop_info != NULL)&&
		(ppixels != NULL))
	{
		if(((pimage_prop_info->pbitmap_data).w >= w) &&
			((pimage_prop_info->pbitmap_data).h >= h))
		{		
			/*copy_image to texture*/
			status	= hmi_set_cur_texture(pimage_prop_info); 
			index	= (pimage_prop_info->pbitmap_data).index;
			pfmt_addr	= hmi_is_loaded(pimage_prop_info,&img_len);			
			if((pfmt_addr != NULL)&&
				(status	!= HMI_BIG_IMAGE_LOAD_FAILED)&&
				(status	!= HMI_BIG_IMAGE_CREATE_TEXTURE_FAILED)/*lq*/)
			{
				cnt		= pfmt_addr->cnt;
				if(index < cnt)
				{
					pfmt_big_image	= pfmt_addr->pfmt_big_image;
					pbig_image_buf	= (pfmt_addr->pfmt_big_image_buffer);
					texture_id		= pbig_image_buf[index].texture_id;
					if(texture_id != 0)/*already create texture*/
					{							
						/*left bottom is origin*/
						ioffset	= (pfmt_big_image->h - 1) - (yoffset + h - 1);
						if(ioffset >= 0)
						{
							yoffset	= (U16)ioffset;
												
							glActiveTexture(GL_TEXTURE0 + HMI_TEXTURE_UNIT_BMP);				
							glBindTexture ( GL_TEXTURE_2D, texture_id );
						
							glTexSubImage2D(GL_TEXTURE_2D,0,
											xoffset,yoffset,
											(GLsizei)(w),(GLsizei)(h),
											format,GL_UNSIGNED_BYTE,
											ppixels);
						}
					
						(pnew_image_prop_info->pbitmap_data).seg_no	= (pimage_prop_info->pbitmap_data).seg_no;
						(pnew_image_prop_info->pbitmap_data).index	= (pimage_prop_info->pbitmap_data).index;
						(pnew_image_prop_info->pbitmap_data).fmt_index= (pimage_prop_info->pbitmap_data).fmt_index;
						(pnew_image_prop_info->pbitmap_data).x		= (pimage_prop_info->pbitmap_data).x;
						(pnew_image_prop_info->pbitmap_data).y		= (pimage_prop_info->pbitmap_data).y;
						(pnew_image_prop_info->pbitmap_data).w 		= w;
						(pnew_image_prop_info->pbitmap_data).h 		= h;
					
						success	= TRUE;
					}
				}
			}		
		 }
		else
		{
			
		}
	}
	else
	{
		
	}
	
						
	return success;
}

