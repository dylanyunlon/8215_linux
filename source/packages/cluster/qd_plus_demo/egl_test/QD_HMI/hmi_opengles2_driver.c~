 HMI_READ_CHAR_TYPE_STR hmi_read_char_type(HMI_CHAR_STR read_ch)
 {
	 HMI_READ_CHAR_TYPE_STR parise_code = HMI_BLANK_READ_CHAR;
 
	 if(read_ch < HMI_BLANK_UNICODE)
	 {
		 parise_code = HMI_OTHER_READ_CHAR;
	 }	 
	 else if(read_ch > HMI_UNICODE_SYMBOL_END)
	 {
		 parise_code = HMI_OTHER_READ_CHAR;
	 }
	 else
	 {
		 if(read_ch== HMI_BLANK_UNICODE)
		 {
			 parise_code = HMI_BLANK_READ_CHAR;
		 }
		 else if((read_ch >= HMI_ASC_NUMBER_BEGIN)&&
				 (read_ch <= HMI_ASC_NUMBER_END))
		 {
			 parise_code = HMI_NUMBER_DOT_READ_DOT;
		 }
		 else if((read_ch >= HMI_FARSI_NUMBER_BEGIN)&&
				 (read_ch <= HMI_FARSI_NUMBER_END))
		 {
			 parise_code = HMI_NUMBER_DOT_READ_DOT;
		 }
		 else if((read_ch >= HMI_UNICODE_SYMBOL_BEGIN)&&
				 (read_ch <= HMI_UNICODE_SYMBOL_END))
		 {
			 parise_code = HMI_NUMBER_DOT_READ_DOT;
		 }
		 else if((read_ch >= HMI_FARSI_UNICODE_BEGIN1)&&
				 (read_ch <= HMI_FARSI_UNICODE_END1))
		 {
			 parise_code = HMI_FARSI_READ_CHAR;
		 }
		 else if((read_ch >= HMI_FARSI_UNICODE_BEGIN2)&&
				 (read_ch <= HMI_FARSI_UNICODE_END2))
		 {
			 parise_code = HMI_FARSI_READ_CHAR;
		 }
		#if 0
		 else if((read_ch >=HMI_FARSI_UNICODE_BEGIN3)&&
				 (read_ch <= HMI_FARSI_UNICODE_END3))
		 {
			 parise_code = HMI_FARSI_READ_CHAR;
		 }	
		 else if((read_ch >=HMI_FARSI_UNICODE_BEGIN4)&&
				 (read_ch <= HMI_FARSI_UNICODE_END4))
		 {
			 parise_code = HMI_FARSI_READ_CHAR;
		 }
		#endif
		
		 else if((read_ch >= HMI_HEBREW_CHAR_UNICODE_BEGIN5)&&
				 (read_ch <= HMI_HEBREW_CHAR_UNICODE_END5))
		 {
			 parise_code = HMI_FARSI_READ_CHAR;
		 }
#if 0
		 else if((read_ch >= HMI_HEBREW_NIQQUD_UNICODE_BEGIN6)&&
				 (read_ch <= HMI_HEBREW_NIQQUD_UNICODE_END6))
		 {
			 parise_code = HMI_FARSI_READ_CHAR;
		 }
#endif
		 else
		 {
			 parise_code = HMI_OTHER_READ_CHAR;
		 }				  
	 }
	 return parise_code;
 }
 
 void hmi_reverse_farsi_word(HMI_CHAR_STR *ptext,U16 text_begin,
		   U16 text_end,HMI_FARSI_ANALYSIS_STR *presult,
		   BOOLEAN next_word)
 {	
	 BOOLEAN end_flag = FALSE;
	 BOOLEAN first_number  = FALSE;
	 HMI_CHAR_STR read_ch  = '\0'; 
	 static U16 search_begin	 = 0U;
	 static U16 search_end		 = 0U;
	 U16 search_end_const		 = 0U;
	 static U16 number_begin	 = 0U;
	 static U16 number_end		 = 0U; 
	 HMI_FIND_NUMBER_STATUS_STR last_status  = HMI_INIT_FIND_NUMBER;
	 HMI_FIND_NUMBER_STATUS_STR cur_status	 = HMI_INIT_FIND_NUMBER;
	 HMI_READ_CHAR_TYPE_STR   parise_code	 = HMI_OTHER_READ_CHAR;
	 static HMI_REVERSE_STATUS_STR reverst_status = HMI_SENTENCE_REVERSE_STATUS;
	BOOLEAN line_end			= FALSE;
 
	 if(next_word == FALSE)/*first search */
	 {
		 number_begin	 = 0U;
		 number_end 	 = 0U;
		 search_begin	 = text_begin;
		 search_end 	 = text_end;
		 reverst_status  = HMI_SENTENCE_REVERSE_STATUS;
	 }
	 if((ptext != NULL)&&(presult != NULL))
	 { 
		 if(reverst_status == HMI_SENTENCE_REVERSE_STATUS)
		 {
			 /*init*/
			 number_begin	 = text_begin;
			 number_end 	 = text_end;
			 presult->begin  = text_begin;
			 presult->end	 = search_end;/*last search position*/
			 presult->reverse= FALSE;
			 search_end_const	 = search_end;
			 last_status = HMI_INIT_FIND_NUMBER;
			while((search_begin <= search_end)&&
				(end_flag == FALSE)&&
				(line_end == FALSE))
			{  
				if(search_begin < search_end)
				{
					search_end--;  				
					read_ch = ptext[search_end];/*search from tail*/
				}
				else
				{
					line_end	= TRUE;
					read_ch 	= HMI_BLANK_UNICODE;
				}
				
				 if(read_ch < HMI_BLANK_UNICODE)
				 {
					 parise_code = HMI_OTHER_READ_CHAR;
				 }	 
				 else if(read_ch > HMI_UNICODE_SYMBOL_END)
				 {
					 parise_code = HMI_OTHER_READ_CHAR;
				 }
				 else
				 {
					 parise_code = hmi_read_char_type(read_ch);
				 }
				 
				 cur_status  = farsi_number_tlb[last_status][parise_code];
				 first_number = (cur_status == HMI_BEGIN_FIND_NUMBER);
				 if(first_number == TRUE)/*first alphabet of number*/
				 {
					 number_end = search_end + 1;
				 }
 
				 end_flag = (cur_status == HMI_END_FIND_NUMBER);
				if(end_flag == TRUE) /*find number */
				{ 
					if(line_end == TRUE)
					{						
						number_begin = search_end ;
						
					}
					else
					{
						number_begin = search_end + 1;
						
					}
				}
				else
				{    
					  
				 }	
				 last_status = cur_status;
			 }
			 if(end_flag == TRUE)/*find a number,return right number word position*/
			 {
				 if(number_end == search_end_const)/*first word is number*/
				 {
					 presult->begin  = number_begin;
					 presult->end	 = number_end ;
					 presult->reverse = FALSE;
					 reverst_status  = HMI_SENTENCE_REVERSE_STATUS;
					 if(text_begin < number_begin)/*remain string*/
					 {
						 search_end = number_begin;
					 }
					 else
					 {
						 reverst_status = HMI_END_REVERSE_STATUS;
					 }
				 }
				 else/*first word is not number*/
				 {
					 presult->begin  = number_end;
					 presult->end	 = search_end_const;
					 presult->reverse = TRUE;
					 reverst_status  = HMI_NUMBER_REVERSE_STATUS;
				 }
			 }
			 else /*not find a number,this is farsi sentence*/
			 {
				 presult->begin  = search_begin;
				 presult->end	 = search_end_const;
				 presult->reverse= TRUE;	
				 reverst_status  = HMI_END_REVERSE_STATUS;
			 }
		 }
		 else if(reverst_status == HMI_NUMBER_REVERSE_STATUS)
		 {
			 presult->begin  = number_begin;
			 presult->end	 = number_end;
			 presult->reverse = FALSE;
			 if(number_begin == text_begin)/*end*/
			 {
				 reverst_status = HMI_END_REVERSE_STATUS;
			 }
			 else
			 {	  
				 search_begin	 = text_begin;
				 search_end 	 = number_begin;
				 reverst_status  = HMI_SENTENCE_REVERSE_STATUS;
			 }
		 }
		 else
		 {
			 presult->begin  = HMI_U16_MAX;
			 presult->end	 = HMI_U16_MAX;
		 }
	 } 
 }
 /*
 check last character for every word,change another character
 */
 void hmi_hebrew_word_last_char(HMI_CHAR_STR *ptext,U16  last_index/*actual index is last_index - 1*/,U16 text_len/*not include end index*/)
 {
	 INT32		 i			 = 0;
	 BOOLEAN	 bfinished	 = FALSE;
	 
	 if(ptext != NULL) 
	 {
		 if(last_index > 0u)
		 {
			 last_index--;
			 if(last_index < text_len)
			 {						 
				 if((ptext[last_index] >= hebrew_gly_char[0][0])&&
					 (ptext[last_index] <= hebrew_gly_char[HMI_HEBREW_GLY_CNT - 1][0]))
				 {
					 for(i = 0;(i < HMI_HEBREW_GLY_CNT) && (bfinished == FALSE);i++)
					 {
						 if(hebrew_gly_char[i][0] == ptext[last_index])
						 {
							 ptext[last_index]	 = hebrew_gly_char[i][1];
							 bfinished			 = TRUE;
						 }				 
					 }
				 }
			 }
		 }
		 
	 }
 }
 
 

void hmi_farsi_word(HMI_CHAR_STR *ptext,U16 text_begin,U16 text_end,
      HMI_FARSI_ANALYSIS_STR *presult,BOOLEAN next_word,
      U16	*pfarsi_sentence_begin,U16 *pfarsi_sentence_end)

{ 
	BOOLEAN   	finished   				= FALSE;
	BOOLEAN   	word_end   				= FALSE;
	static  U16 search_begin   			= 0U;
	static  U16 search_end    			= 0U;
	static U16 farsi_sentence_begin 	= 0U;
	static U16 farsi_sentence_end		= 0U; 
	U16   	next_string_begin  			= 0U; 
	U16   	search_begin_const  		= 0U;
	HMI_WORD_TYPE_STR  one_word_type 	= HMI_WORD_TYPE_CNT;
	HMI_CHAR_STR   	read_ch  			= '\0'; 
	HMI_SEARCH_FARSI_SENTENCE_STR cur_sentence 	= HMI_NULL_SENTENCE;
	HMI_SEARCH_FARSI_SENTENCE_STR next_sentence = HMI_NULL_SENTENCE; 
	HMI_READ_CHAR_TYPE_STR read_char_type  		= HMI_FARSI_CHAR_TYPE_CNT;
	HMI_SEARCH_FARSI_WORD_STR cur_word_status 	= HMI_INIT_CHAR_STATUS;
	HMI_SEARCH_FARSI_WORD_STR next_word_status 	= HMI_INIT_CHAR_STATUS;
	static HMI_ANALYSIS_SENTENCE_STR  analysis 	= HMI_ANALYSIS_SENTENCE_CNT;

	if((ptext != NULL)&&(presult != NULL)&&
		(pfarsi_sentence_begin != NULL)&&
		(pfarsi_sentence_end != NULL))
	{
		if(next_word == FALSE)
		 {	 
			 search_begin	 = text_begin;
			 search_end 	 = text_end;
			 analysis		 = HMI_BEGIN_ANALYSIS_SENTENCE;
			 farsi_sentence_begin	 = 0U;
			 farsi_sentence_end 	 = 0U;
		 }
 
		 if(analysis == HMI_BEGIN_ANALYSIS_SENTENCE) 
		 {
			 farsi_sentence_begin	 = search_begin;
			 cur_sentence			 = HMI_NULL_SENTENCE;
			 cur_word_status		 = HMI_INIT_CHAR_STATUS;
			 search_begin_const 	 = search_begin;
			 while((search_begin <= search_end)&&(finished == FALSE))
			 {
				 if(search_begin != search_end)
				 {
					 read_ch   = ptext[search_begin];
					 if(read_ch < HMI_BLANK_UNICODE)
					 {
						 read_char_type = HMI_OTHER_READ_CHAR;
					 }	 
					 else if(read_ch > HMI_UNICODE_SYMBOL_END)
					 {
						 read_char_type = HMI_OTHER_READ_CHAR;
					 }
					 else
					 {
						 read_char_type = hmi_read_char_type(read_ch);
					 }
				 }
				 else
				 {
					 read_char_type  = HMI_BLANK_READ_CHAR;
					 word_end		 = TRUE;
				 }
				 
				next_word_status = farsi_word_tlb[cur_word_status][read_char_type];
				if(cur_sentence != HMI_FARSI_SENTENCE_BEGIN)
				{
					#if (HMI_FARSI_REVERSE_STYLE == HMI_FARSI_WORD)/*word farsi style*/
					
					#if 0
						if((cur_word_status == HMI_INIT_CHAR_STATUS)&&
							(next_word_status !=  HMI_INIT_CHAR_STATUS))/*begin new word*/
					#else
						if(( (cur_word_status == HMI_INIT_CHAR_STATUS)&&
							 (next_word_status !=  HMI_INIT_CHAR_STATUS))||
							((cur_word_status == HMI_OTHER_CHAR_STATUS)&&	/*2022 06 17*/
							(next_word_status == HMI_INIT_CHAR_STATUS)))	/*begin new word*/
					#endif
					
					{
						farsi_sentence_begin = search_begin;
					}
					#else
					if((cur_word_status == HMI_INIT_CHAR_STATUS)&&
						(next_word_status !=  HMI_INIT_CHAR_STATUS))/*begin new word*/
					
					{	
						if(next_word_status == HMI_FARSI_CHAR_STATUS)
						{
							farsi_sentence_begin = search_begin_const;
						}
						else
						{
							farsi_sentence_begin = search_begin;
						}
					}
					#endif
				}
				
				if(next_word_status == HMI_INIT_CHAR_STATUS)/*finished one word*/
				{
					
					hmi_hebrew_word_last_char(ptext,
										search_begin,
										text_end);
					one_word_type = one_word_type_tlb[cur_word_status];
					if(one_word_type < HMI_WORD_TYPE_CNT)
					{
						next_sentence = farsi_sentence_tlb[cur_sentence][one_word_type];
						if(next_sentence == HMI_FARSI_SENTENCE_BEGIN)
						{
							
							#if (HMI_FARSI_REVERSE_STYLE == HMI_FARSI_WORD)
							if((cur_word_status == HMI_FARSI_CHAR_STATUS)||
								(cur_word_status == HMI_NUMBER_DOT_CHAR_STATUS))///*word farsi style*/ changed by pxguo 201103
							#else
							if((cur_word_status == HMI_FARSI_CHAR_STATUS)||
								(cur_word_status == HMI_NUMBER_DOT_CHAR_STATUS)||
								(cur_word_status == HMI_OTHER_CHAR_STATUS))
							#endif
							{
								farsi_sentence_end  = search_begin;
							}
						}
						if(word_end	== TRUE)
						{
							if(next_sentence == HMI_FARSI_SENTENCE_BEGIN)
							{
								next_sentence = HMI_FARSI_SENTENCE_END;
							}
						}
					}
					else
					{
						if(next_sentence == HMI_FARSI_SENTENCE_BEGIN)
						{
							next_sentence = HMI_FARSI_SENTENCE_END;
						}
					}
					
					if(next_sentence == HMI_FARSI_SENTENCE_END)
					{
						if(text_begin == farsi_sentence_begin)/*Farsi_sentence|... */
						{     
							hmi_reverse_farsi_word(ptext,farsi_sentence_begin,
													farsi_sentence_end,presult,
													FALSE/*first*/);
							
							*pfarsi_sentence_begin		= farsi_sentence_begin; 
							*pfarsi_sentence_end		= farsi_sentence_end; 
							analysis  = HMI_REVERSE_FARSI_GON_ON_SENTENCE;
						 }
						 else/* other_sentence| Farsi_sentence|... */
						 {
							 presult->begin = search_begin_const;
							 presult->end = farsi_sentence_begin;		
							 analysis  = HMI_END_ANALYSIS_SENTENCE;
 
							 if(farsi_sentence_begin < farsi_sentence_end)/*farsi sentence*/
							 {		 
								 search_begin = farsi_sentence_begin;
								 search_end  = farsi_sentence_end;
								 analysis  = HMI_REVERSE_FARSI_SENTENCE;	   
							 }		
						 } 
						 finished = TRUE;
					 }
					 cur_sentence	 = next_sentence;
				 }
				 
				 if((cur_word_status == HMI_OTHER_CHAR_STATUS)&&
				 	(read_char_type == HMI_FARSI_READ_CHAR))			/*2022 06 17*/
				 {
				 	/*into farsi word status*/
				 	next_word_status	= HMI_FARSI_CHAR_STATUS;
				 }
				 cur_word_status = next_word_status;
				 search_begin++;		
			 }
			 
			 if(finished == FALSE)/*not find farsi sentence*/
			 {
				 presult->begin = search_begin_const;
				 presult->end = search_end;
				 if(search_end < text_end)/*not finished*/
				 {
					 search_begin = search_end;
					 search_end  = text_end;
					 analysis = HMI_BEGIN_ANALYSIS_SENTENCE;
				 }
			 }
			else
			{

			}
		}  
		else if(analysis == HMI_REVERSE_FARSI_SENTENCE)
		{
			hmi_reverse_farsi_word(ptext,farsi_sentence_begin,
									farsi_sentence_end,presult,
									FALSE/*first*/);
			
			*pfarsi_sentence_begin 	= farsi_sentence_begin; 
			*pfarsi_sentence_end		= farsi_sentence_end; 
			if(presult->end == HMI_U16_MAX)/*farsi sentence is finished*/
			{
				if(farsi_sentence_end < text_end)/*not finished*/
				 {
					 //next_string_begin = farsi_sentence_end;
					 analysis		 = HMI_BEGIN_ANALYSIS_SENTENCE;
					 search_begin	 = farsi_sentence_end;
					 search_end 	 = text_end;
					 //hmi_farsi_word(ptext,next_string_begin,
					 //text_end,presult,TRUE/*first*/);
				 }
				 else
				 {
					 presult->begin  = HMI_U16_MAX;
					 presult->end	 = HMI_U16_MAX;
					 analysis		 = HMI_END_ANALYSIS_SENTENCE;
				 }
			 }
			 else
			 {
				analysis = HMI_REVERSE_FARSI_GON_ON_SENTENCE;
			}
		}
		else if(analysis == HMI_REVERSE_FARSI_GON_ON_SENTENCE)
		{
			hmi_reverse_farsi_word(ptext,farsi_sentence_begin,
									farsi_sentence_end,presult,
									TRUE/*next*/);
			
			*pfarsi_sentence_begin 	= farsi_sentence_begin; 
			*pfarsi_sentence_end	= farsi_sentence_end; 
			if(presult->end == HMI_U16_MAX)/*farsi sentence is finished*/
			{
				if(farsi_sentence_end < text_end)/*not finished*/
				{
					next_string_begin	= farsi_sentence_end;
					search_begin		= next_string_begin;
					search_end			= text_end;
					 analysis			 = HMI_BEGIN_ANALYSIS_SENTENCE;
					 /*hmi_farsi_word(ptext,next_string_begin,
									 text_end,presult,TRUE);*/
					 /*begin=0,end=HMI_U16_MAX,mean not finished,go on call hmi_farsi_word*/
					 presult->begin  = 0x00;
					 
				 }
				 else
				 {
					 analysis	= HMI_END_ANALYSIS_SENTENCE;
				 }
			 }
		 }
		 else if(analysis == HMI_END_ANALYSIS_SENTENCE)
		 {
			 presult->begin  = HMI_U16_MAX;
			 presult->end	 = HMI_U16_MAX;
		 }
		 else
		 {
			 presult->begin  = HMI_U16_MAX;
			 presult->end	 = HMI_U16_MAX;
		 }
	 }
 }


