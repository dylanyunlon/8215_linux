U08 *get_shader_data_from_file(GLenum type,ESContext *esContext)
{
	U08 *		pdata		= NULL;
	UINT32		len			= 0U;
	UINT32		address		= 0U;
	BOOLEAN	read_success	= FALSE;
	
	hmi_printf_time("get_shader_data_from_file begin",0);
	if(esContext != NULL)
	{
		if(type == GL_VERTEX_SHADER)
		{
			address	= esContext->hmi_vertex_shader_offset;
			len		= esContext->hmi_vertex_shader_len;
		}
		else if(type == GL_FRAGMENT_SHADER)
		{
			address	= esContext->hmi_fragment_shader_offset;
			len		= esContext->hmi_fragment_shader_len;
		}
		else
		{
			
			printf("File path error\n");
			hmi_printf_time("File path error",0);
			#if(HMI_ENDLESS_LOOP == YES)
			while(1);/*error parameter*/
			#endif
		}

		
		pdata	= (U08 *)HMI_MALLOC(len);
	
		hmi_printf_time("get_shader_data_from_file malloc pdata address is",pdata);
		hmi_printf_time("get_shader_data_from_file malloc pdata len is",len);
		if(pdata != NULL)
		{
			read_success	= hmi_read_data(address,len,										
											pdata,len,0/*font data,shader at 0 segment*/);
			if(read_success == FALSE)
			{
			
				hmi_printf_time("get_shader_data_from_file free pdata address is",(SINT32)pdata);
				HMI_FREE(pdata);
				pdata	= NULL; 
				
				printf("Read file error\n");
				hmi_printf_time("Read file error",0);
				#if(HMI_ENDLESS_LOOP == YES)
				while(1);/*read data error*/
				#endif
			}
		}
		else
		{
			
			printf("malloc failed  len is %d\n",len);
			hmi_printf_time("malloc failed len is",len);
			#if(HMI_ENDLESS_LOOP == YES)
			while(1);/*malloc failed*/
			#endif
		}	
	}
	else
	{
		hmi_printf_time("get_shader_data_from_file esContext is null",0);
	}
	
	hmi_printf_time("get_shader_data_from_file end",0);
	return		pdata;
}


