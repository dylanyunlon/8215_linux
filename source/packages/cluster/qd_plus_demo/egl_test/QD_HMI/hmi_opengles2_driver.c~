/*get color format length*/

BYTE get_color_len(TEXTURE_2D_PIXEL_FORMAT color_fmt)
{
	BYTE	len	= 0U;
	
	if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_RGB565 )
	{
		len	= 2U;
	}
	else if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_RGBA8888 )			
	{
		len	= 4U;
	}
	else if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_RGB888 )			
	{
		len	= 3U;
	}
	else if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_A8)			
	{
		len	= 1U;
	}	
	else if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_ETC1)			
	{
		len	= 3U;
	}
	else if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_ETC2RGB888)			
	{
		len	= 3U;
	}
	else if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_ETC2RGBA8888)			
	{
		len	= 4U;
	}
	else
	{
		len	= 2;
		
		printf("get_color_len error\n");
		hmi_printf_time("get_color_len error",0);
		#if(HMI_ENDLESS_LOOP == YES)
		while(1);/*Not support pixel format*/
		#endif
	}
	
	return len;
}



