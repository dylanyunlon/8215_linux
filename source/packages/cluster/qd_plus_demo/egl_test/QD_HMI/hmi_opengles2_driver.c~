	glBufferData(GL_ARRAY_BUFFER, HMI_VERTEX_NOR_ARRAY_LEN,
						image_vertex_nor, QD_DRAW_IMAGE_METHORD);

	/*bind texture 0 data to buffer*/
	glBindBuffer(GL_ARRAY_BUFFER, 
						v_buffer_id[VERTEX_TEX_COOR_BUF_INDX]);
	glBufferData(GL_ARRAY_BUFFER, HMI_VERTEX_TEX0_ARRAY_LEN,
					image_vertex_tex0, QD_DRAW_IMAGE_METHORD);

	/*bind element index data to buffer*/
	glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 
					v_buffer_id[VERTEX_INDEX_BUF_INDX]);
	glBufferData(GL_ELEMENT_ARRAY_BUFFER,HMI_VERTEX_INDEX_ARRAY_LEN,
					image_vertex_index, QD_DRAW_IMAGE_METHORD);

	/*******************Enable vertex buffer**************/
	glBindBuffer(GL_ARRAY_BUFFER, 
				v_buffer_id[VERTEX_POS_BUF_INDX]);
	glEnableVertexAttribArray(VERTEX_POS_INDX);
	
	glBindBuffer(GL_ARRAY_BUFFER, 
				v_buffer_id[VERTEX_NORMAL_BUF_INDX]);
	glEnableVertexAttribArray(VERTEX_NORMAL_INDX);
	
	glBindBuffer(GL_ARRAY_BUFFER, 
				v_buffer_id[VERTEX_TEX_COOR_BUF_INDX]);
	
	glEnableVertexAttribArray(VERTEX_TEXCOORD0_INDX);

	/******************Vertex Data stride**************/
	glVertexAttribPointer(VERTEX_POS_INDX, 
							VERTEX_POS_SIZE,
							GL_FLOAT, GL_FALSE, 
							1, 0);
	
	glVertexAttribPointer(VERTEX_NORMAL_INDX, 
							VERTEX_NORMAL_SIZE,
							GL_FLOAT, GL_FALSE, 
							1, 0);
	
	glVertexAttribPointer(VERTEX_TEXCOORD0_INDX,
							VERTEX_TEXCOORD0_SIZE,
							GL_FLOAT, GL_FALSE, 
							1, 0);


	#endif
	
}


