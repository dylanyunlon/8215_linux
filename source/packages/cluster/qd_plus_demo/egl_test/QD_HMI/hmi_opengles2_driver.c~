void hmi_clear_dirty_layer(HMI_RECT_STR *pdirty_zone,
								U08	screen)
{	
	U08						i					= 0U;
	UINT32 					index				= 0U;
	UINT8					clip_index			= 0U;
	UINT8					next_clip_index		= 0U;
	HMI_RECT_STR			hmi_temp_rect		= {HMI_INVALID_COOR,HMI_INVALID_COOR,0U,0U};
	HMI_Y_STR				clip_y				= 0;
	U08						win_no				= 0U;
	HMI_RECT_STR			hmi_min_dirty_rect	= {0,0,0U,0U};
	
	
	
	if(pdirty_zone != NULL)
	{	
		for(i = 0U;i < HMI_LAYER_MAX_CNT;i++)
		{			
			if((pdirty_zone[i].x != HMI_INVALID_COOR)&&
				(pdirty_zone[i].y != HMI_INVALID_COOR))
			{	
				glEnable(GL_SCISSOR_TEST);  
				#ifdef HMI_RENDER_FULL_SCREEN
				/*Clip position*/						
				glScissor(0/*left*/,0/*bottom*/,
						hmi_screen_size[screen].x,
						hmi_screen_size[screen].y);  
										
				glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);  						
				#else
				clip_index		= 0U;
				next_clip_index	= HMI_LAYER_MAX_CNT + HMI_DIRTY_FIFO_LEN*i;
				while((clip_index < HMI_DIRTY_FIFO_LEN)&&			
						(pdirty_zone[next_clip_index].w	 > 0U)&&	
						(pdirty_zone[next_clip_index].h	 > 0U))
				{							
					/*Clip position*/
					//hmi_get_union_rect(pclip_rect,(&pdirty_rect[next_clip_index]),&hmi_min_dirty_rect);
					hmi_min_dirty_rect.x	= pdirty_zone[next_clip_index].x;
					hmi_min_dirty_rect.y	= pdirty_zone[next_clip_index].y;
					hmi_min_dirty_rect.w	= pdirty_zone[next_clip_index].w;
					hmi_min_dirty_rect.h	= pdirty_zone[next_clip_index].h;
					if((hmi_min_dirty_rect.w > 0U)&&((hmi_min_dirty_rect.h	> 0U)))
					{					
						hmi_convert_clip_rect(&hmi_min_dirty_rect,screen);
						glScissor((GLint)(hmi_min_dirty_rect.x),(GLint)(hmi_min_dirty_rect.y),
								(GLsizei)(hmi_min_dirty_rect.w),(GLsizei)(hmi_min_dirty_rect.h));
						glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);  
					}							
					clip_index++;
					next_clip_index++;
				}
				#endif

			#if (HMI_R_ASYNCHRONOUS_HW_UPDATE == HMI_YES)
				/*glFlush();*/
			#else
				/*glFinish();*/
			#endif																
			}										
		}
	}  
}


 
