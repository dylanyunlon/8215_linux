	U08						screen_no		= 0U;
	U16						index			= 0U;
	SINT16					pos_index		= 0U;

	/*scale*/
	BOOLEAN				bcontainer_scale	= FALSE;
	float_32					scale			= 1.0f;
	HMI_X_STR				hmi_screen_origin_x	= 0;
	HMI_Y_STR				hmi_screen_origin_y	= 0;
#if(HMI_THAI_ENABLE== HMI_YES)
#if HMI_FONT_CODE == HMI_FONT_CODE_UNICODE
	BOOLEAN 			search_success	 = FALSE;
	HMI_FONT_CHAR_PROP	CONST * pTai_font_config	= NULL;
	HMI_CHAR_STR		hmi_last_char_index		= 0U;
	HMI_CHAR_STR		hmi_next_char_index		= 0U;
	UINT16				thai_special_char_len 	= 0U;
	UINT16				thai_index					= 0U;
#endif
#endif
	if(hmi_loc_qd_unit < HMI_SCREEN_NO)// 2020 10 16
	{
		screen_no	= hmi_loc_qd_unit;
	}
	if(pfather_alpha_scale == NULL)
	{
		bcontainer_scale	= FALSE;
		scale			= 1.0f;
	}
	else
	{
		if(fabs(pfather_alpha_scale->scale -HMI_SCALE_1) > HMI_FLOAT_TOLERANCE)
		{
			bcontainer_scale	= TRUE ;			
		}
		else
		{
			bcontainer_scale	= FALSE ;
		}		
		scale			= pfather_alpha_scale->scale;
	}

	if(len > (str_len * HMI_IMAGE_VERTEX_CNT * VERTEX_POS_SIZE))
	{
		success = TRUE;
	}
	else
	{
		success = FALSE;
	}
	if((success == TRUE)&&(ptext_zone != NULL))
	{
		text_width		= (SINT16)(ptext_zone->text_rect.x + ptext_zone->text_rect.w);
		char_print_x		= ptext_zone->text_rect.x;
		char_print_y		= ptext_zone->text_rect.y;
		index			= index_start;
		while((index < index_end)&&(char_print_x <= text_width)&&(pstring[index] != '\0'))
		{
			hmi_hb_char = pstring[index];
			hmi_lb_char = pstring[index + 1];
			char_id 	= hmi_get_value_char(hmi_hb_char,
										hmi_lb_char,&text_offset);
			if(char_id  != HMI_CHAR_TAB)
			{
				
				pchar_prop	= hmi_driver_get_char_data2(char_id,font_id);
				if((pchar_prop != NULL)&&
					(pos_index + HMI_IMAGE_VERTEX_CNT * VERTEX_POS_SIZE) <= len)
				{	
					/*get position*/
					left_top_x			= char_print_x + pchar_prop->x_soffset;
					left_top_y			= char_print_y + pchar_prop->y_soffset;
					
				#if(HMI_THAI_ENABLE== HMI_YES)
				#if (HMI_FONT_CODE == HMI_FONT_CODE_UNICODE)
					if((char_id >= HMI_THAI_TONE_BEGIN)&&(char_id <= HMI_THAI_TONE_END))
					{
						/*rule 1 last char is cap ,tone must shift up*/
						thai_special_char_len 			= 0u;
						search_success	= FALSE;
						if(index > 0u)
						{
							hmi_last_char_index = index - 1u;
							while((thai_special_char_len < HMI_THAI_CAP_NB)&&(search_success == FALSE))
							{
								if(pstring[hmi_last_char_index] == hmi_thai_cap_char[thai_special_char_len])
								{
									search_success = TRUE;
								}
								thai_special_char_len++;
							}
							if(search_success == TRUE)
							{
								pTai_font_config	= hmi_driver_get_char_data2(pstring[hmi_last_char_index],font_id);
								left_top_y	-= (pTai_font_config->h+HMI_THAI_CAP_LINE_SPACE);
							}
						}
						/*rule 2  next char is HMI_THAI_CAP_0E33 ,tone must shift up*/
						hmi_next_char_index = index+1;
						if(hmi_next_char_index < index_end)
						{
							if(pstring[hmi_next_char_index] == HMI_THAI_CAP_0E33)
							{
								left_top_y	-= (pchar_prop->h+HMI_THAI_CAP_LINE_SPACE);
							}
						}
					
					}
					/*rule 3 last char is HMI_THAI_CHAR_0E1B,HMI_THAI_CHAR_0E1D,HMI_THAI_CHAR_0E1F ,tone or cap must shift left */
					
					{
						thai_special_char_len 			= 0u;
						search_success = FALSE;
						while((thai_special_char_len < HMI_THAI_CAP_NB)&&(search_success == FALSE))
						{
							if(pstring[index] == hmi_thai_cap_char[thai_special_char_len])
							{
								search_success = TRUE;
							}
							thai_special_char_len++;
						}
						if((search_success == TRUE)||/*CAP*/
							((char_id >= HMI_THAI_TONE_BEGIN)&&(char_id <= HMI_THAI_TONE_END)))/*TONE*/
						{
							if(index > 0)
							{
								hmi_last_char_index = index - 1u;
								if((pstring[hmi_last_char_index] == HMI_THAI_CHAR_0E1B)||
									(pstring[hmi_last_char_index] == HMI_THAI_CHAR_0E1D)||
									(pstring[hmi_last_char_index] == HMI_THAI_CHAR_0E1F))
								{
									
										left_top_x	-= HMI_THAI_LEFT_SHIFT_PIXEL;
								}
								else
								{
									if(index > 1u)
									{
										if((pstring[hmi_last_char_index] >= HMI_THAI_SHOES_BEGIN)&&
											(pstring[hmi_last_char_index] <= HMI_THAI_SHOES_END))/*SHOES*/
										{
											hmi_last_char_index -= 1u;
											if((pstring[hmi_last_char_index] == HMI_THAI_CHAR_0E1B)||
												(pstring[hmi_last_char_index] == HMI_THAI_CHAR_0E1D)||
												(pstring[hmi_last_char_index] == HMI_THAI_CHAR_0E1F))
											{
													left_top_x	-= HMI_THAI_LEFT_SHIFT_PIXEL;
											}
										}
									}
								}
							}
							
						}
					}
#endif						
#endif
					right_bottom_x	= left_top_x + pchar_prop->w;
					right_bottom_y	= left_top_y + pchar_prop->h;
					
					if(bcontainer_scale == TRUE)
					{	
					/*******scale left_top_x,left_top_y***/
						/*container scale point as origin*/
						HMI_COORDINATE_ORIGIN_TRANS(left_top_x,
												left_top_y,
												((SINT16)pfather_alpha_scale->point.x),
												((SINT16)pfather_alpha_scale->point.y));
						/*scale*/	
						left_top_x		= (HMI_X_STR)(left_top_x * scale + 0.5f);
						left_top_y		= (HMI_X_STR)(left_top_y * scale + 0.5f);

						/*convert to screen coordinate*/
						hmi_screen_origin_x = 0;
						hmi_screen_origin_y = 0;
						HMI_COORDINATE_ORIGIN_TRANS( (hmi_screen_origin_x),
													(hmi_screen_origin_y),
													(HMI_X_STR)(pfather_alpha_scale->point.x),
													(HMI_Y_STR)(pfather_alpha_scale->point.y));
						HMI_COORDINATE_ORIGIN_TRANS(left_top_x,left_top_y,
													hmi_screen_origin_x,
													hmi_screen_origin_y);

					/*******scale right_bottom_x,right_bottom_y***/
						/*container scale point as origin*/
						HMI_COORDINATE_ORIGIN_TRANS((right_bottom_x),
												right_bottom_y,
												(SINT16)(pfather_alpha_scale->point.x),
												(SINT16)(pfather_alpha_scale->point.y));
						/*scale*/	
						right_bottom_x		= (HMI_X_STR)(right_bottom_x * scale + 0.5f);
						right_bottom_y		= (HMI_X_STR)(right_bottom_y * scale + 0.5f);

						/*convert to screen coordinate*/
						hmi_screen_origin_x = 0;
						hmi_screen_origin_y = 0;
						HMI_COORDINATE_ORIGIN_TRANS(hmi_screen_origin_x,hmi_screen_origin_y,
													(HMI_X_STR)(pfather_alpha_scale->point.x),
													(HMI_Y_STR)(pfather_alpha_scale->point.y));
						HMI_COORDINATE_ORIGIN_TRANS(right_bottom_x,right_bottom_y,
												hmi_screen_origin_x,
												hmi_screen_origin_y);
						
					}

					if((char_id > 32/*BLANK*/)&&(pchar_prop->char_data != 0))
					{
						/*convert opengl coordinate*/
						pos.x			= (float_32)left_top_x;
						pos.y			= (float_32)left_top_y;
						pos.z			= -HMI_PERSPECTIVE_POS;
						get_screen_center_coordinate_reverse_y_3d(&pos,screen_no);
						text_char_pos[pos_index++]	= pos.x;
						text_char_pos[pos_index++]	= pos.y;
						text_char_pos[pos_index++]	= pos.z;
						
						pos.x	= (float_32)left_top_x;
						pos.y	= (float_32)right_bottom_y;
						get_screen_center_coordinate_reverse_y_3d(&pos,screen_no);
						text_char_pos[pos_index++]	= pos.x;
						text_char_pos[pos_index++]	= pos.y;
						text_char_pos[pos_index++]	= pos.z;

						pos.x	= (float_32)right_bottom_x;
						pos.y	= (float_32)right_bottom_y;
						get_screen_center_coordinate_reverse_y_3d(&pos,screen_no);
						text_char_pos[pos_index++]	= pos.x;
						text_char_pos[pos_index++]	= pos.y;
						text_char_pos[pos_index++]	= pos.z;

						pos.x	= (float_32)right_bottom_x;
						pos.y	= (float_32)left_top_y;
						get_screen_center_coordinate_reverse_y_3d(&pos,screen_no);
						text_char_pos[pos_index++]	= pos.x;
						text_char_pos[pos_index++]	= pos.y;
						text_char_pos[pos_index++]	= pos.z;
					}

					/*next char print position*/
					char_print_x	+= pchar_prop->owidth + HMI_CHAR_SPACE;
					
					index++;
					index	+= text_offset;
				}
			}
			else
			{
				/*tab char,add x offset*/
				index++;
				hmi_hb_char = pstring[index];
				hmi_lb_char = pstring[index + 1];
				char_id 	= hmi_get_value_char(hmi_hb_char,
										hmi_lb_char,&text_offset);
				index++;
				char_print_x +=char_id;
			}
		}
		pos_len = pos_index;
	}

	return	pos_len;
}


