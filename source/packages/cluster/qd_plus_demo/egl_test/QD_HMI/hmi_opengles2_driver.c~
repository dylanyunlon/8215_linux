void	*hmi_malloc_vram(UINT32 len)
{
	void *pmem	= NULL;

	if(len > 0U)
	{
	#if(HMI_USE_QD_HEAP == NO)
		pmem	= HMI_MALLOC(len);
	#else
		pmem	= hmi_get_qd_buffer(len);
	#endif
	}
	return	pmem;
}


void hmi_trail_segment2float_vertex(SPOINT_TP trail_segment[],
							U16 trail_segment_len,
							GLfloat gl_vertex[],
							U16		gl_vertex_len)
{	
	U16		loop		= 0U;
	U16		index	= 0U;

	for(loop = 0U;loop < trail_segment_len;loop++)
	{
		if(index + 1 < gl_vertex_len)
		{
			gl_vertex[index++]	= trail_segment[loop].x;
			gl_vertex[index++]	= trail_segment[loop].y;
		}
	}
}


