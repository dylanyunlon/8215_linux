static void locDecompressRLE(U08 *pdst, U32 decode_buffer_len,U08 *psrc, UINT32 size, U08 Bpp)
{
	U08  pixelcounter		= 0U;
	U16  bytecounter		= 0U;
	U08  repeat			= 0U;
	U08  data			= 0U;
	U08  loop			= 0U;
	U08  j				= 0U;
	U32	write_len			= 0U;

   if(Bpp == 4)
   {
		while (size > 0)
		{
			data			= *psrc;
			pixelcounter	= (data & 0x7F) + 1;
			repeat			= (data >> 7);
			psrc++;
			size -= 1U;
						        	        
			if (repeat == 1U)/*repeat*/
			{			   
		   		if(size >= 4)
		   		{
					write_len	= pixelcounter * 4;
					if(decode_buffer_len >= write_len)
					{
						for(loop = 0U;loop < pixelcounter;loop++)
						{
							*((UINT32 *)(pdst))	= *((UINT32 *)(psrc));
							pdst	+= 4;						
						}
						psrc	+= 4;
						size 	-= 4U;
						decode_buffer_len	-= write_len;
					}
		   		}
				else
				{
					size	= 0U;
				}
			}						  
			else /*not repeat*/
			{
				bytecounter	= pixelcounter * Bpp;
				if((size >= bytecounter)&&(decode_buffer_len >= bytecounter))
				{
					memcpy(pdst, psrc, bytecounter);
					pdst	+= bytecounter;
					psrc	+= bytecounter;
					size 	-= bytecounter;
					decode_buffer_len	-= bytecounter;
				}
				else
				{
					size	= 0U;
				}
			}					           			
		}		
   }
   else if(Bpp == 3)
   {
   		while (size > 0)
		{
			data = *psrc;
			pixelcounter	= (data & 0x7F) + 1;
			repeat			= (data >> 7);
			psrc++;
			size -= 1U;
						        	        
			if (repeat == 1U)/*repeat*/
			{			   
		   		if(size >= 3)
		   		{
					write_len	= pixelcounter * 3;
					if(decode_buffer_len >= write_len)
					{
						for(loop = 0U;loop < pixelcounter;loop++)
						{
							*pdst		= *psrc;
							*(pdst + 1)	= *(psrc + 1);
							*(pdst + 2)	= *(psrc + 2);
							pdst	+= 3;												
						}
						psrc	+= 3;
						size 	-= 3U;
						decode_buffer_len -= write_len;
					}
		   		}
				else
				{
					size	= 0U;
				}
			}						  
			else /*not repeat*/
			{
				bytecounter	= pixelcounter * Bpp;
				if((size >= bytecounter)&&(decode_buffer_len >= bytecounter))
				{
					memcpy(pdst, psrc, bytecounter);
					pdst	+= bytecounter;
					psrc	+= bytecounter;
					size 	-= bytecounter;
					decode_buffer_len -= bytecounter;
				}
				else
				{
					size	= 0U;
				}
			}					           			
		}
   }
   else
   {
   }
}


HMI_DECODE_STATUS_STR	decode_RLE2Mem(U08	*p_decode_buffer,
							UINT32 address,UINT32 len,
							U16 width,U16 height,
							TEXTURE_2D_PIXEL_FORMAT pixel_fmt,
							U32 decode_buffer_len,
							U08	seg_no
							)
{
	HMI_DECODE_STATUS_STR	status				= HMI_DECODE_STATUS_CNT;		 
	U08						*psrc				= NULL;
	U08						Bpp					= 0U;
	U08						*p_filedata_buffer	= NULL;
	BOOLEAN					success				= FALSE;
	
	if(pixel_fmt == TEXTURE_2D_PIXEL_FORMAT_RGBA8888)
	{		
		Bpp		= 4U;
	}
	else if(pixel_fmt == TEXTURE_2D_PIXEL_FORMAT_RGB888)
	{		
		Bpp		= 3U;
	}
	else
	{
		Bpp		= 0U;
	}

	if(Bpp != 0U)
	{
		/*malloc memory for read data*/
		psrc	= (U08 *)hmi_malloc_memory(len);
		if(psrc != NULL)
		{
			/*read data from file*/
			success	= hmi_read_data(address,len,
						psrc,len,seg_no);
			if(success == TRUE)
			{
				/*Decode RLE*/
				locDecompressRLE(p_decode_buffer,
								decode_buffer_len,
								psrc,len,Bpp);
				status	= HMI_DECODE_IMAGE_SUCCESS;
			}
			else
			{
				status	= HMI_DECODE_IMAGE_FAILED;
			}
			hmi_dealloc_vram(psrc);
			psrc	= NULL;
		}
		else
		{
			status	= HMI_DECODE_IMAGE_MEM_NOT_ENOUGH;
		}
	}

	
	return	status;
}

