		image_vertex_color[index + HMI_ABGR_COLOR_A]	= a_f2;
		index	+= VERTEX_COLOR_SIZE;

		image_vertex_color[index + HMI_ABGR_COLOR_R]	= r_f2;
		image_vertex_color[index + HMI_ABGR_COLOR_G]	= g_f2;
		image_vertex_color[index + HMI_ABGR_COLOR_B]	= b_f2;
		image_vertex_color[index + HMI_ABGR_COLOR_A]	= a_f2;		
	}
}


void get_screen_center_coordinate_reverse_y_3d(S3POINT_FLOAT_TP *ppointer,U08 screen_no)
{
	HMI_WIDTH_STR	screen_center_x	= 0U;
	HMI_HEIGHT_STR	screen_center_y	= 0U;
	
	if((ppointer != NULL)&&((screen_no < HMI_SCREEN_NO)))
	{
		screen_center_x	= (hmi_screen_size[screen_no].x) >> 1;
		screen_center_y	= (hmi_screen_size[screen_no].y) >> 1;

		ppointer[0].x	= ppointer[0].x - screen_center_x;
		ppointer[0].y	= screen_center_y - ppointer[0].y;	
		/*ppointer[0].z	= */
	}
}

