void	hmi_get_max_min_uv(GLfloat image_vertex_tex0[],
									U16	texture_uv_len,
									GLfloat	*pmax_u,GLfloat	*pmax_v,
									GLfloat	*pmin_u,GLfloat	*pmin_v)
{
	U16		i		= 0u;

	if((pmax_u != NULL)&&
		(pmax_v != NULL)&&
		(pmin_u != NULL)&&
		(pmin_v != NULL))
	{
		*pmax_u	= 0.0f;
		*pmax_v	= 0.0f;
		*pmin_u	= 1.0f;
		*pmin_v	= 1.0f;

		for(i = 0u;(i + 1) < texture_uv_len;i += 2/*UV*/)
		{
			/*Get max UV,min UV*/
			if(image_vertex_tex0[i/*u*/] > *pmax_u)
			{
				*pmax_u	= image_vertex_tex0[i/*u*/];
			}
			else if(image_vertex_tex0[i/*u*/] < *pmin_u)
			{
				*pmin_u	= image_vertex_tex0[i/*u*/];
			}
			else
			{
			}
			
			if(image_vertex_tex0[i + 1/*v*/] > *pmax_v)
			{
				*pmax_v	= image_vertex_tex0[i + 1/*v*/];
			}			
			else if(image_vertex_tex0[i + 1/*v*/] < *pmin_v)
			{
				*pmin_v	= image_vertex_tex0[i + 1/*v*/];
			}
			else
			{
			}			
		}
	}
}

void	hmi_check_in_max_min_uv(GLfloat image_vertex_tex0[],
									U16	texture_uv_len,
									GLfloat	max_u,GLfloat	max_v,
									GLfloat	min_u,GLfloat	min_v)
{
	U16		i		= 0u;

	for(i = 0u;(i + 1) < texture_uv_len;i += 2u)
	{
		/*check U*/
		if(image_vertex_tex0[i] > max_u)
		{
			image_vertex_tex0[i] = max_u;
		}
		else if(image_vertex_tex0[i] < min_u)
		{
			image_vertex_tex0[i] = min_u;
		}
		/*check V*/
		if(image_vertex_tex0[i + 1] > max_v)
		{
			image_vertex_tex0[i + 1] = max_v;
		}
		else if(image_vertex_tex0[i + 1] < min_v)
		{
			image_vertex_tex0[i + 1] = min_v;
		}
	}
}


