	{
		radius_max	= circle_radius_w;
	}
	else
	{
		radius_max	= circle_radius_h;
	}
	left_top.x	= -radius_max;
	left_top.y	= -radius_max;

	right_bottom.x	= radius_max;
	right_bottom.y	= radius_max;
	
	end_no		= get_joint_with_trail_container_boder(&left_top,&right_bottom,
