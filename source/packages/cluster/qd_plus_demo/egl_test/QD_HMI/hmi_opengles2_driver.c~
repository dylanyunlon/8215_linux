 BOOLEAN hmi_farsi_search(HMI_CHAR_STR char_farsi,HMI_CHAR_STR CONST* char_list,UINT8 list_len)
 {
	 BOOLEAN success		 = FALSE;
	 SINT16  hmi_mid		 = 0;
	 SINT16  hmi_low		 = 0;
	 SINT16  hmi_high		 = 0;
 
	 hmi_low	 = 0U;
	 hmi_high	 = list_len - 1;
	 
	 while((hmi_low <= hmi_high)&&(success == FALSE))
	 {
		 hmi_mid	 = ((hmi_low + hmi_high) >> 1);
		 if(char_list[hmi_mid] > char_farsi)
		 {
			 hmi_high	 = hmi_mid - 1;
		 }
		 else if(char_list[hmi_mid] < char_farsi)
		 {
			 hmi_low	 = hmi_mid + 1;
		 }
		 else 
		 {
			 success = TRUE;
		 }		 
	 }
	 
	 return success;
 }
 
 
 HMI_CHAR_STR hmi_change_to_concatenation_character(HMI_CHAR_STR left_char,HMI_CHAR_STR middle_char,HMI_CHAR_STR right_char)
 {
	 HMI_CHAR_STR		 hmi_connect_char	 = 0U;
	 HMI_FARSI_CHAR_TYPE hmi_char_type		 = HMI_FARSI_TYPE_LEN;
	 BOOLEAN			 hmi_first_connect	 = FALSE;
	 BOOLEAN			 hmi_last_connect	 = FALSE;
	 UINT8				 hmi_index			 = 0U;
	 BOOLEAN			 hmi_greate_arabic_min	 = FALSE;
	 BOOLEAN			 hmi_less_arabic_max	 = FALSE;
	 BOOLEAN			 hmi_greate_farsi_min	 = FALSE;
	 BOOLEAN			 hmi_less_farsi_max 	 = FALSE;
	 
	 if(middle_char < HMI_ARABIC_MIN)
	 {
		 hmi_connect_char	 = middle_char; 
	 }
	 else if(middle_char > HMI_FARSI_MAX)
	 {
		 hmi_connect_char	 = middle_char; 
	 }
	 else
	 {
		 hmi_greate_arabic_min	 = middle_char >= HMI_ARABIC_MIN;
		 hmi_less_arabic_max	 = middle_char <= HMI_ARABIC_MAX;
		 hmi_greate_farsi_min	 = middle_char >= HMI_FARSI_MIN;
		 hmi_less_farsi_max 	 = middle_char <= HMI_FARSI_MAX;
		 if(((hmi_greate_arabic_min == TRUE)&&(hmi_less_arabic_max == TRUE))||
			 ((hmi_greate_farsi_min == TRUE)&&(hmi_less_farsi_max == TRUE)))
		 {
			 if(left_char != 0U)
			 {
				 hmi_first_connect	 = hmi_farsi_search(left_char,
											 hmi_farsi_first_connect_char,
											 HMI_FARSI_CHAR_FIRST_CONNECT);
			 }
			 if(right_char != 0U)
			 {
				 hmi_last_connect	 = hmi_farsi_search(right_char,
											 hmi_farsi_last_connect_char,
											 HMI_FARSI_CHAR_LAST_CONNECT);
			 }
			 if((hmi_first_connect == TRUE) && (hmi_last_connect == TRUE))
			 {
				 hmi_char_type	 = HMI_MIDDLE_CON;
			 }
			 else if(hmi_first_connect == TRUE)
			 {
				 hmi_char_type = HMI_FIRST_CON;
			 }
			 else if(hmi_last_connect == TRUE)
			 {
				 hmi_char_type = HMI_LAST_CON;
			 }
			 else 
			 {
				 hmi_char_type = HMI_ALONE_CON;
			 }
		 }
 
 
		 
		 if((hmi_greate_arabic_min == TRUE)&&
			 (hmi_less_arabic_max == TRUE))
		 {
			 hmi_index			 = middle_char - HMI_ARABIC_MIN;
			 hmi_connect_char	 = hmi_farsi_char[hmi_index][hmi_char_type];
		 }
		 else if((hmi_greate_farsi_min == TRUE)&&
			 (hmi_less_farsi_max == TRUE))
		 {
			 hmi_index = 0;
			 while((middle_char != hmi_farsi_char_list[hmi_index])&&
				 (hmi_index < HMI_FARSI_CHAR_NUMBER))
			 {
				 hmi_index++;
			 }
			 
			 if(hmi_index < HMI_FARSI_CHAR_NUMBER)
			 {
				 hmi_index			 += (HMI_ARABIC_MAX - HMI_ARABIC_MIN + 1);
				 hmi_connect_char	 = hmi_farsi_char[hmi_index][hmi_char_type];
			 }
			 else
			 {
				 hmi_connect_char = middle_char;
			 }
			 
		 }
		 else
		 {
			 hmi_connect_char = middle_char;
		 }
	 }
 
	 return hmi_connect_char;
 }
