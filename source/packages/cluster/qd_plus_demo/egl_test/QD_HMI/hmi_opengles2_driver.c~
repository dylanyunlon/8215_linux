void drawLineWithoutVBOs(GLfloat			vtxLine[],	
									INT32			vtxLine_array_cnt,
									float_32		line_w,
									HMI_COLOR_STR	one_color,
									INT32			line_type,/*0:GL_LINES.1:GL_LINE_STRIP.2:GL_LINE_LOOP*/
									BOOLEAN			bLine)
{				
	//glBindBuffer(GL_ARRAY_BUFFER, 0);
	//glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
	GLsizei		count	= 0;

	if((line_w > 0.0f)&&(vtxLine_array_cnt > 0))
	{
		hmi_disable_vertex_Array();
		/*Enable vertex*/
		glEnableVertexAttribArray(VERTEX_POS_INDX);
		/*set vertex array*/
		glVertexAttribPointer(VERTEX_POS_INDX, VERTEX_POS_SIZE,
							GL_FLOAT, GL_FALSE, 
							VERTEX_POS_SIZE * sizeof(GLfloat), 
							vtxLine);
		
		hmi_set_uniform_one_color(one_color);
		
		count	= (GLsizei)(vtxLine_array_cnt / 3/*x,y,z*/);
		if(bLine == TRUE)
		{
			glLineWidth(line_w);
			if(line_type == 0)
			{
				glDrawArrays(GL_LINES,0,count);
			}
			else if(line_type == 1)
			{
				glDrawArrays(GL_LINE_STRIP,0,count);
			}
			else if(line_type == 2)
			{
				glDrawArrays(GL_LINE_LOOP,0,count);
			}
			else
			{
				glDrawArrays(GL_LINES,0,count);
			}
		}
		else
		{
		#ifdef	HMI_SIMULATE_QD
			/* set point radius*/	
			glPointSize(line_w);
			glDrawArrays(GL_POINTS,0,count);
		#endif
		}
	}	
}


/*
get rect center position and scale 
*/
BOOLEAN get_rect_center_pointer_scale(HMI_RECT_STR *prect,
									HMI_SCALE_POS_STR *pscale_pos,
									U08	screen_no)
{
	BOOLEAN			success		= FALSE;
	float_32		x			= 0.0f;
	float_32		y			= 0.0f;	
	UINT16			half_w		= 0U;
	UINT16			half_h		= 0U;

	if((prect != NULL) &&(pscale_pos != NULL))
	{		
		if(screen_no < HMI_SCREEN_NO)
		{	
		#if 0	
			half_w	= (prect->w - 1u) >> 1U;
			half_h	= (prect->h - 1u) >> 1U;
		#endif
			half_w	= (prect->w) >> 1u;
			half_h	= (prect->h) >> 1u;
		
			pscale_pos->center_x	= (float_32)(prect->x + half_w);
			pscale_pos->center_y	= (float_32)(prect->y + half_h);
						
			pscale_pos->scale_x	= (float_32)((prect->w)/(float_32)(hmi_screen_size[screen_no].x));
			pscale_pos->scale_y	= (float_32)((prect->h)/(float_32)(hmi_screen_size[screen_no].y));

			success	= TRUE;
		}				
	}
	
	return	success;
}

/*
coordinate transform.
origin at screen center(x-->left,y-->up,z-->to your eye)
*/
void get_screen_center_coordinate_reverse_y(POINT32_TP *ppointer,U08 screen_no)
{
	HMI_WIDTH_STR	screen_center_x		= 0U;
	HMI_HEIGHT_STR	screen_center_y		= 0U;
	
	if((ppointer != NULL)&&((screen_no < HMI_SCREEN_NO)))
	{
		screen_center_x	= (hmi_screen_size[screen_no].x) >> 1U;
		screen_center_y	= (hmi_screen_size[screen_no].y) >> 1U;

		ppointer[0].x	= ppointer[0].x - screen_center_x;
		ppointer[0].y	= screen_center_y - ppointer[0].y;		
	}
}


