/*
Compress ETC FORMAT
#define GL_COMPRESSED_RGB8_ETC2           0x9274
#define GL_COMPRESSED_SRGB8_ETC2          0x9275
#define GL_COMPRESSED_RGB8_PUNCHTHROUGH_ALPHA1_ETC2 0x9276
#define GL_COMPRESSED_SRGB8_PUNCHTHROUGH_ALPHA1_ETC2 0x9277
#define GL_COMPRESSED_RGBA8_ETC2_EAC      0x9278
#define GL_COMPRESSED_SRGB8_ALPHA8_ETC2_EAC 0x9279

*/
GLuint create_texture_id(TEXTURE_2D_PIXEL_FORMAT color_fmt,
							U32	width,U32	height,
							CONST void *ppixels,
							UINT32 img_len,/*compressed data length*/
							BOOLEAN	bbig_img)
{
	GLuint		texture_Id			= 0U;
	GLuint		gl_pixel_fmt		= GL_RGB;
	GLenum		load_status			= 0u;
	SINT32		max_malloc_cnt		= 0U;
	BOOLEAN		release_success		= FALSE;
	UINT32		cache_len			= 0u;
	BYTE		pixel_byte_len		= 0u;
	DWORD		all_free_size		= 0u;
	DWORD		max_block_free_size	= 0u;

	if(ppixels != NULL)
	{
		if((gl_pixel_fmt == 0x8d64/*GL_ETC1_RGB8_OES*/)||
			(gl_pixel_fmt == 0x9274/*GL_COMPRESSED_RGB8_ETC2*/)||
			(gl_pixel_fmt == 0x9278/*GL_COMPRESSED_RGBA8_ETC2_EAC*/))
		{
			cache_len	= img_len;
		}
		else
		{
			pixel_byte_len	= get_color_len(color_fmt);
			cache_len		= (UINT32)(width * height/*lq*/ * pixel_byte_len);
		}
		qd_clear_mcu_cache((void *)ppixels,cache_len);// 2023 05 15
		
		gl_pixel_fmt	= qd_pixel_fmt2opegles_fmt(color_fmt);
		/* Use tightly packed data*/
		glPixelStorei ( GL_UNPACK_ALIGNMENT, 1 );

		/* Generate a texture object */
		glGenTextures ( 1, &texture_Id );
				
		/* Bind the texture object */
		if(texture_Id != 0)	/*2023 10 07*/
		{
			glBindTexture ( GL_TEXTURE_2D, texture_Id );
		}
		//glEnable(GL_TEXTURE_2D);// 2023 04 26

		load_status = glGetError();// 2022 03 18.clear last error
		do
		{
			/* Load the texture */
			#if 1
			if((gl_pixel_fmt == 0x8d64/*GL_ETC1_RGB8_OES*/)||
				(gl_pixel_fmt == 0x9274/*GL_COMPRESSED_RGB8_ETC2*/)||
				(gl_pixel_fmt == 0x9278/*GL_COMPRESSED_RGBA8_ETC2_EAC*/))
			{
				glCompressedTexImage2D ( GL_TEXTURE_2D, 0, 
						gl_pixel_fmt, width,
						height, 0, 	
						(GLsizei)(img_len),
						ppixels
						);			
			}
			else
			#endif
			{
				glTexImage2D ( GL_TEXTURE_2D, 0, 
							gl_pixel_fmt, width,
							height, 0, 
							gl_pixel_fmt,
							GL_UNSIGNED_BYTE, ppixels);			
			}
			load_status = glGetError();		// 2022 03 18
			#if HMI_MEMORY_LONG_TIME_RELEASE ==	HMI_YES
			if (load_status == GL_OUT_OF_MEMORY)
			//if (load_status != GL_NO_ERROR/*GL_OUT_OF_MEMORY*/)
			{
				release_success = hmi_release_texture_long_time_no_used(
										QD_CPU_GPU_MEMORY_RELEASE_OLD);
				if(release_success == TRUE)
				{
					max_malloc_cnt++;
				}
				else
				{
					max_malloc_cnt	= HMI_MAX_MALLOC_CNT;
				}						
			}	
			#endif

			
		}
		#if HMI_MEMORY_LONG_TIME_RELEASE ==	HMI_YES
		while((load_status == GL_OUT_OF_MEMORY)&&(max_malloc_cnt < HMI_MAX_MALLOC_CNT))	;	
		//while((load_status != GL_NO_ERROR)&&(max_malloc_cnt < HMI_MAX_MALLOC_CNT))	;	
		#else
		while(0);
		#endif
		
		/* Set the filtering mode */
		
		/*anti*/
	#if 1	
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR );
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR );
	#else
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST );
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST );
	#endif
				
		/*fill mode*/
	#if 1
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);	
	#else		
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_BORDER);
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_BORDER);
	#endif

		if((load_status != GL_NO_ERROR)	||(texture_Id == 0u))// 2023 10 07
		{
			printf("load textrue id=%d failed load status is %d\n",texture_Id,load_status);
			hmi_printf_time(" load textrue failed,texture",texture_Id);
			hmi_printf_time(" load status is",load_status);
			
			if(texture_Id != 0)
			{
				glDeleteTextures(1,&texture_Id);
				glBindTexture ( GL_TEXTURE_2D, 0);
			}
			texture_Id	= 0;
		}
		else
		{
			if(bbig_img == TRUE)
			{
				hmi_qd_used_big_img_cnt++;
				if(hmi_qd_used_big_img_cnt > HMI_MAX_USE_BIG_IMG_CNT)
				{				
					release_success = hmi_release_texture_long_time_no_used(
												QD_CPU_GPU_MEMORY_RELEASE_OLD);
						
				}
			}
		}
		/*check GPU video memory*/
		hmi_get_video_avail_memory(&all_free_size,&max_block_free_size);
		if(all_free_size < HMI_VGLITE_VIDEO_MEMORY_REMAIN)
		{
			release_success = hmi_release_texture_long_time_no_used(
												QD_CPU_GPU_MEMORY_RELEASE_OLD);
		}
		
	}

	return texture_Id;
}


GLuint create_texture_id_from_frmbuf(TEXTURE_2D_PIXEL_FORMAT color_fmt,
												INT32 	x,		INT32		y,
												INT32	width,	INT32	height,
												HMI_TEXTURE_UNIT_STR texture_unit)
{
	GLuint	texture_Id		= 0U;
	GLuint	gl_pixel_fmt	= GL_RGBA;
	GLenum	error			= 0;
	
	gl_pixel_fmt	= qd_pixel_fmt2opegles_fmt(color_fmt);
	/* Use tightly packed data*/
	glPixelStorei (GL_UNPACK_ALIGNMENT, 1/*4*/ );

	/* Generate a texture object */
	glGenTextures (1, &texture_Id );
	if((texture_Id != 0)&&(texture_unit < HMI_TEXTURE_UNIT_CNT))
	{
		glActiveTexture(GL_TEXTURE0 + texture_unit);
		glBindTexture(GL_TEXTURE_2D, texture_Id);
		//glEnable(GL_TEXTURE_2D);// 2023 04 26
			
		glCopyTexImage2D(GL_TEXTURE_2D,0,
						gl_pixel_fmt,
						(GLint)(x),
						(GLint)(y),
						(GLint)(width),
						(GLint)(height),
						0);
		#if 0
		glTexImage2D(GL_TEXTURE_2D, 0,internalFormat,
							texWidth, texHeight,
							0, internalFormat, 
							GL_UNSIGNED_BYTE, NULL);
		#endif
		/* Set the filtering mode */
	
		/*anti*/
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR );
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR );
		/*fill mode*/
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
		error	= glGetError();
		if(error != GL_NO_ERROR)
		{
		#if 0	/*2023 06 06*/
			glDeleteTextures(1, &texture_Id);
			texture_Id	= 0;
		#endif
		}
	}
							
	return texture_Id;
}


void load_texture_id(TEXTURE_2D_PIXEL_FORMAT color_fmt,
							U32	width,U32	height,
							GLuint texture_Id,
							CONST void *ppixels)
{	
	GLuint	gl_pixel_fmt	= GL_RGB;

	if(ppixels != NULL)
	{
		gl_pixel_fmt	= qd_pixel_fmt2opegles_fmt(color_fmt);
		/* Use tightly packed data*/
		glPixelStorei ( GL_UNPACK_ALIGNMENT, 1 );
						
		/* Bind the texture object */
		glBindTexture ( GL_TEXTURE_2D, texture_Id );

		/* Load the texture */
		glTexImage2D ( GL_TEXTURE_2D, 0, 
					gl_pixel_fmt, width,
					height, 0, 
					gl_pixel_fmt,
					GL_UNSIGNED_BYTE, ppixels);
		
		/*anti*/
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR );
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR );
		/*fill mode*/
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
		glTexParameteri ( GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
	}	
}

