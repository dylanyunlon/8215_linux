	UINT8						hmi_text_offset			= 0U;
	HMI_FONT_CHAR_STR			hmi_char					= 0U;
	HMI_WIDTH_STR				hmi_text_real_width		= 0U;

	if(phmi_string != NULL)	/*lq*/
	{
		phmi_temp_string		= (HMI_CHAR_STR	*)phmi_string;
		if(font_id < HMI_ALL_FONT_NUMBER)
