void	hmi_draw_draw_cublic_bezier_zone(HMI_RECT_STR		*pscreen_target,
													POINT_FLOAT_TP		path_data_f[],
													U08					bezierLength,
													HMI_COLOR_STR		color,
													HMI_RECT_STR		*pclip_rect,
													INT32				line_width)
{
	U08						alpha						= 0;	
	U08						onebezierLength				= 0;	
	HMI_SPLINE_PROP_STR		spline_prop_info/*relative xy list*/= {0};	
	UINT8					layer						= 0;								
	HMI_OBJECT_ID_STR		hmi_object_id				= 0;																		
	HMI_ALPHA_SCALE_PT_STR	*pfather_alpha_scale		= NULL;
	HMI_INPUT_POLYGON_STR  spline_input_point			= {0};	
	UINT32					hmi_spline_point_nb_size	= 0;
	
	alpha	= (U08)(color >> 24);
	if((bezierLength > 0)&&(alpha != 0u))
	{
				
		spline_prop_info.ppolygon								= &spline_input_point;
		spline_prop_info.line_w									= 1u;/*no used*/
		spline_prop_info.scale									= 1.0f;
		spline_prop_info.spline_color.fill_color				= color;
		spline_prop_info.spline_color.fill_flag					= HMI_FILL_NONE ;
		spline_prop_info.spline_color.spline_texture.ptex_attr	= NULL;
		spline_prop_info.spline_color.spline_texture.ptex_prop	= NULL;
		spline_prop_info.spline_color.spline_texture.ptex_rect	= NULL;
		spline_prop_info.spline_color.spline_texture.tex_id		= 0;
		
		spline_prop_info.spline_zone_color.fill_color					= color;
		spline_prop_info.spline_zone_color.fill_flag					= HMI_COLOR;
		spline_prop_info.spline_zone_color.spline_texture.ptex_attr		= NULL;
		spline_prop_info.spline_zone_color.spline_texture.ptex_prop		= NULL;
		spline_prop_info.spline_zone_color.spline_texture.ptex_rect		= NULL;
		spline_prop_info.spline_zone_color.spline_texture.tex_id		= 0;
		spline_prop_info.point_anticlockwise							= FALSE;
		spline_prop_info.spline_attr 									= HMI_CLOSE|HMI_NOT_EXPAND_SPINE|HMI_SPLINE_BIT6|HMI_SPLINE_FLOAT_BIT5;// not expand;

		spline_input_point.act_array_len			= bezierLength;
		spline_input_point.length					= bezierLength;
		spline_input_point.remain_length			= bezierLength;
		spline_input_point.phmi_input_point_polygon	= (POINT32_TP *)path_data_f;		
		spline_input_point.pnext_pre_list			= NULL;
										

		call_C_hmi_driver_draw_spline(pscreen_target,
										&spline_prop_info,
										pclip_rect,
										pclip_rect,
										0,/*layer*/
										0/*ID,No Used*/,
										NULL);	
			
				
	}
}

