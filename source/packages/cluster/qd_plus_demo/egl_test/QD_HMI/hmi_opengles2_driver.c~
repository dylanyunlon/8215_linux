/*
expand polygonal line to zone 
*/


#define	HMI_LINE_TO_ZONE_MINI_CNT			2
#define	HMI_EXPAND_MIN_POINT_CNT			2
#define HMI_SPLINE_INSCRIBED_POLY_CNT		12

/*
a poly line to poly zone
*/
INT32 hmi_line_to_zone(POINT32_TP vertex[], 
							INT32	vertex_len, 
							POINT32_TP vertex_zone[], 
							INT32	 vertex_zone_len,
							INT32	line_width)

{
	BOOLEAN			valide			= FALSE;
	INT32			i				= 0;
	INT32			expand_line_bold= 0;
	POINT32_TP		out_point		= {0,0};
	POINT32_TP		begin_point		= {0,0};
	POINT32_TP		end_point		= {0,0};
	INT32			index			= 0;
	POINT32_TP		vertex1_pallel	= {0,0};
	POINT32_TP		vertex2_pallel	= {0,0};

	valide	= (vertex_len >= HMI_LINE_TO_ZONE_MINI_CNT)&&
				(vertex_zone_len >= (vertex_len + vertex_len));
	if(valide == TRUE)
	{
		expand_line_bold		=((line_width) / 2U);

		/*expand outside*/
		hmi_2d_parallel_line(&vertex[i],
							&vertex[i + 1],
							&vertex1_pallel,
							&vertex2_pallel,
							expand_line_bold,
							FALSE/*CCW*/);
				
		vertex_zone[index].x	= vertex1_pallel.x;
		vertex_zone[index].y	= vertex1_pallel.y;		
		index++;
		
		for(i = 0; i < vertex_len - HMI_LINE_TO_ZONE_MINI_CNT; i++)
		{
			hmi_line_to_zone_one_point(&vertex[i],
									&vertex[i + 1],
									&vertex[i + 2],
									expand_line_bold,
									&out_point);
			if((out_point.x != 0)||(out_point.y != 0))/* not at one line*/
			{
				vertex_zone[index].x	= vertex[i + 1].x + out_point.x;
				vertex_zone[index].y	= vertex[i + 1].y + out_point.y;				
				index++;
			}
		}

		i = vertex_len - HMI_LINE_TO_ZONE_MINI_CNT;		
		hmi_2d_parallel_line(&vertex[i],
							&vertex[i + 1],
							&vertex1_pallel,
							&vertex2_pallel,
							expand_line_bold,
							FALSE/*CCW*/);
		
		vertex_zone[index].x	= vertex2_pallel.x;
		vertex_zone[index].y	= vertex2_pallel.y;		
		index++;
		
		/*expand inside*/		
		expand_line_bold	= line_width - expand_line_bold;
		//expand_line_bold	= -expand_line_bold;/*expand inside*/
		i	= vertex_len - 1;/*last vertex index*/
		
		hmi_2d_parallel_line(&vertex[i],
							&vertex[i - 1],
							&vertex1_pallel,
							&vertex2_pallel,
							expand_line_bold,
							FALSE/*CCW*/);
		
		vertex_zone[index].x	= vertex1_pallel.x;
		vertex_zone[index].y	= vertex1_pallel.y;		
		index++;
		
		for(i = vertex_len - 1; i >= HMI_LINE_TO_ZONE_MINI_CNT ; i--)
		{
			hmi_line_to_zone_one_point(&vertex[i],&vertex[i - 1],
									&vertex[i - 2],expand_line_bold,
									&out_point);
			if((out_point.x != 0)||(out_point.y != 0) )/* not at one line*/
			{
				vertex_zone[index].x	= vertex[i - 1].x + out_point.x;
				vertex_zone[index].y	= vertex[i - 1].y + out_point.y;
				index++;	
			}
		}

		i = 1;	
		hmi_2d_parallel_line(&vertex[i],
							&vertex[i - 1],
							&vertex1_pallel,
							&vertex2_pallel,
							expand_line_bold,
							FALSE/*CCW*/);
				
		vertex_zone[index].x	= vertex2_pallel.x;
		vertex_zone[index].y	= vertex2_pallel.y;
		index++;
		
		
	}
	else	/*one point ,get one circle*/
	{
		valide	= (vertex_len == 1/*one point*/);
		if(valide == TRUE)
		{
			#if 0
			hmi_circle_inscribed_poly(line_width,
							HMI_SPLINE_INSCRIBED_POLY_CNT,
							vertex_zone,
							vertex_zone_len);
			#endif
		}
	}

	return index;
}



