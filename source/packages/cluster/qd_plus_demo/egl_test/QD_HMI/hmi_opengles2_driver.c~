U16 hmi_get_char_pos_index(GLushort text_char_index[],
						U16		array_len,U16	pos_xyz_len)
{
	U16		loop			= 0U;
	U16		char_len		= 0U;
	U16		pos_index	= 0U;
	U16		uv_index		= 0U;
	U16		index_len	= 0U;

	char_len	= (U16)(pos_xyz_len / (HMI_IMAGE_VERTEX_CNT * VERTEX_POS_SIZE));
		
	for(loop = 0U;loop < char_len;loop ++)
	{
		text_char_index[uv_index + 0]	= pos_index + 0;
		text_char_index[uv_index + 1]	= pos_index + 1;
		text_char_index[uv_index + 2]	= pos_index + 2;
		text_char_index[uv_index + 3]	= pos_index + 0;
		text_char_index[uv_index + 4]	= pos_index + 2;
		text_char_index[uv_index + 5]	= pos_index + 3;	
		pos_index	+=  HMI_IMAGE_VERTEX_CNT;
		uv_index	+=	HMI_VERTEX_INDICS_ARRAY_LEN;
		
	}

	index_len	= uv_index;

	return	index_len;
}

void hmi_set_font_buf_cur_texture(UINT32	w,UINT32	h,
						HMI_AVL_TREE_ROOT_NODE_STR *proot)
{	
	GLuint							texture_id		= 0;	
	TEXTURE_2D_PIXEL_FORMAT			pixel_fmt			= TEXTURE_2D_PIXEL_FORMAT_A8;
	BYTE								*pbuffer			= NULL;			
	BOOLEAN						cur_texture		= FALSE;		
	GLuint							buf_texture_id	= 0;
		
	if((proot != NULL)&&(w != 0U)&&(h != 0U))
	{	
		buf_texture_id		= proot->texture_id;
		pbuffer			= proot->pbig_font_buffer;
		cur_texture		= (hmi_cur_font_buffer.phmi_cur_texture ==  pbuffer);								
		if((cur_texture == FALSE)&&(pbuffer != NULL))
		{			
			/*create texture id*/	
			if(buf_texture_id == 0)
			{
				/*Active texture*/		
				glActiveTexture(GL_TEXTURE0 + HMI_TEXTURE_UNIT_FONT_BUFFER);
				texture_id	= create_texture_id(pixel_fmt,
												w,
												h,
												pbuffer,
												0U/*no used*/,
												FALSE);											
				hmi_cur_font_buffer.phmi_cur_texture	= pbuffer;
				hmi_cur_font_buffer.texture_id			= texture_id;
				proot->texture_id						= texture_id;
			}
			else	/*buffer texture already created*/
			{
				/*Active texture*/		
				glActiveTexture(GL_TEXTURE0 + HMI_TEXTURE_UNIT_FONT_BUFFER);				
				glBindTexture ( GL_TEXTURE_2D, buf_texture_id );
				hmi_cur_font_buffer.phmi_cur_texture	= pbuffer;
				hmi_cur_font_buffer.texture_id			= buf_texture_id;
			}
		}		
	}	
}

