					end_no		= hmi_get_beg_end_vertex(end_angel,circle_radius_w,
													circle_radius_h,&end_vertex);
					beg_end		= hmi_is_small_arc((INT32)angel,(INT32)end_angel);
					vertex_num	= hmi_get_draw_vertex(beg_no,end_no,
														&beg_vertex,
														&end_vertex,
														circle_radius_w,
														circle_radius_h,
														beg_end); 

				}
				
				/*set rect uv coordinate*/
				pbig_img	= hmi_get_big_image_addr(hmi_cur_texture.seg_no,
										hmi_cur_texture.fmt_index ,
										hmi_cur_texture.index);
				/*get big image display zone*/
				hmi_get_big_image_display_xy((HMI_FMT_BIG_IMAGE_STR *)pbig_img,
											pimage_prop_info,
											trail_image_disp_rect.x,
											trail_image_disp_rect.y,
											&trail_big_imgdsp_zone_rotation);
				/*rotation position  as coordinage origin*/
				texture_uv_len	= vertex_num * VERTEX_TEXCOORD0_SIZE;
				vertex_gl_len	= vertex_num * VERTEX_POS_SIZE;
				HMI_TRANSFORM_COORDINATE(trail_big_imgdsp_zone_rotation,
									rotation_point);
				/*image compress format*/
				image_compress_fmt =(img_compress.image_attr) & 0x0f;
				alpha_flag = bmp_alpha_rotation_flag & HMI_ALPHA_IMAGE_FLAG;
				if (alpha_flag != 0U)
				{
					balpha = TRUE;
				}
				else
				{
					balpha = FALSE;
				}
				/*
				ETC1 NOT SUPPORT alpha channel,so alpha channel as RGB BMP below ORIGIN bmp 
				*/	
				draw_type	= hmi_get_draw_type(pimage_prop_info,balpha);/*2020 05 25*/
				if((balpha == TRUE)&&(image_compress_fmt == HMI_IMAGE_COMPRESS_ETC1))
				{					
					if(draw_type == HMI_UNIFORM_IMAGE_TYPE_CNT)
					{
							draw_type	= HMI_UNIFORM_ETC1_ALPHA_TYPE;
					}
					pvtx_buf[HMI_STRIDE_VERTEX_TEXTURE_ETC1_ALPHA] 	= trail_alpha_texture_uv;
				}
				else
				{					
					if(draw_type == HMI_UNIFORM_IMAGE_TYPE_CNT)
					{
						draw_type	= HMI_UNIFORM_IMAGE_TYPE;
					}
					pvtx_buf[HMI_STRIDE_VERTEX_TEXTURE_ETC1_ALPHA] 	= NULL;
					
				}
				
				/*trail image uv*/
				hmi_get_uv_poly(trail_segment/*vertex origin is pointer rotation*/,
								vertex_num,
								trail_texture_uv,
								texture_uv_len,
								&trail_big_imgdsp_zone_rotation,
								init_angel,
								pvtx_buf[HMI_STRIDE_VERTEX_TEXTURE_ETC1_ALPHA],
								//ptrail_rect->h + HMI_ECT1_ALPHA_OFFSET/*HMI_ECT1_ALPHA_OFFSET line is transparent alpha*/
								pimage_prop_info->pbitmap_data.h + HMI_ECT1_ALPHA_OFFSET/*HMI_ECT1_ALPHA_OFFSET line is transparent alpha*/
								);
				/*convert 'trail_segment' vertex to GL 3d vertex*/
				pointer_2d_to_gl_3d(trail_segment,vertex_num,
									trail_vertex,
									HMI_TRAIL_VERTEX_NUM * VERTEX_POS_SIZE);
				hmi_reverse_y(trail_vertex,
							vertex_gl_len);								
				/*convert screen coordinate to opengles coordinate*/				
				get_screen_center_coordinate_reverse_y(&rotation_point,screen_no);
				/*translate trail vertex to pointer rotation position*/
				matrix_translate(&modelview,
								(GLfloat)(rotation_point.x), 
								(GLfloat)(rotation_point.y), 
								0.0f);	
				vertex_rotation	= fabs(init_angel) > HMI_FLOAT_TOLERANCE;
				if(vertex_rotation == TRUE)
				{
					matrix_rotate(&modelview,
								init_angel,
								0.0f,
								0.0f,
								1.0f,
								TRUE/*unit matrix*/);
				}				
				/*move  to z=-HMI_PERSPECTIVE_POS at frust for see*/
				matrix_translate(&modelview,
								0.0f, 
								0.0f,  
								-HMI_PERSPECTIVE_POS);
				
				/*pointer scale*/													
				if(pbitmap_data->w != 0U) 
				{						
					scale_w	= ((float_32)(pscreen_target->w))/pbitmap_data->w;
				}	
				if(pbitmap_data->h != 0U) 
				{						
					scale_h	= ((float_32)(pscreen_target->h))/pbitmap_data->h;
				}
				if((scale_h != 1.0f)||(scale_w != 1.0f))
				{
					matrix_scale(&modelview,
							scale_w,
							scale_h,
							1.0f);
				}
				
				matrix_multiply(&mvp_matrix,&modelview,&ortho_matrix);	
				glUniformMatrix4fv(hmi_user_data.mvp_unform_id, 
								1, GL_FALSE, 
								(GLfloat*)(&(mvp_matrix.m[0][0])));
				
				vtx_strides[HMI_STRIDE_VERTEX_POSITION] = 
												VERTEX_POS_SIZE * sizeof(GLfloat);
				vtx_strides[HMI_STRIDE_VERTEX_NORMAL]	= 0;/*No used*/
				vtx_strides[HMI_STRIDE_VERTEX_TEXTURE]	= 
												VERTEX_TEXCOORD0_SIZE * sizeof(GLfloat);
							
				pvtx_buf[HMI_STRIDE_VERTEX_POSITION]	= trail_vertex; 
				pvtx_buf[HMI_STRIDE_VERTEX_NORMAL]		= NULL;/*No used*/
				pvtx_buf[HMI_STRIDE_VERTEX_TEXTURE] 	= trail_texture_uv;

				set_vertex_index_increase(trail_vertex_index,
										vertex_num);
				
				if (alpha != 0U)
				{
					balpha = TRUE;
				}
				else
				{
					balpha = FALSE;
				}
				draw_type	= hmi_get_draw_type(pimage_prop_info,balpha);/*2020 05 25*/

				if(draw_type == HMI_UNIFORM_IMAGE_TYPE_CNT)
				{
					draw_type	= HMI_UNIFORM_IMAGE_TYPE;
				}
				hmi_set_draw_type(draw_type,
									attribute,image_alpha);
								
				glEnable(GL_SCISSOR_TEST);
			#ifdef HMI_RENDER_FULL_SCREEN				
				hmi_get_union_rect(pclip_rect,pdirty_rect,
									&hmi_min_dirty_rect);	
				hmi_convert_clip_rect(&hmi_min_dirty_rect,screen);
				
				glScissor((GLint)(hmi_min_dirty_rect.x),(GLint)(hmi_min_dirty_rect.y),
							(GLsizei)(hmi_min_dirty_rect.w),(GLsizei)(hmi_min_dirty_rect.h));															
				
				drawPrimitiveWithoutVBOs(pvtx_buf, vtx_strides,
										vertex_num,
										trail_vertex_index,
										TRUE/*UV*/,TRUE/*one Color*/);
												
			#else
				next_clip_index	= HMI_LAYER_MAX_CNT + HMI_DIRTY_FIFO_LEN * layer;
				while((clip_index < HMI_DIRTY_FIFO_LEN)&&			
						(pdirty_rect[next_clip_index].w	> 0U)&&	
						(pdirty_rect[next_clip_index].h	> 0U))
				{
					/*Clip position*/
					hmi_get_union_rect(pclip_rect,(&pdirty_rect[next_clip_index]),
									&hmi_min_dirty_rect);
					if((hmi_min_dirty_rect.w > 0U)&&((hmi_min_dirty_rect.h	> 0U)))
					{																						
						/*scissor*/						
						hmi_convert_clip_rect(&hmi_min_dirty_rect,screen);
						glScissor((GLint)(hmi_min_dirty_rect.x),(GLint)(hmi_min_dirty_rect.y),
							(GLsizei)(hmi_min_dirty_rect.w),(GLsizei)(hmi_min_dirty_rect.h));							
																
						drawPrimitiveWithoutVBOs(pvtx_buf, vtx_strides,
										vertex_num,
										trail_vertex_index,
										TRUE/*UV*/,TRUE/*one Color*/);
					}
					clip_index++;
					next_clip_index	++;
				}
			#endif										
				hmi_loc_inc_msg_count(HMI_MONITOR0); 			
			}
		}
	}	
}
