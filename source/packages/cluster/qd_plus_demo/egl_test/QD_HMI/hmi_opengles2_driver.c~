																			ptext_string[index+1],
									//										&hmi_code_char_len);
																			&hmi_code_char_len);
									phmi_font_config	= hmi_driver_get_char_data(hmi_char,NULL, font_id);
									if(phmi_font_config !=NULL)
									{
										hmi_one_char_width	= phmi_font_config->owidth + HMI_CHAR_SPACE;

										if(hmi_farsi_clip_left == FALSE)
										{
											/*get actual string index*/
											if(hmi_copy_x2text_left > hmi_one_char_width)
											{
												hmi_copy_x2text_left	-= hmi_one_char_width;
												text_oneline_rect.text_rect.x		+= hmi_one_char_width;
											}
											else
											{
												/*set finished flag*/
												hmi_copy_x2text_left	= 0U;
												/*set new string index*/
												hmi_string_actual_index = index;
											}
										}
										else	/*clip at left*/
										{
											/*get actual string index*/
											if(hmi_copy_x2text_left > 0)
											{
												hmi_copy_x2text_left	-= hmi_one_char_width;
												//text_oneline_rect.text_rect.x += hmi_one_char_width;

												if(hmi_copy_x2text_left <= 0)
												{
													/*set finished flag*/
													hmi_copy_x2text_left	= 0U;
													/*set new string index*/
													hmi_string_actual_index = index+1;
													text_oneline_rect.text_rect.x	+= hmi_one_char_width;
		#ifdef HMI_CLIP_TEXT
													hmi_print_clipe_end_x	= text_oneline_rect.text_rect.x;
		#endif
												}
												else
												{
													text_oneline_rect.text_rect.x	+= hmi_one_char_width;
												}
											}								
										}
										
									}
									index				+= hmi_code_char_len;
									index++;
								}
							}
							index =0;
							index_string =0;
							hmi_end_print_pixel = phmi_text_copy_rect->text_rect.x +phmi_text_copy_rect->text_rect.w;
							hmi_print_start_x	= text_oneline_rect.text_rect.x;
							if(hmi_farsi_clip_left == TRUE)
							{
								while((phmi_clip_char[index]!= '\0')&&(index_string < hmi_string_max_len))
								{
									phmi_clip_disp_string[index_string] = phmi_clip_char[index];
									index ++;
									index_string++;
								}
								text_oneline_rect.text_rect.x -= hmi_clip_string_width;
								
							}
							while((ptext_string[hmi_string_actual_index] != '\0')&& 
									(!hmi_dis_zone_full)&&
									(hmi_string_actual_index < hmi_string_length)&&
									(index_string < hmi_string_max_len))

							{
								hmi_char			= hmi_get_value_char(ptext_string[hmi_string_actual_index],
																			ptext_string[hmi_string_actual_index+1],
								//											&hmi_code_char_len);
																			&hmi_code_char_len);
								phmi_font_config	= hmi_driver_get_char_data(hmi_char,NULL, font_id);
								if(phmi_font_config != NULL)
								{
									if(hmi_farsi_clip_left == FALSE)
									{
										hmi_cur_print_clip_width	= hmi_print_start_x + hmi_clip_string_width;
									}
									else
									{
										hmi_cur_print_clip_width	= hmi_print_start_x ;
									}
									hmi_cur_char_width = phmi_font_config->owidth + HMI_CHAR_SPACE;
									if((hmi_cur_print_clip_width + hmi_cur_char_width) > hmi_end_print_pixel)
									{
										hmi_dis_zone_full	= TRUE;
									}
									else
									{
										phmi_clip_disp_string[index_string] = ptext_string[hmi_string_actual_index];
										index_string++;
									}
									hmi_print_start_x		+= (phmi_font_config->owidth+HMI_CHAR_SPACE);
								}
								hmi_string_actual_index ++;
								hmi_string_actual_index += hmi_code_char_len;
								
							}
							if(hmi_farsi_clip_left == FALSE)
							{
								while((phmi_clip_char[index]!= '\0')&&(index_string < hmi_string_max_len))
								{
									phmi_clip_disp_string[index_string] = phmi_clip_char[index];
									index ++;
									index_string++;
								}
								
							}
							phmi_clip_disp_string[index_string] = 0;
							hmi_text_prop.hmi_string	= phmi_clip_disp_string;
							ptext_string				= phmi_clip_disp_string;
						}
					}
				}

#endif
			}
			
			hmi_draw_sub_text((&text_oneline_rect)/*phmi_text_copy_rect*/,
						pclip_rect,
						pdirty_rect,
						//#if (HMI_FARSI_ENABLE	== HMI_YES)
						(HMI_TEXT_PROP_STR CONST *)(&hmi_text_prop),
						//#else
						//phmi_text_prop_info,
						//#endif						
						 0,
						 phmi_text_prop_info->length,
						screen,
						font_id,
						pfather_alpha_scale);
						
		}		
		
#if  HMI_SCROLL_TEXT_SUPPORT != 0U
		if((phmi_text_prop_info->properties & HMI_TEXT_PROP_SCROLABLE) != 0U)
		{
			ptext_string			= (HMI_CHAR_STR 	*)(phmi_text_prop_info->hmi_string);
#if HMI_FONT_CODE == HMI_FONT_CODE_UNICODE
			hmi_scroll_offset	= ptext_string[phmi_text_prop_info->length+1];
#else
			hmi_scroll_offset	= (ptext_string[phmi_text_prop_info->length+1]<<8);
			hmi_scroll_offset	+= ptext_string[phmi_text_prop_info->length+2];
#endif
			if(hmi_cycle_sign)
			{
				hmi_scroll_offset =-(HMI_GET_SCROLL_STEP_VALUE(hmi_scroll_offset));
			}
			else
			{
				hmi_scroll_offset =HMI_GET_SCROLL_STEP_VALUE(hmi_scroll_offset);
			}
			
			if(hmi_scroll_offset >= (phmi_text_copy_rect->text_rect.w))
			{
				if(hmi_cycle_flag)
				{
					if(hmi_scroll_offset >= (hmi_text_width + hmi_cycle_step * HMI_TEXT_CYCLE_RANGE))
					{
#if HMI_FONT_CODE == HMI_FONT_CODE_UNICODE//pxguo
							ptext_string[phmi_text_prop_info->length+1] = 0U;
#else
							ptext_string[phmi_text_prop_info->length+1] = 0U;
							ptext_string[phmi_text_prop_info->length+2] = 0U;
#endif
					}
				}
				else
				{
					if(ptext_string != NULL) /*lq*/
					{
#if HMI_FONT_CODE == HMI_FONT_CODE_UNICODE//pxguo
						ptext_string[phmi_text_prop_info->length+1] = 0U;
#else
						ptext_string[phmi_text_prop_info->length+1] = 0U;
						ptext_string[phmi_text_prop_info->length+2] = 0U;
#endif
					}
				}
			}
		}
#endif			
	}		
}


	
UINT16 hmi_get_line_counts(HMI_TEXT_RECT_STR CONST *phmi_text_copy_rect/*screen target and color*/,
								HMI_TEXT_PROP_STR CONST * phmi_text_prop_info,
								U08 					font_id
								)
{
	HMI_CHAR_STR		*ptext_string			= NULL;	
	SINT16 				index_start 			= 0;
	SINT16 				index_end				= 0;
	SINT16 				index					= 0;
	HMI_WIDTH_STR		font_height 			= 0U;
	HMI_WIDTH_STR		text_height 			= 0U;
	HMI_Y_STR			hmi_print_start_Y		= 0;
	CONST HMI_FONT_STR	*phmi_font_table		= NULL;
	BOOLEAN 			hmi_dis_zone_full		= FALSE;
	HMI_FONT_CHAR_PROP	CONST * phmi_font_config= NULL;
	UINT8				hmi_code_char_len		= 0U;/*differene font code .maybe 1,2*/
	HMI_FONT_CHAR_STR	hmi_char				= 0U;
	HMI_WIDTH_STR		hmi_text_width			= 0;
	HMI_WIDTH_STR		hmi_edit_width			= 0U;
	HMI_TEXT_RECT_STR	text_oneline_rect		= {0};
	UINT16		hmi_char_scale_width			= 0U;
#if HMI_FARSI_ENABLE	==HMI_YES
	HMI_TEXT_LENGTH_STR hmi_string_length		= 0U;
	HMI_TEXT_LENGTH_STR hmi_alloc_string_length = 0;
	UINT16				hmi_string_bits 		= 0U;
	BOOLEAN 			hmi_farsi_search_end	= FALSE;
	UINT16				hmi_string_actual_index = 0U;
	HMI_TEXT_PROP_STR	hmi_text_prop			= {0};
	HMI_CHAR_STR		*ptext_string_primitive = NULL;//phmi_text_prop_info->hmi_string;	
#if(HMI_FARSI_NEED_REVERSE == HMI_YES)
	BOOLEAN 			first_call_hmi_farsi_word	= FALSE;
	HMI_FARSI_ANALYSIS_STR text_disp_result 		= {0};
	UINT16				hmi_string_start_index		= 0U;
	UINT8				loop_cnt					= 0U;	
	U16 	farsi_sentence_begin					= 1U;
	U16 	farsi_sentence_end						= 0U;
	HMI_CHAR_STR	farsi_char_left 				= 0U;
	HMI_CHAR_STR	farsi_char_right				= 0U;
	BOOLEAN 		farsi_cap_char					= FALSE;
#endif
#endif
	SINT8		hmi_line_space_scale				= HMI_CHAR_LINE_SPACE;
	UINT16		line_cnt							= 0u;
	HMI_TEXT_LENGTH_STR index_string			= 0U;
	HMI_CHAR_STR		hmi_bidi_string[HMI_BIDI_LEN] 	= {0};
	UINT16 				word_end_index		=0;
	BOOLEAN 			dir_is_rtl= FALSE;
	BOOLEAN				is_break_char= FALSE;
	HMI_WIDTH_STR		hmi_end_word_width	= 0;
	HMI_CHAR_STR		hmi_cycle_string[255]={0};

	if((phmi_text_copy_rect != NULL) &&(phmi_text_prop_info != NULL))	/*lq*/
	{
		ptext_string			= phmi_text_prop_info->hmi_string;
	#if HMI_FARSI_ENABLE	==HMI_YES
		ptext_string_primitive = phmi_text_prop_info->hmi_string;
	#endif
		hmi_edit_width			= phmi_text_copy_rect->text_rect.w;
		if(ptext_string != NULL)
		{	
			if(HMI_TEXT_PROP_ALIGN_IS_MULLINE(phmi_text_prop_info->properties))
			{
				
			#if(HMI_FARSI_ENABLE	== HMI_YES)
				index = 0;
				while(ptext_string[index] != '\0')
				{
					hmi_string_length++;
					index++;
				}
				index =0; 
				hmi_alloc_string_length = hmi_string_length+2;
				if(phmi_disp_string == NULL)
				{
					if(hmi_alloc_string_length < HMI_TEXT_MAX_LEN)
					{
						hmi_string_max_len	= HMI_TEXT_MAX_LEN;
					}
					else
					{
						hmi_string_max_len	= hmi_alloc_string_length;
					}
					hmi_string_bits =(sizeof(HMI_CHAR_STR)) * hmi_string_max_len;
					phmi_disp_string = (HMI_CHAR_STR *)(hmi_malloc_vram(hmi_string_bits));
				}
				else
				{
					if(hmi_alloc_string_length > hmi_string_max_len)
					{
						hmi_string_max_len			= hmi_alloc_string_length;
						hmi_dealloc_vram((void *)(phmi_disp_string));
						//hmi_dealloc_vram((void *)(phmi_disp_string));
						phmi_disp_string	= NULL;
						hmi_string_bits =(sizeof(HMI_CHAR_STR)) * hmi_string_max_len;
						phmi_disp_string = (HMI_CHAR_STR *)(hmi_malloc_vram(hmi_string_bits));
					}
				}
				#if (LV_USE_BIDI==1)
				dir_is_rtl = hmi_bidi(hmi_string_length,ptext_string,hmi_bidi_string);
				hmi_code_char_len	= 0U;
				index =0;
				hmi_string_actual_index =0;
			
				/*hebrew write rule*/
				for(index =(hmi_string_length-1); index >0;index--)
				{
					if(hmi_bidi_string[index] == 32)
					{
						hmi_hebrew_word_last_char(hmi_bidi_string,(index+2),hmi_string_length);
					}
					else if(hmi_driver_is_break_char(hmi_bidi_string[index])==TRUE)
					{
						hmi_hebrew_word_last_char(hmi_bidi_string,(index+2),hmi_string_length);
					}
					else
					{
					}
				}
				hmi_hebrew_word_last_char(hmi_bidi_string,(index+1),hmi_string_length);
				/*farsiscript ligature conversion */
				while(
							#if(HMI_FARSI_NEED_REVERSE == HMI_YES)
							(hmi_string_actual_index < hmi_string_length)
							&&(hmi_string_actual_index >= 0)
							#else
							0
							#endif
							)
				{
					if(hmi_bidi_string[hmi_string_actual_index] != '\0')	// lq
					{
						hmi_code_char_len	= 0U;
						if(hmi_bidi_string[hmi_string_actual_index] < HMI_ARABIC_MIN)
						{
							hmi_char			= hmi_get_value_char(hmi_bidi_string[hmi_string_actual_index],
																hmi_bidi_string[hmi_string_actual_index+1],
							//									&hmi_code_char_len);
																&hmi_code_char_len);
						}
						else if(hmi_bidi_string[hmi_string_actual_index] > HMI_FARSI_MAX)
						{
							hmi_char			= hmi_get_value_char(hmi_bidi_string[hmi_string_actual_index],
																hmi_bidi_string[hmi_string_actual_index+1],
							//									&hmi_code_char_len);
																&hmi_code_char_len);
						}
						else 
						{
								hmi_code_char_len	= 0U;
								if(hmi_string_actual_index <(hmi_string_length-1))
								{
									if(hmi_bidi_string[hmi_string_actual_index+1] == ARABIC_SPECIAL_CHAR_BEGIN)
									{
										if(hmi_string_actual_index <(hmi_string_length-2))
										{
											hmi_char			= hmi_change_to_special_character(hmi_bidi_string[hmi_string_actual_index],
																				hmi_bidi_string[hmi_string_actual_index +1],
																				hmi_bidi_string[hmi_string_actual_index +2]);
										}
										else
										{
								
											hmi_char			= hmi_change_to_special_character(hmi_bidi_string[hmi_string_actual_index],
																				hmi_bidi_string[hmi_string_actual_index+1],
																				0);
										
										}
										if(hmi_char != hmi_bidi_string[hmi_string_actual_index])
										{
											hmi_code_char_len = 1U;
										}
									}
								}
								
								if(hmi_code_char_len == 0)
								{
									if(hmi_string_actual_index ==(hmi_string_length-1))
									{
										farsi_char_left = 0;
									}
									else if(hmi_string_actual_index <(hmi_string_length-1))
									{
										
										farsi_cap_char=hmi_farsi_search(hmi_bidi_string[hmi_string_actual_index+1],
																		hmi_farsi_cap,
																		HMI_FARSI_CAP_NB);
										if(farsi_cap_char == TRUE)
										{
											if(hmi_string_actual_index <(hmi_string_length-2))
											{
												farsi_char_left	= hmi_bidi_string[hmi_string_actual_index+2];
											}
											else
											{
												farsi_char_left = hmi_bidi_string[hmi_string_actual_index+1];
											}
										}
										else
										{
											farsi_char_left = hmi_bidi_string[hmi_string_actual_index+1];
										}
									}
									else
									{
										farsi_char_left = 0;
									}
									
									if(hmi_string_actual_index == 0)
									{
										farsi_char_right =0;
									}
									else if(hmi_string_actual_index >= 1)
									{
										farsi_cap_char=hmi_farsi_search(hmi_bidi_string[hmi_string_actual_index-1],
																		hmi_farsi_cap,
																		HMI_FARSI_CAP_NB);
										if(farsi_cap_char == TRUE)
										{
											if(hmi_string_actual_index >= 2)
											{
												farsi_char_right	= hmi_bidi_string[hmi_string_actual_index-2];
											}
											else
											{
												farsi_char_right = hmi_bidi_string[hmi_string_actual_index-1];
											}
										}
										else
										{
											farsi_char_right = hmi_bidi_string[hmi_string_actual_index-1];
										}
									}
									else
									{
										farsi_char_right =0;
									}
									hmi_char	= hmi_change_to_concatenation_character(farsi_char_left,
																							hmi_bidi_string[hmi_string_actual_index],
																							farsi_char_right);
								}
							}
						
							if(phmi_disp_string != NULL) /*lq*/
							{
								if(index < hmi_string_length)
								{
									phmi_disp_string[index]= hmi_char;
									index++;
								}
							}
							
						}
						hmi_string_actual_index ++;
						hmi_string_actual_index += hmi_code_char_len;
						//#endif
				}
		
			#else
				
				if(hmi_string_length > 0)
				{
					hmi_farsi_search_end = FALSE; 
				}
				else
				{
					hmi_farsi_search_end = TRUE; 
				}
			#if(HMI_FARSI_NEED_REVERSE == HMI_YES)
				while((hmi_farsi_search_end == FALSE )&&
					(loop_cnt <=HMI_MAX_LOOP_CNT))
				{
					loop_cnt++;
					text_disp_result.begin		= HMI_U16_MAX;
					text_disp_result.end		= HMI_U16_MAX;
					text_disp_result.reverse	= FALSE;
				
					do
					{	
						hmi_farsi_word(ptext_string,hmi_string_start_index,
										hmi_string_length,&text_disp_result,
										first_call_hmi_farsi_word,
										&farsi_sentence_begin,
										&farsi_sentence_end);
					}while((text_disp_result.begin	== 0)&&(text_disp_result.end == HMI_U16_MAX));
				
					first_call_hmi_farsi_word	= TRUE;
					if((text_disp_result.begin	== HMI_U16_MAX)&&(text_disp_result.end == HMI_U16_MAX))
					{
						hmi_farsi_search_end	= TRUE;
					}
					if(text_disp_result.reverse == TRUE)
					{
						if(text_disp_result.end > 0U)
						{
							hmi_string_actual_index = text_disp_result.end - 1;
						}
						else
						{
							hmi_string_actual_index = 0U;
						}
					}
					else
					{
						hmi_string_actual_index = text_disp_result.begin;
					}
				#endif
					while(/*(ptext_string[hmi_string_actual_index] != '\0')*/
				#if(HMI_FARSI_NEED_REVERSE == HMI_YES)
							/*&&*/(hmi_string_actual_index < text_disp_result.end)
							&&(hmi_string_actual_index >= text_disp_result.begin)
				#endif
							)
					{
						if(ptext_string[hmi_string_actual_index] != '\0')	
						{
					#if (HMI_FARSI_NEED_REVERSE == HMI_YES)
						if(text_disp_result.reverse == TRUE)
						{
							hmi_code_char_len	= 0U;
							if(hmi_string_actual_index >= 1U)
							{
								if(ptext_string[hmi_string_actual_index - 1] == ARABIC_SPECIAL_CHAR_BEGIN)
								{
									if(hmi_string_actual_index > 1U)
									{
										hmi_char			= hmi_change_to_special_character(ptext_string[hmi_string_actual_index],
																			ptext_string[hmi_string_actual_index - 1],
																			ptext_string[hmi_string_actual_index - 2]);
									}
									else
									{
							
										hmi_char			= hmi_change_to_special_character(ptext_string[hmi_string_actual_index],
																			ptext_string[hmi_string_actual_index-1],
																			0);
									}
									if(hmi_char != ptext_string[hmi_string_actual_index])
									{
										hmi_code_char_len = 1U;
									}
								}
							}
							
							if(hmi_code_char_len == 0)
							{
								if(hmi_string_actual_index ==text_disp_result.begin)
								{
									farsi_char_left = 0;
								}
								else if(hmi_string_actual_index > text_disp_result.begin)
								{
									
									farsi_cap_char=hmi_farsi_search(ptext_string[hmi_string_actual_index-1],
																	hmi_farsi_cap,
																	HMI_FARSI_CAP_NB);
									if(farsi_cap_char == TRUE)
									{
										if(hmi_string_actual_index >= (text_disp_result.begin+2))
										{
											farsi_char_left = ptext_string[hmi_string_actual_index-2];
										}
										else
										{
											farsi_char_left = ptext_string[hmi_string_actual_index-1];
										}
									}
									else
									{
										farsi_char_left = ptext_string[hmi_string_actual_index-1];
									}
								}
								else
								{
									farsi_char_left = 0;
								}
								
								if(hmi_string_actual_index ==(text_disp_result.end-1))
								{
									farsi_char_right =0;
								}
