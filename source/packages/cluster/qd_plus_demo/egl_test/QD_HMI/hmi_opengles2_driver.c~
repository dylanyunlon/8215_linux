HMI_DECODE_STATUS_STR hmi_decode_image(HMI_BIG_IMAGE_INDEX_STR image_fmt,
								UINT32 address,
								TEXTURE_2D_PIXEL_FORMAT pixel_fmt,
								U16 width,U16 height,								
								U08 * pdecode_buffer,
								U32 decode_buffer_len,
								U32	data_len,
								U08	seg_no)
{	
	HMI_DECODE_STATUS_STR	decode_status	= HMI_DECODE_STATUS_CNT;
	U16						max_malloc_cnt	= 0U;
		
	/*decode image or copy uncompress image to buffer*/
	if(pdecode_buffer != NULL)
	{
		if(image_fmt == HMI_JPG_BIG_IMAGE)
		{
			decode_status	= decode_JPG2Mem(pdecode_buffer,
										address,
										data_len,
										width,height,
										pixel_fmt,
										decode_buffer_len,
										seg_no);
		}
		else if((image_fmt == HMI_RLE_ARGB8888_BIG_IMAGE)||
			(image_fmt == HMI_RLE_RGB888_BIG_IMAGE))
		{
			decode_status	= decode_RLE2Mem(pdecode_buffer,
										address,
										data_len,
										 width,height,
										 pixel_fmt,
										 decode_buffer_len,
										 seg_no);
		}		
		else /*HMI_RGB888_BIG_IMAGE,HMI_ARGB8888_BIG_IMAGE,HMI_ETC1_RGB8888_BIG_IMAGE,
				HMI_ETC2_RGB8888_BIG_IMAGE,
				HMI_ETC2_ARGB8888_BIG_IMAGE*/
		{
			decode_status	= copy_file_data2Mem(pdecode_buffer,
												address,	
												data_len,
												seg_no);
				
		}
	}
	else
	{
		decode_status	= HMI_DECODE_IMAGE_MEM_NOT_ENOUGH;
	}
		
	
	return decode_status;
}

