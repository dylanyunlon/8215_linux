void init_sin_cos_buffer(void)
{
	U16 loop	= 0U;

	for(loop = 0U;loop < HMI_SINE_COS_BUFFER_LEN;loop++)
	{
		sin_cos_buffer_fifo.sin_cos_buffer[loop].angle		= 0.0f;
		sin_cos_buffer_fifo.sin_cos_buffer[loop].sin_angle	= 0.0f;
		sin_cos_buffer_fifo.sin_cos_buffer[loop].cos_angle	= 1.0f;
	}
	sin_cos_buffer_fifo.next	= 0U;
}

void write_sin_cos_buffer_value(GLfloat	angle,
									GLfloat	sin_angle,
									GLfloat	cos_angle)
{
	U16		next		= sin_cos_buffer_fifo.next;

	
	sin_cos_buffer_fifo.sin_cos_buffer[next].angle		= angle;
	sin_cos_buffer_fifo.sin_cos_buffer[next].sin_angle	= sin_angle;
	sin_cos_buffer_fifo.sin_cos_buffer[next].cos_angle	= cos_angle;

	next++;
	if(next >= HMI_SINE_COS_BUFFER_LEN)
	{
		sin_cos_buffer_fifo.next	= 0U;
	}
	else
	{
		sin_cos_buffer_fifo.next	= next;
	}
	
}

