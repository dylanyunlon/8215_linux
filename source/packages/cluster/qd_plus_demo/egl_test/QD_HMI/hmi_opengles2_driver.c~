void set_all_vertex_color(HMI_COLOR_STR	fill_color)
{
	INT32	loop		= 0U;
	GLfloat	r_f		= 0.0f;
	GLfloat	g_f		= 0.0f;
	GLfloat	b_f		= 0.0f;
	GLfloat	a_f		= 0.0f;
	
	b_f		= (GLfloat)(fill_color & 0xff);
	g_f		= (GLfloat)((fill_color & 0xff00) >> 8);
	r_f		= (GLfloat)((fill_color & 0xff0000) >> 16);
	a_f		= (GLfloat)((fill_color & 0xff000000) >> 24);

	r_f		= (GLfloat)(r_f/HMI_MAX_ALPHA_VALUE);
	g_f		= (GLfloat)(g_f/HMI_MAX_ALPHA_VALUE);
	b_f		= (GLfloat)(b_f/HMI_MAX_ALPHA_VALUE);
	a_f		= (GLfloat)(a_f/HMI_MAX_ALPHA_VALUE);
	
	for(loop = 0U;loop < HMI_VERTEX_COLOR_ARRAY_LEN;loop += VERTEX_COLOR_SIZE)
	{
		image_vertex_color[loop + HMI_ABGR_COLOR_R]	= r_f;
		image_vertex_color[loop + HMI_ABGR_COLOR_G]	= g_f;
		image_vertex_color[loop + HMI_ABGR_COLOR_B]	= b_f;
		image_vertex_color[loop + HMI_ABGR_COLOR_A]	= a_f;
	}
}

