POINT32_TP *	get_trail_vextex_pos(U08 * pvertex_len,float_32 begin_angel,
										U16 circle_radius_w,U16 circle_radius_h,
										U08	trail_cw,SPOINT_TP *pdisplay_container_pos_left/*in*/,
