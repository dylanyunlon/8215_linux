U16 hmi_line_to_zone_self(POINT32_TP	vertex[], 
								U16			vertex_len, 
								U16			vertex_array_len, 
								U16			line_width,
								UINT8		attr)
{
	U16 		expand_len			= 0;
	U16 		loop				= 0;
	U16 		vertex_zone_len 	= 0;
	U32 		vertex_zone_byte_len= 0;
	BOOLEAN 	valide				= FALSE;
	POINT32_TP	*pvertex_zone		= NULL;
	

	vertex_zone_len = vertex_len + vertex_len;
	valide			= ((vertex_len >= HMI_LINE_TO_ZONE_MINI_CNT)&&
						(vertex_array_len >= vertex_zone_len));
	if(valide == TRUE)
	{		
		vertex_zone_byte_len	= vertex_zone_len * sizeof(POINT32_TP);
		if(hmi_public_buffer.ppublic_buffer != NULL)
		{
			if(vertex_zone_byte_len > hmi_public_buffer.buffer_len)
			{
				hmi_dealloc_vram(hmi_public_buffer.ppublic_buffer);
				hmi_public_buffer.ppublic_buffer	= (BYTE *)hmi_malloc_vram(vertex_zone_byte_len);
				if(hmi_public_buffer.ppublic_buffer != NULL)
				{
					hmi_public_buffer.buffer_len	= vertex_zone_byte_len;
				}
				else
				{
					hmi_public_buffer.buffer_len	= 0U;
				}
			}
		}
		else	/*not malloc memory*/
		{
			hmi_public_buffer.ppublic_buffer	= (BYTE *)hmi_malloc_vram(vertex_zone_byte_len);
			if(hmi_public_buffer.ppublic_buffer != NULL)
			{
				hmi_public_buffer.buffer_len	= vertex_zone_byte_len;
			}
			else
			{
				hmi_public_buffer.buffer_len	= 0U;
			}
		}

		if(hmi_public_buffer.ppublic_buffer != NULL)
		{
			pvertex_zone	= (POINT32_TP *)(hmi_public_buffer.ppublic_buffer);
			
			if(attr == HMI_CLOSE)
			{
				expand_len	= hmi_line_to_zone(
										vertex,
										vertex_len,
										pvertex_zone,
										(INT32)vertex_zone_len,
										(INT32)line_width);
			}
			else	/*cut first and last vertex*/
			{
				if((vertex_len >= HMI_SPLINE_ZONE_CLOSE_POINT_NB)&&
					(vertex_array_len >= HMI_SPLINE_ZONE_CLOSE_POINT_NB))
				{
					expand_len	= hmi_line_to_zone(
										&vertex[1],
								(vertex_len - HMI_SPLINE_ZONE_CLOSE_POINT_NB),
										pvertex_zone,
										(INT32)vertex_zone_len,
										(INT32)line_width);
				}
			}

			/*copy vertex from 'pvertex_zone' to vertex[]*/
			for(loop = 0;loop < expand_len;loop++)
			{
				vertex[loop].x	= pvertex_zone[loop].x;
				vertex[loop].y	= pvertex_zone[loop].y;				
			}
		}
	}	
		
	return expand_len;
}




SINT32 polygon_area_input(HMI_INPUT_POLYGON_STR *pinput_polygon)
{
	SINT32					area				= 0;	
	U16 						j				= 0U;
	U16 						i				= 0U;
	U16						head			= 0U;
	POINT32_TP 				*ppoints			= NULL;
	HMI_NEXT_PRE_LIST_STR	*pnext_pre_list	= NULL;
	
	if(pinput_polygon != NULL)	/*lq*/
	{
		ppoints	= pinput_polygon->phmi_input_point_polygon;
		pnext_pre_list	= pinput_polygon->pnext_pre_list;
		head			= pinput_polygon->head_index;
		
		i	= head;			
		do
		{		
			j	= pnext_pre_list[i].next_node;
			area	+= ppoints[i].x * ppoints[j].y;
			area	-= (ppoints[i].y * ppoints[j].x);
			i		= j;
		}while(i != head);

		area	= ((SINT32)(area / 2.0f));
	}
	
	return area;
}


HMI_POLYGONDIRECTION_STR points_direction(
							HMI_INPUT_POLYGON_STR *pinput_polygon )
{	
	U16 							i						= 0U;
	U16 							j						= 0U;
	U16 							k						= 0U;
	SINT16						ji_x						= 0;
	SINT16						ji_y						= 0;
	SINT16						ik_x						= 0;
	SINT16						ik_y						= 0;
	U16 							convex					= 0U;
	U16 							npoints					= 0U;
	//SINT16						min_y					= 0x7fff;
	SINT32						min_y					= 0x7fffffff;
	SINT32						crossproduct				= 0;
	POINT32_TP					*phmi_input_point_polygon	= NULL;
	HMI_POLYGONDIRECTION_STR	point_type 				= HMI_POLYGONTYPE_UNKNOWN;
	HMI_NEXT_PRE_LIST_STR		*pnext_pre_list			= NULL;


	if(pinput_polygon != NULL)	/*lq*/
	{
		npoints					= pinput_polygon->length;
		phmi_input_point_polygon	= pinput_polygon->phmi_input_point_polygon;
		pnext_pre_list				= pinput_polygon->pnext_pre_list;
		if (npoints < HMI_CUT_EAR_TRIANGLE)
		{
			point_type = HMI_POLYGONTYPE_UNKNOWN;
		}
		else
		{	
			/*look for convex point*/
			for (i = 0U; i < npoints; i++)
			{			
				if(phmi_input_point_polygon[i].y < min_y)	
				{				
					min_y	= phmi_input_point_polygon[i].y;
					convex	= i;
				}					
			}

			i	= convex;
			j	= pnext_pre_list[i].pre_node;		
			k	= pnext_pre_list[i].next_node;

			ji_x	= (SINT16)(phmi_input_point_polygon[i].x - 
					phmi_input_point_polygon[j].x);
			
			ji_y	= (SINT16)(phmi_input_point_polygon[i].y - 
							phmi_input_point_polygon[j].y);

			ik_x	= (SINT16)(phmi_input_point_polygon[k].x - 
					phmi_input_point_polygon[i].x);
			ik_y	= (SINT16)(phmi_input_point_polygon[k].y - 
					phmi_input_point_polygon[i].y);

			crossproduct	= ji_x * ik_y - ik_x * ji_y;
			if( crossproduct < 0) 
			{				
				point_type	= HMI_POLYGONTYPE_COUNT_CLOCKWISE;
			}
			else if (crossproduct > 0)
			{				
				point_type	= HMI_POLYGONTYPE_CLOCKWISE;
			}
			else
			{				
				point_type	= HMI_POLYGONTYPE_UNKNOWN;
			}
		}
	}
	

	return point_type;
}



void reverse_points_direction(HMI_INPUT_POLYGON_STR *pinput_polygon)
{
	U16				length					= 0U;
	U16				next						= 0U;
	U16				half_len					= 0U;
	U16				loop						= 0U;
	POINT32_TP		swap					= {0,0};
	POINT32_TP		*phmi_input_point_polygon	= NULL;

	if(pinput_polygon != NULL)	/*lq*/
	{
		length	= pinput_polygon->length;
		if(length >= HMI_CUT_EAR_TRIANGLE)
		{
			phmi_input_point_polygon	= pinput_polygon->phmi_input_point_polygon;
			if(phmi_input_point_polygon != NULL)
			{
				half_len= length >> 1;
				length--;
				for(loop = 0U;loop < half_len;loop++)
				{
					swap	= phmi_input_point_polygon[loop];
					next	= length - loop;
					phmi_input_point_polygon[loop]	= phmi_input_point_polygon[next];
					phmi_input_point_polygon[next]	= swap;
				}
			}
		}	
	}
}

/*
if vertex not count wise, reverse
*/
void set_updated_polygonvertices(HMI_INPUT_POLYGON_STR *pinput_polygon)
{	
	BOOLEAN					bclock_wise		= FALSE;
	HMI_POLYGONDIRECTION_STR	polygon_dir		= HMI_POLYGONTYPE_UNKNOWN;

	if(pinput_polygon != NULL)	/*lq*/
	{
		if(pinput_polygon != NULL)
		{
			if(pinput_polygon->length >= HMI_CUT_EAR_TRIANGLE)
			{				
				polygon_dir	= points_direction(pinput_polygon);
				bclock_wise	= (polygon_dir == HMI_POLYGONTYPE_CLOCKWISE);
				if(bclock_wise == TRUE)
				{
					reverse_points_direction(pinput_polygon);
				}
			}
		}
	}
}


/*
Get polygon area
*/
SINT32 polygon_area(POINT32_TP points[],U16 length)
{
	SINT32		area		= 0;
	U16			j		= 0U;
	U16			i		= 0U;
		
	for (i = 0U; i < length; i++)
	{
		j	= i + 1;
		if(j >= length)
		{
			j	= 0U;
		}
		area	+= points[i].x * points[j].y;
		area	-= (points[i].y * points[j].x);
	}

	area	= ((SINT32)(area / 2.0f));
	
	return area;
}


HMI_VERTEXTYPE_STR poly_gonvertex_type(HMI_INPUT_POLYGON_STR *pinput_polygon,U16 i)
{
	HMI_VERTEXTYPE_STR		vertex_type	= HMI_POLYGONTYPE_ERRORPOINT;
	U16						j			= 0U;
	U16						k			= 0U;
	U16						length		= 0U;
	SINT32					area			= 0;
	HMI_NEXT_PRE_LIST_STR	*pnext_pre_list				= NULL;
	POINT32_TP				points[HMI_CUT_EAR_TRIANGLE]	= {{0,0},{0,0},{0,0}};

	if(pinput_polygon != NULL)	/*lq*/
	{
		length		= pinput_polygon->length;
		pnext_pre_list	= pinput_polygon->pnext_pre_list;
		/*previous point*/
		j	= pnext_pre_list[i].pre_node;
		/*next point*/
		k	= pnext_pre_list[i].next_node;
			
		if((j < length)&&(i < length)&&(k < length))
		{
			points[0].x	= (pinput_polygon->phmi_input_point_polygon[j]).x;
			points[0].y	= (pinput_polygon->phmi_input_point_polygon[j]).y;
			
			points[1].x	= (pinput_polygon->phmi_input_point_polygon[i]).x;
			points[1].y	= (pinput_polygon->phmi_input_point_polygon[i]).y;
			
			points[2].x	= (pinput_polygon->phmi_input_point_polygon[k]).x;
			points[2].y	= (pinput_polygon->phmi_input_point_polygon[k]).y;
			area	= polygon_area(points,HMI_CUT_EAR_TRIANGLE);
			if(area < 0)
			{
				vertex_type	= HMI_POLYGONTYPE_CONVEXPOINT;
			}
			else
			{
				vertex_type	= HMI_POLYGONTYPE_CONCAVEPOINT;
			}
		}
	}
	
	return vertex_type;
}

BOOLEAN	hmi_in_line(HMI_INPUT_POLYGON_STR *pinput_polygon, 
						U16 point1_index,U16 point2_index,U16 point_index )
{
	BOOLEAN	bin 						= FALSE;
	SINT32		delta_x1					= 0;
	SINT32		delta_y1					= 0;
	SINT32		delta_x2					= 0;
	SINT32		delta_y2					= 0;
	SINT32		delta1					= 0;
	SINT32		delta2					= 0;
	SINT32		min_x					= 0;
	SINT32		max_x					= 0;
	SINT32		min_y					= 0;
	SINT32		max_y					= 0;	
	POINT32_TP	*phmi_input_point_polygon	= NULL;

	if(pinput_polygon != NULL)	/*lq*/
	{
		phmi_input_point_polygon	= pinput_polygon->phmi_input_point_polygon;
		if(phmi_input_point_polygon != NULL)
		{
			if(phmi_input_point_polygon[point1_index].x > 
				phmi_input_point_polygon[point2_index].x)
			{
				min_x	= phmi_input_point_polygon[point2_index].x;
				max_x	= phmi_input_point_polygon[point1_index].x;
			}
			else
			{
				max_x	= phmi_input_point_polygon[point2_index].x;
				min_x	= phmi_input_point_polygon[point1_index].x;
			}
			
			if((phmi_input_point_polygon[point_index].x >= min_x)&&
				(phmi_input_point_polygon[point_index].x <= max_x))
			{
				if(phmi_input_point_polygon[point1_index].y > 
						phmi_input_point_polygon[point2_index].y)
				{
					min_y	= phmi_input_point_polygon[point2_index].y;
					max_y	= phmi_input_point_polygon[point1_index].y;
				}
				else
				{
					max_y	= phmi_input_point_polygon[point2_index].y;
					min_y	= phmi_input_point_polygon[point1_index].y;
				}
				if((phmi_input_point_polygon[point_index].y >= min_y)&&
					(phmi_input_point_polygon[point_index].y <= max_y))
				{				
					delta_x1	= phmi_input_point_polygon[point_index].x - 
								phmi_input_point_polygon[point1_index].x;
					
					delta_x2	= phmi_input_point_polygon[point_index].x - 
								phmi_input_point_polygon[point2_index].x;

					delta_y1	= phmi_input_point_polygon[point_index].y - 
								phmi_input_point_polygon[point1_index].y;
					
					delta_y2	= phmi_input_point_polygon[point_index].y - 
								phmi_input_point_polygon[point2_index].y;

					delta1	= delta_y1 * delta_x2;
					delta2	= delta_y2 * delta_x1;
					if(delta2 > delta1)
					{
						delta1	= delta2 - delta1;
					}
					else
					{
						delta1	= delta1 - delta2;
					}
					if(delta1 == 0)
					{
						bin	= TRUE;
					}
				}
			}
		}
	}
	
	return	bin;
}

/*
To calculate the area of polygon made by given points 

Good for polygon with holes, but the vertices make the 
hole  should be in different direction with bounding 
polygon.

Restriction: the polygon is not self intersecting

As polygon in different direction, the result coulb be
in different sign:
If area>0 : polygon in clock wise to the user 
If area<0: polygon in count clock wise to the user 		
*/
SINT32 hmi_polygon_area(POINT32_TP points[],U16 length)
{
	SINT32		area			= 0;
	U16			loop			= 0U;
	U16			j			= 0U;
		
	for (loop = 0U; loop < length; loop++)
	{
		j		= loop + 1;
		if(j >= length)
		{
			j	= 0U;
		}
		area	+= (points[loop].x * points[j].y);
		area	-= (points[loop].y * points[j].x);
	}

	area	= (SINT32)(area/2);
	
	return area;
}
		


/*
	To check the 'index' is in the Triangle or not.
	If the 'index' is in the line , then return true.
	If the 'index' is out of the Triangle, then return false.

	This method is used for triangle only.
*/
BOOLEAN triangle_contains_point(HMI_INPUT_POLYGON_STR *pinput_polygon, 
										U16 j,U16 i,U16 k,U16 index)
{
	BOOLEAN			bin								= FALSE;
	BOOLEAN			bin1								= FALSE;
	BOOLEAN			bin2								= FALSE;
	BOOLEAN			bin3								= FALSE;
	SINT32				area0							= 0;
	SINT32				area1							= 0;
	SINT32				area2							= 0;
	POINT32_TP			*phmi_input_point_polygon			= NULL;
	POINT32_TP			points[HMI_CUT_EAR_TRIANGLE]		= {{0,0},{0,0},{0,0}};

	if(pinput_polygon != NULL)	/*lq*/
	{
		phmi_input_point_polygon	= pinput_polygon->phmi_input_point_polygon;
		bin1	= hmi_in_line(pinput_polygon,i,j,index);
		bin2	= hmi_in_line(pinput_polygon,i,k,index);
		bin3	= hmi_in_line(pinput_polygon,k,j,index);
		bin		= bin1 || bin2 || bin3;
		if(bin == FALSE)
		{
			if(phmi_input_point_polygon != NULL)
			{
				points[0]	= phmi_input_point_polygon[j];
				points[1]	= phmi_input_point_polygon[i];
				points[2]	= phmi_input_point_polygon[index];			
				area0		= hmi_polygon_area(points,HMI_CUT_EAR_TRIANGLE);

				points[0]	= phmi_input_point_polygon[i];
				points[1]	= phmi_input_point_polygon[k];
				points[2]	= phmi_input_point_polygon[index];			
				area1		= hmi_polygon_area(points,HMI_CUT_EAR_TRIANGLE);

				points[0]	= phmi_input_point_polygon[k];
				points[1]	= phmi_input_point_polygon[j];
				points[2]	= phmi_input_point_polygon[index];			
				area2		= hmi_polygon_area(points,HMI_CUT_EAR_TRIANGLE);

				if (area0 > 0)
				{
					if ((area1 > 0) &&(area2 > 0))
					{
						bin	= TRUE;
					}
				}
				else if (area0 < 0)
				{
					if ((area1 < 0) && (area2 < 0))
					{
						bin	= TRUE;
					}
				}
			}
			else
			{
				bin	= FALSE;
			}
		}		
	}
		
	return bin;			
}

/*
*/
BOOLEAN is_ear_of_updatedpolygon(HMI_INPUT_POLYGON_STR *pinput_polygon,U16 index)
											
{
	BOOLEAN				bear				= FALSE;
	BOOLEAN				bcontain			= FALSE;
	BOOLEAN				bnot_equ		= FALSE;
	U16						i				= 0U;	
	U16						j				= 0U;
	U16						k				= 0U;
	U16						loop				= 0U;	
	U16						length			= 0U;
	U16						head_index		= 0U;
	HMI_VERTEXTYPE_STR 		vertex_type		= HMI_POLYGONTYPE_ERRORPOINT;
	HMI_NEXT_PRE_LIST_STR	*pnext_pre_list	= NULL;
	
	if(pinput_polygon != NULL)
	{
		length		= pinput_polygon->length;
		pnext_pre_list	= pinput_polygon->pnext_pre_list;
		
		if(index < length)
		{			
			bear		= TRUE;
			vertex_type	= poly_gonvertex_type(pinput_polygon,index);
			if(vertex_type == HMI_POLYGONTYPE_CONVEXPOINT)
			{
				i	= index;
				/*previous point*/
				j	= pnext_pre_list[index].pre_node;
				/*next point*/
				k	= pnext_pre_list[index].next_node;				
				head_index		= pinput_polygon->head_index;
				loop			= head_index;
				do
				{		
					bnot_equ	= (loop == i) || (loop == j) ||(loop == k);
					if(bnot_equ == FALSE)
					{
						bcontain	= triangle_contains_point(pinput_polygon,
												j,i,k,loop);
						if(bcontain == TRUE)
						{
							bear	= FALSE;/*Not an ear*/							
						}
					}
					loop	= pnext_pre_list[loop].next_node;
				}
				while((loop != head_index)&&
					(bcontain == FALSE));				
			}
			else	/*concave point*/
			{
				bear	= FALSE;/*Not an ear*/
			}
			
		}
	}

	
	return bear;
}



/*
Cut a ear polygon
*/
BOOLEAN hmi_cut_ear(HMI_INPUT_POLYGON_STR *pinput_polygon,
						HMI_OUTPUT_TRIANGLE_STR *pout_triangle)
{
	BOOLEAN	success		= FALSE;	
	BOOLEAN 	bfinish		= FALSE;
	BOOLEAN 	bnot_found	= FALSE;
	BOOLEAN 	bear			= FALSE;
	U16			i			= 0U;
	U16			length		= 0U;
	U16 			j			= 0U;
	U16 			k			= 0U;	
	U16 			cnt			= 0U;
	U16 			cnt_ear		= 0U;
	U16			head_index	= 0U;
	U16			pre_node		= 0U;
	U16			next_node	= 0U;
	HMI_NEXT_PRE_LIST_STR	*pnext_pre_list	= NULL;
	POINT32_TP	*phmi_input_point_polygon		= NULL;
	POINT32_TP	*phmi_output_point_triangle	= NULL;

	if((pinput_polygon != NULL)&&
		(pout_triangle != NULL))
	{
		phmi_input_point_polygon		= pinput_polygon->phmi_input_point_polygon;
		phmi_output_point_triangle		= pout_triangle->phmi_output_point_triangle;
		pout_triangle->valide_length	= 0U;
		length	= pinput_polygon->length;	
		if(length >= HMI_CUT_EAR_TRIANGLE)
		{
			pnext_pre_list	= pinput_polygon->pnext_pre_list;
				
			if (length == HMI_CUT_EAR_TRIANGLE) /*get a  triangle, don't have to cut ear*/
			{		
				head_index	= pinput_polygon->head_index;
				/*add an ear*/
				j	= head_index;
				i	= pnext_pre_list[j].next_node;				
				k	= pnext_pre_list[i].next_node;
				/*add ear to pout_triangle*/
				if((j < length)&&(i < length)&&(k < length)&&
					((pout_triangle->valide_length + HMI_CUT_EAR_TRIANGLE) <= pout_triangle->array_len))
				{
					phmi_output_point_triangle[pout_triangle->valide_length].x	= 
								(phmi_input_point_polygon[j].x);
					phmi_output_point_triangle[pout_triangle->valide_length].y	= 
								(phmi_input_point_polygon[j].y);
					pout_triangle->valide_length++;

					phmi_output_point_triangle[pout_triangle->valide_length].x	= 
								(phmi_input_point_polygon[i].x);
					phmi_output_point_triangle[pout_triangle->valide_length].y	= 
								(phmi_input_point_polygon[i].y);
					pout_triangle->valide_length++;

					phmi_output_point_triangle[pout_triangle->valide_length].x	= 
								(phmi_input_point_polygon[k].x);
					phmi_output_point_triangle[pout_triangle->valide_length].y	= 
								(phmi_input_point_polygon[k].y);
					pout_triangle->valide_length++;
				}
				bfinish = TRUE;
				success = TRUE;
			}
			else /* cut ear*/
			{							
				while ((bfinish == FALSE)&&(cnt < HMI_POLYGON_NEXT_MAX_CNT)) 
				{
					cnt++;
					head_index	= pinput_polygon->head_index;
					i			= head_index;
					bnot_found	= TRUE;
					
					while ((bnot_found == TRUE) &&
						( cnt_ear < HMI_POLYGON_NEXT_MAX_CNT)) /*loop till find an ear*/
					{
						cnt_ear++;																														
						bear	= is_ear_of_updatedpolygon(pinput_polygon,i);													
						if(bear == TRUE)
						{
							bnot_found	= FALSE; /*got one, 'i' is an ear*/
						}
						else
						{
							i	= pnext_pre_list[i].next_node;
							if( i == head_index)/*search finished*/
							{
								cnt_ear = HMI_POLYGON_NEXT_MAX_CNT;
							}
						}
															
					} /*bNotFount*/
					
					/*an ear found*/
					if((bnot_found == FALSE) && (i < length))
					{	
						/*cut i point from pinput_polygon*/ 						
						pre_node	= pnext_pre_list[i].pre_node;
						next_node	= pnext_pre_list[i].next_node;
						pnext_pre_list[pre_node].next_node	= next_node;
						pnext_pre_list[next_node].pre_node	= pre_node;
						if(head_index == i)/*delete head node*/
						{
							pinput_polygon->head_index	= next_node;
						}
						pinput_polygon->remain_length--;
						/*get previous point*/
						j	= pnext_pre_list[i].pre_node;
						/*get next point*/
						k	= pnext_pre_list[i].next_node;
						/*add ear to pout_triangle*/
						if((j < length)&&(i < length)&&(k < length)&&
							((pout_triangle->valide_length + HMI_CUT_EAR_TRIANGLE) <= pout_triangle->array_len))
						{
							phmi_output_point_triangle[pout_triangle->valide_length].x	= 
										(phmi_input_point_polygon[j].x);
							phmi_output_point_triangle[pout_triangle->valide_length].y	= 
										(phmi_input_point_polygon[j].y);
							pout_triangle->valide_length++;

							phmi_output_point_triangle[pout_triangle->valide_length].x	= 
										(phmi_input_point_polygon[i].x);
							phmi_output_point_triangle[pout_triangle->valide_length].y	= 
										(phmi_input_point_polygon[i].y);
							pout_triangle->valide_length++;

							phmi_output_point_triangle[pout_triangle->valide_length].x	= 
										(phmi_input_point_polygon[k].x);
							phmi_output_point_triangle[pout_triangle->valide_length].y	= 
										(phmi_input_point_polygon[k].y);
							pout_triangle->valide_length++;
						}
						
					}					
					
					if (pinput_polygon->remain_length == HMI_CUT_EAR_TRIANGLE)
					{
						bfinish = TRUE;
						/*get ear j*/
						head_index		= pinput_polygon->head_index;
						j				= head_index;
						i				= pnext_pre_list[j].next_node;
						k				= pnext_pre_list[i].next_node;							
						/*add ear to pout_triangle*/
						if((j < length)&&(i < length)&&(k < length)&&
							((pout_triangle->valide_length + HMI_CUT_EAR_TRIANGLE) <= pout_triangle->array_len))
						{
							phmi_output_point_triangle[pout_triangle->valide_length].x	= 
										pinput_polygon->phmi_input_point_polygon[j].x;
							phmi_output_point_triangle[pout_triangle->valide_length].y	= 
										pinput_polygon->phmi_input_point_polygon[j].y;
							pout_triangle->valide_length++;

							phmi_output_point_triangle[pout_triangle->valide_length].x	= 
										pinput_polygon->phmi_input_point_polygon[i].x;
							phmi_output_point_triangle[pout_triangle->valide_length].y	= 
										pinput_polygon->phmi_input_point_polygon[i].y;
							pout_triangle->valide_length++;

							phmi_output_point_triangle[pout_triangle->valide_length].x	= 
										pinput_polygon->phmi_input_point_polygon[k].x;
							phmi_output_point_triangle[pout_triangle->valide_length].y	= 
										pinput_polygon->phmi_input_point_polygon[k].y;
							pout_triangle->valide_length++;
						}
					}					
				} /*bfinish=false*/ 
				success 	= TRUE;
			}			
		}		
	}	
	
	return	success;
}


/*
Build table
*/
void hmi_build_list(HMI_INPUT_POLYGON_STR *pinput_polygon)
{
	U16 	i	= 0U;
	U16 length	= 0U;
	HMI_NEXT_PRE_LIST_STR	*pnext_pre_list 	= NULL;
	
	if(pinput_polygon != NULL)
	{		
		length	= pinput_polygon->length;
		pinput_polygon->remain_length	= length;
		pnext_pre_list	= pinput_polygon->pnext_pre_list;
		if(length >= HMI_CUT_EAR_TRIANGLE)
		{
			length--;
			pinput_polygon->head_index	= 0U;			
			/*set head*/
			pnext_pre_list[0].pre_node	= length;
			pnext_pre_list[0].next_node = 1U;
			
			
			for(i = 1U;i < length;i++)
			{
				pnext_pre_list[i].pre_node		= i - 1;
				pnext_pre_list[i].next_node 	= i + 1;
			}
			
			/*set tail*/
			pnext_pre_list[length].pre_node 	= length - 1;
			pnext_pre_list[length].next_node	= 0U;
		}
	}
}



BOOLEAN hmi_cut_triangle(HMI_INPUT_POLYGON_STR *pinput_polygon,
					HMI_OUTPUT_TRIANGLE_STR *pout_triangle,BOOLEAN bcheck_count_wise)
{
	BOOLEAN success = FALSE;

	if((pinput_polygon != NULL)&&
		(pout_triangle != NULL))
	{
		/*build double list*/
		hmi_build_list(pinput_polygon);
		/*count wise*/
		if(bcheck_count_wise == FALSE)
		{
			set_updated_polygonvertices(pinput_polygon);
		}
		
		/*cut ear.get multi triangle*/
		success = hmi_cut_ear(pinput_polygon,pout_triangle);
	}

	return	success;
}


/*
x0=xcosA-ysinA
y0=xsinA+ycosA
*/
#define	HMI_MIN_INSCRIBED_POLY_CNT		3
BOOLEAN	hmi_circle_inscribed_poly(U16 radius,U16 n,
							POINT32_TP	poly[],U16	len)
{	
	BOOLEAN		success			= FALSE;			
	float_32			cosA			= 0.0f;
	float_32			sinA				= 0.0f;	
	float_32			angle			= 0.0f;
	float_32			one_arc_angle	= 0.0f;
	U16				loop				= 0U;
	U16				index			= 0U;
	

	success	= (n <=len)&&(n >= HMI_MIN_INSCRIBED_POLY_CNT);
	if((radius > 0U)	&&(success == TRUE))
	{	
		one_arc_angle			= (float_32)(360.0f / n);
		one_arc_angle			= HMI_ANGEL_TO_RADIAN(one_arc_angle);		

		poly[index].x	= radius;
		poly[index].y	= 0;
		index++;
		for(loop = 0U;loop < n - 1;loop++)
		{
			cosA				= (float_32)cos(angle);
			sinA				= (float_32)sin(angle);
			poly[index].x		= (SINT16)(radius * cosA + 0.5f);
			poly[index].y		= (SINT16)(radius * sinA + 0.5f);						
			angle			= angle + one_arc_angle;
			index++;
		}
		
								
		success	= TRUE;
	}
	
	return success;
}

