*/
#if HMI_MEMORY_LONG_TIME_RELEASE ==	HMI_YES
void add_tick_res_manager(void)
{
	BYTE							i				= 0U;
	UINT32							cnt				= 0U;
	UINT32							cnt_loop		= 0U;
	BYTE							fmt_index		= 0U;
	HMI_FMT_ADDR_STR	CONST		*pfmt_addr		= NULL;
	HMI_SEGMENT_LIST_STR	CONST	*psegment_list	= NULL;	
	HMI_FMT_BIG_IMAGE_BUFFER_STR	*pbig_image_buf	= NULL;
	UINT32							ticks			= 0U;
	
	psegment_list	= hmi_cur_texture.psegment_list;
	if(psegment_list != NULL)
	{
		for(i = 0U;i < HMI_BMP_SEGMENT_MAX_CNT;i++)
		{
			for(fmt_index = HMI_JPG_BIG_IMAGE;fmt_index < HMI_MAX_CNT_BIG_IMAGE;
						fmt_index++)
			{
				pfmt_addr	= &(psegment_list[i].fmt_addr[fmt_index]);
				cnt			= pfmt_addr->cnt;
				if(cnt != 0U)
				{
					pbig_image_buf	= pfmt_addr->pfmt_big_image_buffer;
					if(pbig_image_buf != NULL)	/*lq*/
					{
						for(cnt_loop = 0U;cnt_loop < cnt;cnt_loop++)
						{
							//if(pbig_image_buf->pbuffer != NULL)/*is loaded*/
							if(pbig_image_buf[cnt_loop].texture_id != 0U)/* is loaded to GPU.2023 05 06*/
							{
								pbig_image_buf[cnt_loop].ticks++;	
								if(pbig_image_buf[cnt_loop].ticks == 0U)/*overflow,0 mean the texture used at this loop*/
								{
									pbig_image_buf[cnt_loop].ticks	= HMI_MAX_RGL_OVERFLOW;
								}
							}
						}
					}
				}
			}
		}
	}
}

