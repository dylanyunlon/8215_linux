float_32 inline hmi_pixel_opengl_coordinate_x(HMI_WIDTH_STR x,U08 screen_no)	
{
	float_32	result	= 0.0f;
	
	result	= (((float_32)(x))/(hmi_screen_size[screen_no].x >> 1));

	return	result;
}



float_32 inline hmi_pixel_opengl_coordinate_y(HMI_HEIGHT_STR y,U08 screen_no)	
{
	float_32	result	= 0.0f;
	
	result	= (((float_32)(y))/(hmi_screen_size[screen_no].y >> 1));

	return	result;
}




HMI_Y_STR inline hmi_pixel_low_left_coordinate_y(HMI_HEIGHT_STR y,U08 screen_no)	
{
	HMI_Y_STR	result	= 0;
	
	result	= (hmi_screen_size[screen_no].y - (y));

	return	result;
}

/*
 pixel coordinate to opengl coordinate(coordinate at center of screen)
*/
float_32 inline hmi_screen_opengl_coordinate_x(HMI_WIDTH_STR x,U08 screen_no)	
{
	float_32	result	= 0.0f;
	float_32	half_w	= 0.0f;

	half_w	= (float_32)(hmi_screen_size[screen_no].x >>1);
	result	= (x - half_w)/half_w;

	return	result;
}


float_32 inline hmi_screen_opengl_coordinate_y(HMI_HEIGHT_STR y,U08 screen_no)	
{
	float_32	result	= 0.0f;
	float_32	half_h	= 0.0f;

	half_h	= (float_32)(hmi_screen_size[screen_no].y >> 1);
	result	= (half_h  - y)/half_h;

	return	result;
}	

float_32 /*inline*/ hmi_screen_opengl_coordinate_x_f(float_32 x,U08 screen_no)	
{
	float_32	result	= 0.0f;
	float_32	half_w	= 0.0f;

	half_w	= (float_32)(hmi_screen_size[screen_no].x >>1);
	result	= (float_32)((x - half_w)/half_w);

	return	result;
}


float_32 /*inline*/ hmi_screen_opengl_coordinate_y_f(float_32 y,U08 screen_no)	
{
	float_32	result	= 0.0f;
	float_32	half_h	= 0.0f;

	half_h	= (float_32)(hmi_screen_size[screen_no].y >> 1);
	result	= (float_32)((half_h  - y)/half_h);

	return	result;
}

float_32 /*inline*/ hmi_center_screen_opengl_coordinate_x_f(float_32 x,U08 screen_no)	
{
	float_32	result	= 0.0f;
	float_32	half_w	= 0.0f;

	half_w	= (float_32)(hmi_screen_size[screen_no].x >>1);
