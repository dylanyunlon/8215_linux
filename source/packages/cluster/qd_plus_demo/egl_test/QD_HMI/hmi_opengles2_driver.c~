/*
Get vector normal
*/
void hmi_normalise_s3point_float(S3POINT_FLOAT_TP *pa)
{	
	float_32		len		= 0U;

	if(pa != NULL)
	{
		len		= (float_32)((*pa).x * (*pa).x + 
				  (*pa).y * (*pa).y +
				  (*pa).z * (*pa).z);
		
		len		= (float_32)sqrt(len);
		
		if(len > HMI_FLOAT_TOLERANCE)
		{
			(*pa).x	= (float_32)((*pa).x / len);
			(*pa).y	= (float_32)((*pa).y / len);
			(*pa).z	= (float_32)((*pa).z / len);
		}	
		else
		{
			(*pa).x	= 0.0f;
			(*pa).y	= 0.0f;
			(*pa).z	= 1.0f;
		}
	}
}

