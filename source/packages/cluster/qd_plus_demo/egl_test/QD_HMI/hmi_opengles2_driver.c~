/*
coordinate transform.
rect  pointer coordinate to opengl coordinate
origin at screen center(x-->left,y-->up,z-->to your eye)
*/
BOOLEAN get_rect_screen_to_center_coordinate(HMI_RECT_STR *prect,
									GLfloat	image_vertex_pos[],
									U08	len,U08	screen_no)
{
	BOOLEAN			success			= FALSE;
	float_32				x				= 0.0f;
	float_32				y				= 0.0f;	
	U08					index			= 0U;
	HMI_WIDTH_STR		screen_center_x	= 0U;
	HMI_HEIGHT_STR		screen_center_y	= 0U;

	if((prect != NULL) && (len <= HMI_VERTEX_POS_ARRAY_LEN))
	{		
		if(screen_no < HMI_SCREEN_NO)
		{	
			screen_center_x	= hmi_screen_size[screen_no].x >> 1U;
			screen_center_y	= hmi_screen_size[screen_no].y >> 1U;
		
			image_vertex_pos[index++]	= (GLfloat)(prect->x - screen_center_x);
			image_vertex_pos[index++]	= (GLfloat)(screen_center_y - prect->y);
			image_vertex_pos[index++]	= -1.0f;

			image_vertex_pos[index++]	= (GLfloat)(prect->x - screen_center_x);
			image_vertex_pos[index++]	= (GLfloat)(screen_center_y - (prect->y + prect->h));
			image_vertex_pos[index++]	= -1.0f;

			image_vertex_pos[index++]	= (GLfloat)((prect->x + prect->w) - screen_center_x);
			image_vertex_pos[index++]	= (GLfloat)(screen_center_y - (prect->y + prect->h));
			image_vertex_pos[index++]	= -1.0f;

			image_vertex_pos[index++]	= (GLfloat)((prect->x + prect->w) - screen_center_x);
			image_vertex_pos[index++]	= (GLfloat)(screen_center_y - prect->y);
			image_vertex_pos[index++]	= -1.0f;
		}
		
		success	= TRUE;
	}
	
	return	success;
}


TEXTURE_2D_PIXEL_FORMAT get_pixel_format(U08 compress,BOOLEAN alpha_channel)
{
	TEXTURE_2D_PIXEL_FORMAT	color_fmt	= TEXTURE_2D_PIXEL_FORMAT_RGB888;	
	
	if(compress == HMI_IMAGE_COMPRESS_NONE)
	{
		if(alpha_channel == TRUE)
		{
			color_fmt	= TEXTURE_2D_PIXEL_FORMAT_RGBA8888;
		}
		else
		{
			color_fmt	= TEXTURE_2D_PIXEL_FORMAT_RGB565;
		}
	}
	else if((compress == HMI_IMAGE_COMPRESS_NO_LOSS)||
			(compress == HMI_IMAGE_COMPRESS_LOSSY))
	{
		if(alpha_channel == TRUE)
		{
			color_fmt	= TEXTURE_2D_PIXEL_FORMAT_RGBA8888;
		}
		else
		{
			color_fmt	= TEXTURE_2D_PIXEL_FORMAT_RGB565;
		}
	}
	else if(compress == HMI_IMAGE_COMPRESS_RLE0888)			
	{
		color_fmt	= TEXTURE_2D_PIXEL_FORMAT_RGBA8888;
	}
	else if(compress == HMI_IMAGE_COMPRESS_JPG)			
	{		
		color_fmt	= TEXTURE_2D_PIXEL_FORMAT_RGB888;		
	}
	else
	{		
		printf("get_pixel_format error\n");
		hmi_printf_time(" get_pixel_format error",0);
		
		#if(HMI_ENDLESS_LOOP == YES)
		while(1);/* not support the  'color_fmt'*/
		#endif
	}
	
	
	return	color_fmt;
}



