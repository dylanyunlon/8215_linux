void	hmi_get_font_uv(HMI_AVL_TREE_ROOT_NODE_STR *proot,
				HMI_AVL_TREE_USER_DATA_STR	*puser_data,
				GLfloat	uv[],UINT16 uv_len)
{
	UINT32	font_buffer_w		= 0U;
	UINT32	font_buffer_h		= 0U;
	UINT16	font_w			= 0U;
	UINT16	font_h			= 0U;
	UINT32	left_top_x		= 0U;
	UINT32	left_top_y		= 0U;
	UINT32	right_bottom_x	= 0U;
	UINT32	right_bottom_y	= 0U;
	UINT8	x_index			= 0U;
	UINT8	y_index			= 0U;
	UINT16	char_w			= 0U;
	UINT16	char_h			= 0U;

	if((proot != NULL)&&(puser_data != NULL)&&
		uv_len >= HMI_VERTEX_TEX0_ARRAY_LEN)
	{
		char_w	= puser_data->char_w;
		char_h	= puser_data->char_h;
		x_index	= puser_data->x_index;
		y_index	= puser_data->y_index;
		font_w	= proot->font_w;
		font_h	= proot->font_h;
		font_buffer_w	= HMI_FONT_BUFFER_FONT_X * font_w;
		font_buffer_h	= HMI_FONT_BUFFER_FONT_Y * font_h;

		if((font_buffer_w != 0U)&&(font_buffer_h != 0U))
		{
			left_top_x		= x_index * font_w;
			left_top_y		= y_index * font_h;

			right_bottom_x	= left_top_x + char_w;
			right_bottom_y	= left_top_y + char_h;

			uv[0]	= (GLfloat)(((GLfloat)left_top_x)/font_buffer_w);
			uv[1]	= (GLfloat)(((GLfloat)left_top_y)/font_buffer_h); 

			uv[2]	= uv[0];
			uv[3]	= (GLfloat)(((GLfloat)right_bottom_y)/font_buffer_h);

			uv[4]	= (GLfloat)(((GLfloat)right_bottom_x)/font_buffer_w);
			uv[5]	= (GLfloat)(((GLfloat)right_bottom_y)/font_buffer_h);

			uv[6]	= uv[4];
			uv[7]	= uv[1]; 

		}
	}
}

