							load_status	= HMI_BIG_IMAGE_LOAD_FAILED;
							hmi_printf_time("texture load status failed", 0);
						}
					}
				}
			}
			else /*current texture */
			{			
				load_status	= HMI_BIG_IMAGE_TEXTURE_READY;
				hmi_set_ticks_zero(pdata);
			}
		}
		else	/*Render buffer texture ID*/
		{
			texture_id	= (GLuint)(pbitmap_data->fmt_index)/*Used as texture ID*/;
			if(texture_id != 0)
			{
				glActiveTexture(GL_TEXTURE0  + HMI_TEXTURE_UNIT_BMP);
				glBindTexture(GL_TEXTURE_2D,texture_id );
				hmi_cur_texture.seg_no		= 0u;
				hmi_cur_texture.fmt_index	= HMI_MAX_CNT_BIG_IMAGE;
				hmi_cur_texture.index		= 0u;
					
				load_status	= HMI_BIG_IMAGE_TEXTURE_READY;
			}
			else
			{
				/*error*/
				load_status	= HMI_BIG_IMAGE_CREATE_TEXTURE_FAILED;//HMI_BIG_IMAGE_TEXTURE_READY;
			}
		}
	}
	if(load_status != HMI_BIG_IMAGE_TEXTURE_READY)
	{
		hmi_printf_time("texture load status error", (UINT8)load_status);
	}
	
	return	load_status;
}

