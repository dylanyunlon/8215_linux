void hmi_get_trail_image_display_zone(HMI_RECT_STR *ptrail_image_disp_rect/*trail image display zone*/,
									HMI_RECT_STR *ptrail_rect,
									POINT32_TP	*protation_point,
									HMI_RECT_ALPHA_ANGEL_STR *palpha_pos_angel)
