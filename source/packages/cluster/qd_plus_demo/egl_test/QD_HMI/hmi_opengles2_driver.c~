BOOLEAN hmi_is_small_arc(INT32 begin_angel,INT32 end_angel)
{
	BOOLEAN small_arc	= FALSE;
	

	begin_angel	= begin_angel % HMI_CIRCLE_ANGEL;
	end_angel	= end_angel % HMI_CIRCLE_ANGEL;
	
	if(((begin_angel <= 0)&&(end_angel <= 0))||
		((begin_angel >= 0)&&(end_angel >= 0)))
	{
		begin_angel	= end_angel - begin_angel;
		if(begin_angel <= 90)
		{
			small_arc	= TRUE;
		}
		else
		{
			small_arc	= FALSE;
		}
	}
	else
	{
		if((begin_angel <= 0)&&(end_angel >= 0))
		{
			begin_angel	= end_angel - begin_angel;
			if(begin_angel <= 180)
			{
				small_arc	= TRUE;
			}
			else
			{
				small_arc	= FALSE;
			}
		}
		else
		{
			begin_angel	= begin_angel - end_angel;
			if(begin_angel <= 180)
			{
				small_arc	= TRUE;
			}
			else
			{
				small_arc	= FALSE;
			}
		}
	}
		
	return small_arc;
	
}


U08 hmi_get_beg_end_vertex(float_32 angel,U16 circle_radius_w,
									U16 circle_radius_h,
									SPOINT_TP *pvertex)
{
	U08		no	= 0U;

	/*Get rect zone.width==height*/
	if(circle_radius_w > circle_radius_h)
	{
		circle_radius_h	= circle_radius_w;
	}
	else
	{
		circle_radius_w	= circle_radius_h;
	}
	
	if(pvertex != NULL)
	{		
		if(((angel >= (-45))&&(angel <= 45))||
			((angel >= (-360))&&(angel <= -315))||
			((angel >= 315)&&(angel <= 360)))
		{
			if(fabs(angel) < HMI_FLOAT_TOLERANCE)
			{			
				pvertex[0].x	= 0;
				pvertex[0].y	= circle_radius_h;						
			}
			else
			{			
				pvertex[0].x	= (INT16)(circle_radius_h/
								tan(HMI_ANGEL_TO_RADIAN(90+angel)));
				pvertex[0].y	= (INT16)circle_radius_h;							
			}
			no	= 0;
		}
		else if( ((angel <=(-45))&&(angel >= (-135)))||
			((angel <=(315))&&(angel >= (225))))
		{								
			pvertex[0].x	= circle_radius_w;
			pvertex[0].y	= (INT16)(circle_radius_w *
					tan(HMI_ANGEL_TO_RADIAN(90+angel)));	
			no	= 3;
		}
		else if(((angel <= (-135))&&(angel >= (-225)))||
			((angel <= (225))&&(angel >= (135))))
		{	
			if(fabs(angel) < HMI_FLOAT_TOLERANCE)
			{			
				pvertex[0].x	= 0;
				pvertex[0].y	= -circle_radius_h;				
			}
			else
			{			
				pvertex[0].x	= (INT16)(-circle_radius_h/
								tan(HMI_ANGEL_TO_RADIAN(90+angel)));
				pvertex[0].y	= -circle_radius_h;									
			}
			no	= 2;
		}
		else if(((angel <= (-225))&&(angel >= (-315)))||
			((angel <= 135)&&(angel >= (45))))
		{								
			pvertex[0].x	= -circle_radius_w;
			pvertex[0].y	= (INT16)(-circle_radius_w *
							tan(HMI_ANGEL_TO_RADIAN(90+angel)));
			no	= 1;
		}
		else
		{
		}
	}
	return no;
}


float_32 hmi_init_angel_to_y_axis(HMI_ROTATION_STR	*pointer_target_center)
{
	float_32	init_angel			= 0.0f;
	float_32	init_angel_arc			= 0.0f;

	if(pointer_target_center != NULL)
	{
		if(pointer_target_center->x != 0)
		{
			init_angel_arc	= (float_32)atan(fabs(pointer_target_center->y/((float_32)pointer_target_center->x)));
			init_angel		= (float_32)(init_angel_arc*180.0/HMI_PI);
			if(pointer_target_center->x > 0) 
			{
				if(pointer_target_center->y > 0)
				{	
					init_angel	= -(90.0f - init_angel);
				}
				else
				{
					init_angel	= -(90.0f + init_angel);
				}
			}
			else	/*x < 0*/
			{
				if(pointer_target_center->y > 0)
				{
					init_angel	= -(270.0f + init_angel);
				}
				else
				{
					init_angel	= -(270.0f - init_angel);
				}
			}						
		}
		else
		{
			if(pointer_target_center->y > 0)
			{
				init_angel	= 0.0f;
			}
			else if(pointer_target_center->y < 0)
			{
				init_angel	= -180.0f;
			}
			else
			{
				init_angel	= 0.0f;
			}
		}	
	}
	
	return init_angel;
}








