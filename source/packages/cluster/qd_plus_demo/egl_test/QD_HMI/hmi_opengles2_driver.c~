void hmi_init_font_wh_malloc_buffer_avl_tree(HMI_AVL_TREE_ROOT_NODE_STR *proot,
										UINT16					font_w,
										UINT16					font_h)
{
	BYTE			*pbig_font_buffer		= NULL;
	UINT32		len					= 0U;

	if((proot != NULL)&&(font_w != 0U)&&(font_h != 0U))
	{
		proot->font_w		= font_w;
		proot->font_h		= font_h;
		len					= font_w * font_h * HMI_FONT_BUFFER_FONT_X * 
								HMI_FONT_BUFFER_FONT_Y;
		pbig_font_buffer		= (BYTE *)hmi_malloc_vram(len);
