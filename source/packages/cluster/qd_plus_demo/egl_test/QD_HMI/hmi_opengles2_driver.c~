GLuint	qd_pixel_fmt2opegles_fmt(TEXTURE_2D_PIXEL_FORMAT color_fmt)
{
	GLuint	gl_pixel_fmt	= GL_RGB;

	if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_RGBA8888)
	{
		gl_pixel_fmt	= GL_RGBA;
	}
	else if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_RGB888)
	{
		gl_pixel_fmt	= GL_RGB;
	}
	else if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_A8)
	{
		gl_pixel_fmt	= GL_ALPHA;
	}
	else if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_ETC1)
	{
		gl_pixel_fmt = 0x8d64;//GL_ETC1_RGB8_OES;
	}
	else if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_ETC2RGB888)
	{
		gl_pixel_fmt	= 0x9274/*GL_COMPRESSED_RGB8_ETC2*/;//??
	}
	else if(color_fmt == TEXTURE_2D_PIXEL_FORMAT_ETC2RGBA8888)
	{
		gl_pixel_fmt	= 0x9278/*GL_COMPRESSED_RGBA8_ETC2_EAC*/;//??
	}
	else
	{
		printf("qd_pixel_fmt2opegles_fmt error\n");
		hmi_printf_time(" qd_pixel_fmt2opegles_fmt error",0);
		
		#if(HMI_ENDLESS_LOOP == YES)
		while(1);/* not support the  'color_fmt'*/
		#endif
	}

	return	gl_pixel_fmt;
}


