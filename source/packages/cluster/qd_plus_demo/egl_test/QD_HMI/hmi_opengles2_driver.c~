void hmi_line_to_zone_one_point(POINT32_TP *pa, POINT32_TP *pb, 
					POINT32_TP *pc, INT32		line_width,
					POINT32_TP *pout)
{	
	POINT_FLOAT_3D_TP		ba				= {0.0f,0.0f,0.0f};
	POINT_FLOAT_3D_TP		bc				= {0.0f,0.0f,0.0f};
	POINT_FLOAT_3D_TP		mul_sum 		= {0.0f,0.0f,0.0f}; 
	float_32				distance		= 0.0f;
	float_32				cos_val 		= 0.0f; 
	float_32				f_line_width	= 0.0f;
	POINT_FLOAT_3D_TP		out_float		= {0.0f,0.0f,0.0f}; 
	BOOLEAN 				equal			= FALSE;
	
	//if((line_width > 0)&&(pout != NULL))
	if((line_width > 0)&&(pout != NULL) && (pa != NULL) && (pb != NULL) && (pc != NULL))	/*lq*/
	{		
		(*pout).x	= 0;
		(*pout).y	= 0;	
		HMI_SUB_POINT_IIF((*pa),(*pb),ba);
		HMI_SUB_POINT_IIF((*pc),(*pb),bc);	
		
		ba.z	= 0.0f; 		
		bc.z	= 0.0f; 
		if(((ba.x != 0)||(ba.y != 0))&&
			((bc.x != 0)||(bc.y != 0)))
		{
			hmi_normalise(&ba); 	
			hmi_normalise(&bc); 
			HMI_ADD_POINT2(ba,bc,out_float);
		}

		/*ba ,bc not at one line*/
		if((out_float.x > HMI_FLOAT_TOLERANCE)||
			(out_float.x < -HMI_FLOAT_TOLERANCE)||
			(out_float.y > HMI_FLOAT_TOLERANCE)||
			(out_float.y < -HMI_FLOAT_TOLERANCE))
		{
			hmi_normalise(&out_float);	
			HMI_DOT_MUL(ba,bc,cos_val);
			distance	= (float_32)(sqrt((1.0f - cos_val) * 0.5f));
			if(distance > HMI_FLOAT_TOLERANCE)
			{
				f_line_width	= (float_32)(line_width/distance);
			}
			//HMI_MUL_POINT(f_line_width,out_float);
			HMI_MUL_POINT_FF(f_line_width,out_float);//2022 04 23
			
			HMI_MUL_POINT(-1,ba);
			ba.z	= 0.0f;
			bc.z	= 0.0f;
			//HMI_CROSS_MUL(ba,bc,mul_sum);2022 04 23
			HMI_CROSS_MUL_FF(ba,bc,mul_sum);
			if(mul_sum.z > 0.0f)
			{
				HMI_MUL_POINT(-1,out_float);
			}
			if(out_float.x > 0.0f)
			{
				(*pout).x	= (INT32)(out_float.x + 0.5f);
			}
			else
			{
				(*pout).x	= (INT32)(out_float.x - 0.5f);
			}
			if(out_float.y > 0.0f)
			{
				(*pout).y	= (INT32)(out_float.y + 0.5f);	
			}
			else
			{
				(*pout).y	= (INT32)(out_float.y - 0.5f);
			}
		}
		else	// 2022 04 21
		{
			hmi_normalise(&bc);
			/*CW bc 90. [x*cos(-A)-y*sin(-A)  x*sin(-A)+y*cos(-A)] */
			out_float.x =  bc.y;
			out_float.y = -bc.x ;
			
			HMI_MUL_POINT(line_width,out_float);
						
			if(out_float.x > 0.0f)
			{
				(*pout).x	= (INT32)(out_float.x + 0.5f);
			}
			else
			{
				(*pout).x	= (INT32)(out_float.x - 0.5f);
			}
			if(out_float.y > 0.0f)
			{
				(*pout).y	= (INT32)(out_float.y + 0.5f);	
			}
			else
			{
				(*pout).y	= (INT32)(out_float.y - 0.5f);
			}
		}
	}		
}

