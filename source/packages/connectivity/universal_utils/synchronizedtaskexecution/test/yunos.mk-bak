LOCAL_PATH := $(call my-dir)

include $(CLEAR_VARS)

LOCAL_C_INCLUDES := \
    $(corefoundation-includes) \
	$(base-includes) \
    $(LOCAL_PATH)/


LOCAL_SRC_FILES := \
    ./main.cpp \
    ./multitask.cpp \
    ./synchronizedtaskexecution.cpp \
	./tasktest.cpp \

LOCAL_LDLIBS := \
    -lstdc++ \
    -ldl \
    -pthread \
	-lrt

LOCAL_SHARED_LIBRARIES := \
    liblog \
    

# LOCAL_WHOLE_STATIC_LIBRARIES := \
#    libchrome \
   



LOCAL_CFLAGS += -std=c++1y



LOCAL_MULTILIB := 32

LOCAL_MODULE := multitasktest

LOCAL_MODULE_TAGS := optional

include $(BUILD_EXECUTABLE)
