#! /bin/bash
#
# avm
#
# description: Run avm


start() {
	echo 0 > /proc/sys/kernel/hung_task_timeout_secs
	echo "avm start"
	/usr/bin/avm &
}

stop() {
	echo "avm stop"
	killall avm
}

case "$1" in
  start)
  	start
	;;
  stop)
	stop
	;;
  restart)
	stop
	start
	;;
  status)
	;;
  condrestart)
	stop
	start
	;;
  *)
	echo $"Usage: $0 {start|stop|status|restart|condrestart}"
	exit 1
esac

