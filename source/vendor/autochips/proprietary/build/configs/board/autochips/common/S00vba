#! /bin/bash
#
# avm
#
# description: Run avm


start() {
	echo "videobootanimation start"
	/usr/bin/videobootanimation &

	while ! grep -q "VideoBootAnimation Service Start" /proc/bootprof; do
	usleep 5000
	done
}

stop() {
	echo "videobootanimation stop"
	killall videobootanimation
}

case "$1" in
  start)
  	start
	;;
  stop)
	stop
	;;
  restart)
	stop
	start
	;;
  status)
	;;
  condrestart)
	stop
	start
	;;
  *)
	echo $"Usage: $0 {start|stop|status|restart|condrestart}"
	exit 1
esac

