#! /bin/bash
#
# avm
#
# description: Run adb


start() {
	/etc/android-gadget-setup &
	alias  ls="ls --color=never"
}

stop() {
	echo "avm stop"
}

case "$1" in
  start)
  	start
	;;
  stop)
	stop
	;;
  restart)
	stop
	start
	;;
  status)
	;;
  condrestart)
	stop
	start
	;;
  *)
	echo $"Usage: $0 {start|stop|status|restart|condrestart}"
	exit 1
esac

