#! /bin/bash
#
# kernel panic 
#
# description: kernel panic not reboot


start() {
	echo 0 > /proc/sys/kernel/panic
}

stop() {
	echo "kernel panic not reboot"
}

case "$1" in
  start)
  	start
	;;
  stop)
	stop
	;;
  restart)
	stop
	start
	;;
  status)
	;;
  condrestart)
	stop
	start
	;;
  *)
	echo $"Usage: $0 {start|stop|status|restart|condrestart}"
	exit 1
esac

