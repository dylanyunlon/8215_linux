#! /bin/bash
#
# avm
#
# description: Run atcupdateservice


start() {
        echo "atcupdateservice start"
	/usr/bin/update.bin &
}

stop() {
	echo "atcupdateservice stop"
	killall update.bin
}

case "$1" in
  start)
  	start
	;;
  stop)
	stop
	;;
  restart)
	stop
	start
	;;
  status)
	;;
  condrestart)
	stop
	start
	;;
  *)
	echo $"Usage: $0 {start|stop|status|restart|condrestart}"
	exit 1
esac

