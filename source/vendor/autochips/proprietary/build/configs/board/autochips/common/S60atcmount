#! /bin/bash
#
# mountservice
#
# description: Run mountservice
SESSION_BUS_ADDRESS="unix:abstract=/tmp/dbus-service"
export DBUS_SESSION_BUS_ADDRESS="$SESSION_BUS_ADDRESS"

start() {
	echo "atcmountservice start"
	/usr/bin/mountservice &
}

stop() {
	echo "atcmountservice stop"
	killall mountservice
}

case "$1" in
  start)
  	start
	;;
  stop)
	stop
	;;
  restart)
	stop
	start
	;;
  status)
	;;
  condrestart)
	stop
	start
	;;
  *)
	echo $"Usage: $0 {start|stop|status|restart|condrestart}"
	exit 1
esac

