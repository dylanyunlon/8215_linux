config BR2_PACKAGE_MALI_T82X
	bool "mali-t82x"
	select BR2_PACKAGE_HAS_LIBEGL
	select BR2_PACKAGE_HAS_LIBGLES
	help
	  Install the binary user-space components for the ARM Mali
	  Midgard T82X GPU. This package requires a kernel with the
	  ARM Mali Midgard GPU Kernel Drivers enabled.

if BR2_PACKAGE_MALI_T82X

config BR2_PACKAGE_PROVIDES_LIBEGL
	default "mali-t82x"

config BR2_PACKAGE_PROVIDES_LIBGLES
	default "mali-t82x"

endif

